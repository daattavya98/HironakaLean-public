/-!
# Hironaka (1964), Chapter I, §4 (pp. 178, 180): the two argued steps

This file proves the two steps of §4 that the paper argues (the other statements of §4 are only
stated, in `Hironaka.Ch1.Comments`).

Printed text (p. 178): "Here we must use the fact that if J is an ideal in a regular local ring R
which is different from R and if (z₁, ⋯, z_τ) is a regular system of τ-parameters of R for J,
then dim(R) ≦ τ + dim(R/J).  (This follows from the fact that if M is the maximal ideal of R, then
dim(gr_M(R/J)) = dim(R/J), which is well-known.)"

`dimLeTauAddDimQuotient_of_dimAssocGradedQuotient` proves `DimLeTauAddDimQuotient` from
`DimAssocGradedQuotient`, the "well-known" fact, which is stated without proof or citation and enters
as an explicit hypothesis (assumed, as in the paper).  The paper's argument is the one sentence "This
follows from the fact that …".  The steps it does not print are proved here and recorded as gaps
filled: `gr_M(R) = K[X₁, …, X_n]` for a regular system of parameters extending `z`
(`dim_le_tau_add_dim_quotient_of_isTauSubmodule`); `gr_M(R/J) = gr_M(R)/gr_M(J)`; that `gr_M(J)` is
generated in degrees at most `μ_t` (`exists_homogeneous_generators_le_mu`), so that Definition 7 gives
`gr_M(J) = (gr_M(J) ∩ K[T]) gr_M(R)` in all degrees (`grIdeal_le_span_inter_adjoin`); and the
dimension count for a quotient of a polynomial ring by an ideal extended from the first `τ`
variables (`exists_surjective_mvPolynomial_of_ne_top`).

Printed text (p. 180), footnote 38: "This assertion (d) is equivalent to saying that B_{r−1} ⊇ W_{r−1}
(hence, by (a), B_{r−1} = W_{r−1})."

`MonoidalSuccession.lastStep_eq_of_isMainIIISteps` proves the "hence" step: under the property (a)
(`B_{r−1} ⊆ W_{r−1}`) and `B_{r−1} ⊇ W_{r−1}`, `B_{r−1} = W_{r−1}`.  The equivalence of (d) with
`B_{r−1} ⊇ W_{r−1}` is stated without argument and is not proved here.
-/

@[expose] public section

noncomputable section

universe u

open IsLocalRing AlgebraicGeometry MvPolynomial

namespace Hironaka

/-! ### The dimension fact of p. 178 -/

section DimLe

variable (R : Type u) [CommRing R] [IsRegularLocalRing R] (J : Ideal R)

/-- Gap filled: every integer `μ` of the system `μ*(J) = (μ₁, …, μ_t)` of distinct integers
appearing in `ν*(J)` is at most the last one, `μ_t = μ^{(t)}(J)` (the `μ_a` are "arranged in the
increasing order", p. 221). -/
@[blueprint "lem:I.4-dim-tau-mu-max"
  (statement := /-- Let $R$ be a regular local ring and $J$ an ideal of $R$. Every integer $\mu$
    appearing in $\nu^*(J)$ satisfies $\mu\le\mu^{(t)}(J)$, $t=t(J)$ (the integers $\mu_a$ are
    arranged in increasing order, p.~221). Gap filled: the paper's ordering of the $\mu_a$ is used
    without comment on p.~178. -/)
  (proof := /-- The $\mu_a$ are the elements of the finite set of these integers in increasing
    order, and $\mu_t$ is the largest. -/)
  (latexEnv := "lemma")]
theorem le_mu_t_of_mem_muSet {μ : ℕ} (hμ : μ ∈ muSet R J) : μ ≤ mu R J (t R J) := by
  classical
  have hf : (muSet R J).Finite := (muSet_finite R J).1
  have hcard : hf.toFinset.card = t R J := (Set.ncard_eq_toFinset_card _ hf).symm
  have hp : (Set.ofPred (· ∈ muSet R J)).Finite := hf
  have h1 : Nat.count (· ∈ muSet R J) μ < hp.toFinset.card := Nat.count_lt_card hp hμ
  have hcard' : hp.toFinset.card = t R J := hcard
  have key := Nat.nth_strictMonoOn hp
  calc μ = Nat.nth (· ∈ muSet R J) (Nat.count (· ∈ muSet R J) μ) := (Nat.nth_count hμ).symm
    _ ≤ Nat.nth (· ∈ muSet R J) (t R J - 1) := by
      refine key.monotoneOn ?_ ?_ ?_
      · exact Set.mem_Iio.mpr h1
      · exact Set.mem_Iio.mpr (by omega)
      · omega

/-- Gap filled: `gr_M(J, R)` is generated by finitely many homogeneous elements of `gr_M(J, R)` of
degrees at most `μ_t = μ^{(t)}(J)`.  Take the initial forms of a standard base (Lemma 1, p. 205);
by Lemma 1 their degrees are the finite values `ν^{(i)}(J)`, hence lie among `μ₁, …, μ_t`. -/
@[blueprint "lem:I.4-dim-tau-generators"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$ and $J$ an ideal of $R$.
    Then $\operatorname{gr}_M(J,R)$ is generated by finitely many homogeneous elements of
    $\operatorname{gr}_M(J,R)$ of degrees $\le\mu^{(t)}(J)$, $t=t(J)$. Gap filled: used on p.~178
    when Definition~7, which controls $\operatorname{gr}^\mu_M(J,R)$ only for $\mu\le\mu^{(t)}(J)$,
    is applied to the whole ideal $\operatorname{gr}_M(J,R)$. -/)
  (proof := /-- Take the initial forms $\varphi_1,\dots,\varphi_m$ of a standard base of $J$. By
    Lemma~1 (\cref{lem:III.1}), $\nu^{(i)}(J)=\deg\varphi_i$ for $i\le m$, so each $\deg\varphi_i$
    is one of the integers $\mu_a$, hence $\le\mu_t$ (\cref{lem:I.4-dim-tau-mu-max}). -/)
  (proofUses := ["lem:I.4-dim-tau-mu-max", "lem:III.1"])
  (latexEnv := "lemma")]
theorem exists_homogeneous_generators_le_mu :
    ∃ (m : ℕ) (φ : Fin m → AssocGraded (maximalIdeal R)),
      (∀ j, φ j ∈ grIdeal (maximalIdeal R) J) ∧
      (∀ j, ∃ d ≤ mu R J (t R J), φ j ∈ AssocGraded.homogeneous (maximalIdeal R) d) ∧
      grIdeal (maximalIdeal R) J = Ideal.span (Set.range φ) := by
  obtain ⟨m, g, -, hJφ, ⟨d, hd, h₂⟩, h₁, h₃⟩ := exists_isStandardBase J
  obtain ⟨hν, -⟩ := nuI_eq_of_lemma1_properties R J _ hJφ d hd h₁ h₂ h₃
  refine ⟨m, fun j => initialForm (maximalIdeal R) (g j), hJφ, fun j => ⟨d j, ?_, hd j⟩, h₁⟩
  exact le_mu_t_of_mem_muSet R J ⟨⟨(j : ℕ) + 1, Nat.succ_pos _⟩, hν j⟩

/-- Gap filled: Definition 7 (p. 222) controls `gr^μ_M(J, R)` only for `μ ≤ μ^{(t)}(J)`; since
`gr_M(J, R)` is generated in these degrees (`exists_homogeneous_generators_le_mu`), a `K`-submodule
`T` of `gr¹_M(R)` with the property of Definition 6 up to `μ_t` satisfies
`gr_M(J, R) ⊆ (gr_M(J, R) ∩ K[T]) gr_M(R)` in all degrees. -/
@[blueprint "lem:I.4-dim-tau-gr-ideal"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$, $K=R/M$, $J$ an ideal
    of $R$, and $T$ a $K$-submodule of $\operatorname{gr}^1_M(R)$ with the property of
    Definition~6 up to $\mu_0=\mu^{(t)}(J)$ (\cref{def:III.6-property}). Then
    $\operatorname{gr}_M(J,R)\subseteq(\operatorname{gr}_M(J,R)\cap K[T])\operatorname{gr}_M(R)$.
    Gap filled: the paper uses the property for the whole ideal on p.~178. -/)
  (proof := /-- By \cref{lem:I.4-dim-tau-generators} the ideal $\operatorname{gr}_M(J,R)$ is
    generated by homogeneous elements $\varphi_j$ of degrees $\le\mu_t$; each lies in
    $\operatorname{gr}_M(J,R)$, hence, by the property of $T$ in its degree, in
    $(\operatorname{gr}_M(J,R)\cap K[T])\operatorname{gr}_M(R)$. -/)
  (proofUses := ["lem:I.4-dim-tau-generators"])
  (latexEnv := "lemma")]
theorem grIdeal_le_span_inter_adjoin
    (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)))
    (hT : IsTauSubmodule R J T (mu R J (t R J))) :
    grIdeal (maximalIdeal R) J ≤
      Ideal.span ((grIdeal (maximalIdeal R) J : Set (AssocGraded (maximalIdeal R))) ∩
        (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
          Set (AssocGraded (maximalIdeal R)))) := by
  obtain ⟨m, φ, hφJ, hφd, h₁⟩ := exists_homogeneous_generators_le_mu R J
  refine h₁.le.trans (Ideal.span_le.mpr ?_)
  rintro _ ⟨j, rfl⟩
  obtain ⟨d, hd, hdj⟩ := hφd j
  exact (hT.2 d hd (φ j) hdj).mp (hφJ j)

end DimLe

/-- Gap filled (algebra of polynomial rings): if `J₀` is a proper ideal of `K[X₁, …, X_τ]` and
`τ ≤ n`, then there is a field `L` and a surjective ring homomorphism
`K[X₁, …, X_n] → L[Y₁, …, Y_{n-τ}]` killing the polynomials of `J₀` (in the first `τ` variables).
Take a maximal ideal `𝔪 ⊇ J₀`, `L = K[X₁, …, X_τ]/𝔪`, and send `X_i` to the class of `X_i` for
`i ≤ τ` and `X_{τ+j}` to `Y_j`. -/
@[blueprint "lem:I.4-dim-tau-polynomial"
  (statement := /-- Let $K$ be a field, $\tau\le n$ and $J_0\ne(1)$ an ideal of
    $K[X_1,\dots,X_\tau]$. Then there are a field $L$ and a surjective ring homomorphism
    $K[X_1,\dots,X_n]\to L[Y_1,\dots,Y_{n-\tau}]$ which kills every polynomial of $J_0$ (in the
    first $\tau$ variables). Gap filled: the dimension count behind p.~178. -/)
  (proof := /-- Take a maximal ideal $\mathfrak m\supseteq J_0$ and $L=K[X_1,\dots,X_\tau]/
    \mathfrak m$. Send $X_i$ to the class of $X_i$ for $i\le\tau$ and $X_{\tau+j}$ to $Y_j$. The
    image contains the constants $L$ (every class is the image of a polynomial in the first $\tau$
    variables) and the $Y_j$, hence everything; $J_0$ goes to $0$ since $J_0\subseteq\mathfrak m$. -/)
  (latexEnv := "lemma")]
theorem exists_surjective_mvPolynomial_of_ne_top {K : Type u} [Field K] {τ n : ℕ} (hτn : τ ≤ n)
    (J₀ : Ideal (MvPolynomial (Fin τ) K)) (hJ₀ : J₀ ≠ ⊤) :
    ∃ (L : Type u) (_ : Field L) (g : MvPolynomial (Fin n) K →+* MvPolynomial (Fin (n - τ)) L),
      Function.Surjective g ∧
        ∀ p ∈ J₀, g (rename (Fin.castLE hτn) p) = 0 := by
  classical
  obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal J₀ hJ₀
  let _ : Field (MvPolynomial (Fin τ) K ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  let π : MvPolynomial (Fin τ) K →+* MvPolynomial (Fin τ) K ⧸ 𝔪 := Ideal.Quotient.mk 𝔪
  let L := MvPolynomial (Fin τ) K ⧸ 𝔪
  let f : K →+* MvPolynomial (Fin (n - τ)) L :=
    (MvPolynomial.C).comp (π.comp MvPolynomial.C)
  let v : Fin n → MvPolynomial (Fin (n - τ)) L := fun i =>
    if h : (i : ℕ) < τ then MvPolynomial.C (π (MvPolynomial.X ⟨i, h⟩))
    else MvPolynomial.X ⟨(i : ℕ) - τ, by omega⟩
  let g := MvPolynomial.eval₂Hom f v
  have hg : ∀ p : MvPolynomial (Fin τ) K, g (rename (Fin.castLE hτn) p) = MvPolynomial.C (π p) := by
    intro p
    have : g.comp (rename (Fin.castLE hτn)).toRingHom = (MvPolynomial.C).comp π := by
      refine MvPolynomial.ringHom_ext (fun k => ?_) (fun i => ?_)
      · simp [g, f]
      · simp [g, v, MvPolynomial.eval₂_X]
    exact DFunLike.congr_fun this p
  refine ⟨L, inferInstance, g, ?_, ?_⟩
  · intro b
    induction b using MvPolynomial.induction_on with
    | C a =>
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
      exact ⟨rename (Fin.castLE hτn) p, by rw [hg]⟩
    | add p q hp hq =>
      obtain ⟨p', rfl⟩ := hp
      obtain ⟨q', rfl⟩ := hq
      exact ⟨p' + q', by simp⟩
    | mul_X p j hp =>
      obtain ⟨p', rfl⟩ := hp
      refine ⟨p' * MvPolynomial.X ⟨τ + (j : ℕ), by omega⟩, ?_⟩
      simp [g, v]
  · intro p hp
    rw [hg]
    simp [π, Ideal.Quotient.eq_zero_iff_mem.mpr (hle hp)]

/-- Infrastructure: `AssocGraded.mk I n a ha` depends only on `a`, not on the proof `ha`, and
respects equalities of the argument `a`. -/
theorem AssocGraded.mk_congr_of_eq {A : Type*} [CommRing A] (I : Ideal A) (n : ℕ) {a b : A}
    (h : a = b) (ha : a ∈ I ^ n) (hb : b ∈ I ^ n) :
    AssocGraded.mk I n a ha = AssocGraded.mk I n b hb := by
  subst h; rfl

section DimLeCore

variable (R : Type u) [CommRing R] [IsRegularLocalRing R] (J : Ideal R)

/-- The argument behind the dimension fact of p. 178, for a system `y₁, …, y_n` of generators of `M`
(`n = dim R`) whose first `τ` elements `y_i = z_i` have the property of Definition 7: with
`gr_M(R) = K[X₁, …, X_n]` and `gr_M(J, R) = (gr_M(J, R) ∩ K[T]) gr_M(R)`, `T` spanned by the
classes of `y₁, …, y_τ`, the quotient `gr_M(R)/gr_M(J, R) = gr_M(R/J)` maps onto a polynomial ring
in `n − τ` variables over a field, so `dim gr_M(R/J) ≥ n − τ`; with `dim gr_M(R/J) = dim R/J` (the
"well-known" fact `hDG`, assumed, as in the paper) this is `dim R ≤ τ + dim R/J`.

Gaps filled (steps the paper does not print): `gr_M(R)` is the polynomial ring
(`assocGraded_maximalIdeal_aeval_bijective`, p. 225); `gr_M(R/J) = gr_M(R)/gr_M(J, R)`
(`grMapQuot_surjective`, `ker_grMapQuot`); the property of Definition 7 holds for all of `gr_M(J, R)`
(`grIdeal_le_span_inter_adjoin`); `gr_M(R/J)` is not the zero ring (from `hDG`, since `R/J ≠ 0`);
the polynomial dimension count (`exists_surjective_mvPolynomial_of_ne_top` and Mathlib's
`ringKrullDim_add_natCard_le_ringKrullDim_mvPolynomial`). -/
@[blueprint "lem:I.4-dim-tau-core"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$, $J\ne R$ an ideal,
    $y_1,\dots,y_n$ generators of $M$ with $n=\dim R$, $\tau\le n$, and suppose the $K$-span $T$
    of the classes of $y_1,\dots,y_\tau$ in $\operatorname{gr}^1_M(R)$ has the property of
    Definition~6 up to $\mu^{(t)}(J)$. If $\dim\operatorname{gr}_M(R/J)=\dim(R/J)$, then
    $\dim R\le\tau+\dim(R/J)$. (The argument behind p.~178; gap filled.) -/)
  (proof := /-- $\operatorname{gr}_M(R)\cong K[X_1,\dots,X_n]$ (p.~225) and
    $\operatorname{gr}_M(R/J)=\operatorname{gr}_M(R)/\operatorname{gr}_M(J,R)$. By
    \cref{lem:I.4-dim-tau-gr-ideal}, $\operatorname{gr}_M(J,R)$ is generated by elements of
    $K[T]=K[X_1,\dots,X_\tau]$; these form a proper ideal $J_0$ of $K[X_1,\dots,X_\tau]$, since
    $\operatorname{gr}_M(R/J)\ne0$ (as $\dim(R/J)\ge0$). By \cref{lem:I.4-dim-tau-polynomial},
    $\operatorname{gr}_M(R)$ maps onto $L[Y_1,\dots,Y_{n-\tau}]$ killing $\operatorname{gr}_M(J,R)$,
    so $\dim\operatorname{gr}_M(R/J)\ge n-\tau$, and $\dim R=n\le\tau+\dim(R/J)$. -/)
  (proofUses := ["lem:I.4-dim-tau-gr-ideal", "lem:I.4-dim-tau-polynomial"])
  (latexEnv := "lemma")]
theorem dim_le_tau_add_dim_quotient_of_isTauSubmodule {n τ : ℕ} (hn : τ ≤ n) (y : Fin n → R)
    (hspan : Ideal.span (Set.range y) = maximalIdeal R)
    (hncard : (n : WithBot ℕ∞) = ringKrullDim R) (hy1 : ∀ i, y i ∈ maximalIdeal R ^ 1)
    (hJ : J ≠ ⊤)
    (hDG : ringKrullDim (AssocGraded (Ideal.map (Ideal.Quotient.mk J) (maximalIdeal R))) =
      ringKrullDim (R ⧸ J))
    (hT : IsTauSubmodule R J
      (Submodule.span (R ⧸ maximalIdeal R)
        (Set.range fun i : Fin τ => AssocGraded.mk (maximalIdeal R) 1 (y (Fin.castLE hn i))
          (hy1 _))) (mu R J (t R J))) :
    ringKrullDim R ≤ (τ : WithBot ℕ∞) + ringKrullDim (R ⧸ J) := by
  classical
  have hIle := grIdeal_le_span_inter_adjoin R J _ hT
  have hbij := assocGraded_maximalIdeal_aeval_bijective hspan hncard hy1
  set M := maximalIdeal R with hM
  -- `gr_M(R/J)` is not the zero ring: its dimension is that of the non-zero ring `R/J`
  have hnt : Nontrivial (AssocGraded (Ideal.map (Ideal.Quotient.mk J) M)) := by
    by_contra hcon
    rw [not_nontrivial_iff_subsingleton] at hcon
    have h1 := ringKrullDim_eq_bot_of_subsingleton
      (R := AssocGraded (Ideal.map (Ideal.Quotient.mk J) M))
    have : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
    have h2 : (0 : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ J) := ringKrullDim_nonneg_of_nontrivial
    rw [← hDG, h1] at h2
    exact absurd h2 (by simp)
  -- `gr_M(R/J) = gr_M(R)/gr_M(J, R)`: the surjection `grMapQuot` has kernel `grIdeal`
  set G := AssocGraded M with hG
  set I := grIdeal M J with hI
  set grQ := AssocGraded (Ideal.map (Ideal.Quotient.mk J) M) with hgrQ
  have hsurj : Function.Surjective (grMapQuot M J) := grMapQuot_surjective M J
  let eqv : G ⧸ I ≃+* grQ :=
    (Ideal.quotEquivOfEq (ker_grMapQuot M J).symm).trans
      (RingHom.quotientKerEquivOfSurjective (f := (grMapQuot M J : G →+* grQ)) hsurj)
  have hIne : I ≠ ⊤ := by
    have : Nontrivial (G ⧸ I) := eqv.toEquiv.nontrivial
    exact Ideal.Quotient.nontrivial_iff.mp this
  let _ : Field (R ⧸ M) := Ideal.Quotient.field M
  -- `gr_M(R) = K[X₁, …, X_n]`, `X_i ↦ [y_i]` (p. 225)
  let Φ : MvPolynomial (Fin n) (R ⧸ M) →ₐ[R ⧸ M] G :=
    MvPolynomial.aeval fun i => AssocGraded.mk M 1 (y i) (hy1 i)
  let e : MvPolynomial (Fin n) (R ⧸ M) ≃ₐ[R ⧸ M] G := AlgEquiv.ofBijective Φ hbij
  let ι : MvPolynomial (Fin τ) (R ⧸ M) →ₐ[R ⧸ M] G :=
    Φ.comp (MvPolynomial.rename (Fin.castLE hn))
  have hιe : ∀ p, e (MvPolynomial.rename (Fin.castLE hn) p) = ι p := fun p => rfl
  -- `K[T]`, the subalgebra generated by `T`, is the range of `ι`
  have hadj : (Algebra.adjoin (R ⧸ M) (Submodule.span (R ⧸ M)
      (Set.range fun i : Fin τ => AssocGraded.mk M 1 (y (Fin.castLE hn i)) (hy1 _)) :
        Set G) : Set G) = Set.range ι := by
    rw [Algebra.adjoin_span]
    have hS : Set.range (fun i : Fin τ => AssocGraded.mk M 1 (y (Fin.castLE hn i)) (hy1 _)) =
        Set.range (fun i : Fin τ => Φ (MvPolynomial.X (Fin.castLE hn i))) := by
      simp [Φ]
    rw [hS, Algebra.adjoin_range_eq_range_aeval]
    have hι : ι = MvPolynomial.aeval fun i : Fin τ => Φ (MvPolynomial.X (Fin.castLE hn i)) := by
      refine MvPolynomial.algHom_ext fun i => ?_
      simp [ι]
    rw [hι]
    rfl
  -- the ideal `J₀` of `K[X₁, …, X_τ]` of the polynomials whose image lies in `gr_M(J, R)`
  let J₀ : Ideal (MvPolynomial (Fin τ) (R ⧸ M)) := Ideal.comap (ι : _ →+* G) I
  have hJ₀ : J₀ ≠ ⊤ := by
    intro h
    apply hIne
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : MvPolynomial (Fin τ) (R ⧸ M)) ∈ J₀ := by rw [h]; trivial
    simpa [J₀] using h1
  obtain ⟨L, hL, g', hg'surj, hg'ker⟩ := exists_surjective_mvPolynomial_of_ne_top hn J₀ hJ₀
  have hLdim : ringKrullDim L = 0 := ringKrullDim_eq_zero_of_field L
  let g : G →+* MvPolynomial (Fin (n - τ)) L := g'.comp (e.symm : G ≃+* _).toRingHom
  have hgsurj : Function.Surjective g := hg'surj.comp e.symm.surjective
  -- `gr_M(J, R) = (gr_M(J, R) ∩ K[T]) gr_M(R)` is killed by `g`
  have hker : I ≤ RingHom.ker g := by
    refine hIle.trans (Ideal.span_le.mpr ?_)
    rintro x ⟨hxI, hxA⟩
    have hxA' : x ∈ Set.range ι := by rwa [← hadj]
    obtain ⟨p, rfl⟩ := hxA'
    have hp : p ∈ J₀ := hxI
    rw [SetLike.mem_coe, RingHom.mem_ker]
    have : e.symm (ι p) = MvPolynomial.rename (Fin.castLE hn) p :=
      (AlgEquiv.symm_apply_eq e).mpr (hιe p).symm
    simp only [g, RingHom.comp_apply]
    exact (congrArg g' this).trans (hg'ker p hp)
  let gbar : G ⧸ I →+* MvPolynomial (Fin (n - τ)) L := Ideal.Quotient.lift I g
    (fun a ha => hker ha)
  have hgbar : Function.Surjective gbar :=
    Ideal.Quotient.lift_surjective_of_surjective I _ hgsurj
  have h1 : ringKrullDim (MvPolynomial (Fin (n - τ)) L) ≤ ringKrullDim (G ⧸ I) :=
    ringKrullDim_le_of_surjective gbar hgbar
  have h2 : ringKrullDim (G ⧸ I) = ringKrullDim grQ := ringKrullDim_eq_of_ringEquiv eqv
  have h4 := ringKrullDim_add_natCard_le_ringKrullDim_mvPolynomial (R := L) (Fin (n - τ))
  rw [hLdim, zero_add, Nat.card_eq_fintype_card, Fintype.card_fin] at h4
  rw [← hncard]
  have hnτ : (n : WithBot ℕ∞) = (τ : WithBot ℕ∞) + ((n - τ : ℕ) : WithBot ℕ∞) := by
    exact_mod_cast (Nat.add_sub_cancel' hn).symm
  rw [hnτ]
  exact add_le_add_right (h4.trans (h1.trans (h2.trans hDG).le)) _

end DimLeCore

/-- The dimension fact of p. 178 (`DimLeTauAddDimQuotient`): "if J is an ideal in a regular local ring
R which is different from R and if (z₁, ⋯, z_τ) is a regular system of τ-parameters of R for J, then
dim(R) ≦ τ + dim(R/J).  (This follows from the fact that if M is the maximal ideal of R, then
dim(gr_M(R/J)) = dim(R/J), which is well-known.)"

The printed argument is the one sentence "This follows from the fact that …": the hypothesis
`hdim` is that fact (`DimAssocGradedQuotient`), stated without proof or citation (p. 178: "which is
well-known"); assumed, as in the paper.  The steps the paper does not print are gaps filled, proved
in the lemmas above: the regular system `z` extends to a regular system of parameters
(`IsRegularSystemOfTauParameters.exists_isRegularSystemOfParameters`, p. 223), `gr_M(R)` is a
polynomial ring, `gr_M(J, R)` is generated by forms in `K[T]` (all degrees), and the dimension count
of `dim_le_tau_add_dim_quotient_of_isTauSubmodule`.  For `J = 0` (`t(J) = 0`, the junk value
`tau R J 0`, see `DimLeTauAddDimQuotient`) the statement is `dim R ≦ dim R`. -/
theorem dimLeTauAddDimQuotient_of_dimAssocGradedQuotient (hdim : DimAssocGradedQuotient.{u}) :
    DimLeTauAddDimQuotient.{u} := by
  intro R _ _ J hJ z hz
  classical
  have hDG := hdim R J hJ
  by_cases ht : t R J = 0
  · -- `t(J) = 0` forces `J = 0`
    have hJ0 : J = ⊥ := by
      by_contra hJb
      obtain ⟨μ, hμ⟩ := (muSet_finite R J).2 hJb
      have : 0 < (muSet R J).ncard := (Set.ncard_pos (muSet_finite R J).1).mpr ⟨μ, hμ⟩
      exact absurd ht (by unfold t; omega)
    subst hJ0
    have hd : ringKrullDim (R ⧸ (⊥ : Ideal R)) = ringKrullDim R :=
      ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot R)
    rw [hd]
    exact le_add_of_nonneg_left (by exact_mod_cast Nat.zero_le _)
  have ht1 : 1 ≤ t R J := Nat.pos_of_ne_zero ht
  have hT := hz (t R J) ht1 le_rfl
  obtain ⟨n, hn, y, hyinj, hyz, hrsop⟩ :=
    IsRegularSystemOfTauParameters.exists_isRegularSystemOfParameters R J (t R J) ht1 le_rfl z hz
  have hspan : Ideal.span (Set.range y) = maximalIdeal R := by
    have := hrsop.1
    rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ] at this
  have hncard : (n : WithBot ℕ∞) = ringKrullDim R := by
    have := hrsop.2
    rwa [Finset.card_image_of_injective _ hyinj, Finset.card_univ, Fintype.card_fin] at this
  have hy1 : ∀ i, y i ∈ maximalIdeal R ^ 1 := fun i => by
    rw [pow_one, ← hspan]; exact Ideal.subset_span ⟨i, rfl⟩
  refine dim_le_tau_add_dim_quotient_of_isTauSubmodule R J hn y hspan hncard hy1 hJ hDG ?_
  convert hT using 3
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨⟨i, i.2⟩, AssocGraded.mk_congr_of_eq _ 1 (hyz i).symm _ _⟩
  · rintro ⟨⟨i, hi⟩, rfl⟩
    exact ⟨i, AssocGraded.mk_congr_of_eq _ 1 (hyz i) _ _⟩

/-! ### Footnote 38 (p. 180): "hence, by (a), `B_{r-1} = W_{r-1}`" -/

/-- Footnote 38, the step "hence, by (a), `B_{r−1} = W_{r−1}`": if `B ⊆ W` (the property (a): `B_{r−1}`
is a subscheme of `W_{r−1}`) and `B ⊇ W`, then `B = W`.  Containment of subschemes is containment of
ideal sheaves (p. 165). -/
theorem Subscheme.eq_of_isContainedIn_of_isContainedIn {X : Scheme.{u}} {B W : Subscheme X}
    (hBW : B.IsContainedIn W) (hWB : W.IsContainedIn B) : B = W :=
  Scheme.IdealSheafData.ext (funext fun U => le_antisymm (hWB U) (hBW U))

/-- Footnote 38 (p. 180): "This assertion (d) is equivalent to saying that B_{r−1} ⊇ W_{r−1}
(hence, by (a), B_{r−1} = W_{r−1})."  This is the step "hence, by (a)": for a succession with the
properties (a), (b), (c) of Main Theorem III(N, n) (`IsMainIIISteps`), if `B_{r−1} ⊇ W_{r−1}` then
`B_{r−1} = W_{r−1}`.

Only the property (a) at the last step is used: it gives `B_{r−1} ⊆ W_{r−1}`, and with
`B_{r−1} ⊇ W_{r−1}` the antisymmetry of containment gives the equality
(`Subscheme.eq_of_isContainedIn_of_isContainedIn`).  Gap filled: the induction along the succession
that reaches the last step, carrying `J_i`, `E_i`, `W_i`, is not printed (the paper's `B_{r−1}`,
`W_{r−1}` are the last center and the strict transform of `W` before it).  The equivalence of (d)
with `B_{r−1} ⊇ W_{r−1}` is stated without argument and is not proved here. -/
theorem MonoidalSuccession.lastStep_eq_of_isMainIIISteps :
    ∀ {X Y : Scheme.{u}} (s : MonoidalSuccession X Y) (J E W : Subscheme X),
      s.IsMainIIISteps J E W →
      s.LastStep (fun {_} B W' => W'.IsContainedIn B) W →
      s.LastStep (fun {_} B W' => B = W') W
  | _, _, .nil _, _, _, _, _, hc => hc
  | _, _, .cons B _ (.nil _), _, _, _, h, hc =>
      Subscheme.eq_of_isContainedIn_of_isContainedIn h.1.2.1 hc
  | _, _, .cons _ _ (.cons B' t' rest'), _, _, _, h, hc =>
      MonoidalSuccession.lastStep_eq_of_isMainIIISteps (.cons B' t' rest') _ _ _ h.2.2.2 hc

end Hironaka

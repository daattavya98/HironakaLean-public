/-!
# `Z ⊆ T(f)` implies `W ⊆ T(g)` for the strict transforms (Lemma 21, hypothesis (11))

Infrastructure for claim (B) of Theorem 9 (p. 274) and its use of Lemma 21 along a sequence of
monoidal transforms.  Lemma 21 (p. 256) assumes (11) `τ(f_1, ..., f_i) = r`; to apply it again at the
next stage of a sequence one needs (11) for `g_j = x^{-ν_j} f_j` and the frame transform
`(S_1; w)`, which the paper does not mention (p. 257 only says "(11) implies that
`τ(g_1, ..., g_i) = r`" inside the proof of Lemma 21).

* `isTauZSubmodule_map_frameAlgHom`, `poly_of_isTauZSubmodule_frameAlgHom`: the dictionary between
  the spaces `T` of Definition 10* contained in `<Z>` and the spaces `L` of linear forms of the
  polynomial ring `k[Z_1, ..., Z_r]` (`frameAlgHom`, with a retraction `gr_M(A) -> k[Z]`).
* `RegularFrame.FrameTransform.frameForm_mem_tauZSubmodule`: if `psi_j = phi_j(W)` (the polynomials
  of `FrameTransform.exists_polynomials_initialForm`) and `Z_l ∈ T(f)`, then `W_l ∈ T(g)`; the
  descent of the minimal space along the extension `k -> k_1` of residue fields is Lemma 12
  (`isTauSubmoduleMv_map_iff`, `R_1` is residually separable over `R`).
-/

@[expose] public section

open IsLocalRing MvPolynomial

namespace Hironaka

universe u

section Bridge

attribute [local instance] Ideal.Quotient.field

variable {A : Type u} [CommRing A] [IsRegularLocalRing A] {r : ℕ} {z : Fin r → A}

/-- `frameAlgHom` is graded for a system of elements of order one. -/
theorem frameAlgHom_mem_homogeneous
    (hord : ∀ l, Ideal.ordElem (maximalIdeal A) (z l) = ((1 : ℕ) : ℕ∞))
    {p : MvPolynomial (Fin r) (A ⧸ maximalIdeal A)} {d : ℕ} (hp : p.IsHomogeneous d) :
    frameAlgHom z p ∈ AssocGraded.homogeneous (maximalIdeal A) d := by
  have hz : ∀ l, z l ∈ maximalIdeal A ^ 1 := fun l => Ideal.mem_pow_of_ordElem (hord l)
  have h := AssocGraded.aeval_mem_homogeneous (maximalIdeal A) z hz hp
  have heq : frameForm z = fun v => AssocGraded.mk (maximalIdeal A) 1 (z v) (hz v) :=
    funext fun v => initialForm_eq_mk _ (hord v)
  simpa only [frameAlgHom, heq] using h

/-- **From polynomial spaces to spaces of linear forms** (the dictionary between `k[Z]` and
`gr_M(A)` for a system of order-one elements `z`): a space `L` of linear forms of the polynomial
ring `k[Z₁, …, Z_r]` for which the ideal `I = (P_j)` is generated by elements of `k[L]` gives the
space `frameAlgHom z (L)` with the property of Definition 10* for the system `(f_j)` whose
initial forms are `P_j(Z)`. -/
theorem isTauZSubmodule_map_frameAlgHom
    (hord : ∀ l, Ideal.ordElem (maximalIdeal A) (z l) = ((1 : ℕ) : ℕ∞)) {i : ℕ} (f : Fin i → A)
    (P : Fin i → MvPolynomial (Fin r) (A ⧸ maximalIdeal A))
    (hP : ∀ j, frameAlgHom z (P j) = initialForm (maximalIdeal A) (f j))
    (L : Submodule (A ⧸ maximalIdeal A) (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))
    (hL : L ≤ homogeneousSubmodule (Fin r) (A ⧸ maximalIdeal A) 1)
    (h : Ideal.span (Set.range P) ≤ Ideal.span ((Ideal.span (Set.range P) :
      Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) ∩
        (Algebra.adjoin (A ⧸ maximalIdeal A) (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) :
          Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))))) :
    IsTauZSubmodule A f (L.map (frameAlgHom z).toLinearMap) := by
  classical
  refine ⟨?_, ?_⟩
  · rintro _ ⟨p, hp, rfl⟩
    exact frameAlgHom_mem_homogeneous hord (hL hp)
  · set K : Ideal (AssocGraded (maximalIdeal A)) :=
      Ideal.span (Set.range fun j => initialForm (maximalIdeal A) (f j)) with hK
    set I₀ : Ideal (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)) := Ideal.span (Set.range P)
      with hI₀
    have hΘI : ∀ q ∈ I₀, frameAlgHom z q ∈ K := by
      intro q hq
      have : I₀ ≤ Ideal.comap (frameAlgHom z : MvPolynomial (Fin r) (A ⧸ maximalIdeal A) →+*
          AssocGraded (maximalIdeal A)) K := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_comap]
        show frameAlgHom z (P j) ∈ K
        rw [hP j]
        exact Ideal.subset_span ⟨j, rfl⟩
      exact this hq
    refine le_antisymm (Ideal.span_le.mpr fun x hx => hx.1) ?_
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    have hmem : P j ∈ Ideal.span ((I₀ : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) ∩
        (Algebra.adjoin (A ⧸ maximalIdeal A) (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) :
          Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))) := h (Ideal.subset_span ⟨j, rfl⟩)
    have h1 := Ideal.mem_map_of_mem (frameAlgHom z : MvPolynomial (Fin r) (A ⧸ maximalIdeal A) →+*
      AssocGraded (maximalIdeal A)) hmem
    rw [Ideal.map_span] at h1
    rw [SetLike.mem_coe]
    have h2 : (frameAlgHom z) (P j) = initialForm (maximalIdeal A) (f j) := hP j
    have h3 : Ideal.span ((frameAlgHom z : MvPolynomial (Fin r) (A ⧸ maximalIdeal A) →+*
        AssocGraded (maximalIdeal A)) '' ((I₀ : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) ∩
          (Algebra.adjoin (A ⧸ maximalIdeal A)
          (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) :
            Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))))) ≤
        Ideal.span ((K : Set (AssocGraded (maximalIdeal A))) ∩ (Algebra.adjoin
            (A ⧸ maximalIdeal A) ((L.map (frameAlgHom z).toLinearMap : Submodule _ _) :
              Set (AssocGraded (maximalIdeal A))) : Set (AssocGraded (maximalIdeal A)))) := by
      refine Ideal.span_mono ?_
      rintro _ ⟨q, ⟨hq1, hq2⟩, rfl⟩
      refine ⟨hΘI q hq1, ?_⟩
      have : (frameAlgHom z) q ∈ (Algebra.adjoin (A ⧸ maximalIdeal A)
          (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))).map
          (frameAlgHom z) := Subalgebra.mem_map.mpr ⟨q, hq2, rfl⟩
      rw [AlgHom.map_adjoin] at this
      refine Algebra.adjoin_mono ?_ this
      rintro _ ⟨p, hp, rfl⟩
      exact ⟨p, hp, rfl⟩
    show initialForm (maximalIdeal A) (f j) ∈ _
    rw [← h2]
    exact h3 h1

/-- **From spaces of linear forms to polynomial spaces** (the converse of
`isTauZSubmodule_map_frameAlgHom`): a space `T ⊆ ⟨Z⟩` with the property of Definition 10* for
`(f_j)`, the initial forms of which are `P_j(Z)`, pulls back under `frameAlgHom z` to a space `L`
of linear forms of `k[Z₁, …, Z_r]` for which the ideal `(P_j)` is generated by elements of `k[L]`
(a left inverse `π` of `frameAlgHom z` is used to come back from `gr_M(A)` to `k[Z]`). -/
theorem poly_of_isTauZSubmodule_frameAlgHom {i : ℕ} (f : Fin i → A)
    (P : Fin i → MvPolynomial (Fin r) (A ⧸ maximalIdeal A))
    (hP : ∀ j, frameAlgHom z (P j) = initialForm (maximalIdeal A) (f j))
    (π : AssocGraded (maximalIdeal A) →ₐ[A ⧸ maximalIdeal A]
      MvPolynomial (Fin r) (A ⧸ maximalIdeal A)) (hπ : ∀ Q, π (frameAlgHom z Q) = Q)
    {T : Submodule (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A))}
    (hTz : T ≤ Submodule.span (A ⧸ maximalIdeal A) (Set.range (frameForm z)))
    (hT : IsTauZSubmodule A f T) :
    T.comap (frameAlgHom z).toLinearMap ≤ homogeneousSubmodule (Fin r) (A ⧸ maximalIdeal A) 1 ∧
      Ideal.span (Set.range P) ≤ Ideal.span ((Ideal.span (Set.range P) :
        Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) ∩
          (Algebra.adjoin (A ⧸ maximalIdeal A) ((T.comap (frameAlgHom z).toLinearMap :
            Submodule _ _) : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) :
              Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))) := by
  classical
  set Θ := frameAlgHom z with hΘ
  set L := T.comap Θ.toLinearMap with hL
  have hspanZ : Submodule.span (A ⧸ maximalIdeal A) (Set.range (frameForm z)) =
      (Submodule.span (A ⧸ maximalIdeal A)
        (Set.range (X : Fin r → MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))).map Θ.toLinearMap := by
    rw [Submodule.map_span, ← Set.range_comp]
    congr 1
    ext t
    simp [Θ, frameAlgHom]
  -- every element of `T` is the image of an element of `L`
  have hTL : ∀ t ∈ T, ∃ q ∈ L, Θ q = t ∧ q ∈ homogeneousSubmodule (Fin r)
      (A ⧸ maximalIdeal A) 1 := by
    intro t ht
    have := hTz ht
    rw [hspanZ] at this
    obtain ⟨q, hq, hqt⟩ := this
    refine ⟨q, ?_, hqt, ?_⟩
    · show Θ q ∈ T
      exact hqt ▸ ht
    · rw [homogeneousSubmodule_one_eq_span_X]
      exact hq
  refine ⟨fun p hp => ?_, ?_⟩
  · obtain ⟨q, hqL, hqt, hq1⟩ := hTL (Θ p) hp
    have : p = q := by rw [← hπ p, ← hπ q]; exact congrArg π (hqt.symm)
    rw [this]
    exact hq1
  · set K : Ideal (AssocGraded (maximalIdeal A)) :=
      Ideal.span (Set.range fun j => initialForm (maximalIdeal A) (f j)) with hK
    set I₀ : Ideal (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)) := Ideal.span (Set.range P)
      with hI₀
    have hπK : ∀ x ∈ K, π x ∈ I₀ := by
      intro x hx
      have : K ≤ Ideal.comap (π : AssocGraded (maximalIdeal A) →+*
          MvPolynomial (Fin r) (A ⧸ maximalIdeal A)) I₀ := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_comap]
        show π (initialForm (maximalIdeal A) (f j)) ∈ I₀
        rw [← hP j, hπ]
        exact Ideal.subset_span ⟨j, rfl⟩
      exact this hx
    have hadj : ∀ x ∈ Algebra.adjoin (A ⧸ maximalIdeal A)
        (T : Set (AssocGraded (maximalIdeal A))), π x ∈ Algebra.adjoin (A ⧸ maximalIdeal A)
          (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) := by
      intro x hx
      have hsub : (T : Set (AssocGraded (maximalIdeal A))) ⊆ Θ '' (L : Set _) := by
        intro t ht
        obtain ⟨q, hqL, hqt, -⟩ := hTL t ht
        exact ⟨q, hqL, hqt⟩
      have hx' : x ∈ (Algebra.adjoin (A ⧸ maximalIdeal A)
          (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))).map Θ := by
        rw [AlgHom.map_adjoin]
        exact Algebra.adjoin_mono hsub hx
      obtain ⟨q, hq, rfl⟩ := Subalgebra.mem_map.mp hx'
      rw [hπ]
      exact hq
    have key : ∀ x ∈ Ideal.span ((K : Set (AssocGraded (maximalIdeal A))) ∩
        (Algebra.adjoin (A ⧸ maximalIdeal A) (T : Set (AssocGraded (maximalIdeal A))) :
          Set (AssocGraded (maximalIdeal A)))), π x ∈ Ideal.span ((I₀ : Set (MvPolynomial
          (Fin r) (A ⧸ maximalIdeal A))) ∩ (Algebra.adjoin (A ⧸ maximalIdeal A)
            (L : Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A))) :
              Set (MvPolynomial (Fin r) (A ⧸ maximalIdeal A)))) := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx => exact Ideal.subset_span ⟨hπK x hx.1, hadj x hx.2⟩
      | zero => rw [map_zero]; exact zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | smul c x _ hx => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hx
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    have hφ : initialForm (maximalIdeal A) (f j) ∈ Ideal.span ((K : Set (AssocGraded
        (maximalIdeal A))) ∩ (Algebra.adjoin (A ⧸ maximalIdeal A)
          (T : Set (AssocGraded (maximalIdeal A))) : Set (AssocGraded (maximalIdeal A)))) := by
      rw [hT.2]
      exact Ideal.subset_span ⟨j, rfl⟩
    have := key _ hφ
    rw [← hP j, hπ] at this
    exact this

end Bridge

section Transport

attribute [local instance] Ideal.Quotient.field
attribute [local instance] RegularFrame.isDomain_S
attribute [local instance] MvPolynomial.gradedAlgebra

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {F : RegularFrame R} {T : MonoidalTransform R P} [IsLocalHom T.toRing]
  [IsRegularLocalRing T.ring]

/-- **`Z₁, …, Z_r ∈ T(f)` implies `W₁, …, W_r ∈ T(g)`** (condition (11) of Lemma 21, p. 256, and
its transport to the strict transforms, p. 257: "(11) implies that `τ(g₁, …, g_i) = r`"): if
`ψ_j = φ_j(W)` for the initial forms of `f_j` and `g_j = x^{-ν_j} f_j` (as supplied by
`τ_{(z)}(f_j) = 0 = τ_{(w)}(g_j)`, `FrameTransform.exists_polynomials_initialForm`), and `R₁` is
residually separable over `R`, the spaces `T` of Definition 10* for `(f_j)` and `(g_j)` correspond
under the extension of the residue field `k → k₁` (Lemma 12, `isTauSubmoduleMv_map_iff`). -/
theorem RegularFrame.FrameTransform.frameForm_mem_tauZSubmodule [Hironaka.HironakaCitedResults.{u}] (FT : F.FrameTransform T)
    (x : F.S) (h7' : FT.x = T.toRing (algebraMap F.S R x)) (hx0 : FT.TS.toRing x ≠ 0)
    (hsep : RingHom.IsResiduallySeparableAlgebraic (R := R) (R' := T.ring) T.toRing)
    {i : ℕ} (f : Fin i → R) (g : Fin i → T.ring) (ν : Fin i → ℕ)
    (hf : ∀ j, Ideal.ordElem (maximalIdeal R) (f j) = ν j)
    (h2 : ∀ j, tauZ R F.z (fun _ : Fin 1 => f j) = 0)
    (hg : ∀ j, FT.x ^ ν j * g j = T.toRing (f j))
    (hgM : ∀ j, Ideal.ordElem (maximalIdeal T.ring) (g j) = ν j)
    (h8 : ∀ j, tauZ T.ring FT.w (fun _ : Fin 1 => g j) = 0)
    (hZ : ∀ l, frameForm F.z l ∈ tauZSubmodule R f) :
    ∀ l, frameForm FT.w l ∈ tauZSubmodule T.ring g := by
  classical
  intro l
  obtain ⟨Pf, hPh, hPf, hPg⟩ := FT.exists_polynomials_initialForm x h7' hx0 f g ν hf h2 hg hgM h8
  obtain ⟨-, hordz⟩ := linearIndependent_frameForm F.z_injective F.extends_rsop
  obtain ⟨π, hπ⟩ := F.exists_retraction_frameAlgHom
  obtain ⟨π₁, hπ₁⟩ := FT.toRegularFrame.exists_retraction_frameAlgHom
  obtain ⟨-, hordw⟩ := linearIndependent_frameForm FT.toRegularFrame.z_injective
    FT.toRegularFrame.extends_rsop
  have hordw' : ∀ l, Ideal.ordElem (maximalIdeal T.ring) (FT.w l) = ((1 : ℕ) : ℕ∞) := hordw
  set κ := quotientMaximalIdealMap T.toRing with hκ
  let _ : Algebra (R ⧸ maximalIdeal R) (T.ring ⧸ maximalIdeal T.ring) := κ.toAlgebra
  have hsepF : IsSeparableFieldExtension (R ⧸ maximalIdeal R) (T.ring ⧸ maximalIdeal T.ring) :=
    hsep.isResiduallySeparable
  set μb : ℕ := ∑ j, ν j + 1 with hμb
  have hνμ : ∀ j, ν j ≤ μb := fun j =>
    (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)).trans (Nat.le_succ _)
  -- `T(g) ⊆ ⟨W⟩`
  have hT₁ := tauZSubmodule_spec T.ring g
  have hT₁le : tauZSubmodule T.ring g ≤ Submodule.span (T.ring ⧸ maximalIdeal T.ring)
      (Set.range (frameForm FT.w)) := by
    refine tauZSubmodule_le_of_forall_mem_adjoin g _ ?_ fun j => ?_
    · rw [Submodule.span_le]
      rintro _ ⟨l, rfl⟩
      show initialForm (maximalIdeal T.ring) (FT.w l) ∈ _
      rw [initialForm_eq_mk _ (hordw' l)]
      exact AssocGraded.mk_mem_homogeneous _ _
    · have h := FT.toRegularFrame.initialForm_mem_adjoin_of_tauZ_eq_zero (g j) (h8 j)
      exact Algebra.adjoin_mono Submodule.subset_span h
  set L₁ : Submodule (T.ring ⧸ maximalIdeal T.ring) (MvPolynomial (Fin F.r)
    (T.ring ⧸ maximalIdeal T.ring)) := (tauZSubmodule T.ring g).comap
      (frameAlgHom FT.w).toLinearMap with hL₁
  obtain ⟨hL₁h, hL₁I⟩ := poly_of_isTauZSubmodule_frameAlgHom g
    (fun j => MvPolynomial.map κ (Pf j)) hPg π₁ hπ₁ hT₁le hT₁
  -- the ideals `I₀ = (P_j) ⊆ k[Z]`, `I₁ = (κ P_j) ⊆ k₁[W]`
  set I₀ : Ideal (MvPolynomial (Fin F.r) (R ⧸ maximalIdeal R)) := Ideal.span (Set.range Pf)
    with hI₀
  have hI₀h : I₀.IsHomogeneous (homogeneousSubmodule (Fin F.r) (R ⧸ maximalIdeal R)) := by
    apply Ideal.homogeneous_span
    rintro q ⟨j, rfl⟩
    exact ⟨ν j, hPh j⟩
  have hI₁ : Ideal.span (Set.range fun j => MvPolynomial.map κ (Pf j)) =
      I₀.map (MvPolynomial.map (algebraMap (R ⧸ maximalIdeal R) (T.ring ⧸ maximalIdeal T.ring))) := by
    rw [hI₀, Ideal.map_span, ← Set.range_comp]
    rfl
  have hmv₁ : IsTauSubmoduleMv (T.ring ⧸ maximalIdeal T.ring) F.r
      (I₀.map (MvPolynomial.map (algebraMap (R ⧸ maximalIdeal R)
        (T.ring ⧸ maximalIdeal T.ring)))) L₁ μb := by
    rw [← hI₁]
    exact (isTauSubmoduleMv_iff_of_generators _ (fun j => MvPolynomial.map κ (Pf j)) ν rfl
      (fun j => (mem_homogeneousSubmodule _ _).mpr ((hPh j).map κ)) μb hνμ L₁).mpr ⟨hL₁h, hL₁I⟩
  have hmv := (isTauSubmoduleMv_map_iff (R ⧸ maximalIdeal R) hsepF I₀ hI₀h L₁ hL₁h μb
    (Nat.succ_pos _)).mp hmv₁
  obtain ⟨hLh, hLI⟩ := (isTauSubmoduleMv_iff_of_generators I₀ Pf ν rfl
    (fun j => (mem_homogeneousSubmodule _ _).mpr (hPh j)) μb hνμ _).mp hmv
  have hTL := isTauZSubmodule_map_frameAlgHom hordz f Pf hPf _ hLh hLI
  have hle : tauZSubmodule R f ≤ (linearFormsOver (R ⧸ maximalIdeal R) L₁).map
      (frameAlgHom F.z).toLinearMap := sInf_le hTL
  obtain ⟨p, hpL, hpl⟩ := hle (hZ l)
  have hpX : p = X l := by
    rw [← hπ p, ← hπ (X l)]
    congr 1
    rw [show (frameAlgHom F.z) (X l) = frameForm F.z l by simp [frameAlgHom]]
    exact hpl
  rw [hpX] at hpL
  have hXl : (X l : MvPolynomial (Fin F.r) (T.ring ⧸ maximalIdeal T.ring)) ∈ L₁ := by
    have := hpL.1
    simpa using this
  have := hXl
  rw [hL₁] at this
  simpa [frameAlgHom] using this

end Transport

end Hironaka

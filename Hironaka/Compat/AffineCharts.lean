module

public import Mathlib.AlgebraicGeometry.Modules.Tilde
public import Mathlib.RingTheory.Localization.Finiteness
public import Hironaka.Compat.OModulesRestrict
public import Hironaka.Compat.RModuleRestrict
public import Hironaka.Ch0.BlowingUpProj

/-!
# Affine charts of quasi-coherent `ℛ`-modules

Infrastructure used in the derivation of assertions (a) and (b) of p. 124 of the paper; it proves no claim of the
paper.  On a prescheme `X` every point has an affine open neighbourhood `V` (`exists_affine_restrict`), a
quasi-coherent module on `Spec A` is `J~` for an `A`-module `J` (`exists_iso_tilde`), and `J` is finitely generated
when `J~` is coherent, i.e. of finite presentation (`finite_of_isCoherent_tilde`).  Together they give the local
form `M|V ≅ S(A, J)` of a quasi-coherent `ℛ`-module `M = (X, J)` on a prescheme (`RModule.exists_affine_chart`),
with `J` finitely generated if `M` is coherent.

The proof of `finite_of_isCoherent_tilde` has three steps.  A module of finite presentation on `Spec A` is, on each
member of a finite cover by basic opens `D(g)`, generated by finitely many sections (the argument of Mathlib's
`Scheme.Modules.exists_isOpenCover_presentation`, keeping track of finiteness).  A quasi-coherent module `N` on
`Spec B` with finitely many generating sections has finitely generated sections `Γ(N)` (`tilde` is fully faithful,
so it reflects epimorphisms).  Finally `Module.Finite.of_localizationSpan_finite'` glues the finite generation of the
modules of sections over the `D(g)`, which are the localizations `J_g`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite
open Hironaka ProjDegreeOne

noncomputable section

universe u

namespace Hironaka.AffineCharts

open Limits Scheme.Modules in
set_option backward.isDefEq.respectTransparency false in
/-- A sheaf of modules of finite type on a scheme is, on the members of an affine open cover, generated by finitely
many sections (restricted along the inclusions of the members).  It is the argument of Mathlib's
`Scheme.Modules.exists_isOpenCover_presentation`, keeping track of finiteness. -/
lemma exists_isOpenCover_generators {X : Scheme.{u}} (M : X.Modules)
    [SheafOfModules.IsFiniteType.{u, u, u} M] :
    ∃ (ι : Type u) (U : ι → X.Opens) (G : ∀ i, (M.restrict (U i).ι).GeneratingSections),
      (∀ i, (G i).IsFiniteType) ∧ IsOpenCover U ∧ (∀ i, IsAffineOpen (U i)) := by
  obtain ⟨⟨I, W, cov, gens⟩, hfin⟩ := SheafOfModules.IsFiniteType.exists_localGeneratorsData (M := M)
  choose κ hsub heq using fun i ↦ Opens.isBasis_iff_cover.mp X.isBasis_affineOpens (W i)
  have key : ∀ i : Σ (i : I), κ i, ∃ G : (M.restrict (Scheme.Opens.ι (i.2 : X.Opens))).GeneratingSections,
      G.IsFiniteType := by
    intro i
    have := hfin.isFiniteType i.1
    let u := X.homOfLE (U := i.2) (V := W i.1) (by simp [heq, le_sSup])
    have : PreservesColimitsOfSize.{u, u} (restrictFunctor u) := inferInstance
    let F := (overEquiv (W i.1)).functor ⋙ restrictFunctor u
    let iso : SheafOfModules.overFunctor X.ringCatSheaf _ ⋙ F ≅ restrictFunctor
      (Scheme.Opens.ι i.2.1) := (Functor.associator _ _ _).symm ≪≫
        Functor.isoWhiskerRight (Scheme.Modules.overFunctorEquiv _) _ ≪≫
        (restrictFunctorComp _ _).symm ≪≫ (restrictFunctorCongr (by simp [u]))
    exact ⟨((gens i.1).map F (Scheme.Modules.restrictUnitIso _).symm).ofEpi (iso.app M).hom,
      inferInstance⟩
  choose G hG using key
  refine ⟨Σ (i : I), κ i, fun j ↦ j.2, G, hG, ?_, ?_⟩
  · rw [Opens.coversTop_iff, IsOpenCover] at cov
    rw [IsOpenCover, iSup_sigma, ← cov]
    refine iSup_congr fun i ↦ ?_
    rw [heq i, sSup_eq_iSup']
  · intro j
    exact hsub _ j.2.2


set_option backward.isDefEq.respectTransparency false in
/-- If a quasi-coherent module `N` on `Spec B` has finitely many generating sections, then its module of global
sections is a finitely generated `B`-module: the epimorphism from a free module is `tilde` of a linear map, and `tilde`
is faithful, so that linear map is surjective. -/
theorem finite_sections_of_generatingSections {B : CommRingCat.{u}} (N : (Spec B).Modules)
    [N.IsQuasicoherent] (G : N.GeneratingSections) [G.IsFiniteType] :
    Module.Finite B (moduleSpecΓFunctor.obj N) := by
  have : IsIso N.fromTildeΓ := inferInstance
  let e : tilde (moduleSpecΓFunctor.obj N) ≅ N := asIso N.fromTildeΓ
  let f' : tilde (ModuleCat.of B (G.I →₀ B)) ⟶ tilde (moduleSpecΓFunctor.obj N) :=
    (tildeFinsupp G.I).hom ≫ G.π ≫ e.inv
  have hf' : Epi f' := by
    have : Epi G.π := inferInstance
    dsimp only [f']
    infer_instance
  let f : ModuleCat.of B (G.I →₀ B) ⟶ moduleSpecΓFunctor.obj N :=
    (tilde.functor B).preimage f'
  have hf : Epi f := by
    have : Epi ((tilde.functor B).map f) := by
      rw [show (tilde.functor B).map f = f' from (tilde.functor B).map_preimage f']
      exact hf'
    exact (tilde.functor B).epi_of_epi_map this
  have hs : Function.Surjective f.hom := (ModuleCat.epi_iff_surjective f).1 hf
  have : Finite G.I := inferInstance
  exact Module.Finite.of_surjective f.hom hs


open Limits Scheme.Modules in
set_option backward.isDefEq.respectTransparency false in
/-- A module of finite type on `Spec A` is, on the members `D(a_k)` of a finite cover of `Spec A` by basic opens,
generated by finitely many sections: the restriction along `Spec A_{a_k} ⟶ Spec A` has finitely many generating
sections. -/
theorem exists_basicOpen_generators {A : CommRingCat.{u}} (M : (Spec A).Modules)
    [SheafOfModules.IsFiniteType.{u, u, u} M] :
    ∃ (κ : Type u) (_ : Finite κ) (a : κ → A), Ideal.span (Set.range a) = ⊤ ∧
      ∀ k, ∃ G : (M.restrict (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away (a k)))))).GeneratingSections,
        G.IsFiniteType := by
  obtain ⟨ι, U, G, hG, hU, hU'⟩ := exists_isOpenCover_generators M
  obtain ⟨s, hs⟩ := hU.exists_finite_of_compactSpace
  choose κ hκ a ha using fun i : s ↦
    PrimeSpectrum.isBasis_basic_opens.exists_iSup_eq_of_isCompact (U i) (hU' i).isCompact
  have : ∀ i, Finite (κ i) := hκ
  refine ⟨Sigma κ, inferInstance, fun i : Sigma κ ↦ a _ i.2, ?_, fun i ↦ ?_⟩
  · rw [← PrimeSpectrum.iSup_basicOpen_eq_top_iff]
    rw [IsOpenCover] at hs
    rw [iSup_sigma, ← hs]
    exact iSup_congr fun i ↦ (ha i).symm
  · have := hG i.1
    let t := (Spec A).homOfLE (U := PrimeSpectrum.basicOpen (a _ i.2)) (V := U i.1)
      (by rw [ha]; exact le_iSup_of_le _ le_rfl)
    let iso : restrictFunctor (U i.1).ι ⋙ restrictFunctor ((basicOpenIsoSpecAway _).inv ≫ t) ≅
        restrictFunctor (Spec.map (CommRingCat.ofHom <| algebraMap _ _)) :=
      (restrictFunctorComp _ _).symm ≪≫
        restrictFunctorCongr (by simp [t, basicOpenIsoSpecAway])
    have : PreservesColimitsOfSize.{u, u} (restrictFunctor ((basicOpenIsoSpecAway _).inv ≫ t)) :=
      inferInstance
    exact ⟨((G i.1).map (restrictFunctor ((basicOpenIsoSpecAway _).inv ≫ t))
      (restrictUnitIso _).symm).ofEpi (iso.app M).hom, inferInstance⟩


/-- The open immersion `Spec A_g ⟶ Spec A`, with image `D(g)`. -/
abbrev awayHom {A : CommRingCat.{u}} (g : A) : Spec (CommRingCat.of (Localization.Away g)) ⟶ Spec A :=
  Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away g)))

/-- The image of `Spec A_g ⟶ Spec A` is the basic open `D(g)`. -/
lemma image_top_awayHom {A : CommRingCat.{u}} (g : A) :
    (awayHom g) ''ᵁ ⊤ = PrimeSpectrum.basicOpen g := by
  rw [Scheme.Hom.image_top_eq_opensRange]
  exact Opens.ext (PrimeSpectrum.localization_away_comap_range _ _)


section Away

variable {A : CommRingCat.{u}} (J : ModuleCat.{u} A) (g : A)

/-- The module of sections over `Spec A_g` of the restriction of `J~` to `Spec A_g`. -/
def awaySections : Type u :=
  (moduleSpecΓFunctor.obj ((tilde J).restrict (awayHom g)))

/-- The additive group structure on `awaySections J g`. -/
instance : AddCommGroup (awaySections J g) :=
  inferInstanceAs (AddCommGroup (moduleSpecΓFunctor.obj ((tilde J).restrict (awayHom g))))

/-- The `A_g`-module structure on `awaySections J g`. -/
instance : Module (Localization.Away g) (awaySections J g) :=
  inferInstanceAs (Module (Localization.Away g)
    (moduleSpecΓFunctor.obj ((tilde J).restrict (awayHom g))))

/-- The `A`-module structure on `awaySections J g`, by restriction of scalars along `A → A_g`. -/
instance : Module A (awaySections J g) :=
  Module.compHom (awaySections J g) (algebraMap A (Localization.Away g))

/-- The two module structures on `awaySections J g` are compatible. -/
instance : IsScalarTower A (Localization.Away g) (awaySections J g) :=
  IsScalarTower.of_compHom A (Localization.Away g) (awaySections J g)


/-- `awaySections J g` is `A`-linearly equivalent to the sections of `J~` over `D(g)`. -/
def awayEquiv : awaySections J g ≃ₗ[A]
    (modulesSpecToSheaf.obj (tilde J)).presheaf.obj (.op (awayHom g ''ᵁ ⊤)) :=
  { (Scheme.Modules.restrictAppIso (awayHom g) (tilde J) ⊤).addCommGroupIsoToAddEquiv with
    map_smul' := fun r x =>
      Scheme.Modules.restrictAppIso_smul_Spec (M := tilde J)
        (CommRingCat.ofHom (algebraMap A (Localization.Away g))) r x }

/-- `J → Γ(J~, U)` is the localization at `g` when `U = D(g)`. -/
lemma isLocalizedModule_toOpen_of_eq {U : (Spec A).Opens} (hU : U = PrimeSpectrum.basicOpen g) :
    IsLocalizedModule (Submonoid.powers g) (tilde.toOpen J U).hom := by
  subst hU
  infer_instance

/-- The map `J → Γ(Spec A_g, J~|Spec A_g)`: the localization of `J` away from `g`. -/
def awayMap : J →ₗ[A] awaySections J g :=
  ((awayEquiv J g).symm : _ ≃ₗ[A] awaySections J g) ∘ₗ (tilde.toOpen J (awayHom g ''ᵁ ⊤)).hom

/-- `awayMap J g` is the localization of `J` at `g`. -/
instance : IsLocalizedModule (Submonoid.powers g) (awayMap J g) := by
  have := isLocalizedModule_toOpen_of_eq J g (image_top_awayHom g)
  exact IsLocalizedModule.of_linearEquiv (Submonoid.powers g) (tilde.toOpen J (awayHom g ''ᵁ ⊤)).hom
    (awayEquiv J g).symm

end Away


/-- The finite cover by basic opens `D(g)`, `g ∈ t`, with finitely many generating sections of the restriction
of `M` along `Spec A_g ⟶ Spec A`. -/
theorem exists_finset_basicOpen_generators {A : CommRingCat.{u}} (M : (Spec A).Modules)
    [SheafOfModules.IsFiniteType.{u, u, u} M] :
    ∃ t : Finset A, Ideal.span (t : Set A) = ⊤ ∧
      ∀ g ∈ t, ∃ G : (M.restrict (awayHom g)).GeneratingSections, G.IsFiniteType := by
  classical
  obtain ⟨κ, hκ, a, ha, hG⟩ := exists_basicOpen_generators M
  have := Fintype.ofFinite κ
  refine ⟨Finset.univ.image a, ?_, ?_⟩
  · simpa using ha
  · intro g hg
    obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hg
    exact hG k

end Hironaka.AffineCharts

namespace Hironaka

open AffineCharts

set_option backward.isDefEq.respectTransparency false in
/-- A coherent module `J~` on `Spec A` has `J` finitely generated (`tilde` is fully faithful and a module of finite
presentation is locally generated by finitely many sections, hence `J_g` is finite over `A_g` on a cover by basic
opens). -/
theorem finite_of_isCoherent_tilde {A : CommRingCat.{u}} (J : ModuleCat.{u} A)
    (h : (RModule.mk (Spec A).toLocallyRingedSpace (tildeOM J)).IsCoherent) : Module.Finite A J := by
  have hfp : SheafOfModules.IsFinitePresentation.{u, u, u} (tilde J : (Spec A).Modules) := h
  obtain ⟨t, ht, hG⟩ := exists_finset_basicOpen_generators (tilde J : (Spec A).Modules)
  refine Module.Finite.of_localizationSpan_finite' (Mₚ := fun g : t => awaySections J g.1)
    (Rₚ := fun g : t => Localization.Away g.1) t ht (fun g => awayMap J g.1) (fun g => ?_)
  obtain ⟨G, hGfin⟩ := hG g.1 g.2
  exact finite_sections_of_generatingSections ((tilde J : (Spec A).Modules).restrict (awayHom g.1)) G

/-- Affine neighbourhoods of a prescheme (in the sense of `IsPrescheme`): every point `x` has an open neighbourhood
`V` such that the restriction `X|V` is isomorphic to `Spec A` for a commutative ring `A`. -/
theorem exists_affine_restrict {X : LocallyRingedSpace.{u}} (hX : IsPrescheme X) (x : X) :
    ∃ (V : Opens X) (_ : x ∈ V) (A : CommRingCat.{u}),
      Nonempty (X.restrict V.isOpenEmbedding ≅ (Spec A).toLocallyRingedSpace) := by
  obtain ⟨Y, ⟨e⟩⟩ := hX
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ := (Y.isBasis_affineOpens).exists_subset_of_mem_open
    (Set.mem_univ (e.inv.base x)) isOpen_univ
  refine ⟨(Opens.map e.inv.base).obj U, hxU, Γ(Y, U), ⟨?_⟩⟩
  refine (LocallyRingedSpace.restrictIsoOfIso e.symm U) ≪≫ ?_
  exact Scheme.forgetToLocallyRingedSpace.mapIso hU.isoSpec

set_option backward.isDefEq.respectTransparency false in
/-- A quasi-coherent sheaf of modules on `Spec A` is isomorphic to `J~` for an `A`-module `J` (Mathlib's
`Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent`: `J = Γ(J')`). -/
theorem exists_oModulesIso_tilde {A : CommRingCat.{u}} (J' : OModules (Spec A).toLocallyRingedSpace)
    (h : (RModule.mk (Spec A).toLocallyRingedSpace J').IsQuasicoherent) :
    ∃ J : ModuleCat.{u} A, Nonempty (J' ≅ tildeOM J) := by
  have h' : SheafOfModules.IsQuasicoherent.{u, u, u} (R := (Spec A).ringCatSheaf) J' := h
  let J'' : (Spec A).Modules := J'
  have : IsIso (Scheme.Modules.fromTildeΓ J'') := inferInstance
  let e : tilde (moduleSpecΓFunctor.obj J'') ≅ J'' := asIso (Scheme.Modules.fromTildeΓ J'')
  exact ⟨moduleSpecΓFunctor.obj J'', ⟨e.symm⟩⟩

/-- A quasi-coherent module on `Spec A` is `J~`, as an `ℛ`-module (`exists_oModulesIso_tilde`). -/
theorem exists_iso_tilde {A : CommRingCat.{u}} (J' : OModules (Spec A).toLocallyRingedSpace)
    (h : (RModule.mk (Spec A).toLocallyRingedSpace J').IsQuasicoherent) :
    ∃ J : ModuleCat.{u} A,
      Nonempty (RModule.mk (Spec A).toLocallyRingedSpace J' ≅ RModule.mk (Spec A).toLocallyRingedSpace (tildeOM J)) := by
  obtain ⟨J, ⟨α⟩⟩ := exists_oModulesIso_tilde J' h
  exact ⟨J, ⟨RModule.ofModuleIso α⟩⟩

/-- Every point of a prescheme with a quasi-coherent module has an open neighbourhood `V` with `M|V ≅ S(A, J)`,
`J` finitely generated if `M` is coherent.  (The restriction to an affine open `V` is transported to `Spec A` along
`exists_affine_restrict`; it is quasi-coherent and coherent when `M` is, since the inverse image along an open
immersion preserves both.) -/
theorem RModule.exists_affine_chart (M : RModule.{u}) (hX : IsPrescheme M.X) (hq : M.IsQuasicoherent)
    (x : M.X) :
    ∃ (V : Opens M.X) (_ : x ∈ V) (A : CommRingCat.{u}) (J : ModuleCat.{u} A),
      Nonempty (M.restrict V ≅ symmetricAffine A J) ∧ (M.IsCoherent → Module.Finite A J) := by
  obtain ⟨V, hxV, A, ⟨e⟩⟩ := exists_affine_restrict hX x
  have hqV : (M.restrict V).IsQuasicoherent :=
    OModules.isQuasicoherent_pullback_of_isOpenImmersion (M.X.ofRestrict V.isOpenEmbedding) M.J hq
  have hqW : ((M.restrict V).transport e.symm).IsQuasicoherent :=
    OModules.isQuasicoherent_pullback_of_isOpenImmersion e.symm.hom (M.restrict V).J hqV
  obtain ⟨J, ⟨α⟩⟩ := exists_oModulesIso_tilde ((M.restrict V).transport e.symm).J hqW
  refine ⟨V, hxV, A, J, ⟨((M.restrict V).transportIso e.symm).symm ≪≫ RModule.ofModuleIso α⟩,
    fun hc => ?_⟩
  have hcV : (M.restrict V).IsCoherent :=
    OModules.isCoherent_pullback_of_isOpenImmersion (M.X.ofRestrict V.isOpenEmbedding) M.J hc
  have hcW : ((M.restrict V).transport e.symm).IsCoherent :=
    OModules.isCoherent_pullback_of_isOpenImmersion e.symm.hom (M.restrict V).J hcV
  refine finite_of_isCoherent_tilde J ?_
  exact (SheafOfModules.isFinitePresentation
    (ringCatSheaf (Spec A).toLocallyRingedSpace)).prop_of_iso α hcW

end Hironaka

module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Hironaka.Ch3.Basic
public import Hironaka.Ch3.NuStar

/-!
# Extending a standard base by one element (Ch. III §7, p. 251)

The last sentence of the proof of Lemma 18 (p. 251) reads: "Therefore `ν^{(i+1)}(J) = ν_M(f)`
implies that `(f₁, …, f_i, f)` can be extended to a standard base of `J`."  The paper gives no
argument for this "therefore"; the content is the exchange property of standard bases.  It is
proved here in the following form: if `(f₁, …, f_i)` is the beginning of a standard base of `J`, if
`f ∈ J` has order `ν_M(f) = ν^{(i+1)}(J)` and its initial form `φ` does not lie in the ideal
`(φ₁, …, φ_i) gr_M(R)` generated by the initial forms of `f₁, …, f_i`, then `(f₁, …, f_i, f)` is the
beginning of a standard base of `J`.

The proof does not exchange anything: it applies to the family `(f₁, …, f_i, f, g_{i+1}, …, g_m)`,
where `(g₁, …, g_m)` is the given standard base, the usual greedy selection (discard every member
whose initial form lies in the ideal generated by the initial forms of its predecessors), which
keeps the first `i + 1` members because they are independent.
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

section Greedy

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The greedy selection of a standard base from a generating family of elements of `J` whose
initial forms are homogeneous of non-decreasing degrees, keeping an initial segment of the family
which is already independent (each member's initial form is outside the ideal generated by those of
its predecessors). -/
theorem exists_isStandardBase_comp_of_prefix (J : Ideal R) {n : ℕ} (y : Fin n → R)
    (hyJ : ∀ l, y l ∈ J)
    (hgen : Ideal.span (Set.range fun l => initialForm (maximalIdeal R) (y l)) =
      grIdeal (maximalIdeal R) J)
    (d : Fin n → ℕ)
    (hd : ∀ l, initialForm (maximalIdeal R) (y l) ∈ AssocGraded.homogeneous (maximalIdeal R) (d l))
    (hmono : Monotone d) {p : ℕ} (hp : p ≤ n)
    (hpre : ∀ l : Fin n, (l : ℕ) < p → initialForm (maximalIdeal R) (y l) ∉
      Ideal.span (Set.range fun j : Fin l =>
        initialForm (maximalIdeal R) (y (Fin.castLE l.2.le j)))) :
    ∃ (m : ℕ) (σ : Fin m → Fin n), p ≤ m ∧ StrictMono σ ∧
      (∀ k : Fin m, (k : ℕ) < p → (σ k : ℕ) = k) ∧ IsStandardBase R J (y ∘ σ) := by
  classical
  set φ : Fin n → AssocGraded (maximalIdeal R) := fun l => initialForm (maximalIdeal R) (y l)
    with hφ
  set S : Finset (Fin n) := Finset.univ.filter fun l : Fin n =>
    φ l ∉ Ideal.span (Set.range fun j : Fin l => φ (Fin.castLE l.2.le j)) with hS
  have hSmem : ∀ l, l ∈ S ↔ φ l ∉ Ideal.span (Set.range fun j : Fin l => φ (Fin.castLE l.2.le j)) :=
    fun l => by simp [hS]
  let emb := S.orderEmbOfFin rfl
  have hpS : ∀ l : Fin n, (l : ℕ) < p → l ∈ S := fun l hl => (hSmem l).mpr (hpre l hl)
  have hcard : p ≤ S.card := by
    have : (Finset.univ.filter fun l : Fin n => (l : ℕ) < p).card = p := by
      have h1 : (Finset.univ.filter fun l : Fin n => (l : ℕ) < p) =
          (Finset.range p).attachFin (fun m hm => lt_of_lt_of_le (Finset.mem_range.mp hm) hp) := by
        ext l
        simp
      rw [h1, Finset.card_attachFin, Finset.card_range]
    rw [← this]
    exact Finset.card_le_card fun l hl => hpS l (by simpa using hl)
  have hle : ∀ k : ℕ, ∀ hk : k < S.card, k ≤ (emb ⟨k, hk⟩ : ℕ) := by
    intro k
    induction k with
    | zero => intro hk; exact Nat.zero_le _
    | succ k ih =>
      intro hk
      have h1 := ih (by omega)
      have h2 : emb ⟨k, by omega⟩ < emb ⟨k + 1, hk⟩ :=
        emb.strictMono (Fin.mk_lt_mk.mpr (Nat.lt_succ_self k))
      have : (emb ⟨k, by omega⟩ : ℕ) < (emb ⟨k + 1, hk⟩ : ℕ) := h2
      omega
  have hprefix : ∀ k : ℕ, ∀ hk : k < S.card, k < p → (emb ⟨k, hk⟩ : ℕ) = k := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
      intro hk hkp
      have hkn : k < n := by
        have := (emb ⟨k, hk⟩).2
        have h2 : k ≤ (emb ⟨k, hk⟩ : ℕ) := hle k hk
        omega
      have hkS : (⟨k, hkn⟩ : Fin n) ∈ S := hpS _ hkp
      obtain ⟨j, hj⟩ : ∃ j, emb j = ⟨k, hkn⟩ := by
        have : (⟨k, hkn⟩ : Fin n) ∈ Set.range emb := by
          rw [Finset.range_orderEmbOfFin]; exact hkS
        exact this
      have hjk : (j : ℕ) ≤ k := by
        have h3 : (j : ℕ) ≤ (emb j : ℕ) := hle j j.2
        rw [hj] at h3
        exact h3
      rcases Nat.lt_or_eq_of_le hjk with hlt | heq
      · have := ih j hlt j.2 (by omega)
        rw [hj] at this
        simp at this
        omega
      · have : j = ⟨k, hk⟩ := Fin.ext heq
        rw [this] at hj
        rw [hj]
  refine ⟨S.card, emb, hcard, emb.strictMono, fun k hk => hprefix k k.2 hk, ?_⟩
  -- the selected family is a standard base
  have hgen' : ∀ l : Fin n, φ l ∈ Ideal.span (Set.range fun k : Fin S.card => φ (emb k)) := by
    intro l
    induction l using WellFoundedLT.induction with
    | _ l ih =>
      by_cases hl : l ∈ S
      · obtain ⟨k, hk⟩ : l ∈ Set.range emb := by
          rw [Finset.range_orderEmbOfFin]; exact hl
        rw [← hk]
        exact Ideal.subset_span ⟨k, rfl⟩
      · rw [hSmem, not_not] at hl
        refine (Ideal.span_le.mpr ?_) hl
        rintro _ ⟨j, rfl⟩
        exact ih _ (Fin.lt_def.mpr (by simp))
  refine ⟨fun k => hyJ _, fun k => ?_, ⟨fun k => d (emb k), fun k => hd _, hmono.comp emb.monotone⟩,
    ?_, fun k hk => ?_⟩
  · exact Ideal.subset_span ⟨y (emb k), hyJ _, rfl⟩
  · apply le_antisymm
    · rw [← hgen, Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      exact hgen' l
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rw [← hgen]
      exact Ideal.subset_span ⟨emb k, rfl⟩
  · have hkS : emb k ∈ S := Finset.orderEmbOfFin_mem S rfl k
    have := (hSmem _).mp hkS
    refine this ((Ideal.span_mono ?_) hk)
    rintro _ ⟨j, rfl⟩
    have hlt : (emb (Fin.castLE k.2.le j) : ℕ) < (emb k : ℕ) := by
      have : emb (Fin.castLE k.2.le j) < emb k :=
        emb.strictMono (Fin.lt_def.mpr (by simp))
      exact this
    exact ⟨⟨emb (Fin.castLE k.2.le j), hlt⟩, rfl⟩


/-- Extending the beginning `(f₁, …, f_i)` of a standard base of `J` by an element `f ∈ J` with
`ν_M(f) = ν^{(i+1)}(J)` whose initial form lies outside `(φ₁, …, φ_i) gr_M(R)`: the sequence
`(f₁, …, f_i, f)` is the beginning of a standard base of `J`. -/
theorem exists_isStandardBase_snoc (J : Ideal R) {i m : ℕ} (gs : Fin m → R)
    (hgs : IsStandardBase R J gs) (him : i ≤ m) (g : R) (hgJ : g ∈ J)
    (hord : Ideal.ordElem (maximalIdeal R) g = nuI R J i.succPNat)
    (hnot : initialForm (maximalIdeal R) g ∉ Ideal.span
      (Set.range fun j : Fin i => initialForm (maximalIdeal R) (gs (Fin.castLE him j)))) :
    ∃ (m' : ℕ) (gs' : Fin m' → R) (h : i + 1 ≤ m'), IsStandardBase R J gs' ∧
      (∀ j : Fin i, gs' (Fin.castLE h j.castSucc) = gs (Fin.castLE him j)) ∧ gs' ⟨i, h⟩ = g := by
  classical
  obtain ⟨hJ, ⟨dd, hdd, hmono⟩, hspan, hind⟩ := hgs.2
  have hnu := nuI_eq_of_lemma1_properties R J _ hJ dd hdd hspan hmono hind
  have hne : initialForm (maximalIdeal R) g ≠ 0 := fun h0 => hnot (h0 ▸ zero_mem _)
  have htop : Ideal.ordElem (maximalIdeal R) g ≠ ⊤ := fun h => hne (by
    rw [initialForm, dite_eq_left h])
  obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
  have hi : i < m := by
    by_contra hcon
    have := hnu.2 i.succPNat (by simp; omega)
    rw [this] at hord
    exact htop hord
  have hνdd : ν = dd ⟨i, hi⟩ := by
    have := hnu.1 ⟨i, hi⟩
    have h2 : (ν : ℕ∞) = dd ⟨i, hi⟩ := by rw [hν, hord]; exact this
    exact_mod_cast h2
  -- the extended family `y = (g₁, …, g_i, g, g_{i+1}, …, g_m)`
  let D : ℕ → ℕ := fun n => if h : n < m then dd ⟨n, h⟩ else dd ⟨m - 1, by omega⟩
  have hD : Monotone D := by
    intro a b hab
    simp only [D]
    split_ifs with ha hb hb
    · exact hmono (Fin.mk_le_mk.mpr hab)
    · exact hmono (Fin.mk_le_mk.mpr (by omega))
    · omega
    · exact le_rfl
  let f : ℕ → ℕ := fun l => if l ≤ i then l else l - 1
  have hf : Monotone f := by
    intro a b hab
    simp only [f]
    split_ifs <;> omega
  let y : Fin (m + 1) → R := fun l =>
    if h : (l : ℕ) = i then g else gs ⟨f l, by simp only [f]; split_ifs <;> omega⟩
  have hy1 : ∀ l : Fin (m + 1), (l : ℕ) = i → y l = g := fun l h => by simp [y, h]
  have hy2 : ∀ (l : Fin (m + 1)) (h : (l : ℕ) ≠ i) (hl : f l < m), y l = gs ⟨f l, hl⟩ :=
    fun l h hl => by simp [y, h]
  let d : Fin (m + 1) → ℕ := fun l => D (f l)
  have hdmono : Monotone d := fun a b hab => hD (hf hab)
  have hyJ : ∀ l, y l ∈ J := by
    intro l
    by_cases h : (l : ℕ) = i
    · rw [hy1 l h]; exact hgJ
    · rw [hy2 l h (by simp only [f]; split_ifs <;> omega)]
      exact hgs.1 _

  have hyb : ∀ (j : Fin (m + 1)) (hj : (j : ℕ) < i), y j = gs ⟨j, by omega⟩ := by
    intro j hj
    rw [hy2 j (by omega) (by simp only [f]; split_ifs <;> omega)]
    congr 1
    ext
    simp only [f]
    split_ifs <;> omega
  have hgen : Ideal.span (Set.range fun l => initialForm (maximalIdeal R) (y l)) =
      grIdeal (maximalIdeal R) J := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      exact Ideal.subset_span ⟨y l, hyJ l, rfl⟩
    · rw [hspan, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      let l : Fin (m + 1) := ⟨if (j : ℕ) < i then j else j + 1, by split_ifs <;> omega⟩
      have hl : (l : ℕ) ≠ i := by simp only [l]; split_ifs <;> omega
      have hyl : y l = gs j := by
        rw [hy2 l hl (by simp only [f, l]; split_ifs <;> omega)]
        congr 1
        ext
        simp only [f, l]
        split_ifs <;> omega
      exact Ideal.subset_span ⟨l, by simp only [hyl]⟩
  have hd : ∀ l, initialForm (maximalIdeal R) (y l) ∈
      AssocGraded.homogeneous (maximalIdeal R) (d l) := by
    intro l
    by_cases h : (l : ℕ) = i
    · rw [hy1 l h]
      have hdl : d l = ν := by
        simp only [d, f, D]
        rw [ite_eq_left (by omega), h, dite_eq_left hi, hνdd]
      rw [hdl, initialForm_eq_mk _ hν.symm]
      exact AssocGraded.mk_mem_homogeneous _ _
    · have hl : f l < m := by simp only [f]; split_ifs <;> omega
      rw [hy2 l h hl]
      have hdl : d l = dd ⟨f l, hl⟩ := by simp only [d, D]; rw [dite_eq_left hl]
      rw [hdl]
      exact hdd _
  have hpre : ∀ l : Fin (m + 1), (l : ℕ) < i + 1 → initialForm (maximalIdeal R) (y l) ∉
      Ideal.span (Set.range fun j : Fin l =>
        initialForm (maximalIdeal R) (y (Fin.castLE l.2.le j))) := by
    intro l hl
    have hrange : (Set.range fun j : Fin l => initialForm (maximalIdeal R)
        (y (Fin.castLE l.2.le j))) = Set.range fun j : Fin l =>
          initialForm (maximalIdeal R) (gs ⟨j, by have := j.2; have := l.2; omega⟩) := by
      congr 1
      funext j
      have hj : (Fin.castLE l.2.le j : ℕ) < i := by
        have := j.2; simp; omega
      rw [hyb _ hj]
      rfl
    rw [hrange]
    by_cases h : (l : ℕ) = i
    · rw [hy1 l h]
      have : (Set.range fun j : Fin l => initialForm (maximalIdeal R)
          (gs ⟨j, by have := j.2; have := l.2; omega⟩)) =
          Set.range fun j : Fin i => initialForm (maximalIdeal R) (gs (Fin.castLE him j)) := by
        subst_vars
        rfl
      rw [this]
      exact hnot
    · have hlt : (l : ℕ) < i := by omega
      rw [hyb l hlt]
      exact hind ⟨l, by omega⟩
  obtain ⟨m', σ, hpm, hσ, hσp, hbase⟩ :=
    exists_isStandardBase_comp_of_prefix J y hyJ hgen d hd hdmono
    (p := i + 1) (by omega) hpre
  refine ⟨m', y ∘ σ, hpm, hbase, ?_, ?_⟩
  · intro j
    have hσj : σ (Fin.castLE hpm j.castSucc) = ⟨j, by omega⟩ :=
      Fin.ext (hσp _ (by simp))
    simp only [Function.comp_apply, hσj]
    rw [hyb _ j.2]
    rfl
  · have hσj : σ ⟨i, hpm⟩ = ⟨i, by omega⟩ := Fin.ext (hσp _ (by simp))
    simp only [Function.comp_apply, hσj]
    exact hy1 _ rfl

end Greedy

end Hironaka

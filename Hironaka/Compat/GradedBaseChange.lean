module

public import Mathlib.Algebra.Module.GradedModule
public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.GradedAlgebra.TensorProduct
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# Compatibility layer: base change of a graded algebra and a graded module (Ch. II §1, p. 188)

The proof of Lemma 4 (p. 188) applies the corollary to Lemma 2 (p. 182) to the localizations at
the prime `P`: "Since `M_P` is a flat `A_P`-module, we have (a') `(M/PM)_P` is a flat
`(A/P)_P`-module \dots and (b') `Tor₁^A(M, A/P)_P = 0`.  (See corollary to Lemma 2.)"  The
corollary is stated for a graded algebra and a graded module, so this needs `B_P = A_P ⊗_A B`
as a graded `A_P`-algebra of finite type generated by homogeneous elements of positive degrees,
and `M_P = A_P ⊗_A M` as a graded `B_P`-module of finite type.  Mathlib has the graded algebra
`R' ⊗_R B` (`GradedAlgebra.baseChange`) and the decomposition of `R' ⊗_R M`
(`DirectSum.Decomposition.baseChange`); this file adds the rest:

* `baseChangeModule`: the `R' ⊗_R B`-module structure on `R' ⊗_R M`, with
  `(r ⊗ b) • (r' ⊗ m) = (r r') ⊗ (b m)` (`baseChange_smul_tmul`); it is not an instance, to
  avoid a diamond for `M = B`, so users write `attribute [local instance] baseChangeModule`;
* the compatibility of the two gradings (`SetLike.GradedSMul`);
* `baseChange_moduleFinite`: `R' ⊗_R M` is of finite type over `R' ⊗_R B`;
* `baseChange_adjoin_eq_top`: `R' ⊗_R B` is generated over `R'` by the images of the homogeneous
  elements of positive degrees.
-/

@[expose] public section

open TensorProduct

namespace Hironaka

universe u

section BaseChangeModule

variable {R : Type u} [CommRing R] (R' : Type u) [CommRing R'] [Algebra R R']
  {B : Type u} [CommRing B] [Algebra R B]
  {M : Type u} [AddCommGroup M] [Module R M] [Module B M] [IsScalarTower R B M]

/-- The action of `R' ⊗_R B` on `R' ⊗_R M`: `(r ⊗ b) • (r' ⊗ m) = (r r') ⊗ (b m)`, as an algebra
homomorphism into `End_{R'}(R' ⊗_R M)`. -/
noncomputable def baseChangeSMulHom : R' ⊗[R] B →ₐ[R'] Module.End R' (R' ⊗[R] M) :=
  Algebra.TensorProduct.lift (Algebra.lsmul R' R' (R' ⊗[R] M))
    ((Module.End.baseChangeHom R R' M).comp (Algebra.lsmul R R M : B →ₐ[R] Module.End R M))
    (fun r b => by
      show _ * _ = _ * _
      refine TensorProduct.AlgebraTensorModule.ext fun r' m => ?_
      simp [Module.End.mul_apply])

/-- The `R' ⊗_R B`-module structure on `R' ⊗_R M`: `(r ⊗ b) • (r' ⊗ m) = (r r') ⊗ (b m)`.  It is
not an instance (it would be a diamond for `M = B`); use `attribute [local instance]`. -/
@[instance_reducible]
noncomputable def baseChangeModule : Module (R' ⊗[R] B) (R' ⊗[R] M) :=
  Module.compHom _ (baseChangeSMulHom (R := R) R' (B := B) (M := M)).toRingHom

attribute [local instance] baseChangeModule

/-- Unfolding the action of `R' ⊗_R B` on `R' ⊗_R M`. -/
theorem baseChange_smul_def (x : R' ⊗[R] B) (y : R' ⊗[R] M) :
    x • y = baseChangeSMulHom (R := R) R' (B := B) (M := M) x y := rfl

/-- `(r ⊗ b) • (r' ⊗ m) = (r r') ⊗ (b m)`. -/
theorem baseChange_smul_tmul (r r' : R') (b : B) (m : M) :
    (r ⊗ₜ[R] b) • (r' ⊗ₜ[R] m) = (r * r') ⊗ₜ[R] (b • m) := by
  rw [baseChange_smul_def, baseChangeSMulHom, Algebra.TensorProduct.lift_tmul, Module.End.mul_apply]
  show r • (r' ⊗ₜ[R] (b • m)) = _
  rw [smul_tmul', smul_eq_mul]

/-- `(r ⊗ 1) • y = r • y`. -/
theorem baseChange_smul_tmul_one (r : R') (y : R' ⊗[R] M) :
    (r ⊗ₜ[R] (1 : B)) • y = r • y := by
  induction y using TensorProduct.inductionOn with
  | tmul r' m => rw [baseChange_smul_tmul, one_smul, smul_tmul', smul_eq_mul]
  | add x y hx hy => rw [smul_add, smul_add, hx, hy]

/-- The two actions of `R'` on `R' ⊗_R M` (directly and through `R' ⊗_R B`) agree. -/
instance : IsScalarTower R' (R' ⊗[R] B) (R' ⊗[R] M) := by
  refine ⟨fun r b y => ?_⟩
  rw [Algebra.smul_def, mul_smul]
  have : algebraMap R' (R' ⊗[R] B) r = r ⊗ₜ[R] (1 : B) := by
    simp [Algebra.TensorProduct.algebraMap_apply]
  rw [this, baseChange_smul_tmul_one]

end BaseChangeModule

section GradedBaseChange

variable {R : Type u} [CommRing R] (R' : Type u) [CommRing R'] [Algebra R R']
  {B : Type u} [CommRing B] [Algebra R B]
  {M : Type u} [AddCommGroup M] [Module R M] [Module B M] [IsScalarTower R B M]

attribute [local instance] baseChangeModule

/-- The grading of `R' ⊗_R M` by `(ℳ n).baseChange R'` is compatible with the grading of `R' ⊗_R B`
by `(𝒜 n).baseChange R'`. -/
instance (𝒜 : ℕ → Submodule R B) [GradedAlgebra 𝒜] (ℳ : ℕ → Submodule R M)
    [SetLike.GradedSMul 𝒜 ℳ] :
    SetLike.GradedSMul (fun i => (𝒜 i).baseChange R') (fun i => (ℳ i).baseChange R') where
  smul_mem := by
    intro i j x y hx hy
    obtain ⟨tx, rfl⟩ := Submodule.toBaseChange_surjective' R' (𝒜 i) hx
    obtain ⟨ty, rfl⟩ := Submodule.toBaseChange_surjective' R' (ℳ j) hy
    clear hx hy
    induction tx using TensorProduct.inductionOn with
    | tmul r a =>
      induction ty using TensorProduct.inductionOn with
      | tmul r' m =>
        rw [Submodule.coe_toBaseChange_tmul, Submodule.coe_toBaseChange_tmul,
          baseChange_smul_tmul]
        exact Submodule.tmul_mem_baseChange_of_mem _ (SetLike.GradedSMul.smul_mem a.2 m.2)
      | add y z hy hz =>
        rw [map_add, Submodule.coe_add, smul_add]
        exact add_mem hy hz
    | add x y hx hy =>
      rw [map_add, Submodule.coe_add, add_smul]
      exact add_mem hx hy

/-- `R' ⊗_R M` is of finite type over `R' ⊗_R B` when `M` is of finite type over `B`. -/
theorem baseChange_moduleFinite [Module.Finite B M] : Module.Finite (R' ⊗[R] B) (R' ⊗[R] M) := by
  classical
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := B) (M := M)
  rw [Module.finite_def]
  refine ⟨s.image (fun m => (1 : R') ⊗ₜ[R] m), ?_⟩
  rw [eq_top_iff]
  have key : ∀ m ∈ Submodule.span B (s : Set M), ∀ r : R', r ⊗ₜ[R] m ∈
      Submodule.span (R' ⊗[R] B) (↑(s.image (fun m => (1 : R') ⊗ₜ[R] m)) : Set (R' ⊗[R] M)) := by
    intro m hm
    induction hm using Submodule.span_induction with
    | mem g hg =>
      intro r
      have : r ⊗ₜ[R] g = (r ⊗ₜ[R] (1 : B)) • ((1 : R') ⊗ₜ[R] g) := by
        rw [baseChange_smul_tmul, mul_one, one_smul]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (by simpa using ⟨g, hg, rfl⟩))
    | zero => intro r; rw [TensorProduct.tmul_zero]; exact zero_mem _
    | add m n _ _ hm hn => intro r; rw [TensorProduct.tmul_add]; exact add_mem (hm r) (hn r)
    | smul b m' _ hm' =>
      intro r
      have : r ⊗ₜ[R] (b • m') = ((1 : R') ⊗ₜ[R] b) • (r ⊗ₜ[R] m') := by
        rw [baseChange_smul_tmul, one_mul]
      rw [this]
      exact Submodule.smul_mem _ _ (hm' r)
  intro x _
  induction x using TensorProduct.inductionOn with
  | tmul r m => exact key m (hs ▸ Submodule.mem_top) r
  | add x y hx hy => exact add_mem (hx trivial) (hy trivial)

/-- If `B` is generated over `R` by `⋃ₙ 𝒜 (n+1)`, then `R' ⊗_R B` is generated over `R'` by
`⋃ₙ (𝒜 (n+1)).baseChange R'`. -/
theorem baseChange_adjoin_eq_top (𝒜 : ℕ → Submodule R B)
    (hgen : Algebra.adjoin R (⋃ n : ℕ, (𝒜 (n + 1) : Set B)) = ⊤) :
    Algebra.adjoin R' (⋃ n : ℕ, (((𝒜 (n + 1)).baseChange R' : Submodule R' (R' ⊗[R] B)) :
      Set (R' ⊗[R] B))) = ⊤ := by
  set T : Set (R' ⊗[R] B) := ⋃ n : ℕ, (((𝒜 (n + 1)).baseChange R' : Submodule R' (R' ⊗[R] B)) :
      Set (R' ⊗[R] B)) with hT
  have h1 : ∀ b : B, (1 : R') ⊗ₜ[R] b ∈ Algebra.adjoin R' T := by
    intro b
    have hb : b ∈ Algebra.adjoin R (⋃ n : ℕ, (𝒜 (n + 1) : Set B)) := hgen ▸ Algebra.mem_top
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hx
      exact Algebra.subset_adjoin
        (Set.mem_iUnion.mpr ⟨n, Submodule.tmul_mem_baseChange_of_mem _ hn⟩)
    | algebraMap r =>
      have : (1 : R') ⊗ₜ[R] (algebraMap R B r) = algebraMap R' (R' ⊗[R] B) (algebraMap R R' r) := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply]
        exact (Algebra.TensorProduct.tmul_one_eq_one_tmul r).symm
      rw [this]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact add_mem hx hy
    | mul x y _ _ hx hy =>
      have : (1 : R') ⊗ₜ[R] (x * y) = ((1 : R') ⊗ₜ[R] x) * ((1 : R') ⊗ₜ[R] y) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      rw [this]
      exact mul_mem hx hy
  rw [eq_top_iff]
  intro z _
  induction z using TensorProduct.inductionOn with
  | tmul r b =>
    have : r ⊗ₜ[R] b = algebraMap R' (R' ⊗[R] B) r * ((1 : R') ⊗ₜ[R] b) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply,
        Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    rw [this]
    exact mul_mem (Subalgebra.algebraMap_mem _ _) (h1 b)
  | add x y hx hy => exact add_mem (hx trivial) (hy trivial)

end GradedBaseChange

end Hironaka

/-!
# Compatibility layer: flat base change of monoidal transformations

Ch. IV §1 (p. 276) asserts: "If `h` is obtained by a monoidal transformation of `X''` with
center `B''`, then `h_S` is obtained by the monoidal transformation of `X''_S` with center
`B''_S`."  Here `X''_S → X''` is the base change of `Spec(S) → X`, a flat morphism.  This file
proves the general statement from the universal mapping property of p. 166
(`MonoidalTransformation`): for a monoidal transformation `f : X' → X` with center `B` and a flat
morphism `g : Y → X`, the projection `X' ×_X Y → Y` is a monoidal transformation of `Y` with
center `g⁻¹(B)`.

* Invertibility: locally the ideal of `f⁻¹(B)` is generated by a non-zero-divisor `a`; its image
  in `X' ×_X Y` is still a non-zero-divisor, because `X' ×_X Y → X'` is flat (flatness is stable
  under base change) and flat ring homomorphisms preserve non-zero-divisors.
* Universal property: a morphism `Z → Y` along which `g⁻¹(B)` becomes invertible composes to a
  morphism `Z → X` along which `B` becomes invertible, so it factors uniquely through `X'`, hence
  uniquely through the fibre product.

The canonical morphism `Spec O_{X,x} → X` is flat (it is a localization followed by an open
immersion), so the statement applies to the localizations `X'_S` of Ch. IV §1.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace
open scoped nonZeroDivisors

namespace Hironaka

universe u

/-- A flat ring homomorphism maps non-zero-divisors to non-zero-divisors. -/
theorem flat_map_mem_nonZeroDivisors {R S : Type*} [CommRing R] [CommRing S]
    {φ : R →+* S} (hφ : φ.Flat) {r : R} (hr : r ∈ R⁰) : φ r ∈ S⁰ := by
  let _ : Algebra R S := φ.toAlgebra
  have : Module.Flat R S := hφ
  have hreg : IsSMulRegular S r := Module.Flat.isSMulRegular_of_nonZeroDivisors hr
  refine mem_nonZeroDivisors_iff_right.mpr fun x hx => hreg ?_
  change r • x = r • (0 : S)
  rw [smul_zero, Algebra.smul_def]
  change φ r * x = 0
  rw [mul_comm]
  exact hx

/-- The pull-back of an invertible sheaf of ideals along a flat morphism is invertible. -/
theorem isInvertibleIdeal_totalTransform_of_flat {X Y : Scheme.{u}} (g : Y ⟶ X) [Flat g]
    {D : Subscheme X} (hD : D.IsInvertibleIdeal) :
    (Subscheme.totalTransform g D).IsInvertibleIdeal := by
  intro y
  obtain ⟨U, hgyU, a, hDa, ha⟩ := hD (g y)
  obtain ⟨_, ⟨W, hW, rfl⟩, hyW, hWU⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (show y ∈ g ⁻¹ᵁ (U : X.Opens) from hgyU) (g ⁻¹ᵁ (U : X.Opens)).isOpen
  refine ⟨⟨W, hW⟩, hyW, g.appLE U W hWU a, ?_, ?_⟩
  · change (D.comap g).ideal ⟨W, hW⟩ = _
    rw [ideal_comap_eq_map_appLE g D U ⟨W, hW⟩ hWU, hDa, Ideal.map_span, Set.image_singleton]
  · exact flat_map_mem_nonZeroDivisors
      (HasRingHomProperty.appLE @Flat g inferInstance U ⟨W, hW⟩ hWU) ha

/-- The canonical morphism `Spec O_{X,x} → X` is flat: it is `Spec` of the localization
`Γ(X, U) → O_{X,x}` followed by the open immersion of an affine neighbourhood `U` of `x`. -/
theorem flat_fromSpecStalk (X : Scheme.{u}) (x : X) : Flat (X.fromSpecStalk x) := by
  obtain ⟨_, ⟨U, hU₀, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have hU : IsAffineOpen U := hU₀
  have hg : X.fromSpecStalk x = Spec.map (X.presheaf.germ U x hxU) ≫ hU.fromSpec :=
    (hU.fromSpecStalk_eq_fromSpecStalk hxU).symm
  rw [hg]
  have : Flat (Spec.map (X.presheaf.germ U x hxU)) := by
    rw [Flat.SpecMap_iff]
    let _ : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hxU).hom.toAlgebra
    have := hU.isLocalization_stalk ⟨x, hxU⟩
    exact IsLocalization.flat (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
  infer_instance

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X}

/-- The base change of a monoidal transformation along a flat morphism `g : Y → X`: the
projection `X' ×_X Y → Y` is a monoidal transformation of `Y` with center `g⁻¹(B)`. -/
noncomputable def baseChange (t : MonoidalTransformation X B) {Y : Scheme.{u}} (g : Y ⟶ X)
    [Flat g] : MonoidalTransformation Y (Subscheme.totalTransform g B) where
  X' := pullback t.f g
  f := pullback.snd t.f g
  invertible := by
    rw [← Subscheme.totalTransform_comp, ← pullback.condition, Subscheme.totalTransform_comp]
    exact isInvertibleIdeal_totalTransform_of_flat (pullback.fst t.f g) t.invertible
  universal := fun Z f' hf' => by
    rw [← Subscheme.totalTransform_comp] at hf'
    obtain ⟨k, hk, hkuniq⟩ := t.universal Z (f' ≫ g) hf'
    refine ⟨pullback.lift k f' hk, pullback.lift_snd _ _ _, fun h' hh' => ?_⟩
    apply pullback.hom_ext
    · rw [pullback.lift_fst]
      apply hkuniq
      rw [Category.assoc, pullback.condition, ← Category.assoc, hh']
    · rw [pullback.lift_snd]
      exact hh'

variable (t : MonoidalTransformation X B) {Y : Scheme.{u}} (g : Y ⟶ X) [Flat g]

@[simp] theorem baseChange_X' : (t.baseChange g).X' = pullback t.f g := rfl

@[simp] theorem baseChange_f : (t.baseChange g).f = pullback.snd t.f g := rfl

/-- **Flat base change of monoidal transformations** (Ch. IV §1, p. 276: "if `h` is obtained by
a monoidal transformation of `X''` with center `B''`, then `h_S` is obtained by the monoidal
transformation of `X''_S` with center `B''_S`").  For a monoidal transformation `f : X' → X` with
center `B` and a flat morphism `g : Y → X`, the projection `X' ×_X Y → Y` is a monoidal
transformation of `Y` with center `g⁻¹(B)`.

Deviation from the paper (gap filled): p. 276 asserts the statement for `Spec(S) → X` without
argument. -/
@[blueprint "compat:blowup-flat-base-change"
  (statement := /-- Let $f\colon X'\to X$ be the monoidal transformation of $X$ with center $B$
    (\cref{def:monoidal-transformation}) and $g\colon Y\to X$ a flat morphism. Then the
    projection $X'\times_XY\to Y$ is the monoidal transformation of $Y$ with center
    $g^{-1}(B)$ (\cref{def:total-transform}). In particular (Ch.~IV \S1, p.~276), ``if $h$ is
    obtained by a monoidal transformation of $X''$ with center $B''$, then $h_S$ is obtained by
    the monoidal transformation of $X''_S$ with center $B''_S$'', $\operatorname{Spec}(S)\to X$
    being flat. -/)
  (proof := /-- Locally the ideal of $f^{-1}(B)$ is generated by a non-zero-divisor $a$; its image
    in $X'\times_XY$ is still a non-zero-divisor, because the projection $X'\times_XY\to X'$ is
    flat and flat ring homomorphisms preserve non-zero-divisors, so the ideal of
    $(g')^{-1}(g^{-1}(B))=(f')^{-1}(f^{-1}(B))$ is invertible. If $k\colon Z\to Y$ makes
    $g^{-1}(B)$ invertible, then $g\circ k$ makes $B$ invertible, hence factors uniquely through
    $X'$ by the universal mapping property, hence $k$ factors uniquely through the fibre
    product.
    \textbf{Gap in the paper filled.} The paper asserts the statement for
    $\operatorname{Spec}(S)\to X$ without argument (p.~276); the proof above, for any flat
    base change, uses only the universal mapping property of p.~166. -/)
  (latexEnv := "theorem")]
theorem exists_baseChange :
    ∃ s : MonoidalTransformation Y (Subscheme.totalTransform g B),
      ∃ e : s.X' ≅ pullback t.f g,
        e.hom ≫ pullback.snd t.f g = s.f ∧ e.hom ≫ pullback.fst t.f g ≫ t.f = s.f ≫ g :=
  ⟨t.baseChange g, Iso.refl _, by simp, by simp [pullback.condition]⟩

end MonoidalTransformation

/-- Flat base change applied to `Spec O_{X,x} → X` (Ch. IV §1): for any morphism `f : X'' → X`
and point `x : X`, a monoidal transformation of `X''` with center `B''` induces one of the
localization `X''_S = X'' ×_X Spec O_{X,x}` with center `B''_S`. -/
noncomputable def MonoidalTransformation.localize {X X'' : Scheme.{u}} (f : X'' ⟶ X) (x : X)
    {B'' : Subscheme X''} (t : MonoidalTransformation X'' B'') :
    MonoidalTransformation (pullback f (X.fromSpecStalk x))
      (Subscheme.totalTransform (pullback.fst f (X.fromSpecStalk x)) B'') :=
  have := flat_fromSpecStalk X x
  t.baseChange (pullback.fst f (X.fromSpecStalk x))

/-! ### Subscheme facts used along flat base changes -/

namespace Subscheme

variable {Z : Scheme.{u}}

theorem mem_pts_ι (D : Subscheme Z) (z : D.toScheme) : D.ι z ∈ D.pts := by
  show D.ι z ∈ (D.support : Set Z)
  rw [← Scheme.IdealSheafData.range_subschemeι]
  exact ⟨z, rfl⟩

theorem exists_ι_eq_of_mem_pts (D : Subscheme Z) {z : Z} (hz : z ∈ D.pts) :
    ∃ z' : D.toScheme, D.ι z' = z := by
  have : z ∈ Set.range D.ι := by
    rw [Scheme.IdealSheafData.range_subschemeι]
    exact hz
  exact this

theorem isReduced_stalk_quot (D : Subscheme Z) (hD : D.IsReduced) {z : Z} (hz : z ∈ D.pts) :
    _root_.IsReduced (Z.presheaf.stalk z ⧸ D.stalkIdeal z) := by
  have : AlgebraicGeometry.IsReduced D.toScheme := hD
  obtain ⟨z', rfl⟩ := exists_ι_eq_of_mem_pts D hz
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv D z'
  exact isReduced_of_injective e.toRingHom e.injective

theorem isRegular_stalk_quot (D : Subscheme Z) (hD : D.IsNonsingular) {z : Z}
    (hz : z ∈ D.pts) : IsRegularLocalRing (Z.presheaf.stalk z ⧸ D.stalkIdeal z) := by
  obtain ⟨z', rfl⟩ := exists_ι_eq_of_mem_pts D hz
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv D z'
  have : IsRegularLocalRing (D.toScheme.presheaf.stalk z') := hD z'
  exact IsRegularLocalRing.of_ringEquiv e.symm

theorem isReduced_of_stalk_quot (D : Subscheme Z)
    (h : ∀ z ∈ D.pts, _root_.IsReduced (Z.presheaf.stalk z ⧸ D.stalkIdeal z)) :
    D.IsReduced := by
  have : ∀ z' : D.toScheme, _root_.IsReduced (D.toScheme.presheaf.stalk z') := fun z' => by
    obtain ⟨e⟩ := nonempty_stalk_quot_equiv D z'
    have := h (D.ι z') (mem_pts_ι D z')
    exact isReduced_of_injective e.symm.toRingHom e.symm.injective
  exact isReduced_of_isReduced_stalk _

theorem isNonsingular_of_stalk_quot (D : Subscheme Z)
    (h : ∀ z ∈ D.pts, IsRegularLocalRing (Z.presheaf.stalk z ⧸ D.stalkIdeal z)) :
    D.IsNonsingular := fun z' => by
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv D z'
  have := h (D.ι z') (mem_pts_ι D z')
  exact IsRegularLocalRing.of_ringEquiv e

theorem isIrreducible_pts (D : Subscheme Z) (hD : D.IsIrreducible) :
    _root_.IsIrreducible D.pts := by
  have : IrreducibleSpace D.toScheme := hD
  have h := (IrreducibleSpace.isIrreducible_univ D.toScheme).image D.ι
    D.ι.continuous.continuousOn
  rwa [Set.image_univ, Scheme.IdealSheafData.range_subschemeι] at h

theorem isIrreducible_of_pts (D : Subscheme Z) (h : _root_.IsIrreducible D.pts) :
    D.IsIrreducible := by
  have hr : _root_.IsIrreducible (Set.range D.ι) := by
    rw [Scheme.IdealSheafData.range_subschemeι]
    exact h
  have := Subtype.irreducibleSpace hr
  let e := D.ι.isEmbedding.toHomeomorph
  have h2 := (IrreducibleSpace.isIrreducible_univ (Set.range D.ι)).image e.symm
    e.symm.continuous.continuousOn
  rw [Set.image_univ, e.symm.surjective.range_eq] at h2
  exact (irreducibleSpace_def _).mpr h2

theorem irreducibleComponents_congr {E₁ E₂ : Subscheme Z} (h : E₁.pts = E₂.pts) :
    E₁.irreducibleComponents = E₂.irreducibleComponents := by
  unfold Subscheme.irreducibleComponents
  rw [h]

theorem hasOnlyNormalCrossingsWithAt_congr {E₁ E₂ : Subscheme Z} (h : E₁.pts = E₂.pts)
    (D : Subscheme Z) (z : Z) :
    E₁.HasOnlyNormalCrossingsWithAt D z ↔ E₂.HasOnlyNormalCrossingsWithAt D z := by
  unfold Subscheme.HasOnlyNormalCrossingsWithAt
  rw [irreducibleComponents_congr h]

theorem mem_pts_iff_of_affine (D : Subscheme Z) {z : Z} {U : Z.affineOpens}
    (hzU : z ∈ (U : Z.Opens)) :
    z ∈ D.pts ↔ ∀ f ∈ D.ideal U, ¬ IsUnit (Z.presheaf.germ U z hzU f) := by
  show z ∈ (D.support : Set Z) ↔ _
  rw [SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem (U := U) hzU,
    Scheme.mem_zeroLocus_iff]
  simp only [Scheme.mem_basicOpen _ _ _ hzU]
  rfl

theorem pts_inf (A B : Subscheme Z) : (A ⊓ B).pts = A.pts ∪ B.pts := by
  ext z
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ :=
    Z.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
  let U' : Z.affineOpens := ⟨U, hU⟩
  rw [Set.mem_union, mem_pts_iff_of_affine _ (U := U') hzU, mem_pts_iff_of_affine _ (U := U') hzU,
    mem_pts_iff_of_affine _ (U := U') hzU]
  constructor
  · intro h
    by_contra hne
    push Not at hne
    obtain ⟨⟨a, ha, hua⟩, ⟨b, hb, hub⟩⟩ := hne
    refine h (a * b) ⟨Ideal.mul_mem_right _ _ ha, Ideal.mul_mem_left _ _ hb⟩ ?_
    rw [map_mul]
    exact hua.mul hub
  · rintro (h | h) g hg
    · exact h g hg.1
    · exact h g hg.2

theorem pts_iInf {α : ℕ} (E : Fin α → Subscheme Z) : (⨅ i, E i).pts = ⋃ i, (E i).pts := by
  classical
  ext z
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ :=
    Z.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
  let U' : Z.affineOpens := ⟨U, hU⟩
  rw [Set.mem_iUnion, mem_pts_iff_of_affine _ (U := U') hzU]
  simp_rw [mem_pts_iff_of_affine _ (U := U') hzU]
  rw [Scheme.IdealSheafData.ideal_iInf, iInf_apply]
  constructor
  · intro h
    by_contra hne
    push Not at hne
    choose g hg hug using hne
    refine h (∏ i, g i) ((Submodule.mem_iInf _).mpr fun i => ?_) ?_
    · rw [← Finset.mul_prod_erase Finset.univ g (Finset.mem_univ i)]
      exact Ideal.mul_mem_right _ _ (hg i)
    · rw [map_prod, IsUnit.prod_univ_iff]
      exact hug
  · rintro ⟨i, hi⟩ g hg
    exact hi g ((Submodule.mem_iInf _).mp hg i)

/-- The ideal sheaf of a reduced subscheme is its own radical. -/
theorem radical_eq_self_of_isReduced (D : Subscheme Z) (hD : D.IsReduced) :
    D.radical = D := by
  have : AlgebraicGeometry.IsReduced D.toScheme := hD
  refine Scheme.IdealSheafData.ext (funext fun U => ?_)
  show (D.ideal U).radical = D.ideal U
  have e := (Scheme.IdealSheafData.subschemeObjIso D U).commRingCatIsoToRingEquiv
  have : _root_.IsReduced (Γ(Z, U) ⧸ D.ideal U) :=
    isReduced_of_injective e.symm.toRingHom e.symm.injective
  exact ((Ideal.isRadical_iff_quotient_reduced _).mpr this).radical

/-- A subscheme whose ideal sheaf is its own radical is reduced. -/
theorem isReduced_of_radical_eq (D : Subscheme Z) (h : D.radical = D) : D.IsReduced := by
  refine isReduced_of_stalk_quot D fun z _ => ?_
  obtain ⟨_, ⟨U, hU₀, rfl⟩, hzU, -⟩ :=
    Z.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
  have hU : IsAffineOpen U := hU₀
  let _ := TopCat.Presheaf.algebra_section_stalk Z.presheaf (U := U) ⟨z, hzU⟩
  have : IsLocalization (hU.primeIdealOf ⟨z, hzU⟩).asIdeal.primeCompl (Z.presheaf.stalk z) :=
    hU.isLocalization_stalk ⟨z, hzU⟩
  have hrad : (D.ideal ⟨U, hU₀⟩).radical = D.ideal ⟨U, hU₀⟩ := by
    have := congrArg (fun I => Scheme.IdealSheafData.ideal I ⟨U, hU₀⟩) h
    exact this
  rw [stalkIdeal_eq_map_germ D ⟨U, hU₀⟩ hzU]
  refine (Ideal.isRadical_iff_quotient_reduced _).mp ?_
  have := IsLocalization.map_radical (hU.primeIdealOf ⟨z, hzU⟩).asIdeal.primeCompl
    (Z.presheaf.stalk z) (D.ideal ⟨U, hU₀⟩)
  rw [hrad] at this
  show ((D.ideal ⟨U, hU₀⟩).map (algebraMap Γ(Z, U) (Z.presheaf.stalk z))).IsRadical
  rw [Ideal.IsRadical, ← this]

theorem pts_ofClosed (T : Closeds Z) : (Subscheme.ofClosed T).pts = T :=
  Scheme.IdealSheafData.coe_support_vanishingIdeal T

theorem ofClosed_radical (T : Closeds Z) :
    (Subscheme.ofClosed T).radical = Subscheme.ofClosed T := by
  have h1 : (Subscheme.ofClosed T).support = T := by
    ext1
    exact Scheme.IdealSheafData.coe_support_vanishingIdeal T
  have := Scheme.IdealSheafData.vanishingIdeal_support (I := Subscheme.ofClosed T)
  rw [h1] at this
  exact this.symm

theorem ofClosed_isReduced (T : Closeds Z) : (Subscheme.ofClosed T).IsReduced :=
  isReduced_of_radical_eq _ (ofClosed_radical T)

/-- A reduced subscheme is the reduced subscheme on its support. -/
theorem eq_ofClosed_support (D : Subscheme Z) (hD : D.IsReduced) :
    D = Subscheme.ofClosed D.support := by
  unfold Subscheme.ofClosed
  rw [Scheme.IdealSheafData.vanishingIdeal_support, radical_eq_self_of_isReduced D hD]

/-- Normal flatness is invariant under ring isomorphisms. -/
theorem _root_.Hironaka.isNormallyFlatAlongIdeal_of_ringEquiv {A B : Type u} [CommRing A] [CommRing B]
    (e : A ≃+* B) (I : Ideal A) (J : Ideal B) (hIJ : I.map (e : A →+* B) = J)
    (h : IsNormallyFlatAlongIdeal I) : IsNormallyFlatAlongIdeal J := by
  intro n
  have := RingHomInvPair.of_ringEquiv e
  have := RingHomInvPair.symm (e : A →+* B) (e.symm : B →+* A)
  let f₀ : A ≃ₛₗ[(e : A →+* B)] B := e.toSemilinearEquiv
  have hpow : ∀ k, J ^ k = (I ^ k).comap (e.symm : B →+* A) := by
    intro k
    rw [← hIJ, ← Ideal.map_pow, Ideal.map_comap_of_equiv]
    rfl
  have hmap : ∀ k, Submodule.map (f₀ : A →ₛₗ[(e : A →+* B)] B) (I ^ k) = J ^ k := by
    intro k
    ext x
    rw [Submodule.mem_map, hpow k, Ideal.mem_comap]
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa [f₀] using hy
    · intro hx
      exact ⟨e.symm x, hx, by simp [f₀]⟩
  let g₀ : ↥(I ^ n) ≃ₛₗ[(e : A →+* B)] ↥(J ^ n) :=
    (f₀.submoduleMap (I ^ n)).trans (LinearEquiv.ofEq _ _ (hmap n))
  have hq : (Submodule.comap (I ^ n).subtype (I ^ (n + 1))).map
      (g₀ : ↥(I ^ n) →ₛₗ[(e : A →+* B)] ↥(J ^ n)) =
      Submodule.comap (J ^ n).subtype (J ^ (n + 1)) := by
    rw [Submodule.map_equiv_eq_comap_symm]
    ext ⟨x, hx⟩
    show ((g₀.symm ⟨x, hx⟩ : ↥(I ^ n)) : A) ∈ I ^ (n + 1) ↔ x ∈ J ^ (n + 1)
    rw [hpow (n + 1), Ideal.mem_comap]
    rfl
  let j : GrPiece I n ≃ₛₗ[(e : A →+* B)] GrPiece J n := Submodule.Quotient.equiv _ _ g₀ hq
  let i : A ⧸ I ≃+* B ⧸ J := Ideal.quotientEquiv I J e hIJ.symm
  have := RingHomInvPair.of_ringEquiv i
  have := RingHomInvPair.symm (i : A ⧸ I →+* B ⧸ J) (i.symm : B ⧸ J →+* A ⧸ I)
  let j' : GrPiece I n ≃ₛₗ[(i : A ⧸ I →+* B ⧸ J)] GrPiece J n :=
    { j.toAddEquiv with
      map_smul' := fun r m => by
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
        have h1 : (Ideal.Quotient.mk I a) • m = a • m := algebraMap_smul (A ⧸ I) a m
        have h2 : i (Ideal.Quotient.mk I a) = Ideal.Quotient.mk J (e a) := rfl
        have h3 : (Ideal.Quotient.mk J (e a)) • j m = e a • j m :=
          algebraMap_smul (B ⧸ J) (e a) (j m)
        change j ((Ideal.Quotient.mk I a) • m) = i (Ideal.Quotient.mk I a) • j m
        rw [h1, h2, h3]
        exact j.map_smulₛₗ a m }
  have := h n
  exact Module.Free.of_equiv j'

/-- `V` is normally flat along `W ⊆ V` at `x` iff `O_{V,x} = O_{Z,x}/V_x` is normally flat along
the image of `W_x`. -/
theorem isNormallyFlatAlongAt'_iff (V W : Subscheme Z) (hWV : W.IsContainedIn V) (z : Z) :
    Subscheme.IsNormallyFlatAlongAt' V W z ↔ z ∈ W.pts ∧
      IsNormallyFlatAlongIdeal ((W.stalkIdeal z).map (Ideal.Quotient.mk (V.stalkIdeal z))) := by
  have key : ∀ z' : V.toScheme,
      (Subscheme.totalTransform V.ι W).stalkIdeal z' =
        ((W.stalkIdeal (V.ι z')).map (Ideal.Quotient.mk (V.stalkIdeal (V.ι z')))).map
          ((Ideal.quotEquivOfEq (stalkIdeal_eq_ker_stalkMap V z')).trans
            (RingHom.quotientKerEquivOfSurjective (V.ι.stalkMap_surjective z'))
            : _ →+* V.toScheme.presheaf.stalk z') := by
    intro z'
    rw [stalkIdeal_totalTransform, Ideal.map_map]
    rfl
  have hpts : ∀ z' : V.toScheme, z' ∈ (Subscheme.totalTransform V.ι W).pts ↔ V.ι z' ∈ W.pts := by
    intro z'
    change z' ∈ ((W.comap V.ι).support : Set V.toScheme) ↔ _
    rw [Scheme.IdealSheafData.support_comap]
    rfl
  constructor
  · rintro ⟨z', rfl, hz'1, hz'2⟩
    refine ⟨(hpts z').mp hz'1, ?_⟩
    rw [key] at hz'2
    let ψ := (Ideal.quotEquivOfEq (stalkIdeal_eq_ker_stalkMap V z')).trans
        (RingHom.quotientKerEquivOfSurjective (V.ι.stalkMap_surjective z'))
    refine Hironaka.isNormallyFlatAlongIdeal_of_ringEquiv ψ.symm _ _ ?_ hz'2
    rw [Ideal.map_map]
    convert Ideal.map_id _
    ext a
    simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply]
    rw [RingEquiv.coe_toRingHom, RingEquiv.symm_apply_eq]
    rfl
  · rintro ⟨hzW, hnf⟩
    obtain ⟨z', rfl⟩ := exists_ι_eq_of_mem_pts V (pts_subset_of_isContainedIn hWV hzW)
    refine ⟨z', rfl, (hpts z').mpr hzW, ?_⟩
    rw [key]
    exact Hironaka.isNormallyFlatAlongIdeal_of_ringEquiv _ _ _ rfl hnf

/-- The local ring of `Z` at the generic point `ξ` of `W` is `(O_{Z,x})_{W_x}` for `x ∈ W`
(when `W_x` is prime).  (Same argument as in Ch. II §1.) -/
theorem nonempty_stalk_equiv_localization_of_isGenericPoint {X : Scheme.{u}} (W : Subscheme X)
    {ξ : X} (hξ : IsGenericPoint ξ W.pts) {x : X} (hx : x ∈ W.pts)
    [hq : (W.stalkIdeal x).IsPrime] :
    Nonempty (X.presheaf.stalk ξ ≃+* Localization.AtPrime (W.stalkIdeal x)) := by
  have hspec : ξ ⤳ x := by
    rw [specializes_iff_mem_closure, hξ.def]
    exact hx
  obtain ⟨_, ⟨U, hU₀, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have hU : IsAffineOpen U := hU₀
  have hξU : ξ ∈ U := hspec.mem_open U.isOpen hxU
  have hxr : x ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hxU
  have hξr : ξ ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hξU
  obtain ⟨px, rfl⟩ := hxr
  obtain ⟨pξ, rfl⟩ := hξr
  have hle : pξ.asIdeal ≤ px.asIdeal :=
    (PrimeSpectrum.le_iff_specializes (x := pξ) (y := px)).mpr
      ((hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp hspec)
  let _ : Algebra Γ(X, U) (X.presheaf.stalk (hU.fromSpec px)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hU.fromSpec px, hxU⟩
  have hpx : px.asIdeal.IsPrime := PrimeSpectrum.isPrime px
  have hpξ : pξ.asIdeal.IsPrime := PrimeSpectrum.isPrime pξ
  have hlocx : IsLocalization.AtPrime (X.presheaf.stalk (hU.fromSpec px)) px.asIdeal :=
    hU.isLocalization_stalk' px hxU
  set I := W.ideal ⟨U, hU₀⟩ with hI
  -- the stalk `W_x` is generated by `W(U)`
  have hW : W.stalkIdeal (hU.fromSpec px) =
      I.map (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec px))) := by
    apply le_antisymm
    · rw [Subscheme.stalkIdeal, Ideal.span_le]
      rintro _ ⟨V, hxV, s, hs, rfl⟩
      obtain ⟨_, ⟨D, hD, rfl⟩, hxD, hDUV⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
        (show hU.fromSpec px ∈ (U ⊓ V.1 : TopologicalSpace.Opens X) from ⟨hxU, hxV⟩)
        (U ⊓ V.1).isOpen
      have hDV : (⟨D, hD⟩ : X.affineOpens) ≤ V := hDUV.trans inf_le_right
      have hDU : (⟨D, hD⟩ : X.affineOpens) ≤ ⟨U, hU₀⟩ := hDUV.trans inf_le_left
      have h1 := W.ideal_le_comap_ideal hDV hs
      rw [Ideal.mem_comap, ← W.map_ideal hDU] at h1
      have h2 := Ideal.mem_map_of_mem (X.presheaf.germ D _ hxD).hom h1
      rw [Ideal.map_map] at h2
      have e1 : (X.presheaf.germ D _ hxD).hom.comp
          (X.presheaf.map (CategoryTheory.homOfLE hDU).op).hom =
          algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec px)) := by
        ext t
        exact X.presheaf.germ_res_apply (CategoryTheory.homOfLE hDU) _ hxD t
      have e2 : (X.presheaf.germ D _ hxD).hom
          ((X.presheaf.map (CategoryTheory.homOfLE hDV).op).hom s) =
          (X.presheaf.germ V.1 _ hxV).hom s := X.presheaf.germ_res_apply _ _ _ _
      rw [e1, e2] at h2
      exact h2
    · rw [Ideal.map_le_iff_le_comap]
      intro t ht
      exact Ideal.subset_span ⟨⟨U, hU₀⟩, hxU, t, ht, rfl⟩
  -- `√W(U) = P_ξ`: `V(W(U)) = W ∩ U = closure {ξ} ∩ U`
  have hzero : PrimeSpectrum.zeroLocus (I : Set Γ(X, U)) =
      PrimeSpectrum.zeroLocus (pξ.asIdeal : Set Γ(X, U)) := by
    ext p
    have h1 : hU.fromSpec '' PrimeSpectrum.zeroLocus (I : Set Γ(X, U)) =
        (W.support : Set X) ∩ U := by
      rw [hU.fromSpec_image_zeroLocus, W.coe_support_inter ⟨U, hU₀⟩]
    have h2 : p ∈ PrimeSpectrum.zeroLocus (I : Set Γ(X, U)) ↔ hU.fromSpec p ∈ W.pts := by
      constructor
      · intro hp
        have : hU.fromSpec p ∈ hU.fromSpec '' PrimeSpectrum.zeroLocus (I : Set Γ(X, U)) :=
          ⟨p, hp, rfl⟩
        rw [h1] at this
        exact this.1
      · intro hp
        have : hU.fromSpec p ∈ (W.support : Set X) ∩ U :=
          ⟨hp, by rw [← hU.range_fromSpec]; exact ⟨p, rfl⟩⟩
        rw [← h1] at this
        obtain ⟨p', hp', he⟩ := this
        rwa [← hU.fromSpec.isOpenEmbedding.injective he]
    have h3 : hU.fromSpec p ∈ W.pts ↔ pξ.asIdeal ≤ p.asIdeal := by
      rw [← hξ.def, ← specializes_iff_mem_closure]
      refine hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff.trans ?_
      exact (PrimeSpectrum.le_iff_specializes (x := pξ) (y := p)).symm
    rw [h2, h3, PrimeSpectrum.mem_zeroLocus]
    exact SetLike.coe_subset_coe.symm
  have hrad : I.radical = pξ.asIdeal := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hzero,
      PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hpξ.radical]
  -- `W_x = P_ξ O_{X,x}`
  have hq' : W.stalkIdeal (hU.fromSpec px) =
      pξ.asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec px))) := by
    apply le_antisymm
    · rw [hW]
      exact Ideal.map_mono (hrad ▸ Ideal.le_radical)
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [← hrad] at ha
      obtain ⟨n, hn⟩ := ha
      have := Ideal.mem_map_of_mem (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec px))) hn
      rw [← hW, map_pow] at this
      exact hq.mem_of_pow_mem n this
  have hcomap : (W.stalkIdeal (hU.fromSpec px)).comap
      (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec px))) = pξ.asIdeal := by
    rw [hq']
    exact IsLocalization.under_map_of_isPrime_disjoint px.asIdeal.primeCompl _ hpξ
      (by
        rw [Set.disjoint_left]
        intro a ha ha'
        exact ha (hle ha'))
  have hlocq : IsLocalization.AtPrime (Localization.AtPrime (W.stalkIdeal (hU.fromSpec px)))
      pξ.asIdeal := by
    have := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      px.asIdeal.primeCompl
      (S := X.presheaf.stalk (hU.fromSpec px))
      (Localization.AtPrime (W.stalkIdeal (hU.fromSpec px))) (W.stalkIdeal (hU.fromSpec px))
    convert this using 2
    exact hcomap.symm
  let _ : Algebra Γ(X, U) (X.presheaf.stalk (hU.fromSpec pξ)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hU.fromSpec pξ, hξU⟩
  have hlocξ : IsLocalization.AtPrime (X.presheaf.stalk (hU.fromSpec pξ)) pξ.asIdeal :=
    hU.isLocalization_stalk' pξ hξU
  exact ⟨(IsLocalization.algEquiv pξ.asIdeal.primeCompl (X.presheaf.stalk (hU.fromSpec pξ))
    (Localization.AtPrime (W.stalkIdeal (hU.fromSpec px)))).toRingEquiv⟩

theorem isPrime_stalkIdeal_of_isNonsingular_of_mem_pts (W : Subscheme Z) (hW : W.IsNonsingular) {z : Z}
    (hz : z ∈ W.pts) : (W.stalkIdeal z).IsPrime := by
  have := isRegular_stalk_quot W hW hz
  have := isDomain_of_isRegularLocalRing (Z.presheaf.stalk z ⧸ W.stalkIdeal z)
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- Along a non-singular subscheme `W` with generic point `ξ`, the height of `W_z` is the
dimension of `O_{Z,ξ}`. -/
theorem height_stalkIdeal_eq (W : Subscheme Z) (hW : W.IsNonsingular) {ξ : Z}
    (hξ : IsGenericPoint ξ W.pts) {z : Z} (hz : z ∈ W.pts) :
    ((W.stalkIdeal z).height : WithBot ℕ∞) = ringKrullDim (Z.presheaf.stalk ξ) := by
  have := isPrime_stalkIdeal_of_isNonsingular_of_mem_pts W hW hz
  obtain ⟨e⟩ := nonempty_stalk_equiv_localization_of_isGenericPoint W hξ hz
  rw [ringKrullDim_eq_of_ringEquiv e,
    IsLocalization.AtPrime.ringKrullDim_eq_height (W.stalkIdeal z)]

/-- The codimension of a non-singular irreducible subscheme is the height at any of its
points. -/
theorem codim_eq_height (W : Subscheme Z) (hW : W.IsNonsingular) (hirr : W.IsIrreducible)
    {z : Z} (hz : z ∈ W.pts) : W.codim = (W.stalkIdeal z).height := by
  have hI := isIrreducible_pts W hirr
  obtain ⟨ξ, hξ⟩ : ∃ ξ, IsGenericPoint ξ W.pts := QuasiSober.sober hI W.support.isClosed
  have hc : ∀ w ∈ W.pts, (W.stalkIdeal w).height = (W.stalkIdeal z).height := by
    intro w hw
    have h1 := height_stalkIdeal_eq W hW hξ hw
    have h2 := height_stalkIdeal_eq W hW hξ hz
    exact_mod_cast h1.trans h2.symm
  refine le_antisymm (iInf₂_le z hz) (le_iInf₂ fun w hw => ?_)
  exact (hc w hw).ge

end Subscheme

/-! ### Flat preimmersions

A flat preimmersion `g : Y' → Y` (such as `Spec O_{Y,y} → Y`, its base changes, or an
isomorphism) has bijective stalk maps and a range closed under generization, so the local
properties of subschemes of `Y` are those of their pull-backs to `Y'`. -/

namespace FlatPreimm

variable {Y Y' : Scheme.{u}} (g : Y' ⟶ Y)

theorem pts_totalTransform (D : Subscheme Y) :
    (Subscheme.totalTransform g D).pts = g.base ⁻¹' D.pts := by
  change ((D.comap g).support : Set Y') = _
  rw [Scheme.IdealSheafData.support_comap]
  rfl

theorem totalTransform_mono {D D' : Subscheme Y} (h : D ≤ D') :
    Subscheme.totalTransform g D ≤ Subscheme.totalTransform g D' :=
  Scheme.IdealSheafData.comap_mono _ h

variable [Flat g] [IsPreimmersion g]

omit [IsPreimmersion g] in
theorem mem_range_of_specializes {z w : Y} (hwz : w ⤳ z) (hz : z ∈ Set.range g.base) :
    w ∈ Set.range g.base := by
  obtain ⟨z', rfl⟩ := hz
  obtain ⟨w', -, hw'⟩ := Flat.generalizingMap g hwz
  exact ⟨w', hw'⟩

theorem stalkMap_bijective (y : Y') : Function.Bijective (g.stalkMap y).hom := by
  refine ⟨?_, g.stalkMap_surjective y⟩
  let _ : Algebra (Y.presheaf.stalk (g y)) (Y'.presheaf.stalk y) := (g.stalkMap y).hom.toAlgebra
  have : Module.Flat (Y.presheaf.stalk (g y)) (Y'.presheaf.stalk y) := Flat.stalkMap g y
  have : IsLocalHom (algebraMap (Y.presheaf.stalk (g y)) (Y'.presheaf.stalk y)) := by
    show IsLocalHom (g.stalkMap y).hom
    infer_instance
  have hff := Module.FaithfullyFlat.of_flat_of_isLocalHom
    (A := Y.presheaf.stalk (g y)) (B := Y'.presheaf.stalk y)
  exact (RingHom.faithfullyFlat_algebraMap_iff.mpr hff).injective

/-- The stalk isomorphism `O_{Y, g y} ≅ O_{Y', y}`. -/
noncomputable def stalkEquiv (y : Y') : Y.presheaf.stalk (g y) ≃+* Y'.presheaf.stalk y :=
  RingEquiv.ofBijective _ (stalkMap_bijective g y)

theorem stalkIdeal_totalTransform (D : Subscheme Y) (y : Y') :
    (Subscheme.totalTransform g D).stalkIdeal y =
      (D.stalkIdeal (g y)).map (stalkEquiv g y) :=
  Hironaka.stalkIdeal_totalTransform g D y

theorem quotEquiv (D : Subscheme Y) (y : Y') :
    Nonempty ((Y.presheaf.stalk (g y) ⧸ D.stalkIdeal (g y)) ≃+*
      (Y'.presheaf.stalk y ⧸ (Subscheme.totalTransform g D).stalkIdeal y)) :=
  ⟨Ideal.quotientEquiv _ _ (stalkEquiv g y) (stalkIdeal_totalTransform g D y)⟩

theorem isReduced_totalTransform (D : Subscheme Y) (hD : D.IsReduced) :
    (Subscheme.totalTransform g D).IsReduced := by
  refine Subscheme.isReduced_of_stalk_quot _ fun y hy => ?_
  have hjy : g y ∈ D.pts := by
    rw [pts_totalTransform] at hy
    exact hy
  obtain ⟨e⟩ := quotEquiv g D y
  have := Subscheme.isReduced_stalk_quot D hD hjy
  exact isReduced_of_injective e.symm.toRingHom e.symm.injective

theorem isNonsingular_totalTransform (D : Subscheme Y) (hD : D.IsNonsingular) :
    (Subscheme.totalTransform g D).IsNonsingular := by
  refine Subscheme.isNonsingular_of_stalk_quot _ fun y hy => ?_
  have hjy : g y ∈ D.pts := by
    rw [pts_totalTransform] at hy
    exact hy
  obtain ⟨e⟩ := quotEquiv g D y
  have := Subscheme.isRegular_stalk_quot D hD hjy
  exact IsRegularLocalRing.of_ringEquiv e

theorem empty_or_isIrreducible_totalTransform (D : Subscheme Y) (hD : D.IsIrreducible) :
    Subscheme.totalTransform g D = Subscheme.empty ∨
      (Subscheme.totalTransform g D).IsIrreducible := by
  by_cases hne : (Subscheme.totalTransform g D).pts.Nonempty
  · right
    obtain ⟨y, hy⟩ := hne
    have hirr := Subscheme.isIrreducible_pts D hD
    have hcl : IsClosed D.pts := D.support.isClosed
    set η := hirr.genericPoint
    have hηspec : closure {η} = D.pts := by
      rw [hirr.isGenericPoint_genericPoint_closure.def, hcl.closure_eq]
    have hjy : g y ∈ D.pts := by
      rw [pts_totalTransform] at hy
      exact hy
    have hηjy : η ⤳ g y := specializes_iff_mem_closure.mpr (by rw [hηspec]; exact hjy)
    obtain ⟨η', hη'⟩ := mem_range_of_specializes g hηjy ⟨y, rfl⟩
    have hpts : (Subscheme.totalTransform g D).pts = closure {η'} := by
      rw [pts_totalTransform, g.isEmbedding.isInducing.closure_eq_preimage_closure_image,
        Set.image_singleton, hη', hηspec]
    refine Subscheme.isIrreducible_of_pts _ ?_
    rw [hpts]
    exact isIrreducible_singleton.closure
  · left
    rw [Set.not_nonempty_iff_eq_empty] at hne
    refine (Scheme.IdealSheafData.support_eq_bot_iff (I := Subscheme.totalTransform g D)).mp ?_
    ext1
    exact hne

theorem codimAt_totalTransform (D : Subscheme Y) (y : Y') :
    (Subscheme.totalTransform g D).codimAt y = D.codimAt (g y) := by
  unfold Subscheme.codimAt
  rw [stalkIdeal_totalTransform, RingEquiv.height_map]

/-- The irreducible components of `g⁻¹(E)` through `y` are the pull-backs of the irreducible
components of `E` through `g y`. -/
theorem irreducibleComponents_totalTransform (E : Subscheme Y) {C' : Subscheme Y'}
    (hC' : C' ∈ (Subscheme.totalTransform g E).irreducibleComponents) {y : Y'}
    (hy : y ∈ C'.pts) :
    ∃ C ∈ E.irreducibleComponents, g y ∈ C.pts ∧ C' = Subscheme.totalTransform g C := by
  have hemb := g.isEmbedding
  obtain ⟨ZS, ⟨⟨hZirr, hZsub⟩, hZmax⟩, rfl⟩ := hC'
  set ζ' := hZirr.genericPoint
  have hζ'spec : closure {ζ'} = (ZS : Set _) := by
    rw [hZirr.isGenericPoint_genericPoint_closure.def, ZS.isClosed.closure_eq]
  set ζ := g ζ'
  let Zc : Closeds Y := ⟨closure {ζ}, isClosed_closure⟩
  have hZS : (ZS : Set _) = g.base ⁻¹' closure {ζ} := by
    rw [← hζ'spec, hemb.isInducing.closure_eq_preimage_closure_image, Set.image_singleton]
  have hζE : ζ ∈ E.pts := by
    have : ζ' ∈ (Subscheme.totalTransform g E).pts :=
      hZsub (by rw [← hζ'spec]; exact subset_closure rfl)
    rw [pts_totalTransform] at this
    exact this
  have hZE : (Zc : Set Y) ⊆ E.pts :=
    closure_minimal (Set.singleton_subset_iff.mpr hζE) E.support.isClosed
  have hmax : Maximal (fun T : Closeds Y => _root_.IsIrreducible (T : Set Y) ∧ (T : Set Y) ⊆ E.pts)
      Zc := by
    refine ⟨⟨isIrreducible_singleton.closure, hZE⟩, fun T ⟨hTirr, hTE⟩ hZT => ?_⟩
    obtain ⟨τ, hτ⟩ : ∃ τ, IsGenericPoint τ (T : Set Y) := QuasiSober.sober hTirr T.isClosed
    have hτζ : τ ⤳ ζ := by
      rw [specializes_iff_mem_closure, hτ.def]
      exact hZT (subset_closure rfl)
    obtain ⟨τ', hτ'⟩ := mem_range_of_specializes g hτζ ⟨ζ', rfl⟩
    let TS : Closeds Y' := ⟨g.base ⁻¹' T, T.isClosed.preimage g.base.hom.continuous⟩
    have hTS : (TS : Set _) = closure {τ'} := by
      show g.base ⁻¹' T = _
      rw [hemb.isInducing.closure_eq_preimage_closure_image, Set.image_singleton, hτ', hτ.def]
    have hle : ZS ≤ TS := by
      intro w hw
      rw [← SetLike.mem_coe, hZS] at hw
      exact hZT hw
    have hTSle : TS ≤ ZS := hZmax (y := TS) ⟨by rw [hTS]; exact isIrreducible_singleton.closure,
      fun w hw => by
        rw [pts_totalTransform]
        exact hTE hw⟩ hle
    have hτ'Z : τ' ∈ (ZS : Set _) :=
      hTSle (by rw [← SetLike.mem_coe, hTS]; exact subset_closure rfl)
    rw [hZS] at hτ'Z
    have : τ ∈ closure {ζ} := by rw [← hτ']; exact hτ'Z
    intro w hw
    rw [← SetLike.mem_coe, ← hτ.def] at hw
    exact closure_minimal (Set.singleton_subset_iff.mpr this) isClosed_closure hw
  have hyZ : g y ∈ closure {ζ} := by
    have : y ∈ (ZS : Set _) := by
      rw [← Subscheme.pts_ofClosed ZS]
      exact hy
    rw [hZS] at this
    exact this
  refine ⟨Subscheme.ofClosed Zc, ⟨Zc, hmax, rfl⟩, ?_, ?_⟩
  · rw [Subscheme.pts_ofClosed]
    exact hyZ
  · have hred := isReduced_totalTransform g _ (Subscheme.ofClosed_isReduced Zc)
    rw [Subscheme.eq_ofClosed_support _ hred]
    congr 1
    ext1
    change (ZS : Set _) = (Subscheme.totalTransform g (Subscheme.ofClosed Zc)).pts
    rw [pts_totalTransform, Subscheme.pts_ofClosed, hZS]
    rfl

/-- Conversely, the pull-back of an irreducible component of `E` through `g y` is an irreducible
component of `g⁻¹(E)`. -/
theorem totalTransform_mem_irreducibleComponents (E : Subscheme Y) {C : Subscheme Y}
    (hC : C ∈ E.irreducibleComponents) {y : Y'} (hy : g y ∈ C.pts) :
    Subscheme.totalTransform g C ∈ (Subscheme.totalTransform g E).irreducibleComponents := by
  have hemb := g.isEmbedding
  obtain ⟨Z, ⟨⟨hZirr, hZsub⟩, hZmax⟩, rfl⟩ := hC
  obtain ⟨ζ, hζ⟩ : ∃ ζ, IsGenericPoint ζ (Z : Set Y) := QuasiSober.sober hZirr Z.isClosed
  have hgy : g y ∈ (Z : Set Y) := by rw [← Subscheme.pts_ofClosed Z]; exact hy
  obtain ⟨ζ', hζ'⟩ := mem_range_of_specializes g (hζ.specializes hgy) ⟨y, rfl⟩
  let ZS : Closeds Y' := ⟨g.base ⁻¹' Z, Z.isClosed.preimage g.base.hom.continuous⟩
  have hZS : (ZS : Set Y') = closure {ζ'} := by
    show g.base ⁻¹' Z = _
    rw [hemb.isInducing.closure_eq_preimage_closure_image, Set.image_singleton, hζ', hζ.def]
  have hmax : Maximal (fun T : Closeds Y' => _root_.IsIrreducible (T : Set Y') ∧
      (T : Set Y') ⊆ (Subscheme.totalTransform g E).pts) ZS := by
    refine ⟨⟨by rw [hZS]; exact isIrreducible_singleton.closure, fun w hw => by
      rw [pts_totalTransform]
      exact hZsub hw⟩, fun T ⟨hTirr, hTE⟩ hZT => ?_⟩
    let T' : Closeds Y := ⟨closure (g.base '' T), isClosed_closure⟩
    have hT'irr : _root_.IsIrreducible (T' : Set Y) :=
      (hTirr.image g.base g.base.hom.continuous.continuousOn).closure
    have hT'E : (T' : Set Y) ⊆ E.pts := by
      refine closure_minimal (Set.image_subset_iff.mpr fun w hw => ?_) E.support.isClosed
      have := hTE hw
      rw [pts_totalTransform] at this
      exact this
    have hZT' : Z ≤ T' := by
      intro w hw
      rw [← SetLike.mem_coe, ← hζ.def] at hw
      refine closure_minimal (Set.singleton_subset_iff.mpr ?_) isClosed_closure hw
      refine subset_closure ⟨ζ', hZT ?_, hζ'⟩
      rw [← SetLike.mem_coe, hZS]
      exact subset_closure rfl
    have hT'Z := hZmax (y := T') ⟨hT'irr, hT'E⟩ hZT'
    intro w hw
    exact hT'Z (subset_closure ⟨w, hw, rfl⟩)
  have hred := isReduced_totalTransform g _ (Subscheme.ofClosed_isReduced Z)
  refine ⟨ZS, hmax, ?_⟩
  rw [Subscheme.eq_ofClosed_support _ hred]
  congr 1
  ext1
  change (Subscheme.totalTransform g (Subscheme.ofClosed Z)).pts = _
  rw [pts_totalTransform, Subscheme.pts_ofClosed]
  rfl

theorem hasOnlyNormalCrossingsWithAt_totalTransform_iff (E D : Subscheme Y) (y : Y') :
    (Subscheme.totalTransform g E).HasOnlyNormalCrossingsWithAt
        (Subscheme.totalTransform g D) y ↔
      E.HasOnlyNormalCrossingsWithAt D (g y) := by
  classical
  set e := stalkEquiv g y
  have hmapset : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A ≃+* B) (s : Finset A),
      ((s.map φ.toEquiv.toEmbedding : Finset B) : Set B) = φ '' (s : Set A) := by
    intro A B _ _ φ s
    simp
  have hback : ∀ I : Ideal (Y.presheaf.stalk (g y)), (I.map e).map e.symm = I := by
    intro I
    rw [← Ideal.map_coe e, ← Ideal.map_coe e.symm, Ideal.map_map]
    convert Ideal.map_id I
    ext a
    simp
  constructor
  · rintro ⟨z, hz, hcomp, t, htz, hDt⟩
    refine ⟨z.map e.symm.toEquiv.toEmbedding, ⟨?_, ?_⟩, fun C hC hyC => ?_,
      t.map e.symm.toEquiv.toEmbedding, Finset.map_subset_map.mpr htz, ?_⟩
    · rw [hmapset, ← Ideal.map_span, hz.1]
      exact IsLocalRing.map_ringEquiv_maximalIdeal e.symm
    · rw [Finset.card_map, hz.2]
      exact ringKrullDim_eq_of_ringEquiv e.symm
    · have hC' := totalTransform_mem_irreducibleComponents g E hC hyC
      have hyC' : y ∈ (Subscheme.totalTransform g C).pts := by
        rw [pts_totalTransform]
        exact hyC
      obtain ⟨a, haz, hCa⟩ := hcomp _ hC' hyC'
      refine ⟨e.symm a, Finset.mem_map_of_mem _ haz, ?_⟩
      rw [stalkIdeal_totalTransform] at hCa
      rw [← hback (C.stalkIdeal (g y)), hCa, Ideal.map_span, Set.image_singleton]
    · rw [stalkIdeal_totalTransform] at hDt
      rw [← hback (D.stalkIdeal (g y)), hDt, Ideal.map_span, hmapset]
  · rintro ⟨z, hz, hcomp, t, htz, hDt⟩
    refine ⟨z.map e.toEquiv.toEmbedding, ⟨?_, ?_⟩, fun C' hC' hyC' => ?_,
      t.map e.toEquiv.toEmbedding, Finset.map_subset_map.mpr htz, ?_⟩
    · rw [hmapset, ← Ideal.map_span, hz.1]
      exact IsLocalRing.map_ringEquiv_maximalIdeal e
    · rw [Finset.card_map, hz.2]
      exact ringKrullDim_eq_of_ringEquiv e
    · obtain ⟨C, hC, hjC, rfl⟩ := irreducibleComponents_totalTransform g E hC' hyC'
      obtain ⟨a, haz, hCa⟩ := hcomp C hC hjC
      refine ⟨e a, Finset.mem_map_of_mem _ haz, ?_⟩
      rw [stalkIdeal_totalTransform, hCa, Ideal.map_span, Set.image_singleton]
    · rw [stalkIdeal_totalTransform, hDt, Ideal.map_span, hmapset]

theorem isSimpleAt_totalTransform_iff (W : Subscheme Y) (y : Y') :
    (Subscheme.totalTransform g W).IsSimpleAt y ↔ W.IsSimpleAt (g y) := by
  obtain ⟨e⟩ := quotEquiv g W y
  constructor
  · rintro ⟨hy, hreg⟩
    refine ⟨by rw [pts_totalTransform] at hy; exact hy, ?_⟩
    exact IsRegularLocalRing.of_ringEquiv e.symm
  · rintro ⟨hy, hreg⟩
    refine ⟨by rw [pts_totalTransform]; exact hy, ?_⟩
    exact IsRegularLocalRing.of_ringEquiv e

theorem isNormallyFlatAlongAt'_totalTransform_iff (V W : Subscheme Y)
    (hWV : W.IsContainedIn V) (y : Y') :
    Subscheme.IsNormallyFlatAlongAt' (Subscheme.totalTransform g V)
        (Subscheme.totalTransform g W) y ↔
      Subscheme.IsNormallyFlatAlongAt' V W (g y) := by
  have hWV' : (Subscheme.totalTransform g W).IsContainedIn (Subscheme.totalTransform g V) :=
    fun U => totalTransform_mono g (fun U => hWV U) U
  rw [Subscheme.isNormallyFlatAlongAt'_iff _ _ hWV,
    Subscheme.isNormallyFlatAlongAt'_iff _ _ hWV', pts_totalTransform]
  let ē := Ideal.quotientEquiv (V.stalkIdeal (g y))
    ((Subscheme.totalTransform g V).stalkIdeal y) (stalkEquiv g y)
    (stalkIdeal_totalTransform g V y)
  have hmap : ((W.stalkIdeal (g y)).map (Ideal.Quotient.mk (V.stalkIdeal (g y)))).map
      (ē : _ →+* _) = ((Subscheme.totalTransform g W).stalkIdeal y).map
        (Ideal.Quotient.mk ((Subscheme.totalTransform g V).stalkIdeal y)) := by
    rw [Ideal.map_map, stalkIdeal_totalTransform g W y, ← Ideal.map_coe (stalkEquiv g y),
      Ideal.map_map]
    rfl
  constructor
  · rintro ⟨hy, hnf⟩
    refine ⟨hy, Hironaka.isNormallyFlatAlongIdeal_of_ringEquiv ē.symm _ _ ?_ hnf⟩
    rw [← hmap, Ideal.map_map]
    convert Ideal.map_id _
    ext a
    simp
  · rintro ⟨hy, hnf⟩
    exact ⟨hy, Hironaka.isNormallyFlatAlongIdeal_of_ringEquiv ē _ _ hmap hnf⟩

theorem isNonsingularIrreducibleCodimOne_totalTransform (F : Subscheme Y)
    (hF : F.IsNonsingularIrreducibleCodimOne) :
    (Subscheme.totalTransform g F).IsNonsingularIrreducibleCodimOne := by
  rcases hF with h | ⟨hns, hirr, hcodim⟩
  · left
    rw [h]
    exact Scheme.IdealSheafData.comap_top _
  · rcases empty_or_isIrreducible_totalTransform g F hirr with h | h
    · exact Or.inl h
    · right
      have hns' := isNonsingular_totalTransform g F hns
      refine ⟨hns', h, ?_⟩
      obtain ⟨y, hy⟩ : (Subscheme.totalTransform g F).pts.Nonempty :=
        (Subscheme.isIrreducible_pts _ h).nonempty
      have hjy : g y ∈ F.pts := by
        rw [pts_totalTransform] at hy
        exact hy
      rw [Subscheme.codim_eq_height _ hns' h hy, stalkIdeal_totalTransform, RingEquiv.height_map,
        ← Subscheme.codim_eq_height F hns hirr hjy, hcodim]

/-- Density along a flat preimmersion: a point of `Y'` whose image lies in the closure of a
locally closed set `O ∩ C` of the algebraic scheme `Y` lies in the closure of the preimage. -/
theorem mem_closure_preimage [IsAlgebraicScheme Y] {O C : Set Y} (hO : IsOpen O)
    (hC : IsClosed C) {y : Y'} (hy : g y ∈ closure (O ∩ C)) :
    y ∈ closure (g.base ⁻¹' (O ∩ C)) := by
  classical
  have hemb := g.isEmbedding
  rw [hemb.isInducing.closure_eq_preimage_closure_image, Set.image_preimage_eq_inter_range]
  show g y ∈ closure (O ∩ C ∩ Set.range g.base)
  have := IsAlgebraicScheme.noetherianSpace Y
  obtain ⟨S, hSirr, hSeq⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible
    (⟨closure (O ∩ C), isClosed_closure⟩ : Closeds Y)
  have hcl : closure (O ∩ C) = ⋃ K ∈ S, (K : Set Y) := by
    have := congrArg (fun T : Closeds Y => (T : Set Y)) hSeq
    simpa [TopologicalSpace.Closeds.coe_finset_sup] using this
  set S' := S.filter fun K : Closeds Y => ((K : Set Y) ∩ O).Nonempty
  have hsub : closure (O ∩ C) ⊆ ⋃ K ∈ S', (K : Set Y) := by
    refine closure_minimal (fun a ha => ?_) ?_
    · have : a ∈ ⋃ K ∈ S, (K : Set Y) := hcl ▸ subset_closure ha
      obtain ⟨K, hK, haK⟩ := Set.mem_iUnion₂.mp this
      exact Set.mem_iUnion₂.mpr ⟨K, Finset.mem_filter.mpr ⟨hK, a, haK, ha.1⟩, haK⟩
    · exact S'.finite_toSet.isClosed_biUnion fun K _ => K.isClosed
  obtain ⟨K, hK, hyK⟩ := Set.mem_iUnion₂.mp (hsub hy)
  obtain ⟨hKS, hKO⟩ := Finset.mem_filter.mp hK
  obtain ⟨κ, hκ⟩ : ∃ κ, IsGenericPoint κ (K : Set Y) :=
    QuasiSober.sober (hSirr ⟨K, hKS⟩) K.isClosed
  have hκO : κ ∈ O := (hκ.mem_open_set_iff hO).mpr hKO
  have hκC : κ ∈ C := by
    have hKcl : (K : Set Y) ⊆ closure (O ∩ C) := by
      rw [hcl]
      exact Set.subset_biUnion_of_mem (u := fun K : Closeds Y => (K : Set Y)) hKS
    exact closure_minimal Set.inter_subset_right hC (hKcl hκ.mem)
  have hκy : κ ⤳ g y := hκ.specializes hyK
  have hκr := mem_range_of_specializes g hκy ⟨y, rfl⟩
  exact closure_mono (Set.singleton_subset_iff.mpr
    (show κ ∈ O ∩ C ∩ Set.range g.base from ⟨⟨hκO, hκC⟩, hκr⟩))
    (specializes_iff_mem_closure.mp hκy)

end FlatPreimm

/-! ## Lifting flat preimmersions through monoidal transformations -/

/-- A ring isomorphism carries colon ideals to colon ideals. -/
theorem Ideal.map_colon_ringEquiv {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S)
    (I J : Ideal R) :
    (I.colon (J : Set R)).map e = (I.map e).colon ((J.map e : Ideal S) : Set S) := by
  ext s
  rw [← Ideal.map_coe e, Ideal.map_comap_of_equiv, Ideal.mem_comap, Submodule.mem_colon,
    Submodule.mem_colon]
  constructor
  · intro h t ht
    rw [← Ideal.map_coe e, Ideal.map_comap_of_equiv, SetLike.mem_coe, Ideal.mem_comap] at ht
    rw [← Ideal.map_coe e, Ideal.map_comap_of_equiv, Ideal.mem_comap, smul_eq_mul, map_mul]
    exact h _ ht
  · intro h t ht
    have := h (e t) (by
      rw [← Ideal.map_coe e, Ideal.map_comap_of_equiv, SetLike.mem_coe, Ideal.mem_comap]
      simpa using ht)
    rw [← Ideal.map_coe e, Ideal.map_comap_of_equiv, Ideal.mem_comap, smul_eq_mul, map_mul]
      at this
    simpa using this

namespace MonoidalTransformation

variable {Y Z : Scheme.{u}} {B : Subscheme Y}

/-- The exceptional subschemes of the two sides of a commutative square of monoidal
transformations correspond. -/
theorem totalTransform_exceptional_of_square (t : MonoidalTransformation Y B) {Bs : Subscheme Z}
    (ts : MonoidalTransformation Z Bs) (j : Z ⟶ Y) (j' : ts.X' ⟶ t.X')
    (hsq : j' ≫ t.f = ts.f ≫ j) (hB : Subscheme.totalTransform j B = Bs) :
    Subscheme.totalTransform j' t.exceptional = ts.exceptional := by
  unfold exceptional
  rw [← Subscheme.totalTransform_comp, hsq, Subscheme.totalTransform_comp, hB]

/-- Strict transforms commute with flat preimmersions: in a commutative square
`j' ≫ t.f = ts.f ≫ j` of monoidal transformations `t` (center `B`), `ts` (center `j⁻¹(B)`),
with `j'` a flat preimmersion, the pull-back of the strict transform is the strict transform of the
pull-back.  (Stalkwise, by the saturation formula `lem:strict-transform-saturation`, since the
stalk maps of `j'` are isomorphisms.) -/
theorem strictTransform_of_square (t : MonoidalTransformation Y B) {Bs : Subscheme Z}
    (ts : MonoidalTransformation Z Bs) (j : Z ⟶ Y) (j' : ts.X' ⟶ t.X') [Flat j']
    [IsPreimmersion j'] (hsq : j' ≫ t.f = ts.f ≫ j) (hB : Subscheme.totalTransform j B = Bs)
    (V : Subscheme Y) :
    Subscheme.totalTransform j' (Subscheme.strictTransform t V) =
      Subscheme.strictTransform ts (Subscheme.totalTransform j V) := by
  have hexc := totalTransform_exceptional_of_square t ts j j' hsq hB
  have htot : Subscheme.totalTransform j' (Subscheme.totalTransform t.f V) =
      Subscheme.totalTransform ts.f (Subscheme.totalTransform j V) := by
    rw [← Subscheme.totalTransform_comp, hsq, Subscheme.totalTransform_comp]
  refine Subscheme.ext_stalkIdeal fun z => ?_
  rw [FlatPreimm.stalkIdeal_totalTransform, Subscheme.strictTransform_stalkIdeal,
    Subscheme.strictTransform_stalkIdeal, Ideal.map_iSup]
  refine iSup_congr fun n => ?_
  rw [Ideal.map_colon_ringEquiv, Ideal.map_pow, ← FlatPreimm.stalkIdeal_totalTransform,
    ← FlatPreimm.stalkIdeal_totalTransform, hexc, htot]

/-- Lifting a flat preimmersion through a monoidal transformation: if `j : Z → Y` is a flat
preimmersion and `ts` is a monoidal transformation of `Z` with center `j⁻¹(B)`, then `j` lifts
to a flat preimmersion `j' : Z' → Y'` over `j`, whose range is the preimage of that of `j`,
and which pulls back exceptional subschemes and strict transforms to exceptional subschemes
and strict transforms.  (`ts` is isomorphic over `Z` to the base change `Y' ×_Y Z → Z`,
`compat:blowup-flat-base-change`, by `lem:monoidal-transformation-unique`.) -/
theorem exists_lift (t : MonoidalTransformation Y B) (j : Z ⟶ Y) [Flat j] [IsPreimmersion j]
    {Bs : Subscheme Z} (hB : Subscheme.totalTransform j B = Bs)
    (ts : MonoidalTransformation Z Bs) :
    ∃ j' : ts.X' ⟶ t.X', Flat j' ∧ IsPreimmersion j' ∧ j' ≫ t.f = ts.f ≫ j ∧
      Set.range j'.base = t.f.base ⁻¹' Set.range j.base ∧
      Subscheme.totalTransform j' t.exceptional = ts.exceptional ∧
      ∀ V, Subscheme.totalTransform j' (Subscheme.strictTransform t V) =
        Subscheme.strictTransform ts (Subscheme.totalTransform j V) := by
  subst hB
  obtain ⟨e, he, -⟩ := unique_up_to_iso ts (t.baseChange j)
  let e' : ts.X' ≅ pullback t.f j := e
  have he' : e'.hom ≫ pullback.snd t.f j = ts.f := he
  let j' : ts.X' ⟶ t.X' := e'.hom ≫ pullback.fst t.f j
  have hsq : j' ≫ t.f = ts.f ≫ j := by
    change (e'.hom ≫ pullback.fst t.f j) ≫ t.f = ts.f ≫ j
    rw [Category.assoc, pullback.condition, ← Category.assoc, he']
  have hflat : Flat j' := inferInstanceAs (Flat (e'.hom ≫ pullback.fst t.f j))
  have hpre : IsPreimmersion j' := inferInstanceAs (IsPreimmersion (e'.hom ≫ pullback.fst t.f j))
  refine ⟨j', hflat, hpre, hsq, ?_, totalTransform_exceptional_of_square t ts j j' hsq rfl,
    fun V => strictTransform_of_square t ts j j' hsq rfl V⟩
  have hsurj : Function.Surjective e'.hom.base := (Scheme.homeoOfIso e').surjective
  change Set.range (e'.hom ≫ pullback.fst t.f j).base = _
  rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, hsurj.range_eq, Set.image_univ]
  exact Scheme.Pullback.range_fst t.f j

/-- The identity of `Z`, viewed as the monoidal transformation with empty center. -/
noncomputable def idEmpty (Z : Scheme.{u}) : MonoidalTransformation Z Subscheme.empty where
  X' := Z
  f := 𝟙 Z
  invertible := by
    rw [Subscheme.totalTransform_id]
    exact Subscheme.isInvertibleIdeal_empty
  universal := fun _ f' _ => ⟨f', Category.comp_id _, fun h hh => by
    rw [← hh, Category.comp_id]⟩

@[simp] theorem idEmpty_X' (Z : Scheme.{u}) : (idEmpty Z).X' = Z := rfl

@[simp] theorem idEmpty_f (Z : Scheme.{u}) : (idEmpty Z).f = 𝟙 Z := rfl

theorem strictTransform_idEmpty (V : Subscheme Z) :
    Subscheme.strictTransform (idEmpty Z) V = V := by
  refine Subscheme.ext_stalkIdeal fun z => ?_
  rw [Subscheme.strictTransform_stalkIdeal]
  have h1 : Subscheme.totalTransform (idEmpty Z).f V = V := Subscheme.totalTransform_id V
  have hexc : (idEmpty Z).exceptional = ⊤ := Subscheme.totalTransform_id _
  rw [hexc, h1, Subscheme.stalkIdeal_top_eq]
  simp only [Ideal.top_pow, Submodule.top_coe, Submodule.colon_univ, iSup_const]

theorem exceptional_idEmpty : (idEmpty Z).exceptional = Subscheme.empty :=
  Subscheme.totalTransform_id _

/-- A subscheme without points is the empty subscheme. -/
theorem _root_.Hironaka.Subscheme.eq_empty_of_pts_eq_empty {D : Subscheme Z} (h : D.pts = ∅) :
    D = Subscheme.empty := by
  refine (Scheme.IdealSheafData.support_eq_bot_iff (I := D)).mp ?_
  ext1
  exact h

/-- Lifting a flat preimmersion whose range misses the center: then `j` factors through the
monoidal transformation by a flat preimmersion `j'` with range `f⁻¹(range j)`, which pulls
strict transforms back to plain pull-backs (the monoidal transformation is an isomorphism
over the complement of its center). -/
theorem exists_lift_of_disjoint (t : MonoidalTransformation Y B) (j : Z ⟶ Y) [Flat j]
    [IsPreimmersion j] (hdisj : ∀ z, j z ∉ B.pts) :
    ∃ j' : Z ⟶ t.X', Flat j' ∧ IsPreimmersion j' ∧ j' ≫ t.f = j ∧
      Set.range j'.base = t.f.base ⁻¹' Set.range j.base ∧
      Subscheme.totalTransform j' t.exceptional = Subscheme.empty ∧
      ∀ V, Subscheme.totalTransform j' (Subscheme.strictTransform t V) =
        Subscheme.totalTransform j V := by
  have hB : Subscheme.totalTransform j B = Subscheme.empty := by
    refine Subscheme.eq_empty_of_pts_eq_empty ?_
    rw [FlatPreimm.pts_totalTransform]
    ext z
    simpa using hdisj z
  obtain ⟨j', h1, h2, h3, h4, h5, h6⟩ := exists_lift t j hB (idEmpty Z)
  exact ⟨j', h1, h2, h3.trans (Category.id_comp j), h4, h5.trans exceptional_idEmpty,
    fun V => (h6 V).trans (strictTransform_idEmpty _)⟩

end MonoidalTransformation

/-! ### Closure-lifting of subschemes along a flat preimmersion -/

namespace FlatPreimm

variable {Y Y' : Scheme.{u}} (g : Y' ⟶ Y) [Flat g] [IsPreimmersion g]

omit [Flat g] in
theorem preimage_closure_image {T : Set Y'} (hT : IsClosed T) :
    g.base ⁻¹' closure (g.base '' T) = T := by
  rw [← g.isEmbedding.isInducing.closure_eq_preimage_closure_image, hT.closure_eq]

/-- "Let B'' be the smallest irreducible subscheme of `X_{(b)}` such that `R_b = (B'')_S`"
(p. 280): the reduced structure on the closure of the image of `B̄`.  Formalization note
(encoding): the minimality is not stated as a lemma; `totalTransform_closureLift` and
`closureLift_isIrreducible` give `(B'')_S = B̄` and irreducibility. -/
noncomputable def closureLift (D : Subscheme Y') : Subscheme Y :=
  Subscheme.ofClosed ⟨closure (g.base '' D.pts), isClosed_closure⟩

omit [Flat g] [IsPreimmersion g] in
theorem pts_closureLift (D : Subscheme Y') :
    (closureLift g D).pts = closure (g.base '' D.pts) :=
  Subscheme.pts_ofClosed _

omit [Flat g] [IsPreimmersion g] in
theorem closureLift_isReduced (D : Subscheme Y') : (closureLift g D).IsReduced :=
  Subscheme.ofClosed_isReduced _

theorem totalTransform_closureLift (D : Subscheme Y') (hD : D.IsReduced) :
    Subscheme.totalTransform g (closureLift g D) = D := by
  have hred := isReduced_totalTransform g _ (closureLift_isReduced g D)
  conv_rhs => rw [Subscheme.eq_ofClosed_support D hD]
  rw [Subscheme.eq_ofClosed_support _ hred]
  congr 1
  ext1
  change (Subscheme.totalTransform g (closureLift g D)).pts = D.pts
  rw [pts_totalTransform, pts_closureLift]
  exact preimage_closure_image g D.support.isClosed

omit [Flat g] [IsPreimmersion g] in
theorem closureLift_isIrreducible (D : Subscheme Y') (hD : D.IsIrreducible) :
    (closureLift g D).IsIrreducible := by
  refine Subscheme.isIrreducible_of_pts _ ?_
  rw [pts_closureLift]
  exact ((Subscheme.isIrreducible_pts D hD).image g.base g.base.hom.continuous.continuousOn).closure

omit [Flat g] in
theorem pts_closureLift_inter_range (D : Subscheme Y') :
    (closureLift g D).pts ∩ Set.range g.base = g.base '' D.pts := by
  ext y
  constructor
  · rintro ⟨hy, z, rfl⟩
    refine ⟨z, ?_, rfl⟩
    have : z ∈ g.base ⁻¹' closure (g.base '' D.pts) := by
      rw [pts_closureLift] at hy
      exact hy
    have hcl : IsClosed D.pts := D.support.isClosed
    rwa [preimage_closure_image g hcl] at this
  · rintro ⟨z, hz, rfl⟩
    exact ⟨by rw [pts_closureLift]; exact subset_closure ⟨z, hz, rfl⟩, z, rfl⟩

/-- Pull-back along a flat preimmersion commutes with unions of subschemes. -/
theorem totalTransform_inf (A B : Subscheme Y) :
    Subscheme.totalTransform g (A ⊓ B) =
      Subscheme.totalTransform g A ⊓ Subscheme.totalTransform g B := by
  refine Subscheme.ext_stalkIdeal fun y => ?_
  rw [Subscheme.stalkIdeal_inf_eq, stalkIdeal_totalTransform, stalkIdeal_totalTransform,
    stalkIdeal_totalTransform, Subscheme.stalkIdeal_inf_eq, ← Ideal.map_coe (stalkEquiv g y),
    ← Ideal.map_coe (stalkEquiv g y), ← Ideal.map_coe (stalkEquiv g y),
    Ideal.map_comap_of_equiv, Ideal.map_comap_of_equiv, Ideal.map_comap_of_equiv,
    Ideal.comap_inf]

theorem totalTransform_union (A B : Subscheme Y) :
    Subscheme.totalTransform g (A.union B) =
      (Subscheme.totalTransform g A).union (Subscheme.totalTransform g B) :=
  totalTransform_inf g A B

end FlatPreimm

/-! ### Monoidal transformations with nowhere dense centers -/

/-- An invertible sheaf of ideals on an algebraic scheme defines a nowhere dense subscheme:
at the generic point `q` of an irreducible component the maximal ideal of `O_q` is a minimal
prime, hence consists of zero-divisors, and cannot contain the non-zero-divisor generating the
ideal. -/
theorem Subscheme.IsInvertibleIdeal.interior_pts_eq_empty {X : Scheme.{u}}
    [IsAlgebraicScheme X] {P : Subscheme X} (hP : P.IsInvertibleIdeal) :
    interior P.pts = ∅ := by
  by_contra hne
  obtain ⟨p, hp⟩ := Set.nonempty_iff_ne_empty.mpr hne
  have := IsAlgebraicScheme.noetherianSpace X
  obtain ⟨C, hC, hpC⟩ :=
    exists_mem_irreducibleComponents_subset_of_isIrreducible {p} isIrreducible_singleton
  have hCirr : _root_.IsIrreducible C := hC.1
  have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
  set q := hCirr.genericPoint
  have hqC : closure {q} = C := by
    rw [hCirr.isGenericPoint_genericPoint_closure.def, hCcl.closure_eq]
  have hqp : q ⤳ p := specializes_iff_mem_closure.mpr (by rw [hqC]; exact hpC rfl)
  have hqint : q ∈ interior P.pts := hqp.mem_open isOpen_interior hp
  have hqP : q ∈ P.pts := interior_subset hqint
  obtain ⟨g, hg, hgnzd⟩ := hP.exists_stalkIdeal_eq_span q
  have hgm : g ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk q) :=
    Subscheme.stalkIdeal_le_maximalIdeal P hqP (hg ▸ Ideal.subset_span rfl)
  have hmin : IsLocalRing.maximalIdeal (X.presheaf.stalk q) ∈
      minimalPrimes (X.presheaf.stalk q) := by
    refine ⟨⟨inferInstance, bot_le⟩, fun Q hQ hQm => ?_⟩
    have hQp : Q.IsPrime := hQ.1
    let z := X.fromSpecStalk q ⟨Q, hQp⟩
    have hzq : z ⤳ q := by
      have : z ∈ Set.range (X.fromSpecStalk q) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    have hCz : C ⊆ closure {z} := by
      rw [← hqC]
      exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hzq))
        isClosed_closure
    have hzC : closure {z} = C :=
      (hC.2 isIrreducible_singleton.closure hCz).antisymm hCz
    have hqz : q ⤳ z :=
      specializes_iff_mem_closure.mpr (by rw [hqC, ← hzC]; exact subset_closure rfl)
    have hzq' : z = q := (hzq.antisymm hqz).eq
    have hinj := (X.fromSpecStalk q).isEmbedding.injective
    have : (⟨Q, hQp⟩ : PrimeSpectrum (X.presheaf.stalk q)) =
        IsLocalRing.closedPoint (X.presheaf.stalk q) := by
      apply hinj
      change z = _
      rw [hzq', Scheme.fromSpecStalk_closedPoint]
    have hQeq : Q = IsLocalRing.maximalIdeal (X.presheaf.stalk q) :=
      congrArg PrimeSpectrum.asIdeal this
    exact hQeq.ge
  exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hmin) hgm hgnzd

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X}

theorem isIso_of_eq_empty (t : MonoidalTransformation X B) (h : B = Subscheme.empty) :
    IsIso t.f := by
  subst h
  exact isIso_of_empty t

theorem pts_exceptional (t : MonoidalTransformation X B) :
    t.exceptional.pts = t.f.base ⁻¹' B.pts :=
  FlatPreimm.pts_totalTransform t.f B

/-- The exceptional subscheme is nowhere dense. -/
theorem interior_pts_exceptional (t : MonoidalTransformation X B) [IsAlgebraicScheme t.X'] :
    interior t.exceptional.pts = ∅ :=
  Subscheme.IsInvertibleIdeal.interior_pts_eq_empty t.invertible

/-- The monoidal transformation of an irreducible scheme with a center which is not the whole
scheme is irreducible: it is an isomorphism over the complement `U` of the center (the base
change to `U` has empty center), and the complement `f⁻¹(U)` of the exceptional subscheme is
dense. -/
theorem irreducibleSpace (t : MonoidalTransformation X B) [IrreducibleSpace X]
    [IsAlgebraicScheme t.X'] (hB : B.pts ≠ Set.univ) : IrreducibleSpace t.X' := by
  let U : X.Opens := ⟨B.ptsᶜ, B.support.isClosed.isOpen_compl⟩
  have hBU : Subscheme.totalTransform U.ι B = Subscheme.empty := by
    refine Subscheme.eq_empty_of_pts_eq_empty ?_
    rw [FlatPreimm.pts_totalTransform]
    ext z
    simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
    exact (U.ι_apply z ▸ z.2 : _)
  have hiso : IsIso (pullback.snd t.f U.ι) := isIso_of_eq_empty (t.baseChange U.ι) hBU
  have hUne : (U : Set X).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro h
    apply hB
    have : B.ptsᶜ = ∅ := h
    rwa [Set.compl_empty_iff] at this
  have hUirr : IsIrreducible (U : Set X) :=
    ⟨hUne, (irreducibleSpace_def X).mp inferInstance |>.2.open_subset U.isOpen
      (Set.subset_univ _)⟩
  have : IrreducibleSpace (U : Scheme) := Subtype.irreducibleSpace hUirr
  let k : (U : Scheme) ⟶ t.X' := inv (pullback.snd t.f U.ι) ≫ pullback.fst t.f U.ι
  have hsurj : Function.Surjective (inv (pullback.snd t.f U.ι)).base :=
    (Scheme.homeoOfIso (asIso (inv (pullback.snd t.f U.ι)))).surjective
  have hk : Set.range k.base = t.f.base ⁻¹' (U : Set X) := by
    change Set.range (inv (pullback.snd t.f U.ι) ≫ pullback.fst t.f U.ι).base = _
    rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, hsurj.range_eq, Set.image_univ,
      Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
  have hirr : _root_.IsIrreducible (t.f.base ⁻¹' (U : Set X)) := by
    rw [← hk, ← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ _).image _
      k.base.hom.continuous.continuousOn
  have hdense : closure (t.f.base ⁻¹' (U : Set X)) = Set.univ := by
    have : t.f.base ⁻¹' (U : Set X) = t.exceptional.ptsᶜ := by
      rw [pts_exceptional]
      rfl
    rw [this, closure_compl, interior_pts_exceptional, Set.compl_empty]
  refine (irreducibleSpace_def _).mpr ?_
  rw [Set.top_eq_univ, ← hdense]
  exact hirr.closure

end MonoidalTransformation

/-! ### Strict transforms -/

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X}

theorem totalTransform_le_strictTransform (t : MonoidalTransformation X B) (V : Subscheme X) :
    Subscheme.totalTransform t.f V ≤ Subscheme.strictTransform t V := by
  refine Subscheme.le_iff_stalkIdeal_le.mpr fun x => ?_
  rw [Subscheme.strictTransform_stalkIdeal]
  refine le_trans ?_ (le_iSup _ 0)
  simp only [pow_zero, Ideal.one_eq_top, Submodule.top_coe, Submodule.colon_univ, le_refl]

/-- The strict transform lies over the subscheme: `V'` is contained in `f⁻¹(V)`. -/
theorem pts_strictTransform_subset (t : MonoidalTransformation X B) (V : Subscheme X) :
    (Subscheme.strictTransform t V).pts ⊆ t.f.base ⁻¹' V.pts := by
  rw [← FlatPreimm.pts_totalTransform]
  exact Scheme.IdealSheafData.support_antitone (totalTransform_le_strictTransform t V)

/-- The strict transform is monotone in the sheaf of ideals. -/
theorem strictTransform_mono (t : MonoidalTransformation X B) {V V' : Subscheme X}
    (h : V ≤ V') : Subscheme.strictTransform t V ≤ Subscheme.strictTransform t V' := by
  refine Subscheme.le_iff_stalkIdeal_le.mpr fun x => ?_
  rw [Subscheme.strictTransform_stalkIdeal, Subscheme.strictTransform_stalkIdeal]
  refine iSup_mono fun n => Submodule.colon_mono ?_ subset_rfl
  exact Subscheme.stalkIdeal_mono (FlatPreimm.totalTransform_mono t.f h) x

theorem isContainedIn_strictTransform (t : MonoidalTransformation X B) {V W : Subscheme X}
    (h : W.IsContainedIn V) :
    (Subscheme.strictTransform t W).IsContainedIn (Subscheme.strictTransform t V) :=
  fun U => (strictTransform_mono t (show V ≤ W from fun U => h U)) U

/-- Off the exceptional subscheme the strict transform is the total transform. -/
theorem strictTransform_stalkIdeal_of_notMem (t : MonoidalTransformation X B)
    (V : Subscheme X) {x : t.X'} (hx : x ∉ t.exceptional.pts) :
    (Subscheme.strictTransform t V).stalkIdeal x =
      (Subscheme.totalTransform t.f V).stalkIdeal x := by
  rw [Subscheme.strictTransform_stalkIdeal, Subscheme.stalkIdeal_eq_top_of_notMem_pts hx]
  simp only [Ideal.top_pow, Submodule.top_coe, Submodule.colon_univ, iSup_const]

theorem mem_pts_strictTransform_iff_of_notMem (t : MonoidalTransformation X B)
    (V : Subscheme X) {x : t.X'} (hx : x ∉ t.exceptional.pts) :
    x ∈ (Subscheme.strictTransform t V).pts ↔ t.f x ∈ V.pts := by
  rw [Subscheme.mem_pts_iff_stalkIdeal_ne_top, strictTransform_stalkIdeal_of_notMem t V hx,
    ← Subscheme.mem_pts_iff_stalkIdeal_ne_top, FlatPreimm.pts_totalTransform]
  rfl

theorem _root_.Hironaka.Ideal.mem_iSup_colon_pow_span {R : Type*} [CommRing R] (J : Ideal R)
    (g r : R) :
    r ∈ ⨆ n : ℕ, J.colon ((Ideal.span {g} ^ n : Ideal R) : Set R) ↔
      ∃ n, r * g ^ n ∈ J := by
  have hmono : Monotone fun n : ℕ => J.colon ((Ideal.span {g} ^ n : Ideal R) : Set R) := by
    refine monotone_nat_of_le_succ fun n x hx => ?_
    simp only [Ideal.span_singleton_pow, Ideal.mem_colon_span_singleton] at hx ⊢
    rw [pow_succ, ← mul_assoc]
    exact J.mul_mem_right g hx
  rw [Submodule.mem_iSup_of_directed _ hmono.directed_le]
  simp only [Ideal.span_singleton_pow, Ideal.mem_colon_span_singleton]

/-- The strict transform has no irreducible component inside the exceptional subscheme: a
point `y` of `V'` without proper generizations in `V'` does not lie over the center.  (At such a
point the maximal ideal of `O_{X',y}/V'_y` is its nilradical, so a power of the local equation
`g` of `f⁻¹(B)` lies in `V'_y`; as `V'_y` is `g`-saturated, `V'_y` is the unit ideal.) -/
theorem notMem_exceptional_of_generic (t : MonoidalTransformation X B) (V : Subscheme X)
    {D : Subscheme t.X'} (hD : D = Subscheme.strictTransform t V) (y : D.toScheme)
    (hy : ∀ w, w ⤳ y → w = y) : D.ι y ∉ t.exceptional.pts := by
  intro hqE
  generalize hq : D.ι y = q at hqE
  obtain ⟨g, hg, hgnzd⟩ := t.invertible.exists_stalkIdeal_eq_span q
  have hg' : t.exceptional.stalkIdeal q = Ideal.span {g} := hg
  have hgm : g ∈ IsLocalRing.maximalIdeal (t.X'.presheaf.stalk q) := by
    refine Subscheme.stalkIdeal_le_maximalIdeal t.exceptional hqE ?_
    rw [hg']
    exact Ideal.mem_span_singleton_self g
  have hqD : q ∈ D.pts := hq ▸ Subscheme.mem_pts_ι D y
  have hIm : D.stalkIdeal q ≤ IsLocalRing.maximalIdeal _ :=
    Subscheme.stalkIdeal_le_maximalIdeal D hqD
  -- every prime of `O_{D,y}` is maximal
  obtain ⟨e⟩ := hq ▸ nonempty_stalk_quot_equiv D y
  have huniq : ∀ P : Ideal (D.toScheme.presheaf.stalk y), P.IsPrime →
      P = IsLocalRing.maximalIdeal _ := by
    intro P hP
    have hw : D.toScheme.fromSpecStalk y ⟨P, hP⟩ ⤳ y := by
      have : D.toScheme.fromSpecStalk y ⟨P, hP⟩ ∈ Set.range (D.toScheme.fromSpecStalk y) :=
        ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    have h1 := hy _ hw
    have : (⟨P, hP⟩ : PrimeSpectrum _) = IsLocalRing.closedPoint _ := by
      apply (D.toScheme.fromSpecStalk y).isEmbedding.injective
      rw [h1, Scheme.fromSpecStalk_closedPoint]
    exact congrArg PrimeSpectrum.asIdeal this
  -- the image of `g` in `O_{D,y}` is not a unit, hence nilpotent
  have hnu : ¬ IsUnit (e (Ideal.Quotient.mk _ g)) := by
    rintro ⟨u, hu⟩
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (e.symm ↑u⁻¹)
    have h1 : e (Ideal.Quotient.mk _ (g * r)) = 1 := by
      rw [map_mul, map_mul, hr, e.apply_symm_apply, ← hu, Units.mul_inv]
    have h2 : Ideal.Quotient.mk (D.stalkIdeal q) (g * r - 1) = 0 := by
      apply e.injective
      rw [map_sub, map_sub, h1, map_one, map_one, map_zero, sub_self]
    have h3 : g * r - 1 ∈ IsLocalRing.maximalIdeal _ :=
      hIm (Ideal.Quotient.eq_zero_iff_mem.mp h2)
    have h4 : g * r ∈ IsLocalRing.maximalIdeal _ := Ideal.mul_mem_right r _ hgm
    have h5 := Ideal.sub_mem _ h4 h3
    rw [sub_sub_cancel] at h5
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h5)
  have hnil : IsNilpotent (e (Ideal.Quotient.mk _ g)) := by
    rw [← mem_nilradical, nilradical_eq_sInf]
    refine Submodule.mem_sInf.mpr fun P hP => ?_
    rw [huniq P hP]
    exact (IsLocalRing.mem_maximalIdeal _).mpr hnu
  obtain ⟨n, hn⟩ := hnil
  have hgn : g ^ n ∈ D.stalkIdeal q := by
    rw [← map_pow, ← map_pow] at hn
    exact Ideal.Quotient.eq_zero_iff_mem.mp (e.injective (hn.trans (map_zero e).symm))
  -- `D_q` is `g`-saturated
  have hsat : ∀ r, g * r ∈ D.stalkIdeal q → r ∈ D.stalkIdeal q := by
    intro r hr
    rw [hD, Subscheme.strictTransform_stalkIdeal, hg', Ideal.mem_iSup_colon_pow_span] at hr ⊢
    obtain ⟨m, hm⟩ := hr
    exact ⟨m + 1, by rw [pow_succ]; convert hm using 1; ring⟩
  have h1 : ∀ k, g ^ k ∈ D.stalkIdeal q → (1 : t.X'.presheaf.stalk q) ∈ D.stalkIdeal q := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => exact fun h => ih (hsat _ (by rw [← pow_succ']; exact h))
  exact (Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hqD)
    ((Ideal.eq_top_iff_one _).mpr (h1 n hgn))

/-- Every point of the strict transform is a specialization of a point of the strict transform
lying off the exceptional subscheme. -/
theorem exists_generization_notMem_exceptional (t : MonoidalTransformation X B)
    (V : Subscheme X) {p : t.X'} (hp : p ∈ (Subscheme.strictTransform t V).pts) :
    ∃ q ∈ (Subscheme.strictTransform t V).pts, q ∉ t.exceptional.pts ∧ q ⤳ p := by
  set D := Subscheme.strictTransform t V
  obtain ⟨y₀, rfl⟩ := Subscheme.exists_ι_eq_of_mem_pts D hp
  obtain ⟨C, hC, hy₀C⟩ :=
    exists_mem_irreducibleComponents_subset_of_isIrreducible {y₀} isIrreducible_singleton
  have hCirr : _root_.IsIrreducible C := hC.1
  have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
  set y := hCirr.genericPoint
  have hyC : closure {y} = C := by
    rw [hCirr.isGenericPoint_genericPoint_closure.def, hCcl.closure_eq]
  have hyy₀ : y ⤳ y₀ := specializes_iff_mem_closure.mpr (by rw [hyC]; exact hy₀C rfl)
  have hgen : ∀ w, w ⤳ y → w = y := by
    intro w hw
    have hCw : C ⊆ closure {w} := by
      rw [← hyC]
      exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hw))
        isClosed_closure
    have hwC : closure {w} = C := (hC.2 isIrreducible_singleton.closure hCw).antisymm hCw
    have hyw : y ⤳ w :=
      specializes_iff_mem_closure.mpr (by rw [hyC, ← hwC]; exact subset_closure rfl)
    exact (hw.antisymm hyw).eq
  exact ⟨D.ι y, Subscheme.mem_pts_ι D y, notMem_exceptional_of_generic t V rfl y hgen,
    hyy₀.map D.ι.base.hom.continuous⟩

/-- The strict transform of an irreducible subscheme `V` not contained in the center is
irreducible: off the exceptional subscheme it is the isomorphic preimage of `V − B`, which is
irreducible, and it is the closure of that part. -/
theorem strictTransform_isIrreducible (t : MonoidalTransformation X B) (V : Subscheme X)
    (hV : V.IsIrreducible) (hVB : ¬ V.pts ⊆ B.pts) :
    (Subscheme.strictTransform t V).IsIrreducible := by
  set D := Subscheme.strictTransform t V
  let U : X.Opens := ⟨B.ptsᶜ, B.support.isClosed.isOpen_compl⟩
  have hBU : Subscheme.totalTransform U.ι B = Subscheme.empty := by
    refine Subscheme.eq_empty_of_pts_eq_empty ?_
    rw [FlatPreimm.pts_totalTransform]
    ext z
    simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
    exact (U.ι_apply z ▸ z.2 : _)
  have hiso : IsIso (pullback.snd t.f U.ι) := isIso_of_eq_empty (t.baseChange U.ι) hBU
  let k : (U : Scheme) ⟶ t.X' := inv (pullback.snd t.f U.ι) ≫ pullback.fst t.f U.ι
  have hkf : k ≫ t.f = U.ι := by
    change (inv (pullback.snd t.f U.ι) ≫ pullback.fst t.f U.ι) ≫ t.f = U.ι
    rw [Category.assoc, pullback.condition, IsIso.inv_hom_id_assoc]
  have hsurj : Function.Surjective (inv (pullback.snd t.f U.ι)).base :=
    (Scheme.homeoOfIso (asIso (inv (pullback.snd t.f U.ι)))).surjective
  have hk : Set.range k.base = t.f.base ⁻¹' (U : Set X) := by
    change Set.range (inv (pullback.snd t.f U.ι) ≫ pullback.fst t.f U.ι).base = _
    rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, hsurj.range_eq, Set.image_univ,
      Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
  have hkE : t.exceptional.ptsᶜ = Set.range k.base := by
    rw [hk, pts_exceptional]
    rfl
  -- the part of `D` off the exceptional subscheme
  have hoff : D.pts \ t.exceptional.pts = k.base '' (U.ι.base ⁻¹' V.pts) := by
    ext p
    constructor
    · rintro ⟨hpD, hpE⟩
      have hpk : p ∈ Set.range k.base := hkE ▸ hpE
      obtain ⟨u, rfl⟩ := hpk
      refine ⟨u, ?_, rfl⟩
      have := (mem_pts_strictTransform_iff_of_notMem t V hpE).mp hpD
      rw [← Scheme.Hom.comp_apply, hkf] at this
      exact this
    · rintro ⟨u, hu, rfl⟩
      have hpE : k u ∉ t.exceptional.pts := by
        rw [← Set.mem_compl_iff, hkE]
        exact ⟨u, rfl⟩
      refine ⟨(mem_pts_strictTransform_iff_of_notMem t V hpE).mpr ?_, hpE⟩
      rw [← Scheme.Hom.comp_apply, hkf]
      exact hu
  have hVirr := Subscheme.isIrreducible_pts V hV
  obtain ⟨v, hvV, hvB⟩ := Set.not_subset.mp hVB
  have hVU : _root_.IsIrreducible (U.ι.base ⁻¹' V.pts) := by
    refine ⟨⟨⟨v, hvB⟩, hvV⟩, ?_⟩
    exact hVirr.2.preimage U.ι.isOpenEmbedding
  have hoffirr : _root_.IsIrreducible (D.pts \ t.exceptional.pts) := by
    rw [hoff]
    exact hVU.image _ k.base.hom.continuous.continuousOn
  have hcl : D.pts = closure (D.pts \ t.exceptional.pts) := by
    refine subset_antisymm (fun p hp => ?_)
      (closure_minimal Set.sdiff_subset D.support.isClosed)
    obtain ⟨q, hqD, hqE, hqp⟩ := exists_generization_notMem_exceptional t V hp
    exact closure_mono (Set.singleton_subset_iff.mpr
      (show q ∈ D.pts \ t.exceptional.pts from ⟨hqD, hqE⟩))
      (specializes_iff_mem_closure.mp hqp)
  refine Subscheme.isIrreducible_of_pts D ?_
  rw [hcl]
  exact hoffirr.closure

end MonoidalTransformation

/-! ### Dimension of subsets -/

/-- If `f` embeds `α` strictly below a fixed element `c`, then `dim α + 1 ≤ dim β`. -/
theorem Order.krullDim_add_one_le_of_strictMono_lt {α β : Type*} [PartialOrder α]
    [PartialOrder β] [Nonempty α] (f : α → β) (hf : StrictMono f) (c : β)
    (hc : ∀ a, f a < c) : Order.krullDim α + 1 ≤ Order.krullDim β := by
  rw [← Order.krullDim_WithTop]
  refine Order.krullDim_le_of_strictMono (fun x => WithTop.recTopCoe c f x) ?_
  intro x y hxy
  induction x using WithTop.recTopCoe with
  | top => exact absurd hxy (not_top_lt)
  | coe a =>
    induction y using WithTop.recTopCoe with
    | top => exact hc a
    | coe b => exact hf (WithTop.coe_lt_coe.mp hxy)

/-- A closed subset `T` of a closed subset `S` all of whose points are specializations of a
point `c ∈ S − T` has strictly smaller Krull dimension. -/
theorem topologicalKrullDim_add_one_le {Z : Type*} [TopologicalSpace Z] {T S : Set Z}
    (hT : IsClosed T) (hTS : T ⊆ S) (hTne : T.Nonempty) {c : Z} (hcS : c ∈ S) (hcT : c ∉ T)
    (hc : ∀ t ∈ T, c ⤳ t) : topologicalKrullDim T + 1 ≤ topologicalKrullDim S := by
  obtain ⟨t₀, ht₀⟩ := hTne
  have : Nonempty (IrreducibleCloseds T) :=
    ⟨⟨closure {⟨t₀, ht₀⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
  have hemb := Topology.IsEmbedding.inclusion hTS
  let c' : IrreducibleCloseds S := ⟨closure {⟨c, hcS⟩}, isIrreducible_singleton.closure,
    isClosed_closure⟩
  have hTcl : IsClosed {s : S | (s : Z) ∈ T} := hT.preimage continuous_subtype_val
  refine Order.krullDim_add_one_le_of_strictMono_lt _
    (IrreducibleCloseds.map_strictMono_of_isInducing hemb.isInducing) c' fun a => ?_
  refine lt_of_le_of_ne ?_ fun h => ?_
  · show closure (Set.inclusion hTS '' (a : Set T)) ⊆ closure {⟨c, hcS⟩}
    refine closure_minimal ?_ isClosed_closure
    rintro _ ⟨x, -, rfl⟩
    rw [← specializes_iff_mem_closure]
    exact (Topology.IsInducing.subtypeVal.specializes_iff).mp (hc x x.2)
  · have hmem : (⟨c, hcS⟩ : S) ∈ (c' : Set S) := subset_closure rfl
    rw [← h] at hmem
    have hsub : closure (Set.inclusion hTS '' (a : Set T)) ⊆ {s : S | (s : Z) ∈ T} :=
      closure_minimal (by rintro _ ⟨x, -, rfl⟩; exact x.2) hTcl
    exact hcT (hsub hmem)

/-- The dimension of a subscheme is the Krull dimension of its underlying closed set. -/
theorem Subscheme.dim_eq_topologicalKrullDim {X : Scheme.{u}} (D : Subscheme X) :
    D.dim = topologicalKrullDim D.pts := by
  unfold Subscheme.dim
  rw [Scheme.dim_eq_topologicalKrullDim]
  have h := IsHomeomorph.topologicalKrullDim_eq _ (D.ι.isEmbedding.toHomeomorph).isHomeomorph
  rw [h]
  have hr : Set.range D.ι.base = D.pts := Scheme.IdealSheafData.range_subschemeι D
  rw [hr]

/-- A point in the closure of a locally closed subset `O ∩ C` of an algebraic scheme is a
specialization of a point of `O ∩ C`. -/
theorem exists_specializes_of_mem_closure {Y : Scheme.{u}} [IsAlgebraicScheme Y] {O C : Set Y}
    (hO : IsOpen O) (hC : IsClosed C) {y : Y} (hy : y ∈ closure (O ∩ C)) :
    ∃ κ ∈ O ∩ C, κ ⤳ y := by
  classical
  have := IsAlgebraicScheme.noetherianSpace Y
  obtain ⟨S, hSirr, hSeq⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible
    (⟨closure (O ∩ C), isClosed_closure⟩ : Closeds Y)
  have hcl : closure (O ∩ C) = ⋃ K ∈ S, (K : Set Y) := by
    have := congrArg (fun T : Closeds Y => (T : Set Y)) hSeq
    simpa [TopologicalSpace.Closeds.coe_finset_sup] using this
  set S' := S.filter fun K : Closeds Y => ((K : Set Y) ∩ O).Nonempty
  have hsub : closure (O ∩ C) ⊆ ⋃ K ∈ S', (K : Set Y) := by
    refine closure_minimal (fun a ha => ?_) ?_
    · have : a ∈ ⋃ K ∈ S, (K : Set Y) := hcl ▸ subset_closure ha
      obtain ⟨K, hK, haK⟩ := Set.mem_iUnion₂.mp this
      exact Set.mem_iUnion₂.mpr ⟨K, Finset.mem_filter.mpr ⟨hK, a, haK, ha.1⟩, haK⟩
    · exact S'.finite_toSet.isClosed_biUnion fun K _ => K.isClosed
  obtain ⟨K, hK, hyK⟩ := Set.mem_iUnion₂.mp (hsub hy)
  obtain ⟨hKS, hKO⟩ := Finset.mem_filter.mp hK
  obtain ⟨κ, hκ⟩ : ∃ κ, IsGenericPoint κ (K : Set Y) :=
    QuasiSober.sober (hSirr ⟨K, hKS⟩) K.isClosed
  have hκO : κ ∈ O := (hκ.mem_open_set_iff hO).mpr hKO
  have hκC : κ ∈ C := by
    have hKcl : (K : Set Y) ⊆ closure (O ∩ C) := by
      rw [hcl]
      exact Set.subset_biUnion_of_mem (u := fun K : Closeds Y => (K : Set Y)) hKS
    exact closure_minimal Set.inter_subset_right hC (hKcl hκ.mem)
  exact ⟨κ, ⟨hκO, hκC⟩, hκ.specializes hyK⟩

end Hironaka


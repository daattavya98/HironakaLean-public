/-!
# Compatibility layer: the core of the complete case of property (c) of the class 𝔅 (p. 161)

A step in the proof of property (c), the heart of footnote 31's "apply the jacobian
criterion": let `T = k⟦t⟧[x₁..x_m]` (`k` of characteristic zero), `P` a prime of `T`,
`Λ = T_P`, `Λ̂` its completion, `T₁ = k⟦t⟧[x, y₁..y_l]`, and `ρ : T₁ → Λ̂[y]` the base change of `x`
(`extensionHom`).  For an ideal `K₁` of `T₁` and a prime `𝔔` of `Λ̂[y]` with `Q₁ = ρ⁻¹(𝔔)`:
if `(T₁/K₁)_{Q₁}` is regular, so is `(Λ̂[y]/K₁Λ̂[y])_𝔔`
(`isRegularLocalRing_localization_quotient_completion_of_quotient`).

Proof: `K₁T_{1,Q₁}` is generated by part of a regular system of parameters (`f_i ∈ T₁`); by the
minor form of the jacobian criterion (`exists_minor_notMem_of_isIndepModSq`) some minor of the
partial derivatives `(∂_j f_i)` is not in `Q₁`; the partial derivations of `T₁` extend along
`T₁ → Λ̂[y]_𝔔` (`extensionDerivation_extensionHom`,
`exists_derivation_adicCompletion_localization`),
so the same minor is a unit there, whence the `f_i` are independent modulo `𝔫²`
(`isIndepModSq_of_isUnit_det`) and `Λ̂[y]_𝔔/(f)` is regular
(`isRegularLocalRing_quotient_span_of_isIndepModSq`).
-/

@[expose] public section

open IsLocalRing

noncomputable section

namespace Hironaka

universe u

section Lemmas

variable {L : Type u} [CommRing L] [IsLocalRing L]

/-- Multiplying independent elements by units keeps them independent modulo `𝔫²`. -/
theorem IsIndepModSq.mul_isUnit {ι : Type*} [Fintype ι] {f : ι → L} (hf : IsIndepModSq f)
    (v : ι → L) (hv : ∀ i, IsUnit (v i)) : IsIndepModSq (fun i => v i * f i) := by
  intro c hc i
  have := hf (fun j => c j * v j) (by simpa only [mul_assoc] using hc) i
  exact (Ideal.mul_unit_mem_iff_mem _ (hv i)).mp this

/-- Reindexing preserves independence modulo `𝔫²`. -/
theorem IsIndepModSq.comp_equiv {ι ι' : Type*} [Fintype ι] [Fintype ι'] {f : ι → L}
    (hf : IsIndepModSq f) (e : ι' ≃ ι) : IsIndepModSq (fun i => f (e i)) := by
  intro c hc i
  have := hf (fun j => c (e.symm j)) (by
    rw [← Equiv.sum_comp e]
    simpa using hc) (e i)
  simpa using this

end Lemmas

section Lift

variable {A : Type u} [CommRing A] (Q : Ideal A) [Q.IsPrime]

/-- **Lifting independent generators from a localization.**  If `f₁..f_h ∈ 𝔫` are elements of
`A_Q` independent modulo `𝔫²`, there are `a_i ∈ Q` with `algebraMap a_i = unit · f_i`: the images
`algebraMap a_i` are independent modulo `𝔫²` and generate the same ideal as the `f_i`. -/
theorem exists_lift_isIndepModSq_localization {h : ℕ} (f : Fin h → Localization.AtPrime Q)
    (hf : ∀ i, f i ∈ maximalIdeal (Localization.AtPrime Q)) (hind : IsIndepModSq f) :
    ∃ a : Fin h → A, (∀ i, a i ∈ Q) ∧
      IsIndepModSq (fun i => algebraMap A (Localization.AtPrime Q) (a i)) ∧
      Ideal.span (Set.range fun i => algebraMap A (Localization.AtPrime Q) (a i)) =
        Ideal.span (Set.range f) := by
  choose x hx using fun i => IsLocalization.surj Q.primeCompl (f i)
  let a : Fin h → A := fun i => (x i).1
  let u : Fin h → Q.primeCompl := fun i => (x i).2
  have hunit : ∀ i, IsUnit (algebraMap A (Localization.AtPrime Q) (u i : A)) :=
    fun i => IsLocalization.map_units (Localization.AtPrime Q) (u i)
  have hfa : ∀ i, algebraMap A (Localization.AtPrime Q) (a i) =
      algebraMap A (Localization.AtPrime Q) (u i : A) * f i := fun i => by
    rw [← hx i, mul_comm]
  refine ⟨a, fun i => ?_, ?_, ?_⟩
  · have h1 : algebraMap A (Localization.AtPrime Q) (a i) ∈
        maximalIdeal (Localization.AtPrime Q) := by
      rw [hfa i]
      exact Ideal.mul_mem_left _ _ (hf i)
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q _).mp h1
  · have := hind.mul_isUnit (fun i => algebraMap A (Localization.AtPrime Q) (u i : A)) hunit
    simpa only [← hfa] using this
  · apply le_antisymm
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      show algebraMap A (Localization.AtPrime Q) (a i) ∈ _
      rw [hfa i]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      show f i ∈ _
      have : f i = (hunit i).unit⁻¹ * algebraMap A (Localization.AtPrime Q) (a i) := by
        rw [hfa i, ← mul_assoc]
        simp
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

end Lift

section Core

open PowerSeriesPolynomialRing

variable {k : Type u} [Field k] {n m : ℕ} (P : Ideal (PowerSeriesPolynomialRing k n m))
  [P.IsPrime]

/-- The completion `(T_P)^` of the local ring of `T = k⟦t⟧[x]` at a prime `P`. -/
abbrev completionAtPrime : Type u :=
  AdicCompletion (maximalIdeal (Localization.AtPrime P)) (Localization.AtPrime P)

/-- The ring homomorphism `ρ : k⟦t⟧[x,y] → (T_P)^[y]` of the complete case: `τ = (T → (T_P)^)` on
`k⟦t⟧` and `x`, and `y_a ↦ y_a`. -/
abbrev completionExtensionHom (l : ℕ) :
    PowerSeriesPolynomialRing k n (m + l) →+* MvPolynomial (Fin l) (completionAtPrime P) :=
  extensionHom (l := l) (algebraMap (PowerSeriesPolynomialRing k n m) (completionAtPrime P))

/-- The ring `(T_P)^[y₁..y_l]_𝔔` is a regular local ring (`T_P` is regular, hence so is its
completion, and polynomial rings over a regular ring are regular). -/
theorem isRegularLocalRing_localization_mvPolynomial_completion [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (l : ℕ)
    [IsRegularLocalRing (Localization.AtPrime P)]
    (𝔔 : Ideal (MvPolynomial (Fin l) (completionAtPrime P))) [𝔔.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime 𝔔) := by
  have h1 : IsRegularLocalRing (completionAtPrime P) :=
    isRegularLocalRing_adicCompletion_of_isRegularLocalRing (Localization.AtPrime P)
  have h2 : IsRegularRing (completionAtPrime P) :=
    { isRegularLocalRing_localization := fun p _ =>
        isRegularLocalRing_localization_of_isRegularLocalRing _ p }
  exact inferInstance

/-- An element of `T₁` maps into the maximal ideal of `Λ̂[y]_𝔔` iff it lies in `Q₁ = ρ⁻¹ 𝔔`. -/
theorem algebraMap_completionExtensionHom_mem_maximalIdeal_iff (l : ℕ)
    (𝔔 : Ideal (MvPolynomial (Fin l) (completionAtPrime P))) [𝔔.IsPrime]
    (x : PowerSeriesPolynomialRing k n (m + l)) :
    algebraMap (MvPolynomial (Fin l) (completionAtPrime P)) (Localization.AtPrime 𝔔)
        (completionExtensionHom P l x) ∈ maximalIdeal (Localization.AtPrime 𝔔) ↔
      x ∈ 𝔔.comap (completionExtensionHom P l) := by
  rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔔) 𝔔]
  rfl

/-- **The partial derivations of `T₁` extend to `Λ̂[y]_𝔔`.** -/
theorem exists_derivations_localization_completion_extension (l : ℕ)
    (𝔔 : Ideal (MvPolynomial (Fin l) (completionAtPrime P))) [𝔔.IsPrime] :
    ∃ D : Fin (n + (m + l)) → Derivation k (Localization.AtPrime 𝔔) (Localization.AtPrime 𝔔),
      ∀ (J : Fin (n + (m + l))) (F : PowerSeriesPolynomialRing k n (m + l)),
        D J (algebraMap (MvPolynomial (Fin l) (completionAtPrime P)) (Localization.AtPrime 𝔔)
          (completionExtensionHom P l F)) =
        algebraMap (MvPolynomial (Fin l) (completionAtPrime P)) (Localization.AtPrime 𝔔)
          (completionExtensionHom P l (pderiv k n (m + l) J F)) := by
  choose d hd using fun j : Fin (n + m) =>
    exists_derivation_adicCompletion_localization P (pderiv k n m j)
  have hd' : ∀ (j : Fin (n + m)) (t : PowerSeriesPolynomialRing k n m),
      d j (algebraMap (PowerSeriesPolynomialRing k n m) (completionAtPrime P) t) =
        algebraMap (PowerSeriesPolynomialRing k n m) (completionAtPrime P)
          (pderiv k n m j t) := by
    intro j t
    rw [IsScalarTower.algebraMap_apply (PowerSeriesPolynomialRing k n m) (Localization.AtPrime P)
      (completionAtPrime P), IsScalarTower.algebraMap_apply (PowerSeriesPolynomialRing k n m)
      (Localization.AtPrime P) (completionAtPrime P)]
    exact hd j t
  choose D hD using fun J : Fin (n + (m + l)) =>
    exists_derivation_of_isLocalization (B := Localization.AtPrime 𝔔) 𝔔.primeCompl
      (extensionDerivation (l := l) d J)
  refine ⟨D, fun J F => ?_⟩
  rw [hD, extensionDerivation_extensionHom _ d hd']

/-- **The core of the complete case.**  Let `K₁` be an ideal of `T₁ = k⟦t⟧[x,y]` and `𝔔` a prime
of `Λ̂[y]` (`Λ̂ = (T_P)^`), `Q₁ = ρ⁻¹ 𝔔` its contraction along `ρ : T₁ → Λ̂[y]`.  If the local
ring `(T₁/K₁)_{Q₁} = T₁_{Q₁}/K₁T₁_{Q₁}` is regular, so is `Λ̂[y]_𝔔/K₁Λ̂[y]_𝔔`.

Deviation from the paper (gap filled): footnote 31 says only "Reduce the proof to the case in
which S is complete, and then apply the jacobian criterion".  See the module docstring. -/
@[blueprint "lem:class-A-c-core"
  (statement := /-- Let $k$ be a field of characteristic zero, $T=k[[t]][x]$, $\mathfrak P$ a prime
    of $T$, $\Lambda=T_{\mathfrak P}$ and $\hat\Lambda$ its completion, $T_1=k[[t]][x,y_1,\dots,
    y_l]$ and $\rho\colon T_1\to\hat\Lambda[y]$ the natural map. Let $K_1\subseteq T_1$ be an ideal
    and $\mathfrak Q$ a prime of $\hat\Lambda[y]$, $Q_1=\rho^{-1}\mathfrak Q$. If
    $(T_1/K_1)_{Q_1}$ is regular, then so is $\hat\Lambda[y]_{\mathfrak Q}/K_1\hat\Lambda[y]_{
    \mathfrak Q}$. -/)
  (proof := /-- The local ring $(T_1)_{Q_1}$ is regular (\cref{lem:mv-power-series-regular-ring}),
    so $K_1(T_1)_{Q_1}$ is a prime with regular quotient, generated by part $f_1,\dots,f_h$ of a
    regular system of parameters, independent modulo the square of the maximal ideal. By the
    minor form of the jacobian criterion (\cref{lem:jacobian-minor}) some $h\times h$ minor
    $\det(\partial_{s_j}f_i)$ is not in $Q_1$. The partial derivations of $T_1$ extend to
    $\hat\Lambda[y]_{\mathfrak Q}$ compatibly with $\rho$
    (\cref{lem:extension-derivation-compat}, \cref{lem:derivation-localization},
    \cref{lem:derivation-completion}), and the minor is a unit there, so by the elementary
    lemma (\cref{lem:indep-mod-sq-of-unit-det}) the $f_i$ are independent modulo the square of
    the maximal ideal of the regular local ring $\hat\Lambda[y]_{\mathfrak Q}$
    (\cref{lem:mv-power-series-regular-ring}); the quotient by them is regular
    (\cref{lem:regular-quotient-indep-mod-sq}). Finally $K_1\hat\Lambda[y]_{\mathfrak Q}$ is the
    ideal they generate, up to the unit change of generators.
    \textbf{Deviation from the paper (gap filled).} Footnote~31 says only ``apply the jacobian
    criterion''. -/)
  (proofUses := ["lem:mv-power-series-regular-ring", "lem:jacobian-minor",
    "lem:extension-derivation-compat", "lem:derivation-localization",
    "lem:derivation-completion", "lem:indep-mod-sq-of-unit-det",
    "lem:regular-quotient-indep-mod-sq"])
  (latexEnv := "lemma")]
theorem isRegularLocalRing_localization_quotient_completion_of_quotient [Hironaka.Cited.IsRegularLocalRingLocalizationIffRankJacobianEqHeight.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] [CharZero k] (l : ℕ)
    [IsRegularLocalRing (Localization.AtPrime P)]
    (K₁ : Ideal (PowerSeriesPolynomialRing k n (m + l)))
    (𝔔 : Ideal (MvPolynomial (Fin l) (completionAtPrime P))) [𝔔.IsPrime]
    (hreg : IsRegularLocalRing (Localization.AtPrime (𝔔.comap (completionExtensionHom P l)) ⧸
      K₁.map (algebraMap (PowerSeriesPolynomialRing k n (m + l))
        (Localization.AtPrime (𝔔.comap (completionExtensionHom P l)))))) :
    IsRegularLocalRing (Localization.AtPrime 𝔔 ⧸
      K₁.map ((algebraMap (MvPolynomial (Fin l) (completionAtPrime P))
        (Localization.AtPrime 𝔔)).comp (completionExtensionHom P l))) := by
  classical
  have hQ₁ : (𝔔.comap (completionExtensionHom P l)).IsPrime := Ideal.comap_isPrime _ _
  set ρ := completionExtensionHom P l with hρ
  let Q₁ := 𝔔.comap ρ
  have hΛ'' : IsRegularLocalRing (Localization.AtPrime Q₁) := inferInstance
  have hΛ' := isRegularLocalRing_localization_mvPolynomial_completion P l 𝔔
  -- the ideal `𝔞 = K₁ T₁_{Q₁}` is prime with regular quotient
  set 𝔞 := K₁.map (algebraMap (PowerSeriesPolynomialRing k n (m + l)) (Localization.AtPrime Q₁))
    with h𝔞
  have h𝔞prime : 𝔞.IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime 𝔞).mp (isDomain_of_isRegularLocalRing _)
  obtain ⟨S, T', hSspan, hScard, hT'S, hT'span⟩ := exists_finset_span_eq_prime
    (Localization.AtPrime Q₁) 𝔞 hreg
  have hind0 := isIndepModSq_of_subset_minimalGenerators S hSspan hScard T' hT'S
  -- reindex by `Fin h`
  let e : Fin T'.card ≃ T' := T'.equivFin.symm
  let f : Fin T'.card → Localization.AtPrime Q₁ := fun i => ((e i : T') : Localization.AtPrime Q₁)
  have hfind : IsIndepModSq f := hind0.comp_equiv e
  have hfspan : Ideal.span (Set.range f) = 𝔞 := by
    rw [← hT'span]
    congr 1
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (e i).2
    · intro hx
      exact ⟨e.symm ⟨x, hx⟩, by simp [f]⟩
  have h𝔞le : 𝔞 ≤ maximalIdeal (Localization.AtPrime Q₁) := by
    have : 𝔞 ≠ ⊤ := h𝔞prime.ne_top
    exact IsLocalRing.le_maximalIdeal this
  have hfmem : ∀ i, f i ∈ maximalIdeal (Localization.AtPrime Q₁) := fun i =>
    h𝔞le (hfspan ▸ Ideal.subset_span ⟨i, rfl⟩)
  -- lift to `T₁`
  obtain ⟨a, haQ, hainds, hspan_a⟩ := exists_lift_isIndepModSq_localization Q₁ f hfmem hfind
  -- the minor form of the jacobian criterion in `T₁`
  obtain ⟨s, hs⟩ := exists_minor_notMem_of_isIndepModSq (P := Q₁) a haQ hainds
  -- the partial derivations extend to `Λ'`
  obtain ⟨D, hD⟩ := exists_derivations_localization_completion_extension P l 𝔔
  let ρ' := (algebraMap (MvPolynomial (Fin l) (completionAtPrime P))
    (Localization.AtPrime 𝔔)).comp ρ
  have hmem' : ∀ x, x ∈ Q₁ → ρ' x ∈ maximalIdeal (Localization.AtPrime 𝔔) := fun x hx =>
    (algebraMap_completionExtensionHom_mem_maximalIdeal_iff P l 𝔔 x).mpr hx
  have hdet : IsUnit (Matrix.of fun i j => D (s j) (ρ' (a i))).det := by
    have hmat : (Matrix.of fun i j => D (s j) (ρ' (a i))) =
        ρ'.mapMatrix (Matrix.of fun i j => pderiv k n (m + l) (s j) (a i)) := by
      ext i j
      simp only [Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply]
      exact hD (s j) (a i)
    rw [hmat, ← RingHom.map_det]
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hmem
    exact hs ((algebraMap_completionExtensionHom_mem_maximalIdeal_iff P l 𝔔 _).mp hmem)
  have hindρ : IsIndepModSq (fun i => ρ' (a i)) :=
    isIndepModSq_of_isUnit_det (fun j => D (s j)) (fun i => ρ' (a i))
      (fun i => hmem' _ (haQ i)) hdet
  have hregquot := hindρ.isRegularLocalRing_quotient (fun i => hmem' _ (haQ i))
  -- `K₁ Λ' = (ρ' a) Λ'`
  have hunits : ∀ y : Q₁.primeCompl, IsUnit (ρ' y) := fun y => by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hy
    exact y.2 ((algebraMap_completionExtensionHom_mem_maximalIdeal_iff P l 𝔔 _).mp hy)
  let ψ : Localization.AtPrime Q₁ →+* Localization.AtPrime 𝔔 := IsLocalization.lift hunits
  have hψ : ∀ x, ψ (algebraMap _ (Localization.AtPrime Q₁) x) = ρ' x := fun x =>
    IsLocalization.lift_eq hunits x
  have hmapeq : K₁.map ρ' = Ideal.span (Set.range fun i => ρ' (a i)) := by
    have h1 : K₁.map ρ' = 𝔞.map ψ := by
      rw [h𝔞, Ideal.map_map]
      congr 1
      exact RingHom.ext fun x => (hψ x).symm
    rw [h1, ← hfspan, ← hspan_a, Ideal.map_span, ← Set.range_comp]
    congr 2
    ext i
    exact hψ (a i)
  have heq : Ideal.span (Set.range fun i => ρ' (a i)) = K₁.map ρ' := hmapeq.symm
  have key : IsRegularLocalRing (Localization.AtPrime 𝔔 ⧸ K₁.map ρ') :=
    IsRegularLocalRing.of_ringEquiv
      (R := Localization.AtPrime 𝔔 ⧸ Ideal.span (Set.range fun i => ρ' (a i)))
      (Ideal.quotEquivOfEq heq)
  exact key

end Core

end Hironaka

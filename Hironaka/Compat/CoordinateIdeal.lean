module

public import Mathlib.Algebra.Category.Grp.EpiMono
public import Hironaka.Compat.FrameCoordinates
public import Hironaka.Compat.IdealSheafOfStalks
public import Hironaka.Compat.InvertibleSubsheaf

/-!
# The ideal of coordinates of a subsheaf (Ch. 0, proof of Corollary 2 of Main Theorem II, p. 145)

Hironaka, Ch. 0 §5, proof of Corollary 2 (p. 145): "Let `J` be the coherent sheaf of ideals on `X` which is
defined as follows: For each point `x` of `X`, we choose a free base `(c_1, c_2, …, c_r)` (resp. `d`) of the
`O_{X,x}`-module `F_x` (resp. `M_x`), and we write `d = ∑_{j=1}^r h_j c_j` with elements `h_j` in `O_{X,x}`.
Then we see that the ideal `(h_1, h_2, …, h_r) O_{X,x}` is independent of the choice of those bases.  Now `J`
is defined in such a way that `J_x = (h_1, h_2, …, h_r) O_{X,x}`."

Here `F` is a locally free sheaf with local frames, `M` an invertible sheaf and `i : M ⟶ F` a morphism (a
monomorphism in the application).  The paper's choices of bases are replaced by *all* frames, which makes the
independence (the paper: "then we see that the ideal is independent of the choice") a theorem rather than an
implicit choice:

* `Hironaka.coordStalkIdeal i x`: the ideal of `𝒪_{X,x}` generated by the germs of the coordinates
  `coord_c(i(m))_j` for all frames `c` of `F` and all sections `m` of `M` near `x`;
* `Hironaka.coordStalkIdeal_eq_span`: **independence of the choices**: if `c` is a frame of `F` over `U` and
  `d` a one-element frame of `M` over `V`, then on every `W ≤ U ⊓ V` the stalk ideals are generated by the germs
  of the coordinates of `i(d)` in the frame `c` (the change of frame is a matrix, and a change of generator a
  unit);
* `Hironaka.isLocallyGenerated_coordStalkIdeal`: the family `x ↦ J_x` is locally generated, so by
  `Hironaka/Compat/IdealSheafOfStalks.lean` it is the family of stalks of a sheaf of ideals
  `Hironaka.coordSubscheme i : Subscheme X` ("`J` is the coherent sheaf of ideals defined by `J_x = (h_j)`");
* `Hironaka.coordStalkIdeal_ne_bot`: `J_x ≠ 0` when `i` is a monomorphism ("`J` is a sheaf of non-zero
  ideals", needed to apply Corollary 1).

Deviation from the paper (gaps filled): the independence of the choice of bases, the coherence of `J`, and
`J_x ≠ 0` are not argued in the paper (Corollary 2 of Main Theorem II).
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite
open AlgebraicGeometry.Scheme Hironaka.Scheme.Modules AlgebraicGeometry.Scheme.Modules

namespace Hironaka

universe u

variable {X : Scheme.{u}}

/-- A monomorphism of `𝒪_X`-modules is injective on sections. -/
theorem app_injective_of_mono {M F : X.Modules} (i : M ⟶ F) [Mono i] (V : X.Opens) :
    Function.Injective (i.app V) := by
  have h1 : Mono ((Scheme.Modules.toPresheaf X).map i) := inferInstance
  have h2 : Mono (((Scheme.Modules.toPresheaf X).map i).app (Opposite.op V)) :=
    (NatTrans.mono_iff_mono_app _).mp h1 _
  exact (AddCommGrpCat.mono_iff_injective _).mp h2

variable {M F : X.Modules} (i : M ⟶ F)

/-- Naturality of a morphism of modules on sections. -/
theorem app_sectionRes {V W : X.Opens} (h : V ≤ W) (m : Γ(M, W)) :
    i.app V (M.sectionRes h m) = F.sectionRes h (i.app W m) :=
  (map_hom_app_apply i (homOfLE h) m).symm

/-- The stalk `J_x` of the ideal of coordinates: generated by the germs of the coordinates `coord_c(i m)_j` of the
images of sections `m` of `M` near `x` in all frames `c` of `F`. -/
noncomputable def coordStalkIdeal (x : X) : Ideal (X.presheaf.stalk x) :=
  Ideal.span {a | ∃ (V U : X.Opens) (hxV : x ∈ V) (hVU : V ≤ U) (ι : Type u) (_ : Fintype ι)
    (c : ι → Γ(F, U)) (hc : IsFrame F U c) (m : Γ(M, V)) (j : ι),
      a = (X.presheaf.germ V x hxV).hom (hc.coord hVU (i.app V m) j)}

/-- **Change of frame.**  The coordinates in one frame are combinations of the coordinates in another, with
coefficients the coordinates of the frame vectors. -/
theorem coord_change {U U' T : X.Opens} {ι ι' : Type u} [Fintype ι] [Fintype ι'] {c : ι → Γ(F, U)}
    {c' : ι' → Γ(F, U')} (hc : IsFrame F U c) (hc' : IsFrame F U' c') (hTU : T ≤ U) (hTU' : T ≤ U')
    (s : Γ(F, T)) (j : ι') :
    hc'.coord hTU' s j = ∑ k, hc.coord hTU s k * hc'.coord hTU' (F.sectionRes hTU (c k)) j := by
  conv_lhs => rw [← hc.sum_coord_smul hTU s]
  rw [IsFrame.coord_sum]
  exact Finset.sum_congr rfl fun k _ => IsFrame.coord_smul hc' hTU' _ _ j

/-- **Independence of the choices.**  If `c` is a frame of `F` over `U` and `d` a one-element frame of
`M` over `V`, then for `W ≤ U ⊓ V` the stalk ideal `J_y`, `y ∈ W`, is generated by the germs of the coordinates
of `i(d)` in the frame `c`: the ideal does not depend on the choice of the bases. -/
theorem coordStalkIdeal_eq_span {U V W : X.Opens} {ι : Type u} [Fintype ι] {c : ι → Γ(F, U)}
    (hc : IsFrame F U c) {d : Γ(M, V)} (hd : IsFrame M V (fun _ : PUnit.{u + 1} => d))
    (hWV : W ≤ V) (hWU : W ≤ U) {y : X} (hy : y ∈ W) :
    coordStalkIdeal i y = Ideal.span (Set.range fun j =>
      (X.presheaf.germ W y hy).hom (hc.coord hWU (i.app W (M.sectionRes hWV d)) j)) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨V', U', hyV', hV'U', ι', hι', c', hc', m, j, rfl⟩
    have hTV' : V' ⊓ W ≤ V' := inf_le_left
    have hTW : V' ⊓ W ≤ W := inf_le_right
    have hTV : V' ⊓ W ≤ V := hTW.trans hWV
    have hTU : V' ⊓ W ≤ U := hTW.trans hWU
    have hTU' : V' ⊓ W ≤ U' := hTV'.trans hV'U'
    have hyT : y ∈ V' ⊓ W := ⟨hyV', hy⟩
    obtain ⟨a, ha⟩ := (hd.bijective (V' ⊓ W) hTV).2 (M.sectionRes hTV' m)
    have hα : a PUnit.unit • M.sectionRes hTV d = M.sectionRes hTV' m := by
      simp only [Finset.univ_unique, Finset.sum_singleton] at ha
      exact ha
    set α := a PUnit.unit with hαdef
    set s : Γ(F, V' ⊓ W) := F.sectionRes hTW (i.app W (M.sectionRes hWV d)) with hs
    have hid : i.app (V' ⊓ W) (M.sectionRes hTV d) = s := by
      rw [hs, ← app_sectionRes, Modules.sectionRes_res]
    have him : F.sectionRes hTV' (i.app V' m) = α • s := by
      rw [← app_sectionRes, ← hα, Hom.app_smul, hid]
    have e1 : (X.presheaf.germ V' y hyV').hom (hc'.coord hV'U' (i.app V' m) j) =
        (X.presheaf.germ (V' ⊓ W) y hyT).hom
          (hc'.coord hTU' (F.sectionRes hTV' (i.app V' m)) j) := by
      rw [hc'.coord_sectionRes hTV' hV'U' (i.app V' m) j]
      exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hTV') y hyT _).symm
    have e2 : hc'.coord hTU' (α • s) j = α * ∑ k, resO X hTW
        (hc.coord hWU (i.app W (M.sectionRes hWV d)) k) *
          hc'.coord hTU' (F.sectionRes hTU (c k)) j := by
      rw [IsFrame.coord_smul hc' hTU', coord_change hc hc' hTU hTU' s j]
      congr 1
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [hs]
      congr 1
      exact hc.coord_sectionRes hTW hWU _ k
    rw [e1, him, e2, map_mul, map_sum]
    refine Ideal.mul_mem_left _ _ (Ideal.sum_mem _ fun k _ => ?_)
    rw [map_mul]
    refine Ideal.mul_mem_right _ _ ?_
    have : (X.presheaf.germ (V' ⊓ W) y hyT).hom
        (resO X hTW (hc.coord hWU (i.app W (M.sectionRes hWV d)) k)) =
        (X.presheaf.germ W y hy).hom (hc.coord hWU (i.app W (M.sectionRes hWV d)) k) :=
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hTW) y hyT _
    rw [this]
    exact Ideal.subset_span ⟨k, rfl⟩
  · rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨W, U, hy, hWU, ι, inferInstance, c, hc, M.sectionRes hWV d, j, rfl⟩

/-- The family `x ↦ J_x` of stalk ideals of coordinates is locally generated, for a sheaf `F` with local frames
and an invertible sheaf `M` (Corollary 2, p. 145: "`J_x = (h_1, …, h_r) O_{X,x}`"). -/
theorem isLocallyGenerated_coordStalkIdeal (hF : HasLocalFrames F) (hM : IsInvertible M) :
    IsLocallyGenerated (coordStalkIdeal i) := by
  intro x
  obtain ⟨U, hxU, ι, hι, c, hc⟩ := hF x
  obtain ⟨V, hxV, d, hd⟩ := hM x
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ ((U ⊓ V : X.Opens) : Set X) from ⟨hxU, hxV⟩)
      (U ⊓ V).isOpen
  have hWU : W ≤ U := fun z hz => (hWUV hz).1
  have hWV : W ≤ V := fun z hz => (hWUV hz).2
  refine ⟨W, hW, hxW, ι, inferInstance, fun j => hc.coord hWU (i.app W (M.sectionRes hWV d)) j,
    fun y hy => ?_⟩
  exact coordStalkIdeal_eq_span i hc hd hWV hWU hy

/-- **The sheaf of ideals `J`** of the proof of Corollary 2 (p. 145): `J_x = (h_1, …, h_r) O_{X,x}`, the ideal
generated by the coordinates of a local generator of `M` in a local frame of `F`; it is a sheaf of ideals
because the stalk ideals are locally generated (`Hironaka/Compat/IdealSheafOfStalks.lean`). -/
noncomputable def coordSubscheme [IsLocallyNoetherian X] (hF : HasLocalFrames F) (hM : IsInvertible M) :
    Subscheme X :=
  subschemeOfLocallyGenerated (isLocallyGenerated_coordStalkIdeal i hF hM)

/-- The stalks of `coordSubscheme` are the ideals `J_x = (h_1, …, h_r) O_{X,x}`. -/
theorem stalkIdeal_coordSubscheme [IsLocallyNoetherian X] (hF : HasLocalFrames F) (hM : IsInvertible M)
    (x : X) : (coordSubscheme i hF hM).stalkIdeal x = coordStalkIdeal i x :=
  stalkIdeal_subschemeOfLocallyGenerated _ x

/-- The stalks of `coordSubscheme` near a point are generated by the coordinates of a local generator in a local
frame: the formula "`J_x = (h_1, …, h_r) O_{X,x}`" of p. 145, for any choice of the bases. -/
theorem stalkIdeal_coordSubscheme_eq_span [IsLocallyNoetherian X] (hF : HasLocalFrames F)
    (hM : IsInvertible M) {U V W : X.Opens} {ι : Type u} [Fintype ι] {c : ι → Γ(F, U)}
    (hc : IsFrame F U c) {d : Γ(M, V)} (hd : IsFrame M V (fun _ : PUnit.{u + 1} => d))
    (hWV : W ≤ V) (hWU : W ≤ U) {y : X} (hy : y ∈ W) :
    (coordSubscheme i hF hM).stalkIdeal y = Ideal.span (Set.range fun j =>
      (X.presheaf.germ W y hy).hom (hc.coord hWU (i.app W (M.sectionRes hWV d)) j)) := by
  rw [stalkIdeal_coordSubscheme, coordStalkIdeal_eq_span i hc hd hWV hWU hy]

/-- `J_x ≠ 0` when `i : M ⟶ F` is a monomorphism and `M` is invertible ("a coherent sheaf of non-zero ideals",
needed to apply Corollary 1). -/
theorem coordStalkIdeal_ne_bot [Mono i] (hF : HasLocalFrames F) (hM : IsInvertible M) (x : X) :
    coordStalkIdeal i x ≠ ⊥ := by
  intro hbot
  obtain ⟨U, hxU, ι, hι, c, hc⟩ := hF x
  obtain ⟨V, hxV, d, hd⟩ := hM x
  have hxW : x ∈ U ⊓ V := ⟨hxU, hxV⟩
  have hWU : U ⊓ V ≤ U := inf_le_left
  have hWV : U ⊓ V ≤ V := inf_le_right
  rw [coordStalkIdeal_eq_span i hc hd hWV hWU hxW, Ideal.span_eq_bot] at hbot
  -- every coordinate has zero germ: it vanishes on a neighbourhood
  set σ : Γ(F, U ⊓ V) := i.app (U ⊓ V) (M.sectionRes hWV d) with hσ
  have h0 : ∀ j, ∃ (T : X.Opens) (hxT : x ∈ T) (hT : T ≤ U ⊓ V),
      resO X hT (hc.coord hWU σ j) = 0 := by
    intro j
    have hj : (X.presheaf.germ (U ⊓ V) x hxW).hom (hc.coord hWU σ j) = 0 := hbot _ ⟨j, rfl⟩
    obtain ⟨T, hxT, iU, iV, e⟩ := TopCat.Presheaf.germ_eq X.presheaf x hxW hxW
      (hc.coord hWU σ j) 0 (by rw [hj, map_zero])
    refine ⟨T, hxT, iU.le, ?_⟩
    have e' := e
    rw [map_zero] at e'
    exact e'
  choose T hxT hT h0 using h0
  let T₀ : X.Opens := ⟨(⋂ j, (T j : Set X)) ∩ ((U ⊓ V : X.Opens) : Set X),
    (isOpen_iInter_of_finite fun j => (T j).isOpen).inter (U ⊓ V).isOpen⟩
  have hxT₀ : x ∈ T₀ := ⟨Set.mem_iInter.mpr hxT, hxW⟩
  have hT₀T : ∀ j, T₀ ≤ T j := fun j z hz => Set.mem_iInter.mp hz.1 j
  have hT₀W : T₀ ≤ U ⊓ V := fun z hz => hz.2
  have hT₀V : T₀ ≤ V := hT₀W.trans hWV
  have hT₀U : T₀ ≤ U := hT₀W.trans hWU
  -- the section `i(d)` vanishes on `T₀`
  have hs0 : F.sectionRes hT₀W σ = 0 := by
    refine hc.ext_coord hT₀U fun j => ?_
    rw [IsFrame.coord_zero]
    have := hc.coord_sectionRes hT₀W hWU σ j
    have h1 := h0 j
    have h2 : resO X hT₀W (hc.coord hWU σ j) = resO X (hT₀T j) (resO X (hT j) (hc.coord hWU σ j)) := by
      rw [resO_resO]
    rw [this, h2, h1]
    exact map_zero _
  have hd0 : M.sectionRes hT₀V d = 0 := by
    apply app_injective_of_mono i T₀
    have e : M.sectionRes hT₀V d = M.sectionRes hT₀W (M.sectionRes hWV d) :=
      (Modules.sectionRes_res M hT₀W hWV d).symm
    rw [map_zero, e, app_sectionRes]
    exact hs0
  -- the frame `d` forces `1 = 0` on `T₀`
  have hnt : Nontrivial Γ(X, T₀) := by
    have : Nonempty T₀ := ⟨⟨x, hxT₀⟩⟩
    exact Scheme.component_nontrivial X T₀
  have hinj := (hd.bijective T₀ hT₀V).1
  have h10 : (fun _ : PUnit.{u + 1} => (1 : Γ(X, T₀))) = fun _ => 0 := by
    apply hinj
    have hd0' : (ConcreteCategory.hom (M.presheaf.map (homOfLE hT₀V).op)) d = 0 := hd0
    simp [hd0']
  exact one_ne_zero (congrFun h10 PUnit.unit)

end Hironaka

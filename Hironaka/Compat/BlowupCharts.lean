/-!
# Compatibility layer: affine charts of a monoidal transformation

Hironaka characterizes the monoidal transformation `f : X' → X` with center `B` by its universal
mapping property (Ch. 0 §2, p. 166; `MonoidalTransformation`), and then computes with charts:
"`O_{x'}` is a localization of `O_x[z_{r+1}/z_t, …, z_s/z_t]`" (p. 169), "we see that `R'` is a
monoidal transform of `R` with center `P`" (p. 214).  This file builds the charts from the
universal property and proves these local descriptions.

* Stage 1: the chart algebra `A[I/a] ⊆ A_a` (`chartAlgebra`) and its universal property.
* Stage 2: for an affine open `U ⊆ X` and `a ∈ I = B(U)`, the chart
  `Spec Γ(X, U)[I/a] → X'` (`MonoidalTransformation.chart`) is an open immersion onto the open
  `V_a` where `f⁻¹(B)` is generated by `a`, and the `V_a` cover `f⁻¹(U)`.
* Stage 3: every local ring `O_{X', y}` is the localization of a chart algebra at a prime,
  compatibly with the maps from `Γ(X, U)` (`exists_stalk_ringEquiv_localization`).
* Stage 4 (the bridge): if `X` is regular at `x = f(y)`, then `O_{X', y}` is, over
  `R = O_{X, x}`, a monoidal transform of `R` with center `P = B_x` in the sense of Ch. III §2
  (`MonoidalTransformation.exists_monoidalTransform_stalk`); where `x ∉ B`, `f` is a local
  isomorphism at `y` (`MonoidalTransformation.bijective_stalkMap_of_notMem`).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace
open scoped nonZeroDivisors

namespace Hironaka

universe u

section ChartAlgebra

variable {A : Type*} [CommRing A]

/-- The chart algebra. -/
noncomputable def chartAlgebra (I : Ideal A) (a : A) : Subalgebra A (Localization.Away a) :=
  Algebra.adjoin A
    ((fun i : A => algebraMap A (Localization.Away a) i * IsLocalization.Away.invSelf a) '' I)

variable {I : Ideal A} {a : A}

theorem algebraMap_mul_invSelf_mem_chartAlgebra {i : A} (hi : i ∈ I) :
    algebraMap A (Localization.Away a) i * IsLocalization.Away.invSelf a ∈ chartAlgebra I a :=
  Algebra.subset_adjoin ⟨i, hi, rfl⟩

theorem algebraMap_mul_invSelf_pow_mem_chartAlgebra {n : ℕ} {b : A} (hb : b ∈ I ^ n) :
    algebraMap A (Localization.Away a) b * IsLocalization.Away.invSelf a ^ n ∈
      chartAlgebra I a := by
  induction n generalizing b with
  | zero =>
    rw [pow_zero, mul_one]
    exact Subalgebra.algebraMap_mem _ b
  | succ n ih =>
    rw [pow_succ'] at hb
    refine Submodule.mul_induction_on hb (fun i hi c hc => ?_) (fun x y hx hy => ?_)
    · have : algebraMap A (Localization.Away a) (i * c) * IsLocalization.Away.invSelf a ^ (n + 1)
          = (algebraMap A _ i * IsLocalization.Away.invSelf a) *
            (algebraMap A _ c * IsLocalization.Away.invSelf a ^ n) := by
        rw [map_mul]; ring
      rw [this]
      exact Subalgebra.mul_mem _ (algebraMap_mul_invSelf_mem_chartAlgebra hi) (ih hc)
    · rw [map_add, add_mul]
      exact Subalgebra.add_mem _ hx hy

theorem mem_chartAlgebra_iff (ha : a ∈ I) {x : Localization.Away a} :
    x ∈ chartAlgebra I a ↔ ∃ (n : ℕ) (b : A), b ∈ I ^ n ∧
      x = algebraMap A (Localization.Away a) b * IsLocalization.Away.invSelf a ^ n := by
  constructor
  · intro hx
    have key : algebraMap A (Localization.Away a) a * IsLocalization.Away.invSelf a = 1 :=
      IsLocalization.Away.mul_invSelf a
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      exact ⟨1, i, by rwa [pow_one], by rw [pow_one]⟩
    | algebraMap r => exact ⟨0, r, by simp, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨n, b, hb, rfl⟩ := hx
      obtain ⟨m, c, hc, rfl⟩ := hy
      refine ⟨n + m, b * a ^ m + c * a ^ n, ?_, ?_⟩
      · refine Ideal.add_mem _ ?_ ?_
        · rw [pow_add]; exact Ideal.mul_mem_mul hb (Ideal.pow_mem_pow ha m)
        · rw [pow_add, mul_comm (I ^ n)]; exact Ideal.mul_mem_mul hc (Ideal.pow_mem_pow ha n)
      · calc algebraMap A (Localization.Away a) b * IsLocalization.Away.invSelf a ^ n +
              algebraMap A (Localization.Away a) c * IsLocalization.Away.invSelf a ^ m
            = algebraMap A (Localization.Away a) b * IsLocalization.Away.invSelf a ^ n *
                (algebraMap A _ a * IsLocalization.Away.invSelf a) ^ m +
              algebraMap A (Localization.Away a) c * IsLocalization.Away.invSelf a ^ m *
                (algebraMap A _ a * IsLocalization.Away.invSelf a) ^ n := by
              rw [key, one_pow, one_pow, mul_one, mul_one]
          _ = _ := by simp only [map_add, map_mul, map_pow]; ring
    | mul x y _ _ hx hy =>
      obtain ⟨n, b, hb, rfl⟩ := hx
      obtain ⟨m, c, hc, rfl⟩ := hy
      refine ⟨n + m, b * c, by rw [pow_add]; exact Ideal.mul_mem_mul hb hc, ?_⟩
      rw [map_mul]; ring
  · rintro ⟨n, b, hb, rfl⟩
    exact algebraMap_mul_invSelf_pow_mem_chartAlgebra hb

/-- The element `i/a` of `A[I/a]` for `i ∈ I`. -/
noncomputable def chartAlgebra.frac {i : A} (hi : i ∈ I) : chartAlgebra I a :=
  ⟨_, algebraMap_mul_invSelf_mem_chartAlgebra hi⟩

theorem chartAlgebra.algebraMap_mul_frac {i : A} (hi : i ∈ I) :
    algebraMap A (chartAlgebra I a) a * chartAlgebra.frac hi = algebraMap A (chartAlgebra I a) i := by
  apply Subtype.ext
  change algebraMap A (Localization.Away a) a *
    (algebraMap A (Localization.Away a) i * IsLocalization.Away.invSelf a) =
      algebraMap A (Localization.Away a) i
  rw [mul_left_comm, IsLocalization.Away.mul_invSelf, mul_one]

theorem map_algebraMap_chartAlgebra (ha : a ∈ I) :
    I.map (algebraMap A (chartAlgebra I a)) = Ideal.span {algebraMap A (chartAlgebra I a) a} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro i hi
    rw [Ideal.mem_comap, Ideal.mem_span_singleton']
    exact ⟨chartAlgebra.frac hi, by rw [mul_comm, chartAlgebra.algebraMap_mul_frac]⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ ha

theorem algebraMap_mem_nonZeroDivisors_chartAlgebra :
    algebraMap A (chartAlgebra I a) a ∈ (chartAlgebra I a)⁰ := by
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  have hx' : (x : Localization.Away a) * algebraMap A (Localization.Away a) a = 0 :=
    congrArg Subtype.val hx
  exact Subtype.ext ((IsLocalization.Away.algebraMap_isUnit a).mul_left_eq_zero.mp hx')

/-- The image of a non-zero-divisor in a localization is a non-zero-divisor. -/
theorem algebraMap_mem_nonZeroDivisors_of_isLocalization {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (M : Submonoid R) [IsLocalization M S] {r : R}
    (hr : r ∈ R⁰) : algebraMap R S r ∈ S⁰ := by
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  obtain ⟨y, s, rfl⟩ := IsLocalization.mk'_surjective M x
  rw [← IsLocalization.mk'_one (M := M) S r, ← IsLocalization.mk'_mul, mul_one,
    IsLocalization.mk'_eq_zero_iff] at hx
  obtain ⟨c, hc⟩ := hx
  rw [IsLocalization.mk'_eq_zero_iff]
  refine ⟨c, (mul_right_mem_nonZeroDivisors_eq_zero_iff hr).mp ?_⟩
  rw [← hc]; ring

theorem algebraMap_mem_nonZeroDivisors_chartAlgebra_localization {S : Type*} [CommRing S]
    [Algebra (chartAlgebra I a) S] (M : Submonoid (chartAlgebra I a)) [IsLocalization M S] :
    algebraMap (chartAlgebra I a) S (algebraMap A (chartAlgebra I a) a) ∈ S⁰ :=
  algebraMap_mem_nonZeroDivisors_of_isLocalization M algebraMap_mem_nonZeroDivisors_chartAlgebra

/-- Uniqueness in the universal property of `A[I/a]`. -/
theorem chartAlgebra.ringHom_ext {C : Type*} [CommRing C] {φ₁ φ₂ : chartAlgebra I a →+* C}
    (h : φ₁.comp (algebraMap A _) = φ₂.comp (algebraMap A _))
    (ha : φ₁ (algebraMap A _ a) ∈ C⁰) : φ₁ = φ₂ := by
  have hA : ∀ r : A, φ₁ (algebraMap A _ r) = φ₂ (algebraMap A _ r) := fun r =>
    RingHom.congr_fun h r
  ext ⟨x, hx⟩
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    change φ₁ (chartAlgebra.frac hi) = φ₂ (chartAlgebra.frac hi)
    have e₁ := congrArg φ₁ (chartAlgebra.algebraMap_mul_frac (a := a) hi)
    have e₂ := congrArg φ₂ (chartAlgebra.algebraMap_mul_frac (a := a) hi)
    rw [map_mul] at e₁ e₂
    rw [← hA a, ← hA i] at e₂
    have := (mem_nonZeroDivisors_iff_left.mp ha) (φ₁ (chartAlgebra.frac hi) -
      φ₂ (chartAlgebra.frac hi)) (by rw [mul_sub, e₁, e₂, sub_self])
    exact sub_eq_zero.mp this
  | algebraMap r => exact hA r
  | add x y hx hy ihx ihy =>
    change φ₁ (⟨x, hx⟩ + ⟨y, hy⟩) = φ₂ (⟨x, hx⟩ + ⟨y, hy⟩)
    rw [map_add, map_add, ihx, ihy]
  | mul x y hx hy ihx ihy =>
    change φ₁ (⟨x, hx⟩ * ⟨y, hy⟩) = φ₂ (⟨x, hx⟩ * ⟨y, hy⟩)
    rw [map_mul, map_mul, ihx, ihy]

/-- Existence in the universal property of `A[I/a]`. -/
theorem chartAlgebra.exists_ringHom {C : Type*} [CommRing C] (ψ : A →+* C) (ha : ψ a ∈ C⁰)
    (hI : ∀ i ∈ I, ∃ c, ψ a * c = ψ i) :
    ∃ φ : chartAlgebra I a →+* C, φ.comp (algebraMap A _) = ψ := by
  let L := Localization.Away (ψ a)
  let j : C →+* L := algebraMap C L
  have hj : Function.Injective j :=
    IsLocalization.injective L (Submonoid.powers_le.mpr ha)
  let Φ : Localization.Away a →+* L := IsLocalization.Away.map (Localization.Away a) L ψ a
  have hΦ : ∀ r : A, Φ (algebraMap A _ r) = j (ψ r) := fun r => IsLocalization.map_eq _ _
  have hΦinv : Φ (algebraMap A _ a) * Φ (IsLocalization.Away.invSelf a) = 1 := by
    rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]
  have hrange : ∀ x ∈ chartAlgebra I a, Φ x ∈ j.range := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      obtain ⟨c, hc⟩ := hI i hi
      refine ⟨c, ?_⟩
      rw [map_mul, hΦ, ← hc, map_mul, ← hΦ, mul_comm (Φ _) (j c), mul_assoc, hΦinv, mul_one]
    | algebraMap r => exact ⟨ψ r, (hΦ r).symm⟩
    | add x y _ _ hx hy => rw [map_add]; exact Subring.add_mem _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact Subring.mul_mem _ hx hy
  let e : C ≃+* j.range := RingEquiv.ofBijective j.rangeRestrict
    ⟨fun x y hxy => hj (congrArg Subtype.val hxy), j.rangeRestrict_surjective⟩
  refine ⟨e.symm.toRingHom.comp ((Φ.comp (chartAlgebra I a).val.toRingHom).codRestrict j.range
    fun x => hrange x.1 x.2), ?_⟩
  ext r
  apply e.injective
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    RingEquiv.apply_symm_apply]
  apply Subtype.ext
  exact hΦ r

end ChartAlgebra

theorem stalkIdeal_eq_map_germ {X : Scheme.{u}} (D : Subscheme X) (W : X.affineOpens) {x : X}
    (hx : x ∈ (W : X.Opens)) :
    D.stalkIdeal x = (D.ideal W).map (X.presheaf.germ W x hx).hom := by
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨U, hxU, s, hs, rfl⟩
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter U.2 W.2 x ⟨hxU, hx⟩
    have hOU : X.affineBasicOpen g ≤ U := by
      show X.basicOpen g ≤ U.1
      rw [← hfg]; exact X.basicOpen_le f
    have hxO : x ∈ ((X.affineBasicOpen g : X.affineOpens) : X.Opens) := by
      show x ∈ X.basicOpen g
      rw [← hfg]; exact hxf
    have h2 := D.ideal_le_comap_ideal hOU hs
    rw [Ideal.mem_comap, ← D.map_ideal (X.affineBasicOpen_le g)] at h2
    have h3 := Ideal.mem_map_of_mem
      (X.presheaf.germ ((X.affineBasicOpen g : X.affineOpens) : X.Opens) x hxO).hom h2
    rw [Ideal.map_map, ← CommRingCat.hom_comp, TopCat.Presheaf.germ_res'] at h3
    rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hOU) x hxO]
    exact h3
  · rw [Ideal.map_le_iff_le_comap]
    intro s hs
    exact Ideal.subset_span ⟨W, hx, s, hs, rfl⟩

theorem stalkIdeal_totalTransform {X X' : Scheme.{u}} (f : X' ⟶ X) (D : Subscheme X) (y : X') :
    (Subscheme.totalTransform f D).stalkIdeal y =
      (D.stalkIdeal (f y)).map (f.stalkMap y).hom :=
  Subscheme.stalkIdeal_comap D f y

/-! ### Stage 2 helpers -/

theorem iso_hom_mem_nonZeroDivisors {R S : CommRingCat.{u}} (e : R ≅ S) {r : R}
    (hr : r ∈ R⁰) : e.hom r ∈ S⁰ := by
  rw [mem_nonZeroDivisors_iff_right] at hr ⊢
  intro x hx
  have h0 : e.inv x = 0 := hr _ (by simpa using congrArg e.inv hx)
  simpa using congrArg e.hom h0

theorem isIso_mem_nonZeroDivisors {R S : CommRingCat.{u}} (φ : R ⟶ S) [IsIso φ] {r : R}
    (hr : r ∈ R⁰) : φ r ∈ S⁰ :=
  iso_hom_mem_nonZeroDivisors (asIso φ) hr

/-- The basic open `D(r) ⊆ W` of an affine open, as an affine open (a reducible version of
`Scheme.affineBasicOpen`). -/
abbrev affBasicOpen {X : Scheme.{u}} (W : X.affineOpens) (r : Γ(X, W)) : X.affineOpens :=
  ⟨X.basicOpen r, W.2.basicOpen r⟩

theorem ideal_affBasicOpen_eq_span {X : Scheme.{u}} (D : X.IdealSheafData)
    {W : X.affineOpens} {s : Γ(X, W)} (hs : D.ideal W = Ideal.span {s}) (r : Γ(X, W)) :
    D.ideal (affBasicOpen W r) =
      Ideal.span {X.presheaf.map (homOfLE (X.basicOpen_le r)).op s} := by
  have := D.map_ideal_basicOpen W r
  rw [hs, Ideal.map_span, Set.image_singleton] at this
  exact this.symm

theorem res_basicOpen_mem_nonZeroDivisors {X : Scheme.{u}} (W : X.affineOpens)
    {s : Γ(X, W)} (hs : s ∈ Γ(X, W)⁰) (r : Γ(X, W)) :
    X.presheaf.map (homOfLE (X.basicOpen_le r)).op s ∈ Γ(X, X.basicOpen r)⁰ := by
  have := W.2.isLocalization_basicOpen r
  exact algebraMap_mem_nonZeroDivisors_of_isLocalization (S := Γ(X, X.basicOpen r))
    (Submonoid.powers r) hs

/-- The total transform of an invertible ideal sheaf along an open immersion is invertible. -/
theorem isInvertibleIdeal_totalTransform_of_isOpenImmersion {X Y : Scheme.{u}}
    {D : Subscheme X} (hD : D.IsInvertibleIdeal) (j : Y ⟶ X) [IsOpenImmersion j] :
    (Subscheme.totalTransform j D).IsInvertibleIdeal := by
  intro y
  obtain ⟨U, hjyU, s, hs, hsnzd⟩ := hD (j y)
  obtain ⟨r, hrle, hyr⟩ := U.2.exists_basicOpen_le (V := j.opensRange) ⟨j y, ⟨y, rfl⟩⟩ hjyU
  have hWmem : j ⁻¹ᵁ X.basicOpen r ∈ Y.affineOpens :=
    (U.2.basicOpen r).preimage_of_isOpenImmersion j hrle
  have hiso : IsIso (j.app (X.basicOpen r)) := j.isIso_app _ hrle
  refine ⟨⟨_, hWmem⟩, hyr, j.app (X.basicOpen r)
    (X.presheaf.map (homOfLE (X.basicOpen_le r)).op s), ?_, ?_⟩
  · change (D.comap j).ideal ⟨_, hWmem⟩ = _
    rw [ideal_comap_eq_map_appLE j D (affBasicOpen U r) ⟨_, hWmem⟩ le_rfl,
      ideal_affBasicOpen_eq_span D hs r, Ideal.map_span, Set.image_singleton,
      Scheme.Hom.appLE_eq_app]
  · exact isIso_mem_nonZeroDivisors _ (res_basicOpen_mem_nonZeroDivisors U hsnzd r)

theorem SpecMap_fromSpec_appLE {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    {S : CommRingCat.{u}} (φ : Γ(X, U) ⟶ S) (h : ⊤ ≤ (Spec.map φ ≫ hU.fromSpec) ⁻¹ᵁ U) :
    (Spec.map φ ≫ hU.fromSpec).appLE U ⊤ h = φ ≫ (Scheme.ΓSpecIso S).inv := by
  rw [Scheme.Hom.comp_appLE, IsAffineOpen.fromSpec_app_self, Scheme.ΓSpecIso_inv_naturality]
  simp only [Category.assoc]
  congr 1

/-- On an affine scheme, the germs of a global non-zero-divisor are non-zero-divisors. -/
theorem germ_mem_nonZeroDivisors_of_isAffine {Y : Scheme.{u}} [IsAffine Y] {s : Γ(Y, ⊤)}
    (hs : s ∈ Γ(Y, ⊤)⁰) (z : Y) :
    Y.presheaf.germ ⊤ z trivial s ∈ (Y.presheaf.stalk z)⁰ := by
  let := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨z, trivial⟩ : (⊤ : Y.Opens))
  have := (isAffineOpen_top Y).isLocalization_stalk ⟨z, trivial⟩
  exact algebraMap_mem_nonZeroDivisors_of_isLocalization (S := Y.presheaf.stalk z)
    ((isAffineOpen_top Y).primeIdealOf ⟨z, trivial⟩).asIdeal.primeCompl hs

/-- On an affine scheme, the restriction of a global non-zero-divisor to any open is a
non-zero-divisor. -/
theorem res_mem_nonZeroDivisors_of_isAffine {Y : Scheme.{u}} [IsAffine Y] {s : Γ(Y, ⊤)}
    (hs : s ∈ Γ(Y, ⊤)⁰) (T : Y.Opens) :
    Y.presheaf.map (homOfLE le_top : T ⟶ ⊤).op s ∈ Γ(Y, T)⁰ :=
  mem_nonZeroDivisors_of_germ fun z hz => by
    rw [TopCat.Presheaf.germ_res_apply]
    exact germ_mem_nonZeroDivisors_of_isAffine hs z

/-- Germs of sections pulled back along a composite. -/
theorem appLE_germ_stalkMap {Z X' X : Scheme.{u}} (k : Z ⟶ X') (f : X' ⟶ X) (U : X.Opens)
    (W : X'.Opens) (h : W ≤ f ⁻¹ᵁ U) (z : Z) (hz : k z ∈ W) (g : Z ⟶ X) (e : k ≫ f = g)
    (h' : ⊤ ≤ g ⁻¹ᵁ U) :
    f.appLE U W h ≫ X'.presheaf.germ W (k z) hz ≫ k.stalkMap z =
      g.appLE U ⊤ h' ≫ Z.presheaf.germ ⊤ z trivial := by
  subst e
  have hz' : z ∈ k ⁻¹ᵁ W := hz
  rw [← appLE_germ k W (k ⁻¹ᵁ W) le_rfl z hz' hz, ← Category.assoc,
    Scheme.Hom.appLE_comp_appLE, ← TopCat.Presheaf.germ_res Z.presheaf (homOfLE le_top) z hz',
    ← Category.assoc, Scheme.Hom.appLE_map]

/-! ### Charts -/

/-- An affine open is affine (with the membership unfolded). -/
theorem isAffineOpen_of_mem_affineOpens {X : Scheme.{u}} (W : X.affineOpens) :
    IsAffineOpen (W : X.Opens) :=
  W.2

/-- The whole of an affine scheme, as an affine open. -/
abbrev topAffineOpen (Y : Scheme.{u}) [IsAffine Y] : Y.affineOpens := ⟨⊤, isAffineOpen_top Y⟩

section Chart

variable {X : Scheme.{u}} (B : Subscheme X) (U : X.affineOpens) (a : Γ(X, U))

/-- The chart ring `Γ(X, U)[I/a]`, where `I = B(U)`. -/
noncomputable abbrev chartRing : CommRingCat.{u} := CommRingCat.of (chartAlgebra (B.ideal U) a)

/-- The structure map `Γ(X, U) ⟶ Γ(X, U)[I/a]`. -/
noncomputable abbrev chartAlgebraMap : Γ(X, U) ⟶ chartRing B U a :=
  CommRingCat.ofHom (algebraMap Γ(X, U) (chartAlgebra (B.ideal U) a))

/-- The morphism `Spec Γ(X, U)[I/a] ⟶ Spec Γ(X, U) ≅ U ⊆ X`. -/
noncomputable def chartToBase : Spec (chartRing B U a) ⟶ X :=
  Spec.map (chartAlgebraMap B U a) ≫ (isAffineOpen_of_mem_affineOpens U).fromSpec

theorem chartToBase_apply_mem (z : Spec (chartRing B U a)) : chartToBase B U a z ∈ U.1 := by
  rw [chartToBase, Scheme.Hom.comp_apply, ← SetLike.mem_coe,
    ← (isAffineOpen_of_mem_affineOpens U).range_fromSpec]
  exact ⟨_, rfl⟩

theorem chartToBase_preimage : chartToBase B U a ⁻¹ᵁ U = ⊤ :=
  eq_top_iff.mpr fun z _ => chartToBase_apply_mem B U a z

theorem chartToBase_appLE (h : ⊤ ≤ chartToBase B U a ⁻¹ᵁ U) :
    (chartToBase B U a).appLE U ⊤ h = chartAlgebraMap B U a ≫ (Scheme.ΓSpecIso _).inv :=
  SpecMap_fromSpec_appLE _ _ h

/-- The element `a`, as a global section of the chart. -/
noncomputable abbrev chartElem : Γ(Spec (chartRing B U a), ⊤) :=
  (Scheme.ΓSpecIso (chartRing B U a)).inv (algebraMap _ (chartAlgebra (B.ideal U) a) a)

theorem chartElem_mem_nonZeroDivisors : chartElem B U a ∈ Γ(Spec (chartRing B U a), ⊤)⁰ :=
  iso_hom_mem_nonZeroDivisors (Scheme.ΓSpecIso _).symm algebraMap_mem_nonZeroDivisors_chartAlgebra

variable {B U a}

theorem ideal_comap_chartToBase (ha : a ∈ B.ideal U) :
    (B.comap (chartToBase B U a)).ideal (topAffineOpen _) =
      Ideal.span {chartElem B U a} := by
  rw [ideal_comap_eq_map_appLE _ B U (topAffineOpen _) (chartToBase_preimage B U a).ge,
    chartToBase_appLE, CommRingCat.hom_comp, ← Ideal.map_map]
  simp only [chartAlgebraMap, CommRingCat.hom_ofHom]
  rw [map_algebraMap_chartAlgebra ha, Ideal.map_span, Set.image_singleton]

theorem isInvertibleIdeal_chartToBase (ha : a ∈ B.ideal U) :
    (Subscheme.totalTransform (chartToBase B U a) B).IsInvertibleIdeal := fun _ =>
  ⟨topAffineOpen _, trivial, chartElem B U a, ideal_comap_chartToBase ha,
    chartElem_mem_nonZeroDivisors B U a⟩

/-- Morphisms into the chart are determined by their composite to `X`, provided `a` is a
non-zero-divisor on the source. -/
theorem chart_hom_ext {Y : Scheme.{u}} {p₁ p₂ : Y ⟶ Spec (chartRing B U a)}
    (h : p₁ ≫ chartToBase B U a = p₂ ≫ chartToBase B U a)
    (ha : p₂.appTop (chartElem B U a) ∈ Γ(Y, ⊤)⁰) : p₁ = p₂ := by
  have h' : p₁ ≫ Spec.map (chartAlgebraMap B U a) = p₂ ≫ Spec.map (chartAlgebraMap B U a) := by
    rw [← cancel_mono (isAffineOpen_of_mem_affineOpens U).fromSpec]
    simpa only [chartToBase, Category.assoc] using h
  have hA : ∀ p : Y ⟶ Spec (chartRing B U a), chartAlgebraMap B U a ≫
      (Scheme.ΓSpecIso _).inv ≫ p.appTop =
        (Scheme.ΓSpecIso _).inv ≫ (p ≫ Spec.map (chartAlgebraMap B U a)).appTop := by
    intro p
    rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
      Scheme.Hom.comp_appTop]
  apply ext_of_isAffine
  rw [← cancel_epi (Scheme.ΓSpecIso (chartRing B U a)).inv]
  refine CommRingCat.hom_ext (chartAlgebra.ringHom_ext ?_ ?_).symm
  · rw [← CommRingCat.hom_ofHom (algebraMap _ _), ← CommRingCat.hom_comp,
      ← CommRingCat.hom_comp, hA, hA, h']
  · exact ha

end Chart

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X} (t : MonoidalTransformation X B)
  (U : X.affineOpens) {a : Γ(X, U)}

theorem exceptional_eq_comap : t.exceptional = B.comap t.f := rfl

/-- The chart morphism `Spec Γ(X,U)[I/a] ⟶ X'` given by the universal property. -/
noncomputable def chart (ha : a ∈ B.ideal U) : Spec (chartRing B U a) ⟶ t.X' :=
  (t.universal _ (chartToBase B U a) (isInvertibleIdeal_chartToBase ha)).exists.choose

@[reassoc (attr := simp)]
theorem chart_f (ha : a ∈ B.ideal U) : t.chart U ha ≫ t.f = chartToBase B U a :=
  (t.universal _ (chartToBase B U a) (isInvertibleIdeal_chartToBase ha)).exists.choose_spec

variable {t} in
theorem hom_ext {Y : Scheme.{u}} {h₁ h₂ : Y ⟶ t.X'} (h : h₁ ≫ t.f = h₂ ≫ t.f)
    (hinv : (Subscheme.totalTransform (h₁ ≫ t.f) B).IsInvertibleIdeal) : h₁ = h₂ :=
  (t.universal Y _ hinv).unique rfl h.symm

variable (a) in
/-- `W` is an affine open of `X'` contained in `f⁻¹(U)` on which the ideal of `f⁻¹(B)` is
generated by the non-zero-divisor `a`. -/
def IsChartDomain (W : t.X'.affineOpens) : Prop :=
  ∃ h : (W : t.X'.Opens) ≤ t.f ⁻¹ᵁ U, t.exceptional.ideal W = Ideal.span {t.f.appLE U W h a} ∧
    t.f.appLE U W h a ∈ Γ(t.X', W)⁰

variable (a) in
/-- The open `V_a ⊆ f⁻¹(U)` where the ideal of `f⁻¹(B)` is generated by `a`. -/
def chartOpen : t.X'.Opens := ⨆ (W : t.X'.affineOpens) (_ : t.IsChartDomain U a W), W.1

theorem mem_chartOpen_iff {y : t.X'} :
    y ∈ t.chartOpen U a ↔ ∃ W, t.IsChartDomain U a W ∧ y ∈ (W : t.X'.Opens) := by
  simp only [chartOpen, Opens.mem_iSup, exists_prop]

variable {t U} {W : t.X'.affineOpens}

theorem IsChartDomain.exists_ringHom (hW : t.IsChartDomain U a W) :
    ∃ φ : chartRing B U a ⟶ Γ(t.X', W), chartAlgebraMap B U a ≫ φ = t.f.appLE U W hW.1 := by
  obtain ⟨h, hid, hnzd⟩ := hW
  obtain ⟨φ, hφ⟩ := chartAlgebra.exists_ringHom (t.f.appLE U W h).hom hnzd (fun i hi => by
    have : (t.f.appLE U W h).hom i ∈ t.exceptional.ideal W := by
      rw [exceptional_eq_comap, ideal_comap_eq_map_appLE t.f B U W h]
      exact Ideal.mem_map_of_mem _ hi
    rw [hid, Ideal.mem_span_singleton'] at this
    obtain ⟨c, hc⟩ := this
    exact ⟨c, by rw [mul_comm]; exact hc⟩)
  exact ⟨CommRingCat.ofHom φ, CommRingCat.hom_ext hφ⟩

/-- The inverse of the chart over a chart domain. -/
noncomputable def IsChartDomain.toChart (hW : t.IsChartDomain U a W) :
    (W : t.X'.Opens).toScheme ⟶ Spec (chartRing B U a) :=
  (isAffineOpen_of_mem_affineOpens W).isoSpec.hom ≫ Spec.map hW.exists_ringHom.choose

theorem IsChartDomain.toChart_chartToBase (hW : t.IsChartDomain U a W) :
    hW.toChart ≫ chartToBase B U a = W.1.ι ≫ t.f := by
  rw [toChart, chartToBase, Category.assoc, ← Spec.map_comp_assoc,
    hW.exists_ringHom.choose_spec, IsAffineOpen.SpecMap_appLE_fromSpec t.f
      (isAffineOpen_of_mem_affineOpens U) (isAffineOpen_of_mem_affineOpens W),
    IsAffineOpen.isoSpec_hom_fromSpec_assoc]

theorem IsChartDomain.toChart_chart (ha : a ∈ B.ideal U) (hW : t.IsChartDomain U a W) :
    hW.toChart ≫ t.chart U ha = W.1.ι :=
  (hom_ext (by rw [Category.assoc, chart_f, hW.toChart_chartToBase])
    (by
      rw [Subscheme.totalTransform_comp]
      exact isInvertibleIdeal_totalTransform_of_isOpenImmersion t.invertible _)).symm

variable (t U) in
/-- Shrinking to the basic open of `u`: if `f⁻¹(B)` is generated on `W₁` by the non-zero-divisor
`s` and `a = s u`, then on `D(u)` it is generated by the non-zero-divisor `a`. -/
theorem isChartDomain_basicOpen {W₁ : t.X'.affineOpens} (h₁ : (W₁ : t.X'.Opens) ≤ t.f ⁻¹ᵁ U)
    {s u : Γ(t.X', W₁)} (hs : t.exceptional.ideal W₁ = Ideal.span {s})
    (hsnzd : s ∈ Γ(t.X', W₁)⁰) (hau : t.f.appLE U W₁ h₁ a = s * u) :
    t.IsChartDomain U a (affBasicOpen W₁ u) := by
  have h₂ : ((affBasicOpen W₁ u : t.X'.affineOpens) : t.X'.Opens) ≤ t.f ⁻¹ᵁ U :=
    (t.X'.basicOpen_le u).trans h₁
  have e : t.f.appLE U (affBasicOpen W₁ u) h₂ a =
      t.X'.presheaf.map (homOfLE (t.X'.basicOpen_le u)).op s *
        t.X'.presheaf.map (homOfLE (t.X'.basicOpen_le u)).op u := by
    rw [← map_mul, ← hau, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have hunit : IsUnit (t.X'.presheaf.map (homOfLE (t.X'.basicOpen_le u)).op u) :=
    t.X'.toRingedSpace.isUnit_res_basicOpen u
  refine ⟨h₂, ?_, ?_⟩
  · rw [e, ideal_affBasicOpen_eq_span _ hs u, Ideal.span_singleton_mul_right_unit hunit]
  · rw [e]
    exact Submonoid.mul_mem _ (res_basicOpen_mem_nonZeroDivisors W₁ hsnzd u)
      hunit.mem_nonZeroDivisors

variable (t U) in
/-- (d) The chart lands in `V_a`. -/
theorem chart_apply_mem_chartOpen (ha : a ∈ B.ideal U) (z : Spec (chartRing B U a)) :
    t.chart U ha z ∈ t.chartOpen U a := by
  have hyU : t.f (t.chart U ha z) ∈ U.1 := by
    rw [← Scheme.Hom.comp_apply, chart_f]; exact chartToBase_apply_mem B U a z
  obtain ⟨W₀, hyW₀, s, hs, hsnzd⟩ := t.invertible (t.chart U ha z)
  change t.exceptional.ideal W₀ = _ at hs
  obtain ⟨r, hrle, hyr⟩ := (isAffineOpen_of_mem_affineOpens W₀).exists_basicOpen_le
    (V := t.f ⁻¹ᵁ U) ⟨t.chart U ha z, hyU⟩ hyW₀
  have hs₁ := ideal_affBasicOpen_eq_span _ hs r
  have hs₁nzd := res_basicOpen_mem_nonZeroDivisors W₀ hsnzd r
  set s₁ := t.X'.presheaf.map (homOfLE (t.X'.basicOpen_le r)).op s
  have hW₁U : ((affBasicOpen W₀ r : t.X'.affineOpens) : t.X'.Opens) ≤ t.f ⁻¹ᵁ U := hrle
  have hid : t.exceptional.ideal (affBasicOpen W₀ r) =
      (B.ideal U).map (t.f.appLE U _ hW₁U).hom :=
    ideal_comap_eq_map_appLE t.f B U _ hW₁U
  obtain ⟨u, hu⟩ : ∃ u, t.f.appLE U _ hW₁U a = s₁ * u := by
    have : t.f.appLE U _ hW₁U a ∈ t.exceptional.ideal (affBasicOpen W₀ r) :=
      hid ▸ Ideal.mem_map_of_mem _ ha
    rw [hs₁, Ideal.mem_span_singleton'] at this
    obtain ⟨u, hu⟩ := this
    exact ⟨u, by rw [← hu, mul_comm]⟩
  suffices hunit : IsUnit (t.X'.presheaf.germ (t.X'.basicOpen r) _ hyr u) by
    rw [mem_chartOpen_iff]
    exact ⟨_, isChartDomain_basicOpen t U hW₁U hs₁ hs₁nzd hu,
      (Scheme.mem_basicOpen _ _ _ hyr).mpr hunit⟩
  have hdiag := appLE_germ_stalkMap (t.chart U ha) t.f U _ hW₁U z hyr _ (t.chart_f U ha)
    (chartToBase_preimage B U a).ge
  rw [chartToBase_appLE] at hdiag
  set γ := (Spec (chartRing B U a)).presheaf.germ ⊤ z trivial
  set σ := t.X'.presheaf.germ (t.X'.basicOpen r) _ hyr ≫ (t.chart U ha).stalkMap z
  have hα : γ (chartElem B U a) ∈ ((Spec (chartRing B U a)).presheaf.stalk z)⁰ :=
    germ_mem_nonZeroDivisors_of_isAffine (chartElem_mem_nonZeroDivisors B U a) z
  have hs₁' : σ s₁ ∈ Ideal.span {γ (chartElem B U a)} := by
    have h1 : s₁ ∈ (B.ideal U).map (t.f.appLE U _ hW₁U).hom := by
      rw [← hid, hs₁]; exact Ideal.mem_span_singleton_self _
    have h2 := Ideal.mem_map_of_mem σ.hom h1
    rw [Ideal.map_map, ← CommRingCat.hom_comp, hdiag, CommRingCat.hom_comp,
      CommRingCat.hom_comp, ← Ideal.map_map, ← Ideal.map_map] at h2
    simp only [chartAlgebraMap, CommRingCat.hom_ofHom] at h2
    rw [map_algebraMap_chartAlgebra ha, Ideal.map_span, Ideal.map_span, Set.image_singleton,
      Set.image_singleton] at h2
    exact h2
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hs₁'
  have hαeq : γ (chartElem B U a) = σ s₁ * σ u := by
    rw [← map_mul, ← hu]
    exact (congrArg (fun φ => φ a) (congrArg CommRingCat.Hom.hom hdiag)).symm
  rw [← hw] at hαeq
  have h1 : (1 - w * σ u) * γ (chartElem B U a) = 0 := by linear_combination hαeq
  have h2 : w * σ u = 1 := by
    rw [mul_right_mem_nonZeroDivisors_eq_zero_iff hα, sub_eq_zero] at h1
    exact h1.symm
  have h3 : IsUnit (σ u) := IsUnit.of_mul_eq_one w (by rw [mul_comm]; exact h2)
  exact isUnit_of_map_unit ((t.chart U ha).stalkMap z).hom _ h3

theorem IsChartDomain.chart_restrict_toChart (ha : a ∈ B.ideal U) (hW : t.IsChartDomain U a W) :
    (t.chart U ha ∣_ W.1) ≫ hW.toChart = (t.chart U ha ⁻¹ᵁ W.1).ι := by
  apply chart_hom_ext
  · rw [Category.assoc, hW.toChart_chartToBase, ← Category.assoc, morphismRestrict_ι,
      Category.assoc, chart_f]
  · exact res_mem_nonZeroDivisors_of_isAffine (chartElem_mem_nonZeroDivisors B U a) _

theorem IsChartDomain.isIso_chart_restrict (ha : a ∈ B.ideal U) (hW : t.IsChartDomain U a W) :
    IsIso (t.chart U ha ∣_ W.1) := by
  have hrange : Set.range hW.toChart ⊆ Set.range (t.chart U ha ⁻¹ᵁ W.1).ι := by
    rintro _ ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι]
    show t.chart U ha (hW.toChart w) ∈ W.1
    rw [← Scheme.Hom.comp_apply, hW.toChart_chart ha]
    exact w.2
  refine ⟨⟨IsOpenImmersion.lift _ hW.toChart hrange, ?_, ?_⟩⟩
  · rw [← cancel_mono (t.chart U ha ⁻¹ᵁ W.1).ι, Category.assoc, IsOpenImmersion.lift_fac,
      hW.chart_restrict_toChart ha, Category.id_comp]
  · rw [← cancel_mono W.1.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc,
      IsOpenImmersion.lift_fac, hW.toChart_chart ha, Category.id_comp]

variable (t U)

/-- (e) The chart `Spec Γ(X,U)[I/a] ⟶ X'` is an open immersion. -/
@[blueprint "compat:blowup-chart-open-immersion"
  (statement := /-- Let $f\colon X'\to X$ be a monoidal transformation with center $B$
    (\cref{def:monoidal-transformation}), $U=\operatorname{Spec}A\subseteq X$ an affine open,
    $I=B(U)$ and $a\in I$. The morphism $\operatorname{Spec}A[I/a]\to U\subseteq X$, where
    $A[I/a]\subseteq A_a$ is generated by the $i/a$, $i\in I$, factors uniquely through $f$, and
    the resulting chart $\operatorname{Spec}A[I/a]\to X'$ is an open immersion onto the open
    subset $V_a$ of $f^{-1}(U)$ on which the ideal of $f^{-1}(B)$ is generated by $a$. -/)
  (proof := /-- On $\operatorname{Spec}A[I/a]$ the pull-back of $I$ is generated by the
    non-zero-divisor $a$, so the universal property gives the chart. Conversely, on an affine
    open $W\subseteq f^{-1}(U)$ where $f^{-1}(B)$ is generated by the non-zero-divisor $a$, the
    universal property of $A[I/a]$ gives an inverse $W\to\operatorname{Spec}A[I/a]$; the
    uniqueness in the universal property of $f$ shows that the two are mutually inverse. -/)
  (latexEnv := "lemma")]
theorem isOpenImmersion_chart (ha : a ∈ B.ideal U) : IsOpenImmersion (t.chart U ha) := by
  have hmem : ∀ z, ∃ W, t.IsChartDomain U a W ∧ t.chart U ha z ∈ (W : t.X'.Opens) :=
    fun z => (t.mem_chartOpen_iff U).mp (t.chart_apply_mem_chartOpen U ha z)
  apply IsOpenImmersion.of_forall_source_exists
  · intro z₁ z₂ h
    obtain ⟨W, hW, hz⟩ := hmem z₁
    have := hW.isIso_chart_restrict ha
    have hz₁ : z₁ ∈ t.chart U ha ⁻¹ᵁ W.1 := hz
    have hz₂ : z₂ ∈ t.chart U ha ⁻¹ᵁ W.1 := show t.chart U ha z₂ ∈ W.1 from h ▸ hz
    let p₁ : (t.chart U ha ⁻¹ᵁ W.1).toScheme := ⟨z₁, hz₁⟩
    let p₂ : (t.chart U ha ⁻¹ᵁ W.1).toScheme := ⟨z₂, hz₂⟩
    have e : (t.chart U ha ∣_ W.1) p₁ = (t.chart U ha ∣_ W.1) p₂ :=
      Subtype.ext ((morphismRestrict_base_coe _ _ p₁).trans
        (h.trans (morphismRestrict_base_coe _ _ p₂).symm))
    exact congrArg Subtype.val ((t.chart U ha ∣_ W.1).isOpenEmbedding.injective e)
  · intro z
    obtain ⟨W, hW, hz⟩ := hmem z
    have := hW.isIso_chart_restrict ha
    refine ⟨_, (t.chart U ha ⁻¹ᵁ W.1).ι, inferInstance, ⟨⟨z, hz⟩, rfl⟩, ?_⟩
    rw [← morphismRestrict_ι]
    infer_instance

/-- The image of the chart is `V_a`. -/
theorem range_chart (ha : a ∈ B.ideal U) : Set.range (t.chart U ha) = t.chartOpen U a := by
  ext y
  constructor
  · rintro ⟨z, rfl⟩
    exact t.chart_apply_mem_chartOpen U ha z
  · intro hy
    obtain ⟨W, hW, hyW⟩ := (t.mem_chartOpen_iff U).mp hy
    let p : (W : t.X'.Opens).toScheme := ⟨y, hyW⟩
    exact ⟨hW.toChart p, (Scheme.Hom.comp_apply _ _ p).symm.trans
      (congrArg (fun φ => φ p) (hW.toChart_chart ha))⟩

/-- (f) The opens `V_a`, `a ∈ B(U)`, cover `f⁻¹(U)`. -/
@[blueprint "compat:blowup-charts-cover"
  (statement := /-- In the situation of \cref{compat:blowup-chart-open-immersion}, the opens
    $V_a$, $a\in B(U)$, cover $f^{-1}(U)$. -/)
  (proof := /-- Near $y\in f^{-1}(U)$ the ideal of $f^{-1}(B)$ is generated by a
    non-zero-divisor $s$, and the images of the $i\in I$ are the multiples $s u_i$. If no $u_i$
    were a unit at $y$, then $s\in s\,\mathfrak m_y$, i.e.\ $(1-m)s=0$ with $m\in\mathfrak m_y$,
    contradicting that $s$ is a non-zero-divisor. -/)
  (latexEnv := "lemma")]
theorem exists_mem_chartOpen {y : t.X'} (hy : t.f y ∈ U.1) :
    ∃ a ∈ B.ideal U, y ∈ t.chartOpen U a := by
  obtain ⟨W₀, hyW₀, s, hs, hsnzd⟩ := t.invertible y
  change t.exceptional.ideal W₀ = _ at hs
  obtain ⟨r, hrle, hyr⟩ := (isAffineOpen_of_mem_affineOpens W₀).exists_basicOpen_le
    (V := t.f ⁻¹ᵁ U) ⟨y, hy⟩ hyW₀
  have hs₁ := ideal_affBasicOpen_eq_span _ hs r
  have hs₁nzd := res_basicOpen_mem_nonZeroDivisors W₀ hsnzd r
  set s₁ := t.X'.presheaf.map (homOfLE (t.X'.basicOpen_le r)).op s
  have hW₁U : ((affBasicOpen W₀ r : t.X'.affineOpens) : t.X'.Opens) ≤ t.f ⁻¹ᵁ U := hrle
  have hid : t.exceptional.ideal (affBasicOpen W₀ r) =
      (B.ideal U).map (t.f.appLE U _ hW₁U).hom :=
    ideal_comap_eq_map_appLE t.f B U _ hW₁U
  by_contra hcon
  simp only [not_exists, not_and] at hcon
  set 𝔪 := (IsLocalRing.maximalIdeal (t.X'.presheaf.stalk y)).comap
    (t.X'.presheaf.germ (t.X'.basicOpen r) y hyr).hom
  have hle : (B.ideal U).map (t.f.appLE U _ hW₁U).hom ≤ Ideal.span {s₁} * 𝔪 := by
    rw [Ideal.map_le_iff_le_comap]
    intro i hi
    have : t.f.appLE U _ hW₁U i ∈ t.exceptional.ideal (affBasicOpen W₀ r) :=
      hid ▸ Ideal.mem_map_of_mem _ hi
    rw [hs₁, Ideal.mem_span_singleton'] at this
    obtain ⟨u, hu⟩ := this
    rw [Ideal.mem_comap, ← hu, mul_comm u s₁]
    refine Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) ?_
    by_contra hu'
    have hunit : IsUnit (t.X'.presheaf.germ (t.X'.basicOpen r) y hyr u) := by
      simpa [𝔪, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using hu'
    exact hcon i hi ((t.mem_chartOpen_iff U).mpr ⟨_, isChartDomain_basicOpen t U hW₁U hs₁
      hs₁nzd (by rw [← hu, mul_comm]), (Scheme.mem_basicOpen _ _ _ hyr).mpr hunit⟩)
  have hs₁mem : s₁ ∈ Ideal.span {s₁} * 𝔪 := by
    apply hle
    rw [← hid, hs₁]
    exact Ideal.mem_span_singleton_self _
  obtain ⟨m, hm, hsm⟩ := Ideal.mem_span_singleton_mul.mp hs₁mem
  have h1 : (1 - m) * s₁ = 0 := by linear_combination -hsm
  rw [mul_right_mem_nonZeroDivisors_eq_zero_iff hs₁nzd, sub_eq_zero] at h1
  rw [← h1] at hm
  simp [𝔪] at hm

end MonoidalTransformation

/-! ### Stage 3: stalks -/

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X} (t : MonoidalTransformation X B)

/-- The composite `Γ(X, U) → O_{X, f z'} → O_{X', z'} → O_{Spec, z} → Γ(X,U)[I/a]_z` along a
chart is the localization map. -/
theorem germ_stalkMap_chart_stalkIso {U : X.affineOpens} {a : Γ(X, U)} (ha : a ∈ B.ideal U)
    (z : PrimeSpectrum (chartRing B U a)) (hz : t.f (t.chart U ha z) ∈ U.1) :
    X.presheaf.germ U (t.f (t.chart U ha z)) hz ≫ t.f.stalkMap (t.chart U ha z) ≫
      (t.chart U ha).stalkMap z ≫ (Spec.stalkIso (chartRing B U a) z).hom =
        chartAlgebraMap B U a ≫
          CommRingCat.ofHom (algebraMap _ (Localization.AtPrime z.asIdeal)) := by
  have h1 := appLE_germ t.f U (t.f ⁻¹ᵁ U) le_rfl (t.chart U ha z) hz hz
  have h2 := appLE_germ_stalkMap (t.chart U ha) t.f U (t.f ⁻¹ᵁ U) le_rfl z hz _ (t.chart_f U ha)
    (chartToBase_preimage B U a).ge
  rw [chartToBase_appLE] at h2
  rw [← Category.assoc, ← h1, Category.assoc, reassoc_of% h2]
  simp only [Spec.germ_stalkMapIso_hom, Iso.inv_hom_id_assoc]

/-- **Stage 3.** The local ring of `X'` at any point `y` is the localization of a chart algebra
`Γ(X, U)[I/a]` at a prime, compatibly with the maps from `Γ(X, U)` (p. 169: "the local ring
`O_{x'}` of `X'` at `x'` is a ring of fractions of `A = O_x[z_{r+1}/z_t, …, z_s/z_t]` for some
`t`").

Deviation from the paper (statement modified): weaker than p. 169 (`a` is any element of `I`,
not a member `z_t` of a regular system of parameters adapted to `B`, and the base is `Γ(X, U)`
rather than `O_x`).  The form of p. 169 is `DatumTransform.exists_chart_ringOfFractions`
(`Hironaka/Ch1/ResolutionData.lean`, downstream of this file; blueprint node
`compat:blowup-stalk-chart-printed`). -/
@[blueprint "compat:blowup-stalk-chart"
  (statement := /-- Let $f\colon X'\to X$ be a monoidal transformation with center $B$ and
    $y\in X'$. There are an affine open $U=\operatorname{Spec}A$ of $X$ containing $f(y)$, an
    element $a\in I=B(U)$ and a prime $\mathfrak q$ of $A[I/a]$ such that
    $\mathcal O_{X',y}\cong A[I/a]_{\mathfrak q}$ compatibly with the maps from $A$. (Used on
    p.~169: ``$\mathcal O_{x'}$ is a ring of fractions of
    $A=\mathcal O_x[z_{r+1}/z_t,\dots,z_s/z_t]$ for some $t$''.)
    \textbf{Deviation from the paper (statement modified).} This is weaker than the p.~169
    assertion: $a$ is some element of $I$, not a member $z_t$ of a regular system of parameters
    adapted to $B$, and the base is $\Gamma(U,\mathcal O_X)$ rather than $\mathcal O_x$; the
    p.~169 form needs in addition the p.~209 statement that a monoidal transform can be
    written with $x$ a member of a minimal base of $P$; it is
    \cref{compat:blowup-stalk-chart-printed}. -/)
  (proof := /-- Choose $U\ni f(y)$ affine and, by \cref{compat:blowup-charts-cover}, $a\in I$ with
    $y\in V_a$; by \cref{compat:blowup-chart-open-immersion} the chart is an open immersion onto
    $V_a$, so it induces an isomorphism of local rings. -/)
  (latexEnv := "lemma")]
theorem exists_stalk_ringEquiv_localization (y : t.X') :
    ∃ (U : X.affineOpens) (hy : t.f y ∈ U.1) (a : Γ(X, U)) (_ : a ∈ B.ideal U)
      (q : PrimeSpectrum (chartAlgebra (B.ideal U) a))
      (e : t.X'.presheaf.stalk y ≃+* Localization.AtPrime q.asIdeal),
      ∀ r : Γ(X, U), e (t.f.stalkMap y (X.presheaf.germ U (t.f y) hy r)) =
        algebraMap (chartAlgebra (B.ideal U) a) (Localization.AtPrime q.asIdeal)
          (algebraMap Γ(X, U) (chartAlgebra (B.ideal U) a) r) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (t.f y)) isOpen_univ
  obtain ⟨a, ha, hya⟩ := t.exists_mem_chartOpen ⟨U, hU⟩ hyU
  obtain ⟨z, rfl⟩ : y ∈ Set.range (t.chart _ ha) := by
    rw [t.range_chart _ ha]; exact hya
  have := t.isOpenImmersion_chart _ ha
  refine ⟨⟨U, hU⟩, hyU, a, ha, z, (asIso ((t.chart _ ha).stalkMap z) ≪≫
    Spec.stalkIso _ z).commRingCatIsoToRingEquiv, fun r => ?_⟩
  change (X.presheaf.germ U _ hyU ≫ t.f.stalkMap _ ≫ (t.chart _ ha).stalkMap z ≫
    (Spec.stalkIso _ z).hom) r = _
  rw [t.germ_stalkMap_chart_stalkIso ha z hyU]
  rfl

/-- On `V_a`, the stalk of the exceptional ideal is generated by the germ of `a`. -/
theorem stalkIdeal_exceptional_of_mem_chartOpen {U : X.affineOpens} {a : Γ(X, U)} {y : t.X'}
    (hy : y ∈ t.chartOpen U a) (hfy : t.f y ∈ U.1) :
    t.exceptional.stalkIdeal y =
      Ideal.span {t.f.stalkMap y (X.presheaf.germ U (t.f y) hfy a)} := by
  obtain ⟨W, ⟨h, hid, -⟩, hyW⟩ := (t.mem_chartOpen_iff U).mp hy
  rw [stalkIdeal_eq_map_germ _ W hyW, hid, Ideal.map_span, Set.image_singleton,
    ← CommRingCat.comp_apply, appLE_germ t.f U W h y hyW hfy, CommRingCat.comp_apply]

end MonoidalTransformation

/-! ### Stage 4: the bridge to Ch. III §2 -/

section Bridge

open IsLocalRing

variable {A : Type u} [CommRing A] {I : Ideal A} {a : A}
  {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] [Algebra A R]

/-- The canonical map `A[I/a] → R[a⁻¹P]` for `R` an `A`-algebra and `P = IR` (`a ≠ 0` in the
domain `R`): `i/a ↦ i/a`. -/
theorem exists_chartAlgebra_toBlowup (ha0 : algebraMap A R a ≠ 0) :
    ∃ φ : chartAlgebra I a →+* blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a),
      φ.comp (algebraMap A _) = (algebraMap R _).comp (algebraMap A R) := by
  have hK : algebraMap R (FractionRing R) (algebraMap A R a) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr ha0
  apply chartAlgebra.exists_ringHom
  · apply mem_nonZeroDivisors_of_ne_zero
    intro h
    apply hK
    have := congrArg (fun z : blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a) =>
      (z : FractionRing R)) h
    simpa using this
  · intro i hi
    refine ⟨⟨algebraMap R (FractionRing R) (algebraMap A R i) /
      algebraMap R (FractionRing R) (algebraMap A R a),
      Algebra.subset_adjoin ⟨_, Ideal.mem_map_of_mem _ hi, rfl⟩⟩, ?_⟩
    apply Subtype.ext
    simp only [RingHom.coe_comp, Function.comp_apply, MulMemClass.coe_mul,
      Subalgebra.coe_algebraMap]
    field_simp

/-- The value of the map `A[I/a] → R[P/a]` on `b/aⁿ`. -/
theorem chartAlgebra_toBlowup_apply
    (φ : chartAlgebra I a →+* blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a))
    (hφ : φ.comp (algebraMap A _) = (algebraMap R _).comp (algebraMap A R))
    (w : chartAlgebra I a) (n : ℕ) (b : A)
    (hw : (w : Localization.Away a) = algebraMap A _ b * IsLocalization.Away.invSelf a ^ n) :
    ((φ w : blowupAlgebra R _ _) : FractionRing R) *
        algebraMap R (FractionRing R) (algebraMap A R a) ^ n =
      algebraMap R (FractionRing R) (algebraMap A R b) := by
  have h1 : algebraMap A (chartAlgebra I a) a ^ n * w = algebraMap A (chartAlgebra I a) b := by
    apply Subtype.ext
    change algebraMap A (Localization.Away a) a ^ n * (w : Localization.Away a) =
      algebraMap A (Localization.Away a) b
    rw [hw, mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
  have h2 := congrArg φ h1
  rw [map_mul, map_pow] at h2
  have e : ∀ c : A, φ (algebraMap A _ c) = algebraMap R _ (algebraMap A R c) := fun c =>
    RingHom.congr_fun hφ c
  rw [e, e] at h2
  have h3 := congrArg (fun z : blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a) =>
      (z : FractionRing R)) h2
  simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, Subalgebra.coe_algebraMap] at h3
  rw [mul_comm]
  exact h3

/-- If `R = A_p`, then `R[a⁻¹P]`, `P = IR`, is the localization of `A[I/a]` at the image of
`A − p`. -/
theorem isLocalization_chartAlgebra_toBlowup (ha : a ∈ I) (ha0 : algebraMap A R a ≠ 0)
    (p : Ideal A) [p.IsPrime] [IsLocalization.AtPrime R p]
    (φ : chartAlgebra I a →+* blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a))
    (hφ : φ.comp (algebraMap A _) = (algebraMap R _).comp (algebraMap A R)) :
    letI := φ.toAlgebra
    IsLocalization (p.primeCompl.map (algebraMap A (chartAlgebra I a)))
      (blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a)) := by
  let := φ.toAlgebra
  have e : ∀ c : A, φ (algebraMap A _ c) = algebraMap R _ (algebraMap A R c) := fun c =>
    RingHom.congr_fun hφ c
  have hK : algebraMap R (FractionRing R) (algebraMap A R a) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr ha0
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, s, hs, rfl⟩
    change IsUnit (φ (algebraMap A _ s))
    rw [e]
    exact (IsLocalization.map_units R (⟨s, hs⟩ : p.primeCompl)).map _
  · rintro ⟨z, hz⟩
    suffices H : ∃ (w : chartAlgebra I a) (s : A), s ∈ p.primeCompl ∧
        z * algebraMap R (FractionRing R) (algebraMap A R s) = (φ w : FractionRing R) by
      obtain ⟨w, s, hs, h⟩ := H
      refine ⟨⟨w, ⟨algebraMap A _ s, s, hs, rfl⟩⟩, Subtype.ext ?_⟩
      change z * ((φ (algebraMap A _ s) : blowupAlgebra R _ _) : FractionRing R) = _
      rw [e]
      exact h
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨p', hp', rfl⟩ := hx
      obtain ⟨⟨⟨i, hi⟩, ⟨s, hs⟩⟩, hps⟩ :=
        (IsLocalization.mem_map_algebraMap_iff p.primeCompl R).mp hp'
      simp only at hps
      refine ⟨chartAlgebra.frac hi, s, hs, ?_⟩
      have h1 := chartAlgebra_toBlowup_apply φ hφ (chartAlgebra.frac hi) 1 i
        (by rw [pow_one]; rfl)
      rw [pow_one] at h1
      simp only
      rw [(eq_div_iff hK).mpr h1, ← hps, map_mul]
      ring
    | algebraMap r =>
      obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl r
      refine ⟨algebraMap A _ c, s, s.2, ?_⟩
      rw [e]
      simp only [Subalgebra.coe_algebraMap]
      rw [← map_mul, IsLocalization.mk'_spec]
    | add x y _ _ hx hy =>
      obtain ⟨w₁, s₁, hs₁, h₁⟩ := hx
      obtain ⟨w₂, s₂, hs₂, h₂⟩ := hy
      refine ⟨w₁ * algebraMap A _ s₂ + w₂ * algebraMap A _ s₁, s₁ * s₂,
        p.primeCompl.mul_mem hs₁ hs₂, ?_⟩
      simp only [map_add, map_mul, e, Subalgebra.coe_add, MulMemClass.coe_mul,
        Subalgebra.coe_algebraMap, ← h₁, ← h₂]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨w₁, s₁, hs₁, h₁⟩ := hx
      obtain ⟨w₂, s₂, hs₂, h₂⟩ := hy
      refine ⟨w₁ * w₂, s₁ * s₂, p.primeCompl.mul_mem hs₁ hs₂, ?_⟩
      simp only [map_mul, MulMemClass.coe_mul, ← h₁, ← h₂]
      ring
  · intro x y hxy
    have hw : φ (x - y) = 0 := by rw [map_sub]; exact sub_eq_zero.mpr hxy
    obtain ⟨n, b, -, hb⟩ := (mem_chartAlgebra_iff ha).mp (x - y).2
    have h1 := chartAlgebra_toBlowup_apply φ hφ (x - y) n b hb
    rw [hw] at h1
    simp only [ZeroMemClass.coe_zero, zero_mul] at h1
    have h2 : algebraMap A R b = 0 :=
      IsFractionRing.injective R (FractionRing R) (by rw [← h1, map_zero])
    obtain ⟨⟨m, hm⟩, hmb⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl R b).mp h2
    refine ⟨⟨algebraMap A _ m, m, hm, rfl⟩, ?_⟩
    rw [← sub_eq_zero, ← mul_sub]
    apply Subtype.ext
    change algebraMap A (Localization.Away a) m *
      ((x - y : chartAlgebra I a) : Localization.Away a) = 0
    rw [hb, ← mul_assoc, ← map_mul, hmb, map_zero, zero_mul]

/-- If `R[x⁻¹P]` is the localization of a ring `C` at `M` (through `φ`), then the monoidal
transform `R' = R[x⁻¹P]_{M'}` is the localization of `C` at the prime `M' ∩ C`. -/
theorem MonoidalTransform.exists_ringEquiv_of_isLocalization {C : Type u} [CommRing C]
    {P : Ideal R} (t : MonoidalTransform R P) (φ : C →+* blowupAlgebra R P t.x)
    (M : Submonoid C) (hloc : letI := φ.toAlgebra; IsLocalization M (blowupAlgebra R P t.x))
    (q : Ideal C) [q.IsPrime] (hq : t.M'.comap φ = q) :
    ∃ e : Localization.AtPrime q ≃+* t.ring, ∀ w : C,
      e (algebraMap C (Localization.AtPrime q) w) =
        algebraMap (blowupAlgebra R P t.x) t.ring (φ w) := by
  let := φ.toAlgebra
  let : Algebra C t.ring := ((algebraMap (blowupAlgebra R P t.x) t.ring).comp φ).toAlgebra
  have : IsScalarTower C (blowupAlgebra R P t.x) t.ring :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have h2 := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M t.ring t.M'
  have h3 : IsLocalization.AtPrime t.ring q := by
    convert h2
    exact hq.symm
  exact ⟨(IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) t.ring).toRingEquiv,
    fun w => (IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) t.ring).commutes w⟩

/-- **Algebraic bridge.** The localization of a chart algebra `A[I/a]` at a prime `q` over `p`
is a monoidal transform of `R = A_p` with center `P = IR`. -/
@[blueprint "compat:blowup-chart-monoidal-transform"
  (statement := /-- Let $A$ be a ring, $I$ an ideal, $a\in I$, $\mathfrak q$ a prime of
    $A[I/a]$ and $\mathfrak p=\mathfrak q\cap A$. Suppose that $R=A_{\mathfrak p}$ is a regular
    local ring and $a\neq0$ in $R$, and put $P=IR$. Then $A[I/a]_{\mathfrak q}$ is, compatibly
    with the maps from $A$, a monoidal transform of $R$ with center $P$ in the sense of
    \cref{def:III.2-monoidal-transform}, namely the localization of $R[a^{-1}P]$ at a prime
    containing the maximal ideal of $R$. -/)
  (proof := /-- $R[a^{-1}P]$ is the localization of $A[I/a]$ at the image of $A-\mathfrak p$
    (every element of $R[a^{-1}P]$ is $b/(a^ns)$ with $b\in I^n$, $s\notin\mathfrak p$, and an
    element of $A[I/a]$ which vanishes in $R[a^{-1}P]$ is killed by some $s\notin\mathfrak p$).
    The prime $\mathfrak q$ is disjoint from $A-\mathfrak p$, so it extends to a prime $M'$ of
    $R[a^{-1}P]$ with $M'\cap A[I/a]=\mathfrak q$, and $M'\supseteq\mathfrak pR[a^{-1}P]$, which
    is the maximal ideal of $R$ times $R[a^{-1}P]$. Localizing a localization,
    $R[a^{-1}P]_{M'}=A[I/a]_{\mathfrak q}$. -/)
  (latexEnv := "lemma")]
theorem exists_monoidalTransform_of_chart (ha : a ∈ I) (q : Ideal (chartAlgebra I a)) [q.IsPrime]
    (p : Ideal A) [p.IsPrime] [IsLocalization.AtPrime R p]
    (hqp : q.comap (algebraMap A (chartAlgebra I a)) = p)
    (P : Ideal R) (hP : I.map (algebraMap A R) = P) (ha0 : algebraMap A R a ≠ 0) :
    ∃ (s : MonoidalTransform R P) (e : Localization.AtPrime q ≃+* s.ring),
      s.x = algebraMap A R a ∧
      ∀ c : A, e (algebraMap (chartAlgebra I a) (Localization.AtPrime q)
        (algebraMap A (chartAlgebra I a) c)) = s.toRing (algebraMap A R c) := by
  subst hP
  obtain ⟨φ, hφ⟩ := exists_chartAlgebra_toBlowup (I := I) ha0
  let := φ.toAlgebra
  have hloc := isLocalization_chartAlgebra_toBlowup ha ha0 p φ hφ
  set M := p.primeCompl.map (algebraMap A (chartAlgebra I a)) with hMdef
  have hdisj : Disjoint (M : Set (chartAlgebra I a)) (q : Set (chartAlgebra I a)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨s, hs, rfl⟩ hsq
    exact hs (hqp ▸ hsq)
  set M' := q.map (algebraMap (chartAlgebra I a)
    (blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a))) with hM'def
  have hM'prime : M'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M _ q ‹_› hdisj
  have hM'comap : M'.comap (algebraMap _ _) = q :=
    IsLocalization.under_map_of_isPrime_disjoint M _ ‹_› hdisj
  have hle : (maximalIdeal R).map (algebraMap R
      (blowupAlgebra R (I.map (algebraMap A R)) (algebraMap A R a))) ≤ M' := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p R, Ideal.map_map, ← hφ, ← Ideal.map_map]
    exact Ideal.map_mono (Ideal.map_le_iff_le_comap.mpr hqp.ge)
  let s : MonoidalTransform R (I.map (algebraMap A R)) :=
    { x := algebraMap A R a
      x_mem := Ideal.mem_map_of_mem _ ha
      x_ne_zero := ha0
      M' := M'
      isPrime := hM'prime
      le := hle }
  obtain ⟨e, he⟩ := MonoidalTransform.exists_ringEquiv_of_isLocalization s φ M hloc q
    hM'comap
  refine ⟨s, e, rfl, fun c => ?_⟩
  rw [he]
  have := RingHom.congr_fun hφ c
  simp only [RingHom.coe_comp, Function.comp_apply] at this
  rw [this]
  rfl

/-- p. 209: "it is convenient to include the case in which `P = R`. In this case, the monoidal
transform of `R` is canonically isomorphic to `R`": for `P = R` the canonical map `R → R'` is
bijective. -/
@[blueprint "compat:monoidal-transform-unit-center"
  (statement := /-- Let $R'$ be a monoidal transform of the regular local ring $R$ with center
    $P=R$ (\cref{def:III.2-monoidal-transform}). Then the canonical homomorphism $R\to R'$ is an
    isomorphism. (p.~209: ``In this case, the monoidal transform of $R$ is canonically
    isomorphic to $R$.'') -/)
  (proof := /-- If $R'$ is the localization of $R[x^{-1}R]$ at $M'\supseteq MR[x^{-1}R]$, then $x$
    is a unit of $R$: otherwise $x\in M'$ while $x$ is invertible in $R[x^{-1}R]$. Hence
    $R[x^{-1}R]=R$, $M'$ is the maximal ideal, and localizing a local ring at its maximal ideal
    does nothing. -/)
  (latexEnv := "lemma")]
theorem MonoidalTransform.bijective_toRing_of_eq_top {P : Ideal R} (s : MonoidalTransform R P)
    (hP : P = ⊤) : Function.Bijective s.toRing := by
  subst hP
  have hxK : algebraMap R (FractionRing R) s.x ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr s.x_ne_zero
  -- `x` is a unit of `R`, since `1/x ∈ R[x⁻¹R]` and `x ∈ M'` otherwise
  have hxu : IsUnit s.x := by
    by_contra hx
    have hxm : s.x ∈ maximalIdeal R := (mem_maximalIdeal _).mpr hx
    have h1 : algebraMap R (blowupAlgebra R ⊤ s.x) s.x ∈ s.M' :=
      s.le (Ideal.mem_map_of_mem _ hxm)
    have hinv : (⟨algebraMap R (FractionRing R) 1 / algebraMap R (FractionRing R) s.x,
        Algebra.subset_adjoin ⟨1, trivial, rfl⟩⟩ : blowupAlgebra R ⊤ s.x) *
          algebraMap R _ s.x = 1 := by
      apply Subtype.ext
      simp only [map_one, MulMemClass.coe_mul, Subalgebra.coe_algebraMap, OneMemClass.coe_one]
      field_simp
    exact s.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1
      (IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact hinv)))
  -- hence `R[x⁻¹R] = R`
  have hsurj : Function.Surjective (algebraMap R (blowupAlgebra R ⊤ s.x)) := by
    rintro ⟨z, hz⟩
    have hle : blowupAlgebra R ⊤ s.x ≤ ⊥ := by
      refine Algebra.adjoin_le ?_
      rintro _ ⟨p, -, rfl⟩
      refine Algebra.mem_bot.mpr ⟨p * ↑hxu.unit⁻¹, ?_⟩
      rw [map_mul, eq_div_iff hxK, mul_assoc, ← map_mul, IsUnit.val_inv_mul, map_one, mul_one]
    obtain ⟨r, hr⟩ := Algebra.mem_bot.mp (hle hz)
    exact ⟨r, Subtype.ext hr⟩
  have hinj : Function.Injective (algebraMap R (blowupAlgebra R ⊤ s.x)) := fun a b h =>
    IsFractionRing.injective R (FractionRing R) (congrArg Subtype.val h)
  -- and every element outside `M'` is a unit, so `R' = R[x⁻¹R]_{M'} = R`
  have hunits : s.M'.primeCompl ≤ IsUnit.submonoid _ := by
    intro b hb
    obtain ⟨r, rfl⟩ := hsurj b
    have hr : r ∉ maximalIdeal R := fun h => hb (s.le (Ideal.mem_map_of_mem _ h))
    rw [mem_maximalIdeal, mem_nonunits_iff, not_not] at hr
    exact hr.map _
  have hbij : Function.Bijective (algebraMap (blowupAlgebra R ⊤ s.x) s.ring) :=
    (IsLocalization.atUnits _ s.M'.primeCompl (S := s.ring) hunits).bijective
  exact hbij.comp ⟨hinj, hsurj⟩

end Bridge

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X} (t : MonoidalTransformation X B)

/-- **Stage 4 (the bridge).** p. 214: "Let `y'` be any point of `X'`, `y = f(y')`, `R` the local
ring of `X` at `y`, `R'` the local ring of `X'` at `y'`, and `P` the ideal in `R` which defines
the subscheme `B` of `X`. Then we see that `R'` is a monoidal transform of `R` with center `P`."
The monoidal transform `s` of `R` with center `P` (Ch. III §2, p. 209) comes with an isomorphism
`s.ring ≃ O_{X', y'}` under `R`.  Only the regularity of `X` at `f(y')` is needed (it is part of
the definition of monoidal transforms); for `f(y') ∉ B` the center is `P = R`.

Deviation from the paper (gap filled): p. 214 asserts this without argument ("we see"). -/
@[blueprint "compat:blowup-stalk-monoidal-transform"
  (statement := /-- Let $f\colon X'\to X$ be a monoidal transformation with center $B$
    (\cref{def:monoidal-transformation}), $y'\in X'$, $y=f(y')$, and suppose that
    $R=\mathcal O_{X,y}$ is regular. Let $P=B_y$ be the ideal of $B$ in $R$. Then
    $R'=\mathcal O_{X',y'}$ is, over $R$, a monoidal transform of $R$ with center $P$
    (\cref{def:III.2-monoidal-transform}; $P=R$ if $y\notin B$). (p.~214: ``we see that $R'$
    is a monoidal transform of $R$ with center $P$''; p.~169.) -/)
  (proof := /-- By \cref{compat:blowup-stalk-chart},
    $R'\cong A[I/a]_{\mathfrak q}$ over $A=\Gamma(U,\mathcal O_X)$; since $R\to R'$ is local,
    $\mathfrak q\cap A$ is the prime $\mathfrak p$ of $y$, so $R=A_{\mathfrak p}$ and $P=IR$. The
    element $a$ is non-zero in $R$ because its image generates the invertible ideal of
    $f^{-1}(B)$ at $y'$. Conclude by \cref{compat:blowup-chart-monoidal-transform}.
    \textbf{Gap in the paper filled.} The paper asserts this without argument (p.~214, ``we
    see''); the charts are built here from the universal mapping property alone. The statement
    uses the notion of monoidal transform of \cref{def:III.2-monoidal-transform} with an
    arbitrary center $P$; for $B$ non-singular at $y$ it is the paper's notion (p.~209: $P$
    prime with $R/P$ regular, or $P=R$). -/)
  (latexEnv := "lemma")]
theorem exists_monoidalTransform_stalk (y : t.X') [IsRegularLocalRing (X.presheaf.stalk (t.f y))]
    [IsDomain (X.presheaf.stalk (t.f y))] :
    ∃ (s : MonoidalTransform (X.presheaf.stalk (t.f y)) (B.stalkIdeal (t.f y)))
      (e : s.ring ≃+* t.X'.presheaf.stalk y),
      e.toRingHom.comp s.toRing = (t.f.stalkMap y).hom := by
  obtain ⟨U, hy, a, ha, q, e1, he1⟩ := t.exists_stalk_ringEquiv_localization y
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨t.f y, hy⟩ : (U : X.Opens))
  have hloc := U.2.isLocalization_stalk ⟨t.f y, hy⟩
  set p := (U.2.primeIdealOf ⟨t.f y, hy⟩).asIdeal with hpdef
  have hcomp : (algebraMap (chartAlgebra (B.ideal U) a) (Localization.AtPrime q.asIdeal)).comp
      (algebraMap Γ(X, U) _) = (e1.toRingHom.comp (t.f.stalkMap y).hom).comp
        (algebraMap Γ(X, U) (X.presheaf.stalk (t.f y))) := by
    ext r
    exact (he1 r).symm
  have : IsLocalHom e1.toRingHom := ⟨fun x hx => by simpa using hx.map e1.symm.toRingHom⟩
  have hqp : q.asIdeal.comap (algebraMap Γ(X, U) (chartAlgebra (B.ideal U) a)) = p := by
    rw [← IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime q.asIdeal) q.asIdeal,
      Ideal.under, Ideal.comap_comap, hcomp, ← Ideal.comap_comap, ← Ideal.comap_comap,
      IsLocalRing.maximalIdeal_comap, IsLocalRing.maximalIdeal_comap]
    exact IsLocalization.AtPrime.under_maximalIdeal _ p
  have hP : (B.ideal U).map (algebraMap Γ(X, U) (X.presheaf.stalk (t.f y))) =
      B.stalkIdeal (t.f y) := (stalkIdeal_eq_map_germ B U hy).symm
  have ha0 : algebraMap Γ(X, U) (X.presheaf.stalk (t.f y)) a ≠ 0 := by
    intro h0
    have h1 := RingHom.congr_fun hcomp a
    simp only [RingHom.coe_comp, Function.comp_apply, h0, map_zero] at h1
    exact nonZeroDivisors.ne_zero
      (algebraMap_mem_nonZeroDivisors_chartAlgebra_localization
        (S := Localization.AtPrime q.asIdeal) q.asIdeal.primeCompl) h1
  obtain ⟨s, e2, -, he2⟩ := exists_monoidalTransform_of_chart ha q.asIdeal p hqp _ hP ha0
  refine ⟨s, e2.symm.trans e1.symm, ?_⟩
  apply IsLocalization.ringHom_ext p.primeCompl
  ext c
  have h1 := RingHom.congr_fun hcomp c
  simp only [RingHom.coe_comp, Function.comp_apply] at h1
  simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, RingEquiv.trans_apply]
  rw [← he2 c, RingEquiv.symm_apply_apply, h1]
  exact e1.symm_apply_apply _

/-- The stalk at `y` of the total transform of `J` is `J_{f y} R'`, transported to `O_{X', y}`. -/
theorem stalkIdeal_totalTransform_eq_map (y : t.X') [IsRegularLocalRing (X.presheaf.stalk (t.f y))]
    [IsDomain (X.presheaf.stalk (t.f y))] {P : Ideal (X.presheaf.stalk (t.f y))}
    (s : MonoidalTransform (X.presheaf.stalk (t.f y)) P) (e : s.ring ≃+* t.X'.presheaf.stalk y)
    (he : e.toRingHom.comp s.toRing = (t.f.stalkMap y).hom) (J : Subscheme X) :
    (Subscheme.totalTransform t.f J).stalkIdeal y = ((J.stalkIdeal (t.f y)).map s.toRing).map e := by
  rw [stalkIdeal_totalTransform, ← he]
  exact (Ideal.map_map _ _).symm

/-- Where `f y ∉ B`, the monoidal transformation is a local isomorphism at `y` (p. 209, the case
`P = R`; `X` regular at `f y`).

Deviation from the paper (statement modified): p. 167 asserts that `f` is an isomorphism over
`X − B` for any `X`; this is the stalk version, with a regularity hypothesis that is an artefact
of the proof.  The printed statement is `MonoidalTransformation.isIso_morphismRestrict_complOpens` (the
restriction of `f` over `X − B` is an isomorphism, for any `X`) and its stalk form
`MonoidalTransformation.bijective_stalkMap_of_notMem_pts`, both in `Hironaka/Compat/BlowupLocalIso.lean`
(downstream of this file). -/
@[blueprint "compat:blowup-local-iso"
  (statement := /-- Let $f\colon X'\to X$ be a monoidal transformation with center $B$ and
    $y'\in X'$ with $y=f(y')\notin B$, $X$ regular at $y$. Then
    $\mathcal O_{X,y}\to\mathcal O_{X',y'}$ is an isomorphism.
    \textbf{Deviation from the paper (statement modified).} p.~167 asserts, for any $X$, that
    $f$ ``induces an isomorphism of $X'-f^{-1}(B)$ to $X-B$''; this lemma gives only the
    stalk version and assumes $X$ regular at $y$ (an artefact of the proof). The printed
    statement is \cref{compat:blowup-local-iso-open} (by flat base change to $X-B$), with the
    stalk form \cref{compat:blowup-local-iso-stalk}. -/)
  (proof := /-- By \cref{compat:blowup-stalk-monoidal-transform}, $\mathcal O_{X',y'}$ is a
    monoidal transform of $\mathcal O_{X,y}$ with center $B_y=\mathcal O_{X,y}$; apply
    \cref{compat:monoidal-transform-unit-center}. -/)
  (latexEnv := "lemma")]
theorem bijective_stalkMap_of_notMem (y : t.X') (hy : t.f y ∉ B.pts)
    [IsRegularLocalRing (X.presheaf.stalk (t.f y))] :
    Function.Bijective (t.f.stalkMap y) := by
  have := isDomain_of_isRegularLocalRing (X.presheaf.stalk (t.f y))
  obtain ⟨s, e, he⟩ := t.exists_monoidalTransform_stalk y
  have hs := s.bijective_toRing_of_eq_top (Subscheme.stalkIdeal_eq_top_of_notMem_pts hy)
  have : ⇑(t.f.stalkMap y) = ⇑(e.toRingHom.comp s.toRing) := by rw [he]
  rw [this]
  exact e.bijective.comp hs

end MonoidalTransformation

/-! ### Stalks of `f⁻¹(J)·P⁻ᵛ` and of the strict transform -/

/-- Stalks of the division `I·P⁻ᵛ` of Ch. 0 §5 (p. 142) by an invertible sheaf of ideals `P`:
`(I P⁻ᵛ)_x = (I_x : P_xᵛ)`. -/
theorem Subscheme.stalkIdeal_divPow {X : Scheme.{u}} {I P : Subscheme X}
    (hP : P.IsInvertibleIdeal) (ν : ℕ) (x : X) :
    (Subscheme.divPow I P ν).stalkIdeal x =
      (I.stalkIdeal x).colon ((P.stalkIdeal x ^ ν : Ideal _) : Set (X.presheaf.stalk x)) :=
  Subscheme.stalkIdeal_sSup_mul_pow_le hP ν x

end Hironaka


/-!
# A monoidal transformation of a projective `B`-scheme is projective (for the Corollary of Main Theorem I, p. 132)

The Corollary on p. 132 ("an immediate consequence of our main theorem I") needs that the non-singular model obtained
from a projective model by a finite succession of monoidal transformations is again projective, i.e. of the form
`Proj(H)` with `H` a graded quotient of a polynomial ring over `B`.  The paper cites for blow-ups only p. 166:
"taking as `V'` the projective scheme `Proj(S(I))` over `V` (cf. §3, Ch. II of Grothendieck [6])"; the composition of
projective morphisms (EGA II 5.5.5) and the equivalence of the two definitions of "projective" (pp. 126–127 and p. 132)
are not cited.  So this lemma is proved here, not cited.

Proof (steps L1a–L1e, all proved): the presentation of `X` is replaced by a homogeneous prime (`Compat/ProjectivePrimePresentation`,
R0); the monoidal transformation is transported to `Proj H` (`MonoidalTransformation.transport`); with the forms `g_a` of
`Compat/ProjectiveIdealForms` (L1a) and the ring `H'` of `Compat/BlowupProjectiveRing` (L1b) the charts of the blow-up
(`Compat/BlowupCharts`) are compared with the charts of `Proj H'` (`Compat/BlowupProjectiveMaps`, L1c) and glued to an
isomorphism `Proj H' ≅ X'` (`Compat/BlowupProjectiveIso`, L1d).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

namespace Hironaka

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace MonoidalTransformation

/-- Transport of a monoidal transformation along an isomorphism `ι : X ≅ Y` of the base: the center becomes
`D.comap ι.inv`. -/
noncomputable def transport {X Y : Scheme.{u}} {D : Subscheme X} (t : MonoidalTransformation X D) (ι : X ≅ Y) :
    MonoidalTransformation Y (Subscheme.totalTransform ι.inv D) where
  X' := t.X'
  f := t.f ≫ ι.hom
  invertible := by
    have h : Subscheme.totalTransform (t.f ≫ ι.hom) (Subscheme.totalTransform ι.inv D) =
        Subscheme.totalTransform t.f D := by
      rw [← Subscheme.totalTransform_comp]; simp
    rw [h]; exact t.invertible
  universal X'' f'' hf'' := by
    have h : Subscheme.totalTransform (f'' ≫ ι.inv) D =
        Subscheme.totalTransform f'' (Subscheme.totalTransform ι.inv D) :=
      Subscheme.totalTransform_comp _ _ _
    obtain ⟨k, hk, hk'⟩ := t.universal X'' (f'' ≫ ι.inv) (by rw [h]; exact hf'')
    refine ⟨k, ?_, fun k' hk'' => hk' k' ?_⟩
    · show k ≫ t.f ≫ ι.hom = f''
      rw [← Category.assoc, hk]; simp
    · show k' ≫ t.f = f'' ≫ ι.inv
      have : k' ≫ t.f ≫ ι.hom = f'' := hk''
      rw [← this]; simp

end MonoidalTransformation

/-- **A monoidal transformation of an integral projective `B`-scheme is projective** (the unproved, uncited step of the
Corollary on p. 132).  Hypotheses: `X` integral and projective over the field `B`; `t` a monoidal transformation of `X`
with any center `D` and integral total space (which holds at every stage of the successions of Main Theorem I). -/
@[blueprint "lem:0-blowup-projective"
  (statement := /-- Let $X$ be an integral projective $B$-scheme, $D$ a subscheme of $X$ and $f\colon X'\to X$ a monoidal
    transformation with center $D$ and integral total space. Then $X'$ is a projective $B$-scheme.
    (Used in the Corollary on p.~132, ``an immediate consequence of our main theorem I''; the paper cites only that the
    blow-up is $\operatorname{Proj}(S(I))$ over $V$, p.~166.) -/)
  (proof := /-- Replace the presentation of $X$ by a homogeneous prime and transport $t$ to $\operatorname{Proj}H$,
    $H=B[T]/\mathfrak p$. By step L1a the ideal of $D$ on each chart $D_+(u_b)$ is generated by the fractions
    $g_a/u_b^e$ of finitely many forms $g_a\in H_e$. With $y_{ab}=g_au_b$ let $H'\subseteq H$ be the subring generated by the
    $y_{ab}$ (graded by $d\mapsto d(e+1)$), a quotient of a polynomial ring over $B$. The chart $\Gamma(D_+(u_b))[I/\gamma_{ab}]$
    of $t$ (generated by $\gamma_{ab}=g_a/u_b^e$) is isomorphic to $H'_{(y_{ab})}$; the open immersions $\operatorname{Spec}H'_{(y_{ab})}\to X'$
    glue (uniqueness in (ii) of the definition of a monoidal transformation) to a morphism $\operatorname{Proj}H'\to X'$ which is an
    isomorphism over each chart $V_{ab}$ (a section of a separated morphism is a closed immersion, and an open one, into
    an irreducible space), hence an isomorphism. -/)
  (latexEnv := "lemma")]
theorem MonoidalTransformation.isProjectiveOver {B : Type u} [Field B] {X : Scheme.{u}} [IsIntegral X]
    (p : X ⟶ Spec (CommRingCat.of B)) (hp : IsProjectiveOver X p) {D : Subscheme X}
    (t : MonoidalTransformation X D) [IsIntegral t.X'] : IsProjectiveOver t.X' (t.f ≫ p) := by
  obtain ⟨n, 𝔭, h𝔭, e, he⟩ := exists_prime_presentation p hp
  have hdom : IsDomain (MvPolynomial (Fin n) B ⧸ 𝔭.toIdeal) := Ideal.Quotient.isDomain _
  obtain ⟨m, 𝔟, Φ, hΦ⟩ := exists_iso_proj_quotient 𝔭 (t.transport e)
  refine ⟨m, 𝔟, Φ, ?_⟩
  refine hΦ.trans ?_
  show (t.f ≫ e.hom) ≫ projStructure 𝔭 = t.f ≫ p
  rw [Category.assoc, he]

end Hironaka

/-!
# Compatibility layer: points of a monoidal transformation and monoidal transforms of a stalk

Hironaka's proof of Lemma (AB.2), first assertion (p. 295), is "an immediate consequence of Lemma 4,
§2, Ch. III, and its corollaries": the number of monoidal transforms of the local ring of `X̂_s` over
a given monoidal transform of the local ring of `X_s` is at most the separable degree of the residue
field extension (here `1`).  To count *points* of `X̂_{s+1}` by *monoidal transforms* of local rings
one needs two scheme-level facts, which the paper uses without comment:

* (i) every monoidal transform `s` of the local ring `R = O_{Y,y}`, with center the ideal `B_y` of `B`,
  is "the local ring of the blow-up `Y'` at a point over `y`": the morphism `Spec s → Y`, which has
  the invertible pull-back of `B`, lifts to `Y'` by the universal property of the monoidal
  transformation (`MonoidalTransformation.liftOfMonoidalTransform`), and the image of the closed
  point is a point `pointOfMonoidalTransform` of `Y'` over `y`;
* (ii) a point of the blow-up over `y` is determined by its local ring as a monoidal transform
  of `R` (separatedness in the form needed): two points of `Y'` over `y` whose local rings are
  isomorphic over `R` (e.g. which have the same subring of the field of quotients of `R`) are equal
  (`MonoidalTransformation.pointOfMonoidalTransform_eq`, `MonoidalTransformation.eq_of_subring_eq`).

Both follow from the universal mapping property (ii) of p. 166 alone: two morphisms
`Spec s → Y'` with the same composite to `Y` agree because the pull-back of `B` to `Spec s` is
generated by the non-zero element `x` of the domain `s`, hence invertible
(`MonoidalTransformation.hom_ext`).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry IsLocalRing

universe u

/-! ### Stalk maps along an equation of points -/

namespace AlgebraicGeometry.Scheme.Hom

/-- The comorphism of `f` on stalks along an equation `f z = w` of points:
`O_{W,w} → O_{W,f z} → O_{Z,z}`.  (It lets stalks at *propositionally* equal points be compared
without transport of structure.) -/
noncomputable def stalkMapOf {Z W : Scheme.{u}} (f : Z ⟶ W) {z : Z} {w : W} (h : f z = w) :
    W.presheaf.stalk w ⟶ Z.presheaf.stalk z :=
  (W.presheaf.stalkCongr (Inseparable.of_eq h.symm)).hom ≫ f.stalkMap z

@[simp]
theorem stalkMapOf_rfl {Z W : Scheme.{u}} (f : Z ⟶ W) (z : Z) :
    f.stalkMapOf (rfl : f z = f z) = f.stalkMap z := by
  simp [stalkMapOf]

instance isLocalHom_stalkMapOf {Z W : Scheme.{u}} (f : Z ⟶ W) {z : Z} {w : W} (h : f z = w) :
    IsLocalHom (f.stalkMapOf h).hom := by
  subst h
  rw [stalkMapOf_rfl]
  infer_instance

theorem stalkMapOf_comp {Z W V : Scheme.{u}} (f : Z ⟶ W) (g : W ⟶ V) {z : Z} {w : W} {v : V}
    (hf : f z = w) (hg : g w = v) (hfg : (f ≫ g) z = v) :
    (f ≫ g).stalkMapOf hfg = g.stalkMapOf hg ≫ f.stalkMapOf hf := by
  subst hf hg
  rw [stalkMapOf_rfl, stalkMapOf_rfl,
    show (f ≫ g).stalkMapOf hfg = (f ≫ g).stalkMap z from stalkMapOf_rfl (f ≫ g) z,
    Scheme.Hom.stalkMap_comp]

theorem stalkMapOf_congr_hom {Z W : Scheme.{u}} {f g : Z ⟶ W} (e : f = g) {z : Z} {w : W}
    (hf : f z = w) (hg : g z = w) : f.stalkMapOf hf = g.stalkMapOf hg := by
  subst e
  rfl

end AlgebraicGeometry.Scheme.Hom

namespace Hironaka

/-! ### The pull-back of `B` to the spectrum of a domain -/

section SpecStalk

variable {Y : Scheme.{u}}

/-- The pull-back of the ideal sheaf of `B` to `Spec D` along `Spec φ ≫ Y.fromSpecStalk y`, `D` a
domain and `φ : O_{Y,y} → D`, is invertible as soon as the extension to `D` of the stalk ideal of
`B` at `y` is generated by one non-zero element `g`: on the affine scheme `Spec D` the ideal of the
pull-back is generated by `g`, which is a non-zero-divisor in a domain. -/
theorem isInvertibleIdeal_totalTransform_specMap_fromSpecStalk (B : Subscheme Y) (y : Y)
    {D : CommRingCat.{u}} [IsDomain D] (φ : Y.presheaf.stalk y ⟶ D) {g : D} (hg0 : g ≠ 0)
    (hg : (B.stalkIdeal y).map φ.hom = Ideal.span {g}) :
    (Subscheme.totalTransform (Spec.map φ ≫ Y.fromSpecStalk y) B).IsInvertibleIdeal := by
  obtain ⟨U, hxU⟩ := Subscheme.exists_affineOpen_mem y
  have hle : (⊤ : (Spec D).Opens) ≤ (Spec.map φ ≫ Y.fromSpecStalk y) ⁻¹ᵁ U.1 := by
    intro Q _
    have h1 : (Spec.map φ).base Q ⤳ IsLocalRing.closedPoint (Y.presheaf.stalk y) :=
      (PrimeSpectrum.le_iff_specializes (R := Y.presheaf.stalk y) _ _).mp
        (IsLocalRing.le_maximalIdeal ((show PrimeSpectrum (Y.presheaf.stalk y) from
          (Spec.map φ).base Q)).isPrime.ne_top)
    have h2 := h1.map (Y.fromSpecStalk y).continuous
    rw [Scheme.fromSpecStalk_closedPoint] at h2
    exact h2.mem_open U.1.2 hxU
  intro z
  refine ⟨⟨⊤, isAffineOpen_top _⟩, trivial, (Scheme.ΓSpecIso D).inv g, ?_, ?_⟩
  · change (B.comap (Spec.map φ ≫ Y.fromSpecStalk y)).ideal ⟨⊤, isAffineOpen_top _⟩ = _
    rw [ideal_comap_eq_map_appLE _ B U ⟨⊤, isAffineOpen_top _⟩ hle]
    have hcomp : ((Spec.map φ ≫ Y.fromSpecStalk y).appLE U.1 ⊤ hle).hom =
        (Scheme.ΓSpecIso D).inv.hom.comp (φ.hom.comp (Y.presheaf.germ U.1 y hxU).hom) := by
      ext a
      exact appLE_specMap_fromSpecStalk φ U.1 hxU hle a
    rw [hcomp, ← Ideal.map_map, ← Ideal.map_map, ← Subscheme.stalkIdeal_eq_map_germ_affine B U hxU,
      hg, Ideal.map_span, Set.image_singleton]
  · exact iso_hom_mem_nonZeroDivisors (Scheme.ΓSpecIso D).symm (mem_nonZeroDivisors_of_ne_zero hg0)

end SpecStalk


/-! ### Monoidal transforms of a stalk give points of the blow-up -/

namespace MonoidalTransform

variable {Y : Scheme.{u}} {B : Subscheme Y} {y : Y} [IsRegularLocalRing (Y.presheaf.stalk y)]
  [IsDomain (Y.presheaf.stalk y)] (s : MonoidalTransform (Y.presheaf.stalk y) (B.stalkIdeal y))

/-- The morphism `Spec R' → Spec O_{Y,y} → Y` of a monoidal transform `R'` of the local ring
`O_{Y,y}` with center the ideal of `B` (p. 209: `R'` is a local ring over `R = O_{Y,y}`). -/
noncomputable def toBase : Spec (CommRingCat.of s.ring) ⟶ Y :=
  Spec.map (CommRingCat.ofHom s.toRing) ≫ Y.fromSpecStalk y

/-- The pull-back of `B` to `Spec R'` is invertible: `B_y R' = P R' = (x) R'` with
`x ≠ 0` in the domain `R'` (p. 209). -/
theorem isInvertibleIdeal_totalTransform_toBase :
    (Subscheme.totalTransform s.toBase B).IsInvertibleIdeal := by
  have : IsDomain (CommRingCat.of s.ring) := inferInstanceAs (IsDomain s.ring)
  refine isInvertibleIdeal_totalTransform_specMap_fromSpecStalk B y (CommRingCat.ofHom s.toRing)
    (g := s.xR) ?_ ?_
  · exact fun h => s.x_ne_zero (s.toRing_injective (h.trans (map_zero s.toRing).symm))
  · exact (MonoidalTransform.span_xR_eq_map s).symm

/-- The closed point of `Spec R'`. -/
noncomputable def closedPt : Spec (CommRingCat.of s.ring) := IsLocalRing.closedPoint s.ring

/-- The closed point of `Spec R'` goes to `y`. -/
theorem toBase_closedPt : s.toBase s.closedPt = y := by
  have hloc : IsLocalHom (CommRingCat.ofHom s.toRing).hom := inferInstanceAs (IsLocalHom s.toRing)
  have h1 : Spec.map (CommRingCat.ofHom s.toRing) s.closedPt =
      IsLocalRing.closedPoint (Y.presheaf.stalk y) := Spec_closedPoint (f := CommRingCat.ofHom s.toRing)
  rw [toBase, Scheme.Hom.comp_apply, h1, Scheme.fromSpecStalk_closedPoint]

end MonoidalTransform

namespace MonoidalTransformation

variable {Y : Scheme.{u}} {B : Subscheme Y} (t : MonoidalTransformation Y B) {y : Y}
  [IsRegularLocalRing (Y.presheaf.stalk y)] [IsDomain (Y.presheaf.stalk y)]
  (s : MonoidalTransform (Y.presheaf.stalk y) (B.stalkIdeal y))

/-- Fact (i), the morphism: a monoidal transform `R'` of `R = O_{Y,y}` with center `B_y` gives a
morphism `Spec R' → Y'` over `Y`, by the universal mapping property (ii) of p. 166 (the
pull-back of `B` to `Spec R'` is invertible, `MonoidalTransform.isInvertibleIdeal_totalTransform_toBase`). -/
noncomputable def liftOfMonoidalTransform : Spec (CommRingCat.of s.ring) ⟶ t.X' :=
  (t.universal _ s.toBase s.isInvertibleIdeal_totalTransform_toBase).exists.choose

@[reassoc (attr := simp)]
theorem liftOfMonoidalTransform_f : t.liftOfMonoidalTransform s ≫ t.f = s.toBase :=
  (t.universal _ s.toBase s.isInvertibleIdeal_totalTransform_toBase).exists.choose_spec

/-- Fact (i), the point: the image of the closed point of `Spec R'` in `Y'`. -/
noncomputable def pointOfMonoidalTransform : t.X' :=
  t.liftOfMonoidalTransform s s.closedPt

/-- Fact (i): the point `pointOfMonoidalTransform` lies over `y`. -/
theorem f_pointOfMonoidalTransform : t.f (t.pointOfMonoidalTransform s) = y := by
  have h1 : (t.liftOfMonoidalTransform s ≫ t.f) s.closedPt =
      t.f (t.liftOfMonoidalTransform s s.closedPt) := Scheme.Hom.comp_apply _ _ _
  rw [liftOfMonoidalTransform_f] at h1
  exact h1.symm.trans s.toBase_closedPt

end MonoidalTransformation


namespace MonoidalTransformation

/-! ### Fact (ii): a point of the blow-up over `y` is determined by its local ring -/

section Determined

variable {Y : Scheme.{u}} {B : Subscheme Y} (t : MonoidalTransformation Y B)

/-- The statement of `MonoidalTransformation.exists_monoidalTransform_stalk` for a point `y'` over
a point `y` given by a hypothesis `t.f y' = y` (instead of `y = t.f y'`), the stalk map being
`Scheme.Hom.stalkMapOf`. -/
theorem exists_monoidalTransform_stalk_of_eq {y' : t.X'} {y : Y} (h : t.f y' = y)
    [IsRegularLocalRing (Y.presheaf.stalk y)] [IsDomain (Y.presheaf.stalk y)] :
    ∃ (s : MonoidalTransform (Y.presheaf.stalk y) (B.stalkIdeal y))
      (e : s.ring ≃+* t.X'.presheaf.stalk y'),
      e.toRingHom.comp s.toRing = (t.f.stalkMapOf h).hom := by
  subst h
  obtain ⟨s, e, he⟩ := t.exists_monoidalTransform_stalk y'
  exact ⟨s, e, by rw [Scheme.Hom.stalkMapOf_rfl]; exact he⟩

variable {y : Y} [IsRegularLocalRing (Y.presheaf.stalk y)] [IsDomain (Y.presheaf.stalk y)]
  (s : MonoidalTransform (Y.presheaf.stalk y) (B.stalkIdeal y))

/-- Fact (ii), first half: if the local ring of `Y'` at `y'` (over `y`) is, over `O_{Y,y}`, the
monoidal transform `s`, then `y'` is the point `pointOfMonoidalTransform s` of `Y'`. Both morphisms
`Spec O_{Y',y'} → Y'` (the canonical one and `Spec e ≫ liftOfMonoidalTransform s`) have the same
composite to `Y`, and the pull-back of `B` to `Spec O_{Y',y'}` is invertible, so they agree by the
uniqueness in the universal mapping property of p. 166. -/
theorem pointOfMonoidalTransform_eq {y' : t.X'} (h : t.f y' = y)
    (e : s.ring ≃+* t.X'.presheaf.stalk y')
    (he : e.toRingHom.comp s.toRing = (t.f.stalkMapOf h).hom) :
    t.pointOfMonoidalTransform s = y' := by
  subst h
  rw [Scheme.Hom.stalkMapOf_rfl] at he
  let e' : CommRingCat.of s.ring ⟶ t.X'.presheaf.stalk y' := CommRingCat.ofHom e.toRingHom
  have : IsIso e' := e.toCommRingCatIso.isIso_hom
  have hloc : IsLocalHom e'.hom :=
    ⟨fun a (ha : IsUnit (e a)) => by simpa using ha.map e.symm.toRingHom⟩
  have hh : CommRingCat.ofHom s.toRing ≫ e' = t.f.stalkMap y' :=
    CommRingCat.hom_ext (RingHom.ext fun r => RingHom.congr_fun he r)
  have key : Spec.map e' ≫ t.liftOfMonoidalTransform s = t.X'.fromSpecStalk y' := by
    refine MonoidalTransformation.hom_ext (t := t) ?_ ?_
    · rw [Category.assoc, liftOfMonoidalTransform_f, MonoidalTransform.toBase,
        ← Category.assoc, ← Spec.map_comp, hh, Scheme.SpecMap_stalkMap_fromSpecStalk]
    · rw [Category.assoc, liftOfMonoidalTransform_f, Subscheme.totalTransform_comp]
      exact isInvertibleIdeal_totalTransform_of_isOpenImmersion
        (s.isInvertibleIdeal_totalTransform_toBase) _
  have h1 : (Spec.map e' ≫ t.liftOfMonoidalTransform s)
      (IsLocalRing.closedPoint (t.X'.presheaf.stalk y')) = y' := by
    rw [key]; exact Scheme.fromSpecStalk_closedPoint
  have h2 : (Spec.map e' ≫ t.liftOfMonoidalTransform s)
      (IsLocalRing.closedPoint (t.X'.presheaf.stalk y')) =
      t.liftOfMonoidalTransform s (Spec.map e' (IsLocalRing.closedPoint (t.X'.presheaf.stalk y'))) :=
    Scheme.Hom.comp_apply _ _ _
  have h3 : Spec.map e' (IsLocalRing.closedPoint (t.X'.presheaf.stalk y')) = s.closedPt :=
    Spec_closedPoint (f := e')
  rw [h2, h3] at h1
  exact h1

/-- Fact (ii): two points of `Y'` over `y` whose local rings are the monoidal transforms `s₁`, `s₂`
of `O_{Y,y}` with the same subring of the field of quotients are equal (a point of the blow-up is
determined by its local ring as a subring of the field of quotients of `R = O_{Y,y}`). -/
theorem eq_of_subring_eq {y₁ y₂ : t.X'} (h₁ : t.f y₁ = y) (h₂ : t.f y₂ = y)
    {s₁ s₂ : MonoidalTransform (Y.presheaf.stalk y) (B.stalkIdeal y)}
    (hs : s₁.subring = s₂.subring)
    (e₁ : s₁.ring ≃+* t.X'.presheaf.stalk y₁)
    (he₁ : e₁.toRingHom.comp s₁.toRing = (t.f.stalkMapOf h₁).hom)
    (e₂ : s₂.ring ≃+* t.X'.presheaf.stalk y₂)
    (he₂ : e₂.toRingHom.comp s₂.toRing = (t.f.stalkMapOf h₂).hom) : y₁ = y₂ := by
  let ε := s₁.ringEquivOfSubringEq s₂ hs
  have hε : ∀ r, ε (s₁.toRing r) = s₂.toRing r := fun r => by
    apply s₂.injective_toFractionRing
    rw [MonoidalTransform.toFractionRing_ringEquivOfSubringEq, MonoidalTransform.toFractionRing_toRing,
      MonoidalTransform.toFractionRing_toRing]
  have h1 := t.pointOfMonoidalTransform_eq s₁ h₁ e₁ he₁
  have h2 := t.pointOfMonoidalTransform_eq s₁ h₂ (ε.trans e₂) (RingHom.ext fun r => by
    have := RingHom.congr_fun he₂ r
    simpa [hε] using this)
  exact h1.symm.trans h2

/-- Fact (ii) for the center `B_y = O_{Y,y}` (`y ∉ B`): there is at most one point of `Y'` over `y`
(p. 209: for `P = R` the monoidal transform of `R` is `R` itself). -/
theorem eq_of_stalkIdeal_eq_top (hy : B.stalkIdeal y = ⊤) {y₁ y₂ : t.X'} (h₁ : t.f y₁ = y)
    (h₂ : t.f y₂ = y) : y₁ = y₂ := by
  obtain ⟨s₁, e₁, he₁⟩ := t.exists_monoidalTransform_stalk_of_eq h₁
  obtain ⟨s₂, e₂, he₂⟩ := t.exists_monoidalTransform_stalk_of_eq h₂
  have hsub : ∀ s : MonoidalTransform (Y.presheaf.stalk y) (B.stalkIdeal y),
      s.subring = (algebraMap (Y.presheaf.stalk y) (FractionRing (Y.presheaf.stalk y))).range :=
    fun s => by
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        obtain ⟨r, rfl⟩ := (MonoidalTransform.bijective_toRing_of_eq_top s hy).2 w
        exact ⟨r, (MonoidalTransform.toFractionRing_toRing s r).symm⟩
      · rintro ⟨r, rfl⟩
        exact ⟨s.toRing r, MonoidalTransform.toFractionRing_toRing s r⟩
  exact t.eq_of_subring_eq h₁ h₂ ((hsub s₁).trans (hsub s₂).symm) e₁ he₁ e₂ he₂

/-- Fact (i), compatibility with a morphism of blow-ups: in a commutative square
`f̂ ≫ c = c' ≫ f` of monoidal transformations (`B̂ = c⁻¹(B)`), let `s` be a monoidal transform of
`O_{Y,y}` with center `B_y` and `ŝ` one of `O_{Ŷ,ŷ}` (`c ŷ = y`) with center `B̂_ŷ` which admits a
canonical local homomorphism `β : s → ŝ` (`β ∘ (R → s) = (R̂ → ŝ) ∘ (c_ŷ : R → R̂)`).  Then `c'`
maps the point of `Ŷ'` given by `ŝ` to the point of `Y'` given by `s`: the two morphisms
`Spec ŝ → Y'`, `liftOfMonoidalTransform ŝ ≫ c'` and `Spec β ≫ liftOfMonoidalTransform s`, have
the same composite to `Y` and the pull-back of `B` to `Spec ŝ` is invertible, so they agree by the
universal mapping property of p. 166. -/
theorem c_pointOfMonoidalTransform_eq {Yh : Scheme.{u}} {Bh : Subscheme Yh}
    (th : MonoidalTransformation Yh Bh) (c : Yh ⟶ Y) (c' : th.X' ⟶ t.X')
    (hBh : Bh = Subscheme.totalTransform c B) (hcomm : th.f ≫ c = c' ≫ t.f) {ŷ : Yh}
    (hŷ : c ŷ = y) [IsRegularLocalRing (Yh.presheaf.stalk ŷ)] [IsDomain (Yh.presheaf.stalk ŷ)]
    (sh : MonoidalTransform (Yh.presheaf.stalk ŷ) (Bh.stalkIdeal ŷ)) (β : s.ring →+* sh.ring)
    [IsLocalHom β] (hβ : β.comp s.toRing = sh.toRing.comp (c.stalkMapOf hŷ).hom) :
    c' (th.pointOfMonoidalTransform sh) = t.pointOfMonoidalTransform s := by
  subst hŷ
  rw [Scheme.Hom.stalkMapOf_rfl] at hβ
  have e1 : CommRingCat.ofHom s.toRing ≫ CommRingCat.ofHom β =
      c.stalkMap ŷ ≫ CommRingCat.ofHom sh.toRing :=
    CommRingCat.hom_ext (RingHom.ext fun r => RingHom.congr_fun hβ r)
  have key : th.liftOfMonoidalTransform sh ≫ c' =
      Spec.map (CommRingCat.ofHom β) ≫ t.liftOfMonoidalTransform s := by
    refine MonoidalTransformation.hom_ext (t := t) ?_ ?_
    · rw [Category.assoc, ← hcomm, ← Category.assoc, liftOfMonoidalTransform_f, Category.assoc,
        liftOfMonoidalTransform_f, MonoidalTransform.toBase, MonoidalTransform.toBase,
        Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk c (x := ŷ),
        ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, e1]
      rfl
    · rw [Category.assoc, ← hcomm, ← Category.assoc, Subscheme.totalTransform_comp, ← hBh,
        liftOfMonoidalTransform_f]
      exact sh.isInvertibleIdeal_totalTransform_toBase
  have h2 : (th.liftOfMonoidalTransform sh ≫ c') sh.closedPt =
      c' (th.liftOfMonoidalTransform sh sh.closedPt) := Scheme.Hom.comp_apply _ _ _
  have h3 : (Spec.map (CommRingCat.ofHom β) ≫ t.liftOfMonoidalTransform s) sh.closedPt =
      t.liftOfMonoidalTransform s (Spec.map (CommRingCat.ofHom β) sh.closedPt) :=
    Scheme.Hom.comp_apply _ _ _
  have hloc : IsLocalHom (CommRingCat.ofHom β).hom := inferInstanceAs (IsLocalHom β)
  have h4 : Spec.map (CommRingCat.ofHom β) sh.closedPt = s.closedPt :=
    Spec_closedPoint (f := CommRingCat.ofHom β)
  rw [h4] at h3
  exact h2.symm.trans ((congrArg (fun φ => φ sh.closedPt) key).trans h3)

end Determined

end MonoidalTransformation

end Hironaka

module

public import Mathlib.RingTheory.Etale.Weakly
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.MvPolynomial.IrreducibleQuadratic
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.SimpleRing.Principal
public import Mathlib.RingTheory.TotallySplit

/-!
# Lemma 25, (ii) of (c) (pp. 272--273): lifting of the space `T*` through the exceptional variables

In the proof of (ii) of (c) the paper compares the initial form `φ` of `f` in
`gr_M(R) = k[Z, W, Y₁, …, Y_b, Y, X₁, …, X_a]` with the initial form `ψ` of `f̄ = y^{-ν}f` in
`gr_{M₁}(R₁)`: `ψ ≡ φ(Z̄, W̄, Ȳ₁, …)` modulo `(Y, X₁, …, X_a)` (Claim A of `PermissibleEffects.lean`,
`TransformCoord.ordElem_le_and_rho_initialForm_eq`), and "by the assumption (2), we can find a
system of linear forms `(L, L₁, …, L_{τ'})` in `Y, X₁, …, X_a` with coefficients in `k` such that
`ψ = φ(Z̄, W̄ + L, Ȳ₁ + L₁, …)`" (p. 272).  This file proves that sentence for polynomials over a
field (`exists_lift`): a polynomial `q` with `q ≡ p` modulo the variables outside `A`, `p` a
polynomial in the variables of `A`, and `dim T*(q) ≤ dim T*(p)` is obtained from `p` by a
substitution `X_v ↦ X_v + ℓ_v` with linear forms `ℓ_v` in the variables outside `A`, vanishing on
the `Z`'s, and this substitution carries `T*(p)` into `T*(q)`.
-/

@[expose] public section

open MvPolynomial

namespace Hironaka

universe u

section Lifting

variable {k : Type u} [Field k] {ι : Type*} (isA : ι → Prop) [DecidablePred isA]

/-- The substitution killing the variables outside `A`. -/
noncomputable def killB : MvPolynomial ι k →ₐ[k] MvPolynomial ι k :=
  aeval fun v => if isA v then X v else 0

/-- The span of the variables in a set. -/
noncomputable def linSpan (s : Set ι) : Submodule k (MvPolynomial ι k) :=
  Submodule.span k (X '' s)

variable {isA}

theorem killB_X (v : ι) :
    killB (k := k) isA (X v) = if isA v then X v else 0 := by
  simp [killB]

theorem killB_of_mem_linSpan_A {t : MvPolynomial ι k} (ht : t ∈ linSpan (k := k) {v | isA v}) :
    killB isA t = t := by
  refine Submodule.span_induction (p := fun t _ => killB isA t = t) ?_ ?_ ?_ ?_ ht
  · rintro _ ⟨v, hv, rfl⟩
    rw [killB_X, ite_eq_left (show isA v from hv)]
  · simp
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro c a _ ha
    rw [map_smul, ha]

theorem killB_of_mem_linSpan_B {t : MvPolynomial ι k} (ht : t ∈ linSpan (k := k) {v | ¬ isA v}) :
    killB isA t = 0 := by
  refine Submodule.span_induction (p := fun t _ => killB isA t = 0) ?_ ?_ ?_ ?_ ht
  · rintro _ ⟨v, hv, rfl⟩
    rw [killB_X, ite_eq_right (show ¬ isA v from hv)]
  · simp
  · intro a b _ _ ha hb
    rw [map_add, ha, hb, add_zero]
  · intro c a _ ha
    rw [map_smul, ha, smul_zero]

theorem homogeneousSubmodule_one_eq_linSpan_sup :
    homogeneousSubmodule ι k 1 = linSpan {v | isA v} ⊔ linSpan {v | ¬ isA v} := by
  have hU : ({v | isA v} ∪ {v | ¬ isA v} : Set ι) = Set.univ := by
    ext v
    by_cases h : isA v <;> simp [h]
  rw [homogeneousSubmodule_one_eq_span_X, linSpan, linSpan, ← Submodule.span_union,
    ← Set.image_union, hU, Set.image_univ]

theorem linSpan_A_le_homogeneous : linSpan (k := k) {v | isA v} ≤ homogeneousSubmodule ι k 1 := by
  rw [homogeneousSubmodule_one_eq_linSpan_sup (isA := isA)]
  exact le_sup_left

/-- A linear form is the sum of its `A`-part and its `B`-part. -/
theorem sub_killB_mem_linSpan_B {t : MvPolynomial ι k} (ht : t ∈ homogeneousSubmodule ι k 1) :
    t - killB isA t ∈ linSpan (k := k) {v | ¬ isA v} := by
  rw [homogeneousSubmodule_one_eq_linSpan_sup (isA := isA)] at ht
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp ht
  rw [map_add, killB_of_mem_linSpan_A ha, killB_of_mem_linSpan_B hb, add_zero]
  simpa using hb

theorem killB_mem_linSpan_A {t : MvPolynomial ι k} (ht : t ∈ homogeneousSubmodule ι k 1) :
    killB isA t ∈ linSpan (k := k) {v | isA v} := by
  rw [homogeneousSubmodule_one_eq_linSpan_sup (isA := isA)] at ht
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp ht
  rw [map_add, killB_of_mem_linSpan_A ha, killB_of_mem_linSpan_B hb, add_zero]
  exact ha

/-- `killB` is the identity on the subalgebra generated by the `A`-variables. -/
theorem killB_of_mem_adjoin {p : MvPolynomial ι k}
    (hp : p ∈ Algebra.adjoin k (X '' {v | isA v} : Set (MvPolynomial ι k))) : killB isA p = p := by
  have : Algebra.adjoin k (X '' {v | isA v} : Set (MvPolynomial ι k)) ≤
      AlgHom.equalizer (killB (k := k) isA) (AlgHom.id k _) := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨v, hv, rfl⟩
    show killB isA (X v) = X v
    rw [killB_X, ite_eq_left (show isA v from hv)]
  exact this hp

end Lifting

section LiftMain

variable {k : Type u} [Field k] {ι : Type*} [Fintype ι] [DecidableEq ι] {isA : ι → Prop}
  [DecidablePred isA]

instance : Module.Finite k (homogeneousSubmodule ι k 1) := by
  rw [homogeneousSubmodule_one_eq_span_X]
  exact Module.Finite.span_of_finite k (Set.finite_range _)

omit [DecidableEq ι] in
/-- **Lifting of the space `T*` through the projection killing the variables outside `A`**
(p. 272: "By the assumption (2), we can find a system of linear forms `(L, L₁, …, L_{τ'})` in
`Y, X₁, …, X_a` with coefficients in `k` such that `ψ = φ(Z̄, W̄ + L, Ȳ₁ + L₁, …)`").

Let `p` be a polynomial in the variables of `A` and `q` a polynomial with `q ≡ p` modulo the other
variables; let `Tp` be the smallest space of linear forms with `p ∈ k[Tp]` and `Tq` any space of
linear forms with `q ∈ k[Tq]`; let `Zs` be a space of linear forms in the variables of `A`.  If
`dim (Tq + Zs) ≤ dim (Tp + Zs)`, there are linear forms `ℓ_v` in the variables outside `A`
(vanishing on `Zs`) such that `q` is obtained from `p` by the substitution `X_v ↦ X_v + ℓ_v` and
this substitution carries `Tp + Zs` into `Tq + Zs`. -/
theorem exists_lift (p q : MvPolynomial ι k) (hpq : killB isA q = p)
    (hp : p ∈ Algebra.adjoin k (X '' {v | isA v} : Set (MvPolynomial ι k)))
    (Tp Tq Zs : Submodule k (MvPolynomial ι k))
    (hmin : ∀ T : Submodule k (MvPolynomial ι k), T ≤ homogeneousSubmodule ι k 1 →
      p ∈ Algebra.adjoin k (T : Set (MvPolynomial ι k)) → Tp ≤ T)
    (hTq : Tq ≤ homogeneousSubmodule ι k 1)
    (hqTq : q ∈ Algebra.adjoin k (Tq : Set (MvPolynomial ι k)))
    (hZs : Zs ≤ linSpan {v | isA v})
    (hdim : Module.finrank k (Tq ⊔ Zs : Submodule k (MvPolynomial ι k)) ≤
      Module.finrank k (Tp ⊔ Zs : Submodule k (MvPolynomial ι k))) :
    ∃ ℓ : ι → MvPolynomial ι k, (∀ v, ℓ v ∈ linSpan (k := k) {v | ¬ isA v}) ∧
      (∀ v, ¬ isA v → ℓ v = 0) ∧ (∀ v, X v ∈ Zs → ℓ v = 0) ∧
      q = aeval (fun v => X v + ℓ v) p ∧
      ∀ t ∈ Tp ⊔ Zs, aeval (fun v => X v + ℓ v) t ∈ Tq ⊔ Zs := by
  classical
  set π : MvPolynomial ι k →ₐ[k] MvPolynomial ι k := killB isA with hπ
  have hLinA : linSpan (k := k) {v | isA v} ≤ homogeneousSubmodule ι k 1 :=
    linSpan_A_le_homogeneous
  have hpA : p ∈ Algebra.adjoin k ((linSpan (k := k) {v | isA v} : Submodule k _) :
      Set (MvPolynomial ι k)) := by
    rw [linSpan, Algebra.adjoin_span]
    exact hp
  have hTpA : Tp ≤ linSpan (k := k) {v | isA v} := hmin _ hLinA hpA
  have hTpL : Tp ≤ homogeneousSubmodule ι k 1 := hTpA.trans hLinA
  have hZsL : Zs ≤ homogeneousSubmodule ι k 1 := hZs.trans hLinA
  -- (a) `Tp ≤ π(Tq)`
  have hπlin : ∀ t ∈ homogeneousSubmodule ι k 1, π t ∈ homogeneousSubmodule ι k 1 := fun t ht =>
    hLinA (killB_mem_linSpan_A ht)
  have hpmap : p ∈ Algebra.adjoin k ((Tq.map (π : MvPolynomial ι k →ₐ[k] MvPolynomial ι k).toLinearMap :
      Submodule k _) : Set (MvPolynomial ι k)) := by
    have h1 : π q ∈ (Algebra.adjoin k (Tq : Set (MvPolynomial ι k))).map π :=
      Subalgebra.mem_map.mpr ⟨q, hqTq, rfl⟩
    rw [AlgHom.map_adjoin] at h1
    rw [hpq] at h1
    refine (Algebra.adjoin_mono ?_) h1
    rintro _ ⟨t, ht, rfl⟩
    exact ⟨t, ht, rfl⟩
  have hπTq : Tq.map π.toLinearMap ≤ homogeneousSubmodule ι k 1 := by
    rintro _ ⟨t, ht, rfl⟩
    exact hπlin t (hTq ht)
  have hTpπ : Tp ≤ Tq.map π.toLinearMap := hmin _ hπTq hpmap
  -- (b) the dimension count
  have hZsπ : Zs.map π.toLinearMap = Zs := by
    ext t
    constructor
    · rintro ⟨s, hs, rfl⟩
      show π s ∈ Zs
      rw [hπ, killB_of_mem_linSpan_A (hZs hs)]
      exact hs
    · intro ht
      exact ⟨t, ht, killB_of_mem_linSpan_A (hZs ht)⟩
  have hsupπ : (Tq ⊔ Zs).map π.toLinearMap = Tq.map π.toLinearMap ⊔ Zs := by
    rw [Submodule.map_sup, hZsπ]
  have hle : Tp ⊔ Zs ≤ (Tq ⊔ Zs).map π.toLinearMap := by
    rw [hsupπ]
    exact sup_le_sup_right hTpπ _
  have hTqZs : Tq ⊔ Zs ≤ homogeneousSubmodule ι k 1 := sup_le hTq hZsL
  have hTpZs : Tp ⊔ Zs ≤ homogeneousSubmodule ι k 1 := sup_le hTpL hZsL
  have hmapL : (Tq ⊔ Zs).map π.toLinearMap ≤ homogeneousSubmodule ι k 1 := by
    rintro _ ⟨t, ht, rfl⟩
    exact hπlin t (hTqZs ht)
  have hfin1 : FiniteDimensional k (Tq ⊔ Zs : Submodule k (MvPolynomial ι k)) :=
    Submodule.finiteDimensional_of_le hTqZs
  have hfin2 : FiniteDimensional k (Tp ⊔ Zs : Submodule k (MvPolynomial ι k)) :=
    Submodule.finiteDimensional_of_le hTpZs
  have hfin3 : FiniteDimensional k ((Tq ⊔ Zs).map π.toLinearMap) :=
    Submodule.finiteDimensional_of_le hmapL
  have hd1 : Module.finrank k (Tp ⊔ Zs : Submodule k (MvPolynomial ι k)) ≤
      Module.finrank k ((Tq ⊔ Zs).map π.toLinearMap) := Submodule.finrank_mono hle
  have hd2 : Module.finrank k ((Tq ⊔ Zs).map π.toLinearMap) ≤
      Module.finrank k (Tq ⊔ Zs : Submodule k (MvPolynomial ι k)) :=
    Submodule.finrank_map_le π.toLinearMap _
  have hdeq : Module.finrank k (Tp ⊔ Zs : Submodule k (MvPolynomial ι k)) =
      Module.finrank k ((Tq ⊔ Zs).map π.toLinearMap) := le_antisymm hd1 (hd2.trans hdim)
  have hEq : Tp ⊔ Zs = (Tq ⊔ Zs).map π.toLinearMap := Submodule.eq_of_le_of_finrank_eq hle hdeq
  -- `π` is injective on `Tq + Zs`
  set f : ↥(Tq ⊔ Zs) →ₗ[k] MvPolynomial ι k := π.toLinearMap.domRestrict (Tq ⊔ Zs) with hf
  have hfinj : Function.Injective f := by
    have h1 := LinearMap.finrank_range_add_finrank_ker f
    have h2 : LinearMap.range f = (Tq ⊔ Zs).map π.toLinearMap := LinearMap.range_domRestrict _ _
    rw [h2, ← hdeq] at h1
    have h3 : Module.finrank k (LinearMap.ker f) = 0 := by omega
    rw [← LinearMap.ker_eq_bot]
    exact Submodule.finrank_eq_zero.mp h3
  -- the bijection `Tq + Zs ≃ Tp + Zs`
  let f' : ↥(Tq ⊔ Zs) →ₗ[k] ↥(Tp ⊔ Zs) := f.codRestrict (Tp ⊔ Zs) (fun x => by
    rw [hEq]
    exact ⟨x, x.2, rfl⟩)
  have hf'inj : Function.Injective f' := fun x y hxy => hfinj (by
    have := congrArg Subtype.val hxy
    exact this)
  have hf'surj : Function.Surjective f' := by
    rintro ⟨s, hs⟩
    rw [hEq] at hs
    obtain ⟨x, hx, rfl⟩ := hs
    exact ⟨⟨x, hx⟩, rfl⟩
  let e := LinearEquiv.ofBijective f' ⟨hf'inj, hf'surj⟩
  have hπΛ : ∀ s : ↥(Tp ⊔ Zs), π ((e.symm s : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) = s := by
    intro s
    have := congrArg Subtype.val (e.apply_symm_apply s)
    exact this
  have hTpZsA : Tp ⊔ Zs ≤ linSpan (k := k) {v | isA v} := sup_le hTpA hZs
  have hπs : ∀ s : ↥(Tp ⊔ Zs), π (s : MvPolynomial ι k) = s := fun s =>
    killB_of_mem_linSpan_A (hTpZsA s.2)
  -- the difference `λ(s) - s` lies in the span of the variables outside `A`
  have hdiffB : ∀ s : ↥(Tp ⊔ Zs),
      ((e.symm s : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) - s ∈ linSpan (k := k) {v | ¬ isA v} := by
    intro s
    have h1 : ((e.symm s : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) - s ∈ homogeneousSubmodule ι k 1 :=
      sub_mem (hTqZs (e.symm s).2) (hTpZs s.2)
    have h2 := sub_killB_mem_linSpan_B (isA := isA) h1
    have h3 : π (((e.symm s : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) - s) = 0 := by
      rw [map_sub, hπΛ, hπs, sub_self]
    rw [h3, sub_zero] at h2
    exact h2
  let L0 : ↥(Tp ⊔ Zs) →ₗ[k] ↥(linSpan (k := k) {v | ¬ isA v}) :=
    ((Tq ⊔ Zs).subtype ∘ₗ e.symm.toLinearMap - (Tp ⊔ Zs).subtype).codRestrict _ hdiffB
  obtain ⟨g, hg⟩ := LinearMap.exists_extend L0
  have hgL0 : ∀ s : ↥(Tp ⊔ Zs), g (s : MvPolynomial ι k) = L0 s := fun s =>
    LinearMap.congr_fun hg s
  set ℓ : ι → MvPolynomial ι k := fun v => if isA v then (g (X v) : MvPolynomial ι k) else 0
    with hℓ
  have hℓB : ∀ v, ℓ v ∈ linSpan (k := k) {v | ¬ isA v} := by
    intro v
    by_cases hv : isA v
    · simp only [hℓ, ite_eq_left hv]
      exact (g (X v)).2
    · simp only [hℓ, ite_eq_right hv]
      exact zero_mem _
  set σ : MvPolynomial ι k →ₐ[k] MvPolynomial ι k := aeval fun v => X v + ℓ v with hσ
  have hσlin : ∀ t ∈ linSpan (k := k) {v | isA v}, σ t = t + (g t : MvPolynomial ι k) := by
    intro t ht
    refine Submodule.span_induction (p := fun t _ => σ t = t + (g t : MvPolynomial ι k)) ?_ ?_ ?_ ?_ ht
    · rintro _ ⟨v, hv, rfl⟩
      simp only [hσ, aeval_X, hℓ, ite_eq_left (show isA v from hv)]
    · simp
    · intro a b _ _ ha hb
      rw [map_add, ha, hb, map_add]
      push_cast
      ring
    · intro c a _ ha
      rw [map_smul, ha, map_smul]
      simp [smul_add]
  have hσW : ∀ t : ↥(Tp ⊔ Zs), σ (t : MvPolynomial ι k) =
      ((e.symm t : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) := by
    intro t
    rw [hσlin _ (hTpZsA t.2), hgL0]
    have : ((L0 t : ↥(linSpan (k := k) {v | ¬ isA v})) : MvPolynomial ι k) =
        ((e.symm t : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) - t := rfl
    rw [this]
    ring
  have hπσ : ∀ t, π (σ t) = π t := by
    intro t
    have : π.comp σ = π := by
      refine MvPolynomial.algHom_ext fun v => ?_
      simp only [AlgHom.comp_apply, hσ, aeval_X, map_add]
      rw [hπ, killB_of_mem_linSpan_B (hℓB v), add_zero]
    exact AlgHom.congr_fun this t
  -- the set `Tq + Zs` is the image of `Tp + Zs` under `σ`
  have himage : ((Tq ⊔ Zs : Submodule k (MvPolynomial ι k)) : Set (MvPolynomial ι k)) =
      σ '' ((Tp ⊔ Zs : Submodule k (MvPolynomial ι k)) : Set (MvPolynomial ι k)) := by
    ext x
    constructor
    · intro hx
      refine ⟨(f' ⟨x, hx⟩ : MvPolynomial ι k), (f' ⟨x, hx⟩).2, ?_⟩
      rw [show (f' ⟨x, hx⟩ : MvPolynomial ι k) = ((⟨f' ⟨x, hx⟩, (f' ⟨x, hx⟩).2⟩ : ↥(Tp ⊔ Zs)) :
        MvPolynomial ι k) from rfl, hσW]
      have : e.symm (f' ⟨x, hx⟩) = ⟨x, hx⟩ := e.symm_apply_apply ⟨x, hx⟩
      rw [show (⟨f' ⟨x, hx⟩, (f' ⟨x, hx⟩).2⟩ : ↥(Tp ⊔ Zs)) = f' ⟨x, hx⟩ from rfl, this]
    · rintro ⟨t, ht, rfl⟩
      rw [show t = ((⟨t, ht⟩ : ↥(Tp ⊔ Zs)) : MvPolynomial ι k) from rfl, hσW]
      exact (e.symm ⟨t, ht⟩).2
  -- `q = σ p`
  have hq : q ∈ Algebra.adjoin k (σ '' ((Tp ⊔ Zs : Submodule k (MvPolynomial ι k)) :
      Set (MvPolynomial ι k))) := by
    rw [← himage]
    exact (Algebra.adjoin_mono (SetLike.coe_subset_coe.mpr le_sup_left)) hqTq
  rw [← AlgHom.map_adjoin] at hq
  obtain ⟨g', hg', hgq⟩ := Subalgebra.mem_map.mp hq
  have hg'A : g' ∈ Algebra.adjoin k (X '' {v | isA v} : Set (MvPolynomial ι k)) := by
    have h1 : Algebra.adjoin k ((Tp ⊔ Zs : Submodule k (MvPolynomial ι k)) :
        Set (MvPolynomial ι k)) ≤ Algebra.adjoin k ((linSpan (k := k) {v | isA v} :
        Submodule k (MvPolynomial ι k)) : Set (MvPolynomial ι k)) :=
      Algebra.adjoin_mono (fun t ht => hTpZsA ht)
    have h2 : Algebra.adjoin k ((linSpan (k := k) {v | isA v} :
        Submodule k (MvPolynomial ι k)) : Set (MvPolynomial ι k)) =
        Algebra.adjoin k (X '' {v | isA v} : Set (MvPolynomial ι k)) := by
      unfold linSpan
      exact Algebra.adjoin_span k
    rw [h2] at h1
    exact h1 hg'
  have hg'eq : g' = p := by
    have h1 : π (σ g') = π q := congrArg π hgq
    rw [hπσ, hπ, killB_of_mem_adjoin hg'A, hpq] at h1
    exact h1
  refine ⟨ℓ, hℓB, fun v hv => by simp [hℓ, hv], fun v hv => ?_, ?_, fun t ht => ?_⟩
  · by_cases hA : isA v
    · have hvW : X v ∈ Tp ⊔ Zs := Submodule.mem_sup_right hv
      have hvZ : X v ∈ Tq ⊔ Zs := Submodule.mem_sup_right hv
      have h1 : g (X v) = L0 ⟨X v, hvW⟩ := hgL0 ⟨X v, hvW⟩
      have h2 : e ⟨X v, hvZ⟩ = ⟨X v, hvW⟩ := Subtype.ext (by
        show π (X v) = X v
        rw [hπ, killB_of_mem_linSpan_A (hZs hv)])
      have h3 : e.symm ⟨X v, hvW⟩ = ⟨X v, hvZ⟩ := (LinearEquiv.symm_apply_eq e).mpr h2.symm
      have h4 : ((L0 ⟨X v, hvW⟩ : ↥(linSpan (k := k) {v | ¬ isA v})) : MvPolynomial ι k) =
          ((e.symm ⟨X v, hvW⟩ : ↥(Tq ⊔ Zs)) : MvPolynomial ι k) - X v := rfl
      simp only [hℓ, ite_eq_left hA, h1, h4, h3, sub_self]
    · simp [hℓ, hA]
  · rw [← hgq, hg'eq]
  · exact hσW ⟨t, ht⟩ ▸ (e.symm ⟨t, ht⟩).2

end LiftMain

end Hironaka

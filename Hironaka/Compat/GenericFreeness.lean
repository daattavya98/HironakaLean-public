/-!
# Compatibility layer: generic freeness

> Lemma 3. Let A be a noetherian integral domain, S an A-algebra of finite type and M an
> S-module of finite type. Then there exists a non-zero element f of A such that M_f is a free
> A_f-module …  (Ch. II §1, p. 188)

The paper cites this from Grothendieck (Lemma 6.7 of the seminar note "Séminaire de
Géométrie Algébrique de l'IHES, No. IV (1960)", p. 181).  Mathlib does not have it; we prove
it by induction on the number of generators of `S` as an `A`-algebra.  With `S` generated by
`S'` (`n` generators) and one more element `x`, and `M` generated over `S` by `m₁, …, m_k`, the
`S'`-submodules `M_j = M₀ + x M₀ + ⋯ + x^j M₀` (`M₀ = Σ S' mᵢ`) exhaust `M`.  Multiplication by
`x^j` maps `M₀` onto `M_j/M_{j-1}` with kernel `K_j`, an increasing chain of `S'`-submodules of
the noetherian module `M₀` that stabilizes.  So only finitely many finite `S'`-modules
`M₀/K_j` occur as quotients `M_j/M_{j-1}`, and the induction hypothesis and
`Hironaka/Compat/GenericFreenessAux.lean` conclude.

The filtration `M_j` (`GenericFreeness.filt`), the kernels `K_j` (`GenericFreeness.kerFilt`,
indexed so that `kerFilt j` is the kernel of `M₀ → M_{j+1}/M_j`) and the isomorphisms
`M₀/K_j ≅ M_{j+1}/M_j` (`GenericFreeness.quotEquiv`) are set up for an arbitrary ring `R` with
an algebra `R → S`; the induction step `GenericFreeness.exists_free_of_adjoin_singleton` uses
`R = S'`.
-/

@[expose] public section

namespace Hironaka

universe u

namespace GenericFreeness

/-! ### The filtration `M_j = M₀ + x M₀ + ⋯ + x^j M₀` -/

section Filtration

variable {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]

/-- Multiplication by `y ∈ S` on the `S`-module `M`, as an `R`-linear map. -/
def smulMap (R : Type*) [CommRing R] [Algebra R S] [Module R M] [IsScalarTower R S M] (y : S) :
    M →ₗ[R] M :=
  (LinearMap.lsmul S M y).restrictScalars R

@[simp] theorem smulMap_apply (y : S) (m : M) : smulMap R y m = y • m := rfl

/-- The `R`-submodules `M_j = M₀ + x M₀ + ⋯ + x^j M₀` of `M`. -/
def filt (R : Type*) [CommRing R] [Algebra R S] [Module R M] [IsScalarTower R S M] (x : S)
    (M₀ : Submodule R M) : ℕ → Submodule R M
  | 0 => M₀
  | j + 1 => filt R x M₀ j ⊔ M₀.map (smulMap R (x ^ (j + 1)))

variable (x : S) (M₀ : Submodule R M)

theorem filt_zero : filt R x M₀ 0 = M₀ := rfl

theorem filt_succ (j : ℕ) :
    filt R x M₀ (j + 1) = filt R x M₀ j ⊔ M₀.map (smulMap R (x ^ (j + 1))) := rfl

theorem filt_mono : Monotone (filt R x M₀) :=
  monotone_nat_of_le_succ fun j => by rw [filt_succ]; exact le_sup_left

theorem pow_smul_mem_filt (j : ℕ) {m : M} (hm : m ∈ M₀) : x ^ j • m ∈ filt R x M₀ j := by
  cases j with
  | zero => simpa [filt_zero] using hm
  | succ j =>
    rw [filt_succ]
    exact Submodule.mem_sup_right (Submodule.mem_map_of_mem (f := smulMap R (x ^ (j + 1))) hm)

/-- `x M_j ⊆ M_{j+1}`. -/
theorem smul_mem_filt_succ (j : ℕ) {y : M} (hy : y ∈ filt R x M₀ j) :
    x • y ∈ filt R x M₀ (j + 1) := by
  induction j generalizing y with
  | zero =>
    simpa using pow_smul_mem_filt x M₀ 1 hy
  | succ j ih =>
    rw [filt_succ] at hy
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hy
    obtain ⟨m, hm, rfl⟩ := Submodule.mem_map.1 hb
    rw [smul_add, smulMap_apply, smul_smul, ← pow_succ']
    exact add_mem (filt_mono x M₀ (Nat.le_succ _) (ih ha)) (pow_smul_mem_filt x M₀ _ hm)

/-- If `S = R[x]` and `M₀` contains generators of `M` over `S`, the `M_j` exhaust `M`: their
union is stable under `R` and `x`, hence under `S`. -/
theorem exists_mem_filt (hx : Algebra.adjoin R {x} = ⊤) {k : ℕ} (m : Fin k → M)
    (hm : Submodule.span S (Set.range m) = ⊤) (hmM₀ : ∀ i, m i ∈ M₀) (y : M) :
    ∃ j, y ∈ filt R x M₀ j := by
  have hdir : Directed (· ≤ ·) (filt R x M₀) := (filt_mono x M₀).directed_le
  let N := ⨆ j, filt R x M₀ j
  have memN : ∀ z, z ∈ N ↔ ∃ j, z ∈ filt R x M₀ j := fun z =>
    Submodule.mem_iSup_of_directed _ hdir
  -- `N` is stable under every element of `S = R[x]`.
  have hS : ∀ c : S, ∀ z ∈ N, c • z ∈ N := by
    intro c
    have hc : c ∈ Algebra.adjoin R {x} := hx ▸ Algebra.mem_top
    induction hc using Algebra.adjoin_induction with
    | mem c hc =>
      rw [Set.mem_singleton_iff.1 hc]
      intro z hz
      obtain ⟨j, hj⟩ := (memN z).1 hz
      exact (memN _).2 ⟨j + 1, smul_mem_filt_succ x M₀ j hj⟩
    | algebraMap r =>
      intro z hz
      rw [algebraMap_smul]
      exact N.smul_mem r hz
    | add c d _ _ hc hd =>
      intro z hz
      rw [add_smul]
      exact add_mem (hc z hz) (hd z hz)
    | mul c d _ _ hc hd =>
      intro z hz
      rw [mul_smul]
      exact hc _ (hd z hz)
  have hy : y ∈ Submodule.span S (Set.range m) := hm ▸ Submodule.mem_top
  have : y ∈ N := by
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact (memN _).2 ⟨0, hmM₀ i⟩
    | zero => exact N.zero_mem
    | add z w _ _ hz hw => exact add_mem hz hw
    | smul c z _ hz => exact hS c z hz
  exact (memN y).1 this

/-- The kernel `K_{j+1} = {m ∈ M₀ : x^(j+1) m ∈ M_j}` of `M₀ → M_{j+1}/M_j`,
`m ↦ x^(j+1) m`. -/
def kerFilt (j : ℕ) : Submodule R M₀ :=
  (filt R x M₀ j).comap ((smulMap R (x ^ (j + 1))).comp M₀.subtype)

theorem mem_kerFilt {j : ℕ} {m : M₀} :
    m ∈ kerFilt x M₀ j ↔ x ^ (j + 1) • (m : M) ∈ filt R x M₀ j :=
  Iff.rfl

/-- The kernels increase: `x^(j+1) m ∈ M_j` implies `x^(j+2) m ∈ M_{j+1}`. -/
theorem kerFilt_mono : Monotone (kerFilt x M₀) :=
  monotone_nat_of_le_succ fun j m hm => by
    rw [mem_kerFilt] at hm ⊢
    rw [pow_succ', mul_smul]
    exact smul_mem_filt_succ x M₀ j hm

variable (A : Type*) [CommRing A] [Algebra A R] [Module A M] [IsScalarTower A R M]

/-- The `A`-linear map `M₀ → M_{j+1}/M_j`, `m ↦ x^(j+1) m`, into the quotient of `A`-modules
(the form in which `free_localizedModule_of_filtration` takes the successive quotients). -/
def quotMap (j : ℕ) : M₀ →ₗ[A]
    ↥((filt R x M₀ (j + 1)).restrictScalars A) ⧸
      Submodule.comap ((filt R x M₀ (j + 1)).restrictScalars A).subtype
        ((filt R x M₀ j).restrictScalars A) :=
  Submodule.mkQ _ ∘ₗ LinearMap.codRestrict ((filt R x M₀ (j + 1)).restrictScalars A)
    (((smulMap R (x ^ (j + 1))).comp M₀.subtype).restrictScalars A)
    (fun m => pow_smul_mem_filt x M₀ (j + 1) m.2)

theorem quotMap_apply (j : ℕ) (m : M₀) :
    quotMap x M₀ A j m = Submodule.Quotient.mk ⟨x ^ (j + 1) • (m : M),
      pow_smul_mem_filt x M₀ (j + 1) m.2⟩ := rfl

theorem ker_quotMap (j : ℕ) :
    LinearMap.ker (quotMap x M₀ A j) = (kerFilt x M₀ j).restrictScalars A := by
  ext m
  rw [LinearMap.mem_ker, quotMap_apply, Submodule.Quotient.mk_eq_zero,
    Submodule.restrictScalars_mem, mem_kerFilt]
  rfl

theorem quotMap_surjective (j : ℕ) : Function.Surjective (quotMap x M₀ A j) := by
  intro q
  obtain ⟨⟨y, hy⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  have hy' : y ∈ filt R x M₀ (j + 1) := hy
  rw [filt_succ] at hy'
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hy'
  obtain ⟨m, hm, rfl⟩ := Submodule.mem_map.1 hb
  refine ⟨⟨m, hm⟩, ?_⟩
  rw [quotMap_apply, Submodule.Quotient.eq, Submodule.mem_comap]
  change x ^ (j + 1) • m - (a + x ^ (j + 1) • m) ∈ filt R x M₀ j
  rw [sub_add_cancel_right]
  exact neg_mem ha

/-- `M₀/K_{j+1} ≅ M_{j+1}/M_j` as `A`-modules. -/
noncomputable def quotEquiv (j : ℕ) : (M₀ ⧸ kerFilt x M₀ j) ≃ₗ[A]
    ↥((filt R x M₀ (j + 1)).restrictScalars A) ⧸
      Submodule.comap ((filt R x M₀ (j + 1)).restrictScalars A).subtype
        ((filt R x M₀ j).restrictScalars A) :=
  (Submodule.Quotient.restrictScalarsEquiv A (kerFilt x M₀ j)).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (ker_quotMap x M₀ A j).symm ≪≫ₗ
    LinearMap.quotKerEquivOfSurjective _ (quotMap_surjective x M₀ A j)

end Filtration

/-! ### The induction -/

/-- If `f ∣ g` and `M_f` is free over `A_f`, then `M_g` is free over `A_g`. -/
theorem free_of_dvd {A : Type u} [CommRing A] {M : Type u} [AddCommGroup M]
    [Module A M] {f g : A} (h : f ∣ g)
    (hf : Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M)) :
    Module.Free (Localization.Away g) (LocalizedModule (Submonoid.powers g) M) := by
  obtain ⟨c, rfl⟩ := h
  exact free_localizedModule_away_mul f c

/-- The induction step of generic freeness: if `S = S'[x]` for a noetherian subalgebra `S'` for
which generic freeness holds, then it holds for `S`. -/
theorem exists_free_of_adjoin_singleton (A : Type u) [CommRing A] [IsDomain A]
    {S : Type u} [CommRing S] [Algebra A S] (S' : Subalgebra A S) [IsNoetherianRing S']
    (x : S) (hx : Algebra.adjoin S' {x} = ⊤)
    (hS' : ∀ (N : Type u) [AddCommGroup N] [Module S' N] [Module A N] [IsScalarTower A S' N]
      [Module.Finite S' N], ∃ f : A, f ≠ 0 ∧
        Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) N))
    (M : Type u) [AddCommGroup M] [Module S M] [Module A M] [IsScalarTower A S M]
    [Module.Finite S M] :
    ∃ f : A, f ≠ 0 ∧
      Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  obtain ⟨k, m, hm⟩ := Module.Finite.exists_fin (R := S) (M := M)
  let M₀ : Submodule S' M := Submodule.span S' (Set.range m)
  have : Module.Finite S' M₀ := Module.Finite.span_of_finite S' (Set.finite_range m)
  have : IsNoetherian S' M₀ := isNoetherian_of_isNoetherianRing_of_finite S' M₀
  -- The kernels `K_j` stabilize from `j₀` on.
  obtain ⟨j₀, hj₀⟩ := monotone_stabilizes_iff_noetherian.2 ‹IsNoetherian S' M₀›
    ⟨kerFilt x M₀, kerFilt_mono x M₀⟩
  obtain ⟨f₀, hf₀, hfree₀⟩ := hS' M₀
  choose g hg hgfree using fun i : ℕ => hS' (M₀ ⧸ kerFilt x M₀ i)
  refine ⟨f₀ * ∏ i ∈ Finset.range (j₀ + 1), g i,
    mul_ne_zero hf₀ (Finset.prod_ne_zero_iff.2 fun i _ => hg i), ?_⟩
  refine free_localizedModule_of_filtration _ (fun j => (filt S' x M₀ j).restrictScalars A)
    (fun i j hij y hy => filt_mono x M₀ hij hy) ?_ ?_ ?_
  · refine eq_top_iff.2 fun y _ => ?_
    obtain ⟨j, hj⟩ := exists_mem_filt x M₀ hx m hm
      (fun i => Submodule.subset_span ⟨i, rfl⟩) y
    exact Submodule.mem_iSup_of_mem j hj
  · have := free_of_dvd (dvd_mul_right f₀ (∏ i ∈ Finset.range (j₀ + 1), g i)) hfree₀
    exact free_localizedModule_of_linearEquiv (M := M₀) _
      ((Submodule.restrictScalarsEquiv A S' M M₀).symm.restrictScalars A)
  · intro j
    have hi : min j j₀ ∈ Finset.range (j₀ + 1) :=
      Finset.mem_range.2 (Nat.lt_succ_of_le (min_le_right _ _))
    have hK : kerFilt x M₀ (min j j₀) = kerFilt x M₀ j := by
      rcases le_total j j₀ with h | h
      · rw [min_eq_left h]
      · rw [min_eq_right h]
        exact hj₀ j h
    have := free_of_dvd ((Finset.dvd_prod_of_mem g hi).mul_left f₀) (hgfree (min j j₀))
    have := free_localizedModule_of_linearEquiv (f₀ * ∏ i ∈ Finset.range (j₀ + 1), g i)
      ((Submodule.quotEquivOfEq _ _ hK).restrictScalars A)
    exact free_localizedModule_of_linearEquiv _ (quotEquiv x M₀ A j)

/-- Generic freeness for an algebra generated by `n` given elements, by induction on `n`. -/
theorem exists_free_of_adjoin_fin (A : Type u) [CommRing A] [IsDomain A]
    [IsNoetherianRing A] (n : ℕ) :
    ∀ (S : Type u) [CommRing S] [Algebra A S] (s : Fin n → S),
      Algebra.adjoin A (Set.range s) = ⊤ →
      ∀ (M : Type u) [AddCommGroup M] [Module S M] [Module A M] [IsScalarTower A S M]
        [Module.Finite S M],
      ∃ f : A, f ≠ 0 ∧
        Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  induction n with
  | zero =>
    -- `S` is a quotient of `A`, so `M` is an `A`-module of finite type.
    intro S _ _ s hs M _ _ _ _ _
    have hbot : (⊥ : Subalgebra A S) = ⊤ := by
      rw [← hs, Set.range_eq_empty, Algebra.adjoin_empty]
    have hsurj : Function.Surjective (Algebra.linearMap A S) := fun y => by
      have : y ∈ (⊥ : Subalgebra A S) := hbot ▸ Algebra.mem_top
      obtain ⟨a, rfl⟩ := Algebra.mem_bot.1 this
      exact ⟨a, rfl⟩
    have : Module.Finite A S := Module.Finite.of_surjective _ hsurj
    have : Module.Finite A M := Module.Finite.trans S M
    exact exists_free_localizedModule_of_finite A M
  | succ n ih =>
    -- `S = S'[x]` with `S'` generated by the first `n` generators and `x` the last one.
    intro S _ _ s hs M _ _ _ _ _
    let S' : Subalgebra A S := Algebra.adjoin A (Set.range fun i : Fin n => s i.castSucc)
    let t : Fin n → S' := fun i => ⟨s i.castSucc, Algebra.subset_adjoin ⟨i, rfl⟩⟩
    have ht : Algebra.adjoin A (Set.range t) = ⊤ := by
      have : Set.range t = Subtype.val ⁻¹' Set.range fun i : Fin n => s i.castSucc := by
        ext ⟨y, hy⟩
        simp [t, Subtype.ext_iff]
      rw [this]
      exact Algebra.adjoin_adjoin_coe_preimage
    have : Algebra.FiniteType A S' := ⟨Subalgebra.fg_def.2 ⟨_, Set.finite_range t, ht⟩⟩
    have : IsNoetherianRing S' := Algebra.FiniteType.isNoetherianRing A S'
    refine exists_free_of_adjoin_singleton A S' (s (Fin.last n)) ?_ (ih S' t ht) M
    have hle : Algebra.adjoin A (Set.range s) ≤
        (Algebra.adjoin S' {s (Fin.last n)}).restrictScalars A := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, Subalgebra.mem_restrictScalars]
      induction i using Fin.lastCases with
      | last => exact Algebra.subset_adjoin (Set.mem_singleton _)
      | cast i => exact Subalgebra.algebraMap_mem _ (t i)
    rw [hs] at hle
    exact eq_top_iff.2 fun y _ => hle Algebra.mem_top

end GenericFreeness

/-- Generic freeness: a module of finite type over an algebra of finite type over a noetherian
domain `A` becomes free over `A_f` after inverting one non-zero `f ∈ A`. -/
@[blueprint "compat:generic-freeness"
  (statement := /-- Let $A$ be a noetherian integral domain, $S$ an $A$-algebra of finite type
    and $M$ an $S$-module of finite type. Then there is a non-zero $f\in A$ such that $M_f$ is
    a free $A_f$-module. (This is \cref{lem:II.1-3}, which the paper cites.) -/)
  (proof := /-- Induction on the number $n$ of generators of $S$ as an $A$-algebra. For $n=0$,
    $S$ is a quotient of $A$, so $M$ is an $A$-module of finite type; apply
    \cref{compat:generic-freeness-finite}. For the induction step let $S'\subseteq S$ be the
    subalgebra generated by the first $n$ generators and $x$ the last one, so $S=S'[x]$; $S'$
    is noetherian, being of finite type over $A$. Let $m_1,\dots,m_k$ generate $M$ over $S$.
    Put $M_0=\sum S'm_i$ and $M_j=M_0+xM_0+\dots+x^jM_0$, an increasing sequence of
    $S'$-submodules of $M$; their union is stable under $S'$ and $x$, hence under $S$, so it is
    $M$. Multiplication by $x^j$ maps $M_0$ onto $M_j/M_{j-1}$ with kernel
    $K_j=\{m\in M_0: x^jm\in M_{j-1}\}$; the $K_j$ increase (as $xM_{j-1}\subseteq M_j$), so
    they are constant for $j\ge j_0$ since $M_0$ is a noetherian $S'$-module. The induction
    hypothesis, applied to the $S'$-modules of finite type $M_0$ and $M_0/K_j$, gives non-zero
    $f_0,\dots,f_{j_0}$ with $(M_0)_{f_0}$ and $(M_0/K_j)_{f_j}$ free. With
    $f=f_0\cdots f_{j_0}$, $(M_0)_f$ and all $(M_j/M_{j-1})_f\cong(M_0/K_{\min(j,j_0)})_f$ are
    free (freeness of $N_g$ implies freeness of $N_{gh}$), and $M_f$ is free by
    \cref{compat:free-localization-filtration}. -/)
  (latexEnv := "theorem")]
theorem exists_free_localizedModule_of_finiteType (A : Type u) [CommRing A] [IsDomain A]
    [IsNoetherianRing A] (S : Type u) [CommRing S] [Algebra A S] [Algebra.FiniteType A S]
    (M : Type u) [AddCommGroup M] [Module S M] [Module A M] [IsScalarTower A S M]
    [Module.Finite S M] :
    ∃ f : A, f ≠ 0 ∧
      Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  -- Enumerate a finite set of generators of `S` and apply the induction.
  obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := A) (A := S)
  refine GenericFreeness.exists_free_of_adjoin_fin A t.card S
    (fun i => (t.equivFin.symm i : S)) ?_ M
  rw [← ht]
  congr 1
  ext y
  constructor
  · rintro ⟨i, rfl⟩
    exact (t.equivFin.symm i).2
  · intro hy
    exact ⟨t.equivFin ⟨y, hy⟩, by simp⟩

end Hironaka

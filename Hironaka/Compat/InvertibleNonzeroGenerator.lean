module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Architect
public import Hironaka.Ch0.AlgebraicScheme
public import Hironaka.Compat.CodimOneInvertible
public import Hironaka.Compat.IdealSheafStalk

/-!
# "Invertible" versus "locally generated by a single non-zero element" (Ch. II §2, Corollary 2, p. 197)

> Let us suppose that the sheaf of ideals of V on X is invertible, i.e., locally everywhere
> generated by a single non-zero element. (Corollary 2 of Theorem 2, p. 197)

The project's `Subscheme.IsInvertibleIdeal` asks for local generators that are non-zero-divisors
(Ch. 0 §2, "locally isomorphic to `O_X`").  On a non-singular scheme every local ring is a domain, and
a section whose germ at `x` is non-zero is a non-zero-divisor near `x`; the two readings agree.  This
module proves the equivalence:

* `Subscheme.isInvertibleIdeal_iff_forall_exists_ne_zero`: for a non-singular, locally noetherian
  scheme `X` and a subscheme `D`, the ideal sheaf of `D` is invertible iff every point `x` has an affine
  neighbourhood `U` and a section `a ∈ Γ(X, U)` with `D(U) = (a)` and non-zero germ at `x`.

Deviation from the paper (gap filled): the paper uses "invertible, i.e., locally everywhere generated by a
single non-zero element" (p. 197; Ch. 0 §2, p. 123: "invertible" means locally isomorphic to `O`) as one
notion; the equivalence of the two readings used by Lean is not argued.
-/

@[expose] public section

open AlgebraicGeometry
open scoped nonZeroDivisors

namespace Hironaka

universe u

namespace Subscheme

variable {X : Scheme.{u}}

/-- "The sheaf of ideals of `D` on `X` is invertible, i.e., locally everywhere generated by a single
non-zero element" (Corollary 2 of Theorem 2, p. 197), on a non-singular locally noetherian scheme: the
ideal sheaf has a local generator that is a non-zero-divisor (`IsInvertibleIdeal`) if and only if it has a
local generator whose germ at the point is non-zero.  Both directions are stalkwise: in the domain
`O_{X,x}` a non-zero element is a non-zero-divisor, and conversely the germ of a non-zero-divisor of
`Γ(X, U)` generating `D(U)` is a non-zero-divisor, hence non-zero, in `O_{X,x}`.

Deviation from the paper (gap filled): the paper treats the two readings as one. -/
@[blueprint "lem:II.2-invertible-nonzero-generator"
  (statement := /-- Let $X$ be a non-singular locally noetherian scheme and $D$ a subscheme. The
    sheaf of ideals of $D$ is invertible (locally generated by a non-zero-divisor) if and only if
    every point $x$ has an affine neighbourhood $U$ and a section $a\in\Gamma(X,U)$ with
    $D(U)=(a)$ whose germ at $x$ is non-zero, i.e.\ if and only if the sheaf of ideals of $D$ is
    ``locally everywhere generated by a single non-zero element''. (Used in Corollary~2 of
    Theorem~2, p.~197.) \textbf{Gap in the paper filled.} The paper treats the two readings (a generator that is a non-zero-divisor, and a generator with non-zero germ) as one. -/)
  (proof := /-- The stalks of $X$ are regular, hence domains, so a non-zero element of
    $\mathcal O_{X,x}$ is a non-zero-divisor. If $D(U)=(a)$ with the germ of $a$ non-zero then
    $D_x=(\bar a)$ with $\bar a$ a non-zero-divisor, and the stalkwise criterion
    (\cref{lem:0.2-codim-one-invertible-stalkwise}) gives invertibility. Conversely if $D(U)=(a)$
    with $a$ a non-zero-divisor, then $D_x=(\bar a)$ with $\bar a$ a non-zero-divisor of
    $\mathcal O_{X,x}$ (\cref{lem:0.2-codim-one-invertible-stalkwise}); two generators of the same stalk
    ideal, one of which is a non-zero-divisor in a non-trivial ring, are both non-zero. -/)
  (proofUses := ["lem:0.2-codim-one-invertible-stalkwise"])
  (latexEnv := "lemma")]
theorem isInvertibleIdeal_iff_forall_exists_ne_zero [IsLocallyNoetherian X] (hX : X.IsNonsingular)
    (D : Subscheme X) :
    D.IsInvertibleIdeal ↔ ∀ x : X, ∃ (U : X.affineOpens) (hx : x ∈ (U : X.Opens)) (a : Γ(X, U)),
      D.ideal U = Ideal.span {a} ∧ X.presheaf.germ U x hx a ≠ 0 := by
  constructor
  · intro hD x
    obtain ⟨U, hxU, a, ha, -⟩ := hD x
    obtain ⟨g, hg, hgnzd⟩ := hD.exists_stalkIdeal_eq_span x
    refine ⟨U, hxU, a, ha, fun h0 => ?_⟩
    rw [stalkIdeal_eq_map_germ_affine D U hxU, ha, Ideal.map_span, Set.image_singleton] at hg
    have : IsRegularLocalRing (X.presheaf.stalk x) := hX x
    have hg0 : g = 0 := by
      have h1 : g ∈ (Ideal.span {X.presheaf.germ (U : X.Opens) x hxU a} : Ideal (X.presheaf.stalk x)) := by
        rw [hg]; exact Ideal.mem_span_singleton_self g
      rw [show X.presheaf.germ (U : X.Opens) x hxU a = 0 from h0, Ideal.span_singleton_eq_bot.mpr rfl,
        Ideal.mem_bot] at h1
      exact h1
    exact zero_notMem_nonZeroDivisors (hg0 ▸ hgnzd)
  · intro h
    refine (isInvertibleIdeal_iff_forall_exists_stalkIdeal_eq_span D).mpr fun x => ?_
    obtain ⟨U, hxU, a, ha, hne⟩ := h x
    have : IsRegularLocalRing (X.presheaf.stalk x) := hX x
    have := isDomain_of_isRegularLocalRing (X.presheaf.stalk x)
    refine ⟨X.presheaf.germ (U : X.Opens) x hxU a, mem_nonZeroDivisors_of_ne_zero hne, ?_⟩
    rw [stalkIdeal_eq_map_germ_affine D U hxU, ha, Ideal.map_span, Set.image_singleton]

end Subscheme

end Hironaka

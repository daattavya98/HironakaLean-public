/-!
# Compatibility layer: the associated graded ring of a regular local ring is a polynomial ring

Hironaka uses constantly the classical identification of `gr_P(R)` with a polynomial ring:

> "We can identify gr_P(R) with the polynomial ring R̄[Z] = R̄[Z₁, …, Z_r] of r variables over
> R̄ = R/P" (Ch. II, Lemma 7, p. 191; also Ch. II §1, p. 183),

> "gr_M(R) can be identified with a polynomial ring k[X] = k[X₁, …, X_n] with k = R/M, in such
> a way that X_j corresponds to the class of x_j" (Ch. III, p. 225).

This file proves it, following Matsumura, *Commutative Ring Theory*, Theorems 14.4 and 16.2.

## Contents

* `IsQuasiRegular x`: a family `x` in a commutative ring `A` is *quasi-regular* if every
  homogeneous form `F` of degree `d` with `F(x) ∈ (x)^(d+1)` has all its coefficients in `(x)`.
* `isQuasiRegular_of_isWeaklyRegular`: a (weakly) regular sequence is quasi-regular (Matsumura
  16.2), for an arbitrary commutative ring.  The proof is an induction on the length, splitting
  off one variable with `MvPolynomial.finSuccEquiv`; the key point is that the new element is a
  non-zero-divisor modulo every power of the ideal generated by the others.
* `aeval_mk_injective_of_isQuasiRegular`, `aeval_mk_surjective`: for `x` generating an ideal
  `I`, the `A/I`-algebra map `(A/I)[X] → gr_I(A)`, `X i ↦ [x i]` (class in degree `1`), is always
  surjective, and it is injective iff `x` is quasi-regular (`isQuasiRegular_iff_injective`).
* `isRegular_ofFn_of_minimal`: part of a minimal system of generators of the maximal ideal of a
  regular local ring (in any order) is a regular sequence.
* `assocGraded_aeval_bijective`, `assocGradedAlgEquiv`, `exists_assocGraded_aeval_bijective`:
  if `P` is spanned by part `z₁, …, z_r` of a minimal system of generators of the maximal ideal
  of the regular local ring `R` (e.g. `P` prime with `R/P` regular), then
  `(R/P)[Z₁, …, Z_r] ≅ gr_P(R)`, `Z_i ↦ [z_i]`; `assocGraded_maximalIdeal_aeval_bijective`
  is the case `P = M` with a regular system of parameters.
* Corollaries: `gr_P(R)` is a domain (`isDomain_assocGraded`, `isDomain_assocGraded_maximalIdeal`),
  and initial forms and orders are multiplicative (`initialForm_mul_of_isRegularLocalRing`,
  `ordElem_mul_of_isRegularLocalRing`); the latter hold for any ideal `I` with `gr_I(A)` a
  domain (`initialForm_mul_of_isDomain`, `ordElem_mul_of_isDomain`).
-/

@[expose] public section

open IsLocalRing MvPolynomial

namespace Hironaka

universe u

/-! ## Quasi-regular families -/

section QuasiRegular

variable {A : Type u} [CommRing A]

/-- A family `x : σ → A` is *quasi-regular* (Matsumura, §16) if every homogeneous form `F` of
degree `d` with coefficients in `A` such that `F(x) ∈ Iᵈ⁺¹`, where `I = (x)`, has all its
coefficients in `I`.  Equivalently, `(A/I)[X] → gr_I(A)`, `X i ↦ [x i]`, is injective
(`isQuasiRegular_iff_injective`). -/
def IsQuasiRegular {σ : Type*} (x : σ → A) : Prop :=
  ∀ (d : ℕ) (F : MvPolynomial σ A), F.IsHomogeneous d →
    eval x F ∈ Ideal.span (Set.range x) ^ (d + 1) → ∀ m, F.coeff m ∈ Ideal.span (Set.range x)

/-- If `K` is homogeneous of degree `d` with coefficients in `J`, then `K(y) ∈ J · (y)ᵈ`. -/
theorem eval_mem_mul_span_pow_of_coeff_mem {σ : Type*} {y : σ → A} {J : Ideal A} {d : ℕ}
    {K : MvPolynomial σ A} (hK : K.IsHomogeneous d) (hc : ∀ m, K.coeff m ∈ J) :
    eval y K ∈ J * Ideal.span (Set.range y) ^ d := by
  rw [K.as_sum, map_sum]
  refine Ideal.sum_mem _ fun m hm => ?_
  rw [← mul_one (K.coeff m), ← C_mul_monomial, eval_mul, eval_C]
  refine Ideal.mul_mem_mul (hc m) ((Ideal.mem_span_pow_iff_exists_isHomogeneous y _).mpr
    ⟨monomial m 1, isHomogeneous_monomial 1 ?_, rfl⟩)
  by_contra h
  exact (mem_support_iff.mp hm) (hK.coeff_eq_zero h)

/-- A family indexed by an empty type is quasi-regular. -/
theorem isQuasiRegular_of_isEmpty {σ : Type*} [IsEmpty σ] (x : σ → A) : IsQuasiRegular x := by
  intro d F _ hF m
  have hx : Ideal.span (Set.range x) = ⊥ := by simp [Set.range_eq_empty]
  rw [hx, Ideal.bot_pow (Nat.succ_ne_zero d), Ideal.mem_bot, F.eq_C_of_isEmpty, eval_C] at hF
  rw [hx, Ideal.mem_bot, Subsingleton.elim m 0]
  exact hF

/-- Quasi-regularity only depends on the family up to reindexing. -/
theorem IsQuasiRegular.of_comp_equiv {σ τ : Type*} {x : σ → A} (e : τ ≃ σ)
    (h : IsQuasiRegular (x ∘ e)) : IsQuasiRegular x := by
  intro d F hF hFx m
  have hrange : Set.range (x ∘ e) = Set.range x := by
    rw [Set.range_comp, e.range_eq_univ, Set.image_univ]
  have hcomp : (x ∘ e) ∘ e.symm = x := by
    funext i
    simp
  have := h d (rename e.symm F) (hF.rename_isHomogeneous)
    (by rwa [eval_rename, hcomp, hrange]) (m.mapDomain e.symm)
  rwa [coeff_rename_mapDomain _ e.symm.injective, hrange] at this

/-- The inductive step of Matsumura's Theorem 16.2: if `x₁, …, x_n` is quasi-regular and `x₀`
is a non-zero-divisor modulo `(x₁, …, x_n)`, then `x₀, x₁, …, x_n` is quasi-regular.

The proof first shows that `x₀` is a non-zero-divisor modulo every power `I'ᵏ`,
`I' = (x₁, …, x_n)` (by induction on `k`, using quasi-regularity of `x₁, …, x_n`), and then
proves the claim for `F = Σₖ X₀ᵏ Φₖ(X₁, …, X_n)` by induction on the degree, using
`Iᵈ⁺¹ ⊆ I'ᵈ⁺¹ + x₀ Iᵈ`. -/
theorem isQuasiRegular_cons {n : ℕ} (x : Fin (n + 1) → A)
    (h0 : ∀ a, x 0 * a ∈ Ideal.span (Set.range (Fin.tail x)) →
      a ∈ Ideal.span (Set.range (Fin.tail x)))
    (ht : IsQuasiRegular (Fin.tail x)) : IsQuasiRegular x := by
  have hI : Ideal.span (Set.range x) =
      Ideal.span {x 0} ⊔ Ideal.span (Set.range (Fin.tail x)) := by
    rw [Fin.range_fin_succ, Ideal.span_insert]
  set x' := Fin.tail x with hx'
  set I' := Ideal.span (Set.range x') with hI'
  set I := Ideal.span (Set.range x) with hIdef
  have hI'I : I' ≤ I := hI ▸ le_sup_right
  have hx0I : x 0 ∈ I := hI ▸ Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  -- (a) `x₀` is a non-zero-divisor modulo every power of `I'`
  have hreg : ∀ (k : ℕ) (a : A), x 0 * a ∈ I' ^ k → a ∈ I' ^ k := by
    intro k
    induction k with
    | zero => intro a _; simp
    | succ k ih =>
      intro a hxa
      obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous x' a).mp
        (ih a (Ideal.pow_le_pow_right (Nat.le_succ k) hxa))
      have hc : ∀ m, K.coeff m ∈ I' := by
        intro m
        refine h0 _ ?_
        have := ht k (C (x 0) * K) (hK.C_mul _) (by rwa [eval_mul, eval_C])
        simpa [coeff_C_mul] using this m
      rw [pow_succ']
      exact eval_mem_mul_span_pow_of_coeff_mem hK hc
  -- (b) `I^(d+1) ⊆ I'^(d+1) + x₀ Iᵈ`
  have hpow : ∀ d : ℕ, I ^ (d + 1) ≤ I' ^ (d + 1) ⊔ Ideal.span {x 0} * I ^ d := by
    intro d
    induction d with
    | zero =>
      rw [zero_add, pow_one, pow_one, pow_zero, Ideal.one_eq_top, Ideal.mul_top, hI, sup_comm]
    | succ d ihd =>
      calc I ^ (d + 1 + 1) = I ^ (d + 1) * I := pow_succ _ _
        _ ≤ (I' ^ (d + 1) ⊔ Ideal.span {x 0} * I ^ d) * I := Ideal.mul_mono_left ihd
        _ = I' ^ (d + 1) * I ⊔ Ideal.span {x 0} * I ^ (d + 1) := by
            rw [Ideal.sup_mul, mul_assoc, ← pow_succ]
        _ ≤ I' ^ (d + 1 + 1) ⊔ Ideal.span {x 0} * I ^ (d + 1) := by
            refine sup_le ?_ le_sup_right
            have : I' ^ (d + 1) * I = I' ^ (d + 1) * Ideal.span {x 0} ⊔ I' ^ (d + 1 + 1) := by
              rw [hI, Ideal.mul_sup, ← pow_succ]
            rw [this]
            refine sup_le (le_sup_of_le_right ?_) le_sup_left
            rw [mul_comm]
            exact Ideal.mul_mono_right (Ideal.pow_right_mono hI'I _)
  -- (c) the statement for `Φ = Σₖ X₀ᵏ Φₖ`, by induction on the degree
  have key : ∀ (d : ℕ) (Φ : Polynomial (MvPolynomial (Fin n) A)),
      (∀ k, (Φ.coeff k).IsHomogeneous (d - k)) → (∀ k, d < k → Φ.coeff k = 0) →
      Polynomial.eval (x 0) (Φ.map (eval x')) ∈ I ^ (d + 1) →
      ∀ k m, (Φ.coeff k).coeff m ∈ I := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ihd =>
    intro Φ hhom hvan hmem
    set h := Polynomial.eval (x 0) ((Polynomial.divX Φ).map (eval x')) with hh
    have hsplit : Polynomial.eval (x 0) (Φ.map (eval x')) = eval x' (Φ.coeff 0) + x 0 * h := by
      conv_lhs => rw [← Polynomial.divX_mul_X_add Φ]
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_X, Polynomial.map_C,
        Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C, hh]
      ring
    have hΦ0hom : (Φ.coeff 0).IsHomogeneous d := by simpa using hhom 0
    obtain ⟨u, hu, w, hw, huw⟩ := Submodule.mem_sup.mp (hpow d hmem)
    obtain ⟨v, hv, rfl⟩ := Ideal.mem_span_singleton_mul.mp hw
    rw [hsplit] at huw
    have hΦ0 : eval x' (Φ.coeff 0) ∈ I' ^ d :=
      (Ideal.mem_span_pow_iff_exists_isHomogeneous x' _).mpr ⟨_, hΦ0hom, rfl⟩
    have hvh : v - h ∈ I' ^ d := by
      refine hreg d _ ?_
      have : x 0 * (v - h) = eval x' (Φ.coeff 0) - u := by linear_combination huw
      rw [this]
      exact sub_mem hΦ0 (Ideal.pow_le_pow_right (Nat.le_succ d) hu)
    -- the coefficients of `X₀^(k+1)`
    have hhigh : ∀ k m, (Φ.coeff (k + 1)).coeff m ∈ I := by
      intro k m
      rcases Nat.eq_zero_or_pos d with hd | hd
      · rw [hvan (k + 1) (by omega)]
        simp
      · obtain ⟨e, rfl⟩ : ∃ e, d = e + 1 := ⟨d - 1, by omega⟩
        have hhI : h ∈ I ^ (e + 1) := by
          have : h = v - (v - h) := by ring
          rw [this]
          exact sub_mem hv (Ideal.pow_right_mono hI'I _ hvh)
        have := ihd e (by omega) (Polynomial.divX Φ)
          (fun k => by
            rw [Polynomial.coeff_divX]
            have := hhom (k + 1)
            rwa [show e + 1 - (k + 1) = e - k by omega] at this)
          (fun k hk => by rw [Polynomial.coeff_divX]; exact hvan _ (by omega)) hhI k m
        rwa [Polynomial.coeff_divX] at this
    -- the coefficients of `X₀⁰`
    obtain ⟨K, hK, hKe⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous x' (v - h)).mp hvh
    have hlow : ∀ m, (Φ.coeff 0 - C (x 0) * K).coeff m ∈ I' := by
      refine ht d _ (hΦ0hom.sub (hK.C_mul _)) ?_
      rw [eval_sub, eval_mul, eval_C, hKe]
      have : eval x' (Φ.coeff 0) - x 0 * (v - h) = u := by linear_combination -huw
      rw [this]
      exact hu
    intro k m
    cases k with
    | zero =>
      have : (Φ.coeff 0).coeff m = (Φ.coeff 0 - C (x 0) * K).coeff m + x 0 * K.coeff m := by
        rw [coeff_sub, coeff_C_mul]
        ring
      rw [this]
      exact add_mem (hI'I (hlow m)) (Ideal.mul_mem_right _ _ hx0I)
    | succ k => exact hhigh k m
  -- conclusion, via `A[X₀, …, X_n] ≅ A[X₁, …, X_n][X₀]`
  intro d F hF hFx m
  have hvan : ∀ k, d < k → (finSuccEquiv A n F).coeff k = 0 := by
    intro k hk
    by_contra hne
    have h1 := totalDegree_coeff_finSuccEquiv_add_le F k hne
    have h2 := hF.totalDegree_le
    omega
  have hhom : ∀ k, ((finSuccEquiv A n F).coeff k).IsHomogeneous (d - k) := by
    intro k
    by_cases hk : k ≤ d
    · exact hF.finSuccEquiv_coeff_isHomogeneous k (d - k) (by omega)
    · rw [hvan k (by omega)]
      exact isHomogeneous_zero _ _ _
  have heval : eval x F = Polynomial.eval (x 0) ((finSuccEquiv A n F).map (eval x')) := by
    have := eval_eq_eval_mv_eval' x' (x 0) F
    rwa [hx', Fin.cons_self_tail] at this
  have := key d (finSuccEquiv A n F) hhom hvan (heval ▸ hFx) (m 0) m.tail
  rwa [finSuccEquiv_coeff_coeff, Finsupp.cons_tail] at this

/-- A family `x₀, …, x_{n-1}` in which each `x_i` is a non-zero-divisor modulo the ideal
generated by the `x_j` with `j > i` is quasi-regular (induction on `n`, `isQuasiRegular_cons`). -/
theorem isQuasiRegular_of_forall_gt : ∀ {n : ℕ} (x : Fin n → A),
    (∀ i a, x i * a ∈ Ideal.span (x '' {j | i < j}) → a ∈ Ideal.span (x '' {j | i < j})) →
    IsQuasiRegular x
  | 0, x, _ => isQuasiRegular_of_isEmpty x
  | n + 1, x, h => by
    refine isQuasiRegular_cons x (fun a ha => ?_)
      (isQuasiRegular_of_forall_gt (Fin.tail x) fun i a ha => ?_)
    · have hset : x '' {j | 0 < j} = Set.range (Fin.tail x) := by
        ext y
        constructor
        · rintro ⟨j, hj, rfl⟩
          obtain ⟨j', rfl⟩ := Fin.exists_succ_eq.mpr (Fin.pos_iff_ne_zero.mp hj)
          exact ⟨j', rfl⟩
        · rintro ⟨j', rfl⟩
          exact ⟨j'.succ, Fin.succ_pos j', rfl⟩
      rw [← hset] at ha ⊢
      exact h 0 a ha
    · have hset : Fin.tail x '' {j | i < j} = x '' {j | i.succ < j} := by
        ext y
        constructor
        · rintro ⟨j, hj, rfl⟩
          exact ⟨j.succ, Fin.succ_lt_succ_iff.mpr hj, rfl⟩
        · rintro ⟨j, hj, rfl⟩
          obtain ⟨j', rfl⟩ := Fin.exists_succ_eq.mpr ((Fin.succ_pos i).trans hj).ne'
          exact ⟨j', Fin.succ_lt_succ_iff.mp hj, rfl⟩
      rw [hset] at ha ⊢
      exact h i.succ a ha

/-- Elementwise form of weak regularity of `List.ofFn x`: each `x i` is a non-zero-divisor
modulo the ideal generated by the `x j` with `j < i`. -/
theorem isWeaklyRegular_ofFn_iff {n : ℕ} (x : Fin n → A) :
    RingTheory.Sequence.IsWeaklyRegular A (List.ofFn x) ↔
      ∀ i a, x i * a ∈ Ideal.span (x '' {j | j < i}) → a ∈ Ideal.span (x '' {j | j < i}) := by
  have hsub : ∀ i : Fin n, (Ideal.ofList ((List.ofFn x).take i) • ⊤ : Submodule A A) =
      Ideal.span (x '' {j | j < i}) := by
    intro i
    rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.ofList]
    congr 1
    ext r
    constructor
    · intro hr
      obtain ⟨j, hj, rfl⟩ := List.mem_take_iff_getElem.mp hr
      simp only [List.length_ofFn] at hj
      exact ⟨⟨j, by omega⟩, Fin.lt_def.mpr (by simp only; omega), by simp⟩
    · rintro ⟨j, hj, rfl⟩
      refine List.mem_take_iff_getElem.mpr ⟨j, ?_, by simp⟩
      have := Fin.lt_def.mp hj
      simp only [List.length_ofFn]
      omega
  rw [RingTheory.Sequence.isWeaklyRegular_iff]
  constructor
  · intro h i a ha
    have := (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp (h i (by simp)) a
    rw [hsub i, List.getElem_ofFn] at this
    exact this ha
  · intro h i hi
    have hi' : i < n := by simpa using hi
    rw [List.getElem_ofFn, isSMulRegular_quotient_iff_mem_of_smul_mem]
    have := hsub ⟨i, hi'⟩
    simp only at this
    rw [this]
    exact h ⟨i, hi'⟩

/-- **Regular sequences are quasi-regular** (Matsumura, Theorem 16.2): if `x₁, …, x_r` is a
(weakly) regular sequence in a commutative ring `A` and `I = (x₁, …, x_r)`, then every
homogeneous form `F ∈ A[X₁, …, X_r]` of degree `ν` with `F(x) ∈ I^(ν+1)` has all its
coefficients in `I`. -/
@[blueprint "thm:regular-sequence-quasi-regular"
  (statement := /-- Let $A$ be a commutative ring, $x_1,\dots,x_r$ a (weakly) regular sequence
    in $A$ (each $x_i$ is a non-zero-divisor modulo $(x_1,\dots,x_{i-1})$) and
    $I=(x_1,\dots,x_r)$. Then $x_1,\dots,x_r$ is \emph{quasi-regular}: if
    $F\in A[X_1,\dots,X_r]$ is homogeneous of degree $\nu$ and $F(x_1,\dots,x_r)\in I^{\nu+1}$,
    then all coefficients of $F$ lie in $I$. Equivalently, the surjective homomorphism of graded
    $A/I$-algebras $(A/I)[X_1,\dots,X_r]\to\operatorname{gr}_I(A)$
    (\cref{def:II.1-associated-graded-algebra}) sending $X_i$ to the class of $x_i$ in
    $I/I^2$ is an isomorphism. (Matsumura, \emph{Commutative Ring Theory}, Thm.~16.2.) -/)
  (proof := /-- Induction on $r$, the case $r=0$ being trivial. Put
    $I'=(x_1,\dots,x_{r-1})$; by induction $x_1,\dots,x_{r-1}$ is quasi-regular, and $x_r$ is a
    non-zero-divisor modulo $I'$. First, $x_r$ is a non-zero-divisor modulo every $I'^k$: if
    $x_ra\in I'^{k+1}$ then $a\in I'^k$ by induction on $k$, say $a=G(x')$ with $G$ homogeneous
    of degree $k$; quasi-regularity applied to $x_rG$ shows that the coefficients $x_rc$ of
    $x_rG$ lie in $I'$, hence $c\in I'$ and $a\in I'^{k+1}$. Next write a form $F$ of degree $d$
    as $F=G(X_1,\dots,X_{r-1})+X_rH$ with $F(x)\in I^{d+1}=I'^{d+1}+x_rI^d$, say
    $F(x)=u+x_rv$. Then $x_r(v-H(x))=G(x')-u\in I'^d$, so $v-H(x)\in I'^d$; hence
    $H(x)\in I^d$ and the coefficients of $H$ lie in $I$ by induction on $d$. Writing
    $v-H(x)=K(x')$ with $K$ homogeneous of degree $d$, we get $(G-x_rK)(x')=u\in I'^{d+1}$, so
    the coefficients of $G-x_rK$, hence those of $G$, lie in $I'+x_rA=I$. The equivalence with
    injectivity of $(A/I)[X]\to\operatorname{gr}_I(A)$ follows by comparing homogeneous
    components; surjectivity holds because $I^n$ is generated by the monomials of degree $n$
    in the $x_i$. -/)
  (latexEnv := "theorem")]
theorem isQuasiRegular_of_isWeaklyRegular {n : ℕ} (x : Fin n → A)
    (hx : RingTheory.Sequence.IsWeaklyRegular A (List.ofFn x)) : IsQuasiRegular x := by
  have h := (isWeaklyRegular_ofFn_iff x).mp hx
  refine IsQuasiRegular.of_comp_equiv Fin.revPerm
    (isQuasiRegular_of_forall_gt _ fun i a ha => ?_)
  have hset : (x ∘ Fin.revPerm) '' {j | i < j} = x '' {j | j < i.rev} := by
    ext y
    constructor
    · rintro ⟨j, hj, rfl⟩
      exact ⟨j.rev, Fin.rev_lt_rev.mpr hj, by simp⟩
    · rintro ⟨j, hj, rfl⟩
      refine ⟨j.rev, ?_, by simp⟩
      have := Fin.rev_lt_rev.mpr hj
      rwa [Fin.rev_rev] at this
  rw [hset] at ha ⊢
  exact h i.rev a (by simpa using ha)

end QuasiRegular

/-! ## The map `(A/I)[X] → gr_I(A)` -/

section GradedMap

variable {A : Type u} [CommRing A] {σ : Type*} (I : Ideal A) (x : σ → A) (hx : ∀ i, x i ∈ I ^ 1)

/-- The quotient map `reesAlgebra I → gr_I(A)` (`AssocGraded I` is this quotient). -/
noncomputable def AssocGraded.ofRees : reesAlgebra I →+* AssocGraded I :=
  Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I)

theorem AssocGraded.ofRees_monomial (n : ℕ) (a : A) (ha : a ∈ I ^ n) :
    AssocGraded.ofRees I ⟨Polynomial.monomial n a, reesAlgebra.monomial_mem.mpr ha⟩ =
      AssocGraded.mk I n a ha := rfl

/-- `[p] = 0` in `gr_I(A)` iff the `n`-th coefficient of `p` lies in `Iⁿ⁺¹` for all `n`. -/
theorem AssocGraded.ofRees_eq_zero_iff (p : reesAlgebra I) :
    AssocGraded.ofRees I p = 0 ↔ ∀ n, (p : Polynomial A).coeff n ∈ I ^ (n + 1) :=
  (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.map (algebraMap A (reesAlgebra I)) I)).trans
    (mem_map_algebraMap_reesAlgebra_iff p)

/-- The `A`-algebra map `A[X] → reesAlgebra I ⊆ A[T]`, `X i ↦ x i · T`. -/
noncomputable def reesPolyMap : MvPolynomial σ A →ₐ[A] reesAlgebra I :=
  aeval fun i => ⟨Polynomial.monomial 1 (x i), reesAlgebra.monomial_mem.mpr (hx i)⟩

theorem coe_reesPolyMap (K : MvPolynomial σ A) :
    (reesPolyMap I x hx K : Polynomial A) = aeval (fun i => Polynomial.monomial 1 (x i)) K := by
  show (reesAlgebra I).val (aeval _ K) = _
  rw [← AlgHom.comp_apply, comp_aeval]
  rfl

/-- `X i ↦ x i · T` sends the monomial `r X^m` to `r x^m T^|m|`. -/
theorem aeval_monomial_one_monomial (m : σ →₀ ℕ) (r : A) :
    aeval (fun i => Polynomial.monomial 1 (x i)) (monomial m r) =
      Polynomial.monomial m.degree (eval x (monomial m r)) := by
  induction m using Finsupp.induction generalizing r with
  | zero => simp [Polynomial.monomial_zero_left]
  | single_add a b f _ _ ih =>
    rw [monomial_single_add, map_mul, map_mul, ih, map_pow, map_pow, aeval_X, eval_X,
      Polynomial.monomial_pow, Polynomial.monomial_mul_monomial, map_add, Finsupp.degree_single,
      one_mul]

/-- The coefficient of `Tᵏ` in the image of `K` is the value at `x` of the homogeneous component
of degree `k` of `K`. -/
theorem coeff_coe_reesPolyMap (K : MvPolynomial σ A) (k : ℕ) :
    (reesPolyMap I x hx K : Polynomial A).coeff k = eval x (homogeneousComponent k K) := by
  induction K using MvPolynomial.induction_on' with
  | monomial m r =>
    rw [coe_reesPolyMap, aeval_monomial_one_monomial, Polynomial.coeff_monomial,
      homogeneousComponent_of_mem (isHomogeneous_monomial r rfl)]
    by_cases h : m.degree = k
    · simp [h]
    · simp [h, Ne.symm h]
  | add p q hp hq =>
    rw [map_add, map_add, map_add, ← hp, ← hq, Subalgebra.coe_add, Polynomial.coeff_add]

theorem coe_reesPolyMap_of_isHomogeneous {K : MvPolynomial σ A} {d : ℕ}
    (hK : K.IsHomogeneous d) :
    (reesPolyMap I x hx K : Polynomial A) = Polynomial.monomial d (eval x K) := by
  ext k
  rw [coeff_coe_reesPolyMap, homogeneousComponent_of_mem hK, Polynomial.coeff_monomial]
  by_cases h : k = d
  · simp [h]
  · simp [h, Ne.symm h]

include hx in
/-- The value at `x` of a homogeneous form of degree `d` lies in `Iᵈ`. -/
theorem eval_mem_pow_of_isHomogeneous {K : MvPolynomial σ A} {d : ℕ} (hK : K.IsHomogeneous d) :
    eval x K ∈ I ^ d := by
  have hle : Ideal.span (Set.range x) ≤ I := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simpa using hx i
  exact Ideal.pow_right_mono hle d
    ((Ideal.mem_span_pow_iff_exists_isHomogeneous x _).mpr ⟨K, hK, rfl⟩)

/-- `(A/I)[X] → gr_I(A)` composed with reduction of coefficients `A[X] → (A/I)[X]` is
`A[X] → reesAlgebra I → gr_I(A)`. -/
theorem aeval_mk_map (K : MvPolynomial σ A) :
    aeval (R := A ⧸ I) (fun i => AssocGraded.mk I 1 (x i) (hx i))
        (K.map (Ideal.Quotient.mk I)) =
      AssocGraded.ofRees I (reesPolyMap I x hx K) := by
  have : (aeval (R := A ⧸ I) fun i => AssocGraded.mk I 1 (x i) (hx i)).toRingHom.comp
      (MvPolynomial.map (Ideal.Quotient.mk I)) =
      (AssocGraded.ofRees I).comp (reesPolyMap I x hx).toRingHom := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp only [RingHom.coe_comp, Function.comp_apply, map_C, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, aeval_C, reesPolyMap]
      show AssocGraded.algebraMapQuot I (Ideal.Quotient.mk I a) = _
      rw [AssocGraded.algebraMapQuot, Ideal.Quotient.lift_mk]
      rfl
    · simp only [RingHom.coe_comp, Function.comp_apply, map_X, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, aeval_X, reesPolyMap]
      rfl
  exact RingHom.congr_fun this K

/-- The image in `gr_I(A)` of (the reduction of) a homogeneous form `K` of degree `d` is the
class of `K(x)` in `Iᵈ/Iᵈ⁺¹`. -/
theorem aeval_mk_map_of_isHomogeneous {K : MvPolynomial σ A} {d : ℕ}
    (hK : K.IsHomogeneous d) :
    aeval (R := A ⧸ I) (fun i => AssocGraded.mk I 1 (x i) (hx i))
        (K.map (Ideal.Quotient.mk I)) =
      AssocGraded.mk I d (eval x K) (eval_mem_pow_of_isHomogeneous I x hx hK) := by
  rw [aeval_mk_map, ← AssocGraded.ofRees_monomial]
  exact congrArg (AssocGraded.ofRees I) (Subtype.ext (coe_reesPolyMap_of_isHomogeneous I x hx hK))

/-- If `x` generates `I`, then `(A/I)[X] → gr_I(A)`, `X i ↦ [x i]`, is surjective: `gr_I(A)` is
generated by the classes of the monomials in the `x i` (`Iⁿ` is spanned by the values of forms
of degree `n`). -/
theorem aeval_mk_surjective (hI : Ideal.span (Set.range x) = I) :
    Function.Surjective (aeval (R := A ⧸ I) fun i => AssocGraded.mk I 1 (x i) (hx i)) := by
  have hmem : ∀ (n : ℕ) (a : A) (ha : a ∈ I ^ n), AssocGraded.mk I n a ha ∈
      (aeval (R := A ⧸ I) fun i => AssocGraded.mk I 1 (x i) (hx i)).range := by
    intro n a ha
    obtain ⟨K, hK, rfl⟩ :=
      (Ideal.mem_span_pow_iff_exists_isHomogeneous x a).mp (by rw [hI]; exact ha)
    exact ⟨K.map (Ideal.Quotient.mk I), aeval_mk_map_of_isHomogeneous I x hx hK⟩
  intro φ
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective φ
  refine (AlgHom.mem_range _).mp ?_
  rw [mk_eq_sum_mk]
  exact Subalgebra.sum_mem _ fun i _ => hmem _ _ _

/-- If `x` generates `I` and is quasi-regular, then `(A/I)[X] → gr_I(A)` is injective. -/
theorem aeval_mk_injective_of_isQuasiRegular (hqr : IsQuasiRegular x)
    (hI : Ideal.span (Set.range x) = I) :
    Function.Injective (aeval (R := A ⧸ I) fun i => AssocGraded.mk I 1 (x i) (hx i)) := by
  rw [injective_iff_map_eq_zero]
  intro p hp
  obtain ⟨K, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective p
  rw [aeval_mk_map, AssocGraded.ofRees_eq_zero_iff] at hp
  ext m
  suffices K.coeff m ∈ I by simpa [coeff_map, Ideal.Quotient.eq_zero_iff_mem] using this
  have hk : eval x (homogeneousComponent m.degree K) ∈
      Ideal.span (Set.range x) ^ (m.degree + 1) := by
    rw [hI, ← coeff_coe_reesPolyMap I x hx]
    exact hp m.degree
  have := hqr m.degree _ (homogeneousComponent_isHomogeneous _ _) hk m
  simpa [coeff_homogeneousComponent, hI] using this

/-- Quasi-regularity of a generating family `x` of `I` is equivalent to injectivity of
`(A/I)[X] → gr_I(A)`, `X i ↦ [x i]`. -/
theorem isQuasiRegular_iff_injective (hI : Ideal.span (Set.range x) = I) :
    IsQuasiRegular x ↔
      Function.Injective (aeval (R := A ⧸ I) fun i => AssocGraded.mk I 1 (x i) (hx i)) := by
  refine ⟨fun h => aeval_mk_injective_of_isQuasiRegular I x hx h hI, fun h d F hF hFx m => ?_⟩
  rw [hI] at hFx ⊢
  have h0 : F.map (Ideal.Quotient.mk I) = 0 := by
    apply h
    rw [map_zero, aeval_mk_map_of_isHomogeneous I x hx hF, AssocGraded.mk_eq_zero_iff]
    exact hFx
  have := congrArg (fun p => p.coeff m) h0
  simpa [coeff_map, Ideal.Quotient.eq_zero_iff_mem] using this

/-- For a (weakly) regular sequence `x` generating `I`, the `A/I`-algebra map
`(A/I)[X₁, …, X_n] → gr_I(A)`, `X i ↦ [x i]`, is bijective. -/
@[blueprint "thm:regular-sequence-quasi-regular"
  (statement := /-- Let $A$ be a commutative ring, $x_1,\dots,x_r$ a (weakly) regular sequence
    in $A$ and $I=(x_1,\dots,x_r)$. Then the homomorphism of graded $A/I$-algebras
    $(A/I)[X_1,\dots,X_r]\to\operatorname{gr}_I(A)$ sending $X_i$ to the class of $x_i$ in
    $I/I^2$ is an isomorphism. -/)
  (latexEnv := "theorem")]
theorem aeval_mk_bijective_of_isWeaklyRegular {n : ℕ} {x : Fin n → A}
    (hreg : RingTheory.Sequence.IsWeaklyRegular A (List.ofFn x))
    (hI : Ideal.span (Set.range x) = I) (hx : ∀ i, x i ∈ I ^ 1) :
    Function.Bijective (aeval (R := A ⧸ I) fun i => AssocGraded.mk I 1 (x i) (hx i)) :=
  ⟨aeval_mk_injective_of_isQuasiRegular I x hx (isQuasiRegular_of_isWeaklyRegular x hreg) hI,
    aeval_mk_surjective I x hx hI⟩

end GradedMap

/-! ## Initial forms and orders when `gr_I(A)` is a domain -/

section InitialForm

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- `[a Xᵐ] · [b Xⁿ] = [ab Xᵐ⁺ⁿ]` in `gr_I(A)`. -/
theorem AssocGraded.mk_mul_mk {m n : ℕ} {a b : A} (ha : a ∈ I ^ m) (hb : b ∈ I ^ n) :
    AssocGraded.mk I m a ha * AssocGraded.mk I n b hb =
      AssocGraded.mk I (m + n) (a * b) (by rw [pow_add]; exact Ideal.mul_mem_mul ha hb) := by
  rw [← AssocGraded.ofRees_monomial, ← AssocGraded.ofRees_monomial, ← map_mul,
    ← AssocGraded.ofRees_monomial]
  exact congrArg _ (Subtype.ext (Polynomial.monomial_mul_monomial m n a b))

/-- If `gr_I(A)` is a domain and `ν_I(f) = a`, `ν_I(g) = b` are finite, then `ν_I(fg) = a + b`
(the product of the non-zero classes of `f` in `Iᵃ/Iᵃ⁺¹` and of `g` in `Iᵇ/Iᵇ⁺¹` is the class
of `fg` in `Iᵃ⁺ᵇ/Iᵃ⁺ᵇ⁺¹`). -/
theorem ordElem_mul_eq_of_isDomain [IsDomain (AssocGraded I)] {f g : A} {a b : ℕ}
    (hf : Ideal.ordElem I f = a) (hg : Ideal.ordElem I g = b) :
    Ideal.ordElem I (f * g) = ((a + b : ℕ) : ℕ∞) := by
  have hne : ∀ {h : A} {c : ℕ} (hc : Ideal.ordElem I h = c),
      AssocGraded.mk I c h (Ideal.mem_pow_of_ordElem hc) ≠ 0 := by
    intro h c hc h0
    rw [AssocGraded.mk_eq_zero_iff] at h0
    have := Ideal.le_ordElem h0
    rw [hc, Nat.cast_le] at this
    omega
  have hprod := mul_ne_zero (hne hf) (hne hg)
  rw [AssocGraded.mk_mul_mk, Ne, AssocGraded.mk_eq_zero_iff] at hprod
  refine le_antisymm (Ideal.ordElem_le_of_notMem hprod) (Ideal.le_ordElem ?_)
  rw [pow_add]
  exact Ideal.mul_mem_mul (Ideal.mem_pow_of_ordElem hf) (Ideal.mem_pow_of_ordElem hg)

/-- If `gr_I(A)` is a domain, then `ν_I(fg) = ν_I(f) + ν_I(g)`. -/
theorem ordElem_mul_of_isDomain [IsDomain (AssocGraded I)] (f g : A) :
    Ideal.ordElem I (f * g) = Ideal.ordElem I f + Ideal.ordElem I g := by
  by_cases hf : Ideal.ordElem I f = ⊤
  · rw [hf, top_add, Ideal.ordElem_eq_top_iff]
    exact fun ν => Ideal.mul_mem_right _ _ (Ideal.ordElem_eq_top_iff.mp hf ν)
  by_cases hg : Ideal.ordElem I g = ⊤
  · rw [hg, add_top, Ideal.ordElem_eq_top_iff]
    exact fun ν => Ideal.mul_mem_left _ _ (Ideal.ordElem_eq_top_iff.mp hg ν)
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp hf
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp hg
  rw [ordElem_mul_eq_of_isDomain I ha.symm hb.symm, ← ha, ← hb, Nat.cast_add]

/-- If `gr_I(A)` is a domain, then the initial form of `fg` is the product of the initial forms
of `f` and `g`. -/
theorem initialForm_mul_of_isDomain [IsDomain (AssocGraded I)] (f g : A) :
    initialForm I (f * g) = initialForm I f * initialForm I g := by
  have htop : ∀ h : A, Ideal.ordElem I h = ⊤ → initialForm I h = 0 := fun h hh => by
    rw [initialForm, dite_eq_left hh]
  by_cases hf : Ideal.ordElem I f = ⊤
  · rw [htop f hf, zero_mul, htop]
    rw [ordElem_mul_of_isDomain, hf, top_add]
  by_cases hg : Ideal.ordElem I g = ⊤
  · rw [htop g hg, mul_zero, htop]
    rw [ordElem_mul_of_isDomain, hg, add_top]
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp hf
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp hg
  rw [initialForm_eq_mk I ha.symm, initialForm_eq_mk I hb.symm, AssocGraded.mk_mul_mk,
    initialForm_eq_mk I (ordElem_mul_eq_of_isDomain I ha.symm hb.symm)]

end InitialForm

/-! ## Regular local rings -/

section RegularLocal

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- An element `a` of a minimal system `S` of generators of the maximal ideal does not lie in
the ideal generated by a subset `T ⊆ S` with `a ∉ T` (otherwise `S \ {a}` would generate `M`
by Nakayama's lemma). -/
theorem notMem_span_of_minimal {S T : Finset R} (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) (hTS : T ⊆ S) {a : R} (haS : a ∈ S)
    (haT : a ∉ T) : a ∉ Ideal.span (T : Set R) := by
  classical
  intro ha
  have hsub : Ideal.span (T : Set R) ≤ Ideal.span ((S.erase a : Finset R) : Set R) :=
    Ideal.span_mono fun y hy =>
      Finset.mem_erase.mpr ⟨fun h => haT (h ▸ Finset.mem_coe.mp hy), hTS (Finset.mem_coe.mp hy)⟩
  have h1 := span_erase_eq_of_mem hS haS (Ideal.mem_sup_left (hsub ha))
  have h2 : (maximalIdeal R).spanFinrank ≤ (S.erase a).card := by
    rw [← h1, ← Set.ncard_coe_finset]
    exact Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)
  have h3 := Finset.card_erase_add_one haS
  omega

/-- If `T ⊆ S`, `S` a minimal system of generators of the maximal ideal, and `a ∈ S \ T`, then `a`
is a non-zero-divisor modulo `(T)`: `ab ∈ (T)` implies `b ∈ (T)` (`(T)` is prime,
`mem_pow_of_mul_mem_pow_of_card_eq` with `ν = 1`). -/
theorem mem_span_of_mul_mem_span_of_minimal {S T : Finset R}
    (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) (hTS : T ⊆ S) {a : R} (haS : a ∈ S)
    (haT : a ∉ T) {b : R} (hab : a * b ∈ Ideal.span (T : Set R)) :
    b ∈ Ideal.span (T : Set R) := by
  have := mem_pow_of_mul_mem_pow_of_card_eq _ R S T hS hScard hTS rfl 1 a b
    (notMem_span_of_minimal hS hScard hTS haS haT) (by rwa [pow_one])
  rwa [pow_one] at this

/-- Family version of `mem_span_of_mul_mem_span_of_minimal`: for an injective family `z` with
values in a minimal system `S` of generators of the maximal ideal and a set `s` of indices,
`z i` is a non-zero-divisor modulo `(z j : j ∈ s)` whenever `i ∉ s`. -/
theorem mem_span_image_of_mul_mem_of_minimal {S : Finset R}
    (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) (s : Set (Fin r)) {i : Fin r}
    (hi : i ∉ s) {b : R} (hb : z i * b ∈ Ideal.span (z '' s)) : b ∈ Ideal.span (z '' s) := by
  classical
  have hT : (((Finset.univ.filter (· ∈ s)).image z : Finset R) : Set R) = z '' s := by
    ext
    simp
  rw [← hT] at hb ⊢
  refine mem_span_of_mul_mem_span_of_minimal hS hScard ?_ (hzS i) ?_ hb
  · intro y hy
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hy
    exact hzS j
  · intro h
    obtain ⟨j, hj, hji⟩ := Finset.mem_image.mp h
    rw [hinj hji] at hj
    exact hi (Finset.mem_filter.mp hj).2

/-- Part of a minimal system of generators of the maximal ideal of a regular local ring is
quasi-regular. -/
theorem isQuasiRegular_of_minimal {S : Finset R} (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) : IsQuasiRegular z :=
  isQuasiRegular_of_forall_gt z fun i _ hb =>
    mem_span_image_of_mul_mem_of_minimal hS hScard hinj hzS {j | i < j} (lt_irrefl i) hb

/-- **Part of a regular system of parameters is a regular sequence.**  If `z₁, …, z_r` are
distinct elements of a minimal system `S` of generators of the maximal ideal of a regular local
ring `R`, then `z₁, …, z_r` (in this, hence in any, order) is a regular sequence in `R`. -/
@[blueprint "lem:regular-sequence-rsop"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$, $S$ a minimal
    system of generators of $M$ (so $\#S=\dim R$), and $z_1,\dots,z_r$ distinct elements of $S$.
    Then $z_1,\dots,z_r$ is a regular sequence in $R$: each $z_i$ is a non-zero-divisor modulo
    $(z_1,\dots,z_{i-1})R$, and $(z_1,\dots,z_r)R\ne R$. Since the order of the $z_i$ is
    arbitrary, every permutation of $z_1,\dots,z_r$ is again a regular sequence. -/)
  (proof := /-- For $T\subseteq S$ and $a\in S\setminus T$ we have $a\notin(T)R$: otherwise
    $S\setminus\{a\}$ would generate $M$ by Nakayama's lemma, contradicting the minimality of
    $S$. The ideal $(T)R$ is generated by part of a regular system of parameters, so
    $ab\in(T)R$ and $a\notin(T)R$ imply $b\in(T)R$ (the case $\nu=1$ of the proof of
    \cref{lem:regular-quotient-primary-powers}, which uses \cref{lem:regular-local-domain} and
    \cref{lem:regular-quotient-hyperplane}). Apply this with
    $T=\{z_1,\dots,z_{i-1}\}$ and $a=z_i$. Finally $(z_1,\dots,z_r)R\subseteq M\ne R$. -/)
  (latexEnv := "lemma")]
theorem isRegular_ofFn_of_minimal {S : Finset R} (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) :
    RingTheory.Sequence.IsRegular R (List.ofFn z) := by
  refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).mpr ?_
  · intro y hy
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hy
    rw [← hS]
    exact Ideal.subset_span (hzS i)
  · rw [isWeaklyRegular_ofFn_iff]
    exact fun i _ hb =>
      mem_span_image_of_mul_mem_of_minimal hS hScard hinj hzS {j | j < i} (lt_irrefl i) hb

/-- **The associated graded ring along a prime with regular quotient is a polynomial ring.**
Let `S` be a minimal system of generators of the maximal ideal of the regular local ring `R`,
`z₁, …, z_r` distinct elements of `S` and `P = (z₁, …, z_r)` (by `exists_finset_span_eq_prime`
every prime `P` with `R/P` regular is of this form, and conversely such `P` is prime with
`R/P` regular).  Then the `R/P`-algebra map `(R/P)[Z₁, …, Z_r] → gr_P(R)`, `Z_i ↦ [z_i]`
(the class of `z_i` in `P/P²`), is bijective. -/
@[blueprint "thm:regular-graded-polynomial"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$, and let $P$ be an
    ideal generated by part $z_1,\dots,z_r$ of a minimal system of generators of $M$ (by
    \cref{lem:regular-quotient-rsop} this holds for every prime ideal $P$ such that $R/P$ is
    regular). Then the homomorphism of graded $\bar R$-algebras, $\bar R=R/P$,
    \[\bar R[Z_1,\dots,Z_r]\longrightarrow\operatorname{gr}_P(R)\]
    (\cref{def:II.1-associated-graded-algebra}) sending $Z_i$ to the class of $z_i$ in
    $P/P^2$ is an isomorphism. In particular, for $P=M$ and a regular system of parameters
    $(x_1,\dots,x_n)$ of $R$, $\operatorname{gr}_M(R)$ is identified with the polynomial ring
    $k[X_1,\dots,X_n]$, $k=R/M$, in such a way that $X_j$ corresponds to the class of $x_j$.
    (Used on p.~183, in Lemma~7 of Ch.~II, p.~191: ``We can identify $\operatorname{gr}_P(R)$
    with the polynomial ring $\bar R[Z]=\bar R[Z_1,\dots,Z_r]$ of $r$ variables over
    $\bar R=R/P$'', and in Ch.~III, p.~225.) -/)
  (proof := /-- By \cref{lem:regular-sequence-rsop}, $z_1,\dots,z_r$ is a regular sequence, hence
    quasi-regular by \cref{thm:regular-sequence-quasi-regular}, i.e.\ the map is injective. It
    is surjective since $\operatorname{gr}_P(R)$ is generated over $R/P$ by the classes of
    the monomials in the $z_i$ ($P^n$ is generated by the monomials of degree $n$). -/)
  (latexEnv := "theorem")]
theorem assocGraded_aeval_bijective {S : Finset R}
    (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) {P : Ideal R}
    (hP : Ideal.span (Set.range z) = P) (hz : ∀ i, z i ∈ P ^ 1) :
    Function.Bijective (aeval (R := R ⧸ P) fun i => AssocGraded.mk P 1 (z i) (hz i)) :=
  aeval_mk_bijective_of_isWeaklyRegular P
    (isRegular_ofFn_of_minimal hS hScard hinj hzS).toIsWeaklyRegular hP hz

/-- The isomorphism `(R/P)[Z₁, …, Z_r] ≃ gr_P(R)`, `Z_i ↦ [z_i]`, of
`assocGraded_aeval_bijective`. -/
noncomputable def assocGradedAlgEquiv {S : Finset R}
    (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) {P : Ideal R}
    (hP : Ideal.span (Set.range z) = P) (hz : ∀ i, z i ∈ P ^ 1) :
    MvPolynomial (Fin r) (R ⧸ P) ≃ₐ[R ⧸ P] AssocGraded P :=
  AlgEquiv.ofBijective _ (assocGraded_aeval_bijective hS hScard hinj hzS hP hz)

theorem assocGradedAlgEquiv_apply {S : Finset R}
    (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) {P : Ideal R}
    (hP : Ideal.span (Set.range z) = P) (hz : ∀ i, z i ∈ P ^ 1) (p : MvPolynomial (Fin r) (R ⧸ P)) :
    assocGradedAlgEquiv hS hScard hinj hzS hP hz p =
      aeval (R := R ⧸ P) (fun i => AssocGraded.mk P 1 (z i) (hz i)) p := rfl

/-- For a prime `P` of the regular local ring `R` with `R/P` regular, `gr_P(R)` is a polynomial
ring over `R/P` in the classes of generators `z₁, …, z_r` of `P` (Ch. II, Lemma 7, p. 191). -/
@[blueprint "thm:regular-graded-polynomial"
  (statement := /-- Let $R$ be a regular local ring and $P$ a prime ideal such that $R/P$ is
    regular. Then there are generators $z_1,\dots,z_r$ of $P$ such that
    $\bar R[Z_1,\dots,Z_r]\to\operatorname{gr}_P(R)$, $Z_i\mapsto$ class of $z_i$, is an
    isomorphism of graded $\bar R$-algebras, $\bar R=R/P$. -/)
  (latexEnv := "theorem")]
theorem exists_assocGraded_aeval_bijective (P : Ideal R) [P.IsPrime]
    (hP : IsRegularLocalRing (R ⧸ P)) :
    ∃ (r : ℕ) (z : Fin r → R) (hz : ∀ i, z i ∈ P ^ 1), Ideal.span (Set.range z) = P ∧
      Function.Bijective (aeval (R := R ⧸ P) fun i => AssocGraded.mk P 1 (z i) (hz i)) := by
  obtain ⟨S, T, hS, hScard, hTS, hT⟩ := exists_finset_span_eq_prime R P hP
  let z : Fin T.card → R := fun i => (T.equivFin.symm i : R)
  have hinj : Function.Injective z := Subtype.val_injective.comp T.equivFin.symm.injective
  have hrange : Set.range z = (T : Set R) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (T.equivFin.symm i).2
    · intro hy
      exact ⟨T.equivFin ⟨y, hy⟩, by simp [z]⟩
  have hzP : Ideal.span (Set.range z) = P := by rw [hrange, hT]
  have hz : ∀ i, z i ∈ P ^ 1 := fun i => by
    rw [pow_one, ← hzP]
    exact Ideal.subset_span ⟨i, rfl⟩
  exact ⟨T.card, z, hz, hzP, assocGraded_aeval_bijective hS hScard hinj
    (fun i => hTS (T.equivFin.symm i).2) hzP hz⟩

/-- For a prime `P` of the regular local ring `R` with `R/P` regular, `gr_P(R)` is isomorphic to
a polynomial ring over `R/P` as an `R/P`-algebra. -/
theorem exists_algEquiv_assocGraded (P : Ideal R) [P.IsPrime] (hP : IsRegularLocalRing (R ⧸ P)) :
    ∃ r : ℕ, Nonempty (MvPolynomial (Fin r) (R ⧸ P) ≃ₐ[R ⧸ P] AssocGraded P) := by
  obtain ⟨r, z, hz, -, hbij⟩ := exists_assocGraded_aeval_bijective P hP
  exact ⟨r, ⟨AlgEquiv.ofBijective _ hbij⟩⟩

/-- The case `P = M`: for a regular system of parameters `z₁, …, z_n` of `R` (generators of `M`
with `n = dim R`), `k[X₁, …, X_n] → gr_M(R)`, `X_j ↦ [z_j]`, `k = R/M`, is bijective (Ch. III,
p. 225). -/
@[blueprint "thm:regular-graded-polynomial"
  (statement := /-- For a regular system of parameters $(x_1,\dots,x_n)$ of the regular local
    ring $R$, $k[X_1,\dots,X_n]\to\operatorname{gr}_M(R)$, $X_j\mapsto$ class of $x_j$, is an
    isomorphism, $k=R/M$. (p.~225.) -/)
  (latexEnv := "theorem")]
theorem assocGraded_maximalIdeal_aeval_bijective {n : ℕ} {z : Fin n → R}
    (hspan : Ideal.span (Set.range z) = maximalIdeal R) (hn : (n : WithBot ℕ∞) = ringKrullDim R)
    (hz : ∀ i, z i ∈ maximalIdeal R ^ 1) :
    Function.Bijective (aeval (R := R ⧸ maximalIdeal R)
      fun i => AssocGraded.mk (maximalIdeal R) 1 (z i) (hz i)) := by
  classical
  have hn' : n = (maximalIdeal R).spanFinrank := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hn] at h
    exact_mod_cast h.symm
  set S := Finset.univ.image z with hSdef
  have hSspan : Ideal.span (S : Set R) = maximalIdeal R := by
    rw [hSdef, Finset.coe_image, Finset.coe_univ, Set.image_univ, hspan]
  have hScard : S.card = (maximalIdeal R).spanFinrank := by
    refine le_antisymm ?_ ?_
    · rw [← hn']
      exact Finset.card_image_le.trans (by simp)
    · rw [← hSspan, ← Set.ncard_coe_finset]
      exact Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)
  have hinj : Function.Injective z := by
    have hcard : S.card = (Finset.univ : Finset (Fin n)).card := by
      rw [hScard, Finset.card_univ, Fintype.card_fin, hn']
    have := Finset.card_image_iff.mp hcard
    exact fun i j hij => this (Finset.mem_coe.mpr (Finset.mem_univ i))
      (Finset.mem_coe.mpr (Finset.mem_univ j)) hij
  exact assocGraded_aeval_bijective hSspan hScard hinj
    (fun i => Finset.mem_image_of_mem z (Finset.mem_univ i)) hspan hz

/-- `assocGraded_maximalIdeal_aeval_bijective` for a regular system of parameters given as a
finset `s` (`IsRegularSystemOfParameters`), enumerated by `s.equivFin`. -/
theorem assocGraded_maximalIdeal_aeval_bijective_of_rsop {s : Finset R}
    (hs : IsRegularSystemOfParameters R s)
    (hz : ∀ i : Fin s.card, ((s.equivFin.symm i : s) : R) ∈ maximalIdeal R ^ 1) :
    Function.Bijective (aeval (R := R ⧸ maximalIdeal R)
      fun i => AssocGraded.mk (maximalIdeal R) 1 ((s.equivFin.symm i : s) : R) (hz i)) := by
  refine assocGraded_maximalIdeal_aeval_bijective ?_ hs.2 hz
  have hrange : Set.range (fun i : Fin s.card => ((s.equivFin.symm i : s) : R)) = (s : Set R) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
    · intro hy
      exact ⟨s.equivFin ⟨y, hy⟩, by simp⟩
  rw [hrange, hs.1]

/-- If `P` is spanned by part of a minimal system of generators of the maximal ideal and `P`
is prime, then `gr_P(R)` is a domain. -/
theorem isDomain_assocGraded_of_minimal {S : Finset R}
    (hS : Ideal.span (S : Set R) = maximalIdeal R)
    (hScard : S.card = (maximalIdeal R).spanFinrank) {r : ℕ} {z : Fin r → R}
    (hinj : Function.Injective z) (hzS : ∀ i, z i ∈ S) {P : Ideal R} [P.IsPrime]
    (hP : Ideal.span (Set.range z) = P) : IsDomain (AssocGraded P) := by
  have hz : ∀ i, z i ∈ P ^ 1 := fun i => by
    rw [pow_one, ← hP]
    exact Ideal.subset_span ⟨i, rfl⟩
  let e := assocGradedAlgEquiv hS hScard hinj hzS hP hz
  exact Function.Injective.isDomain e.symm e.symm.injective

/-- **`gr_P(R)` is a domain** for a prime `P` of a regular local ring `R` with `R/P` regular. -/
@[blueprint "cor:regular-graded-domain"
  (statement := /-- Let $R$ be a regular local ring and $P$ a prime ideal of $R$ such that $R/P$
    is regular (e.g.\ $P=M$). Then $\operatorname{gr}_P(R)$
    (\cref{def:II.1-associated-graded-algebra}) is an integral domain. -/)
  (proof := /-- By \cref{thm:regular-graded-polynomial}, $\operatorname{gr}_P(R)$ is a
    polynomial ring over $R/P$, which is a domain since $P$ is prime (indeed $R/P$ is regular,
    \cref{lem:regular-local-domain}). -/)
  (latexEnv := "corollary")]
theorem isDomain_assocGraded (P : Ideal R) [P.IsPrime] (hP : IsRegularLocalRing (R ⧸ P)) :
    IsDomain (AssocGraded P) := by
  obtain ⟨r, ⟨e⟩⟩ := exists_algEquiv_assocGraded P hP
  exact Function.Injective.isDomain e.symm e.symm.injective

/-- `gr_M(R)` is a domain for a regular local ring `R`. -/
@[blueprint "cor:regular-graded-domain"
  (statement := /-- For a regular local ring $R$ with maximal ideal $M$,
    $\operatorname{gr}_M(R)$ is an integral domain. -/)
  (latexEnv := "corollary")]
theorem isDomain_assocGraded_maximalIdeal : IsDomain (AssocGraded (maximalIdeal R)) := by
  obtain ⟨S, hScard, hSspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
  have hS : Ideal.span (S : Set R) = maximalIdeal R := hSspan
  let z : Fin S.card → R := fun i => (S.equivFin.symm i : R)
  have hinj : Function.Injective z := Subtype.val_injective.comp S.equivFin.symm.injective
  have hrange : Set.range z = (S : Set R) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (S.equivFin.symm i).2
    · intro hy
      exact ⟨S.equivFin ⟨y, hy⟩, by simp [z]⟩
  exact isDomain_assocGraded_of_minimal hS hScard hinj (fun i => (S.equivFin.symm i).2)
    (by rw [hrange, hS])

/-- **Initial forms are multiplicative** along a prime `P` with `R/P` regular:
`in_P(fg) = in_P(f) · in_P(g)` in `gr_P(R)`. -/
@[blueprint "cor:regular-initial-form-mul"
  (statement := /-- Let $R$ be a regular local ring and $P$ a prime ideal of $R$ such that $R/P$
    is regular (e.g.\ $P=M$). Then for all $f,g\in R$ the initial form
    (\cref{def:II.2-initial-form}) of $fg$ in $\operatorname{gr}_P(R)$ is the product of the
    initial forms of $f$ and $g$, and $\nu_P(fg)=\nu_P(f)+\nu_P(g)$
    (\cref{def:II.2-order-element}). -/)
  (proof := /-- If $\nu_P(f)=\infty$ or $\nu_P(g)=\infty$, then $fg\in\bigcap_\nu P^\nu$ and both
    sides vanish. Otherwise, with $a=\nu_P(f)$ and $b=\nu_P(g)$, the classes of $f$ in
    $P^a/P^{a+1}$ and of $g$ in $P^b/P^{b+1}$ are non-zero, so their product, the class of $fg$
    in $P^{a+b}/P^{a+b+1}$, is non-zero because $\operatorname{gr}_P(R)$ is a domain
    (\cref{cor:regular-graded-domain}); hence $\nu_P(fg)=a+b$ and the initial form of $fg$ is
    this product. -/)
  (latexEnv := "corollary")]
theorem initialForm_mul_of_isRegularLocalRing (P : Ideal R) [P.IsPrime]
    (hP : IsRegularLocalRing (R ⧸ P)) (f g : R) :
    initialForm P (f * g) = initialForm P f * initialForm P g := by
  have := isDomain_assocGraded P hP
  exact initialForm_mul_of_isDomain P f g

/-- **Orders are additive** along a prime `P` with `R/P` regular: `ν_P(fg) = ν_P(f) + ν_P(g)`. -/
@[blueprint "cor:regular-initial-form-mul"
  (statement := /-- For a prime $P$ of the regular local ring $R$ with $R/P$ regular,
    $\nu_P(fg)=\nu_P(f)+\nu_P(g)$ for all $f,g\in R$. -/)
  (latexEnv := "corollary")]
theorem ordElem_mul_of_isRegularLocalRing (P : Ideal R) [P.IsPrime]
    (hP : IsRegularLocalRing (R ⧸ P)) (f g : R) :
    Ideal.ordElem P (f * g) = Ideal.ordElem P f + Ideal.ordElem P g := by
  have := isDomain_assocGraded P hP
  exact ordElem_mul_of_isDomain P f g

/-- Initial forms with respect to the maximal ideal of a regular local ring are multiplicative. -/
theorem initialForm_mul_maximalIdeal (f g : R) :
    initialForm (maximalIdeal R) (f * g) =
      initialForm (maximalIdeal R) f * initialForm (maximalIdeal R) g := by
  have := isDomain_assocGraded_maximalIdeal (R := R)
  exact initialForm_mul_of_isDomain _ f g

/-- `ν(fg) = ν(f) + ν(g)` for the maximal ideal of a regular local ring. -/
theorem ordElem_mul_maximalIdeal (f g : R) :
    Ideal.ordElem (maximalIdeal R) (f * g) =
      Ideal.ordElem (maximalIdeal R) f + Ideal.ordElem (maximalIdeal R) g := by
  have := isDomain_assocGraded_maximalIdeal (R := R)
  exact ordElem_mul_of_isDomain _ f g

end RegularLocal


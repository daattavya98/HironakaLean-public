/-!
# Lemma 21 (Ch. III, pp. 256-258): the choice of the coordinates adapted to `T_a`

The proof of Lemma 21 chooses the system `(x_1, ..., x_t)` of the regular system of parameters
`(z, x, x_k, y)` of `R` "in such a way that, for the integer `tau = tau^{(a)}(J) - r`, `T_a` is
generated by `Z_1, ..., Z_r, X_1, ..., X_tau`" (p. 257), and again "we may assume that
`phi in k[Z_1, ..., Z_r, X_1, ..., X_{taubar}]`".  Then `T*_a` is generated by
`{W_1, ..., W_r, U_1 + L_1, ..., U_tau + L_tau}` with linear forms `L_k` in `X, Y_1, ..., Y_s`, and
`psi = phi(W_1, ..., W_r, U_1 + L_1, ..., U_taubar + L_taubar)` because "zero is the only element in
the intersection of the algebra `k[W, U + L]` and of the ideal `(X, Y_1, ..., Y_s) gr_{M_1}(R_1)`".

A `k`-linear transformation of `(x_1, ..., x_t)` changes the identification
`gr_M(R) = k[Z, X_1, ..., X_t, X, Y]` (and `gr_{M_1}(R_1) = k[W, U, X, Y]`) by the same linear change
of the variables `X_j` (`U_j`).  Here:

* `exists_linearEquiv_span_eq`: a basis of a finite-dimensional space adapted to a subspace;
* `blockAut`, `IsBlockAut`, `exists_blockAut_adapted`: the linear change of the variables `X_a`,
  `a in Av`, carrying a given subspace of `<X_a : a in Av>` onto a coordinate subspace;
* `SemiModel.comp`, `models_comp_hypotheses`: the polynomial pictures composed with such a change;
* `core_adapted_poly`: the end of the proof in adapted coordinates, step by step as printed
  (`theta` induces `T*_a -> T_a` bijectively, the forms `L_k`, `k[W, U + L] cap (X, Y) = 0`,
  `psi = phi(W, U + L)`, `tau_{(w)}(g) = tau_{(z)}(f)`);
* `core_assembly_adapted`, `core_assembly_printed`: the same at the level of `gr_M(R)`, `gr_{M_1}(R_1)`.
-/

@[expose] public section

open Module MvPolynomial IsLocalRing
open scoped Classical

universe u

namespace Hironaka

section AdaptLinear

variable {K : Type u} [Field K] {V : Type u} [AddCommGroup V] [Module K V] {ι : Type*} [Fintype ι]

/-- Basis adapted to a subspace. -/
theorem exists_linearEquiv_span_eq (b : Basis ι K V) (T : Submodule K V) :
    ∃ (f : V ≃ₗ[K] V) (I : Set ι), ∀ v, v ∈ Submodule.span K (b '' I) ↔ f v ∈ T := by
  classical
  have hfd : FiniteDimensional K V := Module.Finite.of_basis b
  let c₀ := Module.Free.chooseBasis K T
  let v₀ : Module.Free.ChooseBasisIndex K T → V := fun i => (c₀ i : V)
  have hv₀ : LinearIndependent K v₀ := c₀.linearIndependent.map' T.subtype (Submodule.ker_subtype T)
  set s : Set V := Set.range v₀ with hs
  have hsT : Submodule.span K s = T := by
    have h1 : Submodule.span K (Set.range c₀) = ⊤ := c₀.span_eq
    have h2 := congrArg (Submodule.map T.subtype) h1
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h2
    have h3 : s = T.subtype '' Set.range c₀ := by rw [hs, ← Set.range_comp]; rfl
    rw [h3]
    exact h2
  have hsli : LinearIndepOn K id s := hv₀.linearIndepOn_id
  let I' : Set V := hsli.extend (Set.subset_univ s)
  let B : Basis I' K V := Basis.extend hsli
  have hB : ∀ x : I', B x = (x : V) := fun x => Basis.extend_apply_self hsli x
  have hfinI : Finite I' := Module.Finite.finite_basis B
  have : Fintype I' := Fintype.ofFinite _
  have hcard : Fintype.card ι = Fintype.card I' := by
    rw [← Module.finrank_eq_card_basis b, ← Module.finrank_eq_card_basis B]
  obtain ⟨eqv⟩ : Nonempty (ι ≃ I') := ⟨Fintype.equivOfCardEq hcard⟩
  let f : V ≃ₗ[K] V := b.equiv B eqv
  have hf : ∀ i, f (b i) = (eqv i : V) := fun i => by
    show (b.equiv B eqv) (b i) = _
    rw [Basis.equiv_apply, hB]
  set I : Set ι := eqv ⁻¹' {x : I' | (x : V) ∈ s} with hI
  have hmap : Submodule.map (f : V →ₗ[K] V) (Submodule.span K (b '' I)) = T := by
    rw [Submodule.map_span, ← hsT]
    congr 1
    ext x
    constructor
    · rintro ⟨_, ⟨i, hi, rfl⟩, rfl⟩
      show f (b i) ∈ s
      rw [hf]
      exact hi
    · intro hx
      have hxI : x ∈ I' := hsli.subset_extend (Set.subset_univ s) hx
      refine ⟨b (eqv.symm ⟨x, hxI⟩), ⟨eqv.symm ⟨x, hxI⟩, ?_, rfl⟩, ?_⟩
      · show ((eqv (eqv.symm ⟨x, hxI⟩) : I') : V) ∈ s
        rw [Equiv.apply_symm_apply]
        exact hx
      · show f (b (eqv.symm ⟨x, hxI⟩)) = x
        rw [hf, Equiv.apply_symm_apply]
  refine ⟨f, I, fun v => ⟨fun hv => ?_, fun hv => ?_⟩⟩
  · rw [← hmap]
    exact Submodule.mem_map_of_mem hv
  · rw [← hmap] at hv
    obtain ⟨w, hw, hwv⟩ := hv
    have : w = v := f.injective hwv
    rwa [this] at hw

end AdaptLinear

section BlockAut

variable {K : Type u} [Field K] {n : ℕ}

/-- The span of the variables `X_a`, `a ∈ Av`, as the span of a family indexed by `Av`. -/
noncomputable def Vb (K : Type u) [Field K] {n : ℕ} (Av : Set (Fin n)) :
    Submodule K (MvPolynomial (Fin n) K) :=
  Submodule.span K (Set.range fun a : Av => (X a.1 : MvPolynomial (Fin n) K))

theorem Vb_eq (Av : Set (Fin n)) : Vb K Av = Submodule.span K (X '' Av) := by
  unfold Vb
  rw [Set.image_eq_range]

theorem X_mem_Vb {Av : Set (Fin n)} {i : Fin n} (h : i ∈ Av) :
    (X i : MvPolynomial (Fin n) K) ∈ Vb K Av :=
  Submodule.subset_span ⟨⟨i, h⟩, rfl⟩

variable {Av : Set (Fin n)}

/-- The substitution `X_a ↦ e(X_a)` for `a ∈ Av`, `X_i ↦ X_i` otherwise. -/
noncomputable def blockSubst (e : Vb K Av ≃ₗ[K] Vb K Av) (i : Fin n) : MvPolynomial (Fin n) K :=
  if h : i ∈ Av then ((e ⟨X i, X_mem_Vb h⟩ : Vb K Av) : MvPolynomial (Fin n) K) else X i

theorem aeval_blockSubst_of_mem (e : Vb K Av ≃ₗ[K] Vb K Av) (v : MvPolynomial (Fin n) K)
    (hv : v ∈ Vb K Av) : aeval (blockSubst e) v = (e ⟨v, hv⟩ : MvPolynomial (Fin n) K) := by
  induction hv using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨⟨a, ha⟩, rfl⟩ := hy
    simp [blockSubst, ha]
  | zero =>
    have : (⟨0, zero_mem _⟩ : Vb K Av) = 0 := rfl
    rw [map_zero, this, map_zero]
    rfl
  | add x y hx hy ihx ihy =>
    rw [map_add, ihx, ihy]
    have : (⟨x + y, add_mem hx hy⟩ : Vb K Av) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
    rw [this, map_add]
    rfl
  | smul c x hx ihx =>
    rw [map_smul, ihx]
    have : (⟨c • x, Submodule.smul_mem _ c hx⟩ : Vb K Av) = c • ⟨x, hx⟩ := rfl
    rw [this, map_smul]
    rfl

theorem aeval_blockSubst_of_notMem (e : Vb K Av ≃ₗ[K] Vb K Av) {i : Fin n} (hi : i ∉ Av) :
    aeval (blockSubst e) (X i : MvPolynomial (Fin n) K) = X i := by
  simp [blockSubst, hi]

/-- **The linear change of the variables `X_a`, `a ∈ Av`, by `e`** (p. 257: "we could choose the
system `(x_1, …, x_t)` in such a way that …"; a `k`-linear transformation of the system). -/
noncomputable def blockAut (e : Vb K Av ≃ₗ[K] Vb K Av) :
    MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K :=
  AlgEquiv.ofAlgHom (aeval (blockSubst e)) (aeval (blockSubst e.symm))
    (by
      refine MvPolynomial.algHom_ext fun i => ?_
      by_cases hi : i ∈ Av
      · have h1 : blockSubst e.symm i = ((e.symm ⟨X i, X_mem_Vb hi⟩ : Vb K Av) :
            MvPolynomial (Fin n) K) := by simp [blockSubst, hi]
        simp only [AlgHom.coe_comp, Function.comp_apply, aeval_X, AlgHom.id_apply]
        rw [h1, aeval_blockSubst_of_mem e _ (e.symm ⟨X i, X_mem_Vb hi⟩).2]
        simp
      · simp only [AlgHom.coe_comp, Function.comp_apply, aeval_X, AlgHom.id_apply]
        rw [show blockSubst e.symm i = X i by simp [blockSubst, hi]]
        exact aeval_blockSubst_of_notMem e hi)
    (by
      refine MvPolynomial.algHom_ext fun i => ?_
      by_cases hi : i ∈ Av
      · have h1 : blockSubst e i = ((e ⟨X i, X_mem_Vb hi⟩ : Vb K Av) :
            MvPolynomial (Fin n) K) := by simp [blockSubst, hi]
        simp only [AlgHom.coe_comp, Function.comp_apply, aeval_X, AlgHom.id_apply]
        rw [h1, aeval_blockSubst_of_mem e.symm _ (e ⟨X i, X_mem_Vb hi⟩).2]
        simp
      · simp only [AlgHom.coe_comp, Function.comp_apply, aeval_X, AlgHom.id_apply]
        rw [show blockSubst e i = X i by simp [blockSubst, hi]]
        exact aeval_blockSubst_of_notMem e.symm hi)

theorem blockAut_apply (e : Vb K Av ≃ₗ[K] Vb K Av) (p : MvPolynomial (Fin n) K) :
    blockAut e p = aeval (blockSubst e) p := rfl

theorem blockAut_symm_apply (e : Vb K Av ≃ₗ[K] Vb K Av) (p : MvPolynomial (Fin n) K) :
    (blockAut e).symm p = aeval (blockSubst e.symm) p := rfl


/-- `σ` is a change of the variables `X_a`, `a ∈ Av`, among themselves: it fixes the other
variables, and so does `σ⁻¹`. -/
structure IsBlockAut (σ : MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K) (Av : Set (Fin n)) :
    Prop where
  fix : ∀ i ∉ Av, σ (X i) = X i
  fix_symm : ∀ i ∉ Av, σ.symm (X i) = X i
  mem : ∀ i ∈ Av, σ (X i) ∈ Vb K Av
  mem_symm : ∀ i ∈ Av, σ.symm (X i) ∈ Vb K Av

namespace IsBlockAut

variable {σ : MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K} (h : IsBlockAut σ Av)
include h

theorem symm : IsBlockAut σ.symm Av where
  fix := h.fix_symm
  fix_symm := fun i hi => by simpa using h.fix i hi
  mem := h.mem_symm
  mem_symm := fun i hi => by simpa using h.mem i hi

theorem X_mem_homogeneous (i : Fin n) :
    σ (X i) ∈ homogeneousSubmodule (Fin n) K 1 := by
  by_cases hi : i ∈ Av
  · have := h.mem i hi
    rw [Vb_eq, homogeneousSubmodule_one_eq_span_X] at *
    exact Submodule.span_mono (Set.image_subset_range _ _) this
  · rw [h.fix i hi]
    exact isHomogeneous_X K i

theorem map_homogeneous {d : ℕ} {p : MvPolynomial (Fin n) K}
    (hp : p ∈ homogeneousSubmodule (Fin n) K d) : σ p ∈ homogeneousSubmodule (Fin n) K d := by
  rw [mem_homogeneousSubmodule] at hp ⊢
  have e : σ p = eval₂ (algebraMap K (MvPolynomial (Fin n) K)) (fun i => σ (X i)) p := by
    have : σ.toAlgHom = aeval fun i => σ (X i) := by
      refine MvPolynomial.algHom_ext fun i => ?_
      simp
    exact congrArg (fun F => F p) this
  rw [e]
  have := hp.eval₂ (algebraMap K (MvPolynomial (Fin n) K)) (fun i => σ (X i))
    (fun r => isHomogeneous_C _ r) (n := 1) (fun i => by
      have := h.X_mem_homogeneous i
      rwa [mem_homogeneousSubmodule] at this)
  simpa using this

theorem mem_homogeneous_iff {d : ℕ} {p : MvPolynomial (Fin n) K} :
    σ p ∈ homogeneousSubmodule (Fin n) K d ↔ p ∈ homogeneousSubmodule (Fin n) K d := by
  refine ⟨fun hp => ?_, h.map_homogeneous⟩
  have := h.symm.map_homogeneous hp
  simpa using this

theorem map_supported {U : Set (Fin n)} (hAU : Av ⊆ U) {p : MvPolynomial (Fin n) K}
    (hp : p ∈ supported K U) : σ p ∈ supported K U := by
  rw [supported_eq_adjoin_X] at hp
  have hle : Algebra.adjoin K (X '' U) ≤ (supported K U).comap σ.toAlgHom := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨i, hi, rfl⟩
    show σ (X i) ∈ supported K U
    by_cases hiA : i ∈ Av
    · have := h.mem i hiA
      rw [Vb_eq] at this
      refine (Submodule.span_le.mpr ?_ : Submodule.span K (X '' Av) ≤
        Subalgebra.toSubmodule (supported K U)) this
      rintro _ ⟨j, hj, rfl⟩
      change X j ∈ supported K U
      rw [mem_supported]
      simpa using hAU hj
    · rw [h.fix i hiA]
      rw [mem_supported]
      simpa using hi
  exact hle hp

theorem map_outIdeal {U : Set (Fin n)} (hAU : Av ⊆ U) {p : MvPolynomial (Fin n) K}
    (hp : p ∈ outIdeal (K := K) U) : σ p ∈ outIdeal (K := K) U := by
  have hle : outIdeal (K := K) U ≤ Ideal.comap σ (outIdeal (K := K) U) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, hi, rfl⟩
    show σ (X i) ∈ outIdeal (K := K) U
    have hiA : i ∉ Av := fun hA => hi (hAU hA)
    rw [h.fix i hiA]
    exact Ideal.subset_span ⟨i, hi, rfl⟩
  exact hle hp

theorem map_of_mem_span_X {S : Set (Fin n)} (hS : Disjoint S Av) {p : MvPolynomial (Fin n) K}
    (hp : p ∈ Submodule.span K (X '' S)) : σ p = p := by
  induction hp using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, hi, rfl⟩ := hy
    exact h.fix i (fun hA => Set.disjoint_left.mp hS hi hA)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | smul c x _ hx => rw [map_smul, hx]

theorem map_mem_Vb {p : MvPolynomial (Fin n) K} (hp : p ∈ Vb K Av) : σ p ∈ Vb K Av := by
  induction hp using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨⟨a, ha⟩, rfl⟩ := hy
    exact h.mem a ha
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ _ hx

end IsBlockAut


theorem isBlockAut_blockAut (e : Vb K Av ≃ₗ[K] Vb K Av) : IsBlockAut (blockAut e) Av where
  fix i hi := by rw [blockAut_apply]; exact aeval_blockSubst_of_notMem e hi
  fix_symm i hi := by rw [blockAut_symm_apply]; exact aeval_blockSubst_of_notMem e.symm hi
  mem i hi := by
    rw [blockAut_apply, aeval_blockSubst_of_mem e _ (X_mem_Vb hi)]
    exact (e ⟨X i, X_mem_Vb hi⟩).2
  mem_symm i hi := by
    rw [blockAut_symm_apply, aeval_blockSubst_of_mem e.symm _ (X_mem_Vb hi)]
    exact (e.symm ⟨X i, X_mem_Vb hi⟩).2

variable (Av) in
/-- **Coordinates adapted to a subspace** (Lemma 21, p. 257: "we could choose the system
`(x_1, …, x_t)` in such a way that … `T_a` is generated by `Z_1, …, Z_r, X_1, …, X_τ`"): for a
subspace `T` of `⟨X_a : a ∈ Av⟩` there is a `k`-linear change `σ` of the variables `X_a`, `a ∈ Av`,
and a subset `A ⊆ Av` of the variables such that `σ` maps `⟨X_a : a ∈ A⟩` onto `T`. -/
theorem exists_blockAut_adapted (T : Submodule K (MvPolynomial (Fin n) K))
    (hT : T ≤ Submodule.span K (X '' Av)) :
    ∃ (σ : MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K) (A : Set (Fin n)),
      IsBlockAut σ Av ∧ A ⊆ Av ∧ ∀ p, p ∈ Submodule.span K (X '' A) ↔ σ p ∈ T := by
  classical
  have hli : LinearIndependent K (fun a : Av => (X a.1 : MvPolynomial (Fin n) K)) :=
    (linearIndependent_X (Fin n) K).comp Subtype.val Subtype.val_injective
  let b : Basis Av K (Vb K Av) := Basis.span hli
  have hb : ∀ a, (b a : MvPolynomial (Fin n) K) = X a.1 := fun a => congrArg Subtype.val (Basis.span_apply hli a)
  obtain ⟨f, I, hI⟩ := exists_linearEquiv_span_eq b (T.comap (Vb K Av).subtype)
  have hσ := isBlockAut_blockAut f
  have key : ∀ v : Vb K Av, v ∈ Submodule.span K (b '' I) ↔
      (v : MvPolynomial (Fin n) K) ∈ Submodule.span K (X '' (Subtype.val '' I)) := by
    have hmap : Submodule.map (Vb K Av).subtype (Submodule.span K (b '' I)) =
        Submodule.span K (X '' (Subtype.val '' I)) := by
      rw [Submodule.map_span, Set.image_image, Set.image_image]
      congr 1
      refine Set.image_congr fun a _ => ?_
      exact hb a
    intro v
    rw [← hmap]
    constructor
    · intro hv
      exact Submodule.mem_map_of_mem hv
    · intro hv
      obtain ⟨w, hw, hwv⟩ := hv
      have : w = v := Subtype.ext hwv
      rwa [this] at hw
  refine ⟨blockAut f, Subtype.val '' I, hσ, ?_, fun p => ?_⟩
  · rintro _ ⟨a, -, rfl⟩
    exact a.2
  · have hAV : Submodule.span K (X '' (Subtype.val '' I)) ≤ Vb K Av := by
      rw [Vb_eq]
      refine Submodule.span_mono (Set.image_mono ?_)
      rintro _ ⟨a, -, rfl⟩
      exact a.2
    constructor
    · intro hp
      have hpV : p ∈ Vb K Av := hAV hp
      have h1 := (hI ⟨p, hpV⟩).mp ((key ⟨p, hpV⟩).mpr hp)
      rw [blockAut_apply, aeval_blockSubst_of_mem f p hpV]
      exact h1
    · intro hp
      have hpV' : blockAut f p ∈ Vb K Av := by
        rw [Vb_eq]; exact hT hp
      have hpV : p ∈ Vb K Av := by
        have := hσ.symm.map_mem_Vb hpV'
        simpa using this
      have h1 : (⟨p, hpV⟩ : Vb K Av) ∈ Submodule.span K (b '' I) := by
        rw [hI]
        show (f ⟨p, hpV⟩ : MvPolynomial (Fin n) K) ∈ T
        rw [← aeval_blockSubst_of_mem f p hpV]
        exact hp
      exact (key ⟨p, hpV⟩).mp h1

end BlockAut

section CoordSplit

variable {K : Type u} [Field K] {n : ℕ}

/-- The coordinate decomposition of the linear forms in the variables `Zv ∪ Av`: `p = θ p + (p - θ p)`
with `θ p` in the variables `Zv` and `p - θ p` in those of `Av` (`θ = projOut Zv`). -/
theorem projOut_split {Zv Av : Set (Fin n)} (hdisj : Disjoint Zv Av)
    {p : MvPolynomial (Fin n) K} (hp : p ∈ Submodule.span K (X '' (Zv ∪ Av))) :
    projOut (K := K) Zv p ∈ Submodule.span K (X '' Zv) ∧
      p - projOut (K := K) Zv p ∈ Submodule.span K (X '' Av) := by
  induction hp using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, hi, rfl⟩ := hy
    rcases hi with hi | hi
    · rw [projOut_X, ite_eq_left hi, sub_self]
      exact ⟨Submodule.subset_span ⟨i, hi, rfl⟩, zero_mem _⟩
    · have hiZ : i ∉ Zv := fun h => Set.disjoint_left.mp hdisj h hi
      rw [projOut_X, ite_eq_right hiZ, sub_zero]
      exact ⟨zero_mem _, Submodule.subset_span ⟨i, hi, rfl⟩⟩
  | zero => simp
  | add x y _ _ hx hy =>
    rw [map_add]
    refine ⟨add_mem hx.1 hy.1, ?_⟩
    have : x + y - (projOut (K := K) Zv x + projOut (K := K) Zv y) =
        (x - projOut (K := K) Zv x) + (y - projOut (K := K) Zv y) := by ring
    rw [this]
    exact add_mem hx.2 hy.2
  | smul c x _ hx =>
    rw [map_smul, ← smul_sub]
    exact ⟨Submodule.smul_mem _ _ hx.1, Submodule.smul_mem _ _ hx.2⟩

theorem span_X_union (Zv Av : Set (Fin n)) :
    Submodule.span K (X '' (Zv ∪ Av) : Set (MvPolynomial (Fin n) K)) =
      Submodule.span K (X '' Zv) ⊔ Submodule.span K (X '' Av) := by
  rw [Set.image_union, Submodule.span_union]

variable {σ : MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K}

/-- A block automorphism of the variables `Av` maps the linear forms in `Zv ∪ Av` into themselves. -/
theorem IsBlockAut.map_mem_span_union {Zv Av : Set (Fin n)} (hσ : IsBlockAut σ Av)
    (hdisj : Disjoint Zv Av) {p : MvPolynomial (Fin n) K}
    (hp : p ∈ Submodule.span K (X '' (Zv ∪ Av))) : σ p ∈ Submodule.span K (X '' (Zv ∪ Av)) := by
  obtain ⟨h1, h2⟩ := projOut_split hdisj hp
  have : σ p = projOut (K := K) Zv p + σ (p - projOut (K := K) Zv p) := by
    rw [map_sub, hσ.map_of_mem_span_X hdisj h1]
    ring
  rw [this, span_X_union]
  refine add_mem (Submodule.mem_sup_left h1) (Submodule.mem_sup_right ?_)
  rw [← Vb_eq] at h2 ⊢
  exact hσ.map_mem_Vb h2

/-- **The adapted coordinates carry `T` to the coordinate subspace** (the choice of coordinates in
Lemma 21, p. 257).  If `σ` is a change of the variables `Av` carrying `⟨X_a : a ∈ At⟩` onto
`T ⊓ ⟨X_a : a ∈ Av⟩`, and `⟨X_z : z ∈ Zv⟩ ≤ T ≤ ⟨X_i : i ∈ Zv ∪ Av⟩`, then `σ p ∈ T` iff `p` is a
linear form in the variables `Zv ∪ At`. -/
theorem mem_span_union_iff_of_blockAut {Zv Av At : Set (Fin n)} (hσ : IsBlockAut σ Av)
    (hdisj : Disjoint Zv Av) (T : Submodule K (MvPolynomial (Fin n) K))
    (hZT : Submodule.span K (X '' Zv) ≤ T) (hTU : T ≤ Submodule.span K (X '' (Zv ∪ Av)))
    (hadapt : ∀ p, p ∈ Submodule.span K (X '' At) ↔
      σ p ∈ T ⊓ Submodule.span K (X '' Av)) (p : MvPolynomial (Fin n) K) :
    σ p ∈ T ↔ p ∈ Submodule.span K (X '' (Zv ∪ At)) := by
  constructor
  · intro hp
    have hpU : p ∈ Submodule.span K (X '' (Zv ∪ Av)) := by
      have h1 : σ.symm (σ p) ∈ Submodule.span K (X '' (Zv ∪ Av)) :=
        hσ.symm.map_mem_span_union hdisj (hTU hp)
      simpa using h1
    obtain ⟨h1, h2⟩ := projOut_split hdisj hpU
    have h3 : σ p = projOut (K := K) Zv p + σ (p - projOut (K := K) Zv p) := by
      rw [map_sub, hσ.map_of_mem_span_X hdisj h1]
      ring
    have h4 : σ (p - projOut (K := K) Zv p) ∈ T := by
      have h5 : σ p - projOut (K := K) Zv p ∈ T := sub_mem hp (hZT h1)
      rwa [h3, add_sub_cancel_left] at h5
    have h6 : σ (p - projOut (K := K) Zv p) ∈ Submodule.span K (X '' Av) := by
      rw [← Vb_eq] at h2 ⊢
      exact hσ.map_mem_Vb h2
    have h7 := (hadapt _).mpr ⟨h4, h6⟩
    have : p = projOut (K := K) Zv p + (p - projOut (K := K) Zv p) := by ring
    rw [this, span_X_union]
    exact add_mem (Submodule.mem_sup_left h1) (Submodule.mem_sup_right h7)
  · intro hp
    rw [span_X_union] at hp
    obtain ⟨pz, hpz, pa, hpa, rfl⟩ := Submodule.mem_sup.mp hp
    rw [map_add, hσ.map_of_mem_span_X hdisj hpz]
    exact add_mem (hZT hpz) (((hadapt pa).mp hpa).1)

end CoordSplit

section PolyCoreAdapted

variable {K : Type u} [Field K] {n : ℕ}

/-- A linear form which is killed by `θ = projOut U` is a linear form in the variables outside
`U` (the paper's "linear forms in `X, Y_1, …, Y_s`"). -/
theorem mem_span_X_compl_of_homogeneous_one {U : Set (Fin n)} {p : MvPolynomial (Fin n) K}
    (hp : p ∈ homogeneousSubmodule (Fin n) K 1) (hθ : projOut (K := K) U p = 0) :
    p ∈ Submodule.span K (X '' Uᶜ) := by
  rw [homogeneousSubmodule_one_eq_span_X] at hp
  have key : ∀ q ∈ Submodule.span K (Set.range (X : Fin n → MvPolynomial (Fin n) K)),
      q - projOut (K := K) U q ∈ Submodule.span K (X '' Uᶜ) := by
    intro q hq
    induction hq using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      by_cases hi : i ∈ U
      · simp [projOut_X, hi]
      · simp only [projOut_X, hi, ite_false, sub_zero]
        exact Submodule.subset_span ⟨i, hi, rfl⟩
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      have : x + y - (projOut (K := K) U x + projOut (K := K) U y) =
          (x - projOut (K := K) U x) + (y - projOut (K := K) U y) := by ring
      rw [this]
      exact add_mem hx hy
    | smul c x _ hx =>
      rw [map_smul, ← smul_sub]
      exact Submodule.smul_mem _ _ hx
  have := key p hp
  rwa [hθ, sub_zero] at this

/-- **The polynomial core of the proof of Lemma 21 in adapted coordinates** (pp. 257–258).
Polynomial picture `𝒫 = k[Z, X_1, …, X_t, X, Y]` of `gr_M(R)`, identified with `gr_{M₁}(R₁) =
k[W, U, X, Y]` (`W_j ↔ Z_j`, `U_j ↔ X_j`).  `U` is the set of the variables `Z, X_1, …, X_t`, `Zv`
that of the `Z`, `At` that of `X_1, …, X_τ`; `θ = projOut U` is the homomorphism sending `X` and
`Y_j` to `0`.  The coordinates are adapted: `T_a = ⟨Z, X_1, …, X_τ⟩` (`hT₀ad`) and
`T*(φ) = ⟨Z, X_1, …, X_τ̄⟩` (`hM₀ad`).  The steps of the paper:

* "the homomorphism … should induce a surjective homomorphism `T*_a → T_a`.  But `T*_a` has the same
  rank as `T_a` by (12).  This homomorphism `T*_a → T_a` is an isomorphism of `k`-modules"
  (`map_projOut_eq_and_injOn`);
* "there exists a system of linear forms in `X, Y_1, …, Y_s`, say `(L_1, …, L_τ)`, such that `T*_a` is
  generated by `{W_1, …, W_r, U_1 + L_1, …, U_τ + L_τ}`" (`E i = X_i + L_i`);
* "`ψ ∈ k[T*_a] = k[W_1, …, W_r, U_1 + L_1, …, U_τ + L_τ]`" and "zero is the only element in the
  intersection of the algebra `k[W, U + L]` and of the ideal `(X, Y_1, …, Y_s) gr_{M₁}(R₁)`.
  Therefore we must have `ψ = φ(W_1, …, W_r, U_1 + L_1, …, U_τ̄ + L_τ̄)`" (`ε φ`, `ε` the
  substitution `X_i ↦ X_i + L_i`);
* "This shows that `τ_{(w)}(g) = τ_{(z)}(f) = τ̄`": the ranks of `T*(ψ)` and `T*(φ)`. -/
theorem core_adapted_poly {ι : Type*} (U Zv At : Set (Fin n)) (hZU : Zv ⊆ U) (hAU : At ⊆ U)
    (hdisj : Disjoint Zv At) (q q₁ : ι → MvPolynomial (Fin n) K) (μb : ℕ)
    (hqU : ∀ i, q i ∈ supported K U) (hq₁ : ∀ i, q₁ i - q i ∈ outIdeal (K := K) U)
    (T₀ T₁ : Submodule K (MvPolynomial (Fin n) K))
    (hT₀ : IsTauSubmoduleMv K n (Ideal.span (Set.range q)) T₀ μb)
    (hT₀min : ∀ T, IsTauSubmoduleMv K n (Ideal.span (Set.range q)) T μb → T₀ ≤ T)
    (hT₁ : T₁ ≤ homogeneousSubmodule (Fin n) K 1)
    (hq₁T₁ : ∀ i, q₁ i ∈ Algebra.adjoin K (T₁ : Set (MvPolynomial (Fin n) K)))
    (hrank : Module.finrank K T₁ = Module.finrank K T₀)
    (hZT₁ : ∀ z ∈ Zv, (X z : MvPolynomial (Fin n) K) ∈ T₁)
    (hT₀ad : T₀ = Submodule.span K (X '' (Zv ∪ At)))
    (i₀ : ι) (hφT₀ : q i₀ ∈ Algebra.adjoin K (T₀ : Set (MvPolynomial (Fin n) K)))
    (M₀ M₁ : Submodule K (MvPolynomial (Fin n) K))
    (hM₀ : M₀ ≤ homogeneousSubmodule (Fin n) K 1)
    (hφM₀ : q i₀ ∈ Algebra.adjoin K (M₀ : Set (MvPolynomial (Fin n) K)))
    (hM₀min : ∀ T : Submodule K (MvPolynomial (Fin n) K), T ≤ homogeneousSubmodule (Fin n) K 1 →
      q i₀ ∈ Algebra.adjoin K (T : Set (MvPolynomial (Fin n) K)) → M₀ ≤ T)
    (hM₁ : M₁ ≤ homogeneousSubmodule (Fin n) K 1)
    (hΨM₁ : q₁ i₀ ∈ Algebra.adjoin K (M₁ : Set (MvPolynomial (Fin n) K)))
    (hM₁min : ∀ T : Submodule K (MvPolynomial (Fin n) K), T ≤ homogeneousSubmodule (Fin n) K 1 →
      q₁ i₀ ∈ Algebra.adjoin K (T : Set (MvPolynomial (Fin n) K)) → M₁ ≤ T)
    (Ab : Set (Fin n))
    (hM₀ad : M₀ ⊔ Submodule.span K (X '' Zv) = Submodule.span K (X '' (Zv ∪ Ab))) :
    Module.finrank K ↥(M₁ ⊔ Submodule.span K (X '' Zv)) =
      Module.finrank K ↥(M₀ ⊔ Submodule.span K (X '' Zv)) := by
  classical
  set θ : MvPolynomial (Fin n) K →ₗ[K] MvPolynomial (Fin n) K := (projOut (K := K) U).toLinearMap
    with hθ
  -- step 1: `θ` induces an isomorphism `T*_a → T_a`
  obtain ⟨hmap, hinj⟩ := map_projOut_eq_and_injOn U q q₁ μb hqU hq₁ T₀ T₁ hT₀ hT₀min hT₁ hq₁T₁
    hrank
  -- step 2: the elements `U_k + L_k` of `T*_a` over `X_k`
  have hex : ∀ i : Fin n, ∃ e : MvPolynomial (Fin n) K,
      (i ∈ At → e ∈ T₁ ∧ projOut (K := K) U e = X i) ∧ (i ∉ At → e = X i) := by
    intro i
    by_cases hi : i ∈ At
    · have hXi : (X i : MvPolynomial (Fin n) K) ∈ T₀ := by
        rw [hT₀ad]
        exact Submodule.subset_span ⟨i, Or.inr hi, rfl⟩
      rw [hmap] at hXi
      obtain ⟨t, ht, hθt⟩ := hXi
      exact ⟨t, fun _ => ⟨ht, hθt⟩, fun h => absurd hi h⟩
    · exact ⟨X i, fun h => absurd h hi, fun _ => rfl⟩
  choose E hE1 hE2 using hex
  -- the linear forms `L_i = E_i - X_i` lie in the ideal `(X, Y)`; in fact they are linear forms in
  -- the variables outside `U`
  have hL : ∀ i, E i - X i ∈ outIdeal (K := K) U := by
    intro i
    by_cases hi : i ∈ At
    · refine (projOut_eq_zero_iff U _).mp ?_
      rw [map_sub, (hE1 i hi).2, projOut_X, ite_eq_left (hAU hi), sub_self]
    · rw [hE2 i hi, sub_self]
      exact zero_mem _
  have hLlin : ∀ i, E i - X i ∈ Submodule.span K (X '' Uᶜ) := by
    intro i
    by_cases hi : i ∈ At
    · refine mem_span_X_compl_of_homogeneous_one ?_ ?_
      · exact sub_mem (hT₁ (hE1 i hi).1) (isHomogeneous_X K i)
      · rw [map_sub, (hE1 i hi).2, projOut_X, ite_eq_left (hAU hi), sub_self]
    · rw [hE2 i hi, sub_self]
      exact zero_mem _
  have hEhom : ∀ i, E i ∈ homogeneousSubmodule (Fin n) K 1 := by
    intro i
    by_cases hi : i ∈ At
    · exact hT₁ (hE1 i hi).1
    · rw [hE2 i hi]
      exact isHomogeneous_X K i
  set ε : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K := aeval E with hε
  have hεX : ∀ i, ε (X i) = E i := fun i => aeval_X E i
  -- `θ ∘ ε` is the identity on the algebra generated by `Z, X_1, …, X_τ`
  have hE1' : ∀ p ∈ supported K (Zv ∪ At), projOut (K := K) U (ε p) = p := by
    intro p hp
    rw [supported_eq_adjoin_X] at hp
    have hle : Algebra.adjoin K (X '' (Zv ∪ At)) ≤
        AlgHom.equalizer ((projOut (K := K) U).comp ε) (AlgHom.id K (MvPolynomial (Fin n) K)) := by
      refine Algebra.adjoin_le ?_
      rintro _ ⟨i, hi, rfl⟩
      show projOut (K := K) U (ε (X i)) = X i
      rw [hεX]
      rcases hi with hi | hi
      · have hiA : i ∉ At := fun h => Set.disjoint_left.mp hdisj hi h
        rw [hE2 i hiA, projOut_X, ite_eq_left (hZU hi)]
      · rw [(hE1 i hi).2]
    exact hle hp
  -- `ε p - p ∈ (X, Y)`
  have hE2' : ∀ p, ε p - p ∈ outIdeal (K := K) U := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p r hp hr =>
      rw [map_add, show ε p + ε r - (p + r) = (ε p - p) + (ε r - r) by ring]
      exact add_mem hp hr
    | mul_X p i hp =>
      rw [map_mul, hεX, show ε p * E i - p * X i = ε p * (E i - X i) + (ε p - p) * X i by ring]
      exact add_mem (Ideal.mul_mem_left _ _ (hL i)) (Ideal.mul_mem_right _ _ hp)
  -- `T*_a` is generated by `W_1, …, W_r, U_1 + L_1, …, U_τ + L_τ`: `T₁ = ε(T₀)`
  have hT₀supp : T₀ ≤ Subalgebra.toSubmodule (supported K (Zv ∪ At)) := by
    rw [hT₀ad, Submodule.span_le]
    rintro _ ⟨i, hi, rfl⟩
    change X i ∈ supported K (Zv ∪ At)
    rw [mem_supported]
    simpa using hi
  have hεT₀ : T₀.map ε.toLinearMap ≤ T₁ := by
    rw [hT₀ad, Submodule.map_span, Submodule.span_le]
    rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
    show ε (X i) ∈ T₁
    rw [hεX]
    rcases hi with hi | hi
    · have hiA : i ∉ At := fun h => Set.disjoint_left.mp hdisj hi h
      rw [hE2 i hiA]
      exact hZT₁ i hi
    · exact (hE1 i hi).1
  have hT₁eq : T₁ = T₀.map ε.toLinearMap := by
    refine le_antisymm (fun t ht => ?_) hεT₀
    have hθt : θ t ∈ T₀ := by rw [hmap]; exact Submodule.mem_map_of_mem ht
    have hg : ε (θ t) ∈ T₁ := hεT₀ (Submodule.mem_map_of_mem hθt)
    have hθg : projOut (K := K) U (ε (θ t)) = projOut (K := K) U t := by
      have := hE1' (θ t) (hT₀supp hθt)
      exact this
    have : ε (θ t) = t := hinj hg ht hθg
    rw [← this]
    exact Submodule.mem_map_of_mem hθt
  have hadj₀ : Algebra.adjoin K (T₀ : Set (MvPolynomial (Fin n) K)) = supported K (Zv ∪ At) := by
    rw [hT₀ad, Algebra.adjoin_span, supported_eq_adjoin_X]
  have hadj : Algebra.adjoin K (T₁ : Set (MvPolynomial (Fin n) K)) =
      (supported K (Zv ∪ At)).map ε := by
    have h1 : ((T₀.map ε.toLinearMap : Submodule K _) : Set (MvPolynomial (Fin n) K)) =
        ε '' (T₀ : Set (MvPolynomial (Fin n) K)) := Submodule.map_coe _ _
    rw [hT₁eq, h1, ← AlgHom.map_adjoin, hadj₀]
  -- zero is the only element of `k[T*_a]` in the ideal `(X, Y)`
  have hzero : ∀ p ∈ Algebra.adjoin K (T₁ : Set (MvPolynomial (Fin n) K)),
      p ∈ outIdeal (K := K) U → p = 0 := by
    intro p hp hpo
    rw [hadj] at hp
    obtain ⟨p₀, hp₀, hpe⟩ := Subalgebra.mem_map.mp hp
    have h1 : projOut (K := K) U (ε p₀) = p₀ := hE1' p₀ hp₀
    have h2 : projOut (K := K) U (ε p₀) = 0 := (projOut_eq_zero_iff U _).mpr (by rw [hpe]; exact hpo)
    have h3 : p₀ = 0 := by rw [← h1]; exact h2
    rw [← hpe, h3, map_zero]
  -- `ψ = φ(W, U_1 + L_1, …)`
  have hφsupp : q i₀ ∈ supported K (Zv ∪ At) := by
    rw [← hadj₀]
    exact hφT₀
  have hεφ : ε (q i₀) ∈ Algebra.adjoin K (T₁ : Set (MvPolynomial (Fin n) K)) := by
    rw [hadj]
    exact ⟨q i₀, hφsupp, rfl⟩
  have hΨ : q₁ i₀ = ε (q i₀) := by
    have h1 : q₁ i₀ - ε (q i₀) ∈ Algebra.adjoin K (T₁ : Set (MvPolynomial (Fin n) K)) :=
      sub_mem (hq₁T₁ i₀) hεφ
    have h2 : q₁ i₀ - ε (q i₀) ∈ outIdeal (K := K) U := by
      have := sub_mem (hq₁ i₀) (hE2' (q i₀))
      rwa [show q₁ i₀ - q i₀ - (ε (q i₀) - q i₀) = q₁ i₀ - ε (q i₀) by ring] at this
    exact sub_eq_zero.mp (hzero _ h1 h2)
  -- the ranks: `T*(ψ) ⊆ ε(⟨Z, X_1, …, X_τ̄⟩)`
  set Zs : Submodule K (MvPolynomial (Fin n) K) := Submodule.span K (X '' Zv) with hZs
  set S₀ : Submodule K (MvPolynomial (Fin n) K) := Submodule.span K (X '' (Zv ∪ Ab)) with hS₀
  have hS₀hom : S₀ ≤ homogeneousSubmodule (Fin n) K 1 := by
    rw [hS₀, Submodule.span_le]
    rintro _ ⟨i, -, rfl⟩
    exact isHomogeneous_X K i
  have hεS₀hom : S₀.map ε.toLinearMap ≤ homogeneousSubmodule (Fin n) K 1 := by
    rw [hS₀, Submodule.map_span, Submodule.span_le]
    rintro _ ⟨_, ⟨i, -, rfl⟩, rfl⟩
    show ε (X i) ∈ homogeneousSubmodule (Fin n) K 1
    rw [hεX]
    exact hEhom i
  have hM₀S₀ : M₀ ≤ S₀ := hM₀ad ▸ le_sup_left
  have hZsS₀ : Zs ≤ S₀ := hM₀ad ▸ le_sup_right
  have hφS₀ : q i₀ ∈ Algebra.adjoin K (S₀ : Set (MvPolynomial (Fin n) K)) :=
    Algebra.adjoin_mono (R := K) hM₀S₀ hφM₀
  have hΨS : q₁ i₀ ∈ Algebra.adjoin K ((S₀.map ε.toLinearMap : Submodule K _) :
      Set (MvPolynomial (Fin n) K)) := by
    have h1 : ((S₀.map ε.toLinearMap : Submodule K _) : Set (MvPolynomial (Fin n) K)) =
        ε '' (S₀ : Set (MvPolynomial (Fin n) K)) := Submodule.map_coe _ _
    rw [h1, hΨ, ← AlgHom.map_adjoin]
    exact ⟨q i₀, hφS₀, rfl⟩
  have hM₁S := hM₁min _ hεS₀hom hΨS
  have hZsε : Zs ≤ S₀.map ε.toLinearMap := by
    intro z hz
    refine ⟨z, hZsS₀ hz, ?_⟩
    rw [hZs] at hz
    show ε z = z
    induction hz using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨i, hi, rfl⟩ := hy
      rw [hεX, hE2 i (fun h => Set.disjoint_left.mp hdisj hi h)]
    | zero => simp
    | add x y _ _ hx hy => rw [map_add, hx, hy]
    | smul c x _ hx => rw [map_smul, hx]
  have hfd₁ := finiteDimensional_of_le_homogeneous_one hεS₀hom
  have hfdS₀ := finiteDimensional_of_le_homogeneous_one hS₀hom
  have hle1 : Module.finrank K ↥(M₁ ⊔ Zs) ≤ Module.finrank K ↥(M₀ ⊔ Zs) := by
    calc Module.finrank K ↥(M₁ ⊔ Zs) ≤ Module.finrank K ↥(S₀.map ε.toLinearMap) :=
          Submodule.finrank_mono (sup_le hM₁S hZsε)
      _ ≤ Module.finrank K ↥S₀ := Submodule.finrank_map_le _ _
      _ = Module.finrank K ↥(M₀ ⊔ Zs) := by rw [hM₀ad]
  -- the other inequality: `T*(φ) ⊆ θ(T*(ψ))`
  have hθΨ : projOut (K := K) U (q₁ i₀) = q i₀ := by
    rw [projOut_sub_of_mem_outIdeal U (hq₁ i₀), projOut_of_mem_supported U (hqU i₀)]
  have hM₀θ : M₀ ≤ M₁.map θ := by
    refine hM₀min _ (projOut_map_homogeneous_one U hM₁) ?_
    have h2 : projOut (K := K) U (q₁ i₀) ∈
        (Algebra.adjoin K (M₁ : Set (MvPolynomial (Fin n) K))).map (projOut (K := K) U) :=
      ⟨q₁ i₀, hΨM₁, rfl⟩
    rw [AlgHom.map_adjoin, hθΨ] at h2
    refine Algebra.adjoin_mono ?_ h2
    rintro _ ⟨t, ht, rfl⟩
    exact ⟨t, ht, rfl⟩
  have hZsθ : Zs.map θ = Zs := by
    rw [hZs, Submodule.map_span]
    congr 1
    ext y
    constructor
    · rintro ⟨_, ⟨z, hz, rfl⟩, rfl⟩
      exact ⟨z, hz, by simp [hθ, projOut_X, hZU hz]⟩
    · rintro ⟨z, hz, rfl⟩
      exact ⟨_, ⟨z, hz, rfl⟩, by simp [hθ, projOut_X, hZU hz]⟩
  have hfdM₁ := finiteDimensional_of_le_homogeneous_one hM₁
  have hfdM₀ := finiteDimensional_of_le_homogeneous_one hM₀
  have hfdZs : FiniteDimensional K Zs :=
    finiteDimensional_of_le_homogeneous_one (hZsS₀.trans hS₀hom)
  have hmapsup : M₀ ⊔ Zs ≤ (M₁ ⊔ Zs).map θ := by
    rw [Submodule.map_sup, hZsθ]
    exact sup_le_sup_right hM₀θ _
  have hfdsup : FiniteDimensional K ↥(M₁ ⊔ Zs) :=
    finiteDimensional_of_le_homogeneous_one (sup_le hM₁ (hZsS₀.trans hS₀hom))
  have hle2 : Module.finrank K ↥(M₀ ⊔ Zs) ≤ Module.finrank K ↥(M₁ ⊔ Zs) := by
    have : FiniteDimensional K ↥((M₁ ⊔ Zs).map θ) := inferInstance
    exact (Submodule.finrank_mono hmapsup).trans (Submodule.finrank_map_le _ _)
  exact le_antisymm hle1 hle2

end PolyCoreAdapted

section ModelAdapted

open scoped Classical

attribute [local instance] Ideal.Quotient.field

/-- **Composition of a polynomial picture with a linear change of the variables** (the choice of
another regular system of parameters `(z, x_1, …, x_t, x, y)`: a `k`-linear transformation of
`(x_1, …, x_t)` changes the identification `gr_M(R) = k[Z, X_1, …, X_t, X, Y]` by the same linear
change of the variables `X_j`). -/
noncomputable def SemiModel.comp {k k₁ G : Type u} [Field k] [Field k₁] [CommRing G] [Algebra k₁ G] {n : ℕ}
    (M : SemiModel k k₁ G n) (σ : MvPolynomial (Fin n) k ≃ₐ[k] MvPolynomial (Fin n) k) :
    SemiModel k k₁ G n where
  ρ := M.ρ
  Φ := σ.toRingEquiv.trans M.Φ
  map_C := fun c => by
    show M.Φ (σ (C c)) = _
    rw [show (C c : MvPolynomial (Fin n) k) = algebraMap k _ c from rfl, σ.commutes]
    exact M.map_C c

section CompLemmas

variable {k k₁ G : Type u} [Field k] [Field k₁] [CommRing G] [Algebra k₁ G] {n : ℕ}
  (M : SemiModel k k₁ G n) (σ : MvPolynomial (Fin n) k ≃ₐ[k] MvPolynomial (Fin n) k)

theorem SemiModel.comp_Φ (p : MvPolynomial (Fin n) k) : (M.comp σ).Φ p = M.Φ (σ p) := rfl

theorem SemiModel.comp_Φ_symm (y : G) : (M.comp σ).Φ.symm y = σ.symm (M.Φ.symm y) := rfl

theorem SemiModel.mem_pull_comp (T : Submodule k₁ G) (p : MvPolynomial (Fin n) k) :
    p ∈ (M.comp σ).pull T ↔ σ p ∈ M.pull T := Iff.rfl

end CompLemmas

variable {K : Type u} [Field K] {A A₁ : Type u} [CommRing A] [IsRegularLocalRing A] [CommRing A₁]
  [IsRegularLocalRing A₁] {n : ℕ}

/-- **Transport along a block automorphism**: the hypotheses on a pair of polynomial pictures
(homogeneity, supports of the initial-form polynomials, the `Z`-variables) are preserved when both
pictures are composed with a change `σ` of the variables `X_a`, `a ∈ Av ⊆ U`, `a ∉ Zv`. -/
theorem models_comp_hypotheses
    (M : SemiModel K (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A)) n)
    (M₁ : SemiModel K (A₁ ⧸ maximalIdeal A₁) (AssocGraded (maximalIdeal A₁)) n)
    (hhom : ∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      M.Φ p ∈ AssocGraded.homogeneous (maximalIdeal A) d)
    (hhom₁ : ∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      M₁.Φ p ∈ AssocGraded.homogeneous (maximalIdeal A₁) d)
    {σ : MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K} {Av U Zv : Set (Fin n)}
    (hσ : IsBlockAut σ Av) (hAU : Av ⊆ U) (hdisj : Disjoint Zv Av)
    {N : ℕ} (G : Fin N → A) (g : Fin N → A₁)
    (hqU : ∀ j, M.Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ supported K U)
    (hq₁ : ∀ j, M₁.Φ.symm (initialForm (maximalIdeal A₁) (g j)) -
      M.Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ outIdeal (K := K) U)
    (Z : Submodule (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A)))
    (Z₁ : Submodule (A₁ ⧸ maximalIdeal A₁) (AssocGraded (maximalIdeal A₁)))
    (hZ : M.pull Z = Submodule.span K (X '' Zv)) (hZ₁ : M₁.pull Z₁ = Submodule.span K (X '' Zv)) :
    (∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      (M.comp σ).Φ p ∈ AssocGraded.homogeneous (maximalIdeal A) d) ∧
    (∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      (M₁.comp σ).Φ p ∈ AssocGraded.homogeneous (maximalIdeal A₁) d) ∧
    (∀ j, (M.comp σ).Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ supported K U) ∧
    (∀ j, (M₁.comp σ).Φ.symm (initialForm (maximalIdeal A₁) (g j)) -
      (M.comp σ).Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ outIdeal (K := K) U) ∧
    (M.comp σ).pull Z = Submodule.span K (X '' Zv) ∧
    (M₁.comp σ).pull Z₁ = Submodule.span K (X '' Zv) := by
  have hZσ : ∀ p, σ p ∈ Submodule.span K (X '' Zv) ↔ p ∈ Submodule.span K (X '' Zv) := by
    intro p
    constructor
    · intro hp
      have h1 : σ.symm (σ p) = σ p := hσ.symm.map_of_mem_span_X hdisj hp
      rw [AlgEquiv.symm_apply_apply] at h1
      rw [h1]
      exact hp
    · intro hp
      rw [hσ.map_of_mem_span_X hdisj hp]
      exact hp
  refine ⟨fun d p => ?_, fun d p => ?_, fun j => ?_, fun j => ?_, ?_, ?_⟩
  · rw [SemiModel.comp_Φ, ← hhom]
    exact (hσ.mem_homogeneous_iff).symm
  · rw [SemiModel.comp_Φ, ← hhom₁]
    exact (hσ.mem_homogeneous_iff).symm
  · rw [SemiModel.comp_Φ_symm]
    exact hσ.symm.map_supported hAU (hqU j)
  · rw [SemiModel.comp_Φ_symm, SemiModel.comp_Φ_symm, ← map_sub]
    exact hσ.symm.map_outIdeal hAU (hq₁ j)
  · ext p
    rw [SemiModel.mem_pull_comp, hZ]
    exact hZσ p
  · ext p
    rw [SemiModel.mem_pull_comp, hZ₁]
    exact hZσ p

end ModelAdapted

section AssemblyPrinted

open scoped Classical

attribute [local instance] Ideal.Quotient.field

variable {K : Type u} [Field K] {A A₁ : Type u} [CommRing A] [IsRegularLocalRing A] [CommRing A₁]
  [IsRegularLocalRing A₁] {n : ℕ}

/-- If `φ ∈ k[T ⊔ Z]` and `Z ⊆ T` (in the polynomial picture), then `φ ∈ k[T]`. -/
theorem SemiModel.mem_adjoin_pull_of_sup {k₁ G : Type u} [Field k₁] [CommRing G] [Algebra k₁ G]
    (M : SemiModel K k₁ G n) (T Z : Submodule k₁ G) (Zv : Set (Fin n))
    (hZ : M.pull Z = Submodule.span K (X '' Zv))
    (hZle : Submodule.span K (X '' Zv) ≤ M.pull T) {y : G}
    (hy : y ∈ Algebra.adjoin k₁ ((T ⊔ Z : Submodule k₁ G) : Set G)) :
    M.Φ.symm y ∈ Algebra.adjoin K (M.pull T : Set (MvPolynomial (Fin n) K)) := by
  have h := (M.mem_adjoin_pull_iff (T ⊔ Z) (M.Φ.symm y)).mpr (by rwa [RingEquiv.apply_symm_apply])
  rwa [M.pull_sup, hZ, sup_eq_left.mpr hZle] at h

/-- **The assembly of the proof of Lemma 21 in adapted coordinates** (pp. 257–258), in the polynomial
picture: the two models are adapted, `T_a = ⟨Z, X_1, …, X_τ⟩` (`hTad`) and
`T*(φ) = ⟨Z, X_1, …, X_τ̄⟩` (`hSad`); the two spaces `T*(G_{i₀}) ⊔ Z` and `T*(g_{i₀}) ⊔ Z₁` have the
same rank, `τ_{(z)}(f) = τ_{(w)}(g)`.  The proof is `core_adapted_poly`. -/
theorem core_assembly_adapted
    (M : SemiModel K (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A)) n)
    (M₁ : SemiModel K (A₁ ⧸ maximalIdeal A₁) (AssocGraded (maximalIdeal A₁)) n)
    (hhom : ∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      M.Φ p ∈ AssocGraded.homogeneous (maximalIdeal A) d)
    (hhom₁ : ∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      M₁.Φ p ∈ AssocGraded.homogeneous (maximalIdeal A₁) d)
    (J : Ideal A) (J₁ : Ideal A₁) (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t A J) (hat₁ : a ≤ t A₁ J₁)
    (hτ : tau A₁ J₁ a = tau A J a)
    {N : ℕ} (G : Fin N → A) (d : Fin N → ℕ)
    (hG : ∀ T, IsTauSubmodule A J T (mu A J a) ↔ IsTauZSubmodule A G T)
    (hGd : ∀ j, initialForm (maximalIdeal A) (G j) ∈ AssocGraded.homogeneous (maximalIdeal A) (d j))
    (hdμ : ∀ j, d j ≤ mu A J a) (g : Fin N → A₁)
    (U : Set (Fin n))
    (hqU : ∀ j, M.Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ supported K U)
    (hq₁ : ∀ j, M₁.Φ.symm (initialForm (maximalIdeal A₁) (g j)) -
      M.Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ outIdeal (K := K) U)
    (hψT : ∀ j, initialForm (maximalIdeal A₁) (g j) ∈
      Algebra.adjoin (A₁ ⧸ maximalIdeal A₁) (tauSubmodule A₁ J₁ a :
        Set (AssocGraded (maximalIdeal A₁))))
    (Z : Submodule (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A)))
    (Z₁ : Submodule (A₁ ⧸ maximalIdeal A₁) (AssocGraded (maximalIdeal A₁)))
    (Zv At Ab : Set (Fin n)) (hZv : Zv ⊆ U) (hAt : At ⊆ U) (hdisj : Disjoint Zv At)
    (hZ : M.pull Z = Submodule.span K (X '' Zv)) (hZ₁ : M₁.pull Z₁ = Submodule.span K (X '' Zv))
    (hZT : Z₁ ≤ tauSubmodule A₁ J₁ a) (i₀ : Fin N)
    (hφ : initialForm (maximalIdeal A) (G i₀) ∈ Algebra.adjoin (A ⧸ maximalIdeal A)
      ((tauSubmodule A J a ⊔ Z : Submodule (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A))) :
        Set (AssocGraded (maximalIdeal A))))
    (hTad : M.pull (tauSubmodule A J a) = Submodule.span K (X '' (Zv ∪ At)))
    (hSad : M.pull (tauZSubmodule A (fun _ : Fin 1 => G i₀) ⊔ Z) =
      Submodule.span K (X '' (Zv ∪ Ab))) :
    Module.finrank (A ⧸ maximalIdeal A)
        ↥(tauZSubmodule A (fun _ : Fin 1 => G i₀) ⊔ Z) =
      Module.finrank (A₁ ⧸ maximalIdeal A₁)
        ↥(tauZSubmodule A₁ (fun _ : Fin 1 => g i₀) ⊔ Z₁) := by
  obtain ⟨hspec1, hspec2, -⟩ := tauSubmodule_spec A J a ha hat
  obtain ⟨hspec1', hspec2', -⟩ := tauSubmodule_spec A₁ J₁ a ha hat₁
  set q : Fin N → MvPolynomial (Fin n) K := fun j =>
    M.Φ.symm (initialForm (maximalIdeal A) (G j)) with hq
  set q₁ : Fin N → MvPolynomial (Fin n) K := fun j =>
    M₁.Φ.symm (initialForm (maximalIdeal A₁) (g j)) with hq₁def
  set T₀ := M.pull (tauSubmodule A J a) with hT₀def
  set T₁ := M₁.pull (tauSubmodule A₁ J₁ a) with hT₁def
  have hdeg : ∀ j, ∃ d' ≤ mu A J a, initialForm (maximalIdeal A) (G j) ∈
      AssocGraded.homogeneous (maximalIdeal A) d' := fun j => ⟨d j, hdμ j, hGd j⟩
  have hT₀ : IsTauSubmoduleMv K n (Ideal.span (Set.range q)) T₀ (mu A J a) :=
    (M.isTauZSubmodule_iff hhom G (mu A J a) hdeg _).mp ((hG _).mp hspec1)
  have hT₀min : ∀ T, IsTauSubmoduleMv K n (Ideal.span (Set.range q)) T (mu A J a) → T₀ ≤ T := by
    intro T hT
    have h1 : IsTauZSubmodule A G (M.push T) := by
      rw [M.isTauZSubmodule_iff hhom G (mu A J a) hdeg, M.pull_push]
      exact hT
    exact (M.pull_le_iff _ _).mpr (tauSubmodule_le A J a _ ((hG _).mpr h1))
  have hT₁ : T₁ ≤ homogeneousSubmodule (Fin n) K 1 := fun p hp => (hhom₁ 1 p).mpr (hspec1'.1 hp)
  have hq₁T₁ : ∀ j, q₁ j ∈ Algebra.adjoin K (T₁ : Set (MvPolynomial (Fin n) K)) := fun j => by
    rw [hT₁def, M₁.mem_adjoin_pull_iff, hq₁def]
    simp only
    rw [RingEquiv.apply_symm_apply]
    exact hψT j
  have hrank : Module.finrank K T₁ = Module.finrank K T₀ := by
    rw [hT₁def, hT₀def, M₁.finrank_pull, M.finrank_pull, hspec2, hspec2', hτ]
  -- the singleton data
  obtain ⟨hM₀, hφM₀, hM₀min⟩ := M.singleton_minimal hhom (G i₀)
  obtain ⟨hM₁, hΨM₁, hM₁min⟩ := M₁.singleton_minimal hhom₁ (g i₀)
  have hZT₁ : ∀ z ∈ Zv, (X z : MvPolynomial (Fin n) K) ∈ T₁ := by
    intro z hz
    have : (X z : MvPolynomial (Fin n) K) ∈ M₁.pull Z₁ := by
      rw [hZ₁]; exact Submodule.subset_span ⟨z, hz, rfl⟩
    exact (M₁.mem_pull).mpr (hZT ((M₁.mem_pull).mp this))
  -- Lemma 19 on the `R`-side: `φ ∈ k[T_a ⊕ Z] = k[T_a]`
  have hZle : Submodule.span K (X '' Zv) ≤ T₀ := by
    rw [hTad]
    exact Submodule.span_mono (Set.image_mono Set.subset_union_left)
  have hφT₀ : q i₀ ∈ Algebra.adjoin K (T₀ : Set (MvPolynomial (Fin n) K)) :=
    M.mem_adjoin_pull_of_sup (tauSubmodule A J a) Z Zv hZ hZle hφ
  have hM₀ad : M.pull (tauZSubmodule A (fun _ : Fin 1 => G i₀)) ⊔ Submodule.span K (X '' Zv) =
      Submodule.span K (X '' (Zv ∪ Ab)) := by
    rw [← hSad, M.pull_sup, hZ]
  have hmain := core_adapted_poly U Zv At hZv hAt hdisj q q₁ (mu A J a) hqU hq₁ T₀ T₁ hT₀ hT₀min
    hT₁ hq₁T₁ hrank hZT₁ hTad i₀ hφT₀ _ _ hM₀ hφM₀ hM₀min hM₁ hΨM₁ hM₁min Ab hM₀ad
  rw [← M₁.finrank_pull, ← M.finrank_pull, M₁.pull_sup, M.pull_sup, hZ₁, hZ]
  exact hmain.symm

/-- **The assembly of the proof of Lemma 21, with the choice of the coordinates** (pp. 256–258).
Given the polynomial pictures `k[Z, X_1, …, X_t, X, Y]` of `gr_M(R)` and `gr_{M₁}(R₁)` of the
coordinates `(z, x_k, x, y)`, `(w, u, x, y)`, and `T_a ⊇ Z` (p. 256: "`T_a` must contain
`Z_1, …, Z_r`, by (1), (2) and (11)"), `T_a ⊆ ⟨Z, X_1, …, X_t⟩` ("We claim that `T_a` is contained in
the `k`-submodule generated by `Z_1, …, Z_r, X_1, …, X_t`"), one chooses the system `(x_1, …, x_t)`
so that `T_a` is generated by `Z, X_1, …, X_τ`, and then (p. 257: "We may assume that
`φ ∈ k[Z_1, …, Z_r, X_1, …, X_τ̄]`") so that `T*(φ)` is generated by `Z, X_1, …, X_τ̄`: two changes of
the variables `X_j`, i.e. two compositions of both pictures with a `k`-linear change of the `X_j`
(`exists_blockAut_adapted`), after which `core_assembly_adapted` applies. -/
theorem core_assembly_printed
    (M : SemiModel K (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A)) n)
    (M₁ : SemiModel K (A₁ ⧸ maximalIdeal A₁) (AssocGraded (maximalIdeal A₁)) n)
    (hhom : ∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      M.Φ p ∈ AssocGraded.homogeneous (maximalIdeal A) d)
    (hhom₁ : ∀ (d : ℕ) (p : MvPolynomial (Fin n) K), p ∈ homogeneousSubmodule (Fin n) K d ↔
      M₁.Φ p ∈ AssocGraded.homogeneous (maximalIdeal A₁) d)
    (J : Ideal A) (J₁ : Ideal A₁) (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t A J) (hat₁ : a ≤ t A₁ J₁)
    (hτ : tau A₁ J₁ a = tau A J a)
    {N : ℕ} (G : Fin N → A) (d : Fin N → ℕ)
    (hG : ∀ T, IsTauSubmodule A J T (mu A J a) ↔ IsTauZSubmodule A G T)
    (hGd : ∀ j, initialForm (maximalIdeal A) (G j) ∈ AssocGraded.homogeneous (maximalIdeal A) (d j))
    (hdμ : ∀ j, d j ≤ mu A J a) (g : Fin N → A₁)
    (U : Set (Fin n))
    (hqU : ∀ j, M.Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ supported K U)
    (hq₁ : ∀ j, M₁.Φ.symm (initialForm (maximalIdeal A₁) (g j)) -
      M.Φ.symm (initialForm (maximalIdeal A) (G j)) ∈ outIdeal (K := K) U)
    (hψT : ∀ j, initialForm (maximalIdeal A₁) (g j) ∈
      Algebra.adjoin (A₁ ⧸ maximalIdeal A₁) (tauSubmodule A₁ J₁ a :
        Set (AssocGraded (maximalIdeal A₁))))
    (Z : Submodule (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A)))
    (Z₁ : Submodule (A₁ ⧸ maximalIdeal A₁) (AssocGraded (maximalIdeal A₁)))
    (Zv : Set (Fin n)) (hZv : Zv ⊆ U)
    (hZ : M.pull Z = Submodule.span K (X '' Zv)) (hZ₁ : M₁.pull Z₁ = Submodule.span K (X '' Zv))
    (hZT : Z₁ ≤ tauSubmodule A₁ J₁ a) (hZTa : Z ≤ tauSubmodule A J a) (i₀ : Fin N)
    (hφ : initialForm (maximalIdeal A) (G i₀) ∈ Algebra.adjoin (A ⧸ maximalIdeal A)
      ((tauSubmodule A J a ⊔ Z : Submodule (A ⧸ maximalIdeal A) (AssocGraded (maximalIdeal A))) :
        Set (AssocGraded (maximalIdeal A)))) :
    Module.finrank (A ⧸ maximalIdeal A)
        ↥(tauZSubmodule A (fun _ : Fin 1 => G i₀) ⊔ Z) =
      Module.finrank (A₁ ⧸ maximalIdeal A₁)
        ↥(tauZSubmodule A₁ (fun _ : Fin 1 => g i₀) ⊔ Z₁) := by
  obtain ⟨hspec1, hspec2, -⟩ := tauSubmodule_spec A J a ha hat
  set q : Fin N → MvPolynomial (Fin n) K := fun j =>
    M.Φ.symm (initialForm (maximalIdeal A) (G j)) with hq
  set T₀ := M.pull (tauSubmodule A J a) with hT₀def
  have hdeg : ∀ j, ∃ d' ≤ mu A J a, initialForm (maximalIdeal A) (G j) ∈
      AssocGraded.homogeneous (maximalIdeal A) d' := fun j => ⟨d j, hdμ j, hGd j⟩
  have hT₀ : IsTauSubmoduleMv K n (Ideal.span (Set.range q)) T₀ (mu A J a) :=
    (M.isTauZSubmodule_iff hhom G (mu A J a) hdeg _).mp ((hG _).mp hspec1)
  have hT₀min : ∀ T, IsTauSubmoduleMv K n (Ideal.span (Set.range q)) T (mu A J a) → T₀ ≤ T := by
    intro T hT
    have h1 : IsTauZSubmodule A G (M.push T) := by
      rw [M.isTauZSubmodule_iff hhom G (mu A J a) hdeg, M.pull_push]
      exact hT
    exact (M.pull_le_iff _ _).mpr (tauSubmodule_le A J a _ ((hG _).mpr h1))
  -- "`T_a` must contain `Z_1, …, Z_r`" (hypothesis `hZTa`)
  have hZT₀ : Submodule.span K (X '' Zv) ≤ T₀ := by
    rw [← hZ]
    exact M.pull_mono hZTa
  -- "We claim that `T_a` is contained in the `k`-submodule generated by `Z_1, …, Z_r, X_1, …, X_t`":
  -- the initial forms of the `G_j` are polynomials in `Z, X_1, …, X_t`
  have hT₀U : T₀ ≤ Submodule.span K (X '' U) := by
    refine hT₀min _ ?_
    rw [isTauSubmoduleMv_iff_span_eq K n q (mu A J a) (fun j => by
      obtain ⟨d', hd', h⟩ := hdeg j
      exact ⟨d', hd', (hhom d' _).mpr (by rw [hq]; simp only; rwa [RingEquiv.apply_symm_apply])⟩)]
    refine ⟨?_, le_antisymm (Ideal.span_le.mpr fun x hx => hx.1) ?_⟩
    · rw [Submodule.span_le]
      rintro _ ⟨i, -, rfl⟩
      exact isHomogeneous_X K i
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      refine Ideal.subset_span ⟨Ideal.subset_span ⟨j, rfl⟩, ?_⟩
      have hqj : q j ∈ Algebra.adjoin K
          ((Submodule.span K (X '' U) : Submodule K (MvPolynomial (Fin n) K)) :
            Set (MvPolynomial (Fin n) K)) := by
        rw [Algebra.adjoin_span, ← supported_eq_adjoin_X]
        exact hqU j
      exact hqj
  -- the first choice of coordinates: `T_a` is generated by `Z, X_1, …, X_τ`
  set Av : Set (Fin n) := U \ Zv with hAv
  have hdisj1 : Disjoint Zv Av := Set.disjoint_sdiff_right
  have hAvU : Av ⊆ U := Set.sdiff_subset
  have hUeq : Zv ∪ Av = U := Set.union_sdiff_cancel hZv
  have hT₀U' : T₀ ≤ Submodule.span K (X '' (Zv ∪ Av)) := by rw [hUeq]; exact hT₀U
  obtain ⟨σ₁, At, hσ₁, hAtAv, hσ₁ad⟩ := exists_blockAut_adapted Av (T₀ ⊓ Submodule.span K (X '' Av))
    inf_le_right
  have hcomap1 := mem_span_union_iff_of_blockAut hσ₁ hdisj1 T₀ hZT₀ hT₀U' hσ₁ad
  obtain ⟨hh1, hh1', hqU1, hq₁1, hZ1, hZ₁1⟩ := models_comp_hypotheses M M₁ hhom hhom₁ hσ₁ hAvU
    hdisj1 G g hqU hq₁ Z Z₁ hZ hZ₁
  set N₀ := M.comp σ₁ with hN₀
  set N₁ := M₁.comp σ₁ with hN₁
  have hTad1 : N₀.pull (tauSubmodule A J a) = Submodule.span K (X '' (Zv ∪ At)) :=
    Submodule.ext fun p => hcomap1 p
  have hAtU : At ⊆ U := hAtAv.trans hAvU
  have hdisj2 : Disjoint Zv At := Set.disjoint_of_subset_right hAtAv hdisj1
  -- "We may assume that `φ ∈ k[Z, X_1, …, X_τ̄]`": the second choice of coordinates
  set S : Submodule K (MvPolynomial (Fin n) K) :=
    N₀.pull (tauZSubmodule A (fun _ : Fin 1 => G i₀) ⊔ Z) with hS
  have hZS : Submodule.span K (X '' Zv) ≤ S := by
    rw [← hZ1]
    exact N₀.pull_mono le_sup_right
  have hZTa1 : Submodule.span K (X '' Zv) ≤ N₀.pull (tauSubmodule A J a) := by
    rw [hTad1]
    exact Submodule.span_mono (Set.image_mono Set.subset_union_left)
  have hφ1 := N₀.mem_adjoin_pull_of_sup _ Z Zv hZ1 hZTa1 hφ
  obtain ⟨-, -, hM₀min1⟩ := N₀.singleton_minimal hh1 (G i₀)
  have hM₀le : N₀.pull (tauZSubmodule A (fun _ : Fin 1 => G i₀)) ≤
      N₀.pull (tauSubmodule A J a) := by
    refine hM₀min1 _ ?_ hφ1
    intro p hp
    exact (hh1 1 p).mpr (hspec1.1 hp)
  have hSU : S ≤ Submodule.span K (X '' (Zv ∪ At)) := by
    rw [hS, N₀.pull_sup, hZ1, ← hTad1]
    exact sup_le hM₀le hZTa1
  obtain ⟨σ₂, Ab, hσ₂, hAbAt, hσ₂ad⟩ := exists_blockAut_adapted At (S ⊓ Submodule.span K (X '' At))
    inf_le_right
  have hcomap2 := mem_span_union_iff_of_blockAut hσ₂ hdisj2 S hZS hSU hσ₂ad
  obtain ⟨hh2, hh2', hqU2, hq₁2, hZ2, hZ₁2⟩ := models_comp_hypotheses N₀ N₁ hh1 hh1' hσ₂ hAtU
    hdisj2 G g hqU1 hq₁1 Z Z₁ hZ1 hZ₁1
  have hTad2 : (N₀.comp σ₂).pull (tauSubmodule A J a) =
      Submodule.span K (X '' (Zv ∪ At)) := by
    ext p
    rw [SemiModel.mem_pull_comp, hTad1]
    constructor
    · intro hp
      have := hσ₂.symm.map_mem_span_union hdisj2 hp
      simpa using this
    · intro hp
      exact hσ₂.map_mem_span_union hdisj2 hp
  have hSad2 : (N₀.comp σ₂).pull (tauZSubmodule A (fun _ : Fin 1 => G i₀) ⊔ Z) =
      Submodule.span K (X '' (Zv ∪ Ab)) :=
    Submodule.ext fun p => hcomap2 p
  exact core_assembly_adapted (N₀.comp σ₂) (N₁.comp σ₂) hh2 hh2' J J₁ a ha hat hat₁ hτ G d hG hGd
    hdμ g U hqU2 hq₁2 hψT Z Z₁ Zv At Ab hZv hAtU hdisj2 hZ2 hZ₁2 hZT i₀ hφ hTad2 hSad2


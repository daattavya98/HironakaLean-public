module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.Ideal
public import Hironaka.Ch0.AlgebraicScheme
public import Hironaka.Compat.IdealSheafStalk

/-!
# A sheaf of ideals defined by locally generated stalk ideals (Compat API for Corollary 2 of Main Theorem II)

Hironaka, Ch. 0, Corollary 2 of Main Theorem II (p. 145): "Let `J` be the coherent sheaf of ideals on `X`
which is defined as follows: for each point `x` of `X`, we choose a free base [...] and we write
`d = ∑ h_j c_j` [...] Now `J` is defined in such a way that `J_x = (h_1, …, h_r) O_{X,x}`."  Hironaka does not
say why ideals `J_x` of the local rings which are generated, near each point, by finitely many sections form
a coherent sheaf of ideals.  This module proves it (a gap filled, the quasi-coherence of a locally generated
family of ideals):

* `Hironaka.IsLocallyGenerated J`: a family of ideals `J x ⊆ 𝒪_{X,x}` is generated near every point by
  finitely many sections over an affine open set;
* `Hironaka.exists_subscheme_of_isLocallyGenerated`: on a locally noetherian scheme such a family is the
  family of stalks of a sheaf of ideals `K : Subscheme X`.

The sections of `K` over an affine open set `U` are the `a` with all germs in `J x`; the point is that
`K_x = J_x` (`exists_pow_mul_mem_sectionIdeal`: a section which lies in `J` on a basic open set `D(g)` lies in
`J` on `U` after multiplication by a power of `g`; proved by compactness of `U` and the local generators).

This is infrastructure (no statement of the paper).
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite

namespace Hironaka

universe u

/-- Inverting `γ`: if `b/1` lies in the extension of an ideal `𝔟` to the localization `R_γ`, then `γ^N b ∈ 𝔟`
for some `N`. -/
theorem exists_pow_mul_mem_of_mem_map {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (γ : R) [IsLocalization.Away γ S] (𝔟 : Ideal R) (b : R)
    (h : algebraMap R S b ∈ 𝔟.map (algebraMap R S)) : ∃ N : ℕ, γ ^ N * b ∈ 𝔟 := by
  obtain ⟨⟨x, ⟨m, M, rfl⟩⟩, hx⟩ :=
    (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers γ) S).mp h
  obtain ⟨⟨c, N, rfl⟩, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers γ) S).mp
    (show algebraMap R S (b * γ ^ M) = algebraMap R S ↑x by
      rw [map_mul]; simpa using hx)
  refine ⟨N + M, ?_⟩
  have : γ ^ (N + M) * b = γ ^ N * ↑x := by
    simp only at hc
    rw [pow_add]
    calc γ ^ N * γ ^ M * b = γ ^ N * (b * γ ^ M) := by ring
      _ = _ := hc
  rw [this]
  exact Ideal.mul_mem_left _ _ x.2

variable {X : Scheme.{u}}

/-- A family of ideals `J x ⊆ 𝒪_{X,x}` is *locally generated*: every point has an affine open neighbourhood `W`
and finitely many sections `h_k` over `W` such that `J y` is generated by the germs of the `h_k`, for all
`y ∈ W`. -/
def IsLocallyGenerated (J : ∀ x : X, Ideal (X.presheaf.stalk x)) : Prop :=
  ∀ x : X, ∃ (W : X.Opens) (_ : IsAffineOpen W) (_ : x ∈ W) (κ : Type u) (_ : Finite κ) (h : κ → Γ(X, W)),
    ∀ (y : X) (hy : y ∈ W),
      J y = Ideal.span (Set.range fun k => (X.presheaf.germ W y hy).hom (h k))

/-- The sections over `U` all of whose germs lie in the ideals `J x`. -/
noncomputable def sectionIdeal (J : ∀ x : X, Ideal (X.presheaf.stalk x)) (U : X.Opens) : Ideal Γ(X, U) :=
  ⨅ (x : X) (hx : x ∈ U), (J x).comap (X.presheaf.germ U x hx).hom

/-- Membership in `sectionIdeal`: all germs lie in the given ideals. -/
theorem mem_sectionIdeal_iff (J : ∀ x : X, Ideal (X.presheaf.stalk x)) {U : X.Opens} {a : Γ(X, U)} :
    a ∈ sectionIdeal J U ↔ ∀ (x : X) (hx : x ∈ U), (X.presheaf.germ U x hx).hom a ∈ J x := by
  simp [sectionIdeal, Submodule.mem_iInf]

variable {J : ∀ x : X, Ideal (X.presheaf.stalk x)}

/-- **Saturation.**  If a section `a` over an affine open set `U` has all germs in `J` on the basic open set
`D(g)`, then `g^N a` has all its germs in `J` on `U`, for some `N`. -/
theorem exists_pow_mul_mem_sectionIdeal (hJ : IsLocallyGenerated J) [IsLocallyNoetherian X]
    {U : X.Opens} (hU : IsAffineOpen U) (g a : Γ(X, U))
    (ha : ∀ (z : X) (hz : z ∈ U), z ∈ X.basicOpen g → (X.presheaf.germ U z hz).hom a ∈ J z) :
    ∃ N : ℕ, g ^ N * a ∈ sectionIdeal J U := by
  have key : ∀ y : U, ∃ (gy : Γ(X, U)) (N : ℕ), (y : X) ∈ X.basicOpen gy ∧
      ∀ (z : X) (hz : z ∈ U), z ∈ X.basicOpen gy →
        (X.presheaf.germ U z hz).hom (g ^ N * a) ∈ J z := by
    intro y
    obtain ⟨W, hW, hyW, κ, hκ, h, hspec⟩ := hJ y
    obtain ⟨f, w, hfw, hyf⟩ := exists_basicOpen_le_affine_inter hU hW y ⟨y.2, hyW⟩
    have hV' : IsAffineOpen (X.basicOpen f) := hU.basicOpen f
    have hV'W : X.basicOpen f ≤ W := hfw ▸ X.basicOpen_le w
    have hV'U : X.basicOpen f ≤ U := X.basicOpen_le f
    let γ : Γ(X, X.basicOpen f) := (X.presheaf.map (homOfLE hV'U).op).hom g
    let b : Γ(X, X.basicOpen f) := (X.presheaf.map (homOfLE hV'U).op).hom a
    let 𝔟 : Ideal Γ(X, X.basicOpen f) :=
      Ideal.span (Set.range fun k => (X.presheaf.map (homOfLE hV'W).op).hom (h k))
    -- the stalk ideals on `D(f)` are the extensions of `𝔟`
    have F1 : ∀ (z : X) (hz : z ∈ X.basicOpen f),
        J z = 𝔟.map (X.presheaf.germ (X.basicOpen f) z hz).hom := by
      intro z hz
      rw [hspec z (hV'W hz), Ideal.map_span, ← Set.range_comp]
      congr 2
      funext k
      exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hV'W) z hz (h k)).symm
    -- `b/1` lies in `𝔟` after inverting `γ`
    have hU₂ : IsAffineOpen (X.basicOpen γ) := hV'.basicOpen γ
    have hloc : IsLocalization.Away γ Γ(X, X.basicOpen γ) := hV'.isLocalization_basicOpen γ
    have F2 : algebraMap Γ(X, X.basicOpen f) Γ(X, X.basicOpen γ) b ∈
        𝔟.map (algebraMap Γ(X, X.basicOpen f) Γ(X, X.basicOpen γ)) := by
      refine (hU₂.mem_ideal_iff).mpr fun z hz => ?_
      have hzV' : z ∈ X.basicOpen f := X.basicOpen_le γ hz
      have hzU : z ∈ U := hV'U hzV'
      have hzg : z ∈ X.basicOpen g := by
        have : X.basicOpen γ = X.basicOpen f ⊓ X.basicOpen g := X.basicOpen_res g _
        rw [this] at hz
        exact hz.2
      have h1 : (X.presheaf.germ (X.basicOpen γ) z hz).hom
          (algebraMap Γ(X, X.basicOpen f) Γ(X, X.basicOpen γ) b) =
          (X.presheaf.germ U z hzU).hom a := by
        change (X.presheaf.germ (X.basicOpen γ) z hz).hom
          ((X.presheaf.map (homOfLE (X.basicOpen_le γ)).op).hom
            ((X.presheaf.map (homOfLE hV'U).op).hom a)) = _
        rw [TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
      have h2 : (𝔟.map (algebraMap Γ(X, X.basicOpen f) Γ(X, X.basicOpen γ))).map
          (X.presheaf.germ (X.basicOpen γ) z hz).hom =
          𝔟.map (X.presheaf.germ (X.basicOpen f) z hzV').hom := by
        rw [Ideal.map_map]
        congr 1
        ext s
        exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le γ)) z hz s
      rw [h1, h2, ← F1 z hzV']
      exact ha z hzU hzg
    obtain ⟨N, hN⟩ := exists_pow_mul_mem_of_mem_map γ 𝔟 b F2
    refine ⟨f, N, hyf, fun z hz hzf => ?_⟩
    have hmem := Ideal.mem_map_of_mem (X.presheaf.germ (X.basicOpen f) z hzf).hom hN
    rw [← F1 z hzf] at hmem
    have h3 : (X.presheaf.germ (X.basicOpen f) z hzf).hom (γ ^ N * b) =
        (X.presheaf.germ U z hz).hom (g ^ N * a) := by
      change (X.presheaf.germ (X.basicOpen f) z hzf).hom
        ((X.presheaf.map (homOfLE hV'U).op).hom g ^ N *
          (X.presheaf.map (homOfLE hV'U).op).hom a) = _
      rw [← map_pow, ← map_mul]
      exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hV'U) z hzf _
    rwa [h3] at hmem
  choose gy N hy hN using key
  obtain ⟨t, ht⟩ := hU.isCompact.elim_finite_subcover (fun y : U => (X.basicOpen (gy y) : Set X))
    (fun y => (X.basicOpen (gy y)).isOpen) (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hy ⟨z, hz⟩⟩)
  refine ⟨t.sup N, ?_⟩
  rw [mem_sectionIdeal_iff]
  intro z hz
  obtain ⟨y, hyt, hzy⟩ := Set.mem_iUnion₂.mp (ht hz)
  obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (Finset.le_sup hyt : N y ≤ t.sup N)
  have h1 := hN y z hz hzy
  have : g ^ t.sup N * a = g ^ d * (g ^ N y * a) := by rw [hd, pow_add]; ring
  rw [this, map_mul]
  exact Ideal.mul_mem_left _ _ h1

/-- The stalk of the sections over an affine open set contains `J x`: `J x ⊆ (sectionIdeal J U) 𝒪_{X,x}`. -/
theorem le_map_sectionIdeal (hJ : IsLocallyGenerated J) [IsLocallyNoetherian X] {U : X.Opens}
    (hU : IsAffineOpen U) {x : X} (hx : x ∈ U) :
    J x ≤ (sectionIdeal J U).map (X.presheaf.germ U x hx).hom := by
  obtain ⟨W, hW, hxW, κ, hκ, h, hspec⟩ := hJ x
  obtain ⟨g, w, hgw, hxg⟩ := exists_basicOpen_le_affine_inter hU hW x ⟨hx, hxW⟩
  have hDW : X.basicOpen g ≤ W := hgw ▸ X.basicOpen_le w
  have hDU : X.basicOpen g ≤ U := X.basicOpen_le g
  have hloc : IsLocalization.Away g Γ(X, X.basicOpen g) := hU.isLocalization_basicOpen g
  rw [hspec x hxW, Ideal.span_le]
  rintro _ ⟨k, rfl⟩
  -- clear denominators
  obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, hp⟩ := IsLocalization.surj (Submonoid.powers g)
    ((X.presheaf.map (homOfLE hDW).op).hom (h k))
  have hp' : (X.presheaf.map (homOfLE hDU).op).hom a =
      (X.presheaf.map (homOfLE hDW).op).hom (h k) * (X.presheaf.map (homOfLE hDU).op).hom (g ^ n) :=
    hp.symm
  have ha : ∀ (z : X) (hz : z ∈ U), z ∈ X.basicOpen g → (X.presheaf.germ U z hz).hom a ∈ J z := by
    intro z hz hzg
    have e1 : (X.presheaf.germ U z hz).hom a =
        (X.presheaf.germ (X.basicOpen g) z hzg).hom ((X.presheaf.map (homOfLE hDU).op).hom a) :=
      (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hDU) z hzg a).symm
    have e2 : (X.presheaf.germ (X.basicOpen g) z hzg).hom
        ((X.presheaf.map (homOfLE hDW).op).hom (h k)) = (X.presheaf.germ W z (hDW hzg)).hom (h k) :=
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hDW) z hzg (h k)
    rw [e1, hp', map_mul, e2, hspec z (hDW hzg)]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨k, rfl⟩)
  obtain ⟨N, hN⟩ := exists_pow_mul_mem_sectionIdeal hJ hU g a ha
  have hmem := Ideal.mem_map_of_mem (X.presheaf.germ U x hx).hom hN
  have hunit : IsUnit ((X.presheaf.germ U x hx).hom g) := (X.mem_basicOpen g x hx).mp hxg
  have e3 : (X.presheaf.germ U x hx).hom (g ^ N * a) =
      (X.presheaf.germ U x hx).hom g ^ (N + n) * (X.presheaf.germ W x hxW).hom (h k) := by
    have e1 : (X.presheaf.germ U x hx).hom a =
        (X.presheaf.germ (X.basicOpen g) x hxg).hom ((X.presheaf.map (homOfLE hDU).op).hom a) :=
      (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hDU) x hxg a).symm
    have e2 : (X.presheaf.germ (X.basicOpen g) x hxg).hom
        ((X.presheaf.map (homOfLE hDW).op).hom (h k)) = (X.presheaf.germ W x hxW).hom (h k) :=
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hDW) x hxg (h k)
    have e4 : (X.presheaf.germ (X.basicOpen g) x hxg).hom ((X.presheaf.map (homOfLE hDU).op).hom (g ^ n)) =
        (X.presheaf.germ U x hx).hom g ^ n := by
      rw [TopCat.Presheaf.germ_res_apply, map_pow]
    rw [map_mul, map_pow, e1, hp', map_mul, e2, e4, pow_add]
    ring
  rw [e3] at hmem
  obtain ⟨u, hu⟩ := (hunit.pow (N + n))
  have := Ideal.mul_mem_left _ (↑u⁻¹ : (X.presheaf.stalk x)) hmem
  rwa [← mul_assoc, ← hu, Units.inv_mul, one_mul] at this

/-- The restriction of a section ideal to a basic open set. -/
theorem map_sectionIdeal_basicOpen (hJ : IsLocallyGenerated J) [IsLocallyNoetherian X] {U : X.Opens}
    (hU : IsAffineOpen U) (f : Γ(X, U)) :
    (sectionIdeal J U).map (X.presheaf.map (homOfLE <| X.basicOpen_le f).op).hom =
      sectionIdeal J (X.basicOpen f) := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, mem_sectionIdeal_iff]
    intro z hz
    rw [TopCat.Presheaf.germ_res_apply]
    exact (mem_sectionIdeal_iff J).mp ha z _
  · intro b hb
    refine (hU.basicOpen f).mem_ideal_iff.mpr fun z hz => ?_
    have hzU : z ∈ U := X.basicOpen_le f hz
    have h1 : ((sectionIdeal J U).map (X.presheaf.map (homOfLE <| X.basicOpen_le f).op).hom).map
        (X.presheaf.germ (X.basicOpen f) z hz).hom = (sectionIdeal J U).map (X.presheaf.germ U z hzU).hom := by
      rw [Ideal.map_map]
      congr 1
      ext s
      exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE <| X.basicOpen_le f) z hz s
    rw [h1]
    exact le_map_sectionIdeal hJ hU hzU ((mem_sectionIdeal_iff J).mp hb z hz)

/-- **The sheaf of ideals with prescribed locally generated stalks.** -/
noncomputable def subschemeOfLocallyGenerated (hJ : IsLocallyGenerated J) [IsLocallyNoetherian X] :
    Subscheme X where
  ideal U := sectionIdeal J U.1
  map_ideal_basicOpen U f := map_sectionIdeal_basicOpen hJ U.2 f

/-- The stalks of `subschemeOfLocallyGenerated` are the given ideals. -/
theorem stalkIdeal_subschemeOfLocallyGenerated (hJ : IsLocallyGenerated J) [IsLocallyNoetherian X]
    (x : X) : (subschemeOfLocallyGenerated hJ).stalkIdeal x = J x := by
  obtain ⟨U, hx⟩ := Subscheme.exists_affineOpen_mem x
  rw [Subscheme.stalkIdeal_eq_map_germ_affine _ U hx]
  refine le_antisymm ?_ (le_map_sectionIdeal hJ U.2 hx)
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  exact (mem_sectionIdeal_iff J).mp ha x hx

/-- On a locally noetherian scheme, a locally generated family of ideals `J x ⊆ 𝒪_{X,x}` is the family of
stalks of a sheaf of ideals. -/
theorem exists_subscheme_of_isLocallyGenerated [IsLocallyNoetherian X] (hJ : IsLocallyGenerated J) :
    ∃ K : Subscheme X, ∀ x, K.stalkIdeal x = J x :=
  ⟨subschemeOfLocallyGenerated hJ, stalkIdeal_subschemeOfLocallyGenerated hJ⟩

end Hironaka

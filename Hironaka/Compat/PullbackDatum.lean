module

public import Hironaka.Compat.CoordinateIdeal
public import Hironaka.Compat.TotalTransformInvertible
public import Hironaka.Compat.GermNeighbourhood
public import Hironaka.Compat.StalkPrimitive

/-!
# The local datum of Corollary 2 at a point of `X'` (Ch. 0, proof of Corollary 2, p. 145)

Hironaka, Ch. 0 §5, proof of Corollary 2 (p. 145): "We then obtain an invertible subsheaf `L` of `f*(F)` such
that `f*(M) = f^{-1}(J)L`".  Locally on `X'` the ideal `f⁻¹(J)·O_{X'}` is generated by one element `g` which is
not a zero divisor (`Hironaka/Compat/TotalTransformInvertible.lean`), and it is also generated by the pull-backs
`f^♯ h_j` of the coordinates `h_j` of a local generator of `M` in a local frame of `F`.  Hence
`f^♯ h_j = g h'_j` with `(h'_j)` generating the unit ideal: the vector `e = ∑ h'_j f*(c_j)` is the generator of `L`
(the "easily seen" step).  This module extracts this local datum as sections over a neighbourhood:

* `Hironaka.PullbackDatum f i y`: frames `c` of `F` and `d` of `M`, a neighbourhood `V'` of `y` in `X'`, and sections
  `g, h'_j, a_j` over `V'` with `f^♯ h_j = g h'_j`, `∑ a_j h'_j = 1` and `g` non-zero at all points;
* `Hironaka.PullbackDatum.nonempty`: the datum exists at every point, when `X'` is integral and `f⁻¹(J)` is
  invertible.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme TopologicalSpace Opposite
open Hironaka.Scheme.Modules AlgebraicGeometry.Scheme.Modules

namespace Hironaka

universe u

variable {X Y : Scheme.{u}} {M F : X.Modules}

/-- The local datum at `y`: a frame `c` of `F` over `U`, a generator `d` of `M` over `V`, `W ≤ U ⊓ V` containing
`f y`, a neighbourhood `V' ≤ f⁻¹W` of `y` and sections over `V'` with `f^♯ h_j = g h'_j`, `∑ a_j h'_j = 1`, `g`
non-zero at every point of `V'`, where `h_j` are the coordinates of `i(d)` in the frame `c` over `W`. -/
structure PullbackDatum (f : Y ⟶ X) (i : M ⟶ F) (y : Y) where
  /-- the open set of the frame of `F` -/
  U : X.Opens
  /-- the open set of the generator of `M` -/
  V : X.Opens
  /-- the common open set -/
  W : X.Opens
  /-- the rank index -/
  ι : Type u
  fintype : Fintype ι
  /-- the frame of `F` -/
  c : ι → Γ(F, U)
  hc : IsFrame F U c
  /-- the generator of `M` -/
  d : Γ(M, V)
  hd : IsFrame M V (fun _ : PUnit.{u + 1} => d)
  hWU : W ≤ U
  hWV : W ≤ V
  hyW : f y ∈ W
  /-- the neighbourhood of `y` -/
  V' : Y.Opens
  hyV' : y ∈ V'
  hV'W : V' ≤ f ⁻¹ᵁ W
  g : Γ(Y, V')
  h' : ι → Γ(Y, V')
  a : ι → Γ(Y, V')
  hg : ∀ j, resO Y hV'W (f.app W (hc.coord hWU (i.app W (M.sectionRes hWV d)) j)) = g * h' j
  ha : ∑ j, a j * h' j = 1
  hg0 : ∀ (z : Y) (hz : z ∈ V'), (Y.presheaf.germ V' z hz).hom g ≠ 0

attribute [instance] PullbackDatum.fintype

/-- **The local datum exists at every point**: `X'` integral, `f⁻¹(J)` invertible. -/
theorem PullbackDatum.nonempty [IsIntegral Y] [IsLocallyNoetherian X] (f : Y ⟶ X) (i : M ⟶ F)
    (hF : HasLocalFrames F) (hM : IsInvertible M)
    (hinv : (Subscheme.totalTransform f (coordSubscheme i hF hM)).IsInvertibleIdeal) (y : Y) :
    Nonempty (PullbackDatum f i y) := by
  obtain ⟨U, hxU, ι, hι, c, hc⟩ := hF (f y)
  obtain ⟨V, hxV, d, hd⟩ := hM (f y)
  have hWU : U ⊓ V ≤ U := inf_le_left
  have hWV : U ⊓ V ≤ V := inf_le_right
  have hxW : f y ∈ U ⊓ V := ⟨hxU, hxV⟩
  set W : X.Opens := U ⊓ V with hW
  let h : ι → Γ(X, W) := fun j => hc.coord hWU (i.app W (M.sectionRes hWV d)) j
  have hJx := stalkIdeal_coordSubscheme_eq_span i hF hM hc hd hWV hWU hxW
  -- the stalk of `f⁻¹(J)` at `y`
  let e : ι → Y.presheaf.stalk y := fun j => (Y.presheaf.germ (f ⁻¹ᵁ W) y hxW).hom (f.app W (h j))
  have hI : (Subscheme.totalTransform f (coordSubscheme i hF hM)).stalkIdeal y =
      Ideal.span (Set.range e) := by
    change Subscheme.stalkIdeal ((coordSubscheme i hF hM).comap f) y = _
    rw [Subscheme.stalkIdeal_comap, hJx, Ideal.map_span, ← Set.range_comp]
    congr 2
    funext j
    exact Scheme.Hom.germ_stalkMap_apply f W y hxW (h j)
  obtain ⟨g0, hg0span, hg0nzd⟩ := hinv.exists_stalkIdeal_eq_span y
  rw [hI] at hg0span
  have hmem : ∀ j, e j ∈ Ideal.span {g0} := fun j => hg0span ▸ Ideal.subset_span ⟨j, rfl⟩
  choose h'0 hh'0 using fun j => Ideal.mem_span_singleton'.mp (hmem j)
  have hg0mem : g0 ∈ Ideal.span (Set.range e) := hg0span ▸ Ideal.mem_span_singleton_self g0
  obtain ⟨a0, ha0⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hg0mem
  have hsum0 : ∑ j, a0 j * h'0 j = 1 := by
    have h1 : (∑ j, a0 j * h'0 j - 1) * g0 = 0 := by
      rw [sub_mul, one_mul, Finset.sum_mul]
      have : ∑ j, a0 j * h'0 j * g0 = ∑ j, a0 j * e j :=
        Finset.sum_congr rfl fun j _ => by rw [mul_assoc, hh'0 j]
      rw [this, ha0, sub_self]
    exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff.mp hg0nzd).2 _ h1)
  have hg00 : g0 ≠ 0 := nonZeroDivisors.ne_zero hg0nzd
  -- spread out to sections
  let e' : ι ⊕ ι ⊕ PUnit.{u + 1} → Y.presheaf.stalk y :=
    Sum.elim h'0 (Sum.elim a0 (fun _ => g0))
  obtain ⟨V₁, hyV₁, s, hs⟩ := exists_sections_of_stalks e'
  let V₂ : Y.Opens := V₁ ⊓ f ⁻¹ᵁ W
  have hyV₂ : y ∈ V₂ := ⟨hyV₁, hxW⟩
  let H' : ι → Γ(Y, V₂) := fun j => resO Y (inf_le_left : V₂ ≤ V₁) (s (Sum.inl j))
  let A : ι → Γ(Y, V₂) := fun j => resO Y (inf_le_left : V₂ ≤ V₁) (s (Sum.inr (Sum.inl j)))
  let G : Γ(Y, V₂) := resO Y (inf_le_left : V₂ ≤ V₁) (s (Sum.inr (Sum.inr PUnit.unit)))
  have hgermH : ∀ j, (Y.presheaf.germ V₂ y hyV₂).hom (H' j) = h'0 j := fun j => by
    exact (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (inf_le_left : V₂ ≤ V₁)) y hyV₂ _).trans
      (hs (Sum.inl j))
  have hgermA : ∀ j, (Y.presheaf.germ V₂ y hyV₂).hom (A j) = a0 j := fun j => by
    exact (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (inf_le_left : V₂ ≤ V₁)) y hyV₂ _).trans
      (hs (Sum.inr (Sum.inl j)))
  have hgermG : (Y.presheaf.germ V₂ y hyV₂).hom G = g0 := by
    exact (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (inf_le_left : V₂ ≤ V₁)) y hyV₂ _).trans
      (hs (Sum.inr (Sum.inr PUnit.unit)))
  let σ : ι ⊕ PUnit.{u + 1} → Γ(Y, V₂) := Sum.elim
    (fun j => resO Y (inf_le_right : V₂ ≤ f ⁻¹ᵁ W) (f.app W (h j))) (fun _ => ∑ j, A j * H' j)
  let τ : ι ⊕ PUnit.{u + 1} → Γ(Y, V₂) := Sum.elim (fun j => G * H' j) (fun _ => 1)
  have hgerm : ∀ k, (Y.presheaf.germ V₂ y hyV₂).hom (σ k) = (Y.presheaf.germ V₂ y hyV₂).hom (τ k) := by
    rintro (j | _)
    · simp only [σ, τ, Sum.elim_inl, map_mul, hgermG, hgermH]
      rw [mul_comm]
      exact (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (inf_le_right : V₂ ≤ f ⁻¹ᵁ W)) y hyV₂
        _).trans (hh'0 j).symm
    · simp only [σ, τ, Sum.elim_inr, map_sum, map_mul, map_one, hgermA, hgermH]
      exact hsum0
  obtain ⟨V₃, hyV₃, hV₃, heq⟩ := exists_opens_resO_eq_of_germ_eq hyV₂ σ τ hgerm
  have hV₃W : V₃ ≤ f ⁻¹ᵁ W := hV₃.trans inf_le_right
  have hne : Nonempty V₃ := ⟨⟨y, hyV₃⟩⟩
  have hgnz : ∀ (z : Y) (hz : z ∈ V₃), (Y.presheaf.germ V₃ z hz).hom (resO Y hV₃ G) ≠ 0 := by
    have hε : Y.germToFunctionField V₃ (resO Y hV₃ G) ≠ 0 := by
      have e1 := Scheme.algebraMap_germ_eq_germToFunctionField Y hyV₃ (resO Y hV₃ G)
      have e2 : (Y.presheaf.germ V₃ y hyV₃).hom (resO Y hV₃ G) = g0 := by
        rw [← hgermG]
        exact TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hV₃) y hyV₃ _
      rw [← e1, e2]
      exact fun h0 => hg00 ((IsFractionRing.injective (Y.presheaf.stalk y) Y.functionField)
        (by rw [h0, map_zero]))
    intro z hz h0
    have e1 := Scheme.algebraMap_germ_eq_germToFunctionField Y hz (resO Y hV₃ G)
    rw [h0, map_zero] at e1
    exact hε e1.symm
  refine ⟨⟨U, V, W, ι, hι, c, hc, d, hd, hWU, hWV, hxW, V₃, hyV₃, hV₃W, resO Y hV₃ G,
    fun j => resO Y hV₃ (H' j), fun j => resO Y hV₃ (A j), fun j => ?_, ?_, hgnz⟩⟩
  · have := heq (Sum.inl j)
    simp only [σ, τ, Sum.elim_inl] at this
    rw [resO_resO] at this
    rw [this]
    exact resO_mul Y hV₃ G (H' j)
  · have := heq (Sum.inr PUnit.unit)
    simp only [σ, τ, Sum.elim_inr] at this
    rw [resO_sum, resO_one] at this
    simp only [resO_mul] at this
    exact this

end Hironaka

/-!
# Compatibility layer: regularity over the fibre of a flat extension (property (c), p. 161)

Footnote 31 (p. 161): "Reduce the proof to the case in which S is complete".  Let `S` satisfy
condition (ii) of the class 𝔅, `A` be a finite type `S`-algebra, `R = A_M` a localization of `A`,
`A' = A ⊗_S Ŝ`, `R'` a localization of `A'` over `R`, and `C` a finite type `R`-algebra.  Then every
prime `Q` of `R' ⊗_R C` lying over a regular prime of `C` is regular.

The proof clears the denominators: `C = C₀ ⊗_A R` for a finite type `A`-algebra `C₀` (the
subalgebra generated over `A` by generators of `C` over `R`).  Then `R' ⊗_R C` is the localization
of `D = C₀ ⊗_S Ŝ` at the image of `M'` (pasting of pushout squares, `RingPushoutSquares.lean`),
and condition (ii) for `S` applied to `C₀` shows that regularity of the contraction to `C₀`
implies regularity in `D`.
-/

@[expose] public section

open IsLocalRing
open scoped TensorProduct

noncomputable section

namespace Hironaka

universe u

/-- A finite type algebra over `A_M` is the localization at `M` of a finite type `A`-algebra (the
subalgebra generated over `A` by a finite set of generators over `A_M`).

Deviation from the paper (gap filled): footnote 31 (p. 161), "Reduce the proof to the case in which
S is complete", does not mention this clearing of denominators. -/
@[blueprint "lem:class-A-c-clear-denominators"
  (statement := /-- Let $A$ be a ring, $M$ a submonoid and $C$ a finite type $A_M$-algebra. Then
    there is a finite type $A$-algebra $C_0$ with a homomorphism $C_0\to C$ compatible with
    $A\to A_M$ such that $C$ is the localization of $C_0$ at the image of $M$. -/)
  (proof := /-- Let $s$ be a finite set of generators of $C$ over $A_M$ and $C_0$ the $A$-subalgebra
    of $C$ generated by $s$. It is of finite type over $A$. Every element of $C$ is a polynomial in
    $s$ with coefficients in $A_M$, hence after multiplying by a common denominator $m\in M$ an
    element of $C_0$. The inclusion $C_0\to C$ is injective and the elements of $M$ become units
    in $C$. \textbf{Deviation from the paper (gap filled).} Footnote~31 does not mention this
    step. -/)
  (latexEnv := "lemma")]
theorem exists_finiteType_isLocalization_of_finiteType {A : Type u} [CommRing A] (M : Submonoid A)
    {C : Type u} [CommRing C] [Algebra (Localization M) C]
    [Algebra.FiniteType (Localization M) C] :
    ∃ (C₀ : Type u) (_ : CommRing C₀) (a₀ : A →+* C₀) (c₀ : C₀ →+* C),
      a₀.FiniteType ∧
      c₀.comp a₀ = (algebraMap (Localization M) C).comp (algebraMap A (Localization M)) ∧
      @IsLocalization C₀ _ (M.map a₀) C _ c₀.toAlgebra := by
  classical
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra (Localization M) C).FG)
  let _ : Algebra A C :=
    ((algebraMap (Localization M) C).comp (algebraMap A (Localization M))).toAlgebra
  have : IsScalarTower A (Localization M) C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let C₀ : Subalgebra A C := Algebra.adjoin A (s : Set C)
  have hfin : Algebra.FiniteType A C₀ :=
    (Subalgebra.fg_iff_finiteType C₀).mp (Subalgebra.fg_adjoin_finset s)
  refine ⟨C₀, inferInstance, algebraMap A C₀, C₀.val.toRingHom,
    RingHom.finiteType_algebraMap.mpr hfin, ?_, ?_⟩
  · ext x
    rfl
  · have key : ∀ z : C, ∃ (x : C₀) (m : M), z * algebraMap A C (m : A) = (x : C) := by
      intro z
      have hz : z ∈ Algebra.adjoin (Localization M) (s : Set C) := by
        rw [hs]
        trivial
      refine Algebra.adjoin_induction (p := fun z _ => ∃ (x : C₀) (m : M),
        z * algebraMap A C (m : A) = (x : C)) ?_ ?_ ?_ ?_ hz
      · intro z hzs
        exact ⟨⟨z, Algebra.subset_adjoin hzs⟩, 1, by simp⟩
      · intro r
        obtain ⟨⟨a, m⟩, h⟩ := IsLocalization.surj M r
        refine ⟨algebraMap A C₀ a, m, ?_⟩
        have h2 : algebraMap (Localization M) C (r * algebraMap A (Localization M) (m : A)) =
            algebraMap (Localization M) C (algebraMap A (Localization M) a) := by
          rw [h]
        rw [map_mul] at h2
        exact h2
      · rintro z₁ z₂ - - ⟨x₁, m₁, h₁⟩ ⟨x₂, m₂, h₂⟩
        refine ⟨x₁ * algebraMap A C₀ (m₂ : A) + x₂ * algebraMap A C₀ (m₁ : A), m₁ * m₂, ?_⟩
        push_cast
        calc (z₁ + z₂) * (algebraMap A C (m₁ : A) * algebraMap A C (m₂ : A))
            = (z₁ * algebraMap A C (m₁ : A)) * algebraMap A C (m₂ : A) +
              (z₂ * algebraMap A C (m₂ : A)) * algebraMap A C (m₁ : A) := by ring
          _ = _ := by rw [h₁, h₂]
      · rintro z₁ z₂ - - ⟨x₁, m₁, h₁⟩ ⟨x₂, m₂, h₂⟩
        refine ⟨x₁ * x₂, m₁ * m₂, ?_⟩
        push_cast
        calc z₁ * z₂ * (algebraMap A C (m₁ : A) * algebraMap A C (m₂ : A))
            = (z₁ * algebraMap A C (m₁ : A)) * (z₂ * algebraMap A C (m₂ : A)) := by ring
          _ = _ := by rw [h₁, h₂]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, m, hm, rfl⟩
      exact (IsLocalization.map_units (Localization M) ⟨m, hm⟩).map
        (algebraMap (Localization M) C)
    · intro z
      obtain ⟨x, m, h⟩ := key z
      exact ⟨(x, ⟨algebraMap A C₀ (m : A), m, m.2, rfl⟩), h⟩
    · intro x y hxy
      exact ⟨1, by simp [Subtype.ext hxy]⟩


section Fibre

variable {S : Type u} [CommRing S] [IsLocalRing S]
  {A : Type u} [CommRing A] [Algebra S A]
  {A' : Type u} [CommRing A']

/-- **Fibre regularity.**  Let `S` satisfy condition (ii) of p. 161 and `A` be a finite type
`S`-algebra.  Let `A'` be a pushout of `A` and `Ŝ` over `S` (that is, `A' ≅ A ⊗_S Ŝ`), `R = A_M`
and `R'` a localization of `A'`, with `R → R'` compatible with `A → A'`.  If `C` is a finite
type `R`-algebra, every prime of `R' ⊗_R C` lying over a regular prime of `C` is regular.

Deviation from the paper (gap filled): footnote 31 (p. 161): "Reduce the proof to the case in which
S is complete". -/
@[blueprint "lem:class-A-c-fibre-regular"
  (statement := /-- Let $S$ be a noetherian local ring satisfying condition (ii) of the class
    $\mathfrak B$, $A$ a finite type $S$-algebra, $A'=A\otimes_S\hat S$, $M$ and $M'$ submonoids
    of $A$ and $A'$, $R=A_M$, $R'=A'_{M'}$ with $R\to R'$ compatible with $A\to A'$, and $C$ a
    finite type $R$-algebra. Then every prime of $R'\otimes_RC$ lying over a regular prime of $C$
    is regular. -/)
  (proof := /-- By \cref{lem:class-A-c-clear-denominators}, $C$ is the localization of a finite
    type $A$-algebra $C_0$. The square
    $A\to C_0$, $A\to A'$, $C_0\to D=C_0\otimes_S\hat S$, $A'\to D$ is a pushout, and so is
    the composite of the localization square for $C_0\to C$ with the tensor square for $R\to R'$
    and $R\to C$. Cancelling the pushout $A,A',C_0,D$ shows that $R'\otimes_RC$ is the pushout of
    $D$ along $A'\to R'$, that is, the localization of $D$. A prime $Q$ of $R'\otimes_RC$ over a
    regular prime of $C$ contracts to a prime of $C_0$ whose local ring is that of $C$ (a
    localization of $C_0$), hence regular. By condition (ii) for $S$ (applied to $C_0$) the
    contraction of $Q$ to $D$ is regular, and its local ring is that of $Q$ (localization), so $Q$
    is regular. \textbf{Deviation from the paper (gap filled).} Footnote~31 only says ``Reduce the
    proof to the case in which S is complete''. -/)
  (proofUses := ["lem:class-A-c-clear-denominators", "lem:regular-locus-localization"])
  (latexEnv := "lemma")]
theorem mem_regularLocus_tensor_of_hasCompletionRegularLocus (hS : HasCompletionRegularLocus S)
    [Algebra.FiniteType S A] (M : Submonoid A)
    (α : A →+* A') (β : AdicCompletion (maximalIdeal S) S →+* A')
    (hA' : IsRingPushout (algebraMap S A) (algebraMap S (AdicCompletion (maximalIdeal S) S)) α β)
    (M' : Submonoid A') {R' : Type u} [CommRing R'] [Algebra A' R'] [IsLocalization M' R']
    [Algebra (Localization M) R']
    (hRR' : (algebraMap (Localization M) R').comp (algebraMap A (Localization M)) =
      (algebraMap A' R').comp α)
    {C : Type u} [CommRing C] [Algebra (Localization M) C]
    [Algebra.FiniteType (Localization M) C]
    (Q : PrimeSpectrum (R' ⊗[Localization M] C))
    (hQ : PrimeSpectrum.comap (Algebra.TensorProduct.includeRight (R := Localization M)
      (A := R') (B := C)).toRingHom Q ∈ regularLocus C) :
    Q ∈ regularLocus (R' ⊗[Localization M] C) := by
  classical
  obtain ⟨C₀, _, a₀, c₀, ha₀, hc₀a₀, hloc⟩ :=
    exists_finiteType_isLocalization_of_finiteType M (C := C)
  let _ : Algebra S C₀ := (a₀.comp (algebraMap S A)).toAlgebra
  have hfinS : Algebra.FiniteType S C₀ :=
    RingHom.finiteType_algebraMap.mp (RingHom.FiniteType.comp ha₀
      (RingHom.finiteType_algebraMap.mpr inferInstance))
  let _ : Algebra C₀ C := c₀.toAlgebra
  have : IsLocalization (M.map a₀) C := hloc
  -- the squares
  have SQ_D := IsRingPushout.tensorProduct S C₀ (AdicCompletion (maximalIdeal S) S)
  have Q2 := IsRingPushout.tensorProduct (Localization M) R' C
  have Q1 : IsRingPushout a₀ (algebraMap A (Localization M)) (algebraMap C₀ C)
      (algebraMap (Localization M) C) :=
    IsRingPushout.of_isLocalization a₀ (algebraMap (Localization M) C) hc₀a₀.symm M
  -- the map `u : A' → D`
  have hwu : ((Algebra.TensorProduct.includeLeftRingHom :
      C₀ →+* C₀ ⊗[S] AdicCompletion (maximalIdeal S) S).comp a₀).comp (algebraMap S A) =
      (Algebra.TensorProduct.includeRight (R := S) (A := C₀)
        (B := AdicCompletion (maximalIdeal S) S)).toRingHom.comp
        (algebraMap S (AdicCompletion (maximalIdeal S) S)) := SQ_D.comm
  obtain ⟨u, hu1, hu2⟩ := hA'.exists_desc
    ((Algebra.TensorProduct.includeLeftRingHom :
      C₀ →+* C₀ ⊗[S] AdicCompletion (maximalIdeal S) S).comp a₀)
    (Algebra.TensorProduct.includeRight (R := S) (A := C₀)
      (B := AdicCompletion (maximalIdeal S) S)).toRingHom hwu
  have PD : IsRingPushout a₀ α Algebra.TensorProduct.includeLeftRingHom u := by
    refine IsRingPushout.of_left (h₁₁ := algebraMap S A) (v₁₁ := algebraMap S
      (AdicCompletion (maximalIdeal S) S)) (h₂₁ := β) ?_ hA' hu1.symm
    rw [hu2]
    exact SQ_D
  -- the map `e : D → E`
  have hwe : ((Algebra.TensorProduct.includeRight (R := Localization M) (A := R')
        (B := C)).toRingHom.comp c₀).comp (algebraMap S C₀) =
      (((Algebra.TensorProduct.includeLeftRingHom : R' →+* R' ⊗[Localization M] C).comp
        (algebraMap A' R')).comp β).comp (algebraMap S (AdicCompletion (maximalIdeal S) S)) := by
    ext s
    have hx := congr($(hA'.comm) s)
    have h1 := congr($hc₀a₀ (algebraMap S A s))
    have h2 := congr($(Q2.comm) (algebraMap A (Localization M) (algebraMap S A s)))
    have h3 := congr($hRR' (algebraMap S A s))
    simp only [RingHom.comp_apply] at hx h1 h2 h3 ⊢
    rw [← hx, ← h3, h2, ← h1]
    rfl
  obtain ⟨e, he1, he2⟩ := SQ_D.exists_desc _ _ hwe
  -- the pushout square exhibiting `E` as a localization of `D`
  have Q12 := IsRingPushout.paste_horiz Q1.flip Q2
  have hT_s : IsRingPushout ((algebraMap A' R').comp α) a₀
      Algebra.TensorProduct.includeLeftRingHom
      (e.comp Algebra.TensorProduct.includeLeftRingHom) := by
    rw [← hRR', he1]
    exact Q12
  have hp : (Algebra.TensorProduct.includeLeftRingHom : R' →+* R' ⊗[Localization M] C).comp
      (algebraMap A' R') = e.comp u := by
    refine hA'.hom_ext ?_ ?_
    · refine RingHom.ext fun a => ?_
      have h1 := congr($hRR' a)
      have h2 := congr($(Q2.comm) (algebraMap A (Localization M) a))
      have h3 := congr($hc₀a₀ a)
      have h4 := congr($he1 (a₀ a))
      have h5 := congr($hu1 a)
      simp only [RingHom.comp_apply] at h1 h2 h3 h4 h5 ⊢
      rw [h5, h4, h3, ← h2, h1]
    · rw [RingHom.comp_assoc β u e, hu2]
      exact he2.symm
  have T := IsRingPushout.of_left hT_s PD.flip hp
  let _ : Algebra (C₀ ⊗[S] AdicCompletion (maximalIdeal S) S) (R' ⊗[Localization M] C) :=
    e.toAlgebra
  have hlocE : IsLocalization (M'.map u) (R' ⊗[Localization M] C) :=
    IsRingPushout.isLocalization M' u _ e T
  have step1 := mem_regularLocus_iff_comap_of_isLocalization (M'.map u) Q
  have step2 := hS C₀ (PrimeSpectrum.comap
    (algebraMap (C₀ ⊗[S] AdicCompletion (maximalIdeal S) S) (R' ⊗[Localization M] C)) Q)
  have step3 := mem_regularLocus_iff_comap_of_isLocalization (M.map a₀)
    (PrimeSpectrum.comap (Algebra.TensorProduct.includeRight (R := Localization M)
      (A := R') (B := C)).toRingHom Q)
  rw [step1, step2]
  have hcomap : PrimeSpectrum.comap (algebraMap C₀
      (C₀ ⊗[S] AdicCompletion (maximalIdeal S) S)) (PrimeSpectrum.comap
      (algebraMap (C₀ ⊗[S] AdicCompletion (maximalIdeal S) S) (R' ⊗[Localization M] C)) Q) =
      PrimeSpectrum.comap (algebraMap C₀ C) (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight (R := Localization M) (A := R') (B := C)).toRingHom
        Q) := by
    rw [← PrimeSpectrum.comap_comp_apply, ← PrimeSpectrum.comap_comp_apply]
    exact congrArg (fun f => PrimeSpectrum.comap f Q) he1
  rw [hcomap]
  exact step3.mp hQ

end Fibre

end Hironaka

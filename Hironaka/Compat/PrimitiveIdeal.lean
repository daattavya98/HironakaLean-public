/-!
# Ch. 0 §5 (p. 141): ideals not divisible by any invertible ideal ("primitive" ideals)

> … and if we can write `J'ᵢPᵢ = h⁻¹(Jᵢ)` for each `i` where `Pᵢ` is an invertible sheaf of ideals on `X'` and `J'ᵢ` is a
> sheaf of ideals `≠ (0)` on `X'` which is not divisible by any invertible sheaf of ideals (except `O_{X'}`), …
> (p. 141, from the fact (*), quoted in full in `Hironaka/Ch0/FactStar.lean`)

This file defines "not divisible by any invertible sheaf of ideals (except `O_{X'}`)" (`Subscheme.IsPrimitive`) and proves
the decomposition "we can write `J'ᵢPᵢ = h⁻¹(Jᵢ)`" which the paper takes for granted whenever it applies (*): every sheaf
of non-zero ideals on a non-singular scheme is an invertible sheaf of ideals times a sheaf of ideals which is not
divisible (`Subscheme.exists_isInvertibleIdeal_mul_isPrimitive`).  The proof glues the greatest common divisors of the
local rings, which are unique factorization domains (`IsRegularLocalRing.uniqueFactorizationMonoid`, the cited fact of
footnote 3):

* `Subscheme.gcdStalk K y` is the intersection of the principal ideals of `O_{X,y}` containing `K_y`;
* `Subscheme.isLocallyGenerated_gcdStalk`: near each point, `gcdStalk K y` is generated by one section (the
  non-divisible part of a family of generators is a non-divisible family at the nearby points, by the openness of
  `HeightGood`, `Hironaka/Compat/PrimitiveGcd.lean`);
* hence a sheaf of ideals `G`, invertible, with `G_y = gcdStalk K y`; `K₀ = (K : G)`, and `K = G K₀`.

It also proves the stalkwise form of primitivity (`Subscheme.IsPrimitive.stalk`), used for the weak transform
(`Hironaka/Compat/PrimitiveWeakTransform.lean`).

Deviation from the paper (gap filled): the decomposition is used tacitly (p. 141); this module proves it.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u

namespace Hironaka

variable {X : Scheme.{u}}


/-! ### The stalks: the divisor of a stalk ideal -/

/-- The intersection of the principal ideals of the local ring at `y` containing the stalk `K_y` (in the unique
factorization domain `O_{X,y}` it is generated by the greatest common divisor of the generators of `K_y`). -/
noncomputable def Subscheme.gcdStalk (K : Subscheme X) (y : X) : Ideal (X.presheaf.stalk y) :=
  gcdIdeal (K.stalkIdeal y)

theorem Subscheme.le_gcdStalk (K : Subscheme X) (y : X) : K.stalkIdeal y ≤ K.gcdStalk y :=
  le_gcdIdeal _

/-- The stalks of a non-singular scheme are unique factorization domains. -/
theorem stalk_ufd [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] (hX : X.IsNonsingular) (y : X) :
    IsDomain (X.presheaf.stalk y) ∧ UniqueFactorizationMonoid (X.presheaf.stalk y) := by
  have : IsRegularLocalRing (X.presheaf.stalk y) := hX y
  have := isDomain_of_isRegularLocalRing (X.presheaf.stalk y)
  exact ⟨this, IsRegularLocalRing.uniqueFactorizationMonoid _⟩

/-! ### The divisor is locally generated by one section -/

section Spreading

variable [IsLocallyNoetherian X]

/-- **Near each point the divisor `gcdStalk K y` is generated by one section.**  At `x`, `K_x = g · (wᵢ)` with the `wᵢ`
without common non-unit divisor (unique factorization).  The factorization spreads to an affine neighbourhood
(`exists_spread`): sections `a`, `cᵢ` with `s² kᵢ = a cᵢ` after inverting `s u`; the `cᵢ` stay without common divisor at
the points `y` of a smaller neighbourhood (`exists_forall_heightGood`), so there `gcdStalk K y = (a)`
(`gcdIdeal_eq_span_of_coprime`). -/
theorem Subscheme.isLocallyGenerated_gcdStalk [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] (hX : X.IsNonsingular) (K : Subscheme X)
    (hK : ∀ x, K.stalkIdeal x ≠ ⊥) : IsLocallyGenerated fun y : X => K.gcdStalk y := by
  intro x
  obtain ⟨W₀, hxW₀⟩ := Subscheme.exists_affineOpen_mem x
  have hAn : IsNoetherianRing Γ(X, W₀) := IsLocallyNoetherian.component_noetherian W₀
  -- generators of the ideal of sections
  obtain ⟨s₀, hs₀⟩ := (IsNoetherian.noetherian (K.ideal W₀) : (K.ideal W₀).FG)
  -- the stalks at the points of `W₀` are generated by the germs of these generators
  have hstalk : ∀ (y : X) (hy : y ∈ (W₀ : X.Opens)), K.stalkIdeal y =
      Ideal.span (Set.range fun i : s₀ => (X.presheaf.germ W₀ y hy).hom (i : Γ(X, W₀))) := by
    intro y hy
    rw [Subscheme.stalkIdeal_eq_map_germ_affine K W₀ hy, ← hs₀, Ideal.map_span]
    congr 1
    ext z
    simp
  -- the local ring at `x` and its prime in `A = Γ(X, W₀)`
  let _ : Algebra Γ(X, W₀) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW₀⟩ : (W₀ : X.Opens))
  have hlocx := W₀.2.isLocalization_stalk ⟨x, hxW₀⟩
  set p := (W₀.2.primeIdealOf ⟨x, hxW₀⟩).asIdeal with hp
  obtain ⟨hdomx, hufdx⟩ := stalk_ufd hX x
  have hregx : IsRegularLocalRing (X.presheaf.stalk x) := hX x
  have hnoethx : IsNoetherianRing (X.presheaf.stalk x) := inferInstance
  let k : s₀ → Γ(X, W₀) := fun i => i
  -- `K_x ≠ 0`, so some generator is non-zero
  have hnz : ∃ i : s₀, algebraMap Γ(X, W₀) (X.presheaf.stalk x) (k i) ≠ 0 := by
    by_contra hcon
    push Not at hcon
    apply hK x
    rw [hstalk x hxW₀, Ideal.span_eq_bot]
    rintro _ ⟨i, rfl⟩
    exact hcon i
  obtain ⟨g, w, hg0, hpw, hcop⟩ := exists_mul_coprime_of_ufd
    (fun i : s₀ => algebraMap Γ(X, W₀) (X.presheaf.stalk x) (k i)) hnz
  obtain ⟨a, c, s, u, hsp, hup, has, hcs, hrel⟩ := exists_spread p k g w hpw
  -- the `cᵢ` have no common divisor at `x`
  have hgoodx : HeightGood c p := by
    refine (heightGood_iff_coprime (B := X.presheaf.stalk x) p c).mpr fun π hπ => hcop π fun i => ?_
    have hsu : IsUnit (algebraMap Γ(X, W₀) (X.presheaf.stalk x) s) :=
      IsLocalization.map_units (X.presheaf.stalk x) (⟨s, hsp⟩ : p.primeCompl)
    have := hπ i
    rw [hcs i] at this
    exact hsu.dvd_mul_left.mp this
  obtain ⟨f, hfp, hf⟩ := exists_forall_heightGood c hgoodx
  -- the neighbourhood
  set t : Γ(X, W₀) := s * u * f with ht
  have htp : t ∉ p := fun h =>
    (Ideal.IsPrime.mem_or_mem inferInstance h).elim
      (fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hsp hup) hfp
  have hxW : x ∈ (X.affineBasicOpen t : X.Opens) := by
    show x ∈ X.basicOpen t
    by_contra h
    exact htp ((Scheme.mem_primeIdealOf_iff_notMem_basicOpen W₀.2 hxW₀ t).mpr h)
  refine ⟨(X.affineBasicOpen t : X.Opens), (X.affineBasicOpen t).2, hxW, PUnit, inferInstance,
    fun _ => X.presheaf.map (homOfLE (X.affineBasicOpen_le t : (X.affineBasicOpen t : X.Opens) ≤ W₀)).op a,
    fun y hy => ?_⟩
  have hyW₀ : y ∈ (W₀ : X.Opens) := X.affineBasicOpen_le t hy
  have hytq : t ∉ (W₀.2.primeIdealOf ⟨y, hyW₀⟩).asIdeal := by
    rw [Scheme.mem_primeIdealOf_iff_notMem_basicOpen W₀.2 hyW₀ t, not_not]
    exact hy
  let _ : Algebra Γ(X, W₀) (X.presheaf.stalk y) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨y, hyW₀⟩ : (W₀ : X.Opens))
  have hlocy := W₀.2.isLocalization_stalk ⟨y, hyW₀⟩
  set q := (W₀.2.primeIdealOf ⟨y, hyW₀⟩).asIdeal with hq
  obtain ⟨hdomy, hufdy⟩ := stalk_ufd hX y
  have hregy : IsRegularLocalRing (X.presheaf.stalk y) := hX y
  have hnoethy : IsNoetherianRing (X.presheaf.stalk y) := inferInstance
  have hsq : s ∉ q := fun h => hytq (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ h))
  have huq : u ∉ q := fun h => hytq (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ h))
  have hfq : f ∉ q := fun h => hytq (Ideal.mul_mem_left _ _ h)
  have hsu : IsUnit (algebraMap Γ(X, W₀) (X.presheaf.stalk y) s) :=
    IsLocalization.map_units (X.presheaf.stalk y) (⟨s, hsq⟩ : q.primeCompl)
  have huu : IsUnit (algebraMap Γ(X, W₀) (X.presheaf.stalk y) u) :=
    IsLocalization.map_units (X.presheaf.stalk y) (⟨u, huq⟩ : q.primeCompl)
  have hcopy := (heightGood_iff_coprime (B := X.presheaf.stalk y) q c).mp (hf q hfq)
  -- the relation `s² kᵢ = a cᵢ` at `y`
  have hrel' : ∀ i : s₀, algebraMap Γ(X, W₀) (X.presheaf.stalk y) s ^ 2 *
      algebraMap Γ(X, W₀) (X.presheaf.stalk y) (k i) =
      algebraMap Γ(X, W₀) (X.presheaf.stalk y) a * algebraMap Γ(X, W₀) (X.presheaf.stalk y) (c i) := by
    intro i
    have := congrArg (algebraMap Γ(X, W₀) (X.presheaf.stalk y)) (hrel i)
    simp only [map_mul, map_pow] at this
    exact (huu.mul_right_inj).mp this
  have hKy : K.stalkIdeal y = Ideal.span (Set.range fun i : s₀ =>
      algebraMap Γ(X, W₀) (X.presheaf.stalk y) a * algebraMap Γ(X, W₀) (X.presheaf.stalk y) (c i)) := by
    rw [hstalk y hyW₀]
    obtain ⟨σ, hσ⟩ := hsu.pow 2
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro _ ⟨i, rfl⟩
      show (X.presheaf.germ W₀ y hyW₀).hom (i : Γ(X, W₀)) ∈ _
      have : (X.presheaf.germ W₀ y hyW₀).hom (i : Γ(X, W₀)) =
          ((σ⁻¹ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y) *
            (algebraMap Γ(X, W₀) (X.presheaf.stalk y) a *
              algebraMap Γ(X, W₀) (X.presheaf.stalk y) (c i)) := by
        rw [← hrel' i, ← hσ, ← mul_assoc, Units.inv_mul, one_mul]
        rfl
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · rintro _ ⟨i, rfl⟩
      show algebraMap Γ(X, W₀) (X.presheaf.stalk y) a * algebraMap Γ(X, W₀) (X.presheaf.stalk y) (c i) ∈ _
      rw [← hrel' i]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  show gcdIdeal (K.stalkIdeal y) = _
  rw [hKy, gcdIdeal_eq_span_of_coprime _ _ hcopy]
  rw [Set.range_const]
  congr 1
  simp only [Set.singleton_eq_singleton_iff]
  exact (X.presheaf.germ_res_apply (homOfLE (X.affineBasicOpen_le t :
    (X.affineBasicOpen t : X.Opens) ≤ W₀)) y hy a).symm

end Spreading

/-! ### Gluing the divisors: the invertible sheaf of ideals `G` -/

section Glue

variable [IsLocallyNoetherian X]

/-- At each point the divisor of the stalk of a sheaf of non-zero ideals is principal. -/
theorem Subscheme.exists_gcdStalk_eq_span [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] (hX : X.IsNonsingular) (K : Subscheme X)
    (hK : ∀ x, K.stalkIdeal x ≠ ⊥) (y : X) :
    ∃ g : X.presheaf.stalk y, g ≠ 0 ∧ K.gcdStalk y = Ideal.span {g} ∧ K.stalkIdeal y ≤ Ideal.span {g} := by
  obtain ⟨hdom, hufd⟩ := stalk_ufd hX y
  have hreg : IsRegularLocalRing (X.presheaf.stalk y) := hX y
  have hnoeth : IsNoetherianRing (X.presheaf.stalk y) := inferInstance
  exact exists_gcdIdeal_eq_span (K.stalkIdeal y) (hK y)

/-- **The divisors glue**: there is an invertible sheaf of ideals `G` whose stalks are the divisors `gcdStalk K y`. -/
theorem Subscheme.exists_isInvertibleIdeal_stalkIdeal_eq_gcdStalk [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] (hX : X.IsNonsingular) (K : Subscheme X)
    (hK : ∀ x, K.stalkIdeal x ≠ ⊥) :
    ∃ G : Subscheme X, G.IsInvertibleIdeal ∧ ∀ y, G.stalkIdeal y = K.gcdStalk y := by
  have hloc := Subscheme.isLocallyGenerated_gcdStalk hX K hK
  refine ⟨subschemeOfLocallyGenerated hloc, ?_, fun y => stalkIdeal_subschemeOfLocallyGenerated hloc y⟩
  rw [isInvertibleIdeal_iff_forall_exists_stalkIdeal_eq_span]
  intro y
  obtain ⟨g, hg0, hgcd, -⟩ := Subscheme.exists_gcdStalk_eq_span hX K hK y
  obtain ⟨hdom, -⟩ := stalk_ufd hX y
  exact ⟨g, mem_nonZeroDivisors_of_ne_zero hg0, by rw [stalkIdeal_subschemeOfLocallyGenerated hloc y, hgcd]⟩

/-- **Primitivity is stalkwise**: if `K` is not divisible by any invertible sheaf of ideals, then no stalk `K_y` lies in
a proper principal ideal of `O_{X,y}`.  (The sheaf `G` of divisors contains `K`, so it is trivial.) -/
theorem Subscheme.IsPrimitive.stalk [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] (hX : X.IsNonsingular) {K : Subscheme X} (hK : ∀ x, K.stalkIdeal x ≠ ⊥)
    (hprim : K.IsPrimitive) (y : X) (π : X.presheaf.stalk y) (hπ : K.stalkIdeal y ≤ Ideal.span {π}) :
    IsUnit π := by
  obtain ⟨G, hG, hGy⟩ := Subscheme.exists_isInvertibleIdeal_stalkIdeal_eq_gcdStalk hX K hK
  have h1 := hprim G hG (fun z => (hGy z).symm ▸ Subscheme.le_gcdStalk K z) y
  have h2 : G.stalkIdeal y ≤ Ideal.span {π} := by
    rw [hGy y]
    exact gcdIdeal_le_of_le_span hπ
  rw [h1, top_le_iff, Ideal.span_singleton_eq_top] at h2
  exact h2

end Glue

/-- **The decomposition `J = P · J'` with `P` invertible and `J'` not divisible by any invertible sheaf of ideals.**

Deviation from the paper (gap filled): used tacitly by the paper; proved here.  The paper applies (*) to `h⁻¹(Jᵢ) = J'ᵢPᵢ`
(p. 141: "if we can write `J'ᵢPᵢ = h⁻¹(Jᵢ)` for each `i` where `Pᵢ` is an invertible sheaf of ideals on `X'` and `J'ᵢ` is a
sheaf of ideals `≠ (0)` on `X'` which is not divisible by any invertible sheaf of ideals (except `O_{X'}`)") and, in using
it for Question (E), takes for granted that such a decomposition exists.  It is true: the local rings of a non-singular
scheme are unique factorization domains (footnote 3), the greatest common divisor of the generators of a non-zero ideal is
unique up to a unit, so these local divisors glue to an invertible sheaf of ideals `G` (`isLocallyGenerated_gcdStalk`), and
`K₀ = (K : G)`. -/
@[blueprint "lem:0.5-primitive-decomposition"
  (statement := /-- Let $X$ be a non-singular algebraic scheme and $K$ a coherent sheaf of ideals on $X$ with
    $K_x\ne(0)$ for all $x$. Then $K=G\cdot K_0$ with $G$ an invertible sheaf of ideals and $K_0$ a sheaf of non-zero
    ideals not divisible by any invertible sheaf of ideals (except $\mathcal O_X$). This decomposition is taken for
    granted in the application of (*) (p.~141). \textbf{Deviation from the paper (gap filled).} Used tacitly by the paper;
    proved here. -/)
  (proof := /-- The local rings are unique factorization domains (footnote~3). The intersection $G_y$ of the principal
    ideals containing $K_y$ is generated by the greatest common divisor of the generators of $K_y$. Near a point $x$, write
    $K_x=g\cdot(w_i)$ with the $w_i$ coprime and spread this to sections $K=a\cdot(c_i)$ over an affine neighbourhood; the
    coprimality of the $c_i$ is an open condition (the primes of height at most one containing $(c_i)$ contain one of
    finitely many minimal primes), so $G_y=(a)$ near $x$: the family $G_y$ is locally generated by one section, hence the
    stalks of an invertible sheaf of ideals $G$. Put $K_0=(K:G)$; then $K=GK_0$, and an invertible $Q\supseteq K_0$ would give
    $G\subseteq Q\cdot G$ so $Q=\mathcal O$. -/)
  (latexEnv := "lemma")]
theorem Subscheme.exists_isInvertibleIdeal_mul_isPrimitive [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] [IsAlgebraicScheme X] (hX : X.IsNonsingular)
    (K : Subscheme X) (hK : ∀ x, K.stalkIdeal x ≠ ⊥) :
    ∃ G K₀ : Subscheme X, G.IsInvertibleIdeal ∧ Subscheme.IsPrimitive K₀ ∧ (∀ x, K₀.stalkIdeal x ≠ ⊥) ∧
      K = G * K₀ := by
  have := IsAlgebraicScheme.isNoetherian X
  obtain ⟨G, hG, hGy⟩ := Subscheme.exists_isInvertibleIdeal_stalkIdeal_eq_gcdStalk hX K hK
  let K₀ : Subscheme X := colonOfFG K G (fun U => hG.ideal_fg U)
  have hK₀ : ∀ y, K₀.stalkIdeal y =
      (K.stalkIdeal y).colon (G.stalkIdeal y : Set (X.presheaf.stalk y)) := fun y =>
    stalkIdeal_colonOfFG K G (fun U => hG.ideal_fg U) y
  have hg : ∀ y, ∃ g : X.presheaf.stalk y, g ≠ 0 ∧ G.stalkIdeal y = Ideal.span {g} ∧
      K.stalkIdeal y ≤ Ideal.span {g} := fun y => by
    obtain ⟨g, hg0, hgcd, hle⟩ := Subscheme.exists_gcdStalk_eq_span hX K hK y
    exact ⟨g, hg0, (hGy y).trans hgcd, hle⟩
  have hmul : ∀ y, G.stalkIdeal y * K₀.stalkIdeal y = K.stalkIdeal y := by
    intro y
    obtain ⟨g, hg0, hGg, hKg⟩ := hg y
    rw [hK₀ y]
    refine le_antisymm ?_ ?_
    · rw [Ideal.mul_le]
      intro a ha b hb
      have := Submodule.mem_colon.mp hb a ha
      rwa [smul_eq_mul, mul_comm] at this
    · intro k hk
      obtain ⟨m, hm⟩ := Ideal.mem_span_singleton'.mp (hKg hk)
      have hmc : m ∈ (K.stalkIdeal y).colon (G.stalkIdeal y : Set (X.presheaf.stalk y)) := by
        refine Submodule.mem_colon.mpr fun r hr => ?_
        rw [hGg] at hr
        obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hr
        rw [smul_eq_mul, ← hz]
        have : m * (z * g) = z * k := by rw [← hm]; ring
        rw [this]
        exact Ideal.mul_mem_left _ _ hk
      rw [← hm, mul_comm m g]
      exact Ideal.mul_mem_mul (hGg ▸ Ideal.mem_span_singleton_self g) hmc
  have hK₀nz : ∀ y, K₀.stalkIdeal y ≠ ⊥ := by
    intro y h0
    apply hK y
    rw [← hmul y, h0, Ideal.mul_bot]
  refine ⟨G, K₀, hG, ?_, hK₀nz, Subscheme.ext_stalkIdeal fun y => by
    rw [Subscheme.stalkIdeal_mul_eq]
    exact (hmul y).symm⟩
  intro Q hQ hle y
  obtain ⟨q, hqQ, hqnzd⟩ := hQ.exists_stalkIdeal_eq_span y
  obtain ⟨g, hg0, hGg, hKg⟩ := hg y
  obtain ⟨hdom, -⟩ := stalk_ufd hX y
  have h1 : K.stalkIdeal y ≤ Ideal.span {g * q} := by
    rw [← hmul y, hGg]
    calc Ideal.span {g} * K₀.stalkIdeal y ≤ Ideal.span {g} * Ideal.span {q} :=
          Ideal.mul_mono_right (hqQ ▸ hle y)
      _ = Ideal.span {g * q} := Ideal.span_singleton_mul_span_singleton g q
  have h2 : Ideal.span {g} ≤ Ideal.span {g * q} := by
    rw [← hGg, hGy y]
    exact gcdIdeal_le_of_le_span h1
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (h2 (Ideal.mem_span_singleton_self g))
  have hqc : q * c = 1 := by
    apply mul_left_cancel₀ hg0
    linear_combination hc
  rw [hqQ]
  exact Ideal.span_singleton_eq_top.mpr (IsUnit.of_mul_eq_one c hqc)

end Hironaka

module

public import Hironaka.Compat.BlowupCompositionChartGeneration

/-!
# Ch. 0 §3 (p. 133): existence of the sheaf of ideals `J(m)`

p. 133: "Then we can see that for a sufficiently large integer m there exists a coherent sheaf of
ideals J(m) on X0 such that f0^-1(J(m)) = f0^-1(J0)^m J1."

Hironaka gives neither a proof nor a citation.  We take `J(m) := (f₀⁻¹(J₀)ᵐ J₁).map f₀`, the
largest sheaf of ideals whose total transform is contained in `f₀⁻¹(J₀)ᵐ J₁`, and prove the
reverse inclusion for `m ≫ 0` on a finite affine cover `U` of `X₀` and finite chart covers
`V_{a₁}, …, V_{aₙ}` of `f₀⁻¹(U)`: the generators `x/a_iᵏ` of `J₁(V_i)` give the sections
`a_i^(m-k) x` of `J(m)(U)` (pair lemma, `eventually_appLE_pow_mul_mem`).  The finitely many
thresholds are combined with `Filter.eventually_all`.  No ampleness and no cohomology is used.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Filter
open scoped nonZeroDivisors

namespace Hironaka

universe u

/-- A sheaf of ideals `I` is contained in `J` if every point has an affine neighbourhood `V` with
`I(V) ≤ J(V)`. -/
theorem Subscheme.le_of_forall_exists_ideal_le {X : Scheme.{u}} {I J : Subscheme X}
    (h : ∀ y : X, ∃ V : X.affineOpens, y ∈ (V : X.Opens) ∧ I.ideal V ≤ J.ideal V) : I ≤ J := by
  refine Scheme.IdealSheafData.le_of_iSup_eq_top
    (fun V : {V : X.affineOpens // I.ideal V ≤ J.ideal V} => V.1) ?_ (fun V => V.2)
  refine eq_top_iff.mpr fun y _ => ?_
  obtain ⟨V, hyV, hV⟩ := h y
  exact Opens.mem_iSup.mpr ⟨⟨V, hV⟩, hyV⟩

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X} (t : MonoidalTransformation X B) (D₁ : Subscheme t.X')
  (U : X.affineOpens)

/-- One generator `g` of `D₁` on a chart `V_a`, given a finite family of charts `V_{a'}`
covering `f⁻¹(U)`: for all large `m`, `aᵐ g` is the image of a section of
`J(m) = (f⁻¹(B)ᵐ D₁).map f` over `U`. -/
theorem eventually_pow_mul_mem_map_appLE [QuasiCompact t.f]
    (S : Finset {a : Γ(X, U) // a ∈ B.ideal U})
    (hS : ∀ y ∈ t.f ⁻¹ᵁ (U : X.Opens), ∃ a ∈ S, y ∈ t.chartV U a.2)
    {a : Γ(X, U)} (ha : a ∈ B.ideal U) {g : Γ(t.X', (t.chartAff U ha : t.X'.Opens))}
    (hg : g ∈ D₁.ideal (t.chartAff U ha)) :
    ∀ᶠ m in atTop, t.f.appLE U _ (t.chartAff_le U ha) a ^ m * g ∈
      (((t.exceptional ^ m * D₁).map t.f).ideal U).map
        (t.f.appLE U _ (t.chartAff_le U ha)).hom := by
  obtain ⟨k, x, hx, hgx⟩ := t.exists_pow_mul_eq_appLE U ha g
  have hall : ∀ᶠ n in atTop, ∀ a' : S,
      t.f.appLE U _ (t.chartAff_le U a'.1.2) (a ^ n * x) ∈
        (t.exceptional ^ (n + k) * D₁).ideal (t.chartAff U a'.1.2) :=
    eventually_all.mpr fun a' => t.eventually_appLE_pow_mul_mem U D₁ ha a'.1.2 hx hg hgx
  obtain ⟨N, hN⟩ := eventually_atTop.mp hall
  refine eventually_atTop.mpr ⟨N + k, fun m hm => ?_⟩
  have hmk : m - k + k = m := Nat.sub_add_cancel (by omega)
  have hs : a ^ (m - k) * x ∈ ((t.exceptional ^ m * D₁).map t.f).ideal U := by
    refine mem_ideal_map_of_forall_appLE_mem t.f _ U (fun a' : S => t.chartAff U a'.1.2)
      (fun a' => t.chartAff_le U a'.1.2) (fun y hy => ?_) (fun a' => ?_)
    · obtain ⟨a', ha'S, hy'⟩ := hS y hy
      exact ⟨⟨a', ha'S⟩, hy'⟩
    · have := hN (m - k) (by omega) a'
      rwa [hmk] at this
  have key : t.f.appLE U _ (t.chartAff_le U ha) a ^ m * g =
      t.f.appLE U _ (t.chartAff_le U ha) (a ^ (m - k) * x) := by
    rw [map_mul, map_pow, ← hgx, ← mul_assoc, ← pow_add, hmk]
  rw [key]
  exact Ideal.mem_map_of_mem _ hs

/-- On one chart `V_a` of a finite chart cover of `f⁻¹(U)`: for all large `m`, the ideal of
`f⁻¹(B)ᵐ D₁` on `V_a` is generated by images of sections of `J(m)` over `U`. -/
theorem eventually_ideal_le_map_appLE [QuasiCompact t.f] [IsLocallyNoetherian t.X']
    (S : Finset {a : Γ(X, U) // a ∈ B.ideal U})
    (hS : ∀ y ∈ t.f ⁻¹ᵁ (U : X.Opens), ∃ a ∈ S, y ∈ t.chartV U a.2)
    {a : Γ(X, U)} (ha : a ∈ B.ideal U) :
    ∀ᶠ m in atTop, (t.exceptional ^ m * D₁).ideal (t.chartAff U ha) ≤
      (((t.exceptional ^ m * D₁).map t.f).ideal U).map
        (t.f.appLE U _ (t.chartAff_le U ha)).hom := by
  have := IsLocallyNoetherian.component_noetherian (t.chartAff U ha)
  obtain ⟨G, hG⟩ : (D₁.ideal (t.chartAff U ha)).FG := IsNoetherian.noetherian _
  have hall : ∀ᶠ m in atTop, ∀ g ∈ G, t.f.appLE U _ (t.chartAff_le U ha) a ^ m * g ∈
      (((t.exceptional ^ m * D₁).map t.f).ideal U).map
        (t.f.appLE U _ (t.chartAff_le U ha)).hom :=
    (eventually_all_finset G).mpr fun g hg =>
      t.eventually_pow_mul_mem_map_appLE D₁ U S hS ha (hG ▸ Ideal.subset_span hg)
  filter_upwards [hall] with m hm
  obtain ⟨_, hE, -⟩ := t.isChartDomain_chartAff U ha
  change t.exceptional.ideal (t.chartAff U ha) ^ m * D₁.ideal (t.chartAff U ha) ≤ _
  rw [hE, ← hG, Ideal.span_singleton_pow, Ideal.span_mul_span, Ideal.span_le]
  intro z hz
  obtain ⟨_, rfl, g, hg, rfl⟩ := Set.mem_mul.mp hz
  exact hm g hg

/-- (P3d, local form) Over an affine open `U` of `X`: for all large `m`, every point of
`f⁻¹(U)` has an affine neighbourhood on which `f⁻¹(B)ᵐ D₁ ≤ f⁻¹(J(m))`. -/
theorem eventually_forall_exists_ideal_le [QuasiCompact t.f] [IsLocallyNoetherian t.X'] :
    ∀ᶠ m in atTop, ∀ y ∈ t.f ⁻¹ᵁ (U : X.Opens), ∃ V : t.X'.affineOpens, y ∈ (V : t.X'.Opens) ∧
      (t.exceptional ^ m * D₁).ideal V ≤
        (Subscheme.totalTransform t.f ((t.exceptional ^ m * D₁).map t.f)).ideal V := by
  -- a finite chart cover of `f⁻¹(U)`
  have hcomp : IsCompact (t.f ⁻¹' (U : Set X)) :=
    QuasiCompact.isCompact_preimage _ U.1.isOpen U.2.isCompact
  obtain ⟨S, hS⟩ := hcomp.elim_finite_subcover
    (fun a : {a : Γ(X, U) // a ∈ B.ideal U} => (t.chartV U a.2 : Set t.X'))
    (fun a => (t.chartV U a.2).isOpen) (fun y hy => by
      obtain ⟨a, ha, hya⟩ := t.exists_mem_chartOpen U hy
      rw [← t.chartV_eq_chartOpen U ha] at hya
      exact Set.mem_iUnion.mpr ⟨⟨a, ha⟩, hya⟩)
  have hS' : ∀ y ∈ t.f ⁻¹ᵁ (U : X.Opens), ∃ a ∈ S, y ∈ t.chartV U a.2 := fun y hy => by
    obtain ⟨a, haS, hya⟩ := Set.mem_iUnion₂.mp (hS hy)
    exact ⟨a, haS, hya⟩
  have hall : ∀ᶠ m in atTop, ∀ a : S,
      (t.exceptional ^ m * D₁).ideal (t.chartAff U a.1.2) ≤
        (((t.exceptional ^ m * D₁).map t.f).ideal U).map
          (t.f.appLE U _ (t.chartAff_le U a.1.2)).hom :=
    eventually_all.mpr fun a => t.eventually_ideal_le_map_appLE D₁ U S hS' a.1.2
  filter_upwards [hall] with m hm
  intro y hy
  obtain ⟨a, haS, hya⟩ := hS' y hy
  refine ⟨t.chartAff U a.2, hya, ?_⟩
  change _ ≤ (((t.exceptional ^ m * D₁).map t.f).comap t.f).ideal (t.chartAff U a.2)
  rw [ideal_comap_eq_map_appLE t.f _ U _ (t.chartAff_le U a.2)]
  exact hm ⟨a, haS⟩

/-- (P3d) For all large `m`, the total transform of `J(m) := (f⁻¹(B)ᵐ D₁).map f` is
`f⁻¹(B)ᵐ D₁`. -/
theorem eventually_totalTransform_map_eq [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [IsNoetherian X] :
    ∀ᶠ m in atTop, Subscheme.totalTransform t.f ((t.exceptional ^ m * D₁).map t.f) =
      t.exceptional ^ m * D₁ := by
  have := t.isProper
  have : IsLocallyNoetherian t.X' := LocallyOfFiniteType.isLocallyNoetherian t.f
  -- a finite affine cover of `X`
  choose W hW using fun x : X => Subscheme.exists_affineOpen_mem x
  obtain ⟨F, hF⟩ := isCompact_univ.elim_finite_subcover (fun x : X => ((W x : X.Opens) : Set X))
    (fun x => (W x : X.Opens).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hW x⟩)
  have hall := (eventually_all_finset F).mpr fun x _ =>
    t.eventually_forall_exists_ideal_le D₁ (W x)
  filter_upwards [hall] with m hm
  refine le_antisymm (Scheme.IdealSheafData.comap_map_le _ _)
    (Subscheme.le_of_forall_exists_ideal_le fun y => ?_)
  obtain ⟨x, hxF, hyx⟩ := Set.mem_iUnion₂.mp (hF (Set.mem_univ (t.f y)))
  exact hm x hxF y hyx

/-- The sheaf of ideals `J(m) := (f₀⁻¹(J₀)ᵐ J₁).map f₀` satisfies
`f₀⁻¹(J(m)) = f₀⁻¹(J₀)ᵐ J₁` for all large `m` (p. 133).  This names the `J(m)` of
`exists_totalTransform_eq_exceptional_pow_mul`. -/
theorem exists_totalTransform_map_eq [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [IsNoetherian X] :
    ∃ m₀ : ℕ, ∀ m ≥ m₀, Subscheme.totalTransform t.f ((t.exceptional ^ m * D₁).map t.f) =
      t.exceptional ^ m * D₁ :=
  eventually_atTop.mp (t.eventually_totalTransform_map_eq D₁)

variable {D₀ : Subscheme X}

/-- p. 133: "Then we can see that for a sufficiently large integer m there exists a coherent
sheaf of ideals J(m) on X0 such that f0^-1(J(m)) = f0^-1(J0)^m J1."

Here `t₀ : X₁ → X₀` is the monoidal transformation with center `D₀` (ideal `J₀`), `D₁` is a
subscheme of `X₁` (ideal `J₁`), and `t₀.exceptional = f₀⁻¹(J₀)`.  "Coherent" is automatic: on
a locally noetherian scheme every (quasi-coherent) sheaf of ideals is coherent.  Asserted
without proof or citation in the paper (gap filled); `J(m) = (f₀⁻¹(J₀)ᵐ J₁).map f₀`
(`exists_totalTransform_map_eq`). -/
@[blueprint "lem:0.2-composition-ideal"
  (statement := /-- Let $X_0$ be a noetherian scheme, $f_0\colon X_1\to X_0$ the monoidal
    transformation with center $D_0$ (sheaf of ideals $J_0$), and $D_1$ a subscheme of $X_1$
    with sheaf of ideals $J_1$. Then for every sufficiently large integer $m$ there exists a
    (coherent) sheaf of ideals $J(m)$ on $X_0$ such that
    $f_0^{-1}(J(m))=f_0^{-1}(J_0)^m J_1$. (p.~133.) -/)
  (proof := /-- Put $E=f_0^{-1}(J_0)$ and $J(m)=f_{0*}$-image of $E^mJ_1$, the largest sheaf of
    ideals $K$ on $X_0$ with $f_0^{-1}(K)\subseteq E^mJ_1$; so only $E^mJ_1\subseteq
    f_0^{-1}(J(m))$ is to be shown, and it is local. Cover $X_0$ by finitely many affine
    opens $U=\operatorname{Spec}A$, $I=J_0(U)$, and $f_0^{-1}(U)$ by finitely many charts
    $V_i=\operatorname{Spec}A[I/a_i]$, $a_i\in I$ ($f_0$ is quasi-compact, being proper,
    \cref{lem:monoidal-transformation-proper}; the charts cover by
    \cref{compat:blowup-charts-cover}). On $V_i$, $E$ is generated by the non-zero-divisor
    $a_i$, and $J_1(V_i)$ is generated by finitely many fractions $x/a_i^k$, $x\in I^k$. For
    $m\ge k$ the element $s=a_i^{m-k}x\in A$ maps to $a_i^m\cdot x/a_i^k$ on $V_i$. On another
    chart $V_j$ write $b=a_i/a_j$ and $\sigma_0=x/a_j^k$: on $D_{V_j}(b)\subseteq V_i$ one has
    $a_j^k\sigma_0=x=a_i^k\cdot x/a_i^k$ and $a_i=a_jb$, so cancelling the non-zero-divisor
    $a_j^k$ gives $\sigma_0\in J_1(V_j)_b$, i.e.\ $b^N\sigma_0\in J_1(V_j)$ for some $N$; then
    $s=a_j^m\cdot b^{m-k}\sigma_0\in E^mJ_1(V_j)$ for $m\ge k+N$. A section of $X_0$ over $U$
    whose images on the $V_j$ lie in $E^mJ_1$ lies in $J(m)(U)$. Taking $m$ larger than the
    finitely many thresholds, the images of the $s$ generate $E^mJ_1$ on every $V_i$.
    \textbf{Gap in the paper filled.} The paper asserts this (``we can see'') without proof
    or citation. The usual argument via relative ampleness of $E$ (Serre) is replaced by the
    explicit fractions $x/a^k$ of the chart rings; no cohomology is used. -/)
  (proofUses := ["lem:monoidal-transformation-proper", "compat:blowup-charts-cover"])
  (latexEnv := "lemma")]
theorem exists_totalTransform_eq_exceptional_pow_mul [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [IsNoetherian X]
    (t₀ : MonoidalTransformation X D₀) (D₁ : Subscheme t₀.X') :
    ∃ m₀ : ℕ, ∀ m ≥ m₀, ∃ J : Subscheme X,
      Subscheme.totalTransform t₀.f J = t₀.exceptional ^ m * D₁ := by
  obtain ⟨m₀, hm₀⟩ := t₀.exists_totalTransform_map_eq D₁
  exact ⟨m₀, fun m hm => ⟨_, hm₀ m hm⟩⟩

end MonoidalTransformation

end Hironaka

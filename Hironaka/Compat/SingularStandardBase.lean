/-!
# Singularity of `W(s)` from the order-one elements of a standard base (Ch. IV §3, p. 305)

The proof of Lemma (AB.5) (ii) (p. 305): "If `W` is singular at `x_0`, then the number of those
indices `k` with `ν_{0k} = 1` is less than codimension of `W` in `X` at `x_0`. ... It is clear that
the codimension of `W(s)` in `W'_s` at `x'_s` is at least equal to that of `W` in `X` at `x_0`.
Therefore, in view of (a) and (b) of (2) for `Ĵ_0(s)` and `g_{0k}(s)`, we see that `W(s)` is
singular at the point `x' = x'_s`.  (Observe that a suitably reordered subsystem of
`(g_{01}(s), …, g_{0m}(s))` is a standard base of `Ĵ_0(s)`.)"  (The paper prints `W'_s`; the
ambient scheme `X'_s` is meant.)

General cores, all of them "clear" in the paper:
* the criterion: a quotient `R/J` of a regular local ring is regular iff `J` is generated by part
  of a regular system of parameters; for a standard base, the number of elements of order one is
  `dim_κ (J + M²)/M²`, which equals `ht J` exactly for regular `R/J`;
* the descent along the completion: `Ŝ/JŜ` regular implies `S/J` regular;
* the heights of strict transforms: `ht J' ≥ ht J`;
* the regularity of the completed quotient from class 𝔅 (ii).
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry IsLocalRing

namespace Hironaka

universe u

noncomputable section

/-! ### Classes in the cotangent space

The class `cotangentClass a ∈ M/M²` of an element, with its additivity and the criterion for
a class to lie in the span of the classes of a set, is `cotangentClass` of
`Hironaka/Compat/RegularQuotientGenerators.lean`. -/

section Criterion

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- `ht (T) = #T` for a set `T` extending to a regular system of parameters. -/
theorem height_span_eq_card_of_extendsToRSOP {T : Finset R} (h : ExtendsToRSOP R T) :
    (Ideal.span (T : Set R)).height = T.card := by
  classical
  have hP := ExtendsToRSOP.isPrime_span h
  refine le_antisymm ?_ (ExtendsToRSOP.card_le_height_span h)
  exact Ideal.height_le_card_of_mem_minimalPrimes_span_finset
    ⟨⟨hP, le_rfl⟩, fun q hq _ => hq.2⟩

/-- If `T` is part of a regular system of parameters, then `(T) ∩ M² ⊆ M (T)`. -/
theorem mem_maximalIdeal_mul_span_of_mem_sq {T : Finset R} (hT : ExtendsToRSOP R T) {e : R}
    (he : e ∈ Ideal.span (T : Set R)) (he2 : e ∈ maximalIdeal R ^ 2) :
    e ∈ maximalIdeal R * Ideal.span (T : Set R) := by
  classical
  have hind : RSOPIndep T (fun a : R => a) :=
    RSOPIndep.of_extends (fun a _ b _ h => h) (by simpa using hT)
  obtain ⟨f, -, rfl⟩ := Submodule.mem_span_finset.mp he
  refine sum_mem fun i hi => ?_
  have hfi : f i ∈ maximalIdeal R := by
    by_contra hfM
    have hu : IsUnit (f i) := IsLocalRing.notMem_maximalIdeal.mp hfM
    apply (hind i hi).2
    have hrest : ∑ j ∈ T.erase i, f j • j ∈
        Ideal.span ((fun a : R => a) '' ((T : Set R) \ {i})) := by
      refine sum_mem fun j hj => ?_
      have hjT := Finset.mem_erase.mp hj
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, ⟨hjT.2, hjT.1⟩, rfl⟩)
    have hsplit : f i • i = ∑ j ∈ T, f j • j - ∑ j ∈ T.erase i, f j • j := by
      rw [← Finset.add_sum_erase T _ hi]; ring
    have h1 : f i * i ∈ Ideal.span ((fun a : R => a) '' ((T : Set R) \ {i})) ⊔ maximalIdeal R ^ 2 :=
      by
        rw [smul_eq_mul] at hsplit
        rw [hsplit]
        exact Ideal.sub_mem _ (Ideal.mem_sup_right he2) (Ideal.mem_sup_left hrest)
    exact (Ideal.unit_mul_mem_iff_mem _ hu).mp h1
  exact Ideal.mul_mem_mul hfi (Ideal.subset_span hi)

/-- The class `[b X] ∈ gr¹_M(R)` of an element of the ideal generated by elements whose classes
lie in an ideal `L` of `gr_M(R)` lies in `L`. -/
theorem mk_one_mem_of_mem_span {A : Type u} [CommRing A] [IsLocalRing A]
    (L : Ideal (AssocGraded (maximalIdeal A))) (S : Set A) (hSM : S ⊆ maximalIdeal A)
    (hS : ∀ x (hx : x ∈ S), AssocGraded.mk (maximalIdeal A) 1 x (by simpa using hSM hx) ∈ L) :
    ∀ b ∈ Ideal.span S, ∀ hb : b ∈ maximalIdeal A ^ 1,
      AssocGraded.mk (maximalIdeal A) 1 b hb ∈ L := by
  have hle : Ideal.span S ≤ maximalIdeal A := Ideal.span_le.mpr hSM
  intro b hbS
  induction hbS using Submodule.span_induction with
  | mem x hx => intro hb; exact hS x hx
  | zero =>
    intro hb
    have : AssocGraded.mk (maximalIdeal A) 1 (0 : A) hb = 0 :=
      (AssocGraded.mk_eq_zero_iff (maximalIdeal A) hb).mpr (zero_mem _)
    rw [this]; exact zero_mem _
  | add x y hx hy ihx ihy =>
    intro hb
    have hx1 : x ∈ maximalIdeal A ^ 1 := by simpa using hle hx
    have hy1 : y ∈ maximalIdeal A ^ 1 := by simpa using hle hy
    have := AssocGraded.mk_add (maximalIdeal A) 1 x y hx1 hy1
    rw [show AssocGraded.mk (maximalIdeal A) 1 (x + y) hb =
      AssocGraded.mk (maximalIdeal A) 1 (x + y) (add_mem hx1 hy1) from rfl, this]
    exact add_mem (ihx hx1) (ihy hy1)
  | smul r x hx ihx =>
    intro hb
    have hx1 : x ∈ maximalIdeal A ^ 1 := by simpa using hle hx
    have h0 : r ∈ maximalIdeal A ^ 0 := by simp
    have := AssocGraded.mk_mul_mk (maximalIdeal A) h0 hx1
    have h1 : AssocGraded.mk (maximalIdeal A) 1 (r • x) hb =
        AssocGraded.mk (maximalIdeal A) 0 r h0 * AssocGraded.mk (maximalIdeal A) 1 x hx1 := by
      rw [this]; rfl
    rw [h1]
    exact Ideal.mul_mem_left _ _ (ihx hx1)

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- For a standard base, the classes in `M/M²` of the elements of order one are linearly
independent over `κ`: this is condition (iii) of Definition 3 in degree one.

Proof of the "clear" step of p. 305 (the counting): suppose `[g_a]` lies in the span of earlier
order-one classes; then `g_a - b ∈ M²` for an element `b` of the ideal they generate, so the
initial form of `g_a` equals the class of `b`, which lies in the ideal generated by the initial
forms of the earlier `g_j`: this contradicts (iii) of Definition 3.  Deviation from the paper
(gap filled): the paper says only "we see that ..." (p. 305).
-/
@[blueprint "lem:IV.AB-5-ii-order-one-independent"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $\mathfrak M$ and residue
    field $\kappa$, $J\ne R$ an ideal and $(g_1,\dots,g_m)$ a standard base of $J$
    (\cref{def:III.3}). Then the classes in $\mathfrak M/\mathfrak M^2$ of those $g_k$ with
    $\nu_{\mathfrak M}(g_k)=1$ are linearly independent over $\kappa$. (Used on p.~305, in the
    words ``the number of those indices $k$ with $\nu_{0k}=1$''.) -/)
  (proof := /-- Induct on the (ordered) set of indices of order one. If the class of $g_a$ lay in
    the span of the earlier ones, then $g_a-b\in\mathfrak M^2$ for an element $b$ of the ideal
    generated by the earlier $g_j$ of order one; hence the initial form of $g_a$ is the class of
    $b$, which lies in the ideal of $\operatorname{gr}_{\mathfrak M}(R)$ generated by the
    initial forms of the earlier $g_j$. This contradicts (iii) of \cref{def:III.3}.
    \textbf{Deviation from the paper (gap filled).} The paper says only ``we see that
    \ldots'' (p.~305). -/)
  (proofUses := ["def:III.3"])
  (latexEnv := "lemma")]
theorem linearIndepOn_cotangentClass_order_one_of_isStandardBase {J : Ideal R} (hJ : J ≠ ⊤)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) :
    LinearIndepOn (ResidueField R) (fun k => cotangentClass (g k))
      (↑(Finset.univ.filter fun k => Ideal.ordElem (maximalIdeal R) (g k) = 1) : Set (Fin m)) := by
  classical
  set G₁ := Finset.univ.filter fun k => Ideal.ordElem (maximalIdeal R) (g k) = 1 with hG₁
  have hJM : J ≤ maximalIdeal R := le_maximalIdeal hJ
  have key : ∀ s : Finset (Fin m), s ⊆ G₁ →
      LinearIndepOn (ResidueField R) (fun k => cotangentClass (g k)) (↑s : Set (Fin m)) := by
    intro s
    induction s using Finset.induction_on_max with
    | empty => intro _; simp
    | insert a s hlt ih =>
      intro hsub
      have haG : a ∈ G₁ := hsub (Finset.mem_insert_self a s)
      have hsG : s ⊆ G₁ := fun x hx => hsub (Finset.mem_insert_of_mem hx)
      have hna : a ∉ s := fun h => lt_irrefl a (hlt a h)
      rw [Finset.coe_insert]
      refine (ih hsG).insert fun hmem => ?_
      -- a combination `g a ≡ Σ c_j g_j (mod M²)` contradicts (iii)
      have hgM : ∀ j, g j ∈ maximalIdeal R := fun j => hJM (hg.1 j)
      have himg : cotangentClass (g a) ∈ Submodule.span (ResidueField R)
          (cotangentClass '' (g '' (s : Set (Fin m)))) := by
        rwa [Set.image_image]
      obtain ⟨b, hb, hab⟩ := exists_sub_mem_sq_of_cotangentClass_mem_span
        (by rintro _ ⟨j, -, rfl⟩; exact hgM j) (hgM a) himg
      set L : Ideal (AssocGraded (maximalIdeal R)) :=
        Ideal.span (Set.range fun j : Fin a =>
          initialForm (maximalIdeal R) (g (Fin.castLE a.2.le j))) with hL
      have hbL : ∀ hb1 : b ∈ maximalIdeal R ^ 1,
          AssocGraded.mk (maximalIdeal R) 1 b hb1 ∈ L := by
        refine mk_one_mem_of_mem_span L (g '' (s : Set (Fin m))) ?_ ?_ b hb
        · rintro _ ⟨j, -, rfl⟩; exact hgM j
        · rintro _ ⟨j, hj, rfl⟩
          have hjG : j ∈ G₁ := hsG hj
          have hj1 : Ideal.ordElem (maximalIdeal R) (g j) = ((1 : ℕ) : ℕ∞) := by
            have := (Finset.mem_filter.mp hjG).2
            simpa using this
          rw [← initialForm_eq_mk _ hj1, hL]
          exact Ideal.subset_span ⟨⟨j, hlt j hj⟩, rfl⟩
      have ha1 : Ideal.ordElem (maximalIdeal R) (g a) = ((1 : ℕ) : ℕ∞) := by
        have := (Finset.mem_filter.mp haG).2
        simpa using this
      have hbM : b ∈ maximalIdeal R ^ 1 := by
        rw [pow_one]
        exact (Ideal.span_le.mpr (by rintro _ ⟨j, -, rfl⟩; exact hgM j) :
          Ideal.span (g '' (s : Set (Fin m))) ≤ maximalIdeal R) hb
      have hsq1 : g a - b ∈ maximalIdeal R ^ 1 := Ideal.pow_le_pow_right (by norm_num : 1 ≤ 2) hab
      have hga1 : g a ∈ maximalIdeal R ^ 1 := by rw [pow_one]; exact hgM a
      have hmk : AssocGraded.mk (maximalIdeal R) 1 (g a) hga1 =
          AssocGraded.mk (maximalIdeal R) 1 b hbM := by
        have h1 := AssocGraded.mk_add (maximalIdeal R) 1 b (g a - b) hbM hsq1
        have h2 : AssocGraded.mk (maximalIdeal R) 1 (g a - b) hsq1 = 0 :=
          (AssocGraded.mk_eq_zero_iff (maximalIdeal R) hsq1).mpr hab
        rw [h2, add_zero] at h1
        rw [← h1]
        congr 1
        ring
      have hφ : initialForm (maximalIdeal R) (g a) ∈ L := by
        rw [initialForm_eq_mk _ ha1, hmk]
        exact hbL hbM
      exact hg.2.2.2.2 a hφ
  exact key G₁ le_rfl

/-- **(K2)** If the initial forms of `g_1, …, g_m ∈ J` generate `gr_M(J, R)` and the number of the
`g_k` of order one is less than `ht J`, then `R/J` is not regular (`J ≠ R`).

Paper (p. 305): "If W is singular at x_0, then the number of those indices k with ν_{0k} = 1
is less than codimension of W in X(= X_0 = X'_0) at x_0."  The remark "(Observe that a suitably
reordered subsystem of (g_{01}(s), ···, g_{0m}(s)) is a standard base of Ĵ_0(s).)" is not needed
by this ring-level criterion itself: only the generation of `gr_M(J)` by the initial forms is used, so no
reordering here.  The proof of the AB lemma (`RemovalFamily.not_isSimpleAt_strictTransform_of_b_le_nu`,
`Hironaka/Ch4/ImplicationsAB.lean`) applies this criterion, as printed, to the standard base of `Ĵ_0(s)` that
the remark provides (the subsystem extracted by `exists_injective_isStandardBase_comp`).

Deviation from the paper (gap filled): the paper says "we see that W(s) is singular at the point
x' = x'_s" (p. 305) without proof; this is the ring-level criterion (an equivalent contrapositive:
if `R/J` is regular then `J` is generated by part of a regular system of parameters, so the
`g_k` of order `≥ 2` are redundant by Nakayama and `ht J` is at most the number of those of
order one).
-/
@[blueprint "lem:IV.AB-5-ii-criterion"
  (statement := /-- Let $R$ be a regular local ring, $J\ne R$ an ideal and $g_1,\dots,g_m\in J$
    elements whose initial forms generate $\operatorname{gr}_{\mathfrak M}(J,R)$. If the number
    of the $g_k$ with $\nu_{\mathfrak M}(g_k)=1$ is less than the height of $J$, then $R/J$ is
    not regular. (p.~305: ``we see that $W(s)$ is singular'' from the number of $k$ with
    $\nu_{0k}=1$ being less than the codimension.) -/)
  (proof := /-- Suppose $R/J$ is regular. Then $J$ is generated by part $T$ of a regular system
    of parameters (\cref{lem:regular-quotient-rsop}), and $J\cap\mathfrak M^2\subseteq
    \mathfrak M J$. By the generation of $\operatorname{gr}_{\mathfrak M}(J,R)$, $J=(g_1,\dots,
    g_m)$, so $J\subseteq N+\mathfrak M^2$ for $N$ the ideal generated by the $g_k$ of order
    one, whence $J\subseteq N+\mathfrak M J$ and $J=N$ by Nakayama. By Krull's height theorem
    $\operatorname{ht}J=\operatorname{ht}N$ is at most the number of generators of $N$,
    a contradiction. \textbf{Deviation from the paper (gap filled).} The paper gives no proof
    (p.~305, ``we see that $W(s)$ is singular''). -/)
  (proofUses := ["lem:regular-quotient-rsop"])
  (latexEnv := "lemma")]
theorem not_isRegularLocalRing_quotient_of_card_order_one_lt_height {J : Ideal R} (hJ : J ≠ ⊤)
    {m : ℕ} (g : Fin m → R) (hgJ : ∀ k, g k ∈ J)
    (hgr : grIdeal (maximalIdeal R) J =
      Ideal.span (Set.range fun k => initialForm (maximalIdeal R) (g k)))
    (hlt : ((Finset.univ.filter fun k => Ideal.ordElem (maximalIdeal R) (g k) = 1).card : ℕ∞) <
      J.height) :
    ¬ IsRegularLocalRing (R ⧸ J) := by
  classical
  intro hreg
  have hdom : IsDomain (R ⧸ J) := Transforms.isDomain_of_isRegularLocalRing _
  have hJp : J.IsPrime := (Ideal.Quotient.isDomain_iff_prime J).mp hdom
  obtain ⟨S, T, hSM, hScard, hTS, hTJ⟩ := exists_finset_span_eq_prime R J hreg
  have hS : IsRegularSystemOfParameters R S :=
    ⟨hSM, by rw [hScard, IsRegularLocalRing.spanFinrank_maximalIdeal]⟩
  have hext : ExtendsToRSOP R T := ⟨S, hTS, hS⟩
  have hht : J.height = T.card := by rw [← hTJ]; exact height_span_eq_card_of_extendsToRSOP hext
  have hJM : J ≤ maximalIdeal R := le_maximalIdeal hJ
  have hJg : Ideal.span (Set.range g) = J :=
    span_eq_of_span_initialForm_eq_grIdeal (maximalIdeal R) (maximalIdeal.isMaximal R).ne_top J g
      hgJ hgr.symm
  -- `J ⊆ N + M²`, `N` generated by the elements of order one
  set G₁ := Finset.univ.filter fun k => Ideal.ordElem (maximalIdeal R) (g k) = 1 with hG₁
  set N : Ideal R := Ideal.span ((G₁.image g : Finset R) : Set R) with hN
  have hNJ : N ≤ J := Ideal.span_le.mpr fun a ha => by
    obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp ha
    exact hgJ k
  have hJN : J ≤ N ⊔ maximalIdeal R ^ 2 := by
    rw [← hJg, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    by_cases hk : k ∈ G₁
    · exact Ideal.mem_sup_left (Ideal.subset_span (by
        rw [Finset.coe_image]; exact ⟨k, hk, rfl⟩))
    · apply Ideal.mem_sup_right
      have h1 : (1 : ℕ∞) ≤ Ideal.ordElem (maximalIdeal R) (g k) := by
        have := Ideal.le_ordElem (I := maximalIdeal R) (f := g k) (ν := 1)
          (by simpa using hJM (hgJ k))
        exact_mod_cast this
      have h2 : (2 : ℕ∞) ≤ Ideal.ordElem (maximalIdeal R) (g k) := by
        have hne : Ideal.ordElem (maximalIdeal R) (g k) ≠ 1 := fun h => hk (by simp [hG₁, h])
        exact Order.succ_le_of_lt (lt_of_le_of_ne h1 (Ne.symm hne))
      exact Ideal.mem_pow_of_le_ordElem h2
  -- Nakayama: `J = N`
  have hJle : J ≤ N := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian J)
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
    intro a ha
    obtain ⟨n, hn, c, hc, hnc⟩ := Submodule.mem_sup.mp (hJN ha)
    have hcJ : c ∈ J := by
      have : c = a - n := by rw [← hnc]; ring
      rw [this]; exact Ideal.sub_mem _ ha (hNJ hn)
    have hc' : c ∈ maximalIdeal R * Ideal.span (T : Set R) :=
      mem_maximalIdeal_mul_span_of_mem_sq hext (hTJ ▸ hcJ) hc
    rw [hTJ] at hc'
    rw [← hnc]
    exact Submodule.add_mem_sup hn hc'
  have hJeq : J = N := le_antisymm hJle hNJ
  have hNne : N ≠ ⊤ := hJeq ▸ hJ
  have hbound : J.height ≤ (G₁.image g).card := by
    rw [hJeq]; exact Ideal.height_span_le_card_of_span_ne_top hNne
  have hcard : (G₁.image g).card ≤ G₁.card := Finset.card_image_le
  have : J.height ≤ G₁.card := hbound.trans (by exact_mod_cast hcard)
  exact absurd hlt (not_lt.mpr this)

/-- **(K1)** If `(g_k)` is a standard base of `J ≠ R` and `R/J` is not regular, the number of
`g_k` of order one is less than `ht J`.

This is the form in which the count of p. 305 is used: the order-one members of a standard base
of a non-regular quotient are fewer than the height (the paper's "codimension" at `x_0`, "the
minimum of the codimensions of irreducible components of W in X at x_0", is `Ideal.height` of
the stalk ideal, the infimum of the heights of its minimal primes).

Deviation from the paper (gap filled): "If W is singular at x_0, then the number of those indices
k with ν_{0k} = 1 is less than codimension of W in X(= X_0 = X'_0) at x_0" (p. 305) is stated
without proof.
-/
@[blueprint "lem:IV.AB-5-ii-standard-base-count"
  (statement := /-- Let $R$ be a regular local ring, $J\ne R$ an ideal and
    $(g_1,\dots,g_m)$ a standard base of $J$ (\cref{def:III.3}). If $R/J$ is not regular, the
    number of indices $k$ with $\nu_{\mathfrak M}(g_k)=1$ is less than the height of $J$, the
    minimum of the heights of the minimal primes of $J$. (p.~305: ``If $W$ is singular at $x_0$,
    then the number of those indices $k$ with $\nu_{0k}=1$ is less than codimension of $W$ in $X$
    at $x_0$.'') -/)
  (proof := /-- Suppose the number of $k$ of order one is at least $\operatorname{ht}J$. By
    \cref{lem:IV.AB-5-ii-order-one-independent} these $g_k$ have linearly independent classes
    in $\mathfrak M/\mathfrak M^2$, so they are part of a regular system of parameters. Hence
    the ideal $N\subseteq J$ they generate is prime of height equal to their number, which is
    at least $\operatorname{ht}J$, so $N=J$ and $R/J=R/N$ is regular, a contradiction.
    \textbf{Deviation from the paper (gap filled).} The paper gives no proof (p.~305). -/)
  (proofUses := ["lem:IV.AB-5-ii-order-one-independent", "lem:regular-quotient-rsop"])
  (latexEnv := "lemma")]
theorem card_order_one_lt_height_of_not_isRegularLocalRing_quotient {J : Ideal R} (hJ : J ≠ ⊤)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) (hreg : ¬ IsRegularLocalRing (R ⧸ J)) :
    ((Finset.univ.filter fun k => Ideal.ordElem (maximalIdeal R) (g k) = 1).card : ℕ∞) <
      J.height := by
  classical
  by_contra hnlt
  set G₁ := Finset.univ.filter fun k => Ideal.ordElem (maximalIdeal R) (g k) = 1 with hG₁
  have hind := linearIndepOn_cotangentClass_order_one_of_isStandardBase hJ g hg
  have hJM : J ≤ maximalIdeal R := le_maximalIdeal hJ
  have hrsop : RSOPIndep G₁ g := by
    intro z hz
    refine ⟨hJM (hg.1 z), fun hmem => ?_⟩
    obtain ⟨x, hx, c, hc, hxc⟩ := Submodule.mem_sup.mp hmem
    have hxM : x ∈ maximalIdeal R :=
      (Ideal.span_le.mpr (by rintro _ ⟨j, -, rfl⟩; exact hJM (hg.1 j)) :
        Ideal.span (g '' ((G₁ : Set (Fin m)) \ {z})) ≤ maximalIdeal R) hx
    have hcM : c ∈ maximalIdeal R := Ideal.pow_le_self (by norm_num) hc
    have h1 : cotangentClass (g z) = cotangentClass x := by
      rw [← hxc, cotangentClass_add hxM hcM, (cotangentClass_eq_zero_iff hcM).mpr hc, add_zero]
    refine hind.notMem_span (by simpa [hG₁] using hz) ?_
    rw [h1, ← Set.image_image]
    exact cotangentClass_mem_span_of_mem_span (by rintro _ ⟨j, -, rfl⟩; exact hJM (hg.1 j)) hx
  obtain ⟨hinj, hext⟩ := hrsop.injOn_and_extends
  set N : Ideal R := Ideal.span ((G₁.image g : Finset R) : Set R) with hN
  have hNJ : N ≤ J := Ideal.span_le.mpr fun a ha => by
    obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp ha
    exact hg.1 k
  have hNprime : N.IsPrime := ExtendsToRSOP.isPrime_span hext
  have hNht : N.height = G₁.card := by
    rw [hN, height_span_eq_card_of_extendsToRSOP hext, Finset.card_image_of_injOn hinj]
  have hle : J.height ≤ N.height := by
    rw [hNht]; exact not_lt.mp hnlt
  have hNJeq : N = J := Ideal.eq_of_le_of_height_le N hNJ hle
  apply hreg
  rw [← hNJeq]
  exact ExtendsToRSOP.isRegularLocalRing_quotient hext

end Criterion

section Completion

/-- **(K3)** Descent along the completion: if `Ŝ/JŜ` is regular, so is `S/J`.

Deviation from the paper (gap filled): the paper passes between `S_s/J_0(s)` and
`Ŝ_s/Ĵ_0(s)` without comment ("we see that W(s) is singular at the point x' = x'_s", p. 305).
The proof: `Ĵ` is prime and generated by part `T` of a regular system of parameters of `Ŝ`; lift
`T` to elements of `J` modulo `M̂ Ĵ`, which are independent modulo `M²` and so part of a regular
system of parameters of `S`; by Nakayama in `Ŝ` and faithful flatness `J` is the ideal they
generate.
-/
@[blueprint "lem:IV.AB-5-ii-completion-descent"
  (statement := /-- Let $S$ be a regular local ring, $\hat S$ its completion and $J$ an ideal of
    $S$. If $\hat S/J\hat S$ is regular, then $S/J$ is regular. (Used on p.~305 to go from
    $\hat S_s/\hat J_0(s)$ to $S_s/J_0(s)$.) -/)
  (proof := /-- The ring $\hat S$ is regular local and faithfully flat over $S$ with
    $\mathfrak M\hat S=\hat{\mathfrak M}$, and $\hat J=J\hat S$ is prime generated by part
    $T$ of a regular system of parameters of $\hat S$ (\cref{lem:regular-quotient-rsop}). Lift
    each $t\in T$ to $v(t)\in J$ with $t-v(t)\in\hat{\mathfrak M}\hat J$. The $v(t)$ are
    independent modulo $\mathfrak M^2$, since $t-v(t)\in\hat{\mathfrak M}^2$ and
    $\hat{\mathfrak M}^2\cap S=\mathfrak M^2$; so they are part of a regular system of
    parameters of $S$ and generate a prime $N\subseteq J$ with $S/N$ regular. By Nakayama in
    $\hat S$, $\hat J=N\hat S$, and by faithful flatness $J=N$.
    \textbf{Deviation from the paper (gap filled).} The paper does not comment on this passage
    (p.~305). -/)
  (proofUses := ["lem:regular-quotient-rsop"])
  (latexEnv := "lemma")]
theorem isRegularLocalRing_quotient_of_isRegularLocalRing_quotient_map_adicCompletion
    {S : Type u} [CommRing S] [IsRegularLocalRing S] (J : Ideal S)
    (h : IsRegularLocalRing (AdicCompletion (maximalIdeal S) S ⧸
      J.map (algebraMap S (AdicCompletion (maximalIdeal S) S)))) :
    IsRegularLocalRing (S ⧸ J) := by
  classical
  set m := maximalIdeal S with hm
  set Ŝ := AdicCompletion m S with hŜ
  have hreg : IsRegularLocalRing Ŝ := isRegularLocalRing_adicCompletion_of_isRegularLocalRing S
  set α := algebraMap S Ŝ with hα
  have : IsLocalHom α := inferInstance
  set Ĵ : Ideal Ŝ := J.map α with hĴ
  have hĴne : Ĵ ≠ ⊤ := fun hh => by
    have : Nontrivial (Ŝ ⧸ Ĵ) := inferInstance
    exact (Ideal.Quotient.nontrivial_iff.mp this) hh
  have hJne : J ≠ ⊤ := fun hJ => hĴne (by rw [hĴ, hJ, Ideal.map_top])
  have hJM : J ≤ m := le_maximalIdeal hJne
  have hĴM : Ĵ ≤ maximalIdeal Ŝ := le_maximalIdeal hĴne
  have hdom : IsDomain (Ŝ ⧸ Ĵ) := Transforms.isDomain_of_isRegularLocalRing _
  have hprime : Ĵ.IsPrime := (Ideal.Quotient.isDomain_iff_prime Ĵ).mp hdom
  obtain ⟨S₀, T, hS₀, hS₀card, hTS₀, hTĴ⟩ := exists_finset_span_eq_prime Ŝ Ĵ h
  have hS₀r : IsRegularSystemOfParameters Ŝ S₀ :=
    ⟨hS₀, by rw [hS₀card, IsRegularLocalRing.spanFinrank_maximalIdeal]⟩
  have hext : ExtendsToRSOP Ŝ T := ⟨S₀, hTS₀, hS₀r⟩
  have hind : RSOPIndep T (fun a : Ŝ => a) :=
    RSOPIndep.of_extends (fun a _ b _ h => h) (by simpa using hext)
  -- `M̂ = ker (Ŝ → S/M)`, so `Ŝ = α(S) + M̂`
  have hker : RingHom.ker (AdicCompletion.evalOneₐ m (R := S) : Ŝ →+* S ⧸ m) =
      maximalIdeal Ŝ := by
    let _ : Field (S ⧸ m) := Ideal.Quotient.field m
    have hmax : (RingHom.ker (AdicCompletion.evalOneₐ m (R := S) : Ŝ →+* S ⧸ m)).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective _ (AdicCompletion.evalOneₐ_surjective m)
    exact IsLocalRing.eq_maximalIdeal hmax
  have hdec : ∀ x : Ŝ, ∃ r : S, x - α r ∈ maximalIdeal Ŝ := fun x => by
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalOneₐ m (R := S) x)
    refine ⟨r, ?_⟩
    rw [← hker, RingHom.mem_ker]
    have hα1 : AdicCompletion.evalOneₐ m (R := S) (α r) = Ideal.Quotient.mk m r :=
      RingHom.congr_fun (AdicCompletion.evalOneₐ_comp_algebraMap_eq_mk (I := m) (R := S)) r
    show AdicCompletion.evalOneₐ m (R := S) (x - α r) = 0
    rw [map_sub, hα1, hr, sub_self]
  -- approximation of the generators of `Ĵ` by images of elements of `J`
  have happ : ∀ t ∈ Ĵ, ∃ f ∈ J, t - α f ∈ maximalIdeal Ŝ * Ĵ := by
    intro t ht
    have ht' : t ∈ Ideal.span (α '' (J : Set S)) := by rwa [hĴ, Ideal.map] at ht
    induction ht' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact ⟨j, hj, by simp⟩
    | zero => exact ⟨0, zero_mem _, by simp⟩
    | add x y hx hy ihx ihy =>
      have hxĴ : x ∈ Ĵ := by rwa [hĴ, Ideal.map]
      have hyĴ : y ∈ Ĵ := by rwa [hĴ, Ideal.map]
      obtain ⟨f, hf, hfx⟩ := ihx hxĴ
      obtain ⟨f', hf', hfy⟩ := ihy hyĴ
      refine ⟨f + f', add_mem hf hf', ?_⟩
      have : x + y - α (f + f') = (x - α f) + (y - α f') := by rw [map_add]; ring
      rw [this]; exact add_mem hfx hfy
    | smul r x hx ihx =>
      have hxĴ : x ∈ Ĵ := by rwa [hĴ, Ideal.map]
      obtain ⟨f, hf, hfx⟩ := ihx hxĴ
      obtain ⟨h, hh⟩ := hdec r
      refine ⟨h * f, Ideal.mul_mem_left _ h hf, ?_⟩
      have : r • x - α (h * f) = α h * (x - α f) + (r - α h) * x := by
        rw [smul_eq_mul, map_mul]; ring
      rw [this]
      exact add_mem (Ideal.mul_mem_left _ _ hfx) (Ideal.mul_mem_mul hh hxĴ)
  have hTĴ' : ∀ t ∈ T, t ∈ Ĵ := fun t ht => hTĴ ▸ Ideal.subset_span ht
  choose! v hvJ hvt using fun t (ht : t ∈ T) => happ t (hTĴ' t ht)
  have hsq : ∀ t ∈ T, t - α (v t) ∈ maximalIdeal Ŝ ^ 2 := fun t ht => by
    have := hvt t ht
    rw [pow_two]
    exact Ideal.mul_mono_right hĴM this
  have hmapM : m.map α ≤ maximalIdeal Ŝ := IsLocalRing.map_maximalIdeal_le α
  have hαsq : ∀ c ∈ m ^ 2, α c ∈ maximalIdeal Ŝ ^ 2 := fun c hc => by
    have h1 : α c ∈ (m ^ 2).map α := Ideal.mem_map_of_mem α hc
    rw [Ideal.map_pow] at h1
    exact Ideal.pow_right_mono hmapM 2 h1
  -- the family `v` is independent modulo `m²`
  have hrs : RSOPIndep T v := by
    intro z hz
    refine ⟨hJM (hvJ z hz), fun hmem => ?_⟩
    obtain ⟨x, hx, c, hc, hxc⟩ := Submodule.mem_sup.mp hmem
    set K : Ideal Ŝ := Ideal.span ((fun a : Ŝ => a) '' ((T : Set Ŝ) \ {z})) ⊔
      maximalIdeal Ŝ ^ 2 with hK
    have hαv : ∀ t ∈ ((T : Set Ŝ) \ {z}), α (v t) ∈ K := fun t ht => by
      have h1 : t ∈ K := Ideal.mem_sup_left (Ideal.subset_span ⟨t, ht, rfl⟩)
      have h2 : t - α (v t) ∈ K := Ideal.mem_sup_right (hsq t ht.1)
      have := Ideal.sub_mem K h1 h2
      rwa [sub_sub_cancel] at this
    have hαx : α x ∈ K := by
      have : α x ∈ Ideal.span (α '' (v '' ((T : Set Ŝ) \ {z}))) := by
        rw [← Ideal.map_span]; exact Ideal.mem_map_of_mem α hx
      refine (Ideal.span_le.mpr ?_ : Ideal.span (α '' (v '' ((T : Set Ŝ) \ {z}))) ≤ K) this
      rintro _ ⟨_, ⟨t, ht, rfl⟩, rfl⟩
      exact hαv t ht
    have hzK : z ∈ K := by
      have e : z = (z - α (v z)) + (α x + α c) := by
        rw [← map_add, hxc]; ring
      rw [e]
      exact add_mem (Ideal.mem_sup_right (hsq z hz))
        (add_mem hαx (Ideal.mem_sup_right (hαsq c hc)))
    exact (hind z hz).2 hzK
  obtain ⟨hinj, hextS⟩ := hrs.injOn_and_extends
  set N : Ideal S := Ideal.span ((T.image v : Finset S) : Set S) with hN
  have hNJ : N ≤ J := Ideal.span_le.mpr fun a ha => by
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp ha
    exact hvJ t ht
  -- Nakayama: `Ĵ = N Ŝ`
  have hTsub : (T : Set Ŝ) ⊆ (N.map α ⊔ maximalIdeal Ŝ • Ĵ : Ideal Ŝ) := by
    intro t ht
    have h1 : α (v t) ∈ N.map α :=
      Ideal.mem_map_of_mem α (Ideal.subset_span (Finset.mem_coe.mpr
        (Finset.mem_image_of_mem v ht)))
    have h2 : t - α (v t) ∈ maximalIdeal Ŝ • Ĵ := by
      rw [smul_eq_mul]; exact hvt t ht
    have := Submodule.add_mem_sup h1 h2
    rwa [add_sub_cancel] at this
  have hle : Ĵ ≤ N.map α ⊔ maximalIdeal Ŝ • Ĵ :=
    (le_of_eq hTĴ.symm).trans (Ideal.span_le.mpr hTsub)
  have hNĴ : N.map α ≤ Ĵ := Ideal.map_mono hNJ
  have hĴN : Ĵ ≤ N.map α :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian Ĵ)
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge hle
  have hJN : J = N := by
    have h1 := comap_map_adicCompletion_maximalIdeal J
    have h2 := comap_map_adicCompletion_maximalIdeal N
    rw [← hĴ, le_antisymm hĴN hNĴ] at h1
    exact h1.symm.trans h2
  rw [hJN]
  exact ExtendsToRSOP.isRegularLocalRing_quotient hextS

end Completion

section StrictTransform

section Dictionary

variable {Z : Scheme.{u}}

/-- The dimension of the local ring at the point of `Z` given by a prime `P` of `O_{Z,y}` is the
height of `P` (the stalk of `Spec O_{Z,y} → Z` at `P` is an isomorphism). -/
theorem ringKrullDim_stalk_fromSpecStalk (y : Z) (P : Spec (Z.presheaf.stalk y)) :
    ringKrullDim (Z.presheaf.stalk (Z.fromSpecStalk y P)) = P.asIdeal.height := by
  have := flat_fromSpecStalk Z y
  have hiso := isIso_stalkMap_of_flat_of_isPreimmersion (Z.fromSpecStalk y) P
  rw [ringKrullDim_eq_of_ringEquiv
    (asIso ((Z.fromSpecStalk y).stalkMap P)).commRingCatIsoToRingEquiv,
    ringKrullDim_stalk_eq_coheight, idealHeight_eq_coheight]

/-- A subscheme contains the point of `Z` given by a prime `P` of `O_{Z,y}` iff its stalk ideal at
`y` is contained in `P`. -/
theorem fromSpecStalk_mem_pts_iff (D : Subscheme Z) (y : Z) (P : Spec (Z.presheaf.stalk y)) :
    Z.fromSpecStalk y P ∈ D.pts ↔ D.stalkIdeal y ≤ P.asIdeal := by
  have h := stalkIdeal_comap_specMap_fromSpecStalk D y (Z.presheaf.stalk y) (𝟙 _) P
  simp only [Spec.map_id, Category.id_comp, CommRingCat.hom_id, Ideal.map_id] at h
  have hpts : Z.fromSpecStalk y P ∈ D.pts ↔
      P ∈ (Subscheme.totalTransform (Z.fromSpecStalk y) D).pts := by
    rw [Subscheme.pts_totalTransform_eq_preimage]; rfl
  rw [hpts, Subscheme.mem_pts_iff_stalkIdeal_ne_top]
  show Subscheme.stalkIdeal (D.comap (Z.fromSpecStalk y)) P ≠ ⊤ ↔ _
  rw [h]
  have hbij : Function.Bijective (Spec.stalkIso (Z.presheaf.stalk y) P).inv.hom :=
    ConcreteCategory.bijective_of_isIso (C := CommRingCat) _
  have : P.asIdeal.IsPrime := (show PrimeSpectrum (Z.presheaf.stalk y) from P).isPrime
  have hmap : ∀ I : Ideal (Localization.AtPrime P.asIdeal),
      I.map (Spec.stalkIso (Z.presheaf.stalk y) P).inv.hom = ⊤ ↔ I = ⊤ := by
    intro I
    refine ⟨fun hI => ?_, fun hI => hI ▸ Ideal.map_top _⟩
    rw [← Ideal.comap_map_of_bijective _ hbij (I := I), hI, Ideal.comap_top]
  rw [ne_eq, hmap, ← ne_eq,
    IsLocalization.map_algebraMap_ne_top_iff_disjoint P.asIdeal.primeCompl, Set.disjoint_left]
  exact ⟨fun hd a ha => by_contra fun hn => hd hn ha, fun hle a ha1 ha2 => ha1 (hle ha2)⟩

/-- The height of the stalk ideal of `D` at `y` is at most the dimension of the local ring of `Z`
at any generization `z` of `y` lying on `D`. -/
theorem height_stalkIdeal_le_ringKrullDim_stalk (D : Subscheme Z) {y z : Z} (hz : z ∈ D.pts)
    (hzy : z ⤳ y) :
    ((D.stalkIdeal y).height : WithBot ℕ∞) ≤ ringKrullDim (Z.presheaf.stalk z) := by
  have hz' : z ∈ Set.range (Z.fromSpecStalk y) := by
    rw [Scheme.range_fromSpecStalk]; exact hzy
  obtain ⟨P, rfl⟩ := hz'
  rw [ringKrullDim_stalk_fromSpecStalk]
  exact_mod_cast Ideal.height_mono ((fromSpecStalk_mem_pts_iff D y P).mp hz)

/-- A prime of `O_{Z,y}` containing the stalk ideal of `D` gives a generization of `y` lying on
`D`, whose local ring has dimension the height of the prime. -/
theorem exists_pts_specializes_ringKrullDim_eq (D : Subscheme Z) (y : Z)
    (P : Ideal (Z.presheaf.stalk y)) [hP : P.IsPrime] (hle : D.stalkIdeal y ≤ P) :
    ∃ p ∈ D.pts, p ⤳ y ∧ ringKrullDim (Z.presheaf.stalk p) = P.height := by
  let P' : Spec (Z.presheaf.stalk y) := (⟨P, hP⟩ : PrimeSpectrum (Z.presheaf.stalk y))
  refine ⟨Z.fromSpecStalk y P', (fromSpecStalk_mem_pts_iff D y P').mpr hle, ?_,
    ringKrullDim_stalk_fromSpecStalk y P'⟩
  have : Z.fromSpecStalk y P' ∈ Set.range (Z.fromSpecStalk y) := Set.mem_range_self _
  rwa [Scheme.range_fromSpecStalk] at this

end Dictionary

/-- **(K4)** The height of the stalk ideal of the strict transform is at least that of `W`
(p. 305: "It is clear that the codimension of `W(s)` … at `x'_s` is at least equal to that of `W`
in `X` at `x_0`", one step; iterate along a succession of non-singular schemes).

Paper (p. 305): "It is clear that the codimension of W(s) in W'_s at x'_s is at least equal to
that of W in X at x_0."  The paper prints `W'_s`; the ambient scheme `X'_s` is meant (misprint).

Deviation from the paper (gap filled): the paper gives no proof.  The proof here works with the
heights of primes of the local rings: a prime `P` of `O_{X',y}` containing the stalk ideal `J'` of
the strict transform is a generization `p` of `y` on `W'`, with `dim O_{X',p} = ht P`
(`Spec O_{X',y} → X'` is a flat preimmersion); a generization `q` of `p` on `W'` off the
exceptional divisor exists, `f` is an isomorphism of stalks at `q` (`X` non-singular), `f(q)` lies
on `W`, so `ht J ≤ dim O_{X,f q} = dim O_{X',q} ≤ dim O_{X',p} = ht P`.  The statement is true
also when the strict transform is empty at `y` (height `⊤`) and for components of `W` not through
`f(y)`, which do not enter; no irreducibility or nowhere-density is needed, only the
non-singularity of `X` (for the isomorphism off the center).
-/
@[blueprint "lem:IV.AB-5-ii-strict-transform-height"
  (statement := /-- Let $X$ be a non-singular scheme, $f\colon X'\to X$ a monoidal
    transformation, $W$ a subscheme of $X$ and $W'$ its strict transform, and $y\in X'$. Then the
    codimension of $W'$ in $X'$ at $y$ (the height of its stalk ideal, the minimum of the
    codimensions of the irreducible components through $y$) is at least the codimension of $W$ in
    $X$ at $f(y)$. (p.~305: ``It is clear that the codimension of $W(s)$ in $X'_s$ at $x'_s$ is at
    least equal to that of $W$ in $X$ at $x_0$'', for one transformation; iterate.) -/)
  (proof := /-- It suffices to bound $\operatorname{ht}P$ for each minimal prime $P$ of the stalk
    ideal $J'$ of $W'$ at $y$. The prime $P$ is a generization $p$ of $y$ on $W'$, and
    $\dim\mathcal O_{X',p}=\operatorname{ht}P$. By \cref{lem:strict-transform-saturation}
    there is a generization $q$ of $p$ on $W'$ off the exceptional divisor; by
    \cref{compat:blowup-local-iso}, $f$ is an isomorphism of local rings at $q$, and $f(q)\in W$
    is a generization of $f(y)$. Hence
    $\operatorname{ht}J_{f(y)}\le\dim\mathcal O_{X,f(q)}=\dim\mathcal O_{X',q}\le
    \dim\mathcal O_{X',p}=\operatorname{ht}P$.
    \textbf{Deviation from the paper (gap filled).} The paper gives no proof (p.~305); it
    prints $W'_s$ for the ambient scheme $X'_s$. -/)
  (proofUses := ["lem:strict-transform-saturation", "compat:blowup-local-iso",
    "def:I.0-codimension-at"])
  (latexEnv := "lemma")]
theorem MonoidalTransformation.height_stalkIdeal_le_strictTransform {X : Scheme.{u}}
    (hXns : X.IsNonsingular) {B : Subscheme X} (t : MonoidalTransformation X B)
    (W : Subscheme X) (y : t.X') :
    (W.stalkIdeal (t.f y)).height ≤ ((Subscheme.strictTransform t W).stalkIdeal y).height := by
  rw [Ideal.height_eq_inf_minimalPrimes ((Subscheme.strictTransform t W).stalkIdeal y)]
  refine le_iInf₂ fun P hP => ?_
  have hPprime : P.IsPrime := hP.1.1
  obtain ⟨p, hp, hpy, hdim⟩ := exists_pts_specializes_ringKrullDim_eq
    (Subscheme.strictTransform t W) y P hP.1.2
  obtain ⟨q, hq, hqE, hqp⟩ := t.exists_generization_notMem_exceptional W hp
  have hfB : t.f q ∉ B.pts := by
    rw [MonoidalTransformation.pts_exceptional] at hqE; exact hqE
  have hqW : t.f q ∈ W.pts :=
    (MonoidalTransformation.mem_pts_strictTransform_iff_of_notMem t W hqE).mp hq
  have hfq : t.f q ⤳ t.f y := (hqp.trans hpy).map t.f.continuous
  have h1 := height_stalkIdeal_le_ringKrullDim_stalk W hqW hfq
  have : IsRegularLocalRing (X.presheaf.stalk (t.f q)) := hXns _
  have h2 : ringKrullDim (X.presheaf.stalk (t.f q)) = ringKrullDim (t.X'.presheaf.stalk q) :=
    ringKrullDim_eq_of_ringEquiv
      (RingEquiv.ofBijective (t.f.stalkMap q).hom (t.bijective_stalkMap_of_notMem q hfB))
  have h3 : ringKrullDim (t.X'.presheaf.stalk q) ≤ ringKrullDim (t.X'.presheaf.stalk p) := by
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight]
    exact_mod_cast Order.coheight_anti (Scheme.le_iff_specializes.mpr hqp)
  have h4 := h1.trans (h2.le.trans (h3.trans hdim.le))
  exact_mod_cast h4

end StrictTransform

section Hironaka5Spec

open scoped TensorProduct

/-- Regularity of the completed stalk, `Spec` form (class 𝔅, (ii)): for `A` of finite type over
`S ∈ 𝔅` and `W = Spec A ×_{Spec S} Spec Ŝ`, a point of `W` over a regular point of `Spec A` is
regular. -/
theorem isRegularLocalRing_stalk_of_isPullback_spec {S : Type u} [CommRing S] [IsLocalRing S]
    [IsHironakaBase S] {A : Type u} [CommRing A] [Algebra S A] [Algebra.FiniteType S A]
    {W : Scheme.{u}} (ψ : W ⟶ Spec (CommRingCat.of A))
    (ĝ : W ⟶ Spec (CommRingCat.of (AdicCompletion (IsLocalRing.maximalIdeal S) S)))
    (H : IsPullback ψ ĝ (Spec.map (CommRingCat.ofHom (algebraMap S A)))
      (Spec.map (CommRingCat.ofHom (algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S)))))
    (w : W) (hreg : IsRegularLocalRing ((Spec (CommRingCat.of A)).presheaf.stalk (ψ w))) :
    IsRegularLocalRing (W.presheaf.stalk w) := by
  let e : W ≅ Spec (CommRingCat.of (A ⊗[S] AdicCompletion (IsLocalRing.maximalIdeal S) S)) :=
    H.isoPullback ≪≫ pullbackSpecIso S A (AdicCompletion (IsLocalRing.maximalIdeal S) S)
  let f : CommRingCat.of A ⟶
      CommRingCat.of (A ⊗[S] AdicCompletion (IsLocalRing.maximalIdeal S) S) :=
    CommRingCat.ofHom (algebraMap A _)
  have hw : e.hom ≫ Spec.map f = ψ ≫ 𝟙 _ := by
    rw [Category.comp_id]
    show (H.isoPullback.hom ≫ (pullbackSpecIso S A _).hom) ≫ Spec.map f = ψ
    rw [Category.assoc]
    simp only [f, pullbackSpecIso_hom_fst', IsPullback.isoPullback_hom_fst]
  have hpt : ψ.base w = (Spec.map f).base (e.hom.base w) := by
    have := congrArg (fun g : W ⟶ _ => g.base w) hw
    simpa using this.symm
  set q' : PrimeSpectrum (A ⊗[S] AdicCompletion (IsLocalRing.maximalIdeal S) S) := e.hom.base w
    with hq'
  have hreg0 : IsRegularLocalRing ((Spec (CommRingCat.of A)).presheaf.stalk
      ((Spec.map f).base q')) :=
    IsRegularLocalRing.of_ringEquiv
      ((Spec (CommRingCat.of A)).presheaf.stalkCongr (.of_eq hpt)).commRingCatIsoToRingEquiv
  have hreg1 : IsRegularLocalRing ((Spec (CommRingCat.of A)).presheaf.stalk
      (q'.comap f.hom)) := hreg0
  have hreg2 : IsRegularLocalRing (Localization.AtPrime (q'.asIdeal.comap (algebraMap A _))) :=
    IsRegularLocalRing.of_ringEquiv
      (Spec.stalkIso (CommRingCat.of A) (q'.comap f.hom)).commRingCatIsoToRingEquiv
  have hq : IsRegularLocalRing (Localization.AtPrime q'.asIdeal) :=
    (IsHironakaBase.completion_singularLocus A q').mpr hreg2
  have h2 : IsRegularLocalRing ((Spec (CommRingCat.of (A ⊗[S]
      AdicCompletion (IsLocalRing.maximalIdeal S) S))).presheaf.stalk q') :=
    IsRegularLocalRing.of_ringEquiv
      (Spec.stalkIso (CommRingCat.of (A ⊗[S] AdicCompletion (IsLocalRing.maximalIdeal S) S))
        q').commRingCatIsoToRingEquiv.symm
  exact IsRegularLocalRing.of_ringEquiv (asIso (e.hom.stalkMap w)).commRingCatIsoToRingEquiv

/-- Regularity of the stalk, chart form: the pull-back `cS : Y → P` of `Spec Ŝ → Spec S` along a
morphism `gS : P → Spec S` which is locally of finite type, `S ∈ 𝔅`; reduction to an affine
chart of `P`. -/
theorem isRegularLocalRing_stalk_of_isPullback_of_locallyOfFiniteType {S : Type u} [CommRing S]
    [IsLocalRing S] [IsHironakaBase S] {P Y : Scheme.{u}} (gS : P ⟶ Spec (CommRingCat.of S))
    [LocallyOfFiniteType gS] (cS : Y ⟶ P)
    (ĝ : Y ⟶ Spec (CommRingCat.of (AdicCompletion (IsLocalRing.maximalIdeal S) S)))
    (H : IsPullback cS ĝ gS
      (Spec.map (CommRingCat.ofHom (algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S)))))
    (y : Y) (hreg1 : IsRegularLocalRing (P.presheaf.stalk (cS y))) :
    IsRegularLocalRing (Y.presheaf.stalk y) := by
  obtain ⟨W, hW, hyW, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := ⊤) (x := cS y) (by simp)
  have : IsAffine (W : Scheme) := hW
  let y' : ((cS ⁻¹ᵁ W : Y.Opens) : Scheme.{u}) := ⟨y, hyW⟩
  have hsq := (isPullback_morphismRestrict cS W)
  have hw1 : (cS ⁻¹ᵁ W).ι ≫ cS = (cS ∣_ W) ≫ W.ι := (morphismRestrict_ι cS W).symm
  have Hpb : IsPullback (cS ∣_ W) ((cS ⁻¹ᵁ W).ι ≫ ĝ) (W.ι ≫ gS) _ :=
    (hsq.flip.paste_horiz H.flip).flip
  let ν : (W : Scheme) ≅ Spec Γ((W : Scheme), ⊤) := Scheme.isoSpec (W : Scheme)
  obtain ⟨φ, hφ⟩ := Spec.map_surjective (ν.inv ≫ W.ι ≫ gS)
  have HpbS : IsPullback (cS ∣_ W ≫ ν.hom) ((cS ⁻¹ᵁ W).ι ≫ ĝ) (Spec.map φ)
      (Spec.map (CommRingCat.ofHom
        (algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S)))) := by
    refine Hpb.of_iso (Iso.refl _) ν (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp
    · simp [hφ]
    · simp
  let inst : Algebra S Γ((W : Scheme), ⊤) := φ.hom.toAlgebra
  have hft : Algebra.FiniteType S Γ((W : Scheme), ⊤) := by
    have : LocallyOfFiniteType (Spec.map φ) := by
      rw [hφ]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
  have hreg2 : IsRegularLocalRing ((W : Scheme).presheaf.stalk ((cS ∣_ W) y')) :=
    (isRegularLocalRing_stalk_iff_of_square (cS ⁻¹ᵁ W).ι cS (cS ∣_ W) W.ι hw1 y').mp hreg1
  have hreg3 : IsRegularLocalRing ((Spec Γ((W : Scheme), ⊤)).presheaf.stalk
      ((cS ∣_ W ≫ ν.hom) y')) :=
    (isRegularLocalRing_stalk_iff_of_square (𝟙 ((cS ⁻¹ᵁ W : Y.Opens) : Scheme.{u}))
      (cS ∣_ W ≫ ν.hom) (cS ∣_ W) ν.hom (by simp) y').mpr hreg2
  have hU : IsRegularLocalRing (((cS ⁻¹ᵁ W : Y.Opens) : Scheme.{u}).presheaf.stalk y') :=
    @isRegularLocalRing_stalk_of_isPullback_spec S _ _ _ Γ((W : Scheme), ⊤) _ inst hft
      _ (cS ∣_ W ≫ ν.hom) _ HpbS y' hreg3
  exact IsRegularLocalRing.of_ringEquiv
    (asIso ((cS ⁻¹ᵁ W).ι.stalkMap y')).commRingCatIsoToRingEquiv.symm

/-- **The scheme-level bridge for regularity (class 𝔅, (ii))**: let `S = O_{X,x₀}` belong to the
class 𝔅, `g : Y → X` be locally of finite type and `c : Ŷ → Y`, `ĝ : Ŷ → Spec Ŝ` the pull-back
of `g` along `Spec Ŝ → Spec S → X`.  Then `O_{Ŷ,ŷ}` is regular whenever `O_{Y,c ŷ}` is.

Deviation from the paper (gap filled): the passage from `Ŝ_s/Ĵ_0(s)` to `S_s/J_0(s)` on p. 305
uses the class 𝔅 tacitly; the analogous passage on p. 320 reads "This can be easily deduced from
the fact that X̂_s = X_s ×_X Spec(Ŝ) and that S belongs to the class 𝔅".
-/
@[blueprint "lem:IV.AB-5-ii-class-A-stalk"
  (statement := /-- Let $x_0\in X$ with $S=\mathcal O_{X,x_0}$ in the class $\mathfrak B$
    (\cref{def:class-A}), $g\colon Y\to X$ locally of finite type, and $\hat Y=Y\times_X
    \operatorname{Spec}\hat S$ with projection $c\colon\hat Y\to Y$. If $\mathcal
    O_{Y,c(\hat y)}$ is regular, then so is $\mathcal O_{\hat Y,\hat y}$. -/)
  (proof := /-- Replace $Y$ by $P=Y\times_X\operatorname{Spec}S$ (the stalks agree, $P\to Y$ being
    flat and a preimmersion), then by an affine chart $\operatorname{Spec}A$, $A$ of finite type
    over $S$; there $\hat Y\supseteq\operatorname{Spec}(A\otimes_S\hat S)$ and condition (ii) of
    \cref{def:class-A} applies. \textbf{Deviation from the paper (gap filled).} The passage from $\hat S_s/\hat J_0(s)$ to $S_s/J_0(s)$ on p.~305 uses the class $\mathfrak B$ tacitly (the analogous passage on p.~320 reads ``This can be easily deduced from the fact that $\hat X_s=X_s\times_X\operatorname{Spec}(\hat S)$ and that $S$ belongs to the class $\mathfrak B$''). -/)
  (proofUses := ["def:class-A"])
  (latexEnv := "lemma")]
theorem isRegularLocalRing_stalk_of_isPullback_completion {X Y Ŷ : Scheme.{u}} (x₀ : X)
    [IsHironakaBase (X.presheaf.stalk x₀)] (g : Y ⟶ X) [LocallyOfFiniteType g] (c : Ŷ ⟶ Y)
    (ĝ : Ŷ ⟶ Spec (CommRingCat.of (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x₀))
      (X.presheaf.stalk x₀))))
    (H : IsPullback c ĝ g (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x₀)
      (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x₀))
        (X.presheaf.stalk x₀)))) ≫ X.fromSpecStalk x₀))
    (ŷ : Ŷ) (hreg : IsRegularLocalRing (Y.presheaf.stalk (c ŷ))) :
    IsRegularLocalRing (Ŷ.presheaf.stalk ŷ) := by
  obtain ⟨P, π, gS, cS, H1, hc, H2⟩ := exists_factorization_isPullback x₀ g c ĝ _ H
  subst hc
  have hflat : Flat π := MorphismProperty.of_isPullback H1.flip (flat_fromSpecStalk X x₀)
  have hpre : IsPreimmersion π := MorphismProperty.of_isPullback (P := @IsPreimmersion) H1.flip
    inferInstance
  have hfin : LocallyOfFiniteType gS :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) H1 inferInstance
  have hiso := isIso_stalkMap_of_flat_of_isPreimmersion π (cS ŷ)
  have hreg' : IsRegularLocalRing (Y.presheaf.stalk (π (cS ŷ))) := hreg
  have hregP : IsRegularLocalRing (P.presheaf.stalk (cS ŷ)) :=
    IsRegularLocalRing.of_ringEquiv (asIso (π.stalkMap (cS ŷ))).commRingCatIsoToRingEquiv
  have hloc : IsLocalRing (X.presheaf.stalk x₀) := inferInstance
  exact @isRegularLocalRing_stalk_of_isPullback_of_locallyOfFiniteType
    (X.presheaf.stalk x₀) _ hloc _ P Ŷ gS hfin cS ĝ H2 ŷ hregP

end Hironaka5Spec

section Hironaka5

/-- The quotient of the stalk of `Z` by the stalk of `D` at `z = ι y` is regular iff the stalk of
the scheme `D` at `y` is. -/
theorem isRegularLocalRing_quotient_stalk_iff {Z : Scheme.{u}} (D : Subscheme Z) {z : Z}
    (y : D.toScheme) (hy : D.ι y = z) :
    IsRegularLocalRing (Z.presheaf.stalk z ⧸ D.stalkIdeal z) ↔
      IsRegularLocalRing (D.toScheme.presheaf.stalk y) := by
  subst hy
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv D y
  exact ⟨fun _ => IsRegularLocalRing.of_ringEquiv e,
    fun _ => IsRegularLocalRing.of_ringEquiv e.symm⟩

/-- **(K5)** Regularity of the completed quotient (class 𝔅, (ii)): let `Ŷ = Y ×_X Spec Ŝ` with
`Y → X` locally of finite type, `S = O_{X,x_0} ∈ 𝔅`, `W ⊆ Y` a subscheme and `ŷ ∈ Ŷ`.  If
`O_{Y,c ŷ}/W` is regular, then so is `O_{Ŷ,ŷ}/c⁻¹(W)`.

Paper (p. 305): "we see that W(s) is singular at the point x' = x'_s": the completed quotient
`Ŝ_s/Ĵ_0(s)` is regular if `S_s/J_0(s)` is (this is what the contrapositive needs).

Deviation from the paper (gap filled; route changed): the paper compares the count of order-one
elements of a standard base of `Ĵ_0(s)` in `Ŝ_s` with the codimension of `W` in `X` at `x_0` and
of `W(s)` in `X'_s` at `x'_s`, i.e. heights in `S` and `S_s`, without relating them to heights of
the completed ideals.  Lean keeps all heights in the completed rings
(`lem:IV.AB-5-ii-standard-base-count` and `lem:IV.AB-5-ii-criterion` in `Ŝ_s`,
`lem:IV.AB-5-ii-strict-transform-height` for the transformations of `Spec Ŝ`) and moves
regularity between `S_s` and `Ŝ_s` by this lemma and `lem:IV.AB-5-ii-completion-descent`.
-/
@[blueprint "lem:IV.AB-5-ii-class-A-quotient"
  (statement := /-- With the notation of \cref{lem:IV.AB-5-ii-class-A-stalk}, let $W$ be a
    subscheme of $Y$ and $\hat y\in\hat Y$. If $\mathcal O_{Y,c(\hat y)}/W$ is regular, then so is
    $\mathcal O_{\hat Y,\hat y}/c^{-1}(W)$. (p.~305: ``we see that $W(s)$ is singular at the
    point $x'=x'_s$''.) -/)
  (proof := /-- The total transform $c^{-1}(W)$ is the pull-back $W\times_Y\hat Y=W\times_X
    \operatorname{Spec}\hat S$, so $\mathcal O_{\hat Y,\hat y}/c^{-1}(W)$ is the local ring of
    this base change at the corresponding point, and $\mathcal O_{Y,c(\hat y)}/W$ is the local ring
    of $W$ at its image; apply \cref{lem:IV.AB-5-ii-class-A-stalk} to $W\to X$.
    \textbf{Deviation from the paper (gap filled; route changed).} The paper compares the count of order-one elements of a standard base of $\hat J_0(s)$ in $\hat S_s$ with the codimension of $W$ in $X$ at $x_0$ and of $W(s)$ in $X_s'$ at $x_s'$, i.e.\ heights in $S$ and $S_s$, without relating them to heights of the completed ideals; Lean keeps all heights in the completed rings and moves regularity between $S_s$ and $\hat S_s$ by this lemma. -/)
  (proofUses := ["lem:IV.AB-5-ii-class-A-stalk"])
  (latexEnv := "lemma")]
theorem isRegularLocalRing_quotient_stalk_totalTransform_of_isPullback_completion
    {X Y Ŷ : Scheme.{u}} (x₀ : X) [IsHironakaBase (X.presheaf.stalk x₀)] (g : Y ⟶ X)
    [LocallyOfFiniteType g] (c : Ŷ ⟶ Y)
    (ĝ : Ŷ ⟶ Spec (CommRingCat.of (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x₀))
      (X.presheaf.stalk x₀))))
    (H : IsPullback c ĝ g (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x₀)
      (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x₀))
        (X.presheaf.stalk x₀)))) ≫ X.fromSpecStalk x₀))
    (W : Subscheme Y) (ŷ : Ŷ)
    (hreg : IsRegularLocalRing (Y.presheaf.stalk (c ŷ) ⧸ W.stalkIdeal (c ŷ))) :
    IsRegularLocalRing (Ŷ.presheaf.stalk ŷ ⧸ (Subscheme.totalTransform c W).stalkIdeal ŷ) := by
  have hne : W.stalkIdeal (c ŷ) ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have hmem : c ŷ ∈ W.pts := Subscheme.mem_pts_iff_stalkIdeal_ne_top.mpr hne
  have hmem' : ŷ ∈ (Subscheme.totalTransform c W).pts := by
    rw [Subscheme.pts_totalTransform_eq_preimage]; exact hmem
  obtain ⟨w, hw⟩ := Subscheme.exists_ι_eq_of_mem_pts (Subscheme.totalTransform c W) hmem'
  let cW : (Subscheme.totalTransform c W).toScheme ⟶ W.toScheme :=
    Scheme.IdealSheafData.subschemeMap (W.comap c) W c (W.le_map_comap c)
  have hsq : (Subscheme.totalTransform c W).ι ≫ c = cW ≫ W.ι :=
    (Scheme.IdealSheafData.subschemeMap_subschemeι (W.comap c) W c (W.le_map_comap c)).symm
  have hP : IsPullback (Subscheme.totalTransform c W).ι cW c W.ι := by
    refine isPullback_of_isClosedImmersion _ _ _ _ hsq ?_
    show W.subschemeι.ker.comap c = (W.comap c).subschemeι.ker
    rw [Scheme.IdealSheafData.ker_subschemeι, Scheme.IdealSheafData.ker_subschemeι]
  have Hpb := (hP.paste_horiz H.flip).flip
  have hy : W.ι (cW w) = c ŷ := by
    rw [← hw, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hsq]
  have hregW : IsRegularLocalRing (W.toScheme.presheaf.stalk (cW w)) :=
    (isRegularLocalRing_quotient_stalk_iff W (cW w) hy).mp hreg
  have : LocallyOfFiniteType (W.ι ≫ g) := inferInstance
  have hreg' := isRegularLocalRing_stalk_of_isPullback_completion x₀ (W.ι ≫ g) cW
    ((Subscheme.totalTransform c W).ι ≫ ĝ) Hpb w hregW
  exact (isRegularLocalRing_quotient_stalk_iff (Subscheme.totalTransform c W) w hw).mpr hreg'

end Hironaka5


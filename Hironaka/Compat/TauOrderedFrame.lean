/-!
# Regular systems of `τ`-parameters through the spaces of Definition 10*

For a standard base `(g₁, …, g_m)` of `J` and a system `(w₁, …, w_r)` which can be extended to a
regular system of parameters, the classes of `w₁, …, w_{τ^{(b)}(J)}` span a space with the
property of Definition 6 up to degree `μ^{(b)}(J)` as soon as `τ_{(w₁, …, w_{τ^{(b)}})}(g_j) = 0`
for all `g_j` of order `≤ μ^{(b)}(J)` (Definition 7, pp. 222–223; Definition 10, pp. 252–253).
The `T` of Definition 10* for an initial segment of a standard base is the `T_b` of Definition 7
(`Hironaka/Compat/TauZStandardBase.lean`).
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

section Ordered

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The property of Definition 6 is preserved by enlarging the `k`-space `T` of linear forms
(`gr_M(J, R) ∩ k[T] ⊆ gr_M(J, R) ∩ k[T']`, and the ideal generated is contained in `gr_M(J, R)`). -/
theorem IsTauSubmodule.mono {J : Ideal R}
    {T T' : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))} {μ₀ : ℕ}
    (h : IsTauSubmodule R J T μ₀) (hle : T ≤ T')
    (hT' : T' ≤ AssocGraded.homogeneous (maximalIdeal R) 1) : IsTauSubmodule R J T' μ₀ := by
  refine ⟨hT', fun μ hμ ψ hψ => ⟨fun hJ => ?_, fun hs => ?_⟩⟩
  · refine Ideal.span_mono (Set.inter_subset_inter_right _ ?_) ((h.2 μ hμ ψ hψ).1 hJ)
    exact Algebra.adjoin_mono (SetLike.coe_subset_coe.mpr hle)
  · exact (Ideal.span_le.mpr fun x hx => hx.1) hs

open Classical in
/-- **Regular systems of `τ`-parameters through the spaces of Definition 10*.**  Let `(g₁, …, g_m)`
be a standard base of `J` and `(w₁, …, w_r)` an injective system which can be extended to a
regular system of parameters.  If the initial forms of the `g_j` with `ν_M(g_j) ≤ μ^{(b)}(J)` lie in
the `k`-algebra generated by the initial forms of `w₁, …, w_{τ^{(b)}(J)}` (stated through
`τ_{(w_1, …, w_{τ^{(b)}})}(g_j) = 0`), then the classes of `w₁, …, w_{τ^{(b)}(J)}` span a space
with the property of Definition 6 up to degree `μ^{(b)}(J)`, i.e. contain `T_b` (p. 222). -/
theorem isTauSubmodule_span_castLE_of_forall_tauZ_eq_zero (J : Ideal R) {m r : ℕ}
    (g : Fin m → R) (hg : IsStandardBase R J g) (w : Fin r → R) (hinj : Function.Injective w)
    (hext : ExtendsToRSOP R (Finset.image w Finset.univ)) {b : ℕ} (hb : 1 ≤ b)
    (hbt : b ≤ t R J) (h : tau R J b ≤ r)
    (hz : ∀ j : Fin m, Ideal.ordElem (maximalIdeal R) (g j) ≤ (mu R J b : ℕ∞) →
      tauZ R (fun l : Fin (tau R J b) => w (Fin.castLE h l)) (fun _ : Fin 1 => g j) = 0) :
    IsTauSubmodule R J (Submodule.span (R ⧸ maximalIdeal R)
      (Set.range fun l : Fin (tau R J b) => frameForm w (Fin.castLE h l))) (mu R J b) := by
  obtain ⟨-, hord⟩ := linearIndependent_frameForm hinj hext
  obtain ⟨m', hm', hlow, -, heq, -⟩ := exists_prefix_tauZSubmodule_eq_tauSubmodule J g hg hb hbt
  set V := Submodule.span (R ⧸ maximalIdeal R)
    (Set.range fun l : Fin (tau R J b) => frameForm w (Fin.castLE h l)) with hV
  have hV1 : V ≤ AssocGraded.homogeneous (maximalIdeal R) 1 := by
    rw [hV, Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    show initialForm (maximalIdeal R) (w (Fin.castLE h l)) ∈ _
    rw [initialForm_eq_mk _ (hord _)]
    exact AssocGraded.mk_mem_homogeneous _ _
  have hinj' : Function.Injective fun l : Fin (tau R J b) => w (Fin.castLE h l) :=
    hinj.comp (Fin.castLE_injective h)
  have hext' : ExtendsToRSOP R
      (Finset.image (fun l : Fin (tau R J b) => w (Fin.castLE h l)) Finset.univ) := by
    obtain ⟨s, hs, hsr⟩ := hext
    refine ⟨s, fun x hx => hs ?_, hsr⟩
    obtain ⟨l, -, rfl⟩ := Finset.mem_image.mp hx
    exact Finset.mem_image.mpr ⟨Fin.castLE h l, Finset.mem_univ _, rfl⟩
  have hle : tauSubmodule R J b ≤ V := by
    rw [← heq]
    refine tauZSubmodule_le_of_forall_mem_adjoin _ V hV1 fun j => ?_
    have hj := hz (Fin.castLE hm' j) (hlow (Fin.castLE hm' j) j.2)
    have h0 := tauZSubmoduleStar_eq_span_of_tauZ_eq_zero hinj' hext'
      (fun _ : Fin 1 => g (Fin.castLE hm' j)) hj
    have h1 := initialForm_mem_adjoin_tauZSubmoduleStar
      (fun l : Fin (tau R J b) => w (Fin.castLE h l)) (g (Fin.castLE hm' j))
    rw [h0] at h1
    exact h1
  exact (tauSubmodule_spec R J b hb hbt).1.mono hle hV1

end Ordered

section MuMax

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (J : Ideal R)

/-- `μ^{(t)}(J)` is the largest of the distinct integers which appear in `ν*(J)`. -/
theorem le_mu_t_of_mem_muSet {x : ℕ} (hx : x ∈ muSet R J) : x ≤ mu R J (t R J) := by
  have hf := (muSet_finite R J).1
  have hcard : hf.toFinset.card = t R J := (Set.ncard_eq_toFinset_card _ hf).symm
  obtain ⟨n, hn, hnx⟩ := Nat.exists_lt_card_nth_eq (p := (· ∈ muSet R J)) hx
  have hn' := hn hf
  rw [← hnx, mu]
  have key := Nat.nth_strictMonoOn (p := (· ∈ muSet R J)) hf
  rw [hcard] at hn'
  have ht0 : 1 ≤ t R J := by omega
  exact key.monotoneOn (Set.mem_Iio.mpr (by rw [hcard]; omega)) (Set.mem_Iio.mpr (by
    rw [hcard]; omega)) (by omega)

theorem mu_t_mem_muSet (ht : 1 ≤ t R J) : mu R J (t R J) ∈ muSet R J := by
  have hf := (muSet_finite R J).1
  have hcard : hf.toFinset.card = t R J := (Set.ncard_eq_toFinset_card _ hf).symm
  exact Nat.nth_mem_of_lt_card (p := (· ∈ muSet R J)) hf (by rw [hcard]; omega)

theorem mu_lt_mu_t {b : ℕ} (hb : 1 ≤ b) (hbt : b < t R J) : mu R J b < mu R J (t R J) := by
  have hf := (muSet_finite R J).1
  have hcard : hf.toFinset.card = t R J := (Set.ncard_eq_toFinset_card _ hf).symm
  have key := Nat.nth_strictMonoOn (p := (· ∈ muSet R J)) hf
  exact key (Set.mem_Iio.mpr (by rw [hcard]; omega)) (Set.mem_Iio.mpr (by rw [hcard]; omega))
    (by omega)

/-- The orders of the members of a standard base are among the integers which appear in `ν*(J)`. -/
theorem ordElem_mem_muSet {m : ℕ} {f : Fin m → R} (hf : IsStandardBase R J f) (j : Fin m) :
    ∃ μ ∈ muSet R J, Ideal.ordElem (maximalIdeal R) (f j) = (μ : ℕ∞) := by
  have hne : initialForm (maximalIdeal R) (f j) ≠ 0 := fun h0 =>
    hf.2.2.2.2 j (by beta_reduce; rw [h0]; exact zero_mem _)
  have htop : Ideal.ordElem (maximalIdeal R) (f j) ≠ ⊤ := fun h => hne (by
    rw [initialForm, dite_eq_left h])
  obtain ⟨μ, hμ⟩ := ENat.ne_top_iff_exists.mp htop
  exact ⟨μ, ⟨(j : ℕ).succPNat, by rw [← ordElem_eq_nuI_of_isStandardBase J f hf j, ← hμ]⟩,
    hμ.symm⟩

theorem ordElem_le_mu_t {m : ℕ} {f : Fin m → R} (hf : IsStandardBase R J f) (j : Fin m) :
    Ideal.ordElem (maximalIdeal R) (f j) ≤ (mu R J (t R J) : ℕ∞) := by
  obtain ⟨μ, hμ, h⟩ := ordElem_mem_muSet J hf j
  rw [h]
  exact_mod_cast le_mu_t_of_mem_muSet J hμ

/-- Some member of a standard base has the order `μ^{(t)}(J)`. -/
theorem exists_ordElem_eq_mu_t {m : ℕ} {f : Fin m → R} (hf : IsStandardBase R J f)
    (ht : 1 ≤ t R J) :
    ∃ j : Fin m, Ideal.ordElem (maximalIdeal R) (f j) = (mu R J (t R J) : ℕ∞) := by
  obtain ⟨i, hi⟩ := mu_t_mem_muSet J ht
  have hm : (i : ℕ) ≤ m := by
    by_contra hlt
    rw [not_le] at hlt
    obtain ⟨-, htop⟩ := nuI_eq_of_hasLemma1Properties R J _ hf.2
    rw [htop i hlt] at hi
    exact ENat.top_ne_natCast _ hi
  obtain ⟨k, hk⟩ : ∃ k : ℕ, (i : ℕ) = k + 1 := ⟨(i : ℕ) - 1, by have := i.pos; omega⟩
  refine ⟨⟨k, by omega⟩, ?_⟩
  rw [ordElem_eq_nuI_of_isStandardBase J f hf ⟨k, by omega⟩]
  convert hi using 2
  exact PNat.eq (by simp [hk])

end MuMax

section RegularTauFrameCriterion

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

open Classical in
/-- **A criterion for regular `τ`-frames** (Definition 10, pp. 252--253, with Definition 7 for the
ordered notion of a regular system of `τ`-parameters): a regular frame `(S; w₁, …, w_r)` of `R`
is a regular `τ`-frame for `J` as soon as `r = τ^{(t)}(J)` and, for a standard base
`(g₁, …, g_m)` of `J` and every `1 ≤ b ≤ t(J)`, `τ_{(w₁, …, w_{τ^{(b)}})}(g_j) = 0` for all `g_j` of
order `≤ μ^{(b)}(J)` (the initial forms of these `g_j` lie in `k[W₁, …, W_{τ^{(b)}}]`). -/
theorem RegularFrame.isRegularTauFrame_of_forall_tauZ_eq_zero (G : RegularFrame R) (J : Ideal R)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) (hr : tau R J (t R J) = G.r)
    (hz : ∀ b, 1 ≤ b → b ≤ t R J → ∀ h : tau R J b ≤ G.r, ∀ j : Fin m,
      Ideal.ordElem (maximalIdeal R) (g j) ≤ (mu R J b : ℕ∞) →
        tauZ R (fun l : Fin (tau R J b) => G.z (Fin.castLE h l)) (fun _ : Fin 1 => g j) = 0) :
    G.IsRegularTauFrame J := by
  have hM : ∀ j, G.z j ∈ maximalIdeal R := fun j =>
    G.extends_rsop.mem_maximalIdeal (Finset.mem_image_of_mem _ (Finset.mem_univ j))
  have hord : ∀ j, Ideal.ordElem (maximalIdeal R) (G.z j) = 1 := fun j =>
    ordElem_maximalIdeal_eq_one_of_mem_extendsToRSOP G.extends_rsop
      (Finset.mem_image_of_mem _ (Finset.mem_univ j))
  refine ⟨hr, hM, fun b hb1 hbt => ?_⟩
  have hbr : tau R J b ≤ G.r := hr ▸ tau_le_tau_of_le J hb1 hbt le_rfl
  have hset : Set.range (fun i : {i : Fin (tau R J (t R J)) // (i : ℕ) < tau R J b} =>
      AssocGraded.mk (maximalIdeal R) 1 (G.z (Fin.cast hr i.1)) (by
        rw [pow_one]; exact hM _)) =
      Set.range fun l : Fin (tau R J b) => frameForm G.z (Fin.castLE hbr l) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      refine ⟨⟨i.1.1, i.2⟩, ?_⟩
      show initialForm (maximalIdeal R) (G.z (Fin.castLE hbr ⟨i.1.1, i.2⟩)) = _
      rw [initialForm_eq_mk _ (hord _)]
      rfl
    · rintro ⟨l, rfl⟩
      refine ⟨⟨⟨l.1, lt_of_lt_of_le l.2 (hr ▸ hbr)⟩, l.2⟩, ?_⟩
      show _ = initialForm (maximalIdeal R) (G.z (Fin.castLE hbr l))
      rw [initialForm_eq_mk _ (hord _)]
      rfl
  show IsTauSubmodule R J (Submodule.span (R ⧸ maximalIdeal R) (Set.range
    fun i : {i : Fin (tau R J (t R J)) // (i : ℕ) < tau R J b} =>
      AssocGraded.mk (maximalIdeal R) 1 (G.z (Fin.cast hr i.1)) (by
        rw [pow_one]; exact hM _))) (mu R J b)
  rw [hset]
  exact isTauSubmodule_span_castLE_of_forall_tauZ_eq_zero J g hg G.z G.z_injective
    G.extends_rsop hb1 hbt hbr (hz b hb1 hbt hbr)

end RegularTauFrameCriterion

section EndAux

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- `ν*` determines `μ*` and `t`. -/
theorem muSet_congr_of_nuStar_eq {R' : Type u} [CommRing R'] [IsRegularLocalRing R'] {J' : Ideal R'}
    {J : Ideal R} (h : nuStar R' J' = nuStar R J) : muSet R' J' = muSet R J := by
  have h' : ∀ i, nuI R' J' i = nuI R J i := fun i => congrFun (congrArg ofLex h) i
  ext μ
  exact ⟨fun ⟨i, hi⟩ => ⟨i, (h' i).symm.trans hi⟩, fun ⟨i, hi⟩ => ⟨i, (h' i).trans hi⟩⟩

theorem t_congr_of_nuStar_eq {R' : Type u} [CommRing R'] [IsRegularLocalRing R'] {J' : Ideal R'}
    {J : Ideal R} (h : nuStar R' J' = nuStar R J) : t R' J' = t R J := by
  unfold t
  rw [muSet_congr_of_nuStar_eq h]

theorem mu_congr_of_nuStar_eq {R' : Type u} [CommRing R'] [IsRegularLocalRing R'] {J' : Ideal R'}
    {J : Ideal R} (h : nuStar R' J' = nuStar R J) (a : ℕ) : mu R' J' a = mu R J a := by
  unfold mu
  rw [muSet_congr_of_nuStar_eq h]

/-- If `J` has a standard base with no member, `τ^{(a)}(J) = 0` (then `gr_M(J, R) = 0`). -/
theorem tau_eq_zero_of_isStandardBase_nil {J : Ideal R} (g : Fin 0 → R) (hg : IsStandardBase R J g)
    (a : ℕ) : tau R J a = 0 := by
  obtain ⟨-, -, -, hspan, -⟩ := hg
  have hbot : grIdeal (maximalIdeal R) J = ⊥ := by
    rw [hspan]
    simp
  refine Nat.eq_zero_of_le_zero (Nat.sInf_le ⟨fun i => i.elim0, fun i => i.elim0, ?_⟩)
  have hrange : Set.range (fun i : Fin 0 => (i.elim0 : AssocGraded (maximalIdeal R))) = ∅ :=
    Set.range_eq_empty _
  rw [hrange, Submodule.span_empty]
  refine ⟨bot_le, fun μ hμ ψ hψ => ⟨fun hJ => ?_, fun hs => ?_⟩⟩
  · rw [hbot] at hJ
    rw [(Submodule.mem_bot _).mp hJ]
    exact zero_mem _
  · exact (Ideal.span_le.mpr fun x hx => hx.1) hs

/-- With no member in a standard base there are no integers in `ν*(J)`: `t(J) = 0`. -/
theorem t_eq_zero_of_isStandardBase_nil {J : Ideal R} (g : Fin 0 → R) (hg : IsStandardBase R J g) :
    t R J = 0 := by
  obtain ⟨-, htop⟩ := nuI_eq_of_hasLemma1Properties R J _ hg.2
  have : muSet R J = ∅ := by
    ext μ
    simp only [Set.mem_empty_iff_false, iff_false]
    rintro ⟨i, hi⟩
    rw [htop i (by simp)] at hi
    exact ENat.top_ne_natCast _ hi
  unfold t
  rw [this, Set.ncard_empty]

/-- A standard base with a member gives `t(J) ≥ 1`. -/
theorem one_le_t_of_isStandardBase {J : Ideal R} {m : ℕ} {g : Fin m → R}
    (hg : IsStandardBase R J g) (hm : 0 < m) : 1 ≤ t R J := by
  obtain ⟨μ, hμ, -⟩ := ordElem_mem_muSet J hg ⟨0, hm⟩
  exact (Set.ncard_pos (muSet_finite R J).1).mpr ⟨μ, hμ⟩

end EndAux

end Hironaka

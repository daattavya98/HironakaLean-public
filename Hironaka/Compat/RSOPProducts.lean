/-!
# Parts of regular systems of parameters

Commutative algebra behind the normal crossing property (Ch. 0 §5, Def. 2) and its behaviour
under monoidal transformations (Ch. I §1, Remark 1, p. 169): in a regular local ring, elements
`z₁, …, z_k` which can be extended to a regular system of parameters generate prime ideals
`(zᵢ)`, the intersection of the `(zᵢ)` is the principal ideal generated by their product, and the
minimal primes of that product are the `(zᵢ)`.

Deviation from the paper (gap filled): the paper uses these facts without comment ("E has only
normal crossings", "the ideal of each irreducible component … is generated by one of the zᵢ");
this module supplies them, together with the exchange lemma behind "and similarly for the
others" (p. 169).
-/

@[expose] public section

open IsLocalRing Classical

namespace Hironaka

universe u

/-! ### Regular systems of parameters as minimal systems of generators -/

section Helpers

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- A regular system of parameters is a minimal system of generators of the maximal ideal. -/
theorem rsop_card_eq_spanFinrank {Z : Finset R} (hZ : IsRegularSystemOfParameters R Z) :
    Z.card = (maximalIdeal R).spanFinrank := by
  have h1 := hZ.2
  rw [← IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)] at h1
  exact_mod_cast h1

/-- A finite generating set of the maximal ideal has at least `spanFinrank` members. -/
theorem rsop_spanFinrank_le_card {A : Type u} [CommRing A] [IsLocalRing A] {Z : Finset A}
    (hZ : Ideal.span (Z : Set A) = maximalIdeal A) : (maximalIdeal A).spanFinrank ≤ Z.card := by
  rw [← hZ, ← Set.ncard_coe_finset]
  exact Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet Z)

/-- A generating set of the maximal ideal with at most `spanFinrank` members is a regular
system of parameters. -/
theorem rsop_of_span_of_card_le {Z : Finset R} (hZ : Ideal.span (Z : Set R) = maximalIdeal R)
    (hcard : Z.card ≤ (maximalIdeal R).spanFinrank) : IsRegularSystemOfParameters R Z := by
  refine ⟨hZ, ?_⟩
  rw [← IsRegularLocalRing.spanFinrank_maximalIdeal (R := R),
    le_antisymm hcard (rsop_spanFinrank_le_card hZ)]

/-- A member `z` of a regular system of parameters `Z` is not in `(Z \ {z}) + M²`. -/
theorem rsop_notMem_span_erase_sup_sq [DecidableEq R] {Z : Finset R}
    (hZ : IsRegularSystemOfParameters R Z) {z : R} (hz : z ∈ Z) :
    z ∉ Ideal.span ((Z.erase z : Finset R) : Set R) ⊔ maximalIdeal R ^ 2 := by
  intro h
  have h1 := span_erase_eq_of_mem hZ.1 hz h
  have h2 := rsop_spanFinrank_le_card h1
  have h3 := Finset.card_erase_add_one hz
  have h4 := rsop_card_eq_spanFinrank hZ
  omega

/-- A member `a` of a regular system of parameters `Z` is not in `(T) + M²` for `T ⊆ Z \ {a}`. -/
theorem rsop_notMem_span_sup_sq {Z T : Finset R} (hZ : IsRegularSystemOfParameters R Z)
    (hTZ : T ⊆ Z) {a : R} (ha : a ∈ Z) (haT : a ∉ T) :
    a ∉ Ideal.span (T : Set R) ⊔ maximalIdeal R ^ 2 := by
  classical
  intro h
  have hle : Ideal.span (T : Set R) ⊔ maximalIdeal R ^ 2 ≤
      Ideal.span ((Z.erase a : Finset R) : Set R) ⊔ maximalIdeal R ^ 2 := by
    refine sup_le_sup_right (Ideal.span_mono fun y hy => ?_) _
    exact Finset.mem_erase.mpr ⟨fun h => haT (h ▸ Finset.mem_coe.mp hy), hTZ (Finset.mem_coe.mp hy)⟩
  exact rsop_notMem_span_erase_sup_sq hZ ha (hle h)

theorem rsop_notMem_span {Z T : Finset R} (hZ : IsRegularSystemOfParameters R Z)
    (hTZ : T ⊆ Z) {a : R} (ha : a ∈ Z) (haT : a ∉ T) : a ∉ Ideal.span (T : Set R) :=
  fun h => rsop_notMem_span_sup_sq hZ hTZ ha haT (Ideal.mem_sup_left h)

/-- The quotient by part `K` of a regular system of parameters `Z` is regular, and the images
of the members of `Z \ K` form a regular system of parameters of it, with no two identified. -/
theorem rsop_quotient {Z K : Finset R} (hZ : IsRegularSystemOfParameters R Z) (hKZ : K ⊆ Z) :
    ∃ _ : IsRegularLocalRing (R ⧸ Ideal.span (K : Set R)),
      IsRegularSystemOfParameters (R ⧸ Ideal.span (K : Set R))
        ((Z \ K).image (Ideal.Quotient.mk (Ideal.span (K : Set R)))) ∧
      ((Z \ K).image (Ideal.Quotient.mk (Ideal.span (K : Set R)))).card = (Z \ K).card := by
  classical
  set I := Ideal.span (K : Set R) with hIdef
  set mk := Ideal.Quotient.mk I
  have hZM : ∀ z ∈ Z, z ∈ maximalIdeal R := fun z hz => hZ.1 ▸ Ideal.subset_span hz
  have hIM : I ≤ maximalIdeal R := Ideal.span_le.mpr fun k hk => hZM k (hKZ hk)
  have := isLocalRing_quotient_of_le hIM
  have hM : Ideal.span (((Z \ K).image mk : Finset _) : Set (R ⧸ I)) =
      maximalIdeal (R ⧸ I) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective, ← hZ.1,
      Ideal.map_span, Finset.coe_image]
    refine le_antisymm (Ideal.span_mono (Set.image_mono (by simp))) (Ideal.span_le.mpr ?_)
    rintro _ ⟨z, hz, rfl⟩
    by_cases hzK : z ∈ K
    · rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hzK)]
      exact zero_mem _
    · exact Ideal.subset_span ⟨z, by simp [hz, hzK], rfl⟩
  -- numerics
  have hn := rsop_card_eq_spanFinrank hZ
  have hsd := Finset.card_sdiff_add_card_eq_card hKZ
  have h1 : (maximalIdeal (R ⧸ I)).spanFinrank ≤ ((Z \ K).image mk).card :=
    rsop_spanFinrank_le_card hM
  have h2 : ((Z \ K).image mk).card ≤ (Z \ K).card := Finset.card_image_le
  have hdimQ : ringKrullDim (R ⧸ I) ≤ (maximalIdeal (R ⧸ I)).spanFinrank :=
    ringKrullDim_le_spanFinrank_maximalIdeal _
  obtain ⟨k, hkm, hk⟩ := exists_nat_ringKrullDim_eq hdimQ
  have hdim := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I
    (by rw [ringJacobson_eq_maximalIdeal R]; exact hIM)
  have hIs : I.spanFinrank ≤ K.card := by
    have := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) (Finset.finite_toSet K)
    rwa [Set.ncard_coe_finset] at this
  rw [← IsRegularLocalRing.spanFinrank_maximalIdeal (R := R), hk, ← hn] at hdim
  have h3 : Z.card ≤ k + I.spanFinrank := by exact_mod_cast hdim
  have hreg : IsRegularLocalRing (R ⧸ I) := by
    refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
    rw [hk]
    exact_mod_cast (by omega : (maximalIdeal (R ⧸ I)).spanFinrank ≤ k)
  refine ⟨hreg, ⟨hM, ?_⟩, by omega⟩
  rw [hk]
  exact_mod_cast (by omega : ((Z \ K).image mk).card = k)

/-- Lifting: if `mk a ∈ (mk '' V)` in `A/(y)`, then `a ∈ (y, V)`. -/
theorem rsop_mem_span_insert_of_mk_mem {A : Type u} [CommRing A] {y a : A} {V : Finset A}
    (ha : Ideal.Quotient.mk (Ideal.span {y}) a ∈
      Ideal.span ((V.image (Ideal.Quotient.mk (Ideal.span {y})) : Finset _) : Set (A ⧸ _))) :
    a ∈ Ideal.span (insert y (V : Set A)) := by
  classical
  rw [Finset.coe_image, ← Ideal.map_span,
    Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at ha
  obtain ⟨b, hb, hba⟩ := ha
  rw [Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hba
  obtain ⟨c, hc⟩ := hba
  rw [Ideal.span_insert]
  have : a = b - c * y := by rw [hc]; ring
  rw [this]
  exact sub_mem (Ideal.mem_sup_right hb)
    (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self y)))

/-- The one-element-at-a-time criterion: if `y ≠ 0` lies in the maximal ideal of the regular
local ring `A` and the images of the members of `V` generate the maximal ideal of `A/(y)`, with
`#V ≤ dim A/(y)`, then `{y} ∪ V` is a regular system of parameters of `A`. -/
theorem rsop_insert_of_quotient {A : Type u} [CommRing A] [IsRegularLocalRing A] {y : A}
    (hy : y ∈ maximalIdeal A) (hy0 : y ≠ 0) [IsLocalRing (A ⧸ Ideal.span {y})] {V : Finset A}
    (hV : Ideal.span ((V.image (Ideal.Quotient.mk (Ideal.span {y})) : Finset _) : Set (A ⧸ _)) =
      maximalIdeal (A ⧸ Ideal.span {y}))
    (hVcard : (V.card : WithBot ℕ∞) ≤ ringKrullDim (A ⧸ Ideal.span {y})) :
    IsRegularSystemOfParameters A (insert y V) := by
  classical
  have := isDomain_of_isRegularLocalRing A
  have hspan : Ideal.span ((insert y V : Finset A) : Set A) = maximalIdeal A := by
    refine le_antisymm (Ideal.span_le.mpr ?_) fun a ha => ?_
    · rw [Finset.coe_insert]
      refine Set.insert_subset hy fun v hv => ?_
      have hv' : Ideal.Quotient.mk (Ideal.span {y}) v ∈ maximalIdeal (A ⧸ Ideal.span {y}) :=
        hV ▸ Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hv))
      exact (IsLocalRing.mem_maximalIdeal _).mpr fun hu =>
        (IsLocalRing.mem_maximalIdeal _).mp hv' (hu.map _)
    · rw [Finset.coe_insert]
      refine rsop_mem_span_insert_of_mk_mem ?_
      rw [hV]
      have : IsLocalHom (Ideal.Quotient.mk (Ideal.span {y})) :=
        IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
      exact map_nonunit _ a ha
  have h2 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor (mem_nonZeroDivisors_of_ne_zero hy0)
  have h3 : ((V.card + 1 : ℕ) : WithBot ℕ∞) ≤ ((maximalIdeal A).spanFinrank : WithBot ℕ∞) := by
    rw [IsRegularLocalRing.spanFinrank_maximalIdeal]
    push_cast
    exact (add_le_add hVcard le_rfl).trans h2
  have h4 : V.card + 1 ≤ (maximalIdeal A).spanFinrank := by exact_mod_cast h3
  exact rsop_of_span_of_card_le hspan ((Finset.card_insert_le _ _).trans h4)

/-- Lifting along `A → A/J`: if the class of `a` lies in the ideal generated by the classes of
the members of `V`, then `a ∈ (V) + J`. -/
theorem rsop_mem_span_sup_of_mk_mem {A : Type u} [CommRing A] {J : Ideal A} {a : A}
    {V : Finset A}
    (ha : Ideal.Quotient.mk J a ∈
      Ideal.span ((V.image (Ideal.Quotient.mk J) : Finset _) : Set (A ⧸ J))) :
    a ∈ Ideal.span (V : Set A) ⊔ J := by
  classical
  rw [Finset.coe_image, ← Ideal.map_span,
    Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at ha
  obtain ⟨b, hb, hba⟩ := ha
  rw [Ideal.Quotient.eq] at hba
  have : a = b - (b - a) := by ring
  rw [this]
  exact sub_mem (Ideal.mem_sup_left hb) (Ideal.mem_sup_right hba)

/-- The one-element-at-a-time criterion, for parts of regular systems of parameters: if `y ≠ 0`
lies in the maximal ideal of the regular local ring `A`, and the classes of the members of `V`
are distinct and form part of a regular system of parameters of `A/(y)`, then `{y} ∪ V` is part
of a regular system of parameters of `A`. -/
theorem rsop_extends_insert_of_quotient {A : Type u} [CommRing A] [IsRegularLocalRing A] {y : A}
    (hy : y ∈ maximalIdeal A) (hy0 : y ≠ 0) [IsLocalRing (A ⧸ Ideal.span {y})] {V : Finset A}
    (hV : ExtendsToRSOP (A ⧸ Ideal.span {y}) (V.image (Ideal.Quotient.mk (Ideal.span {y}))))
    (hinj : Set.InjOn (Ideal.Quotient.mk (Ideal.span {y})) V) :
    ExtendsToRSOP A (insert y V) := by
  classical
  obtain ⟨W, hVW, hW⟩ := hV
  set mk := Ideal.Quotient.mk (Ideal.span {y}) with hmk
  set σ := Function.surjInv (Ideal.Quotient.mk_surjective (I := Ideal.span {y}))
  have hσ : mk ∘ σ = id := funext (Function.surjInv_eq _)
  obtain ⟨V', hV'⟩ : ∃ V' : Finset A, V' = V ∪ (W \ V.image mk).image σ := ⟨_, rfl⟩
  have hV'W : V'.image mk = W := by
    rw [hV', Finset.image_union, Finset.image_image, hσ, Finset.image_id,
      Finset.union_sdiff_of_subset hVW]
  have h1 : V'.card ≤ W.card := by
    have a1 : V'.card ≤ V.card + (W \ V.image mk).card := by
      rw [hV']
      exact (Finset.card_union_le _ _).trans (Nat.add_le_add_left Finset.card_image_le _)
    have a3 : (W \ V.image mk).card + (V.image mk).card = W.card :=
      Finset.card_sdiff_add_card_eq_card hVW
    have a4 : (V.image mk).card = V.card := Finset.card_image_of_injOn hinj
    omega
  have hrsop := rsop_insert_of_quotient hy hy0 (V := V') (by rw [hV'W]; exact hW.1)
    (by rw [← hW.2]; exact_mod_cast h1)
  exact ⟨insert y V', Finset.insert_subset_insert _ (by rw [hV']; exact Finset.subset_union_left), hrsop⟩

/-- A part `K` of the maximal ideal of a regular local ring `A` with `A/(K)` regular and
`dim A/(K) + #K ≤ dim A` is part of a regular system of parameters. -/
theorem rsop_extends_of_quotient_regular {A : Type u} [CommRing A] [IsRegularLocalRing A]
    {K : Finset A} (hK : ∀ k ∈ K, k ∈ maximalIdeal A)
    [IsRegularLocalRing (A ⧸ Ideal.span (K : Set A))]
    (hdim : ringKrullDim (A ⧸ Ideal.span (K : Set A)) + (K.card : WithBot ℕ∞) ≤
      ringKrullDim A) :
    ExtendsToRSOP A K := by
  classical
  set J := Ideal.span (K : Set A) with hJ
  obtain ⟨-, W, hW⟩ := (isRegularLocalRing_iff_exists_rsop (A ⧸ J)).mp inferInstance
  set σ := Function.surjInv (Ideal.Quotient.mk_surjective (I := J))
  have hσ : Ideal.Quotient.mk J ∘ σ = id := funext (Function.surjInv_eq _)
  have hspan : Ideal.span ((K ∪ W.image σ : Finset A) : Set A) = maximalIdeal A := by
    refine le_antisymm (Ideal.span_le.mpr ?_) fun a ha => ?_
    · intro b hb
      rcases Finset.mem_union.mp (Finset.mem_coe.mp hb) with hb | hb
      · exact hK b hb
      · obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hb
        have hwM : w ∈ maximalIdeal (A ⧸ J) := hW.1 ▸ Ideal.subset_span hw
        rw [← Function.surjInv_eq (Ideal.Quotient.mk_surjective (I := J)) w] at hwM
        exact (IsLocalRing.mem_maximalIdeal _).mpr fun hu =>
          (IsLocalRing.mem_maximalIdeal _).mp hwM (hu.map _)
    · have hmk : Ideal.Quotient.mk J a ∈ Ideal.span
          (((W.image σ).image (Ideal.Quotient.mk J) : Finset _) : Set (A ⧸ J)) := by
        rw [Finset.image_image, hσ, Finset.image_id, hW.1]
        have : IsLocalHom (Ideal.Quotient.mk J) :=
          IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
        exact map_nonunit _ a ha
      have := rsop_mem_span_sup_of_mk_mem hmk
      rw [Finset.coe_union, Ideal.span_union, sup_comm]
      exact this
  have h1 : ((W.card + K.card : ℕ) : WithBot ℕ∞) ≤
      ((maximalIdeal A).spanFinrank : WithBot ℕ∞) := by
    rw [IsRegularLocalRing.spanFinrank_maximalIdeal]
    push_cast
    rw [hW.2]
    exact hdim
  have h2 : W.card + K.card ≤ (maximalIdeal A).spanFinrank := by exact_mod_cast h1
  have h3 := Finset.card_union_le K (W.image σ)
  have h4 := Finset.card_image_le (s := W) (f := σ)
  exact ⟨K ∪ W.image σ, Finset.subset_union_left, rsop_of_span_of_card_le hspan (by omega)⟩

end Helpers

namespace ExtendsToRSOP

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {K L : Finset R}

/-- A regular system of parameters extends to itself. -/
theorem of_isRegularSystemOfParameters {Z : Finset R} (hZ : IsRegularSystemOfParameters R Z) :
    ExtendsToRSOP R Z :=
  ⟨Z, subset_rfl, hZ⟩

theorem mono (h : ExtendsToRSOP R L) (hKL : K ⊆ L) : ExtendsToRSOP R K := by
  obtain ⟨Z, hLZ, hZ⟩ := h
  exact ⟨Z, hKL.trans hLZ, hZ⟩

theorem mem_maximalIdeal (h : ExtendsToRSOP R K) {k : R} (hk : k ∈ K) : k ∈ maximalIdeal R := by
  obtain ⟨Z, hKZ, hZ⟩ := h
  exact hZ.1 ▸ Ideal.subset_span (hKZ hk)

theorem notMem_maximalIdeal_sq (h : ExtendsToRSOP R K) {k : R} (hk : k ∈ K) :
    k ∉ maximalIdeal R ^ 2 := by
  classical
  obtain ⟨Z, hKZ, hZ⟩ := h
  exact fun h2 => rsop_notMem_span_erase_sup_sq hZ (hKZ hk) (Ideal.mem_sup_right h2)

theorem ne_zero (h : ExtendsToRSOP R K) {k : R} (hk : k ∈ K) : k ≠ 0 := by
  intro h0
  exact h.notMem_maximalIdeal_sq hk (by rw [h0]; exact zero_mem _)

/-- The ideal generated by part of a regular system of parameters is prime. -/
theorem isPrime_span (h : ExtendsToRSOP R K) : (Ideal.span (K : Set R)).IsPrime := by
  obtain ⟨Z, hKZ, hZ⟩ := h
  obtain ⟨_, -⟩ := rsop_quotient hZ hKZ
  have := isDomain_of_isRegularLocalRing (R ⧸ Ideal.span (K : Set R))
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- ... and the quotient by it is regular. -/
theorem isRegularLocalRing_quotient (h : ExtendsToRSOP R K) :
    IsRegularLocalRing (R ⧸ Ideal.span (K : Set R)) := by
  obtain ⟨Z, hKZ, hZ⟩ := h
  obtain ⟨h', -⟩ := rsop_quotient hZ hKZ
  exact h'

theorem isPrime_span_singleton (h : ExtendsToRSOP R K) {k : R} (hk : k ∈ K) :
    (Ideal.span {k}).IsPrime := by
  have := (h.mono (Finset.singleton_subset_iff.mpr hk)).isPrime_span
  rwa [Finset.coe_singleton] at this

theorem isRegularLocalRing_quotient_span_singleton (h : ExtendsToRSOP R K) {k : R}
    (hk : k ∈ K) : IsRegularLocalRing (R ⧸ Ideal.span {k}) := by
  have := (h.mono (Finset.singleton_subset_iff.mpr hk)).isRegularLocalRing_quotient
  rwa [Finset.coe_singleton] at this

/-- Distinct members of a part of a regular system of parameters generate distinct ideals. -/
theorem span_singleton_injOn (h : ExtendsToRSOP R K) :
    Set.InjOn (fun k : R => Ideal.span {k}) (K : Set R) := by
  intro a ha b hb hab
  by_contra hne
  obtain ⟨Z, hKZ, hZ⟩ := h
  have hb' : b ∈ Ideal.span (({a} : Finset R) : Set R) := by
    rw [Finset.coe_singleton, show Ideal.span {a} = Ideal.span {b} from hab]
    exact Ideal.mem_span_singleton_self b
  exact rsop_notMem_span hZ (Finset.singleton_subset_iff.mpr (hKZ ha)) (hKZ hb)
    (by simpa [eq_comm] using hne) hb'

/-- Distinct members: `b ∉ (a)`. -/
theorem notMem_span_singleton (h : ExtendsToRSOP R K) {a b : R} (ha : a ∈ K) (hb : b ∈ K)
    (hab : a ≠ b) : b ∉ Ideal.span {a} := by
  obtain ⟨Z, hKZ, hZ⟩ := h
  have := rsop_notMem_span hZ (Finset.singleton_subset_iff.mpr (hKZ ha)) (hKZ hb)
    (T := {a}) (by simpa [eq_comm] using hab)
  rwa [Finset.coe_singleton] at this

/-- The product of the members of `K` other than `a` is not in `(a)`. -/
theorem prod_erase_notMem_span_singleton (h : ExtendsToRSOP R K) {a : R} (ha : a ∈ K) :
    ∏ k ∈ K.erase a, k ∉ Ideal.span {a} := by
  classical
  have := h.isPrime_span_singleton ha
  intro hmem
  obtain ⟨b, hb, hbmem⟩ := (Ideal.IsPrime.prod_mem_iff (x := fun k : R => k)).mp hmem
  exact h.notMem_span_singleton ha (Finset.mem_of_mem_erase hb)
    (Finset.ne_of_mem_erase hb).symm hbmem

/-- The intersection of the `(k)`, `k ∈ K`, is generated by the product of the `k`. -/
theorem iInf_span_singleton (h : ExtendsToRSOP R K) :
    ⨅ k ∈ K, Ideal.span {k} = Ideal.span {∏ k ∈ K, k} := by
  classical
  induction K using Finset.induction_on with
  | empty => simp
  | insert a K haK ih =>
    rw [Finset.iInf_insert, ih (h.mono (Finset.subset_insert a K)), Finset.prod_insert haK]
    refine le_antisymm (fun x hx => ?_) (le_inf ?_ ?_)
    · obtain ⟨hxa, hxK⟩ := Submodule.mem_inf.mp hx
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hxK
      have := h.isPrime_span_singleton (Finset.mem_insert_self a K)
      have hK : ∏ k ∈ K, k ∉ Ideal.span {a} := by
        have := h.prod_erase_notMem_span_singleton (Finset.mem_insert_self a K)
        rwa [Finset.erase_insert haK] at this
      obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp
        ((Ideal.IsPrime.mem_or_mem ‹_› hxa).resolve_right hK)
      exact Ideal.mem_span_singleton'.mpr ⟨d, by ring⟩
    · exact Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_right _ _)
    · exact Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_left _ _)

theorem span_prod_inf (h : ExtendsToRSOP R (K ∪ L)) :
    Ideal.span {∏ k ∈ K, k} ⊓ Ideal.span {∏ k ∈ L, k} = Ideal.span {∏ k ∈ K ∪ L, k} := by
  classical
  rw [← iInf_span_singleton h, ← iInf_span_singleton (h.mono Finset.subset_union_left),
    ← iInf_span_singleton (h.mono Finset.subset_union_right), Finset.iInf_union]

/-- The minimal primes of `(∏ K)` are the `(k)`, `k ∈ K`. -/
theorem minimalPrimes_span_prod (h : ExtendsToRSOP R K) :
    (Ideal.span {∏ k ∈ K, k}).minimalPrimes = (fun k : R => Ideal.span {k}) '' (K : Set R) := by
  classical
  have hle : ∀ k ∈ K, Ideal.span {∏ k ∈ K, k} ≤ Ideal.span {k} := fun k hk =>
    Ideal.span_singleton_le_span_singleton.mpr (Finset.dvd_prod_of_mem _ hk)
  -- a prime containing `∏ K` contains some `k ∈ K`
  have hex : ∀ Q : Ideal R, Q.IsPrime → Ideal.span {∏ k ∈ K, k} ≤ Q → ∃ k ∈ K, k ∈ Q := by
    intro Q hQ hle
    exact (Ideal.IsPrime.prod_mem_iff (x := fun k : R => k)).mp
      (hle (Ideal.mem_span_singleton_self _))
  ext Q
  constructor
  · intro hQ
    obtain ⟨k, hk, hkQ⟩ := hex Q hQ.1.1 hQ.1.2
    have hkQ' : Ideal.span {k} ≤ Q := (Ideal.span_singleton_le_iff_mem _).mpr hkQ
    exact ⟨k, hk, le_antisymm hkQ' (hQ.2 ⟨h.isPrime_span_singleton hk, hle k hk⟩ hkQ')⟩
  · rintro ⟨k, hk, rfl⟩
    refine ⟨⟨h.isPrime_span_singleton hk, hle k hk⟩, fun Q hQ hQk => ?_⟩
    obtain ⟨k', hk', hk'Q⟩ := hex Q hQ.1 hQ.2
    have hkk' : k = k' := by
      by_contra hne
      exact h.notMem_span_singleton hk hk' hne (hQk hk'Q)
    subst hkk'
    exact (Ideal.span_singleton_le_iff_mem _).mpr hk'Q

theorem isRadical_span_prod (h : ExtendsToRSOP R K) : (Ideal.span {∏ k ∈ K, k}).IsRadical := by
  intro x hx
  rw [← iInf_span_singleton h]
  refine Submodule.mem_iInf _ |>.mpr fun k => Submodule.mem_iInf _ |>.mpr fun hk => ?_
  have := h.isPrime_span_singleton hk
  have hle : Ideal.span {∏ k ∈ K, k} ≤ Ideal.span {k} :=
    Ideal.span_singleton_le_span_singleton.mpr (Finset.dvd_prod_of_mem _ hk)
  exact (Ideal.IsPrime.radical ‹_›) ▸ Ideal.radical_mono hle hx

theorem height_span_prod (h : ExtendsToRSOP R K) (hK : K.Nonempty) :
    (Ideal.span {∏ k ∈ K, k}).height = 1 := by
  classical
  have := isDomain_of_isRegularLocalRing R
  obtain ⟨a, ha⟩ := hK
  refine Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero (Finset.prod_ne_zero_iff.mpr fun k hk => h.ne_zero hk)) ?_
  rw [← Finset.mul_prod_erase K (fun k => k) ha]
  exact (IsLocalRing.mem_maximalIdeal _).mp
    (Ideal.mul_mem_right _ _ (h.mem_maximalIdeal ha))

/-- Transport along a ring isomorphism. -/
theorem map_ringEquiv {S : Type u} [CommRing S] [IsRegularLocalRing S] (e : R ≃+* S)
    (h : ExtendsToRSOP R K) : ExtendsToRSOP S (K.image e) := by
  classical
  obtain ⟨Z, hKZ, hZ⟩ := h
  refine ⟨Z.image e, Finset.image_subset_image hKZ, ?_, ?_⟩
  · rw [Finset.coe_image, ← Ideal.map_span, hZ.1]
    exact map_ringEquiv_maximalIdeal e
  · rw [Finset.card_image_of_injective _ e.injective, hZ.2]
    exact ringKrullDim_eq_of_ringEquiv e

/-- Replacing the members by associated elements. -/
theorem image_of_associated (h : ExtendsToRSOP R K) (g : R → R) (hg : Set.InjOn g (K : Set R))
    (hassoc : ∀ k ∈ K, Associated k (g k)) : ExtendsToRSOP R (K.image g) := by
  classical
  -- (the injectivity of `g` is not needed)
  have _ := hg
  obtain ⟨Z, hKZ, hZ⟩ := h
  refine ⟨(Z \ K) ∪ K.image g, Finset.subset_union_right, rsop_of_span_of_card_le ?_ ?_⟩
  · refine le_antisymm (Ideal.span_le.mpr fun a ha => ?_) ?_
    · rcases Finset.mem_union.mp (Finset.mem_coe.mp ha) with ha | ha
      · exact hZ.1 ▸ Ideal.subset_span (Finset.mem_sdiff.mp ha).1
      · obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp ha
        obtain ⟨u, hu⟩ := hassoc k hk
        rw [← hu]
        exact Ideal.mul_mem_right _ _ (hZ.1 ▸ Ideal.subset_span (hKZ hk))
    · rw [← hZ.1, Ideal.span_le]
      intro z hz
      by_cases hzK : z ∈ K
      · obtain ⟨u, hu⟩ := hassoc z hzK
        have : z = g z * ↑u⁻¹ := by rw [← hu, mul_assoc, Units.mul_inv, mul_one]
        rw [SetLike.mem_coe, this]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Finset.mem_coe.mpr
          (Finset.mem_union_right _ (Finset.mem_image_of_mem g hzK))))
      · exact Ideal.subset_span (by simp [hz, hzK])
  · have h1 := Finset.card_union_le (Z \ K) (K.image g)
    have h2 := Finset.card_image_le (s := K) (f := g)
    have h3 := Finset.card_sdiff_add_card_eq_card hKZ
    have h4 := rsop_card_eq_spanFinrank hZ
    omega

/-- The exchange step behind "and similarly for the others" (p. 169): let `Z` be a regular
system of parameters, `J, T ⊆ Z`, and `f ∈ (T)` such that `J ∪ {f}` can be extended to a
regular system of parameters (`f ∉ J`).  Then there is a regular system of parameters
containing `J` and `f` of which a subset generates `(T)`.

Deviation from the paper (gap filled): the paper does not say how to obtain a regular system of
parameters adapted at once to `E`, `F` and `B`; this lemma provides it. -/
theorem exchange {Z J T : Finset R} (hZ : IsRegularSystemOfParameters R Z) (hJZ : J ⊆ Z)
    (hTZ : T ⊆ Z) {f : R} (hf : f ∈ Ideal.span (T : Set R)) (hfJ : f ∉ J)
    (hJf : ExtendsToRSOP R (insert f J)) :
    ∃ Z' T' : Finset R, IsRegularSystemOfParameters R Z' ∧ J ⊆ Z' ∧ f ∈ Z' ∧ T' ⊆ Z' ∧
      Ideal.span (T' : Set R) = Ideal.span (T : Set R) := by
  classical
  have hZM : ∀ z ∈ Z, z ∈ maximalIdeal R := fun z hz => hZ.1 ▸ Ideal.subset_span hz
  obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp (hf : f ∈ Submodule.span R (T : Set R))
  -- some coefficient `c i`, `i ∈ T \ J`, is a unit
  obtain ⟨i, hiT, hiJ, hci⟩ : ∃ i ∈ T, i ∉ J ∧ c i ∉ maximalIdeal R := by
    by_contra hcon
    push Not at hcon
    obtain ⟨W, hJW, hW⟩ := hJf
    have hfW : f ∈ W := hJW (Finset.mem_insert_self f J)
    refine rsop_notMem_span_sup_sq hW (T := J) (fun j hj => hJW (Finset.mem_insert_of_mem hj))
      hfW hfJ ?_
    rw [← hc]
    refine Ideal.sum_mem _ fun t ht => ?_
    by_cases htJ : t ∈ J
    · exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span htJ))
    · refine Ideal.mem_sup_right ?_
      rw [smul_eq_mul, pow_two]
      exact Ideal.mul_mem_mul (hcon t ht htJ) (hZM t (hTZ ht))
  have hu : IsUnit (c i) := (IsLocalRing.mem_maximalIdeal _).not.mp hci |> not_not.mp
  obtain ⟨v, hv⟩ := hu.exists_left_inv
  have hsplit : c i * i = f - ∑ a ∈ T.erase i, c a • a := by
    rw [← hc, ← Finset.add_sum_erase T _ hiT, smul_eq_mul]
    ring
  have himem : i ∈ Ideal.span ((insert f (T.erase i) : Finset R) : Set R) := by
    have : i = v * (f - ∑ a ∈ T.erase i, c a • a) := by
      rw [← hsplit, ← mul_assoc, hv, one_mul]
    have key : v * (f - ∑ a ∈ T.erase i, c a • a) ∈
        Ideal.span ((insert f (T.erase i) : Finset R) : Set R) := by
      refine Ideal.mul_mem_left _ _ (sub_mem (Ideal.subset_span (by simp))
        (Ideal.sum_mem _ fun a ha => Ideal.mul_mem_left _ _ (Ideal.subset_span ?_)))
      exact Finset.mem_coe.mpr (Finset.mem_insert_of_mem ha)
    rwa [← this] at key
  have hT'T : Ideal.span ((insert f (T.erase i) : Finset R) : Set R) = Ideal.span (T : Set R) := by
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr fun t ht => ?_)
    · rw [Finset.coe_insert]
      exact Set.insert_subset hf fun a ha =>
        Ideal.subset_span (Finset.mem_of_mem_erase (Finset.mem_coe.mp ha))
    · by_cases hti : t = i
      · exact hti ▸ himem
      · exact Ideal.subset_span (by simp [hti, Finset.mem_coe.mp ht])
  have hfM : f ∈ maximalIdeal R :=
    (Ideal.span_le.mpr fun t ht => hZM t (hTZ (Finset.mem_coe.mp ht))) hf
  have hZ'span : Ideal.span ((insert f (Z.erase i) : Finset R) : Set R) = maximalIdeal R := by
    refine le_antisymm (Ideal.span_le.mpr ?_) ?_
    · rw [Finset.coe_insert]
      exact Set.insert_subset hfM fun a ha => hZM a (Finset.mem_of_mem_erase (Finset.mem_coe.mp ha))
    · rw [← hZ.1, Ideal.span_le]
      intro z hz
      by_cases hzi : z = i
      · subst hzi
        refine Ideal.span_mono ?_ himem
        intro a ha
        simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe, Finset.mem_erase] at ha ⊢
        rcases ha with ha | ⟨ha1, ha2⟩
        · exact Or.inl ha
        · exact Or.inr ⟨ha1, hTZ ha2⟩
      · exact Ideal.subset_span (by simp [hzi, Finset.mem_coe.mp hz])
  refine ⟨insert f (Z.erase i), insert f (T.erase i), rsop_of_span_of_card_le hZ'span ?_, ?_,
    Finset.mem_insert_self _ _, Finset.insert_subset_insert _ (Finset.erase_subset_erase _ hTZ),
    hT'T⟩
  · have h1 := Finset.card_insert_le f (Z.erase i)
    have h2 := Finset.card_erase_add_one (hTZ hiT)
    have h3 := rsop_card_eq_spanFinrank hZ
    omega
  · intro j hj
    exact Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨fun h => hiJ (h ▸ hj), hJZ hj⟩)

end ExtendsToRSOP

/-- If `y ≠ 0` lies in the maximal ideal of the regular local ring `A` and `A/(y)` is regular,
then `y ∉ M²` (`y` together with lifts of a regular system of parameters of `A/(y)` is a
regular system of parameters of `A`). -/
theorem rsop_notMem_sq_of_quotient {A : Type u} [CommRing A] [IsRegularLocalRing A] {y : A}
    (hy : y ∈ maximalIdeal A) (hy0 : y ≠ 0) [IsRegularLocalRing (A ⧸ Ideal.span {y})] :
    y ∉ maximalIdeal A ^ 2 := by
  classical
  obtain ⟨-, W, hW⟩ :=
    (isRegularLocalRing_iff_exists_rsop (A ⧸ Ideal.span {y})).mp inferInstance
  have h := rsop_extends_insert_of_quotient hy hy0 (V := ∅)
    (by rw [Finset.image_empty]; exact ⟨W, Finset.empty_subset _, hW⟩) (by simp)
  exact h.notMem_maximalIdeal_sq (Finset.mem_insert_self y ∅)

/-! ### Independent families

A family `(v z)_{z ∈ F}` in a local ring is *independent* if every member lies in the maximal
ideal `M` and none lies in the ideal generated by the others plus `M²` (i.e. the classes in
`M/M²` are linearly independent).  In a regular local ring these are exactly the injective
families whose members form part of a regular system of parameters
(`RSOPIndep.injOn_and_extends`, `RSOPIndep.of_extends`). -/

/-- Independence of a family modulo `M²`. -/
def RSOPIndep {A : Type u} {ι : Type*} [CommRing A] [IsLocalRing A] (F : Finset ι) (v : ι → A) :
    Prop :=
  ∀ z ∈ F, v z ∈ maximalIdeal A ∧
    v z ∉ Ideal.span (v '' ((F : Set ι) \ {z})) ⊔ maximalIdeal A ^ 2

namespace RSOPIndep

variable {ι : Type*}

theorem injOn {A : Type u} [CommRing A] [IsLocalRing A] {F : Finset ι} {v : ι → A}
    (h : RSOPIndep F v) : Set.InjOn v F := by
  intro z₁ h₁ z₂ h₂ heq
  by_contra hne
  exact (h z₁ h₁).2 (Ideal.mem_sup_left (Ideal.subset_span
    ⟨z₂, ⟨h₂, fun h => hne (Set.mem_singleton_iff.mp h).symm⟩, heq.symm⟩))

theorem injOn_and_extends_of_card_eq (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] (F : Finset ι) (v : ι → A),
      F.card = n → RSOPIndep F v → ExtendsToRSOP A (F.image v) := by
  classical
  induction n with
  | zero =>
    intro A _ _ F v hF _
    rw [Finset.card_eq_zero.mp hF, Finset.image_empty]
    obtain ⟨-, W, hW⟩ := (isRegularLocalRing_iff_exists_rsop A).mp inferInstance
    exact ⟨W, Finset.empty_subset _, hW⟩
  | succ n ih =>
    intro A _ _ F v hF h
    obtain ⟨z₀, hz₀⟩ : F.Nonempty := Finset.card_pos.mp (by omega)
    set y := v z₀ with hydef
    obtain ⟨hyM, hyn⟩ := h z₀ hz₀
    have hy2 : y ∉ maximalIdeal A ^ 2 := fun h2 => hyn (Ideal.mem_sup_right h2)
    have hy0 : y ≠ 0 := fun h0 => hy2 (by rw [h0]; exact zero_mem _)
    have := isLocalRing_quotient_of_le ((Ideal.span_singleton_le_iff_mem _).mpr hyM)
    obtain ⟨hreg, -⟩ := quotient_span_singleton_regular hyM hy2
    set mk := Ideal.Quotient.mk (Ideal.span {y}) with hmk
    have hlocal : IsLocalHom mk := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    -- the classes of the others are independent in `A/(y)`
    have hind : RSOPIndep (F.erase z₀) (fun z => mk (v z)) := by
      intro z hz
      obtain ⟨hzz₀, hzF⟩ := Finset.mem_erase.mp hz
      obtain ⟨hzM, hzn⟩ := h z hzF
      refine ⟨map_nonunit mk _ hzM, fun hmem => hzn ?_⟩
      have hmap : Ideal.span ((fun z => mk (v z)) '' (((F.erase z₀ : Finset ι) : Set ι) \ {z})) ⊔
          maximalIdeal (A ⧸ Ideal.span {y}) ^ 2 =
          (Ideal.span (v '' (((F.erase z₀ : Finset ι) : Set ι) \ {z})) ⊔
            maximalIdeal A ^ 2).map mk := by
        rw [Ideal.map_sup, Ideal.map_span, Ideal.map_pow,
          IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective,
          ← Set.image_comp]
        rfl
      rw [hmap, ← Ideal.mem_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at hmem
      refine (sup_le (sup_le_sup_right (Ideal.span_mono (Set.image_mono ?_)) _) ?_ :
        Ideal.span (v '' (((F.erase z₀ : Finset ι) : Set ι) \ {z})) ⊔ maximalIdeal A ^ 2 ⊔
          Ideal.span {y} ≤ _) hmem
      · intro a ha
        exact ⟨Finset.mem_of_mem_erase ha.1, ha.2⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_sup_left (Ideal.subset_span ⟨z₀, ⟨hz₀, fun h => hzz₀
          (Set.mem_singleton_iff.mp h).symm⟩, rfl⟩)
    have hcard : (F.erase z₀).card = n := by
      rw [Finset.card_erase_of_mem hz₀]
      omega
    have hext := ih (A ⧸ Ideal.span {y}) (F.erase z₀) (fun z => mk (v z)) hcard hind
    have hinj := hind.injOn
    have hV : ExtendsToRSOP (A ⧸ Ideal.span {y}) (((F.erase z₀).image v).image mk) := by
      rw [Finset.image_image]
      exact hext
    have hinjV : Set.InjOn mk ((F.erase z₀).image v : Set A) := by
      intro a ha b hb hab
      obtain ⟨z₁, hz₁, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp ha)
      obtain ⟨z₂, hz₂, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hb)
      rw [hinj (Finset.mem_coe.mpr hz₁) (Finset.mem_coe.mpr hz₂) hab]
    have := rsop_extends_insert_of_quotient hyM hy0 hV hinjV
    rwa [← Finset.image_insert, Finset.insert_erase hz₀] at this

/-- An independent family in a regular local ring is injective and its members form part of a
regular system of parameters. -/
theorem injOn_and_extends {A : Type u} [CommRing A] [IsRegularLocalRing A] {F : Finset ι}
    {v : ι → A} (h : RSOPIndep F v) : Set.InjOn v F ∧ ExtendsToRSOP A (F.image v) :=
  ⟨h.injOn, injOn_and_extends_of_card_eq _ A F v rfl h⟩

/-- Conversely, an injective family whose members form part of a regular system of parameters
is independent. -/
theorem of_extends {A : Type u} [CommRing A] [IsRegularLocalRing A] {F : Finset ι}
    {v : ι → A} (hinj : Set.InjOn v F) (h : ExtendsToRSOP A (F.image v)) : RSOPIndep F v := by
  classical
  intro z hz
  refine ⟨h.mem_maximalIdeal (Finset.mem_image_of_mem v hz), ?_⟩
  obtain ⟨W, hFW, hW⟩ := h
  have hT : (((F.filter (· ≠ z)).image v : Finset A) : Set A) = v '' ((F : Set ι) \ {z}) := by
    ext a
    simp only [Finset.coe_image, Finset.coe_filter, Set.mem_image, Set.mem_ofPred_eq,
      Set.mem_sdiff, Set.mem_singleton_iff, Finset.mem_coe]
  rw [← hT]
  refine rsop_notMem_span_sup_sq hW ((Finset.image_subset_image
    (Finset.filter_subset _ F)).trans hFW) (hFW (Finset.mem_image_of_mem v hz)) ?_
  intro hmem
  obtain ⟨z', hz', heq⟩ := Finset.mem_image.mp hmem
  obtain ⟨hz'F, hne⟩ := Finset.mem_filter.mp hz'
  exact hne (hinj hz'F hz heq)

/-- Independence only depends on the members up to units. -/
theorem of_associated {A : Type u} [CommRing A] [IsLocalRing A] {F : Finset ι} {v w : ι → A}
    (h : RSOPIndep F v) (hvw : ∀ z ∈ F, Associated (v z) (w z)) : RSOPIndep F w := by
  have hmem : ∀ z ∈ F, ∀ I : Ideal A, w z ∈ I ↔ v z ∈ I := by
    intro z hz I
    obtain ⟨u, hu⟩ := hvw z hz
    constructor
    · intro hw
      have : v z = w z * ↑u⁻¹ := by rw [← hu, mul_assoc, Units.mul_inv, mul_one]
      rw [this]
      exact I.mul_mem_right _ hw
    · intro hv
      rw [← hu]
      exact I.mul_mem_right _ hv
  have hspan : ∀ S : Set ι, S ⊆ F → Ideal.span (w '' S) = Ideal.span (v '' S) := by
    intro S hS
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro _ ⟨z, hz, rfl⟩
      exact (hmem z (hS hz) _).mpr (Ideal.subset_span ⟨z, hz, rfl⟩)
    · rintro _ ⟨z, hz, rfl⟩
      exact (hmem z (hS hz) _).mp (Ideal.subset_span ⟨z, hz, rfl⟩)
  intro z hz
  rw [hmem z hz, hspan _ (fun a ha => ha.1), hmem z hz]
  exact h z hz

/-- Transport of independence along a ring isomorphism of regular local rings. -/
theorem map_ringEquiv {A B : Type u} [CommRing A] [IsRegularLocalRing A] [CommRing B]
    [IsRegularLocalRing B] (e : A ≃+* B) {F : Finset ι} {v : ι → A} (h : RSOPIndep F v) :
    RSOPIndep F (fun z => e (v z)) := by
  classical
  obtain ⟨hinj, hext⟩ := h.injOn_and_extends
  refine of_extends (fun a ha b hb hab => hinj ha hb (e.injective hab)) ?_
  have := hext.map_ringEquiv e
  rwa [Finset.image_image] at this

/-- Adjoining an independent family `(v z)_{z ∈ G}` generating `J` to a family whose classes are
independent in `A/J`. -/
theorem union_of_quotient {A : Type u} [CommRing A] [IsLocalRing A] {G F : Finset ι}
    {v : ι → A} (hGF : Disjoint G F) (hG : RSOPIndep G v) {J : Ideal A}
    (hJ : J = Ideal.span (v '' (G : Set ι))) [IsLocalRing (A ⧸ J)]
    (hF : RSOPIndep F (fun z => Ideal.Quotient.mk J (v z))) : RSOPIndep (G ∪ F) v := by
  classical
  set mk := Ideal.Quotient.mk J with hmk
  have hmap : (maximalIdeal A).map mk = maximalIdeal (A ⧸ J) :=
    IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective
  have hGJ : ∀ x ∈ G, mk (v x) = 0 := fun x hx =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (hJ ▸ Ideal.subset_span ⟨x, hx, rfl⟩)
  have hFM : ∀ z ∈ F, v z ∈ maximalIdeal A := by
    intro z hz
    by_contra hn
    have hu : IsUnit (v z) := (IsLocalRing.mem_maximalIdeal _).not.mp hn |> not_not.mp
    exact (IsLocalRing.mem_maximalIdeal _).mp (hF z hz).1 (hu.map mk)
  -- an element of `(v z)_{z ∈ F}` whose class lies in `M̄²` lies in `M²`
  have hkey : ∀ b ∈ Ideal.span (v '' (F : Set ι)), mk b ∈ maximalIdeal (A ⧸ J) ^ 2 →
      b ∈ maximalIdeal A ^ 2 := by
    intro b hb hbM
    rw [← Finset.coe_image] at hb
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp (hb : b ∈ Submodule.span A _)
    by_cases hall : ∀ w ∈ F.image v, c w ∈ maximalIdeal A
    · rw [← hc, pow_two]
      refine Ideal.sum_mem _ fun w hw => Ideal.mul_mem_mul (hall w hw) ?_
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hw
      exact hFM z hz
    exfalso
    push Not at hall
    obtain ⟨w₀, hw₀, hcw₀⟩ := hall
    obtain ⟨z₀, hz₀, rfl⟩ := Finset.mem_image.mp hw₀
    have hu : IsUnit (mk (c (v z₀))) :=
      ((IsLocalRing.mem_maximalIdeal _).not.mp hcw₀ |> not_not.mp).map mk
    obtain ⟨d, hd⟩ := hu.exists_left_inv
    apply (hF z₀ hz₀).2
    beta_reduce
    have hsplit : mk (c (v z₀)) * mk (v z₀) =
        mk b - ∑ w ∈ (F.image v).erase (v z₀), mk (c w) * mk w := by
      rw [← hc, map_sum, ← Finset.add_sum_erase _ _ hw₀]
      simp only [smul_eq_mul, map_mul]
      ring
    have : mk (v z₀) = d * (mk b - ∑ w ∈ (F.image v).erase (v z₀), mk (c w) * mk w) := by
      rw [← hsplit, ← mul_assoc, hd, one_mul]
    rw [this]
    refine Ideal.mul_mem_left _ _ (sub_mem (Ideal.mem_sup_right hbM)
      (Ideal.mem_sup_left (Ideal.sum_mem _ fun w hw => Ideal.mul_mem_left _ _ ?_)))
    obtain ⟨hwne, hw⟩ := Finset.mem_erase.mp hw
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hw
    exact Ideal.subset_span ⟨z, ⟨hz, fun h => hwne (by rw [Set.mem_singleton_iff.mp h])⟩, rfl⟩
  intro z hz
  rcases Finset.mem_union.mp hz with hzG | hzF
  · -- `z ∈ G`
    refine ⟨(hG z hzG).1, fun hmem => (hG z hzG).2 ?_⟩
    have hzF : z ∉ F := Finset.disjoint_left.mp hGF hzG
    have hset : v '' (((G ∪ F : Finset ι) : Set ι) \ {z}) =
        v '' ((G : Set ι) \ {z}) ∪ v '' (F : Set ι) := by
      rw [← Set.image_union]
      congr 1
      ext a
      simp only [Finset.coe_union, Set.mem_sdiff, Set.mem_union, Finset.mem_coe,
        Set.mem_singleton_iff]
      constructor
      · rintro ⟨ha | ha, hne⟩
        · exact Or.inl ⟨ha, hne⟩
        · exact Or.inr ha
      · rintro (⟨ha, hne⟩ | ha)
        · exact ⟨Or.inl ha, hne⟩
        · exact ⟨Or.inr ha, fun h => hzF (h ▸ ha)⟩
    rw [hset, Ideal.span_union] at hmem
    obtain ⟨ab, hab, t, ht, hsum⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
    have haJ : a ∈ J := hJ ▸ Ideal.span_mono (Set.image_mono Set.sdiff_subset) ha
    have hzJ : v z ∈ J := hJ ▸ Ideal.subset_span ⟨z, hzG, rfl⟩
    have hbM : mk b ∈ maximalIdeal (A ⧸ J) ^ 2 := by
      have : b = v z - a - t := by rw [← hsum]; ring
      rw [this, map_sub, map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hzJ,
        Ideal.Quotient.eq_zero_iff_mem.mpr haJ, ← hmap, ← Ideal.map_pow]
      simpa using neg_mem (Ideal.mem_map_of_mem mk ht)
    rw [← hsum, add_assoc]
    exact add_mem (Ideal.mem_sup_left ha) (Ideal.mem_sup_right (add_mem (hkey b hb hbM) ht))
  · -- `z ∈ F`
    refine ⟨hFM z hzF, fun hmem => (hF z hzF).2 ?_⟩
    have := Ideal.mem_map_of_mem mk hmem
    rw [Ideal.map_sup, Ideal.map_span, Ideal.map_pow, hmap] at this
    refine (sup_le_sup_right (Ideal.span_le.mpr ?_) _ :
      Ideal.span (mk '' (v '' (((G ∪ F : Finset ι) : Set ι) \ {z}))) ⊔
        maximalIdeal (A ⧸ J) ^ 2 ≤ _) this
    rintro _ ⟨_, ⟨x, ⟨hx, hxz⟩, rfl⟩, rfl⟩
    rcases Finset.mem_union.mp (Finset.mem_coe.mp hx) with hxG | hxF
    · rw [SetLike.mem_coe, hGJ x hxG]
      exact zero_mem _
    · exact Ideal.subset_span ⟨x, ⟨hxF, hxz⟩, rfl⟩

/-- Adjoining to an independent family `(v z)_{z ∈ G}` members `v z`, `z ∈ F`, none of which lies
in the ideal generated by all the others plus `M²`. -/
theorem union {A : Type u} [CommRing A] [IsLocalRing A] {G F : Finset ι} {v : ι → A}
    (hGF : Disjoint G F) (hG : RSOPIndep G v)
    (hF : ∀ z ∈ F, v z ∈ maximalIdeal A ∧
      v z ∉ Ideal.span (v '' (((G ∪ F : Finset ι) : Set ι) \ {z})) ⊔ maximalIdeal A ^ 2) :
    RSOPIndep (G ∪ F) v := by
  classical
  intro z hz
  rcases Finset.mem_union.mp hz with hzG | hzF
  swap
  · exact hF z hzF
  refine ⟨(hG z hzG).1, fun hmem => (hG z hzG).2 ?_⟩
  have hzF : z ∉ F := Finset.disjoint_left.mp hGF hzG
  have hset : v '' (((G ∪ F : Finset ι) : Set ι) \ {z}) =
      v '' ((G : Set ι) \ {z}) ∪ v '' (F : Set ι) := by
    rw [← Set.image_union]
    congr 1
    ext a
    simp only [Finset.coe_union, Set.mem_sdiff, Set.mem_union, Finset.mem_coe,
      Set.mem_singleton_iff]
    constructor
    · rintro ⟨ha | ha, hne⟩
      · exact Or.inl ⟨ha, hne⟩
      · exact Or.inr ha
    · rintro (⟨ha, hne⟩ | ha)
      · exact ⟨Or.inl ha, hne⟩
      · exact ⟨Or.inr ha, fun h => hzF (h ▸ ha)⟩
  rw [hset, Ideal.span_union] at hmem
  obtain ⟨ab, hab, t, ht, hsum⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hab
  rw [← Finset.coe_image] at hb
  obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp (hb : b ∈ Submodule.span A _)
  by_cases hall : ∀ w ∈ F.image v, c w ∈ maximalIdeal A
  · have hb2 : b ∈ maximalIdeal A ^ 2 := by
      rw [← hc, pow_two]
      refine Ideal.sum_mem _ fun w hw => Ideal.mul_mem_mul (hall w hw) ?_
      obtain ⟨z', hz', rfl⟩ := Finset.mem_image.mp hw
      exact (hF z' hz').1
    rw [← hsum, add_assoc]
    exact add_mem (Ideal.mem_sup_left ha) (Ideal.mem_sup_right (add_mem hb2 ht))
  exfalso
  push Not at hall
  obtain ⟨w₀, hw₀, hcw₀⟩ := hall
  obtain ⟨z₀, hz₀, rfl⟩ := Finset.mem_image.mp hw₀
  have hu : IsUnit (c (v z₀)) := (IsLocalRing.mem_maximalIdeal _).not.mp hcw₀ |> not_not.mp
  obtain ⟨d, hd⟩ := hu.exists_left_inv
  apply (hF z₀ hz₀).2
  have hsplit : c (v z₀) * v z₀ = v z - a - t - ∑ w ∈ (F.image v).erase (v z₀), c w * w := by
    rw [← hsum, ← hc, ← Finset.add_sum_erase _ _ hw₀]
    simp only [smul_eq_mul]
    ring
  have : v z₀ = d * (v z - a - t - ∑ w ∈ (F.image v).erase (v z₀), c w * w) := by
    rw [← hsplit, ← mul_assoc, hd, one_mul]
  have hz₀z : z₀ ≠ z := fun h => hzF (h ▸ hz₀)
  have hsub : ∀ x ∈ (((G ∪ F : Finset ι) : Set ι) \ {z₀}), v x ∈
      Ideal.span (v '' (((G ∪ F : Finset ι) : Set ι) \ {z₀})) := fun x hx =>
    Ideal.subset_span ⟨x, hx, rfl⟩
  rw [this]
  refine Ideal.mul_mem_left _ _ (sub_mem (sub_mem (sub_mem (Ideal.mem_sup_left ?_)
    (Ideal.mem_sup_left ?_)) (Ideal.mem_sup_right ht))
    (Ideal.mem_sup_left (Ideal.sum_mem _ fun w hw => Ideal.mul_mem_left _ _ ?_)))
  · exact hsub z ⟨Finset.mem_coe.mpr hz, fun h => hz₀z (Set.mem_singleton_iff.mp h).symm⟩
  · refine Ideal.span_mono ?_ ha
    rintro _ ⟨x, ⟨hx, hxz⟩, rfl⟩
    refine ⟨x, ⟨Finset.mem_coe.mpr (Finset.mem_union_left _ hx), fun h => ?_⟩, rfl⟩
    exact Finset.disjoint_left.mp hGF hx (by rw [Set.mem_singleton_iff.mp h]; exact hz₀)
  · obtain ⟨hwne, hw⟩ := Finset.mem_erase.mp hw
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hw
    exact hsub x ⟨Finset.mem_coe.mpr (Finset.mem_union_right _ hx),
      fun h => hwne (by rw [Set.mem_singleton_iff.mp h])⟩

end RSOPIndep


/-!
# A locally free sheaf contains an invertible subsheaf (Ch. 0, Corollary 2 of Main Theorem II, p. 145)

Hironaka, Ch. 0 §5, proof of Corollary 2 (p. 145): "To see this, we first remark that any locally free
coherent sheaf `F` contains an invertible sheaf of `O_X`-modules `M`.  Of course, in general, the quotient
sheaf `F/M` may not be locally free."  The remark is asserted without proof or citation.  This
module proves it for a non-singular integral locally noetherian scheme `X` and a sheaf `F` with local frames
(Mathlib's `IsLocallyFree` + `IsFiniteType`, `Hironaka/Compat/PullbackFrames.lean`) which is not zero.

The subsheaf is the *saturation* of a rational frame vector: if `v = c0 k0` is a vector of a frame of `F` over
a non-empty open set `U0`, `M(V) = {s ∈ Γ(F, V) | s|_{V ∩ U0} ∈ Γ(X, V ∩ U0) • v}`.

* `AlgebraicGeometry.Scheme.Modules.mkSubmodule`, `ofSubmodule`, `ofSubmoduleι`, `isFrame_ofSubmodule_singleton`: the
  sub-`𝒪_X`-module of `F` defined by submodules `P V ⊆ Γ(F, V)` with local membership, and the criterion that a
  section freely generates it;
* `Hironaka.Scheme.Modules.IsInvertible`: invertible = locally free of rank one, by one-element frames; implies
  Mathlib's `IsLocallyFree` + `IsFiniteType` (`IsInvertible.isLocallyFree`, `isFiniteType`,
  `exists_localGeneratorsData` with charts indexed by `PUnit`);
* `AlgebraicGeometry.Scheme.Modules.LineData`: the saturation `P`, its locality (`mem_P_of_local`);
* `LineData.exists_local_generator`: **local structure**: around every point the saturation is freely generated by
  one section.  Proof: in a frame `c` of `F` near `x` the coordinates `aᵢ` of `v` are unimodular on `V ⊓ U0`
  (`exists_unimodular`); in the function field `K`, `α = (aᵢ)` is `μ⁻¹ w` with `w` primitive over the UFD
  `𝒪_{X,x}` (`Hironaka.exists_isPrimitive_smul`); `w` stays primitive on a neighbourhood
  (`exists_forall_isPrimitive_stalkRange`: the non-primitive locus consists of the finitely many height-one
  minimal primes of `(wᵢ)`), and sections of `𝒪_X` are the intersection of the stalks
  (`exists_section_of_forall_mem_stalkRange`);
* `Modules.exists_nonempty_frame_of_not_isZero`: `F ≠ 0` gives a frame with a non-empty index set (the tacit
  hypothesis of the corollary);
* `Modules.exists_isInvertible_mono`: **the remark**: `∃ M, ∃ i : M ⟶ F, Mono i ∧ IsInvertible M`.

Deviation from the paper (gap filled): the remark is not proved in the paper (Corollary 2 of Main Theorem II).  The only cited fact used is the factoriality of regular local rings
(`Hironaka/Compat/RegularLocalRingUFD.lean`, footnote 3, p. 116).
-/

@[expose] public section

open CategoryTheory Limits Opposite AlgebraicGeometry TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme

variable {X : Scheme.{u}}

/-- A sub-`𝒪_X`-module of `F` given by submodules `P V ⊆ Γ(F, V)` which are stable under restriction and
whose membership is local. -/
noncomputable def Modules.mkSubmodule (F : X.Modules) (P : ∀ V : X.Opens, Submodule Γ(X, V) Γ(F, V))
    (hres : ∀ {V W : X.Opens} (h : V ≤ W) (s : Γ(F, W)), s ∈ P W → F.sectionRes h s ∈ P V)
    (hloc : ∀ (V : X.Opens) (s : Γ(F, V)),
      (∀ x ∈ V, ∃ (V' : X.Opens) (h : V' ≤ V), x ∈ V' ∧ F.sectionRes h s ∈ P V') → s ∈ P V) :
    SheafOfModules.Submodule F where
  obj V := P V.unop
  map {V W} f := fun s hs => hres (leOfHom f.unop) s hs
  isSheaf V s hs := hloc V.unop s fun x hx => by
    obtain ⟨V', f, hf, hxV'⟩ := ((_root_.Opens.mem_grothendieckTopology X).mp hs) x hx
    exact ⟨V', leOfHom f, hxV', hf⟩

section

variable (F : X.Modules) (P : ∀ V : X.Opens, Submodule Γ(X, V) Γ(F, V))
  (hres : ∀ {V W : X.Opens} (h : V ≤ W) (s : Γ(F, W)), s ∈ P W → F.sectionRes h s ∈ P V)
  (hloc : ∀ (V : X.Opens) (s : Γ(F, V)),
      (∀ x ∈ V, ∃ (V' : X.Opens) (h : V' ≤ V), x ∈ V' ∧ F.sectionRes h s ∈ P V') → s ∈ P V)

/-- The `𝒪_X`-module defined by `mkSubmodule`. -/
noncomputable def Modules.ofSubmodule : X.Modules :=
  (Modules.mkSubmodule F P hres hloc).toSheafOfModules

/-- The inclusion of the `𝒪_X`-module defined by `mkSubmodule` in `F`. -/
noncomputable def Modules.ofSubmoduleι : Modules.ofSubmodule F P hres hloc ⟶ F :=
  (Modules.mkSubmodule F P hres hloc).ι

/-- The inclusion `ofSubmoduleι` is a monomorphism. -/
instance Modules.mono_ofSubmoduleι : Mono (Modules.ofSubmoduleι F P hres hloc) :=
  let : Mono ((Modules.mkSubmodule F P hres hloc).toSubmodule.ι) := inferInstance
  (SheafOfModules.forget X.ringCatSheaf).mono_of_mono_map
    (inferInstanceAs (Mono ((Modules.mkSubmodule F P hres hloc).toSubmodule.ι)))

/-- The sections of `ofSubmodule` over `V` are those of `P V`. -/
theorem Modules.ofSubmodule_sections (V : X.Opens) :
    Γ(Modules.ofSubmodule F P hres hloc, V) = ↥(P V) := rfl

/-- If a section `d ∈ P V` generates `P V'` freely for all `V' ≤ V`, it is a one-element frame of
`ofSubmodule`. -/
theorem Modules.isFrame_ofSubmodule_singleton {V : X.Opens} (d : Γ(F, V)) (hd : d ∈ P V)
    (hinj : ∀ (V' : X.Opens) (h : V' ≤ V) (a : Γ(X, V')), a • F.sectionRes h d = 0 → a = 0)
    (hsurj : ∀ (V' : X.Opens) (h : V' ≤ V) (s : Γ(F, V')), s ∈ P V' →
      ∃ a : Γ(X, V'), a • F.sectionRes h d = s) :
    Hironaka.Scheme.Modules.IsFrame (Modules.ofSubmodule F P hres hloc) V
      (fun _ : PUnit.{u + 1} => (⟨d, hd⟩ : P V)) where
  bijective V' h := by
    have hmap : ∀ (a : PUnit.{u + 1} → Γ(X, V')), (∑ i : PUnit.{u + 1}, a i •
        (Modules.ofSubmodule F P hres hloc).presheaf.map (homOfLE h).op (⟨d, hd⟩ : P V)) =
        (⟨a PUnit.unit • F.sectionRes h d, (P V').smul_mem _ (hres h d hd)⟩ : P V') := by
      intro a
      simp
      exact Subtype.ext rfl
    constructor
    · intro a b hab
      have h1 := hmap a
      have h2 := hmap b
      have hab' := hab
      simp only at hab'
      have h3 := (h1.symm.trans hab').trans h2
      have h4 : a PUnit.unit • F.sectionRes h d = b PUnit.unit • F.sectionRes h d :=
        congrArg Subtype.val h3
      have h5 : (a PUnit.unit - b PUnit.unit) • F.sectionRes h d = 0 := by
        rw [sub_smul, h4, sub_self]
      funext i
      cases i
      exact sub_eq_zero.mp (hinj V' h _ h5)
    · rintro ⟨s, hs⟩
      obtain ⟨a, ha⟩ := hsurj V' h s hs
      refine ⟨fun _ => a, ?_⟩
      refine (hmap _).trans (Subtype.ext ?_)
      exact ha

end

end AlgebraicGeometry.Scheme

namespace Hironaka

namespace Scheme.Modules

open AlgebraicGeometry AlgebraicGeometry.Scheme AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}


/-- An invertible sheaf has local frames (of rank one). -/
theorem HasLocalFrames.of_isInvertible {L : X.Modules} (h : IsInvertible L) : HasLocalFrames L :=
  fun x => by
    obtain ⟨U, hxU, d, hd⟩ := h x
    exact ⟨U, hxU, PUnit.{u + 1}, inferInstance, _, hd⟩

/-- An invertible sheaf is locally free (Mathlib's `IsLocallyFree`). -/
theorem IsInvertible.isLocallyFree {L : X.Modules} (h : IsInvertible L) : L.IsLocallyFree :=
  isLocallyFree_of_hasLocalFrames (HasLocalFrames.of_isInvertible h)

/-- An invertible sheaf is of finite type. -/
theorem IsInvertible.isFiniteType {L : X.Modules} (h : IsInvertible L) : L.IsFiniteType :=
  isFiniteType_of_hasLocalFrames (HasLocalFrames.of_isInvertible h)

/-- An invertible sheaf has charts of Mathlib's `IsLocallyFree` of rank one (index type `PUnit`). -/
theorem IsInvertible.exists_localGeneratorsData {L : X.Modules} (h : IsInvertible L) :
    ∃ q : SheafOfModules.LocalGeneratorsData.{u, u, u, u} L, q.IsLocallyFreeData ∧ ∀ i, Nonempty ((q.generators i).I ≃ PUnit.{u + 1}) := by
  choose U hxU d hd using h
  exact ⟨localGeneratorsDataOfFrames (c := fun x _ => d x) hxU hd,
    isLocallyFreeData_localGeneratorsDataOfFrames hxU hd, fun i => ⟨Equiv.refl _⟩⟩

end Scheme.Modules

end Hironaka

namespace AlgebraicGeometry.Scheme

variable {X : Scheme.{u}}

/-! ### The saturation of a rational frame vector -/

section Saturation

/-- The data of a "rational section" of `F`: a frame `c0` of `F` over a nonempty open set `U0`, and one of its
vectors `v = c0 k0`. -/
structure Modules.LineData (F : X.Modules) where
  /-- the open set where the frame lives -/
  U0 : X.Opens
  nonempty : Nonempty U0
  /-- the index set of the frame -/
  ι0 : Type u
  fintype : Fintype ι0
  /-- the frame -/
  c0 : ι0 → Γ(F, U0)
  frame : Hironaka.Scheme.Modules.IsFrame F U0 c0
  /-- the chosen vector -/
  k0 : ι0

attribute [instance] Modules.LineData.fintype Modules.LineData.nonempty

variable {F : X.Modules} (D : Modules.LineData F)

/-- The rational section `v = c0 k0`. -/
def Modules.LineData.v : Γ(F, D.U0) := D.c0 D.k0

/-- `a • v|_V = 0` forces `a = 0` for `V ≤ U0` (the frame `c0` has `v` as a vector). -/
theorem Modules.LineData.eq_zero_of_smul_eq_zero {V : X.Opens} (h : V ≤ D.U0) (a : Γ(X, V))
    (ha : a • F.sectionRes h D.v = 0) : a = 0 := by
  classical
  have := D.frame.coord_smul h a (F.sectionRes h D.v) D.k0
  rw [ha, D.frame.coord_zero] at this
  have h2 := D.frame.coord_sectionRes_self h D.k0 D.k0
  rw [Modules.LineData.v, h2] at this
  simpa using this.symm

/-- The saturation of `v`: the sections `s` over `V` whose restriction to `V ⊓ U0` is a multiple `l • v`. -/
def Modules.LineData.P (V : X.Opens) : Submodule Γ(X, V) Γ(F, V) where
  carrier := {s | ∃ l : Γ(X, V ⊓ D.U0), F.sectionRes inf_le_left s =
    l • F.sectionRes (inf_le_right : V ⊓ D.U0 ≤ D.U0) D.v}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro s t ⟨l, hl⟩ ⟨m, hm⟩
    exact ⟨l + m, by rw [Modules.sectionRes_add, hl, hm, add_smul]⟩
  smul_mem' := by
    rintro a s ⟨l, hl⟩
    exact ⟨resO X inf_le_left a * l, by rw [Modules.sectionRes_smul, hl, mul_smul]⟩

/-- Unfolding of membership in the saturation. -/
theorem Modules.LineData.mem_P {V : X.Opens} {s : Γ(F, V)} :
    s ∈ D.P V ↔ ∃ l : Γ(X, V ⊓ D.U0), F.sectionRes inf_le_left s =
      l • F.sectionRes (inf_le_right : V ⊓ D.U0 ≤ D.U0) D.v := Iff.rfl

/-- The saturation is stable under restriction. -/
theorem Modules.LineData.sectionRes_mem_P {V W : X.Opens} (h : V ≤ W) {s : Γ(F, W)} (hs : s ∈ D.P W) :
    F.sectionRes h s ∈ D.P V := by
  obtain ⟨l, hl⟩ := hs
  refine ⟨resO X (inf_le_inf_right D.U0 h) l, ?_⟩
  have h1 : F.sectionRes (inf_le_left : V ⊓ D.U0 ≤ V) (F.sectionRes h s) =
      F.sectionRes (inf_le_inf_right D.U0 h) (F.sectionRes (inf_le_left : W ⊓ D.U0 ≤ W) s) := by
    rw [Modules.sectionRes_res, Modules.sectionRes_res]
  rw [h1, hl, Modules.sectionRes_smul, Modules.sectionRes_res]

/-- Membership in the saturation is local. -/
theorem Modules.LineData.mem_P_of_local {V : X.Opens} (s : Γ(F, V))
    (hs : ∀ x ∈ V, ∃ (V' : X.Opens) (h : V' ≤ V), x ∈ V' ∧ F.sectionRes h s ∈ D.P V') :
    s ∈ D.P V := by
  have hs' : ∀ x : V, ∃ (V' : X.Opens) (h : V' ≤ V), (x : X) ∈ V' ∧ F.sectionRes h s ∈ D.P V' :=
    fun x => hs x x.2
  choose V' hV' hxV' hl using hs'
  choose lx hlx using hl
  let U : V → X.Opens := fun x => V' x ⊓ D.U0
  have hUle : ∀ x, U x ≤ V ⊓ D.U0 := fun x => le_inf (inf_le_left.trans (hV' x)) inf_le_right
  have hU0 : ∀ x, U x ≤ D.U0 := fun x => inf_le_right
  have key : ∀ (x : V) {T : X.Opens} (hT : T ≤ U x),
      resO X hT (lx x) • F.sectionRes (hT.trans (hU0 x)) D.v =
        F.sectionRes (hT.trans ((hUle x).trans inf_le_left)) s := by
    intro x T hT
    have h1 := congrArg (F.sectionRes hT) (hlx x)
    rw [Modules.sectionRes_res, Modules.sectionRes_res, Modules.sectionRes_smul,
      Modules.sectionRes_res] at h1
    exact h1.symm
  have hcomp : ∀ i j, resO X (inf_le_left : U i ⊓ U j ≤ U i) (lx i) =
      resO X (inf_le_right : U i ⊓ U j ≤ U j) (lx j) := by
    intro i j
    have hT : U i ⊓ U j ≤ D.U0 := inf_le_left.trans (hU0 i)
    have h1 := key i (inf_le_left : U i ⊓ U j ≤ U i)
    have h2 := key j (inf_le_right : U i ⊓ U j ≤ U j)
    have h3 : (resO X (inf_le_left : U i ⊓ U j ≤ U i) (lx i) -
        resO X (inf_le_right : U i ⊓ U j ≤ U j) (lx j)) • F.sectionRes hT D.v = 0 := by
      rw [sub_smul]
      exact sub_eq_zero.mpr (h1.trans h2.symm)
    exact sub_eq_zero.mp (D.eq_zero_of_smul_eq_zero hT _ h3)
  have hcov : V ⊓ D.U0 ≤ ⨆ x, U x := by
    intro z hz
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨z, hz.1⟩, hxV' ⟨z, hz.1⟩, hz.2⟩
  obtain ⟨Λ, hΛ⟩ := AlgebraicGeometry.Scheme.exists_section_of_compatible X U hUle hcov lx hcomp
  refine ⟨Λ, Modules.eq_of_locally_eq F U hUle hcov fun x => ?_⟩
  rw [Modules.sectionRes_res, Modules.sectionRes_smul, Modules.sectionRes_res, hΛ x]
  have := key x le_rfl
  rw [resO_self] at this
  exact this.symm.trans rfl

section Local

variable {ι : Type u} [Fintype ι] {V : X.Opens} {c : ι → Γ(F, V)}

/-- The coordinates `aᵢ` of `v|_{V ⊓ U0}` in a frame `c` of `F` over `V`. -/
noncomputable def Modules.LineData.coeff (hc : Hironaka.Scheme.Modules.IsFrame F V c) (i : ι) :
    Γ(X, V ⊓ D.U0) :=
  hc.coord inf_le_left (F.sectionRes (inf_le_right : V ⊓ D.U0 ≤ D.U0) D.v) i

/-- The coordinates of `v` in another frame are unimodular: `∑ aᵢ bᵢ = 1`. -/
theorem Modules.LineData.exists_unimodular (hc : Hironaka.Scheme.Modules.IsFrame F V c) :
    ∃ b : ι → Γ(X, V ⊓ D.U0), ∑ i, D.coeff hc i * b i = 1 := by
  classical
  refine ⟨fun i => D.frame.coord (inf_le_right : V ⊓ D.U0 ≤ D.U0)
    (F.sectionRes (inf_le_left : V ⊓ D.U0 ≤ V) (c i)) D.k0, ?_⟩
  have h1 := hc.sum_coord_smul (inf_le_left : V ⊓ D.U0 ≤ V)
    (F.sectionRes (inf_le_right : V ⊓ D.U0 ≤ D.U0) D.v)
  have h2 := congrArg (fun t => D.frame.coord (inf_le_right : V ⊓ D.U0 ≤ D.U0) t D.k0) h1
  simp only [Hironaka.Scheme.Modules.IsFrame.coord_sum, Hironaka.Scheme.Modules.IsFrame.coord_smul] at h2
  rw [Modules.LineData.v, Hironaka.Scheme.Modules.IsFrame.coord_sectionRes_self] at h2
  have h3 : (if D.k0 = D.k0 then (1 : Γ(X, V ⊓ D.U0)) else 0) = 1 := by simp
  rw [h3] at h2
  exact (h2.symm.trans (Finset.sum_congr rfl fun i _ => rfl)).symm

/-- The coordinates of `v|_{V ⊓ U0}` do not all vanish when `V ⊓ U0` is nonempty. -/
theorem Modules.LineData.exists_coeff_ne_zero [Nonempty (V ⊓ D.U0 : X.Opens)]
    (hc : Hironaka.Scheme.Modules.IsFrame F V c) : ∃ i, D.coeff hc i ≠ 0 := by
  by_contra hcon
  push Not at hcon
  obtain ⟨b, hb⟩ := D.exists_unimodular hc
  simp only [hcon, zero_mul, Finset.sum_const_zero] at hb
  exact zero_ne_one hb

omit [Fintype ι] in
/-- Two nonempty open subsets of an irreducible space meet. -/
theorem nonempty_inf_of_irreducible [IrreducibleSpace X] (U V : X.Opens) [Nonempty U] [Nonempty V] :
    Nonempty (U ⊓ V : X.Opens) := by
  obtain ⟨u⟩ := ‹Nonempty U›
  obtain ⟨v⟩ := ‹Nonempty V›
  obtain ⟨z, -, hzU, hzV⟩ := (PreirreducibleSpace.isPreirreducible_univ (X := X)) U V U.isOpen V.isOpen
    ⟨u.1, trivial, u.2⟩ ⟨v.1, trivial, v.2⟩
  exact ⟨⟨z, hzU, hzV⟩⟩

/-- A vector whose coordinates are unimodular on `W` is primitive for the stalk at every point of `W`. -/
theorem isPrimitive_stalkRange_of_unimodular [IsIntegral X] {W : X.Opens} [Nonempty W]
    (a b : ι → Γ(X, W)) (hab : ∑ i, a i * b i = 1) {y : X} (hy : y ∈ W) :
    Hironaka.IsPrimitive (stalkRange X y) fun i => X.germToFunctionField W (a i) := by
  intro l hl
  have h1 : l = ∑ i, (l * X.germToFunctionField W (a i)) * X.germToFunctionField W (b i) := by
    have := congrArg (X.germToFunctionField W) hab
    rw [map_sum, map_one] at this
    calc l = l * 1 := (mul_one l).symm
      _ = l * ∑ i, X.germToFunctionField W (a i) * X.germToFunctionField W (b i) := by
        rw [← this]
        simp only [map_mul]
      _ = _ := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => by ring
  rw [h1]
  let S : Subring X.functionField := (algebraMap (X.presheaf.stalk y) X.functionField).range
  refine Subring.sum_mem S fun i _ => Subring.mul_mem S (hl i) ?_
  exact germToFunctionField_mem_stalkRange (b i) hy

/-- **Local structure of the saturation.**  On a non-singular locally noetherian integral scheme, around every
point `x` there is an open set `V''` and a section `d ∈ P V''` of the saturation which freely generates
`P V'` over `Γ(X, V')` for all `V' ≤ V''`. -/
theorem Modules.LineData.exists_local_generator [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] [IsIntegral X] [IsLocallyNoetherian X]
    (hX : X.IsNonsingular) {x : X} (hxV : x ∈ V)
    (hc : Hironaka.Scheme.Modules.IsFrame F V c) :
    ∃ (V'' : X.Opens) (_ : x ∈ V'') (d : Γ(F, V'')) (_ : d ∈ D.P V''),
      (∀ (V' : X.Opens) (h : V' ≤ V'') (a : Γ(X, V')), a • F.sectionRes h d = 0 → a = 0) ∧
      ∀ (V' : X.Opens) (h : V' ≤ V'') (s : Γ(F, V')), s ∈ D.P V' →
        ∃ a : Γ(X, V'), a • F.sectionRes h d = s := by
  classical
  have hVne : Nonempty V := ⟨⟨x, hxV⟩⟩
  have hWne : Nonempty (V ⊓ D.U0 : X.Opens) := nonempty_inf_of_irreducible V D.U0
  obtain ⟨i0, hi0⟩ := D.exists_coeff_ne_zero hc
  obtain ⟨b, hb⟩ := D.exists_unimodular hc
  let α : ι → X.functionField := fun i => X.germToFunctionField (V ⊓ D.U0) (D.coeff hc i)
  have hα : ∃ i, α i ≠ 0 := ⟨i0, fun h => hi0 (Scheme.germToFunctionField_injective X _ (by rw [map_zero]; exact h))⟩
  have hprimα : ∀ y ∈ V ⊓ D.U0, Hironaka.IsPrimitive (stalkRange X y) α := fun y hy =>
    isPrimitive_stalkRange_of_unimodular (D.coeff hc) b hb hy
  have : IsRegularLocalRing (X.presheaf.stalk x) := hX x
  have hufd : UniqueFactorizationMonoid (X.presheaf.stalk x) :=
    Hironaka.IsRegularLocalRing.uniqueFactorizationMonoid _
  obtain ⟨μ, hμ0, hμmem, hμprim⟩ := Hironaka.exists_isPrimitive_smul (B := X.presheaf.stalk x) α hα
  choose w0 hw0 using hμmem
  choose Ui hxi wi hwi using fun i => X.presheaf.exists_germ_eq (w0 i)
  let O : X.Opens := ⟨(V : Set X) ∩ ⋂ i, (Ui i : Set X),
    V.isOpen.inter (isOpen_iInter_of_finite fun i => (Ui i).isOpen)⟩
  have hxO : x ∈ O := ⟨hxV, Set.mem_iInter.mpr fun i => hxi i⟩
  obtain ⟨_, ⟨U₁, hU₁, rfl⟩, hxU₁, hU₁O⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxO O.isOpen
  have hU1V : U₁ ≤ V := fun z hz => (hU₁O hz).1
  have hU1i : ∀ i, U₁ ≤ Ui i := fun i z hz => Set.mem_iInter.mp (hU₁O hz).2 i
  have hU1ne : Nonempty U₁ := ⟨⟨x, hxU₁⟩⟩
  have hUine : ∀ i, Nonempty (Ui i) := fun i => ⟨⟨x, hxi i⟩⟩
  let W : ι → Γ(X, U₁) := fun i => resO X (hU1i i) (wi i)
  have hWε : ∀ i, X.germToFunctionField U₁ (W i) = μ * α i := fun i => by
    have := hUine i
    rw [germToFunctionField_resO (hU1i i) (wi i)]
    rw [← hw0 i, ← hwi i]
    exact (Scheme.algebraMap_germ_eq_germToFunctionField X (hxi i) (wi i)).symm
  obtain ⟨i1, hi1⟩ := hα
  have hW0 : ∃ i, W i ≠ 0 := ⟨i1, fun h => by
    have := hWε i1
    rw [h, map_zero] at this
    exact mul_ne_zero hμ0 hi1 this.symm⟩
  have : IsFractionRing Γ(X, U₁) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U₁ hU₁
  have hp : Hironaka.IsPrimitive (stalkRange X x) fun i => X.germToFunctionField U₁ (W i) := by
    simp only [hWε]
    exact hμprim
  obtain ⟨f, hxf, hf⟩ := exists_forall_isPrimitive_stalkRange hU₁ hX W hW0 hxU₁ hp
  -- the neighbourhood `V2 = D(f)` and the section `d`
  let V2 : X.Opens := X.basicOpen f
  have hV2U : V2 ≤ U₁ := X.basicOpen_le f
  have hV2V : V2 ≤ V := hV2U.trans hU1V
  have hV2ne : Nonempty V2 := ⟨⟨x, hxf⟩⟩
  let d : Γ(F, V2) := ∑ i, resO X hV2U (W i) • F.sectionRes hV2V (c i)
  have hdcoord : ∀ {V' : X.Opens} (h : V' ≤ V2) (i : ι),
      hc.coord (h.trans hV2V) (F.sectionRes h d) i = resO X (h.trans hV2U) (W i) := by
    intro V' h i
    refine hc.coord_eq (h.trans hV2V) _ (fun j => resO X (h.trans hV2U) (W j)) ?_ i
    simp only [d, Modules.sectionRes_sum, Modules.sectionRes_smul, Modules.sectionRes_res, resO_resO]
  have hεW : ∀ i, X.germToFunctionField U₁ (W i) = μ * α i := hWε
  -- `d` lies in the saturation
  have hdP : d ∈ D.P V2 := by
    have hW2ne : Nonempty (V2 ⊓ D.U0 : X.Opens) := nonempty_inf_of_irreducible V2 D.U0
    have hμy : ∀ y ∈ (V2 ⊓ D.U0 : X.Opens), μ ∈ stalkRange X y := by
      intro y hy
      refine hprimα y ⟨hV2V hy.1, hy.2⟩ μ fun i => ?_
      rw [← hεW i]
      exact germToFunctionField_mem_stalkRange (W i) (hV2U hy.1)
    obtain ⟨Λ, hΛ⟩ := exists_section_of_forall_mem_stalkRange (V := (V2 ⊓ D.U0 : X.Opens)) μ hμy
    refine ⟨Λ, ?_⟩
    have h2V : V2 ⊓ D.U0 ≤ V := inf_le_left.trans hV2V
    have hle : (V2 ⊓ D.U0 : X.Opens) ≤ V ⊓ D.U0 := inf_le_inf_right D.U0 hV2V
    have hWne' : Nonempty (V ⊓ D.U0 : X.Opens) := hWne
    refine hc.ext_coord h2V fun i => ?_
    rw [hdcoord (inf_le_left : V2 ⊓ D.U0 ≤ V2) i, Hironaka.Scheme.Modules.IsFrame.coord_smul]
    have hv : F.sectionRes (inf_le_right : V2 ⊓ D.U0 ≤ D.U0) D.v =
        F.sectionRes hle (F.sectionRes (inf_le_right : V ⊓ D.U0 ≤ D.U0) D.v) := by
      rw [Modules.sectionRes_res]
    rw [hv, hc.coord_sectionRes hle inf_le_left]
    refine Scheme.germToFunctionField_injective X (V2 ⊓ D.U0) ?_
    rw [map_mul, hΛ, germToFunctionField_resO hle, germToFunctionField_resO (inf_le_left.trans hV2U : V2 ⊓ D.U0 ≤ U₁), hεW]
    rfl
  refine ⟨V2, hxf, d, hdP, ?_, ?_⟩
  · -- injectivity
    intro V' h a ha
    by_cases hne : Nonempty V'
    · have h1 : ∀ i, a * resO X (h.trans hV2U) (W i) = 0 := fun i => by
        have := congrArg (fun t => hc.coord (h.trans hV2V) t i) ha
        simp only [Hironaka.Scheme.Modules.IsFrame.coord_smul, hdcoord h i,
          hc.coord_zero] at this
        exact this
      have h2 := congrArg (X.germToFunctionField V') (h1 i1)
      rw [map_mul, germToFunctionField_resO (h.trans hV2U), hεW, map_zero] at h2
      have h3 : X.germToFunctionField V' a = 0 :=
        (mul_eq_zero.mp h2).resolve_right (mul_ne_zero hμ0 hi1)
      exact Scheme.germToFunctionField_injective X V' (by rw [h3, map_zero])
    · have := subsingleton_sections_of_not_nonempty V' hne
      exact Subsingleton.elim _ _
  · -- surjectivity
    intro V' h s hs
    by_cases hne : Nonempty V'
    · obtain ⟨l, hl⟩ := hs
      have hVV : V' ≤ V := h.trans hV2V
      have hTne : Nonempty (V' ⊓ D.U0 : X.Opens) := nonempty_inf_of_irreducible V' D.U0
      have hle : (V' ⊓ D.U0 : X.Opens) ≤ V ⊓ D.U0 := inf_le_inf_right D.U0 hVV
      have hWne' : Nonempty (V ⊓ D.U0 : X.Opens) := hWne
      let sc : ι → Γ(X, V') := fun i => hc.coord hVV s i
      have hsc : ∀ i, resO X (inf_le_left : V' ⊓ D.U0 ≤ V') (sc i) =
          l * resO X hle (D.coeff hc i) := by
        intro i
        have e1 := hc.coord_sectionRes (inf_le_left : V' ⊓ D.U0 ≤ V') hVV s i
        have hv : F.sectionRes (inf_le_right : V' ⊓ D.U0 ≤ D.U0) D.v =
            F.sectionRes hle (F.sectionRes (inf_le_right : V ⊓ D.U0 ≤ D.U0) D.v) := by
          rw [Modules.sectionRes_res]
        refine e1.symm.trans ?_
        rw [hl, hc.coord_smul, hv, hc.coord_sectionRes hle inf_le_left]
        rfl
      let κ : X.functionField := X.germToFunctionField (V' ⊓ D.U0) l * μ⁻¹
      have hεsc : ∀ i, X.germToFunctionField V' (sc i) =
          X.germToFunctionField (V' ⊓ D.U0) l * α i := by
        intro i
        have := congrArg (X.germToFunctionField (V' ⊓ D.U0)) (hsc i)
        rw [germToFunctionField_resO, map_mul, germToFunctionField_resO hle] at this
        exact this
      have hκ : ∀ i, κ * X.germToFunctionField U₁ (W i) = X.germToFunctionField V' (sc i) := by
        intro i
        rw [hεW, hεsc]
        simp only [κ]
        field_simp
      have hκy : ∀ y ∈ V', κ ∈ stalkRange X y := fun y hy =>
        hf y (h hy) κ fun i => by rw [hκ i]; exact germToFunctionField_mem_stalkRange (sc i) hy
      obtain ⟨K', hK'⟩ := exists_section_of_forall_mem_stalkRange (V := V') κ hκy
      refine ⟨K', hc.ext_coord hVV fun i => ?_⟩
      rw [hc.coord_smul, hdcoord h i]
      refine Scheme.germToFunctionField_injective X V' ?_
      rw [map_mul, hK', germToFunctionField_resO (h.trans hV2U), hκ i]
    · have := subsingleton_sections_of_not_nonempty V' hne
      refine ⟨0, hc.ext_coord (h.trans hV2V) fun i => Subsingleton.elim _ _⟩

end Local

/-- A sheaf with local frames which is not zero has a frame with a non-empty index set over a non-empty open
set (the tacit hypothesis `F ≠ 0` of Corollary 2, p. 145). -/
theorem Modules.exists_nonempty_frame_of_not_isZero (hF : Hironaka.Scheme.Modules.HasLocalFrames F)
    (hFz : ¬ IsZero F) :
    ∃ (U : X.Opens) (_ : Nonempty U) (ι : Type u) (_ : Fintype ι) (c : ι → Γ(F, U))
      (_ : Hironaka.Scheme.Modules.IsFrame F U c), Nonempty ι := by
  by_contra hcon
  refine hFz ?_
  rw [IsZero.iff_id_eq_zero]
  refine Modules.hom_ext _ _ fun V => ?_
  ext s
  have hloc : ∀ x : V, ∃ (V' : X.Opens) (h : V' ≤ V), (x : X) ∈ V' ∧ Subsingleton Γ(F, V') := by
    intro ⟨x, hx⟩
    obtain ⟨U, hxU, ι, hι, c, hc⟩ := hF x
    have hempty : IsEmpty ι := by
      by_contra hne
      exact hcon ⟨U, ⟨⟨x, hxU⟩⟩, ι, hι, c, hc, not_isEmpty_iff.mp hne⟩
    refine ⟨V ⊓ U, inf_le_left, ⟨hx, hxU⟩, ?_⟩
    exact (hc.linearEquiv (inf_le_right : V ⊓ U ≤ U)).toEquiv.symm.subsingleton
  choose V' hV' hxV' hsub using hloc
  refine Modules.eq_of_locally_eq F V' hV' (fun z hz => ?_) (fun x => ?_)
  · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨z, hz⟩, hxV' ⟨z, hz⟩⟩
  · have := hsub x
    exact Subsingleton.elim _ _

/-- **The invertible subsheaf.** On an integral, locally noetherian, non-singular scheme, a locally
free sheaf of finite type which is not zero contains an invertible subsheaf (Corollary 2, p. 145: "we first
remark that any locally free coherent sheaf `F` contains an invertible sheaf of `O_X`-modules `M`"). -/
theorem Modules.exists_isInvertible_mono [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] [IsIntegral X] [IsLocallyNoetherian X] (hX : X.IsNonsingular)
    (hF : Hironaka.Scheme.Modules.HasLocalFrames F) (hFz : ¬ IsZero F) :
    ∃ (M : X.Modules) (i : M ⟶ F), Mono i ∧ Hironaka.Scheme.Modules.IsInvertible M := by
  obtain ⟨U0, hU0, ι0, hι0, c0, hc0, k0⟩ := Modules.exists_nonempty_frame_of_not_isZero hF hFz
  obtain ⟨k⟩ := k0
  let D : Modules.LineData F := ⟨U0, hU0, ι0, hι0, c0, hc0, k⟩
  refine ⟨Modules.ofSubmodule F D.P (fun h s hs => D.sectionRes_mem_P h hs)
    (fun V s hs => D.mem_P_of_local s hs),
    Modules.ofSubmoduleι F D.P (fun h s hs => D.sectionRes_mem_P h hs)
      (fun V s hs => D.mem_P_of_local s hs), inferInstance, fun x => ?_⟩
  obtain ⟨V, hxV, ι, hι, c, hc⟩ := hF x
  obtain ⟨V'', hxV'', d, hd, hinj, hsurj⟩ := D.exists_local_generator hX hxV hc
  exact ⟨V'', hxV'', ⟨d, hd⟩, Modules.isFrame_ofSubmodule_singleton F D.P _ _ d hd hinj hsurj⟩

end Saturation

end AlgebraicGeometry.Scheme

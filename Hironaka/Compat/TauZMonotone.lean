/-!
# Monotonicity of `T` of Definition 10* along initial segments of a standard base

Infrastructure for claim (B) of Theorem 9 (p. 274, "The proof of (B) for this `f_{i+1}` can be
obtained by Lemmas 18-19, §7, and Lemmas 20-21, §8").  The space `T` of Definition 10* for
`(f_1, ..., f_i)` is contained in the space for `(f_1, ..., f_{i+1})` when the initial forms have
non-decreasing degrees (`tauZSubmodule_le_snoc`), hence for the initial segments of a standard
base (`tauZSubmodule_prefix_mono`).  The paper uses this tacitly: "(2) `(z)` can be extended to a
regular system of `tau`-parameters of `R` for `(f_1, ..., f_i)`" is kept when `f_{i+1}` is added.

Also here: Lemma 19 for the ideal of the system itself
(`RegularFrame.initialForm_mem_adjoin_of_isTauZSubmodule_snoc`): if `g` is normalized by
`(f_1, ..., f_i)` and `T` contains `Z_1, ..., Z_r` and has the property of Definition 10* for
`(f_1, ..., f_i, g)`, then the initial form of `g` lies in `k[T]`; with the monotonicity this gives
`T(f_1, ..., f_i, g) = T(g) + <Z>` (the equality `tau(f_1, ..., f_{i+1}) = r + tau_{(z)}(f_{i+1})`
of condition (3) in the proof of Theorem 9).
-/

@[expose] public section

open IsLocalRing MvPolynomial

namespace Hironaka

universe u

section Projection

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- An ideal of `gr_I(A)` generated by homogeneous elements is closed under taking homogeneous
components. -/
theorem AssocGraded.proj_mem_span_range {ι : Type*} (Φ : ι → AssocGraded I)
    (hΦ : ∀ t, ∃ d, Φ t ∈ AssocGraded.homogeneous I d) {x : AssocGraded I}
    (hx : x ∈ Ideal.span (Set.range Φ)) (e : ℕ) :
    AssocGraded.proj I e x ∈ Ideal.span (Set.range Φ) := by
  induction hx using Submodule.span_induction generalizing e with
  | mem y hy =>
    obtain ⟨t, rfl⟩ := hy
    obtain ⟨d, hd⟩ := hΦ t
    by_cases hde : d = e
    · rw [← hde, AssocGraded.proj_of_mem_homogeneous I hd]
      exact Ideal.subset_span ⟨t, rfl⟩
    · rw [AssocGraded.proj_of_mem_homogeneous_of_ne I hd hde]
      exact zero_mem _
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem (hx e) (hy e)
  | smul c x _ hx =>
    rw [smul_eq_mul, AssocGraded.proj_mul]
    exact Ideal.sum_mem _ fun d _ => Ideal.mul_mem_left _ _ (hx d)

/-- Adjoining one homogeneous generator `ψ` of degree `n` to an ideal generated by homogeneous
elements does not change its homogeneous elements of degree `< n`. -/
theorem AssocGraded.mem_span_range_of_mem_sup_span_singleton {ι : Type*} (Φ : ι → AssocGraded I)
    (hΦ : ∀ t, ∃ d, Φ t ∈ AssocGraded.homogeneous I d) {ψ : AssocGraded I} {n : ℕ}
    (hψ : ψ ∈ AssocGraded.homogeneous I n) {y : AssocGraded I}
    (hy : y ∈ Ideal.span (Set.range Φ) ⊔ Ideal.span {ψ}) {d : ℕ} (hd : d < n)
    (hyd : y ∈ AssocGraded.homogeneous I d) : y ∈ Ideal.span (Set.range Φ) := by
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hy
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hb
  have h1 := AssocGraded.proj_of_mem_homogeneous I hyd
  rw [map_add, AssocGraded.proj_mul_of_mem_homogeneous _ c _ hψ] at h1
  simp only [show ¬ n ≤ d by omega, ↓reduceIte, add_zero] at h1
  rw [← h1]
  exact AssocGraded.proj_mem_span_range I Φ hΦ ha d


end Projection

section Monotone

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- **A space with the property of Definition 10\* for `(f₁, …, f_i, f_{i+1})` has it for
`(f₁, …, f_i)`** when the initial form of `f_{i+1}` is homogeneous of degree at least those of the
`φ_j`.  The ideal `K' = K + (ψ)` has the same homogeneous elements as `K` in the degrees
`< deg ψ`; the degree-`e` component of an element of `K` is a combination of lower degree members
of `K' ∩ k[T]` (which lie in `K`) and one more member of `K' ∩ k[T]`, which differs from the
element by an element of `K` and therefore lies in `K` too
(`AssocGraded.exists_proj_eq_add_of_mem_span`). -/
theorem isTauZSubmodule_of_snoc {i : ℕ} (f : Fin i → R) (g : R) {d : Fin i → ℕ} {d₀ : ℕ}
    (hd : ∀ j, initialForm (maximalIdeal R) (f j) ∈
      AssocGraded.homogeneous (maximalIdeal R) (d j))
    (hdle : ∀ j, d j ≤ d₀)
    (hg : initialForm (maximalIdeal R) g ∈ AssocGraded.homogeneous (maximalIdeal R) d₀)
    {T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))}
    (hT : IsTauZSubmodule R (Fin.snoc f g : Fin (i + 1) → R) T) : IsTauZSubmodule R f T := by
  classical
  obtain ⟨hT1, hspan⟩ := hT
  refine ⟨hT1, ?_⟩
  set Φ : Fin i → AssocGraded (maximalIdeal R) := fun j => initialForm (maximalIdeal R) (f j)
    with hΦ
  set Φ' : Fin (i + 1) → AssocGraded (maximalIdeal R) :=
    fun j => initialForm (maximalIdeal R) ((Fin.snoc f g : Fin (i + 1) → R) j) with hΦ'
  set K : Ideal (AssocGraded (maximalIdeal R)) := Ideal.span (Set.range Φ) with hK
  set K' : Ideal (AssocGraded (maximalIdeal R)) := Ideal.span (Set.range Φ') with hK'
  have hΦ'castSucc : ∀ j, Φ' j.castSucc = Φ j := fun j => by simp [hΦ', hΦ]
  have hΦ'last : Φ' (Fin.last i) = initialForm (maximalIdeal R) g := by simp [hΦ']
  have hKK' : K ≤ K' := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨j.castSucc, hΦ'castSucc j⟩
  have hK'le : K' ≤ K ⊔ Ideal.span {initialForm (maximalIdeal R) g} := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    refine Fin.lastCases ?_ (fun j => ?_) j
    · rw [hΦ'last]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    · rw [hΦ'castSucc]
      exact Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩)
  have hhomK : ∀ t, ∃ e, Φ t ∈ AssocGraded.homogeneous (maximalIdeal R) e := fun t => ⟨_, hd t⟩
  have hhomK' : ∀ t, ∃ e, Φ' t ∈ AssocGraded.homogeneous (maximalIdeal R) e := by
    intro t
    refine Fin.lastCases ?_ (fun j => ?_) t
    · exact ⟨d₀, by rw [hΦ'last]; exact hg⟩
    · exact ⟨d j, by rw [hΦ'castSucc]; exact hd j⟩
  -- (L1) the homogeneous elements of `K'` of degree `< d₀` lie in `K`
  have L1 : ∀ y ∈ K', ∀ d', d' < d₀ → y ∈ AssocGraded.homogeneous (maximalIdeal R) d' → y ∈ K :=
    fun y hy d' hd' hyh => AssocGraded.mem_span_range_of_mem_sup_span_singleton (maximalIdeal R)
      Φ hhomK hg (hK'le hy) hd' hyh
  -- the set `W = K' ∩ k[T]`
  set W : Set (AssocGraded (maximalIdeal R)) := (K' : Set _) ∩
    (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) : Set _)
    with hW
  have hWp : ∀ w ∈ W, ∀ e, AssocGraded.proj (maximalIdeal R) e w ∈ W := by
    intro w hw e
    exact ⟨AssocGraded.proj_mem_span_range (maximalIdeal R) Φ' hhomK' hw.1 e,
      AssocGraded.proj_mem_adjoin (maximalIdeal R) (fun s hs => hT1 hs) hw.2 e⟩
  have hW0 : (0 : AssocGraded (maximalIdeal R)) ∈ W := ⟨zero_mem _, zero_mem _⟩
  have hWa : ∀ w ∈ W, ∀ w' ∈ W, w + w' ∈ W := fun w hw w' hw' =>
    ⟨add_mem hw.1 hw'.1, add_mem hw.2 hw'.2⟩
  have hWs : ∀ c ∈ AssocGraded.homogeneous (maximalIdeal R) 0, ∀ w ∈ W, c * w ∈ W := by
    intro c hc w hw
    exact ⟨Ideal.mul_mem_left _ _ hw.1, mul_mem (by
      obtain ⟨c₀, rfl⟩ := AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero (maximalIdeal R) hc
      exact Subalgebra.algebraMap_mem _ _) hw.2⟩
  -- the conclusion
  refine le_antisymm (Ideal.span_le.mpr fun x hx => hx.1) ?_
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨j, rfl⟩
  have hφK : Φ j ∈ K := Ideal.subset_span ⟨j, rfl⟩
  have hφK' : Φ j ∈ Ideal.span W := by
    rw [show Ideal.span W = K' from hspan]
    exact hKK' hφK
  obtain ⟨B₀, w', hB₀, hw'W, -, hproj⟩ := AssocGraded.exists_proj_eq_add_of_mem_span
    (maximalIdeal R) W hWp hW0 hWa hWs hφK' (d j)
  rw [AssocGraded.proj_of_mem_homogeneous _ (hd j)] at hproj
  have hproj' : Φ j = B₀ + w' := hproj
  have hB₀K : B₀ ∈ Ideal.span ((K : Set _) ∩ (Algebra.adjoin (R ⧸ maximalIdeal R)
      (T : Set (AssocGraded (maximalIdeal R))) : Set _)) := by
    refine Ideal.span_mono ?_ hB₀
    rintro w ⟨hwW, d', hd', hwh⟩
    exact ⟨L1 w hwW.1 d' (lt_of_lt_of_le hd' (hdle j)) hwh, hwW.2⟩
  have hB₀K' : B₀ ∈ K :=
    (Ideal.span_le.mpr fun x hx => hx.1 : Ideal.span ((K : Set _) ∩ (Algebra.adjoin
      (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) : Set _)) ≤ K) hB₀K
  have hw'K : w' ∈ K := by
    have : w' = Φ j - B₀ := by rw [hproj']; ring
    rw [this]
    exact sub_mem hφK hB₀K'
  rw [hproj']
  exact add_mem hB₀K (Ideal.subset_span ⟨hw'K, hw'W.2⟩)

/-- Monotonicity of `T` (Definition 10\*) along `(f₁, …, f_i) ↦ (f₁, …, f_i, f_{i+1})`, for
initial forms of non-decreasing degrees. -/
theorem tauZSubmodule_le_snoc {i : ℕ} (f : Fin i → R) (g : R) {d : Fin i → ℕ} {d₀ : ℕ}
    (hd : ∀ j, initialForm (maximalIdeal R) (f j) ∈
      AssocGraded.homogeneous (maximalIdeal R) (d j))
    (hdle : ∀ j, d j ≤ d₀)
    (hg : initialForm (maximalIdeal R) g ∈ AssocGraded.homogeneous (maximalIdeal R) d₀) :
    tauZSubmodule R f ≤ tauZSubmodule R (Fin.snoc f g : Fin (i + 1) → R) :=
  le_sInf fun _ hT => sInf_le (isTauZSubmodule_of_snoc f g hd hdle hg hT)

end Monotone

section StandardBasePrefix

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {J : Ideal R} {m : ℕ} {σ : Fin m → R}

/-- `T` of the initial segments of a standard base increases with the length of the segment
(`T` of Definition 10\*; the initial forms have non-decreasing degrees). -/
theorem tauZSubmodule_prefix_mono (hσ : IsStandardBase R J σ) {a b : ℕ} (hab : a ≤ b)
    (hb : b ≤ m) :
    tauZSubmodule R (fun j : Fin a => σ (Fin.castLE (hab.trans hb) j)) ≤
      tauZSubmodule R (fun j : Fin b => σ (Fin.castLE hb j)) := by
  obtain ⟨-, -, ⟨d, hd, hmono⟩, -, -⟩ := hσ
  induction b, hab using Nat.le_induction with
  | base => exact le_rfl
  | succ b hab ih =>
    have hb' : b ≤ m := (Nat.le_succ b).trans hb
    refine (ih hb').trans ?_
    have hfun : (fun j : Fin (b + 1) => σ (Fin.castLE hb j)) =
        (Fin.snoc (fun j : Fin b => σ (Fin.castLE hb' j)) (σ ⟨b, hb⟩) : Fin (b + 1) → R) := by
      funext j
      refine Fin.lastCases ?_ (fun j => ?_) j
      · rw [Fin.snoc_last]
        rfl
      · simp
    rw [hfun]
    refine tauZSubmodule_le_snoc _ _ (d := fun j : Fin b => d (Fin.castLE hb' j)) (d₀ := d ⟨b, hb⟩)
      (fun j => hd _) (fun j => hmono (Fin.mk_le_of_le_val (by simp))) (hd _)

end StandardBasePrefix

section LemmaNineB

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

attribute [local instance] MvPolynomial.gradedAlgebra


/-- **Lemma 19 for the ideal of the system itself** (the core of claim (B) of Theorem 9, p. 274:
"The proof of (B) for this `f_{i+1}` can be obtained by Lemmas 18–19, §7"): let `(S; z)` be a
regular frame, `τ_{(z)}(f_j) = 0` for `j ≤ i`, `g` normalized by `(f₁, …, f_i)` with respect to
`(S; z)`, and `T` a space with the property of Definition 10* for `(f₁, …, f_i, g)` which
contains `Z₁, …, Z_r`.  Then the initial form of `g` lies in `k[T]`.  It is the proof of
`initialForm_mem_adjoin_of_isNormalizedBy` (the algebraic core `core_mem_adjoin`, Remark 2)
with the ideal `gr_M(J, R)` and the space `T*_a` replaced by `(φ₁, …, φ_i, ψ) gr_M(R)` and `T`:
the homogeneous parts of this ideal of degree `< ν_M(g)` lie in `(φ₁, …, φ_i) gr_M(R)`. -/
theorem RegularFrame.initialForm_mem_adjoin_of_isTauZSubmodule_snoc (F : RegularFrame R) {i : ℕ}
    (f : Fin i → R) (hτ : ∀ j : Fin i, tauZ R F.z (fun _ : Fin 1 => f j) = 0) (g : R)
    (h2 : F.IsNormalizedBy f g)
    {T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))}
    (hT : IsTauZSubmodule R (Fin.snoc f g : Fin (i + 1) → R) T)
    (hZ : ∀ l, frameForm F.z l ∈ T) :
    initialForm (maximalIdeal R) g ∈
      Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  by_cases hg0 : initialForm (maximalIdeal R) g = 0
  · rw [hg0]; exact zero_mem _
  have hne : Ideal.ordElem (maximalIdeal R) g ≠ ⊤ := fun h => hg0 (by
    rw [initialForm, dite_eq_left h])
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp hne
  have hordg : Ideal.ordElem (maximalIdeal R) g = n := hn.symm
  have hgν : initialForm (maximalIdeal R) g ∈ AssocGraded.homogeneous (maximalIdeal R) n := by
    rw [initialForm_eq_mk _ hordg]
    exact AssocGraded.mk_mem_homogeneous _ _
  obtain ⟨s, Θ, hΘh, hΘp, hΘZ, hΘe, -⟩ := RegularFrame.exists_transport F
  -- the initial forms `φ_j` lie in `k[Z]`: `φ_j = Θ(ψ_j(Z))`
  have hψ : ∀ j : Fin i, ∃ ψ, frameAlgHom F.z ψ = initialForm (maximalIdeal R) (f j) := by
    intro j
    have h := RegularFrame.initialForm_mem_adjoin_of_tauZ_eq_zero F (f j) (hτ j)
    rw [Algebra.adjoin_range_eq_range_aeval] at h
    exact h
  choose ψ hψ using hψ
  have hΘrename : ∀ q, Θ (rename (Fin.castAdd s) q) = frameAlgHom F.z q := by
    intro q
    have : Θ.toAlgHom.comp (rename (Fin.castAdd s)) = frameAlgHom F.z :=
      MvPolynomial.algHom_ext fun l => by
        rw [AlgHom.comp_apply, rename_X, frameAlgHom, aeval_X]
        exact hΘZ l
    exact AlgHom.congr_fun this q
  have hψI : ∀ j, ψ j ∈ frameInitialIdeal F.z f := fun j => Ideal.subset_span ⟨j, hψ j⟩
  -- `I = (φ₁, …, φ_i) k[Z]` is homogeneous
  have hI₀ : (frameInitialIdeal F.z f).IsHomogeneous
      (homogeneousSubmodule (Fin F.r) (R ⧸ maximalIdeal R)) := by
    apply Ideal.homogeneous_span
    rintro q ⟨j, hj⟩
    obtain ⟨d, hd⟩ := initialForm_mem_homogeneous_aux' (maximalIdeal R) (f j)
    refine ⟨d, ?_⟩
    have h1 : rename (Fin.castAdd s) q ∈
        homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) d :=
      (hΘh d _).mpr (by rw [hΘrename, hj]; exact hd)
    exact (IsHomogeneous.rename_isHomogeneous_iff (Fin.castAdd_injective _ _)).mp h1
  -- `T = Θ⁻¹(T)`
  have hT1 : T.comap Θ.toLinearMap ≤
      homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) 1 :=
    fun t ht => (hΘh 1 t).mpr (hT.1 ht)
  have hTZ : ∀ l, (X (Fin.castAdd s l) : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)) ∈
      T.comap Θ.toLinearMap := by
    intro l
    show Θ (X (Fin.castAdd s l)) ∈ T
    rw [hΘZ]
    exact hZ l
  have hφh : (Θ.symm (initialForm (maximalIdeal R) g)).IsHomogeneous n :=
    (hΘh _ _).mpr (by rwa [AlgEquiv.apply_symm_apply])
  -- the ideal `K' = (φ₁, …, φ_i, ψ) gr_M(R)` and `K = (φ₁, …, φ_i) gr_M(R)`
  set Φ : Fin i → AssocGraded (maximalIdeal R) := fun j => initialForm (maximalIdeal R) (f j)
    with hΦ
  set Φ' : Fin (i + 1) → AssocGraded (maximalIdeal R) :=
    fun j => initialForm (maximalIdeal R) ((Fin.snoc f g : Fin (i + 1) → R) j) with hΦ'
  have hΦ'castSucc : ∀ j, Φ' j.castSucc = Φ j := fun j => by simp [hΦ', hΦ]
  have hΦ'last : Φ' (Fin.last i) = initialForm (maximalIdeal R) g := by simp [hΦ']
  have hhomK : ∀ t, ∃ e, Φ t ∈ AssocGraded.homogeneous (maximalIdeal R) e := fun t => by
    obtain ⟨d, hd⟩ := initialForm_mem_homogeneous_aux' (maximalIdeal R) (f t)
    exact ⟨d, hd⟩
  have hhomK' : ∀ t, ∃ e, Φ' t ∈ AssocGraded.homogeneous (maximalIdeal R) e := by
    intro t
    refine Fin.lastCases ?_ (fun j => ?_) t
    · exact ⟨n, by rw [hΦ'last]; exact hgν⟩
    · rw [hΦ'castSucc]
      exact hhomK j
  have hK'le : Ideal.span (Set.range Φ') ≤
      Ideal.span (Set.range Φ) ⊔ Ideal.span {initialForm (maximalIdeal R) g} := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    refine Fin.lastCases ?_ (fun j => ?_) j
    · rw [hΦ'last]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    · rw [hΦ'castSucc]
      exact Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩)
  have hψK' : initialForm (maximalIdeal R) g ∈ Ideal.span (Set.range Φ') :=
    Ideal.subset_span ⟨Fin.last i, hΦ'last⟩
  have hφG : Θ.symm (initialForm (maximalIdeal R) g) ∈ Ideal.span
      ((Ideal.comap Θ (Ideal.span (Set.range Φ')) :
        Set (MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R))) ∩
      (Algebra.adjoin (R ⧸ maximalIdeal R) ((T.comap Θ.toLinearMap : Submodule _ _) :
        Set (MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R))) :
          Set (MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)))) := by
    refine symm_mem_span_inter_aux Θ ?_
    have := hT.2
    rw [this]
    exact hψK'
  -- the homogeneous parts of degree `< n` of the ideal lie in `(φ₁, …, φ_i) k[Z, W]`
  have hG : ∀ d < n, ∀ u ∈ Ideal.comap Θ (Ideal.span (Set.range Φ')),
      homogeneousComponent d u ∈ (frameInitialIdeal F.z f).map (rename (Fin.castAdd s)) := by
    intro d hd u hu
    have hcomp : Θ (homogeneousComponent d u) = AssocGraded.proj (maximalIdeal R) d (Θ u) :=
      (hΘp d u).symm
    have hy' : AssocGraded.proj (maximalIdeal R) d (Θ u) ∈ Ideal.span (Set.range Φ') :=
      AssocGraded.proj_mem_span_range (maximalIdeal R) Φ' hhomK' hu d
    have hyK : AssocGraded.proj (maximalIdeal R) d (Θ u) ∈ Ideal.span (Set.range Φ) :=
      AssocGraded.mem_span_range_of_mem_sup_span_singleton (maximalIdeal R) Φ hhomK hgν
        (hK'le hy') hd (AssocGraded.proj_mem_homogeneous (maximalIdeal R) d (Θ u))
    have key : ∀ v ∈ Ideal.span (Set.range Φ),
        Θ.symm v ∈ (frameInitialIdeal F.z f).map (rename (Fin.castAdd s)) := by
      intro v hv
      induction hv using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨j, rfl⟩ := hv
        have : Θ.symm (Φ j) = rename (Fin.castAdd s) (ψ j) := by
          have h1 : Φ j = initialForm (maximalIdeal R) (f j) := rfl
          rw [h1, ← hψ j, ← hΘrename, AlgEquiv.symm_apply_apply]
        rw [this]
        exact Ideal.mem_map_of_mem _ (hψI j)
      | zero => rw [map_zero]; exact zero_mem _
      | add v w _ _ hv hw => rw [map_add]; exact add_mem hv hw
      | smul c v _ hv => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hv
    have := key _ hyK
    rwa [← hcomp, AlgEquiv.symm_apply_apply] at this
  -- no monomial of `φ` has its `Z`-part in `E` (normalization)
  have hE : ∀ B ∈ (Θ.symm (initialForm (maximalIdeal R) g)).support,
      zPart B ∉ ESet (frameInitialIdeal F.z f) := by
    intro B hB hBE
    obtain ⟨B', -, hB'0, hBB'⟩ := hΘe g _ hordg B hB
    rw [hBB'] at hBE
    have h := h2 (expansion F) (isExpansion_expansion F) ⇑B' hBE
    rw [psCoeff, Finsupp.equivFunOnFinite_symm_coe, coeff_expansion] at h
    exact hB'0 h
  have hcore := core_mem_adjoin _ _ hI₀ _ hT1 hTZ _ _ hφh hφG hG hE
  -- back to `gr_M(R)`
  have h3 : Θ (Θ.symm (initialForm (maximalIdeal R) g)) ∈
      (Algebra.adjoin (R ⧸ maximalIdeal R) (T.comap Θ.toLinearMap :
        Set (MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)))).map
          Θ.toAlgHom := Subalgebra.mem_map.mpr ⟨_, hcore, rfl⟩
  rw [AlgHom.map_adjoin, AlgEquiv.apply_symm_apply] at h3
  refine Algebra.adjoin_mono ?_ h3
  rintro _ ⟨t, ht, rfl⟩
  exact ht

end LemmaNineB


section StageSnoc

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {J : Ideal R} {i : ℕ} {f : Fin i → R}
  {g : R}

/-- The orders of the members of a system extendable to a standard base are the characters
`ν^{(j)}(J)`. -/
theorem ordElem_snoc_eq_nuI (hext : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R))
    (j : Fin (i + 1)) :
    Ideal.ordElem (maximalIdeal R) ((Fin.snoc f g : Fin (i + 1) → R) j) =
      nuI R J (j : ℕ).succPNat := by
  obtain ⟨m, σ, him, hσ, hσf⟩ := hext
  have := ordElem_eq_nuI_of_isStandardBase J σ hσ (Fin.castLE him j)
  rw [hσf] at this
  simpa using this

/-- The degrees of the initial forms of a system extendable to a standard base are
non-decreasing. -/
theorem exists_degrees_snoc (hext : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R)) :
    ∃ (d : Fin i → ℕ) (d₀ : ℕ),
      (∀ j, initialForm (maximalIdeal R) (f j) ∈ AssocGraded.homogeneous (maximalIdeal R) (d j)) ∧
      (∀ j, d j ≤ d₀) ∧
      initialForm (maximalIdeal R) g ∈ AssocGraded.homogeneous (maximalIdeal R) d₀ := by
  obtain ⟨m, σ, him, hσ, hσf⟩ := hext
  obtain ⟨-, -, ⟨d, hd, hmono⟩, -, -⟩ := hσ
  refine ⟨fun j => d (Fin.castLE him j.castSucc), d (Fin.castLE him (Fin.last i)),
    fun j => ?_, fun j => ?_, ?_⟩
  · have := hd (Fin.castLE him j.castSucc)
    simp only [hσf, Fin.snoc_castSucc] at this
    exact this
  · exact hmono (Fin.mk_le_of_le_val (by simp))
  · have := hd (Fin.castLE him (Fin.last i))
    simp only [hσf, Fin.snoc_last] at this
    exact this

end StageSnoc

section StageExtras

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {J : Ideal R} {i : ℕ} {f : Fin i → R}
  {g : R}

/-- `T` of the empty system is zero. -/
theorem tauZSubmodule_nil (f : Fin 0 → R) : tauZSubmodule R f = ⊥ := by
  refine le_bot_iff.mp (sInf_le ⟨bot_le, ?_⟩)
  simp [Set.range_eq_empty]

/-- The orders of the members of a system extendable to a standard base are non-decreasing. -/
theorem ordElem_le_ordElem_last
    (hext : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R)) (j : Fin i) :
    Ideal.ordElem (maximalIdeal R) (f j) ≤ Ideal.ordElem (maximalIdeal R) g := by
  have h1 := ordElem_snoc_eq_nuI hext j.castSucc
  have h2 := ordElem_snoc_eq_nuI hext (Fin.last i)
  rw [Fin.snoc_castSucc] at h1
  rw [Fin.snoc_last] at h2
  rw [h1, h2]
  refine nuI_mono J ?_
  rw [← PNat.coe_le_coe]
  simp only [Nat.succPNat_coe, Fin.val_castSucc, Fin.val_last]
  omega

end StageExtras

section TSnoc

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {J : Ideal R} {i : ℕ} {f : Fin i → R}
  {g : R}

/-- **`T(f₁, …, f_{i+1}) = T*_{(z)}(f_{i+1})`** (the equality of condition (3) in the proof of
Theorem 9, p. 273: `τ(f₁, …, f_{i+1}) = r + τ_{(z)}(f_{i+1})`): for `g` normalized by
`(f₁, …, f_i)`, `τ_{(z)}(f_j) = 0` for `j ≤ i`, `(f₁, …, f_i, g)` extendable to a standard base
and `Z₁, …, Z_r ∈ T(f₁, …, f_i)`. -/
theorem tauZSubmodule_snoc_eq (F : RegularFrame R)
    (hτf : ∀ j : Fin i, tauZ R F.z (fun _ : Fin 1 => f j) = 0) (hnorm : F.IsNormalizedBy f g)
    (hext : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R))
    (hZ : ∀ l, frameForm F.z l ∈ tauZSubmodule R f) :
    tauZSubmodule R (Fin.snoc f g : Fin (i + 1) → R) =
      tauZSubmoduleStar R F.z (fun _ : Fin 1 => g) := by
  obtain ⟨d, d₀, hd, hdle, hg⟩ := exists_degrees_snoc hext
  have hmono := tauZSubmodule_le_snoc f g hd hdle hg
  have hZ' : ∀ l, frameForm F.z l ∈ tauZSubmodule R (Fin.snoc f g : Fin (i + 1) → R) :=
    fun l => hmono (hZ l)
  obtain ⟨hli, hord⟩ := linearIndependent_frameForm F.z_injective F.extends_rsop
  apply le_antisymm
  · refine tauZSubmodule_le_of_forall_mem_adjoin _ _ (tauZSubmoduleStar_le_homogeneous_one hord)
      (fun j => ?_)
    refine Fin.lastCases ?_ (fun j => ?_) j
    · simpa using initialForm_mem_adjoin_tauZSubmoduleStar F.z g
    · have h := RegularFrame.initialForm_mem_adjoin_of_tauZ_eq_zero F (f j) (hτf j)
      simp only [Fin.snoc_castSucc]
      refine Algebra.adjoin_mono ?_ h
      rintro _ ⟨l, rfl⟩
      exact Submodule.mem_sup_right (Submodule.subset_span ⟨l, rfl⟩)
  · refine sup_le ?_ (Submodule.span_le.mpr ?_)
    · refine tauZSubmodule_le_of_mem_adjoin g _ (tauZSubmodule_spec R _).1 ?_
      exact RegularFrame.initialForm_mem_adjoin_of_isTauZSubmodule_snoc F f hτf g hnorm
        (tauZSubmodule_spec R _) hZ'
    · rintro _ ⟨l, rfl⟩
      exact hZ' l

/-- `T` of a standard base is `T_t(J)` (Definition 7, `t = t(J)`). -/
theorem tauZSubmodule_eq_tauSubmodule_t {m : ℕ} {σ : Fin m → R} (hσ : IsStandardBase R J σ)
    (hm : 0 < m) : tauZSubmodule R σ = tauSubmodule R J (t R J) := by
  have ht1 := one_le_t_of_isStandardBase hσ hm
  obtain ⟨m', hm', -, hhigh, heq, -⟩ :=
    exists_prefix_tauZSubmodule_eq_tauSubmodule J σ hσ ht1 le_rfl
  have hmm : m' = m := by
    by_contra hne
    have hlt : m' < m := lt_of_le_of_ne hm' hne
    exact absurd (ordElem_le_mu_t J hσ ⟨m', hlt⟩) (not_le.mpr (hhigh ⟨m', hlt⟩ le_rfl))
  subst hmm
  rw [← heq]
  rfl

/-- `T(f₁, …, f_{i+1}) ≤ T_t(J)` for a system extendable to a standard base. -/
theorem tauZSubmodule_snoc_le_tauSubmodule_t
    (hext : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R)) :
    tauZSubmodule R (Fin.snoc f g : Fin (i + 1) → R) ≤ tauSubmodule R J (t R J) := by
  obtain ⟨m, σ, him, hσ, hσf⟩ := hext
  have h1 := tauZSubmodule_prefix_mono hσ him le_rfl
  have hfun : (fun j : Fin (i + 1) => σ (Fin.castLE (him.trans le_rfl) j)) =
      (Fin.snoc f g : Fin (i + 1) → R) := funext hσf
  rw [hfun] at h1
  have hm : 0 < m := lt_of_lt_of_le (Nat.succ_pos i) him
  rw [← tauZSubmodule_eq_tauSubmodule_t hσ hm]
  exact h1

end TSnoc

section OneStepAux

attribute [local instance] RegularFrame.isDomain_S
attribute [local instance] Ideal.Quotient.field

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- `ExtendsToStandardBase` is inherited by initial segments. -/
theorem ExtendsToStandardBase.of_snoc {J : Ideal R} {i : ℕ} {f : Fin i → R} {g : R}
    (h : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R)) : ExtendsToStandardBase J f := by
  obtain ⟨m, σ, him, hσ, hσf⟩ := h
  refine ⟨m, σ, (Nat.le_succ i).trans him, hσ, fun j => ?_⟩
  have := hσf j.castSucc
  rw [Fin.snoc_castSucc] at this
  exact this

/-- (11) of Lemma 21: if `Z₁, …, Z_r ∈ T(f)` and `τ_{(z)}(f_j) = 0`, then `τ(f₁, …, f_i) = r`. -/
theorem tauZ_empty_eq_of_mem {F : RegularFrame R} {i : ℕ} {f : Fin i → R}
    (h2 : ∀ j, tauZ R F.z (fun _ : Fin 1 => f j) = 0)
    (hZ : ∀ l, frameForm F.z l ∈ tauZSubmodule R f) : tauZ R (![] : Fin 0 → R) f = F.r := by
  classical
  obtain ⟨hli, hord⟩ := linearIndependent_frameForm F.z_injective F.extends_rsop
  have hle : tauZSubmodule R f ≤ Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) := by
    refine tauZSubmodule_le_of_forall_mem_adjoin f _ ?_ fun j => ?_
    · rw [Submodule.span_le]
      rintro _ ⟨l, rfl⟩
      show initialForm (maximalIdeal R) (F.z l) ∈ _
      rw [initialForm_eq_mk _ (hord l)]
      exact AssocGraded.mk_mem_homogeneous _ _
    · exact Algebra.adjoin_mono Submodule.subset_span
        (RegularFrame.initialForm_mem_adjoin_of_tauZ_eq_zero F (f j) (h2 j))
  have hge : Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) ≤
      tauZSubmodule R f := Submodule.span_le.mpr (by rintro _ ⟨l, rfl⟩; exact hZ l)
  rw [tauZ_empty, le_antisymm hle hge, finrank_span_eq_card hli, Fintype.card_fin]

end OneStepAux


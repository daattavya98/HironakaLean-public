/-!
# Generic coordinates and the Weierstrass form of a finite family of power series

Ch. IV, §3, p. 297 (construction of the regular frame `(T; z)` of `Ŝ`), condition `[c]`: a
`J_j`-stable standard base `(g_{j1}, …, g_{jm_j})` can be written
`g_{jk} = u_{jk}(z^{ν_{jk}} + g_{jk1} z^{ν_{jk}-1} + ⋯ + g_{jkν_{jk}})`, `u_{jk}` a unit of `Ŝ` and
`g_{jki} ∈ T`.  The paper obtains this from Cohen's structure theorem, `Ŝ = k{z, y₁, …, y_{N-1}}`:

> By replacing `y_j` by `y_j + c_j z` with suitable `c_j ∈ k` `(1 ≤ j ≤ N − 1)`, we may assume that
> all the `g_{jk}` can be written in the form described in [c], where `T = k{y₁, …, y_{N−1}}`.

(p. 297.)  The paper gives no argument for "suitable `c_j`".  This
file proves the statement for the concrete ring `k[[z, y₁, …, y_n]]` over a field of
characteristic `0` (`exists_generic_weierstrass_form`): (1) the initial forms `F_i` of the `g_i`
are homogeneous, so `F_i(1, c) ≠ 0` for all `i` for some `c ∈ kⁿ` since `k` is infinite
(`exists_generic_coordinates`); (2) for such `c` the shifted series `g_i(z, y + c z)` has order
exactly `ν_i` and a non-zero `z^{ν_i}`-coefficient at `y = 0`; (3) the Weierstrass preparation
theorem of Mathlib over the complete local ring `k[[y]]` (`exists_weierstrass_form`) gives the unit
and the distinguished polynomial; the coefficients `a_l` have order `≥ l`.
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

section MaximalIdeal

variable {k : Type u} [Field k]

/-- The maximal ideal of `k[[y₁, …, y_n]]` is generated by the variables (used to apply Mathlib's
completeness instance for `span (range X)` to the maximal ideal). -/
theorem maximalIdeal_mvPowerSeries_eq_span_X (n : ℕ) :
    maximalIdeal (MvPowerSeries (Fin n) k) = Ideal.span (Set.range (MvPowerSeries.X : Fin n →
      MvPowerSeries (Fin n) k)) := by
  induction n with
  | zero =>
    apply le_antisymm
    · intro f hf
      have hf0 : MvPowerSeries.constantCoeff f = 0 := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
          isUnit_iff_ne_zero, not_not] at hf
        exact hf
      have : f = 0 := by
        ext d
        have hd : d = 0 := Subsingleton.elim _ _
        rw [hd, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hf0]; simp
      rw [this]; exact zero_mem _
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact i.elim0
  | succ n ih =>
    set A := MvPowerSeries (Fin n) k with hA
    let Φ : MvPowerSeries (Fin (n + 1)) k ≃+* PowerSeries A :=
      (MvPowerSeries.finSuccEquiv k n).toRingEquiv
    have hmax : maximalIdeal (PowerSeries A) = (maximalIdeal (MvPowerSeries (Fin (n + 1)) k)).map Φ :=
      (IsLocalRing.map_ringEquiv_maximalIdeal Φ).symm
    have hXI : (PowerSeries.X : PowerSeries A) ∈ maximalIdeal (PowerSeries A) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
      simp
    have hI : (maximalIdeal (PowerSeries A)).map (PowerSeries.constantCoeff (R := A)) =
        maximalIdeal A := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro f hf
        rw [Ideal.mem_comap]
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hf ⊢
        exact fun h => hf (PowerSeries.isUnit_iff_constantCoeff.mpr h)
      · intro y hy
        have : (PowerSeries.C y : PowerSeries A) ∈ maximalIdeal (PowerSeries A) := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
          simpa using hy
        simpa using Ideal.mem_map_of_mem (PowerSeries.constantCoeff (R := A)) this
    have key := PowerSeries.eq_span_insert_X_of_X_mem_of_span_eq (I := maximalIdeal (PowerSeries A))
      (S := Set.range (MvPowerSeries.X : Fin n → A)) hXI (by rw [hI, ← ih])
    have hP : maximalIdeal (MvPowerSeries (Fin (n + 1)) k) =
        (maximalIdeal (PowerSeries A)).map Φ.symm := by
      rw [Ideal.map_symm, hmax]
      exact (Ideal.comap_map_of_bijective (f := Φ.toRingHom) Φ.bijective).symm
    rw [hP, key, Ideal.map_span]
    congr 1
    have h0 : Φ.symm (PowerSeries.X : PowerSeries A) = MvPowerSeries.X 0 :=
      (Φ.symm_apply_eq).mpr (MvPowerSeries.finSuccEquiv_X_zero).symm
    have h1 : ∀ j : Fin n, Φ.symm (PowerSeries.C (MvPowerSeries.X j : A)) =
        MvPowerSeries.X j.succ := fun j =>
      (Φ.symm_apply_eq).mpr (MvPowerSeries.finSuccEquiv_X_succ j).symm
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      rcases hy with rfl | ⟨_, ⟨j, rfl⟩, rfl⟩
      · exact ⟨0, h0.symm⟩
      · exact ⟨j.succ, (h1 j).symm⟩
    · rintro ⟨i, rfl⟩
      refine Fin.cases ?_ (fun j => ?_) i
      · exact ⟨PowerSeries.X, Or.inl rfl, h0⟩
      · exact ⟨_, Or.inr ⟨_, ⟨j, rfl⟩, rfl⟩, h1 j⟩

instance isAdicComplete_maximalIdeal_mvPowerSeries (n : ℕ) :
    IsAdicComplete (maximalIdeal (MvPowerSeries (Fin n) k)) (MvPowerSeries (Fin n) k) := by
  rw [maximalIdeal_mvPowerSeries_eq_span_X]
  infer_instance

end MaximalIdeal

section Preparation

theorem degree_cons {n : ℕ} (a : ℕ) (β : Fin n →₀ ℕ) :
    (Finsupp.cons a β).degree = a + β.degree := by
  rw [Finsupp.degree_eq_sum, Finsupp.degree_eq_sum, Fin.sum_univ_succ]
  simp [Finsupp.cons_zero, Finsupp.cons_succ]

variable {k : Type u} [Field k]

open PowerSeries in
/-- Weierstrass step (Mathlib's preparation theorem over the complete local ring `k[[y]]`): a power series `h` in `z, y₁..y_n` of order `≥ ν` with a non-zero
coefficient at `z^ν` is `u · (z^ν + ∑ a_l z^{ν-l-1})` with `a_l ∈ k[[y]]` of order `≥ l+1`. -/
theorem exists_weierstrass_form (n ν : ℕ) (h : MvPowerSeries (Fin (n + 1)) k)
    (hord : (ν : ℕ∞) ≤ h.order) (hcoeff : MvPowerSeries.coeff (Finsupp.cons ν 0) h ≠ 0) :
    ∃ (u : (MvPowerSeries (Fin (n + 1)) k)ˣ) (f : Polynomial (MvPowerSeries (Fin n) k)),
      f.Monic ∧ f.natDegree = ν ∧
      h = u * (MvPowerSeries.finSuccEquiv k n).symm (f : PowerSeries (MvPowerSeries (Fin n) k)) ∧
      ∀ e < ν, ((ν - e : ℕ) : ℕ∞) ≤ (f.coeff e).order := by
  classical
  set A := MvPowerSeries (Fin n) k with hA
  set Φ := MvPowerSeries.finSuccEquiv k n with hΦ
  set G : PowerSeries A := Φ h with hG
  have hcc : ∀ d : ℕ, MvPowerSeries.constantCoeff (PowerSeries.coeff d G) =
      MvPowerSeries.coeff (Finsupp.cons d 0) h := by
    intro d
    rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hG, MvPowerSeries.coeff_coeff_finSuccEquiv]
  have hresz : ∀ x : A, IsLocalRing.residue A x = 0 ↔ MvPowerSeries.constantCoeff x = 0 := by
    intro x
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      MvPowerSeries.isUnit_iff_constantCoeff, isUnit_iff_ne_zero, not_not]
  have hlow : ∀ d < ν, PowerSeries.coeff d G ∈ maximalIdeal A := by
    intro d hd
    rw [← IsLocalRing.residue_eq_zero_iff, hresz, hcc]
    refine MvPowerSeries.coeff_of_lt_order ?_
    refine lt_of_lt_of_le ?_ hord
    rw [degree_cons]
    simp only [map_zero, add_zero]
    exact_mod_cast hd
  have hord' : (G.map (IsLocalRing.residue A)).order = ν := by
    rw [PowerSeries.order_eq_nat]
    refine ⟨?_, fun i hi => ?_⟩
    · rw [PowerSeries.coeff_map, Ne, hresz, hcc]; exact hcoeff
    · rw [PowerSeries.coeff_map, (IsLocalRing.residue_eq_zero_iff _).mpr (hlow i hi)]
  have hne : G.map (IsLocalRing.residue A) ≠ 0 := by
    intro h0
    rw [h0] at hord'
    simp at hord'
  obtain ⟨f, U, H⟩ := PowerSeries.exists_isWeierstrassFactorization hne
  have hm : f.Monic := H.isDistinguishedAt.monic
  have hdeg : f.natDegree = ν := by
    have h1 := H.natDegree_eq_toNat_order_map_of_ne_top (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    rw [h1]
    have : (G.map (Ideal.Quotient.mk (maximalIdeal A))).order = ν := hord'
    rw [this]; rfl
  have hunit : IsUnit (Φ.symm U) := H.isUnit.map Φ.symm
  have hhU : h = Φ.symm (f : PowerSeries A) * Φ.symm U := by
    rw [← map_mul, ← H.eq_mul, hG]; simp
  refine ⟨hunit.unit, f, hm, hdeg, ?_, ?_⟩
  · rw [hhU, mul_comm]; rfl
  · intro e he
    set F := Φ.symm (f : PowerSeries A) with hF
    have hFord : (ν : ℕ∞) ≤ F.order := by
      have hh : h = (hunit.unit : MvPowerSeries (Fin (n + 1)) k) * F := by
        rw [hhU, mul_comm]; rfl
      have : F = ((hunit.unit⁻¹ : (MvPowerSeries (Fin (n + 1)) k)ˣ) :
          MvPowerSeries (Fin (n + 1)) k) * h := by
        rw [hh, ← mul_assoc, Units.inv_mul, one_mul]
      rw [this]
      exact hord.trans (le_trans le_add_self MvPowerSeries.le_order_mul)
    apply MvPowerSeries.nat_le_order
    intro β hβ
    have h1 : MvPowerSeries.coeff β (f.coeff e) = MvPowerSeries.coeff (Finsupp.cons e β) F := by
      rw [hF, ← MvPowerSeries.coeff_coeff_finSuccEquiv]
      simp [hΦ]
    rw [h1]
    refine MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le ?_ hFord)
    rw [degree_cons]
    exact_mod_cast (by omega : e + β.degree < ν)

end Preparation

section Shift

variable {k : Type u} [Field k] {n : ℕ}

/-- The substitution data `z ↦ z`, `y_j ↦ y_j + c_j z`. -/
noncomputable def genericShiftData (c : Fin n → k) :
    Fin (n + 1) → MvPowerSeries (Fin (n + 1)) k :=
  Fin.cons (MvPowerSeries.X 0)
    (fun j => MvPowerSeries.X j.succ + MvPowerSeries.C (c j) * MvPowerSeries.X 0)

theorem constantCoeff_genericShiftData (c : Fin n → k) (s : Fin (n + 1)) :
    MvPowerSeries.constantCoeff (genericShiftData c s) = 0 := by
  refine Fin.cases ?_ (fun j => ?_) s <;> simp [genericShiftData]

theorem hasSubst_genericShiftData (c : Fin n → k) :
    MvPowerSeries.HasSubst (genericShiftData c) :=
  MvPowerSeries.hasSubst_of_constantCoeff_zero (constantCoeff_genericShiftData c)

/-- The `k`-algebra endomorphism `z ↦ z`, `y_j ↦ y_j + c_j z` of `k[[z, y₁, …, y_n]]`. -/
noncomputable def genericShift (c : Fin n → k) :
    MvPowerSeries (Fin (n + 1)) k →ₐ[k] MvPowerSeries (Fin (n + 1)) k :=
  MvPowerSeries.substAlgHom (hasSubst_genericShiftData c)

theorem genericShift_apply (c : Fin n → k) (f : MvPowerSeries (Fin (n + 1)) k) :
    genericShift c f = MvPowerSeries.subst (genericShiftData c) f :=
  MvPowerSeries.substAlgHom_apply _ f

theorem genericShiftData_zero (c : Fin n → k) :
    genericShiftData c 0 = MvPowerSeries.X 0 := by
  simp [genericShiftData]

theorem genericShiftData_succ (c : Fin n → k) (j : Fin n) :
    genericShiftData c j.succ = MvPowerSeries.X j.succ + MvPowerSeries.C (c j) * MvPowerSeries.X 0 := by
  simp [genericShiftData]

theorem genericShift_neg_genericShift (c : Fin n → k) (f : MvPowerSeries (Fin (n + 1)) k) :
    genericShift (-c) (genericShift c f) = f := by
  unfold genericShift
  rw [MvPowerSeries.substAlgHom_comp_substAlgHom_apply]
  have hb := hasSubst_genericShiftData (-c)
  have : (fun s => MvPowerSeries.substAlgHom hb (genericShiftData c s)) =
      (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) k) := by
    funext s
    refine Fin.cases ?_ (fun j => ?_) s
    · rw [genericShiftData_zero, MvPowerSeries.substAlgHom_apply, MvPowerSeries.subst_X hb,
        genericShiftData_zero]
    · rw [genericShiftData_succ, MvPowerSeries.substAlgHom_apply, MvPowerSeries.subst_add hb,
        MvPowerSeries.subst_mul hb, MvPowerSeries.subst_X hb, MvPowerSeries.subst_X hb,
        MvPowerSeries.subst_C, genericShiftData_succ, genericShiftData_zero]
      simp
  rw [MvPowerSeries.substAlgHom_apply, this, MvPowerSeries.subst_self]
  rfl

theorem genericShift_bijective (c : Fin n → k) : Function.Bijective (genericShift c) := by
  refine ⟨Function.LeftInverse.injective (g := genericShift (-c)) fun f =>
    genericShift_neg_genericShift c f, Function.RightInverse.surjective
    (g := genericShift (-c)) fun f => ?_⟩
  simpa using genericShift_neg_genericShift (-c) f

theorem le_order_prod_pow {σ τ : Type*} {a : σ → MvPowerSeries τ k}
    (ha : ∀ s, MvPowerSeries.constantCoeff (a s) = 0) (d : σ →₀ ℕ) :
    ((Finsupp.degree d : ℕ) : ℕ∞) ≤ (d.prod fun s e => a s ^ e).order := by
  classical
  unfold Finsupp.prod
  refine le_trans ?_ (MvPowerSeries.le_order_prod _ _)
  show ((∑ i ∈ d.support, d i : ℕ) : ℕ∞) ≤ _
  rw [Nat.cast_sum]
  refine Finset.sum_le_sum fun s _ => ?_
  have := MvPowerSeries.le_order_pow_of_constantCoeff_eq_zero (f := a s) (d s) (ha s)
  exact this

theorem le_order_genericShift (c : Fin n → k) (f : MvPowerSeries (Fin (n + 1)) k) :
    f.order ≤ (genericShift c f).order := by
  apply MvPowerSeries.le_order
  intro e he
  rw [genericShift_apply, MvPowerSeries.coeff_subst (hasSubst_genericShiftData c)]
  refine finsum_eq_zero_of_forall_eq_zero fun d => ?_
  by_cases hd : MvPowerSeries.coeff d f = 0
  · simp [hd]
  · have h1 : f.order ≤ (Finsupp.degree d : ℕ) := MvPowerSeries.order_le hd
    have h2 := le_order_prod_pow (constantCoeff_genericShiftData c) d
    rw [MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le he (h1.trans h2)), smul_zero]

end Shift

section Homogeneous

variable {k : Type u} [Field k] {m : ℕ}

theorem eval_smul_of_isHomogeneous {F : MvPolynomial (Fin m) k} {ν : ℕ}
    (hF : F.IsHomogeneous ν) (t : k) (x : Fin m → k) :
    MvPolynomial.eval (t • x) F = t ^ ν * MvPolynomial.eval x F := by
  rw [MvPolynomial.eval_eq', MvPolynomial.eval_eq', Finset.mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg : d.degree = ν := by
    by_contra h
    exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
  have : ∏ i, ((t • x) i) ^ d i = t ^ ν * ∏ i, x i ^ d i := by
    simp only [Pi.smul_apply, smul_eq_mul, mul_pow, Finset.prod_mul_distrib,
      Finset.prod_pow_eq_pow_sum]
    rw [← hdeg, Finsupp.degree_eq_sum]
  rw [this]; ring

theorem eval₂_C_mul_X_of_isHomogeneous {F : MvPolynomial (Fin m) k} {ν : ℕ}
    (hF : F.IsHomogeneous ν) (x : Fin m → k) :
    MvPolynomial.eval₂ (PowerSeries.C : k →+* PowerSeries k)
        (fun s => PowerSeries.C (x s) * PowerSeries.X) F =
      PowerSeries.C (MvPolynomial.eval x F) * PowerSeries.X ^ ν := by
  rw [MvPolynomial.eval₂_eq', MvPolynomial.eval_eq', map_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg : d.degree = ν := by
    by_contra h
    exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
  simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, map_mul, map_prod,
    map_pow]
  rw [← hdeg, Finsupp.degree_eq_sum]
  ring

end Homogeneous

section Coefficient

variable {k : Type u} [Field k] {n : ℕ}

/-- Setting `y = 0`: `k[[z, y]] → k[[z]]`. -/
noncomputable def evalY0 (k : Type u) [Field k] (n : ℕ) :
    MvPowerSeries (Fin (n + 1)) k →+* PowerSeries k :=
  (PowerSeries.map (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) k →+* k)).comp
    (MvPowerSeries.finSuccEquiv k n).toRingEquiv.toRingHom

theorem coeff_evalY0 (p : MvPowerSeries (Fin (n + 1)) k) (d : ℕ) :
    PowerSeries.coeff d (evalY0 k n p) = MvPowerSeries.coeff (Finsupp.cons d 0) p := by
  simp only [evalY0, RingHom.comp_apply, PowerSeries.coeff_map]
  rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, ← MvPowerSeries.coeff_coeff_finSuccEquiv]
  rfl

theorem evalY0_X_zero : evalY0 k n (MvPowerSeries.X 0) = PowerSeries.X := by
  simp [evalY0]

theorem evalY0_X_succ (j : Fin n) : evalY0 k n (MvPowerSeries.X j.succ) = 0 := by
  simp [evalY0]

theorem evalY0_C (a : k) : evalY0 k n (MvPowerSeries.C a) = PowerSeries.C a := by
  simp [evalY0]

theorem evalY0_algebraMap (a : k) : evalY0 k n (algebraMap k _ a) = PowerSeries.C a := by
  rw [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self_apply]
  exact evalY0_C a

/-- The coefficient of `z^ν` (at `y = 0`) of the shift of a homogeneous polynomial is its value at
`(1, c)`. -/
theorem coeff_genericShift_homogeneous (c : Fin n → k) {ν : ℕ} {F : MvPolynomial (Fin (n + 1)) k}
    (hF : F.IsHomogeneous ν) :
    MvPowerSeries.coeff (Finsupp.cons ν 0) (genericShift c (F : MvPowerSeries (Fin (n + 1)) k)) =
      MvPolynomial.eval (Fin.cons 1 c : Fin (n + 1) → k) F := by
  rw [← coeff_evalY0, genericShift_apply, MvPowerSeries.subst_coe, MvPolynomial.aeval_def,
    MvPolynomial.eval₂_comp_left (evalY0 k n)]
  have h1 : (evalY0 k n).comp (algebraMap k (MvPowerSeries (Fin (n + 1)) k)) =
      (PowerSeries.C : k →+* PowerSeries k) := by
    exact RingHom.ext fun a => evalY0_algebraMap a
  have h2 : (evalY0 k n ∘ genericShiftData c) =
      fun s => PowerSeries.C ((Fin.cons 1 c : Fin (n + 1) → k) s) * PowerSeries.X := by
    funext s
    refine Fin.cases ?_ (fun j => ?_) s
    · simp [genericShiftData, evalY0_X_zero]
    · simp [genericShiftData, evalY0_X_succ, evalY0_C, evalY0_X_zero]
  rw [h1, h2, eval₂_C_mul_X_of_isHomogeneous hF, PowerSeries.coeff_C_mul_X_pow]
  simp

end Coefficient

section Generic

variable {k : Type u} [Field k] {n : ℕ}

/-- The initial form (homogeneous component of degree `ν`) of a power series, as a polynomial. -/
noncomputable def leadingForm (ν : ℕ) (g : MvPowerSeries (Fin (n + 1)) k) :
    MvPolynomial (Fin (n + 1)) k :=
  MvPowerSeries.truncTotal (ν + 1) (MvPowerSeries.homogeneousComponent ν g)

theorem coeff_leadingForm (ν : ℕ) (g : MvPowerSeries (Fin (n + 1)) k) (d : Fin (n + 1) →₀ ℕ) :
    (leadingForm ν g).coeff d = if d.degree = ν then MvPowerSeries.coeff d g else 0 := by
  rw [leadingForm, MvPowerSeries.coeff_truncTotal_eq_ite, MvPowerSeries.coeff_homogeneousComponent]
  by_cases h : d.degree = ν
  · simp [h]
  · by_cases h' : d.degree < ν + 1
    · simp [h, h']
    · simp [h, h']

theorem isHomogeneous_leadingForm (ν : ℕ) (g : MvPowerSeries (Fin (n + 1)) k) :
    (leadingForm ν g).IsHomogeneous ν := by
  intro d hd
  rw [coeff_leadingForm] at hd
  split_ifs at hd with h
  · show Finsupp.weight (fun _ => 1) d = ν
    rw [← Finsupp.degree_eq_weight_one]; exact h
  · exact absurd rfl hd

theorem leadingForm_ne_zero (g : MvPowerSeries (Fin (n + 1)) k) (hg : g ≠ 0) :
    leadingForm g.order.toNat g ≠ 0 := by
  have hfin : g.order.toNat = g.order := MvPowerSeries.ne_zero_iff_order_finite.mp hg
  obtain ⟨d, hd, hdeg⟩ := MvPowerSeries.exists_coeff_ne_zero_and_order hfin
  intro h0
  have hdeg' : d.degree = g.order.toNat := by exact_mod_cast hdeg.trans hfin.symm
  have h1 := coeff_leadingForm g.order.toNat g d
  simp only [hdeg', ite_true, h0] at h1
  rw [show (0 : MvPolynomial (Fin (n + 1)) k).coeff d = 0 from by simp] at h1
  exact hd h1.symm

theorem succ_le_order_sub_leadingForm (g : MvPowerSeries (Fin (n + 1)) k) (hg : g ≠ 0) :
    ((g.order.toNat + 1 : ℕ) : ℕ∞) ≤
      (g - (leadingForm g.order.toNat g : MvPowerSeries (Fin (n + 1)) k)).order := by
  have hfin : g.order.toNat = g.order := MvPowerSeries.ne_zero_iff_order_finite.mp hg
  apply MvPowerSeries.le_order
  intro d hd
  rw [map_sub, MvPolynomial.coeff_coe, coeff_leadingForm]
  have hd' : d.degree < g.order.toNat + 1 := by exact_mod_cast hd
  by_cases h : d.degree = g.order.toNat
  · simp [h]
  · simp only [h, ite_false, sub_zero]
    refine MvPowerSeries.coeff_of_lt_order ?_
    rw [← hfin]
    exact_mod_cast (by omega : d.degree < g.order.toNat)

/-- Generic coordinates: for finitely many non-zero power series over an infinite field there is
a point `(1, c)` at which no initial form vanishes (the homogeneous polynomial
`∏ F_i · z` is non-zero, hence non-zero at some point with `z ≠ 0`; scale it to `z = 1`). -/
theorem exists_generic_coordinates [Infinite k] {m : ℕ} (g : Fin m → MvPowerSeries (Fin (n + 1)) k)
    (hg : ∀ i, g i ≠ 0) :
    ∃ c : Fin n → k, ∀ i, MvPolynomial.eval (Fin.cons 1 c : Fin (n + 1) → k)
      (leadingForm (g i).order.toNat (g i)) ≠ 0 := by
  classical
  set F : Fin m → MvPolynomial (Fin (n + 1)) k := fun i => leadingForm (g i).order.toNat (g i)
    with hF
  have hFh : ∀ i, (F i).IsHomogeneous (g i).order.toNat := fun i =>
    isHomogeneous_leadingForm _ _
  have hF0 : ∀ i, F i ≠ 0 := fun i => leadingForm_ne_zero _ (hg i)
  have hQh : (∏ i, (F i * MvPolynomial.X 0)).IsHomogeneous
      (∑ i, ((g i).order.toNat + 1)) :=
    MvPolynomial.IsHomogeneous.prod _ _ _ fun i _ => (hFh i).mul (MvPolynomial.isHomogeneous_X _ _)
  have hQ0 : (∏ i, (F i * MvPolynomial.X 0)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun i _ => mul_ne_zero (hF0 i) (MvPolynomial.X_ne_zero _)
  rcases isEmpty_or_nonempty (Fin m) with hE | hN
  · exact ⟨0, fun i => (hE.false i).elim⟩
  obtain ⟨r, hr⟩ : ∃ r : Fin (n + 1) → k, MvPolynomial.eval r (∏ i, (F i * MvPolynomial.X 0)) ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hQ0 (hQh.eq_zero_of_forall_eval_eq_zero hcon)
  rw [map_prod] at hr
  have hr' : ∀ i, MvPolynomial.eval r (F i) ≠ 0 ∧ r 0 ≠ 0 := by
    intro i
    have := Finset.prod_ne_zero_iff.mp hr i (Finset.mem_univ _)
    rw [map_mul, MvPolynomial.eval_X] at this
    exact mul_ne_zero_iff.mp this
  refine ⟨fun j => r j.succ / r 0, fun i => ?_⟩
  obtain ⟨h1, h2⟩ := hr' i
  have hx : (Fin.cons 1 (fun j => r j.succ / r 0) : Fin (n + 1) → k) = (r 0)⁻¹ • r := by
    funext s
    refine Fin.cases ?_ (fun j => ?_) s
    · simp [h2]
    · simp [div_eq_inv_mul]
  show MvPolynomial.eval _ (F i) ≠ 0
  rw [hx, eval_smul_of_isHomogeneous (hFh i)]
  exact mul_ne_zero (pow_ne_zero _ (inv_ne_zero h2)) h1

end Generic

section Main

variable {k : Type u} [Field k] {n : ℕ}

/-- The inclusion `T = k[[y₁, …, y_n]] → k[[z, y₁, …, y_n]]`. -/
noncomputable def coeffRingInclusion (k : Type u) [Field k] (n : ℕ) :
    MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin (n + 1)) k :=
  (MvPowerSeries.finSuccEquiv k n).symm.toRingEquiv.toRingHom.comp PowerSeries.C

theorem expansion_of_monic (f : Polynomial (MvPowerSeries (Fin n) k)) (hm : f.Monic) (ν : ℕ)
    (hdeg : f.natDegree = ν) :
    (MvPowerSeries.finSuccEquiv k n).symm (f : PowerSeries (MvPowerSeries (Fin n) k)) =
      MvPowerSeries.X 0 ^ ν + ∑ l : Fin ν, coeffRingInclusion k n (f.coeff (ν - ((l : ℕ) + 1))) *
        MvPowerSeries.X 0 ^ (ν - ((l : ℕ) + 1)) := by
  have h0 : (MvPowerSeries.finSuccEquiv k n).symm (PowerSeries.X : PowerSeries (MvPowerSeries (Fin n) k)) =
      MvPowerSeries.X 0 :=
    ((MvPowerSeries.finSuccEquiv k n).symm_apply_eq).mpr (MvPowerSeries.finSuccEquiv_X_zero).symm
  have h1 := hm.as_sum
  rw [hdeg] at h1
  have h2 : (f : PowerSeries (MvPowerSeries (Fin n) k)) = PowerSeries.X ^ ν +
      ∑ i ∈ Finset.range ν, PowerSeries.C (f.coeff i) * PowerSeries.X ^ i := by
    conv_lhs => rw [h1]
    rw [← Polynomial.coeToPowerSeries.ringHom_apply, map_add, map_sum]
    simp [Polynomial.coeToPowerSeries.ringHom_apply, Polynomial.coe_pow]
  rw [h2, map_add, map_pow, h0, map_sum]
  congr 1
  rw [← Finset.sum_range_reflect, ← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl fun l _ => ?_
  have hl : ν - 1 - (l : ℕ) = ν - ((l : ℕ) + 1) := by omega
  rw [hl, map_mul, map_pow, h0]
  rfl

/-- **Generic coordinates and Weierstrass form** (p. 297, `[c]`): for finitely many non-zero power
series `g_i ∈ k[[z, y₁, …, y_n]]` over a field `k` of characteristic `0`, after a substitution
`y_j ↦ y_j + c_j z` with suitable `c_j ∈ k`, each `g_i` is a unit times
`z^{ν_i} + a_{i1} z^{ν_i - 1} + ⋯ + a_{iν_i}`, with `ν_i = ord g_i` and `a_{il} ∈ k[[y]]` of order
at least `l`.

Deviation from the paper (gap filled): the paper says only "By replacing `y_j` by `y_j + c_j z`
with suitable `c_j ∈ k` `(1 ≤ j ≤ N − 1)`, we may assume that all the `g_{jk}` can be written in
the form described in [c]" (p. 297), without giving the `c_j` nor the Weierstrass preparation.
Lean proves it: generic `c` off the zero set of the dehomogenized initial forms (`k` infinite;
char `0` gives infinitude), then Weierstrass preparation over `k[[y]]` (Mathlib).  The order bound
on the coefficients (`g_{jki} ∈ (maximal ideal of T)^i`) is also proved. -/
@[blueprint "lem:IV.3-frame-generic-weierstrass"
  (statement := /-- Let $k$ be a field of characteristic $0$ and $g_1,\dots,g_m\ne0$ in the formal
    power series ring $k[[z,y_1,\dots,y_n]]$, $\nu_i=\operatorname{ord}g_i$. There are
    $c_1,\dots,c_n\in k$ such that, after the substitution $y_j\mapsto y_j+c_jz$, every $g_i$
    equals $u_i\,(z^{\nu_i}+a_{i1}z^{\nu_i-1}+\dots+a_{i\nu_i})$ with $u_i$ a unit and
    $a_{il}\in k[[y_1,\dots,y_n]]$ of order $\ge l$. -/)
  (proof := /-- The initial form $F_i$ of $g_i$ is a non-zero homogeneous polynomial of degree
    $\nu_i$; since $k$ is infinite there is $c\in k^n$ with $F_i(1,c)\neq0$ for all $i$. After the
    substitution the coefficient of $z^{\nu_i}$ at $y=0$ is $F_i(1,c)\ne0$ and the order is
    $\ge\nu_i$, so $g_i$ is $z$-regular of order $\nu_i$ over the complete local ring
    $k[[y]]$. The Weierstrass preparation theorem gives $g_i=u_i f_i$ with $f_i$ distinguished of
    degree $\nu_i$; comparing orders, $f_i=z^{\nu_i}+\sum a_{il}z^{\nu_i-l}$ with
    $\operatorname{ord}a_{il}\ge l$.

    \textbf{Deviation from the paper (gap filled).} The paper says only ``By replacing $y_j$ by
    $y_j+c_jz$ with suitable $c_j\in k$ $(1\le j\le N-1)$, we may assume that all the $g_{jk}$ can
    be written in the form described in [c]'' (p.~297). The choice of the $c_j$ (generic, $k$
    infinite) and the Weierstrass preparation are supplied here, as is the order bound
    $a_{il}\in\mathfrak m_T^l$. -/)
  (latexEnv := "lemma")]
theorem exists_generic_weierstrass_form (k : Type u) [Field k] [CharZero k] {n m : ℕ}
    (g : Fin m → MvPowerSeries (Fin (n + 1)) k) (hg : ∀ i, g i ≠ 0) :
    ∃ c : Fin n → k, ∀ i, ∃ (u : (MvPowerSeries (Fin (n + 1)) k)ˣ)
      (a : Fin (g i).order.toNat → MvPowerSeries (Fin n) k),
      genericShift c (g i) =
        (u : MvPowerSeries (Fin (n + 1)) k) * (MvPowerSeries.X 0 ^ (g i).order.toNat +
          ∑ l : Fin (g i).order.toNat, coeffRingInclusion k n (a l) *
            MvPowerSeries.X 0 ^ ((g i).order.toNat - ((l : ℕ) + 1))) ∧
      ∀ l : Fin (g i).order.toNat, (((l : ℕ) + 1 : ℕ) : ℕ∞) ≤ (a l).order := by
  obtain ⟨c, hc⟩ := exists_generic_coordinates g hg
  refine ⟨c, fun i => ?_⟩
  have hfin : (g i).order.toNat = (g i).order := MvPowerSeries.ne_zero_iff_order_finite.mp (hg i)
  set ν := (g i).order.toNat with hν
  set F := leadingForm ν (g i) with hF
  have hord : (ν : ℕ∞) ≤ (genericShift c (g i)).order := by
    rw [hfin]; exact le_order_genericShift c (g i)
  have hFh : F.IsHomogeneous ν := isHomogeneous_leadingForm _ _
  have hsplit : genericShift c (g i) = genericShift c (F : MvPowerSeries (Fin (n + 1)) k) +
      genericShift c (g i - (F : MvPowerSeries (Fin (n + 1)) k)) := by
    rw [← map_add]; congr 1; ring
  have hsub := succ_le_order_sub_leadingForm (g i) (hg i)
  have hcoeff : MvPowerSeries.coeff (Finsupp.cons ν 0) (genericShift c (g i)) ≠ 0 := by
    rw [hsplit, map_add, coeff_genericShift_homogeneous c hFh]
    have h2 : MvPowerSeries.coeff (Finsupp.cons ν 0)
        (genericShift c (g i - (F : MvPowerSeries (Fin (n + 1)) k))) = 0 := by
      refine MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le ?_
        (hsub.trans (le_order_genericShift c _)))
      rw [degree_cons]
      simp only [map_zero, add_zero]
      exact_mod_cast Nat.lt_succ_self ν
    rw [h2, add_zero]
    exact hc i
  obtain ⟨u, f, hm, hdeg, hh, hbound⟩ := exists_weierstrass_form n ν _ hord hcoeff
  refine ⟨u, fun l => f.coeff (ν - ((l : ℕ) + 1)), ?_, fun l => ?_⟩
  · rw [hh, expansion_of_monic f hm ν hdeg]
  · have := hbound (ν - ((l : ℕ) + 1)) (by have := l.2; omega)
    have e : ν - (ν - ((l : ℕ) + 1)) = (l : ℕ) + 1 := by have := l.2; omega
    rwa [e] at this

end Main

end Hironaka

/-!
# Irreducible components through a point and the stalk of a subscheme

The irreducible components of a subscheme `D` of `X` passing through a point `x` correspond to the
minimal primes of the stalk `D_x ⊆ O_{X,x}` (via the generizations of `x`, i.e. the image of
`Spec O_{X,x} → X`), the component `C` corresponding to its stalk `C_x`.  As a consequence, the
normal crossing property of Ch. 0 §5, Def. 2 (stated with the irreducible components of `E`) can
be read off the stalk of `E`: for reduced `E`, `E` has only normal crossings with `D` at `x` iff
`E_x` is generated by the product of some members of a regular system of parameters `z` of
`O_{X,x}` and `D_x` by some other members of `z`.

Deviation from the paper (gap filled): the paper passes between "the ideal of each irreducible
component of `E` containing `x` is generated by one of the `zᵢ`" and the local equation
`z_{i₁} ⋯ z_{i_k} = 0` of `E` at `x` without comment (e.g. p. 169); this module supplies the
translation.
-/

@[expose] public section

open AlgebraicGeometry TopologicalSpace IsLocalRing Classical

namespace Hironaka

universe u

namespace Subscheme

variable {X : Scheme.{u}}

/-! ### Components through a point, read on an affine open

Throughout, `U` is an affine open of `X` with ring `A = Γ(X, U)`, and points of `U` are
`hU.fromSpec q` for primes `q` of `A`. -/

/-- A point of `U` given by the prime `q` of `Γ(X, U)` lies on `D` iff `q` contains the
sections of `D` over `U`. -/
theorem compStalk_fromSpec_mem_pts_iff (D : Subscheme X) {U : X.Opens} (hU : IsAffineOpen U)
    (q : PrimeSpectrum Γ(X, U)) :
    hU.fromSpec q ∈ D.pts ↔ D.ideal ⟨U, hU⟩ ≤ q.asIdeal := by
  have hqW : hU.fromSpec q ∈ U := by
    rw [← SetLike.mem_coe, ← hU.range_fromSpec]; exact ⟨_, rfl⟩
  have key : ∀ s : Γ(X, U), hU.fromSpec q ∈ X.basicOpen s ↔ s ∉ q.asIdeal := by
    intro s
    rw [← PrimeSpectrum.mem_basicOpen, ← hU.fromSpec_preimage_basicOpen]
    rfl
  show hU.fromSpec q ∈ (D.support : Set X) ↔ _
  rw [SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hU⟩) hqW,
    Scheme.mem_zeroLocus_iff]
  refine ⟨fun h s hs => ?_, fun h s hs hq => ?_⟩
  · by_contra hsq
    exact h s hs ((key s).mpr hsq)
  · exact (key s).mp hq (h hs)

theorem compStalk_fromSpec_specializes_iff {U : X.Opens} (hU : IsAffineOpen U)
    (q r : PrimeSpectrum Γ(X, U)) :
    hU.fromSpec q ⤳ hU.fromSpec r ↔ q.asIdeal ≤ r.asIdeal := by
  exact hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff.trans
    (PrimeSpectrum.le_iff_specializes q r).symm

/-- The sections over `U` of the reduced structure on `closure {hU.fromSpec q}`. -/
theorem compStalk_ideal_ofClosed_closure {U : X.Opens} (hU : IsAffineOpen U)
    (q : PrimeSpectrum Γ(X, U)) :
    (ofClosed ⟨closure {hU.fromSpec q}, isClosed_closure⟩).ideal ⟨U, hU⟩ = q.asIdeal := by
  have h : hU.fromSpec ⁻¹' closure {hU.fromSpec q} = closure {q} := by
    ext w
    rw [Set.mem_preimage, ← specializes_iff_mem_closure]
    exact ((compStalk_fromSpec_specializes_iff hU q w).trans
      (PrimeSpectrum.le_iff_specializes q w)).trans specializes_iff_mem_closure
  show PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' closure {hU.fromSpec q}) = q.asIdeal
  exact (congrArg PrimeSpectrum.vanishingIdeal h).trans (by
    rw [PrimeSpectrum.vanishingIdeal_closure, PrimeSpectrum.vanishingIdeal_singleton])

/-- The stalk at `x ∈ U` of the reduced structure on `closure {hU.fromSpec q}`. -/
theorem compStalk_stalkIdeal_ofClosed_closure {U : X.Opens} (hU : IsAffineOpen U) {x : X}
    (hxW : x ∈ U) (q : PrimeSpectrum Γ(X, U)) :
    (ofClosed ⟨closure {hU.fromSpec q}, isClosed_closure⟩).stalkIdeal x =
      q.asIdeal.map (X.presheaf.germ U x hxW).hom := by
  rw [stalkIdeal_eq_map_germ_affine _ ⟨U, hU⟩ hxW, compStalk_ideal_ofClosed_closure]

/-- An irreducible component of `D` through `x ∈ U` is the closure of a point of `U` whose prime
is a minimal prime of `D(U)` contained in the prime of `x`. -/
theorem compStalk_exists_prime (D : Subscheme X) {U : X.Opens} (hU : IsAffineOpen U) {x : X}
    (hxW : x ∈ U) {C : Subscheme X} (hC : C ∈ D.irreducibleComponents)
    (hx : x ∈ C.pts) :
    ∃ q : PrimeSpectrum Γ(X, U), q.asIdeal ∈ (D.ideal ⟨U, hU⟩).minimalPrimes ∧
      q.asIdeal ≤ (hU.primeIdealOf ⟨x, hxW⟩).asIdeal ∧
      C = ofClosed ⟨closure {hU.fromSpec q}, isClosed_closure⟩ := by
  obtain ⟨Z, ⟨⟨hZirr, hZsub⟩, hZmax⟩, rfl⟩ := hC
  have hxZ : x ∈ (Z : Set X) := by rw [← pts_ofClosed Z]; exact hx
  obtain ⟨η, hη⟩ : ∃ η, IsGenericPoint η (Z : Set X) := QuasiSober.sober hZirr Z.isClosed
  have hηx : η ⤳ x := hη.specializes hxZ
  have hηW : η ∈ U := hηx.mem_open U.isOpen hxW
  set q := hU.primeIdealOf ⟨η, hηW⟩
  have hq : hU.fromSpec q = η := hU.fromSpec_primeIdealOf ⟨η, hηW⟩
  have hxq : hU.fromSpec (hU.primeIdealOf ⟨x, hxW⟩) = x := hU.fromSpec_primeIdealOf ⟨x, hxW⟩
  have hZq : closure {hU.fromSpec q} = (Z : Set X) := by rw [hq]; exact hη.def
  refine ⟨q, ⟨⟨inferInstance, ?_⟩, fun r ⟨hr, hDr⟩ hrq => ?_⟩, ?_, ?_⟩
  · exact (compStalk_fromSpec_mem_pts_iff D hU q).mp (by rw [hq]; exact hZsub hη.mem)
  · let r' : PrimeSpectrum Γ(X, U) := ⟨r, hr⟩
    have hr'D : hU.fromSpec r' ∈ D.pts := (compStalk_fromSpec_mem_pts_iff D hU r').mpr hDr
    have hr'q : hU.fromSpec r' ⤳ hU.fromSpec q :=
      (compStalk_fromSpec_specializes_iff hU r' q).mpr hrq
    let T : Closeds X := ⟨closure {hU.fromSpec r'}, isClosed_closure⟩
    have hZT : Z ≤ T := by
      intro w hw
      rw [← SetLike.mem_coe, ← hZq] at hw
      exact closure_minimal (Set.singleton_subset_iff.mpr
        (specializes_iff_mem_closure.mp hr'q)) isClosed_closure hw
    have hTZ : T ≤ Z := hZmax (y := T) ⟨isIrreducible_singleton.closure,
      closure_minimal (Set.singleton_subset_iff.mpr hr'D) D.support.isClosed⟩ hZT
    have : hU.fromSpec r' ∈ closure {hU.fromSpec q} := by
      rw [hZq]; exact hTZ (subset_closure rfl)
    exact (compStalk_fromSpec_specializes_iff hU q r').mp (specializes_iff_mem_closure.mpr this)
  · rw [← compStalk_fromSpec_specializes_iff hU, hq, hxq]; exact hηx
  · congr 1
    ext1
    exact hZq.symm

/-- Conversely, the closure of the point of `U` given by a minimal prime of `D(U)` is (the
support of) an irreducible component of `D`. -/
theorem compStalk_ofClosed_mem_irreducibleComponents (D : Subscheme X) {U : X.Opens}
    (hU : IsAffineOpen U) {q : PrimeSpectrum Γ(X, U)}
    (hq : q.asIdeal ∈ (D.ideal ⟨U, hU⟩).minimalPrimes) :
    ofClosed ⟨closure {hU.fromSpec q}, isClosed_closure⟩ ∈ D.irreducibleComponents := by
  refine ⟨_, ⟨⟨isIrreducible_singleton.closure, closure_minimal (Set.singleton_subset_iff.mpr
    ((compStalk_fromSpec_mem_pts_iff D hU q).mpr hq.1.2)) D.support.isClosed⟩,
    fun T ⟨hTirr, hTD⟩ hZT => ?_⟩, rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ, IsGenericPoint τ (T : Set X) := QuasiSober.sober hTirr T.isClosed
  have hqT : hU.fromSpec q ∈ (T : Set X) := hZT (subset_closure rfl)
  have hτq : τ ⤳ hU.fromSpec q := hτ.specializes hqT
  have hqW : hU.fromSpec q ∈ U := by
    rw [← SetLike.mem_coe, ← hU.range_fromSpec]; exact ⟨_, rfl⟩
  have hτW : τ ∈ U := hτq.mem_open U.isOpen hqW
  set r := hU.primeIdealOf ⟨τ, hτW⟩
  have hr : hU.fromSpec r = τ := hU.fromSpec_primeIdealOf ⟨τ, hτW⟩
  have hrq : r.asIdeal ≤ q.asIdeal := by
    rw [← compStalk_fromSpec_specializes_iff hU, hr]; exact hτq
  have hDr : D.ideal ⟨U, hU⟩ ≤ r.asIdeal :=
    (compStalk_fromSpec_mem_pts_iff D hU r).mp (by rw [hr]; exact hTD hτ.mem)
  have hqr : q.asIdeal ≤ r.asIdeal := hq.2 ⟨inferInstance, hDr⟩ hrq
  have hτZ : τ ∈ closure {hU.fromSpec q} := by
    rw [← hr]
    exact specializes_iff_mem_closure.mp ((compStalk_fromSpec_specializes_iff hU q r).mpr hqr)
  intro w hw
  rw [← SetLike.mem_coe, ← hτ.def] at hw
  exact closure_minimal (Set.singleton_subset_iff.mpr hτZ) isClosed_closure hw

/-- In a localization at a prime `P`, contraction undoes extension on primes inside `P`. -/
theorem compStalk_under_map {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (P : Ideal R) [P.IsPrime] [IsLocalization.AtPrime A P] (q : Ideal R) [q.IsPrime]
    (hq : q ≤ P) : (q.map (algebraMap R A)).comap (algebraMap R A) = q :=
  IsLocalization.under_map_of_isPrime_disjoint P.primeCompl A ‹_›
    (Set.disjoint_left.mpr fun _ ha haq => ha (hq haq))

/-- The stalk at `x` of an irreducible component of `D` through `x` is a minimal prime of the
stalk of `D`. -/
theorem stalkIdeal_mem_minimalPrimes {D C : Subscheme X} (hC : C ∈ D.irreducibleComponents)
    {x : X} (hx : x ∈ C.pts) : C.stalkIdeal x ∈ (D.stalkIdeal x).minimalPrimes := by
  obtain ⟨⟨U, hU⟩, hxW⟩ := exists_affineOpen_mem x
  replace hxW : x ∈ U := hxW
  obtain ⟨q, hqmin, hqx, rfl⟩ := compStalk_exists_prime D hU hxW hC hx
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : U)
  have := hU.isLocalization_stalk ⟨x, hxW⟩
  rw [compStalk_stalkIdeal_ofClosed_closure hU hxW, stalkIdeal_eq_map_germ_affine D ⟨U, hU⟩ hxW]
  change q.asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk x)) ∈
    ((D.ideal ⟨U, hU⟩).map (algebraMap Γ(X, U) (X.presheaf.stalk x))).minimalPrimes
  rw [IsLocalization.minimalPrimes_map (hU.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl]
  rw [Set.mem_preimage]
  show Ideal.comap (algebraMap Γ(X, U) (X.presheaf.stalk x))
    (q.asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk x))) ∈
      (D.ideal ⟨U, hU⟩).minimalPrimes
  rw [compStalk_under_map (hU.primeIdealOf ⟨x, hxW⟩).asIdeal q.asIdeal hqx]
  exact hqmin

/-- Every minimal prime of the stalk of `D` at `x` is the stalk of an irreducible component of
`D` through `x`. -/
theorem exists_mem_irreducibleComponents_of_mem_minimalPrimes (D : Subscheme X) (x : X)
    {p : Ideal (X.presheaf.stalk x)} (hp : p ∈ (D.stalkIdeal x).minimalPrimes) :
    ∃ C ∈ D.irreducibleComponents, x ∈ C.pts ∧ C.stalkIdeal x = p := by
  obtain ⟨⟨U, hU⟩, hxW⟩ := exists_affineOpen_mem x
  replace hxW : x ∈ U := hxW
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : U)
  have := hU.isLocalization_stalk ⟨x, hxW⟩
  set P := (hU.primeIdealOf ⟨x, hxW⟩).asIdeal with hP
  rw [stalkIdeal_eq_map_germ_affine D ⟨U, hU⟩ hxW] at hp
  change p ∈
    ((D.ideal ⟨U, hU⟩).map (algebraMap Γ(X, U) (X.presheaf.stalk x))).minimalPrimes at hp
  have hmin : p.under Γ(X, U) ∈ (D.ideal ⟨U, hU⟩).minimalPrimes := by
    have := hp
    rw [IsLocalization.minimalPrimes_map P.primeCompl] at this
    exact this
  have hdisj :=
    (IsLocalization.isPrime_iff_isPrime_disjoint P.primeCompl (X.presheaf.stalk x) p).mp hp.1.1
  let q : PrimeSpectrum Γ(X, U) := ⟨p.under Γ(X, U), hdisj.1⟩
  have hqx : q.asIdeal ≤ P := fun a ha => by
    by_contra h
    exact Set.disjoint_left.mp hdisj.2 h ha
  refine ⟨_, compStalk_ofClosed_mem_irreducibleComponents D hU (q := q) hmin, ?_, ?_⟩
  · rw [pts_ofClosed]
    show x ∈ closure {hU.fromSpec q}
    have h1 := (compStalk_fromSpec_specializes_iff hU q _).mpr hqx
    rw [hU.fromSpec_primeIdealOf ⟨x, hxW⟩] at h1
    exact specializes_iff_mem_closure.mp h1
  · rw [compStalk_stalkIdeal_ofClosed_closure hU hxW]
    exact IsLocalization.map_under P.primeCompl (X.presheaf.stalk x) p

/-- Two irreducible components of `D` through `x` with the same stalk at `x` are equal. -/
theorem eq_of_stalkIdeal_eq {D C₁ C₂ : Subscheme X} (hC₁ : C₁ ∈ D.irreducibleComponents)
    (hC₂ : C₂ ∈ D.irreducibleComponents) {x : X} (hx₁ : x ∈ C₁.pts) (hx₂ : x ∈ C₂.pts)
    (h : C₁.stalkIdeal x = C₂.stalkIdeal x) : C₁ = C₂ := by
  obtain ⟨⟨U, hU⟩, hxW⟩ := exists_affineOpen_mem x
  replace hxW : x ∈ U := hxW
  obtain ⟨q₁, -, hq₁x, rfl⟩ := compStalk_exists_prime D hU hxW hC₁ hx₁
  obtain ⟨q₂, -, hq₂x, rfl⟩ := compStalk_exists_prime D hU hxW hC₂ hx₂
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : U)
  have := hU.isLocalization_stalk ⟨x, hxW⟩
  rw [compStalk_stalkIdeal_ofClosed_closure hU hxW,
    compStalk_stalkIdeal_ofClosed_closure hU hxW] at h
  change q₁.asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk x)) =
    q₂.asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk x)) at h
  have h' := congrArg (Ideal.comap (algebraMap Γ(X, U) (X.presheaf.stalk x))) h
  rw [compStalk_under_map _ q₁.asIdeal hq₁x, compStalk_under_map _ q₂.asIdeal hq₂x] at h'
  have : q₁ = q₂ := PrimeSpectrum.ext h'
  subst this
  rfl

/-- The stalks of a reduced subscheme are radical. -/
theorem isRadical_stalkIdeal_of_isReduced {D : Subscheme X} (hD : D.IsReduced) (x : X) :
    (D.stalkIdeal x).IsRadical := by
  obtain ⟨⟨U, hU⟩, hxW⟩ := exists_affineOpen_mem x
  replace hxW : x ∈ U := hxW
  have hrad : (D.ideal ⟨U, hU⟩).radical = D.ideal ⟨U, hU⟩ :=
    congrArg (fun I => Scheme.IdealSheafData.ideal I ⟨U, hU⟩)
      (radical_eq_self_of_isReduced D hD)
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : U)
  have := hU.isLocalization_stalk ⟨x, hxW⟩
  have hmap := IsLocalization.map_radical (hU.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
    (X.presheaf.stalk x) (D.ideal ⟨U, hU⟩)
  rw [hrad] at hmap
  rw [stalkIdeal_eq_map_germ_affine D ⟨U, hU⟩ hxW]
  show ((D.ideal ⟨U, hU⟩).map (algebraMap Γ(X, U) (X.presheaf.stalk x))).radical ≤ _
  rw [← hmap]
  exact le_rfl

/-- A subscheme all of whose stalks are radical is reduced. -/
theorem isReduced_of_isRadical_stalkIdeal {D : Subscheme X}
    (h : ∀ x, (D.stalkIdeal x).IsRadical) : D.IsReduced := by
  exact isReduced_of_stalk_quot D fun z _ => (Ideal.isRadical_iff_quotient_reduced _).mp (h z)

/-- The normal crossing property of Ch. 0 §5, Def. 2, read on the stalk of a reduced `E` at a
point `x` where `X` is regular. -/
theorem hasOnlyNormalCrossingsWithAt_iff {E D : Subscheme X} (hE : E.IsReduced) {x : X}
    (hx : X.IsSimpleAt x) :
    E.HasOnlyNormalCrossingsWithAt D x ↔
      ∃ z : Finset (X.presheaf.stalk x), IsRegularSystemOfParameters _ z ∧
        (∃ J ⊆ z, E.stalkIdeal x = Ideal.span {∏ a ∈ J, a}) ∧
        (∃ T ⊆ z, D.stalkIdeal x = Ideal.span (T : Set (X.presheaf.stalk x))) := by
  have : IsRegularLocalRing (X.presheaf.stalk x) := hx
  constructor
  · rintro ⟨z, hz, hcomp, t, htz, hDt⟩
    have hzext := ExtendsToRSOP.of_isRegularSystemOfParameters hz
    set J := z.filter (fun a => Ideal.span {a} ∈ (E.stalkIdeal x).minimalPrimes) with hJ
    have hJz : J ⊆ z := Finset.filter_subset _ _
    have hmin : (E.stalkIdeal x).minimalPrimes =
        (fun a : X.presheaf.stalk x => Ideal.span {a}) '' (J : Set (X.presheaf.stalk x)) := by
      ext p
      constructor
      · intro hp
        obtain ⟨C, hC, hxC, hCp⟩ := exists_mem_irreducibleComponents_of_mem_minimalPrimes E x hp
        obtain ⟨a, haz, hCa⟩ := hcomp C hC hxC
        refine ⟨a, ?_, ?_⟩
        · rw [Finset.mem_coe, hJ, Finset.mem_filter, ← hCa, hCp]
          exact ⟨haz, hp⟩
        · show Ideal.span {a} = p
          rw [← hCa, hCp]
      · rintro ⟨a, ha, rfl⟩
        rw [Finset.mem_coe, hJ, Finset.mem_filter] at ha
        exact ha.2
    refine ⟨z, hz, ⟨J, hJz, ?_⟩, ⟨t, htz, hDt⟩⟩
    rw [← (hzext.mono hJz).iInf_span_singleton,
      ← (isRadical_stalkIdeal_of_isReduced hE x).radical,
      ← Ideal.sInf_minimalPrimes, hmin, sInf_image]
    simp only [Finset.mem_coe]
  · rintro ⟨z, hz, ⟨J, hJz, hEJ⟩, ⟨T, hTz, hDT⟩⟩
    have hJext := (ExtendsToRSOP.of_isRegularSystemOfParameters hz).mono hJz
    refine ⟨z, hz, fun C hC hxC => ?_, ⟨T, hTz, hDT⟩⟩
    have h1 := stalkIdeal_mem_minimalPrimes hC hxC
    rw [hEJ, hJext.minimalPrimes_span_prod] at h1
    obtain ⟨a, haJ, ha⟩ := h1
    exact ⟨a, hJz haJ, ha.symm⟩

/-- A subscheme whose stalk at `x` is generated by a member of a regular system of parameters is
simple at `x`. -/
theorem isSimpleAt_of_stalkIdeal_eq_span {D : Subscheme X} {x : X} (hx : X.IsSimpleAt x)
    {K : Finset (X.presheaf.stalk x)} (hK : ExtendsToRSOP _ K) {a : X.presheaf.stalk x}
    (ha : a ∈ K) (hDx : D.stalkIdeal x = Ideal.span {a}) : D.IsSimpleAt x := by
  have : IsRegularLocalRing (X.presheaf.stalk x) := hx
  refine ⟨mem_pts_iff_stalkIdeal_ne_top.mpr ?_, ?_⟩
  · rw [hDx, Ne, Ideal.span_singleton_eq_top]
    have := hK.mem_maximalIdeal ha
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at this
    exact this
  · rw [hDx]
    exact hK.isRegularLocalRing_quotient_span_singleton ha

end Subscheme

end Hironaka

module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Architect
public import Hironaka.Compat.RegularQuotientIndependent

/-!
# Compatibility layer: the height of an ideal generated by elements independent modulo `𝔫²`

In a regular local ring `(L, 𝔫)`, elements `f₁,…,f_h ∈ 𝔫` independent modulo `𝔫²` (i.e. part of a
regular system of parameters) generate an ideal of height `h`; we need only the lower bound
`h ≤ ht(f₁,…,f_h)` (the upper bound is Krull's height theorem).  The proof is the chain of primes
`(f₁) ⊊ (f₁,f₂) ⊊ … ⊊ (f₁,…,f_h)`: each `(f₁,…,f_i)` is prime because the quotient is regular
(`isRegularLocalRing_quotient_span_of_isIndepModSq`), hence a domain, and the chain is strict
because the `f_i` are independent.  This is used for the "minor form" of the jacobian criterion
(`Hironaka/Compat/JacobianMinors.lean`), where the height of `𝔭 = (f)T_P ∩ T` must be at least `h`.
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

variable {L : Type u} [CommRing L] [IsRegularLocalRing L]

namespace IsIndepModSq

/-- Dropping the last element preserves independence modulo `𝔫²`. -/
theorem init {h : ℕ} {f : Fin (h + 1) → L} (hind : IsIndepModSq f) :
    IsIndepModSq (fun i : Fin h => f i.castSucc) := by
  intro c hc i
  have := hind (Fin.snoc c 0) (by simpa [Fin.sum_univ_castSucc] using hc) i.castSucc
  simpa using this

/-- The last element is not in the ideal generated by the previous ones. -/
theorem last_notMem_span_init {h : ℕ} {f : Fin (h + 1) → L} (hind : IsIndepModSq f) :
    f (Fin.last h) ∉ Ideal.span (Set.range fun i : Fin h => f i.castSucc) := by
  intro hmem
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun L).mp hmem
  -- `f_last = Σ cᵢ fᵢ` gives the relation `Σ cᵢ fᵢ - f_last = 0 ∈ 𝔫²`
  have := hind (Fin.snoc c (-1)) (by
    simp only [Fin.sum_univ_castSucc, Fin.snoc_castSucc, Fin.snoc_last]
    simp only [smul_eq_mul] at hc
    have : ∑ i : Fin h, c i * f i.castSucc + -1 * f (Fin.last h) = 0 := by
      rw [show ∑ i : Fin h, c i * f i.castSucc = f (Fin.last h) by simpa using hc]; ring
    rw [this]; exact Ideal.zero_mem _) (Fin.last h)
  simp at this

/-- If `f₁,…,f_h ∈ 𝔫` are independent modulo `𝔫²`, `(f₁,…,f_h)` is a prime ideal. -/
theorem isPrime_span {h : ℕ} {f : Fin h → L} (hf : ∀ i, f i ∈ maximalIdeal L)
    (hind : IsIndepModSq f) : (Ideal.span (Set.range f)).IsPrime := by
  have := hind.isRegularLocalRing_quotient hf
  have := isDomain_of_isRegularLocalRing (L ⧸ Ideal.span (Set.range f))
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- **The height of the ideal generated by `h` independent elements is at least `h`.**  For a ring
homomorphism `φ : R → L` and `F₁,…,F_h ∈ R` with `φ(F_i)` independent modulo `𝔫²`, the contraction
to `R` of `(φ F₁,…,φ F_h) L` has height at least `h`. -/
theorem le_height_comap_span {R : Type u} [CommRing R] (φ : R →+* L) :
    ∀ (h : ℕ) (F : Fin h → R), (∀ i, φ (F i) ∈ maximalIdeal L) →
      IsIndepModSq (fun i => φ (F i)) →
      (h : ℕ∞) ≤ (Ideal.comap φ (Ideal.span (Set.range fun i => φ (F i)))).height := by
  intro h
  induction h with
  | zero => intro F _ _; simp
  | succ h ih =>
    intro F hF hind
    have hprime : ∀ {j : ℕ} (G : Fin j → R), (∀ i, φ (G i) ∈ maximalIdeal L) →
        IsIndepModSq (fun i => φ (G i)) →
        (Ideal.comap φ (Ideal.span (Set.range fun i => φ (G i)))).IsPrime := by
      intro j G hG hGind
      have := isPrime_span hG hGind
      exact Ideal.comap_isPrime φ _
    set G : Fin h → R := fun i => F i.castSucc with hG
    have hGmem : ∀ i, φ (G i) ∈ maximalIdeal L := fun i => hF _
    have hGind : IsIndepModSq (fun i => φ (G i)) := hind.init
    have hb := hprime G hGmem hGind
    have hc := hprime F hF hind
    have hlt : Ideal.comap φ (Ideal.span (Set.range fun i => φ (G i))) <
        Ideal.comap φ (Ideal.span (Set.range fun i => φ (F i))) := by
      refine lt_of_le_of_ne (Ideal.comap_mono (Ideal.span_mono ?_)) ?_
      · rintro _ ⟨i, rfl⟩
        exact ⟨i.castSucc, rfl⟩
      · intro heq
        have h1 : F (Fin.last h) ∈ Ideal.comap φ (Ideal.span (Set.range fun i => φ (F i))) := by
          rw [Ideal.mem_comap]
          exact Ideal.subset_span ⟨Fin.last h, rfl⟩
        rw [← heq, Ideal.mem_comap] at h1
        exact last_notMem_span_init hind h1
    have := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    calc ((h + 1 : ℕ) : ℕ∞) = (h : ℕ∞) + 1 := by push_cast; rfl
      _ ≤ _ := le_trans (add_le_add (ih G hGmem hGind) le_rfl) this

end IsIndepModSq

end Hironaka

/-!
# Stalk-level helpers for the frame-transform step (Ch. IV, pp. 316-318)

Locally principal ideal sheaves and `divPow`, the strict transform of a principal ideal generated by
a regular parameter, stalks of strict transforms through the monoidal transform of the local ring,
and colon-ideal computations in a domain.  Used by `CD.Frame.stalkInv_succ`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry IsLocalRing

universe u

namespace Hironaka

section LocallyPrincipal
variable {X : Scheme.{u}}

/-- The ideal sheaf `P` is locally principal (generated on each point's affine neighbourhood by one
section; unlike `IsInvertibleIdeal` the generator may be a zero divisor). -/
def Subscheme.IsLocallyPrincipal (P : Subscheme X) : Prop :=
  ∀ x : X, ∃ (U : X.affineOpens) (_ : x ∈ (U : X.Opens)) (a : Γ(X, U)),
    P.ideal U = Ideal.span {a}

theorem Subscheme.IsInvertibleIdeal.isLocallyPrincipal {P : Subscheme X}
    (hP : P.IsInvertibleIdeal) : P.IsLocallyPrincipal := fun x => by
  obtain ⟨W, hxW, a, ha, -⟩ := hP x
  exact ⟨W, hxW, a, ha⟩

theorem Subscheme.IsLocallyPrincipal.totalTransform {Y : Scheme.{u}} (g : Y ⟶ X) {D : Subscheme X}
    (hD : D.IsLocallyPrincipal) : (Subscheme.totalTransform g D).IsLocallyPrincipal := by
  intro y
  obtain ⟨U, hgyU, a, hDa⟩ := hD (g y)
  obtain ⟨_, ⟨W, hW, rfl⟩, hyW, hWU⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (show y ∈ g ⁻¹ᵁ (U : X.Opens) from hgyU) (g ⁻¹ᵁ (U : X.Opens)).isOpen
  refine ⟨⟨W, hW⟩, hyW, g.appLE U W hWU a, ?_⟩
  change (D.comap g).ideal ⟨W, hW⟩ = _
  rw [ideal_comap_eq_map_appLE g D U ⟨W, hW⟩ hWU, hDa, Ideal.map_span, Set.image_singleton]


theorem Subscheme.IsLocallyPrincipal.ideal_fg {P : Subscheme X} (hP : P.IsLocallyPrincipal)
    (U : X.affineOpens) : (P.ideal U).FG := by
  let t : Set Γ(X, U) := {g | (P.ideal (X.affineBasicOpen g)).FG}
  have ht : Ideal.span t = ⊤ := by
    rw [← U.2.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨W, hxW, a, ha⟩ := hP x
    obtain ⟨g, hgW, hxg⟩ := U.2.exists_basicOpen_le (V := W.1) ⟨x, hxW⟩ hx
    have hg : g ∈ t := by
      show (P.ideal (X.affineBasicOpen g)).FG
      rw [← P.map_ideal (show X.affineBasicOpen g ≤ W from hgW), ha, Ideal.map_span,
        Set.image_singleton]
      exact Submodule.fg_span_singleton _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hg⟩, hxg⟩
  apply Ideal.fg_of_localizationSpan t ht
  rintro ⟨g, hg⟩
  have := U.2.isLocalization_basicOpen g
  let e := IsLocalization.algEquiv (Submonoid.powers g) Γ(X, X.basicOpen g) (Localization.Away g)
  have h1 : algebraMap Γ(X, U) (Localization.Away g) =
      (e : Γ(X, X.basicOpen g) →+* Localization.Away g).comp
        (algebraMap Γ(X, U) Γ(X, X.basicOpen g)) := by
    ext r
    exact (e.commutes r).symm
  have h2 : (P.ideal U).map (algebraMap Γ(X, U) Γ(X, X.basicOpen g)) =
      P.ideal (X.affineBasicOpen g) := P.map_ideal_basicOpen U g
  rw [h1, ← Ideal.map_map]
  refine Ideal.FG.map ?_ _
  rw [h2]
  exact hg

/-- The stalks of `I·P⁻ᵛ` (`divPow`) for a locally principal (possibly zero-divisor-generated) `P`
are the colon ideals `(I_x : P_xᵛ)`; as `Subscheme.stalkIdeal_divPow`, which asks `P` invertible, but
only local finite generation is used. -/
theorem Subscheme.stalkIdeal_divPow_of_isLocallyPrincipal {I P : Subscheme X}
    (hP : P.IsLocallyPrincipal) (ν : ℕ) (x : X) :
    (Subscheme.divPow I P ν).stalkIdeal x =
      (I.stalkIdeal x).colon ((P.stalkIdeal x ^ ν : Ideal _) : Set (X.presheaf.stalk x)) := by
  apply le_antisymm
  · rw [Subscheme.divPow, Subscheme.stalkIdeal_sSup_eq]
    refine iSup₂_le fun K hK => fun k hk => Submodule.mem_colon.mpr fun p hp => ?_
    exact hK x (Ideal.mul_mem_mul hk hp)
  · have hfg : ∀ U, ((P ^ ν).ideal U).FG := fun U => by
      rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply]
      exact (hP.ideal_fg U).pow
    have hmem : Subscheme.colonOfFG I (P ^ ν) hfg ∈
        {K : Subscheme X | ∀ x : X, K.stalkIdeal x * (P.stalkIdeal x) ^ ν ≤ I.stalkIdeal x} := by
      intro z
      rw [Subscheme.stalkIdeal_colonOfFG, Subscheme.stalkIdeal_pow_eq, Ideal.mul_le]
      intro c hc p hp
      exact Submodule.mem_colon.mp hc p hp
    have := Subscheme.stalkIdeal_mono (le_sSup hmem) x
    rwa [Subscheme.stalkIdeal_colonOfFG, Subscheme.stalkIdeal_pow_eq] at this

end LocallyPrincipal

/-- The strict transform of a principal ideal `(g)` along a monoidal transform with prime center `P`, `R/P` regular, is generated by `x^{-ν} g`, `ν = ν_P(g)` (Lemma 6, p. 216, with the one-element system `(g)`: `gr_P(R)` is a domain, so `gr_P((g), R)` is generated by the initial form of `g`). -/
theorem strictTransformIdeal_span_singleton_eq {R : Type u} [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] {P : Ideal R} (t : MonoidalTransform R P)
    (hP : P.IsPrime) (hS : IsRegularLocalRing (R ⧸ P)) (g : R) (g' : t.ring)
    (hg' : t.xR ^ (Ideal.ordElem P g).toNat * g' = t.toRing g) :
    strictTransformIdeal t (Ideal.span {g}) = Ideal.span {g'} := by
  have hxP : Ideal.span {t.xR} = P.map t.toRing := t.span_xR_eq_map
  have hX0 : t.xR ≠ 0 := fun h => t.x_ne_zero (MonoidalTransform.toRing_injective t (h.trans (map_zero _).symm))
  have hgen : Ideal.span (Set.range fun _ : Fin 1 => initialForm P g) =
      grIdeal P (Ideal.span {g}) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨_, rfl⟩
      exact Ideal.subset_span ⟨g, Ideal.mem_span_singleton_self g, rfl⟩
    · rw [grIdeal, Ideal.span_le]
      rintro _ ⟨a, ha, rfl⟩
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [SetLike.mem_coe, initialForm_mul_of_isRegularLocalRing P hS]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨0, rfl⟩)
  rw [MonoidalTransform.strictTransformIdeal_eq_span_of_span_initialForm_eq_grIdeal hP hS
    (Ideal.span {g}) (fun _ : Fin 1 => g) (fun _ => Ideal.mem_span_singleton_self g) hgen t t.x
    t.x_mem hxP]
  congr 1
  ext y
  simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff, exists_const]
  exact ⟨fun h => mul_left_cancel₀ (pow_ne_zero _ hX0) (h.trans hg'.symm), fun h => h ▸ hg'⟩

/-- The stalk of the strict transform of `V` at `y'` is the image under `R' ≅ O_{X',y'}` of the strict transform of the stalk `V_{f(y')}` in the monoidal transform `R'` of `O_{X,f(y')}` (Remark 3, 4, pp. 214-215). -/
theorem MonoidalTransformation.stalkIdeal_strictTransform_eq_map {X : Scheme.{u}}
    {B : Subscheme X} (t : MonoidalTransformation X B) (y : t.X')
    [IsRegularLocalRing (X.presheaf.stalk (t.f y))] [IsDomain (X.presheaf.stalk (t.f y))]
    (s : MonoidalTransform (X.presheaf.stalk (t.f y)) (B.stalkIdeal (t.f y)))
    (e : s.ring ≃+* t.X'.presheaf.stalk y) (he : e.toRingHom.comp s.toRing = (t.f.stalkMap y).hom)
    (hP : ((B.stalkIdeal (t.f y)).IsPrime ∧ IsRegularLocalRing (X.presheaf.stalk (t.f y) ⧸
      B.stalkIdeal (t.f y))) ∨ B.stalkIdeal (t.f y) = ⊤) (V : Subscheme X) :
    (Subscheme.strictTransform t V).stalkIdeal y =
      (strictTransformIdeal s (V.stalkIdeal (t.f y))).map e := by
  rw [Subscheme.strictTransform_stalkIdeal]
  simp_rw [Subscheme.stalkIdeal_colon_eq_map t y s e he V]
  rw [← Ideal.map_iSup]
  congr 1
  exact (s.strictTransformIdeal_eq_iSup_colon hP _).symm

/-- Colon by a power of a principal ideal. -/
theorem Ideal.colon_pow_of_eq_span {R : Type u} [CommRing R] (I E : Ideal R) (a : R)
    (h : E = Ideal.span {a}) (n : ℕ) : I.colon ((E ^ n : Ideal R) : Set R) = I.colon {a ^ n} := by
  subst h
  rw [Ideal.span_singleton_pow, Ideal.colon_span]

/-- In a domain, `(w^ν h_j)_j : (w)^ν = (h_j)_j`. -/
theorem Ideal.colon_span_range_mul_pow {R : Type u} [CommRing R] [IsDomain R] (w : R) (hw : w ≠ 0)
    (ν : ℕ) {ι : Type*} [Fintype ι] (h : ι → R) :
    (Ideal.span (Set.range fun j => w ^ ν * h j)).colon
        ((Ideal.span {w} ^ ν : Ideal R) : Set R) = Ideal.span (Set.range h) := by
  have hν : w ^ ν ≠ 0 := pow_ne_zero ν hw
  ext a
  rw [Submodule.mem_colon]
  constructor
  · intro ha
    have h1 := ha (w ^ ν) (by
      rw [Ideal.span_singleton_pow]; exact Ideal.mem_span_singleton_self _)
    rw [smul_eq_mul, Submodule.mem_span_range_iff_exists_fun] at h1
    obtain ⟨c, hc⟩ := h1
    rw [Ideal.mem_span_range_iff_exists_fun]
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ hν
    rw [mul_comm (w ^ ν) a, ← hc, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [smul_eq_mul]; ring
  · intro ha p hp
    rw [Ideal.span_singleton_pow, SetLike.mem_coe, Ideal.mem_span_singleton'] at hp
    obtain ⟨q, rfl⟩ := hp
    rw [Ideal.mem_span_range_iff_exists_fun] at ha
    obtain ⟨c, hc⟩ := ha
    rw [smul_eq_mul, Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun j => q * c j, ?_⟩
    rw [← hc, Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [smul_eq_mul]; ring


/-- Stalks of an ideal sheaf at equal points correspond under `stalkCongr`. -/
theorem Subscheme.stalkIdeal_eq_map_stalkCongr {Y : Scheme.{u}} (D : Subscheme Y) {q q' : Y}
    (h : q = q') :
    D.stalkIdeal q' = (D.stalkIdeal q).map (Y.presheaf.stalkCongr (Inseparable.of_eq h)).hom.hom := by
  subst h
  simp only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl]
  simp

/-- Colon by a principal ideal commutes with flat extension. -/
theorem Ideal.map_colon_singleton_eq_of_flat {A A' : Type u} [CommRing A] [CommRing A']
    [Algebra A A'] [Module.Flat A A'] (I : Ideal A) (x : A) :
    (I.colon ({x} : Set A)).map (algebraMap A A') =
      (I.map (algebraMap A A')).colon ({algebraMap A A' x} : Set A') := by
  refine le_antisymm ?_ (Ideal.colon_map_le_map_colon_of_flat I x)
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, Submodule.mem_colon_singleton]
  rw [Submodule.mem_colon_singleton] at ha
  rw [smul_eq_mul, ← map_mul]
  exact Ideal.mem_map_of_mem _ (by simpa using ha)



/-- In a domain, `(c_p (w u)^b)_p : (w)^b = (c_p)_p` for a unit `u`. -/
theorem Ideal.colon_span_range_mul_pow_unit {R : Type u} [CommRing R] [IsDomain R] (w : R)
    (hw : w ≠ 0) (b : ℕ) (u : Rˣ) {ι : Type*} [Fintype ι] (c : ι → R) :
    (Ideal.span (Set.range fun p => c p * (w * (u : R)) ^ b)).colon
        ((Ideal.span {w} ^ b : Ideal R) : Set R) = Ideal.span (Set.range c) := by
  have h1 : (Set.range fun p => c p * (w * (u : R)) ^ b) =
      Set.range fun p => w ^ b * ((u ^ b : Rˣ) * c p : R) := by
    congr 1
    funext p
    rw [mul_pow, Units.val_pow_eq_pow_val]; ring
  rw [h1, Ideal.colon_span_range_mul_pow w hw b (fun p => ((u ^ b : Rˣ) * c p : R))]
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨p, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p, rfl⟩)
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨p, rfl⟩
    have : c p = ((u ^ b)⁻¹ : Rˣ) * (((u ^ b : Rˣ) : R) * c p) := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p, rfl⟩)

/-- If `e a ∈ M_B^n` for a ring isomorphism of local rings, then `a ∈ M_A^n`. -/
theorem mem_pow_maximalIdeal_of_ringEquiv {A B : Type u} [CommRing A] [IsLocalRing A] [CommRing B]
    [IsLocalRing B] (e : A ≃+* B) {a : A} {n : ℕ} (h : e a ∈ maximalIdeal B ^ n) :
    a ∈ maximalIdeal A ^ n := by
  have h1 : (maximalIdeal B).map e.symm.toRingHom ≤ maximalIdeal A := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (IsLocalRing.mem_maximalIdeal _).mp hx (by simpa using hu.map e.toRingHom)
  have h2 : e.symm.toRingHom (e a) ∈ (maximalIdeal B ^ n).map e.symm.toRingHom :=
    Ideal.mem_map_of_mem _ h
  rw [Ideal.map_pow] at h2
  have := Ideal.pow_right_mono h1 n h2
  simpa using this

/-- A ring isomorphism of local rings preserves the maximal ideal. -/
theorem ringEquiv_mem_maximalIdeal_iff {A B : Type u} [CommRing A] [IsLocalRing A] [CommRing B]
    [IsLocalRing B] (e : A ≃+* B) {a : A} : e a ∈ maximalIdeal B ↔ a ∈ maximalIdeal A := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, mem_nonunits_iff]
  exact not_congr ⟨fun hu => by simpa using hu.map e.symm.toRingHom, fun hu => hu.map e.toRingHom⟩

/-- `ν_Q(z) = 1` for `z ∈ Q ∖ M²`, `Q` a proper ideal of the local ring with maximal ideal `M`. -/
theorem Ideal.ordElem_eq_one_of_mem_of_notMem_sq {R : Type u} [CommRing R] [IsLocalRing R]
    {Q : Ideal R} (hQ : Q ≠ ⊤) {z : R} (hzQ : z ∈ Q) (hz2 : z ∉ maximalIdeal R ^ 2) :
    Ideal.ordElem Q z = 1 := by
  refine le_antisymm (Ideal.ordElem_le_of_notMem (m := 1) fun h => hz2 ?_) ?_
  · have hle : Q ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal hQ
    exact Ideal.pow_right_mono hle 2 h
  · exact_mod_cast Ideal.le_ordElem (I := Q) (f := z) (ν := 1) (by simpa using hzQ)


/-! ### Stalks of ideal sheaves on `Spec` and along `Spec R' → Spec O_{X,x₀} → X` -/

/-- The comorphism of `Spec.map φ ≫ X.fromSpecStalk x₀` on sections over `U`. -/
theorem appLE_specMap_fromSpecStalk {X : Scheme.{u}} {x₀ : X} {R : CommRingCat.{u}} (φ : X.presheaf.stalk x₀ ⟶ R)
    (U : X.Opens) (hxU : x₀ ∈ U)
    (hle : (⊤ : (Spec R).Opens) ≤ (Spec.map φ ≫ X.fromSpecStalk x₀) ⁻¹ᵁ U) (a : Γ(X, U)) :
    ((Spec.map φ ≫ X.fromSpecStalk x₀).appLE U ⊤ hle).hom a =
      (Scheme.ΓSpecIso R).inv.hom (φ.hom (X.presheaf.germ U x₀ hxU a)) := by
  rw [Scheme.Hom.comp_appLE]
  have h1 := Scheme.fromSpecStalk_app (X := X) (x := x₀) (U := U) hxU
  rw [h1]
  simp only [Category.assoc]
  have h3 : (Spec (X.presheaf.stalk x₀)).presheaf.map (homOfLE le_top).op ≫
      (Spec.map φ).appLE (X.fromSpecStalk x₀ ⁻¹ᵁ U) ⊤ (by simpa using hle) =
      (Spec.map φ).appTop := by
    rw [Scheme.Hom.map_appLE]
    simp [Scheme.Hom.appLE]
    exact Category.comp_id _ |>.symm.trans rfl |>.symm
  have h4 : (Scheme.ΓSpecIso (X.presheaf.stalk x₀)).inv ≫ (Spec.map φ).appTop =
      φ ≫ (Scheme.ΓSpecIso R).inv := (Scheme.ΓSpecIso_inv_naturality φ).symm
  erw [h3, h4]
  rfl


/-- The subscheme `V(I)` of `Spec R`. -/
theorem mem_pts_ofIdealTop_spec (R : CommRingCat.{u}) (I : Ideal R) (P : Spec R) :
    P ∈ Subscheme.pts (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso R).inv.hom) : Subscheme (Spec R)) ↔
      I ≤ (show PrimeSpectrum R from P).asIdeal := by
  show P ∈ ((Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso R).inv.hom) : Subscheme (Spec R)).support : Set _) ↔ _
  rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Spec_zeroLocus]
  refine (PrimeSpectrum.mem_zeroLocus (x := (show PrimeSpectrum R from P)) _).trans ?_
  have hbij : Function.Bijective (Scheme.ΓSpecIso R).inv.hom :=
    ConcreteCategory.bijective_of_isIso (C := CommRingCat) _
  have hc : Ideal.comap (Scheme.ΓSpecIso R).inv.hom (I.map (Scheme.ΓSpecIso R).inv.hom) = I :=
    Ideal.comap_map_of_bijective _ hbij
  have hpre : (Scheme.ΓSpecIso R).inv.hom ⁻¹' (I.map (Scheme.ΓSpecIso R).inv.hom : Set _) =
      (I : Set R) := by
    rw [← Ideal.coe_comap, hc]
  rw [hpre]
  exact Iff.rfl

/-- The stalk at `P` of the ideal sheaf `V(I)` of `Spec R` is the extension of `I` to `R_P`,
read in the stalk `(Spec R).presheaf.stalk P ≅ R_P`. -/
theorem stalkIdeal_ofIdealTop_spec (R : CommRingCat.{u}) (I : Ideal R) (P : Spec R) :
    Subscheme.stalkIdeal (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso R).inv.hom) : Subscheme (Spec R)) P =
      (I.map (algebraMap R (Localization.AtPrime (show PrimeSpectrum R from P).asIdeal))).map
        (Spec.stalkIso R (show PrimeSpectrum R from P)).inv.hom := by
  have hP : P ∈ ((⊤ : (Spec R).Opens) : Set (Spec R)) := trivial
  rw [Subscheme.stalkIdeal_eq_map_germ_affine _ ⟨⊤, isAffineOpen_top _⟩ hP]
  show Ideal.map _ (Ideal.map _ (Ideal.map _ I)) = _
  rw [Ideal.map_map, Ideal.map_map, Ideal.map_map]
  congr 1
  ext s
  have h1 := ConcreteCategory.congr_hom (Spec.algebraMap_stalkIso_inv (show PrimeSpectrum R from P)) s
  simp only [CommRingCat.comp_apply] at h1
  show (Spec R).presheaf.germ ⊤ P hP ((Spec R).presheaf.map (homOfLE le_top).op
    ((Scheme.ΓSpecIso R).inv s)) = _
  have h2 : (Spec R).presheaf.map (homOfLE (le_refl (⊤ : (Spec R).Opens))).op = 𝟙 _ := by
    exact (Spec R).presheaf.map_id _
  rw [h2]
  exact h1.symm

/-- The stalk at `P` of the pull-back of `D` along `Spec R' → Spec S_{x_0} → X`: the extension of
`D_{x_0}` to `R'_P`. -/
theorem stalkIdeal_comap_specMap_fromSpecStalk {X : Scheme.{u}} (D : Subscheme X) (x₀ : X)
    (R' : CommRingCat.{u}) (φ : X.presheaf.stalk x₀ ⟶ R') (P : Spec R') :
    Subscheme.stalkIdeal (D.comap (Spec.map φ ≫ X.fromSpecStalk x₀)) P =
      (((D.stalkIdeal x₀).map φ.hom).map
        (algebraMap R' (Localization.AtPrime (show PrimeSpectrum R' from P).asIdeal))).map
        (Spec.stalkIso R' (show PrimeSpectrum R' from P)).inv.hom := by
  obtain ⟨U, hxU⟩ := Subscheme.exists_affineOpen_mem x₀
  have hP : P ∈ ((⊤ : (Spec R').Opens) : Set (Spec R')) := trivial
  have hle : (⊤ : (Spec R').Opens) ≤ (Spec.map φ ≫ X.fromSpecStalk x₀) ⁻¹ᵁ U.1 := by
    intro Q _
    have h1 : (Spec.map φ).base Q ⤳ IsLocalRing.closedPoint (X.presheaf.stalk x₀) :=
      (PrimeSpectrum.le_iff_specializes (R := X.presheaf.stalk x₀) _ _).mp
        (IsLocalRing.le_maximalIdeal ((show PrimeSpectrum (X.presheaf.stalk x₀) from
          (Spec.map φ).base Q)).isPrime.ne_top)
    have h2 := h1.map (X.fromSpecStalk x₀).continuous
    rw [Scheme.fromSpecStalk_closedPoint] at h2
    exact h2.mem_open U.1.2 hxU
  rw [Subscheme.stalkIdeal_eq_map_germ_affine _ ⟨⊤, isAffineOpen_top _⟩ hP,
    ideal_comap_eq_map_appLE _ D U ⟨⊤, isAffineOpen_top _⟩ hle,
    Subscheme.stalkIdeal_eq_map_germ_affine D U hxU]
  rw [Ideal.map_map, Ideal.map_map, Ideal.map_map, Ideal.map_map]
  congr 1
  ext a
  have h1 := ConcreteCategory.congr_hom
    (Spec.algebraMap_stalkIso_inv (show PrimeSpectrum R' from P))
    (φ.hom (X.presheaf.germ U.1 x₀ hxU a))
  simp only [CommRingCat.comp_apply] at h1
  have h2 := appLE_specMap_fromSpecStalk φ U.1 hxU hle a
  show (Spec R').presheaf.germ _ P hP ((Spec.map φ ≫ X.fromSpecStalk x₀).appLE U.1 ⊤ hle a) = _
  rw [h2]
  exact h1.symm

/-! ### The closed subscheme `V(I)` of `Spec R` for a prime `I` with `R/I` regular -/

/-- `R_p/(I R_p) ≅ (R/I)_{p/I}` for a prime `p ⊇ I`. -/
theorem nonempty_localization_quotient_equiv {R : Type u} [CommRing R] (I p : Ideal R) [p.IsPrime]
    (hp : I ≤ p) :
    haveI : (p.map (Ideal.Quotient.mk I)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
        rw [Ideal.mk_ker]; exact hp)
    Nonempty ((Localization.AtPrime p ⧸ I.map (algebraMap R (Localization.AtPrime p))) ≃+*
      Localization.AtPrime (p.map (Ideal.Quotient.mk I))) := by
  have : (p.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
      rw [Ideal.mk_ker]; exact hp)
  have hcomap : p = (p.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) := by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective p,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact (sup_eq_left.mpr hp).symm
  let φ := Localization.localRingHom p (p.map (Ideal.Quotient.mk I)) (Ideal.Quotient.mk I) hcomap
  have hφ : Function.Surjective φ := by
    intro y
    obtain ⟨b, s, rfl⟩ := IsLocalization.exists_mk'_eq (p.map (Ideal.Quotient.mk I)).primeCompl y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨s0, hs0⟩ := Ideal.Quotient.mk_surjective (s : R ⧸ I)
    have hs0p : s0 ∉ p := fun h => s.2 (hs0 ▸ Ideal.mem_map_of_mem _ h)
    refine ⟨IsLocalization.mk' (Localization.AtPrime p) a (⟨s0, hs0p⟩ : p.primeCompl), ?_⟩
    simp only [φ, Localization.localRingHom, IsLocalization.map_mk']
    congr 1
    exact Subtype.ext hs0
  have hker : RingHom.ker φ = I.map (algebraMap R (Localization.AtPrime p)) := by
    refine le_antisymm ?_ ?_
    · intro x hx
      obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq p.primeCompl x
      simp only [RingHom.mem_ker, φ, Localization.localRingHom, IsLocalization.map_mk'] at hx
      rw [IsLocalization.mk'_eq_zero_iff] at hx
      obtain ⟨t, ht⟩ := hx
      obtain ⟨t0, ht0e⟩ := Ideal.Quotient.mk_surjective (t : R ⧸ I)
      have ht0 : t0 ∉ p := fun h => t.2 (ht0e ▸ Ideal.mem_map_of_mem _ h)
      have hmem : t0 * a ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, ht0e]
        simpa [mul_comm] using ht
      have : IsLocalization.mk' (Localization.AtPrime p) a s =
          IsLocalization.mk' (Localization.AtPrime p) (t0 * a) (⟨t0, ht0⟩ * s) := by
        rw [IsLocalization.mk'_eq_iff_eq]
        simp only [Submonoid.coe_mul]
        ring_nf
      rw [this, IsLocalization.mk'_eq_mul_mk'_one]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)
    · rw [Ideal.map_le_iff_le_comap]
      intro i hi
      rw [Ideal.mem_comap, RingHom.mem_ker]
      simp only [φ, Localization.localRingHom_to_map]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hi, map_zero]
  exact ⟨(Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hφ)⟩

/-- The closed subscheme `V(I)` of `Spec R`, for a prime `I` with `R/I` regular local (`R` regular
local), is non-singular: its local rings are the localizations of the regular local ring `R/I`
(Serre, the cited leaf `isRegularLocalRing_localization_of_isRegularLocalRing`). -/
theorem isNonsingular_ofIdealTop_spec [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (R : CommRingCat.{u}) (I : Ideal R) [I.IsPrime]
    [IsRegularLocalRing R] [IsRegularLocalRing (R ⧸ I)] :
    Subscheme.IsNonsingular (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom) :
      Subscheme (Spec R)) := by
  refine Subscheme.isNonsingular_of_stalk_quot _ fun P hP => ?_
  have hIP := (mem_pts_ofIdealTop_spec R I P).mp hP
  have hPp : (show PrimeSpectrum R from P).asIdeal.IsPrime := (show PrimeSpectrum R from P).isPrime
  rw [stalkIdeal_ofIdealTop_spec]
  let e : Localization.AtPrime (show PrimeSpectrum R from P).asIdeal ≃+*
      (Spec R).presheaf.stalk P :=
    (Spec.stalkIso R (show PrimeSpectrum R from P)).symm.commRingCatIsoToRingEquiv
  obtain ⟨e2⟩ := nonempty_localization_quotient_equiv I (show PrimeSpectrum R from P).asIdeal hIP
  have : (Ideal.map (Ideal.Quotient.mk I) (show PrimeSpectrum R from P).asIdeal).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
      rw [Ideal.mk_ker]; exact hIP)
  have hreg := isRegularLocalRing_localization_of_isRegularLocalRing (R ⧸ I)
    (Ideal.map (Ideal.Quotient.mk I) (show PrimeSpectrum R from P).asIdeal)
  refine IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime
      (Ideal.map (Ideal.Quotient.mk I) (show PrimeSpectrum R from P).asIdeal)) ?_
  exact e2.symm.trans (Ideal.quotientEquiv _ _ e rfl)

/-- The points of `V(I)` in `Spec R`. -/
theorem pts_ofIdealTop_spec_eq (R : CommRingCat.{u}) (I : Ideal R) :
    Subscheme.pts (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom) :
      Subscheme (Spec R)) = {P : Spec R | I ≤ (show PrimeSpectrum R from P).asIdeal} :=
  Set.ext fun P => mem_pts_ofIdealTop_spec R I P

/-- `V(I)` is irreducible, of codimension `ht I`, for a prime `I` with `R/I` regular local. -/
theorem isIrreducible_and_codim_ofIdealTop_spec [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (R : CommRingCat.{u}) (I : Ideal R) [I.IsPrime]
    [IsRegularLocalRing R] [IsRegularLocalRing (R ⧸ I)] (hI : I.height = 1) :
    Subscheme.IsIrreducible (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom) :
      Subscheme (Spec R)) ∧
    Subscheme.codim (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom) :
      Subscheme (Spec R)) = 1 := by
  set D : Subscheme (Spec R) := Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom)
    with hD
  have hpts : D.pts = PrimeSpectrum.zeroLocus (I : Set R) := by
    rw [hD, pts_ofIdealTop_spec_eq]
    ext P
    exact (PrimeSpectrum.mem_zeroLocus _ _).symm
  have hirr : _root_.IsIrreducible D.pts := by
    rw [hpts]
    exact (PrimeSpectrum.isIrreducible_zeroLocus_iff I).mpr (by
      rw [Ideal.IsPrime.radical inferInstance]; infer_instance)
  have hDirr : D.IsIrreducible := Subscheme.isIrreducible_of_pts D hirr
  refine ⟨hDirr, ?_⟩
  let P0 : Spec R := (⟨I, inferInstance⟩ : PrimeSpectrum R)
  have hP0 : P0 ∈ D.pts := by
    rw [hD, pts_ofIdealTop_spec_eq]
    show I ≤ I
    exact le_rfl
  have hgen : IsGenericPoint P0 D.pts := by
    show closure {P0} = D.pts
    rw [hpts]
    exact PrimeSpectrum.closure_singleton (⟨I, inferInstance⟩ : PrimeSpectrum R)
  have hns := isNonsingular_ofIdealTop_spec R I
  rw [Subscheme.codim_eq_height D hns hDirr hP0]
  have h1 := Subscheme.height_stalkIdeal_eq D hns hgen hP0
  have h2 : ringKrullDim ((Spec R).presheaf.stalk P0) = (I.height : WithBot ℕ∞) := by
    let k : Algebra R ((Spec R).presheaf.stalk P0) := StructureSheaf.stalkAlgebra R P0
    have : IsLocalization.AtPrime ((Spec R).presheaf.stalk P0)
        (show PrimeSpectrum R from P0).asIdeal := StructureSheaf.IsLocalization.to_stalk R P0
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height (show PrimeSpectrum R from P0).asIdeal
      ((Spec R).presheaf.stalk P0)]
  rw [h2, hI] at h1
  exact_mod_cast h1

end Hironaka

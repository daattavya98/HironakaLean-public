/-!
# The order of `E` along `G` drops by one under the blow-up of `G` (Ch. IV §2, Lemma 5, p. 288)

The proof of Lemma 5 (p. 288) shows that the iteration of monoidal transformations with centers
`F^{(i)}` stops by the following one-step computation, which is stated here one step at a time.
Let `R_i` be the local ring of `X^{(i)}` at the generic point of `F^{(i)}`, `M_i` its maximal
ideal and `P_i` the prime ideal of `W^{(i)}` in `R_i`.  "Let `w` be an element of `M_0` which
generates the ideal `E^{(0)}` in `R_0`. Let `(z_1, …, z_r)` be a minimal base of the prime ideal
`P_0` in `R_0` and `(z_1, …, z_r, y)` a regular system of parameters of `R_0`. Let
`z_j^{(i)} = y^{-i} z_j` ... Then we can easily see that `(z_1^{(i)}, …, z_r^{(i)}, y)` is a
regular system of parameters of `R_i`. Let `w^{(i)} = y^{-i} w` ... Since `E` does not contain
`W`, `w` is not contained in `P_0`, hence, we have a positive integer `ν` such that
`P_0 + (y^ν) R_0` contains `w` but `P_0 + (y^{ν+1}) R_0` does not. Then one can easily see that
`w^{(ν)}` is a unit of `R_ν`." (p. 288, quoted with the indices and exponents
read as in the argument.)  The paper's `ν` is the order of `w` in the discrete valuation ring
`R_0/P_0 = O_{W,η}` (uniformizer `y`): `orderAt W E w` below.  Every step lowers the order by
exactly one (`exists_orderAt_strictTransform_add_one`), so after `ν` steps `E^{(ν)}` no longer
contains `F^{(ν)}`.

Deviation from the paper (statement generalized, gaps filled): the paper assumes `W` non-singular
irreducible and `F` of codimension one in `W`; here `G` need only be a Cartier divisor of `W`
(`W' ≅ W` then follows from invertibility).  The two "easily see" steps, that
`(z^{(i)}, y)` is a regular system of parameters of `R_i` and that `w^{(ν)}` is a unit of `R_ν`,
are proved: in Lean the `y`-adic order is the order of the DVR `O_{W,η}` and the statement is
`ν(E'|_{W'}) + 1 = ν(E|_W)` (`E'` generated by `w/x`, `x` generating the exceptional ideal).
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry IsLocalRing

namespace Hironaka

universe u

namespace Subscheme

variable {X : Scheme.{u}}

/-- **The measure `μ`**: the order of the ideal of `W ∩ E` in the local ring `O_{W,w}`, with respect
to its maximal ideal (`∞` if `W ∩ E` contains `W` near `w`, `0` if `w ∉ E`).  For `w` the generic
point of `F`, this is the paper's `ν` of the proof of Lemma 5 (p. 288): "a positive integer `ν`
such that `P_0 + (y^ν) R_0` contains `w` but `P_0 + (y^{ν+1}) R_0` does not", the order of `w` in
the discrete valuation ring `R_0/P_0` (the ideal of `W ∩ E` there is `(w)`). -/
@[blueprint "def:IV.2-5-order-along"
  (statement := /-- Let $W,E$ be subschemes of $X$ and $w$ a point of $W$. The \emph{order of
    $E$ along $W$ at $w$}, $\mu(W,E,w)\in\mathbb N\cup\{\infty\}$, is the order $\nu(J)$ of the
    ideal $J$ of $W\cap E$ in the local ring $\mathcal O_{W,w}$ with respect to its maximal ideal
    (\cref{def:order-nu}). For $w$ the generic point of $F$ and $W$ non-singular with $F$ of
    codimension one in $W$, $\mathcal O_{W,w}=R_0/P_0$ is a discrete valuation ring with
    uniformizer $y$, $J=(w)$ and $\mu=\nu$ is the integer of p.~288: ``a positive integer
    $\nu$ such that $P_0+(y^\nu)R_0$ contains $w$ but $P_0+(y^{\nu+1})R_0$ does not''. -/)
  (latexEnv := "definition")]
noncomputable def orderAt (W E : Subscheme X) (w : W.toScheme) : ℕ∞ :=
  Ideal.nu ((totalTransform W.ι E).stalkIdeal w)

/-- `μ ≥ 1` iff `w ∈ E`. -/
theorem one_le_orderAt_iff (W E : Subscheme X) (w : W.toScheme) :
    1 ≤ orderAt W E w ↔ W.ι w ∈ E.pts := by
  unfold orderAt Ideal.nu
  rw [(Ideal.ord_basic _ _ ⊥ ⊥).2.1]
  have hpts : W.ι w ∈ E.pts ↔ w ∈ (totalTransform W.ι E).pts := by
    rw [pts_totalTransform_eq_preimage]; rfl
  rw [hpts, mem_pts_iff_stalkIdeal_ne_top]
  constructor
  · intro h htop
    exact (maximalIdeal.isMaximal _).ne_top (top_le_iff.mp (htop ▸ h))
  · exact fun h => le_maximalIdeal h

/-- `μ < ∞` iff `W ⊄ E` at `w` (for a noetherian local ring `O_{W,w}`). -/
theorem orderAt_ne_top_iff (W E : Subscheme X) (w : W.toScheme)
    [IsNoetherianRing (W.toScheme.presheaf.stalk w)] :
    orderAt W E w ≠ ⊤ ↔ (totalTransform W.ι E).stalkIdeal w ≠ ⊥ := by
  unfold orderAt Ideal.nu
  rw [Ne, (Ideal.ord_basic _ _ ⊥ ⊥).1, Ne]
  constructor
  · intro h hbot
    exact h fun ν => hbot ▸ bot_le
  · intro h hall
    apply h
    rw [eq_bot_iff, ← Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal _)
      (maximalIdeal.isMaximal _).ne_top]
    exact le_iInf hall

end Subscheme

namespace BlowupOrderDrop

section Ring

variable {S : Type u} [CommRing S] [IsLocalRing S]

omit [IsLocalRing S] in
theorem ord_span_singleton (I : Ideal S) (x : S) :
    Ideal.ord I (Ideal.span {x}) = Ideal.ordElem I x := by
  simp only [Ideal.ord, Ideal.ordElem, Ideal.span_singleton_le_iff_mem]

/-- If the maximal ideal is generated by a non-zero-divisor `π`, then `ν(π a) = ν(a) + 1`. -/
@[blueprint "lem:IV.2-5-order-additive"
  (statement := /-- Let $S$ be a local ring whose maximal ideal is generated by a
    non-zero-divisor $\pi$. Then $\nu(\pi a)=\nu(a)+1$ for every $a\in S$. (Used on p.~288 for
    the discrete valuation ring $R_0/P_0$ with uniformizer $y$.) -/)
  (proof := /-- If $\pi a\in M^{n+1}=(\pi^{n+1})$ then $\pi a=c\pi^{n+1}$ and, $\pi$ being a
    non-zero-divisor, $a=c\pi^n\in M^n$; conversely $a\in M^n$ gives $\pi a\in M^{n+1}$. The
    case $\nu(a)=\infty$ is treated separately. -/)
  (latexEnv := "lemma")]
theorem ordElem_mul_of_maximalIdeal_eq_span {π : S} (hπ : π ∈ nonZeroDivisors S)
    (hM : maximalIdeal S = Ideal.span {π}) (a : S) :
    Ideal.ordElem (maximalIdeal S) (π * a) = Ideal.ordElem (maximalIdeal S) a + 1 := by
  have hπM : π ∈ maximalIdeal S := hM ▸ Ideal.mem_span_singleton_self π
  have hmul : ∀ (n : ℕ), a ∈ maximalIdeal S ^ n → π * a ∈ maximalIdeal S ^ (n + 1) := by
    intro n h
    rw [pow_succ']
    exact Ideal.mul_mem_mul hπM h
  have hdiv : ∀ (n : ℕ), π * a ∈ maximalIdeal S ^ (n + 1) → a ∈ maximalIdeal S ^ n := by
    intro n h
    rw [hM, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h
    obtain ⟨c, hc⟩ := h
    have h2 := (mem_nonZeroDivisors_iff_right.mp hπ) (a - c * π ^ n) (by
      linear_combination (-1 : S) * hc)
    rw [sub_eq_zero] at h2
    rw [hM, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    exact ⟨c, h2.symm⟩
  apply le_antisymm
  · refine Ideal.ordElem_le fun ν hν => ?_
    cases ν with
    | zero => exact zero_le
    | succ n =>
      have := Ideal.le_ordElem (hdiv n hν)
      push_cast
      exact add_le_add_left this 1
  · by_cases htop : Ideal.ordElem (maximalIdeal S) a = ⊤
    · rw [htop, top_add, top_le_iff, Ideal.ordElem_eq_top_iff]
      intro ν
      cases ν with
      | zero => simp
      | succ n => exact hmul n (Ideal.ordElem_eq_top_iff.mp htop n)
    · obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp htop
      rw [← hm]
      exact_mod_cast Ideal.le_ordElem (hmul m (Ideal.mem_pow_of_ordElem hm.symm))

variable {S' : Type u} [CommRing S'] [IsLocalRing S']

/-- The order of an ideal is invariant under an isomorphism of local rings. -/
theorem nu_map_ringEquiv (ρ : S ≃+* S') (J : Ideal S) :
    Ideal.nu (J.map ρ) = Ideal.nu J := by
  unfold Ideal.nu Ideal.ord
  have hM : (maximalIdeal S).map ρ = maximalIdeal S' := map_ringEquiv_maximalIdeal ρ
  have key : ∀ ν : ℕ, J.map ρ ≤ maximalIdeal S' ^ ν ↔ J ≤ maximalIdeal S ^ ν := by
    intro ν
    rw [← hM, ← Ideal.map_pow, Ideal.map_le_iff_le_comap,
      Ideal.comap_map_of_bijective ρ ρ.bijective]
  simp only [key]

omit [IsLocalRing S] in
/-- If `(a) = (b)` and `a` is a non-zero-divisor, so is `b`. -/
theorem mem_nonZeroDivisors_of_span_eq {a b : S} (h : Ideal.span {a} = Ideal.span {b})
    (ha : a ∈ nonZeroDivisors S) : b ∈ nonZeroDivisors S := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp
    (h ▸ Ideal.mem_span_singleton_self a : a ∈ Ideal.span {b})
  rw [mem_nonZeroDivisors_iff_right]
  intro z hz
  have : z * a = 0 := by rw [← hc]; linear_combination c * hz
  exact (mem_nonZeroDivisors_iff_right.mp ha) z this

/-- The order drops by one when dividing by a generator of the maximal ideal. -/
theorem nu_span_singleton_mul {π a b : S} (hπ : π ∈ nonZeroDivisors S)
    (hM : maximalIdeal S = Ideal.span {π}) (hab : π * a = b) :
    Ideal.nu (Ideal.span {b}) = Ideal.nu (Ideal.span {a}) + 1 := by
  unfold Ideal.nu
  rw [ord_span_singleton, ord_span_singleton, ← hab, ordElem_mul_of_maximalIdeal_eq_span hπ hM]

end Ring

end BlowupOrderDrop

namespace MonoidalTransformation

variable {X : Scheme.{u}}

/-- A monoidal transformation whose center has an invertible sheaf of ideals is an isomorphism. -/
theorem isIso_f_of_isInvertibleIdeal' {B : Subscheme X} (t : MonoidalTransformation X B)
    (hB : B.IsInvertibleIdeal) : IsIso t.f := by
  obtain ⟨h, hh, -⟩ := t.universal X (𝟙 X) (by rw [Subscheme.totalTransform_id]; exact hB)
  have h2 : t.f ≫ h = 𝟙 _ :=
    (t.universal t.X' t.f t.invertible).unique
      (by rw [Category.assoc, hh, Category.comp_id]) (Category.id_comp _)
  exact ⟨⟨h, h2, hh⟩⟩

/-- If the ideal of `F ∩ W` in `W` is invertible, the strict transform of `W` is isomorphic to `W`
compatibly with the immersions (first assertion of Lemma 5, p. 287). -/
theorem exists_iso_strictTransform_of_isInvertibleIdeal' [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] {F : Subscheme X}
    (t : MonoidalTransformation X F) (W : Subscheme X)
    (hF : (Subscheme.totalTransform W.ι F).IsInvertibleIdeal) :
    ∃ e : (Subscheme.strictTransform t W).toScheme ≅ W.toScheme,
      e.hom ≫ W.ι = (Subscheme.strictTransform t W).ι ≫ t.f := by
  obtain ⟨⟨s⟩, hs⟩ := Subscheme.nonempty_monoidalTransformation_strictTransform t W
  obtain ⟨e, he⟩ := hs s
  have := isIso_f_of_isInvertibleIdeal' s hF
  refine ⟨e.symm ≪≫ asIso s.f, ?_⟩
  simp only [Iso.trans_hom, Iso.symm_hom, asIso_hom, Category.assoc]
  rw [← he]
  simp

/-- The computation of the drop on the stalk at `w'`, for an arbitrary `W'` with an isomorphism
`ε : W' ≅ W` over `X` (the stalk computation of the proof of Lemma 5, p. 288: `E'` is generated by
`w/x`, `x` generating the exceptional ideal, which restricts to a uniformizer of `O_{W',w'}`). -/
@[blueprint "lem:IV.2-5-order-drop-aux"
  (statement := /-- Let $f\colon X'\to X$ be the monoidal transformation with center $G$,
    $W'\to W$ an isomorphism over $X$, and notation and hypotheses as in
    \cref{lem:IV.2-5-order-drop}. Then
    $\mu(W',E',w')+1=\mu(W,E,\varepsilon(w'))$. -/)
  (proof := /-- At $y'=w'$ the center is the maximal ideal $M$ of $R=\mathcal O_{X,f(y')}$, and
    $E_x=(e)$ with $R/(e)$ regular, so $e\in M\setminus M^2$ and $\nu_M(e)=1$. In the monoidal
    transform $R'$ with center $M$ the strict transform of $(e)$ is $(e/x)$ with
    $xg'=e$ (\cref{lem:III.6}). On $\mathcal O_{W',w'}\cong\mathcal O_{W,w}$ the exceptional
    ideal $(x)$ restricts to the maximal ideal, generated by a non-zero-divisor (invertibility of
    $G$ in $W$); by \cref{lem:IV.2-5-order-additive}, $\mu(W,E,w)=\nu(x\cdot g')=1+\nu(g')$.
    \textbf{Deviation from the paper (gap filled).} The paper's ``one can easily see that
    $w^{(\nu)}$ is a unit of $R_\nu$'' and ``we can easily see that $(z^{(i)}_1,\dots,z^{(i)}_r,y)$
    is a regular system of parameters of $R_i$'' (p.~288) are replaced by this order computation,
    one step at a time. -/)
  (proofUses := ["lem:III.6", "lem:IV.2-5-order-additive",
    "compat:blowup-stalk-monoidal-transform"])
  (latexEnv := "lemma")]
theorem orderAt_aux_add_one (hXns : X.IsNonsingular) {G : Subscheme X}
    (t : MonoidalTransformation X G) (W E : Subscheme X)
    (hinv : (Subscheme.totalTransform W.ι G).IsInvertibleIdeal)
    (W' : Subscheme t.X') (ε : W'.toScheme ≅ W.toScheme) (hε : ε.hom ≫ W.ι = W'.ι ≫ t.f)
    (w' : W'.toScheme)
    (hGw : G.stalkIdeal (W.ι (ε.hom w')) = maximalIdeal (X.presheaf.stalk (W.ι (ε.hom w'))))
    (hEprin : ∃ e, E.stalkIdeal (W.ι (ε.hom w')) = Ideal.span {e})
    (hEreg : IsRegularLocalRing (X.presheaf.stalk (W.ι (ε.hom w')) ⧸
      E.stalkIdeal (W.ι (ε.hom w'))))
    (hEmem : W.ι (ε.hom w') ∈ E.pts)
    (hWE : (Subscheme.totalTransform W.ι E).stalkIdeal (ε.hom w') ≠ ⊥) :
    Subscheme.orderAt W' (Subscheme.strictTransform t E) w' + 1 =
      Subscheme.orderAt W E (ε.hom w') := by
  have hpt : t.f (W'.ι w') = W.ι (ε.hom w') := by
    rw [← Scheme.Hom.comp_apply, ← hε, Scheme.Hom.comp_apply]
  have hGw0 := hGw
  rw [← hpt] at hGw hEprin hEreg hEmem
  have hXreg : IsRegularLocalRing (X.presheaf.stalk (t.f (W'.ι w'))) := hXns _
  have hdomX : IsDomain (X.presheaf.stalk (t.f (W'.ι w'))) :=
    Transforms.isDomain_of_isRegularLocalRing _
  obtain ⟨s, eiso, he, hexc⟩ := t.exists_monoidalTransform_stalk_exceptional (W'.ι w')
  obtain ⟨e, hEe⟩ := hEprin
  have hP : (G.stalkIdeal (t.f (W'.ι w'))).IsPrime := by
    rw [hGw]; exact (maximalIdeal.isMaximal _).isPrime
  have hS : IsRegularLocalRing (X.presheaf.stalk (t.f (W'.ι w')) ⧸
      G.stalkIdeal (t.f (W'.ι w'))) := by
    rw [hGw]
    let := Ideal.Quotient.field (maximalIdeal (X.presheaf.stalk (t.f (W'.ι w'))))
    infer_instance
  have hEne : E.stalkIdeal (t.f (W'.ι w')) ≠ ⊤ :=
    Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hEmem
  have heM : e ∈ maximalIdeal (X.presheaf.stalk (t.f (W'.ι w'))) := by
    by_contra h
    apply hEne
    rw [hEe, Ideal.span_singleton_eq_top]
    exact IsLocalRing.notMem_maximalIdeal.mp h
  -- the stalk map `ρ : O_{W,ε w'} ≅ O_{W',w'}` and the ideals on the `W'`-side
  let ρ : W.toScheme.presheaf.stalk (ε.hom w') ≃+* W'.toScheme.presheaf.stalk w' :=
    (asIso (ε.hom.stalkMap w')).commRingCatIsoToRingEquiv
  have hρ : ∀ D : Subscheme X,
      (Subscheme.totalTransform W'.ι (Subscheme.totalTransform t.f D)).stalkIdeal w' =
        ((Subscheme.totalTransform W.ι D).stalkIdeal (ε.hom w')).map ρ := by
    intro D
    have : Subscheme.totalTransform W'.ι (Subscheme.totalTransform t.f D) =
        Subscheme.totalTransform ε.hom (Subscheme.totalTransform W.ι D) := by
      rw [← Subscheme.totalTransform_comp, ← Subscheme.totalTransform_comp, hε]
    rw [this, stalkIdeal_totalTransform]
    rfl
  -- `G` in `W` and on the `W'`-side
  have hGW : (Subscheme.totalTransform W.ι G).stalkIdeal (ε.hom w') =
      maximalIdeal (W.toScheme.presheaf.stalk (ε.hom w')) := by
    rw [stalkIdeal_totalTransform, hGw0]
    exact IsLocalRing.map_maximalIdeal_of_surjective _ (W.ι.stalkMap_surjective _)
  have hG' : (Subscheme.totalTransform W'.ι t.exceptional).stalkIdeal w' =
      maximalIdeal (W'.toScheme.presheaf.stalk w') := by
    have := hρ G
    rw [hGW] at this
    exact this.trans (map_ringEquiv_maximalIdeal ρ)
  obtain ⟨π₀, hπ₀, hπ₀nzd⟩ := Subscheme.IsInvertibleIdeal.exists_stalkIdeal_eq_span hinv (ε.hom w')
  -- the generator `e/x` of the strict transform of `E`
  have hsM : G.stalkIdeal (t.f (W'.ι w')) = maximalIdeal (X.presheaf.stalk (t.f (W'.ι w'))) := hGw
  have heTop : e ≠ 0 := by
    intro h0
    apply hWE
    have h1 := hρ E
    have h2 : (Subscheme.totalTransform W'.ι (Subscheme.totalTransform t.f E)).stalkIdeal w' =
        ⊥ := by
      rw [stalkIdeal_totalTransform, stalkIdeal_totalTransform, hEe, h0,
        Ideal.span_singleton_eq_bot.mpr rfl, Ideal.map_bot, Ideal.map_bot]
    rw [h2] at h1
    exact (Ideal.map_eq_bot_iff_of_injective ρ.injective).mp h1.symm
  have hnsq : e ∉ maximalIdeal (X.presheaf.stalk (t.f (W'.ι w'))) ^ 2 := by
    rw [hEe] at hEreg
    exact rsop_notMem_sq_of_quotient heM heTop
  have hord : Ideal.ordElem (G.stalkIdeal (t.f (W'.ι w'))) e = 1 :=
    Ideal.ordElem_eq_one_of_mem_of_notMem_sq (hP.ne_top) (hsM ▸ heM) hnsq
  -- `e = x · e'` in the monoidal transform
  obtain ⟨g', hg'⟩ : ∃ g', s.xR * g' = s.toRing e := by
    have : s.toRing e ∈ (G.stalkIdeal (t.f (W'.ι w'))).map s.toRing :=
      Ideal.mem_map_of_mem _ (hsM ▸ heM)
    rw [← s.span_xR_eq_map, Ideal.mem_span_singleton'] at this
    obtain ⟨c, hc⟩ := this
    exact ⟨c, by rw [mul_comm]; exact hc⟩
  have hstrict : (Subscheme.strictTransform t E).stalkIdeal (W'.ι w') =
      Ideal.span {eiso g'} := by
    rw [t.stalkIdeal_strictTransform_eq_map (W'.ι w') s eiso he (Or.inl ⟨hP, hS⟩) E, hEe,
      strictTransformIdeal_span_singleton_eq s hP hS e g' (by rw [hord]; simpa using hg'),
      Ideal.map_span, Set.image_singleton]
  -- the three ideals on the `W'`-side
  let ι' := (W'.ι.stalkMap w').hom
  have hJE : (Subscheme.totalTransform W'.ι (Subscheme.totalTransform t.f E)).stalkIdeal w' =
      Ideal.span {ι' (eiso s.xR) * ι' (eiso g')} := by
    rw [stalkIdeal_totalTransform, stalkIdeal_totalTransform, hEe, Ideal.map_span,
      Set.image_singleton, Ideal.map_span, Set.image_singleton]
    congr 2
    rw [← map_mul, ← map_mul, hg']
    congr 1
    exact (RingHom.congr_fun he e).symm
  have hJG : (Subscheme.totalTransform W'.ι t.exceptional).stalkIdeal w' =
      Ideal.span {ι' (eiso s.xR)} := by
    rw [stalkIdeal_totalTransform, hexc, Ideal.map_span, Set.image_singleton]
  have hJ' : (Subscheme.totalTransform W'.ι (Subscheme.strictTransform t E)).stalkIdeal w' =
      Ideal.span {ι' (eiso g')} := by
    rw [stalkIdeal_totalTransform, hstrict, Ideal.map_span, Set.image_singleton]
  have hM' : maximalIdeal (W'.toScheme.presheaf.stalk w') = Ideal.span {ι' (eiso s.xR)} :=
    hG'.symm.trans hJG
  have hnzd : ι' (eiso s.xR) ∈ nonZeroDivisors (W'.toScheme.presheaf.stalk w') := by
    have h1 : (Subscheme.totalTransform W.ι G).stalkIdeal (ε.hom w') = Ideal.span {π₀} := hπ₀
    have h2 : Ideal.span {ρ π₀} = Ideal.span {ι' (eiso s.xR)} := by
      rw [← hJG]
      have hρG : (Subscheme.totalTransform W'.ι t.exceptional).stalkIdeal w' =
          ((Subscheme.totalTransform W.ι G).stalkIdeal (ε.hom w')).map ρ := hρ G
      rw [hρG, h1, Ideal.map_span, Set.image_singleton]
    refine BlowupOrderDrop.mem_nonZeroDivisors_of_span_eq h2 ?_
    rw [mem_nonZeroDivisors_iff_right]
    intro z hz
    have := (mem_nonZeroDivisors_iff_right.mp hπ₀nzd) (ρ.symm z) (by
      apply ρ.injective
      rw [map_mul, map_zero, RingEquiv.apply_symm_apply]
      exact hz)
    rw [← ρ.apply_symm_apply z, this, map_zero]
  unfold Subscheme.orderAt
  rw [hJ', ← BlowupOrderDrop.nu_map_ringEquiv ρ, ← hρ E, hJE]
  exact (BlowupOrderDrop.nu_span_singleton_mul hnzd hM' rfl).symm

/-- **The drop** (Lemma 5, p. 288, one step: the measure `μ` decreases by one).  Let `t` be the
monoidal transformation of the non-singular scheme `X` with center `G`, `W` a subscheme in which
`G` is a Cartier divisor (`hinv`: the ideal of `G` in `W` is invertible; this holds if `W` is simple
along `G` and `G` has codimension one in `W`), `w` a point of `W` over the generic point of `G`
(`hGw`: `G_x = M_x`, `x = W.ι w`), and `E` a subscheme with `x ∈ E` whose ideal at `x` is principal
with regular quotient (`E` non-singular of codimension one at `x`) and `W ⊄ E` at `w`.  Then
`W'` (the strict transform of `W`) has a unique point `w'` over `w`, and
`μ(W', E', w') + 1 = μ(W, E, w)`.

The paper's own argument, stated one step at a time (p. 288): "The monoidal tranformation [sic]
`f : X' → X` induces in `W` the monoidal transformation of `W` with center `F`, which is clearly an
isomorphism because `W` is non-singular and `F` has codimension 1 in `W`" (here: `W' ≅ W` because
`G` is Cartier in `W`), and then, with `w` generating `E` in `R_0` and `(z_1, …, z_r, y)` a regular
system of parameters with `(z_j) = P_0`, "a positive integer `ν` such that `P_0 + (y^ν)R_0` contains
`w` but `P_0 + (y^{ν+1})R_0` does not" (the measure `μ`), and `w^{(i)} = y^{-i} w` (the equation
`e/x` of `E'`).

Deviation from the paper (statement generalized, gaps filled): `G` need only be Cartier in `W` (the
paper assumes `W` non-singular irreducible and `F` of codimension one in `W`).  The two "easily
see" steps, "(z^{(i)}, y) is a regular system of parameters of R_i" and "one can easily see that
w^{(ν)} is a unit of R_ν", are replaced by the order computation `μ' + 1 = μ`: `ν_M(e) = 1`
(`E` non-singular of codimension one), the strict transform of `(e)` in the monoidal transform
with center `M` is `(e/x)`, and `x` restricts to a uniformizer of `O_{W',w'} ≅ O_{W,w}`. -/
@[blueprint "lem:IV.2-5-order-drop"
  (statement := /-- Let $X$ be a non-singular algebraic scheme, $f\colon X'\to X$ the monoidal
    transformation with center $G$, $W\subseteq X$ a subscheme in which the ideal of $G$ is
    invertible, $w$ a point of $W$ over the generic point of $G$ (the ideal of $G$ at $x$ is the
    maximal ideal), and $E\subseteq X$ a subscheme whose ideal at $x$ is principal with regular
    quotient, with $x\in E$ and $W\not\subseteq E$ at $w$. Then the strict transform $W'$ of $W$
    has a unique point $w'$ over $w$, and $\mu(W',E',w')+1=\mu(W,E,w)$, $E'$ the strict
    transform of $E$ (\cref{def:IV.2-5-order-along}). (The measure of the proof of Lemma~5,
    p.~288.) -/)
  (proof := /-- The paper's own argument, stated one step at a time (p.~288). The monoidal
    transformation induces on $W$ the monoidal transformation with the invertible center $G$,
    hence an isomorphism $W'\cong W$ (\cref{lem:strict-transform-is-blowup}); the point $w'$ is the
    preimage of $w$. The rest is \cref{lem:IV.2-5-order-drop-aux}.
    \textbf{Deviation from the paper (statement generalized, gaps filled).} The paper assumes $W$
    non-singular irreducible and $F$ of codimension one in $W$; here $G$ need only be a Cartier
    divisor of $W$. The two ``easily see'' steps of p.~288, ``Then we can easily see that
    $(z^{(i)}_1,\dots,z^{(i)}_r,y)$ is a regular system of parameters of $R_i$'' and ``Then one
    can easily see that $w^{(\nu)}$ is a unit of $R_\nu$'', are proved as the order computation
    $\mu'+1=\mu$. -/)
  (proofUses := ["lem:IV.2-5-order-drop-aux", "lem:strict-transform-is-blowup"])
  (latexEnv := "lemma")]
theorem exists_orderAt_strictTransform_add_one [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] (hXns : X.IsNonsingular) {G : Subscheme X}
    (t : MonoidalTransformation X G) (W E : Subscheme X)
    (hinv : (Subscheme.totalTransform W.ι G).IsInvertibleIdeal) (w : W.toScheme)
    (hGw : G.stalkIdeal (W.ι w) = maximalIdeal (X.presheaf.stalk (W.ι w)))
    (hEprin : ∃ e, E.stalkIdeal (W.ι w) = Ideal.span {e})
    (hEreg : IsRegularLocalRing (X.presheaf.stalk (W.ι w) ⧸ E.stalkIdeal (W.ι w)))
    (hEmem : W.ι w ∈ E.pts) (hWE : (Subscheme.totalTransform W.ι E).stalkIdeal w ≠ ⊥) :
    ∃ w' : (Subscheme.strictTransform t W).toScheme,
      t.f ((Subscheme.strictTransform t W).ι w') = W.ι w ∧
      (∀ w'' : (Subscheme.strictTransform t W).toScheme,
        t.f ((Subscheme.strictTransform t W).ι w'') = W.ι w → w'' = w') ∧
      Subscheme.orderAt (Subscheme.strictTransform t W) (Subscheme.strictTransform t E) w' + 1 =
        Subscheme.orderAt W E w := by
  classical
  obtain ⟨ε, hε⟩ := exists_iso_strictTransform_of_isInvertibleIdeal' t W hinv
  obtain ⟨w', hw'⟩ : ∃ w', ε.hom w' = w := ⟨ε.inv w, by
    rw [← Scheme.Hom.comp_apply]; simp⟩
  subst hw'
  have hpt : t.f ((Subscheme.strictTransform t W).ι w') = W.ι (ε.hom w') := by
    rw [← Scheme.Hom.comp_apply, ← hε, Scheme.Hom.comp_apply]
  refine ⟨w', hpt, fun w'' h'' => ?_, ?_⟩
  · have h2 : W.ι (ε.hom w'') = t.f ((Subscheme.strictTransform t W).ι w'') := by
      rw [← Scheme.Hom.comp_apply, hε, Scheme.Hom.comp_apply]
    have h1 : W.ι (ε.hom w'') = W.ι (ε.hom w') := h2.trans h''
    exact (Scheme.homeoOfIso ε).injective (W.ι.isClosedEmbedding.injective h1)
  · exact orderAt_aux_add_one hXns t W E hinv _ ε hε w' hGw hEprin hEreg hEmem hWE

/-- The point `w'` of `W'` over `w` lies on `E'` iff `μ(W, E, w) ≥ 2` (so `H ⊆ E'` iff `μ ≥ 2`,
`H = W' ∩ t⁻¹(G)`, whose generic point is `w'`).  In the paper's terms, `w^{(ν)}` is a unit
exactly when the order `ν` has been used up: "as long as `E^{(i)}` contains `F^{(i)}`, `w^{(i)}` is
an element of `M_i`" (p. 288). -/
@[blueprint "lem:IV.2-5-order-drop-mem"
  (statement := /-- In the situation of \cref{lem:IV.2-5-order-drop}, the point $w'$ of $W'$ over
    $w$ lies on the strict transform $E'$ of $E$ if and only if $\mu(W,E,w)\ge2$; thus
    $F'=W'\cap f^{-1}(G)$ is contained in $E'$ iff $\mu\ge2$. -/)
  (proof := /-- $w'\in E'$ iff $\mu(W',E',w')\ge1$ (\cref{def:IV.2-5-order-along}, the ideal of
    $W'\cap E'$ being proper), and $\mu(W',E',w')+1=\mu(W,E,w)$ by
    \cref{lem:IV.2-5-order-drop}. -/)
  (proofUses := ["lem:IV.2-5-order-drop", "def:IV.2-5-order-along"])
  (latexEnv := "lemma")]
theorem mem_pts_strictTransform_iff_two_le_orderAt [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] (hXns : X.IsNonsingular) {G : Subscheme X}
    (t : MonoidalTransformation X G) (W E : Subscheme X)
    (hinv : (Subscheme.totalTransform W.ι G).IsInvertibleIdeal) (w : W.toScheme)
    (hGw : G.stalkIdeal (W.ι w) = maximalIdeal (X.presheaf.stalk (W.ι w)))
    (hEprin : ∃ e, E.stalkIdeal (W.ι w) = Ideal.span {e})
    (hEreg : IsRegularLocalRing (X.presheaf.stalk (W.ι w) ⧸ E.stalkIdeal (W.ι w)))
    (hEmem : W.ι w ∈ E.pts) (hWE : (Subscheme.totalTransform W.ι E).stalkIdeal w ≠ ⊥)
    (w' : (Subscheme.strictTransform t W).toScheme)
    (hw' : t.f ((Subscheme.strictTransform t W).ι w') = W.ι w) :
    (Subscheme.strictTransform t W).ι w' ∈ (Subscheme.strictTransform t E).pts ↔
      2 ≤ Subscheme.orderAt W E w := by
  obtain ⟨w₁, hw₁, huniq, hμ⟩ := exists_orderAt_strictTransform_add_one hXns t W E hinv w hGw
    hEprin hEreg hEmem hWE
  obtain rfl := huniq w' hw'
  rw [← Subscheme.one_le_orderAt_iff, ← hμ]
  generalize Subscheme.orderAt (Subscheme.strictTransform t W) (Subscheme.strictTransform t E) w'
    = m
  induction m using ENat.recTopCoe with
  | top => simp
  | coe n => norm_cast; omega

end MonoidalTransformation

end Hironaka

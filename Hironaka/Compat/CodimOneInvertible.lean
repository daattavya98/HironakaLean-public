/-!
# Ch. 0 §5, Def. 2 (p. 141): invertible sheaf of ideals versus everywhere of codimension one

Hironaka, Ch. 0 §5, Definition 2, p. 141: "Let X be a non-singular algebraic 𝔅-scheme [...]. Let E
be a reduced subscheme [...] of X. Assume that the sheaf of ideals of E on X is invertible (or,
equivalently, E is everywhere of codimension one on X in the sense specified in a later chapter)."
The paper states the equivalence without proof or citation (p. 163 defines the codimension but
proves nothing).  This module proves it:

* `Subscheme.isEverywhereCodimOne_iff_isInvertibleIdeal_of_isNonsingular`: for a non-singular
  algebraic scheme `X` and a reduced subscheme `E`, `E` is everywhere of codimension one iff its
  sheaf of ideals is invertible.

Deviation from the paper (gap filled): the equivalence is asserted on p. 141 without proof.  The
proof is the standard one, organized stalkwise:

* "invertible ⇔ every stalk of the ideal is principal, generated by a non-zero-divisor"
  (`Subscheme.exists_ideal_eq_span_of_stalkIdeal_eq_span`: a local generator spreads to an
  affine neighbourhood, by finite generation of the ideal and of an annihilator, since `X` is
  noetherian);
* invertible ⇒ codimension one: Krull's principal ideal theorem in `O_{X,x}`;
* codimension one ⇒ invertible: the stalk `E_x` of the reduced `E` is radical, its minimal primes
  are the stalks of the irreducible components of `E` through `x`, all of height one (the
  generic-point argument: at the generic point `ξ` of a component, `E_ξ` is the maximal ideal of
  `O_{X,ξ}`), and these are principal because the regular local ring `O_{X,x}` is a unique
  factorization domain (Auslander-Buchsbaum; **cited**, see
  `Hironaka/Compat/RegularLocalRingUFD.lean`: footnote 3 of the Introduction, p. 116, cites the
  theory of local rings); a radical ideal with all minimal primes principal of height one is
  principal in a UFD.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace IsLocalRing
open scoped nonZeroDivisors

namespace Hironaka

universe u v

/-! ### Spreading a local generator

A noetherian ring `A`, a prime `P`, an ideal `I` with `I A_P = (g)`, `g` a non-zero-divisor of
`A_P`: there are `t ∉ P` and `c ∈ I` with `I A_t = (c)`, `c` a non-zero-divisor of `A_t`. -/

section Spreading

variable {A : Type u} [CommRing A]

/-- Elementary form of the spreading of a local generator: if `I A_P = (g)` with `g` a
non-zero-divisor of `A_P`, then there are `c ∈ I` and `t ∉ P` with `t I ⊆ (c)` and
`t · Ann(c) = 0` (`I` and `Ann(c)` are finitely generated, `c` is `g` up to a unit of `A_P`).

Deviation from the paper (gap filled): the paper asserts without proof or citation that the ideal
sheaf of `E` is invertible when `E` is everywhere of codimension one (Def. 2, p. 141); this is
the step "a local generator of the stalk spreads to a neighbourhood". -/
@[blueprint "lem:0.2-codim-one-spread-ring"
  (statement := /-- Let $A$ be a noetherian ring, $P$ a prime of $A$, $I\subseteq A$ an ideal with
    $IA_P=(g)$, $g$ a non-zero-divisor of $A_P$. Then there are $c\in I$ and $t\notin P$ with
    $tI\subseteq(c)$ and $t\cdot\operatorname{Ann}(c)=0$. -/)
  (proof := /-- Write $g=c/s$ up to a unit with $c\in I$. Then $c/1$ is a non-zero-divisor
    generating $IA_P$. Each of the finitely many generators $i$ of $I$ satisfies
    $w_ii\in(c)$ with $w_i\notin P$, and each of the finitely many generators $b$ of
    $\operatorname{Ann}(c)$ maps to $0$ in $A_P$ (as $c/1$ is a non-zero-divisor), so
    $w_bb=0$ with $w_b\notin P$. Take $t$ the product of all $w$'s.
    \textbf{Deviation from the paper (gap filled).} The paper does not prove that the ideal
    sheaf is invertible. -/)
  (latexEnv := "lemma")]
theorem exists_mul_mem_span_and_mul_eq_zero_of_map_eq_span [IsNoetherianRing A] (P : Ideal A)
    [P.IsPrime] (I : Ideal A) {S : Type v} [CommRing S] [Algebra A S]
    [IsLocalization.AtPrime S P] {g : S} (hg : g ∈ S⁰)
    (hIg : I.map (algebraMap A S) = Ideal.span {g}) :
    ∃ t c : A, t ∉ P ∧ c ∈ I ∧ (∀ i ∈ I, ∃ r, t * i = r * c) ∧
      (∀ b, b * c = 0 → t * b = 0) := by
  classical
  have hgI : g ∈ I.map (algebraMap A S) := hIg ▸ Ideal.mem_span_singleton_self g
  obtain ⟨⟨⟨c, hc⟩, s⟩, hcs⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl S).mp hgI
  have hsunit : IsUnit (algebraMap A S (s : A)) := IsLocalization.map_units S s
  have hspan : Ideal.span {algebraMap A S c} = Ideal.span {g} := by
    rw [← hcs]; exact Ideal.span_singleton_mul_right_unit hsunit g
  have hcnzd : algebraMap A S c ∈ S⁰ := by
    rw [← hcs]; exact mul_mem_nonZeroDivisors.mpr ⟨hg, hsunit.mem_nonZeroDivisors⟩
  -- `t₁ • I ⊆ (c)`
  have key1 : ∀ i ∈ I, ∃ (w : P.primeCompl) (r : A), (w : A) * i = r * c := by
    intro i hi
    have h1 : algebraMap A S i ∈ Ideal.span {algebraMap A S c} := by
      rw [hspan, ← hIg]; exact Ideal.mem_map_of_mem _ hi
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp h1
    obtain ⟨⟨r, u⟩, hru⟩ := IsLocalization.surj P.primeCompl z
    have h2 : algebraMap A S ((u : A) * i) = algebraMap A S (r * c) := by
      rw [map_mul, map_mul, ← hru, ← hz]; ring
    obtain ⟨w, hw⟩ := (IsLocalization.eq_iff_exists P.primeCompl S).mp h2
    exact ⟨w * u, w * r, by simpa [mul_assoc] using hw⟩
  obtain ⟨T, hT⟩ := IsNoetherian.noetherian I
  choose! w r hwr using key1
  set t₁ : A := ∏ i ∈ T, (w i : A) with ht₁
  have ht₁mem : t₁ ∈ P.primeCompl := Submonoid.prod_mem _ fun i _ => (w i).2
  have hI1 : ∀ i ∈ I, ∃ r, t₁ * i = r * c := by
    intro i hi
    rw [← hT] at hi
    induction hi using Submodule.span_induction with
    | mem x hx =>
      have hxI : x ∈ I := hT ▸ Ideal.subset_span hx
      refine ⟨(∏ j ∈ T.erase x, (w j : A)) * r x, ?_⟩
      have h : t₁ = (w x : A) * ∏ j ∈ T.erase x, (w j : A) :=
        (Finset.mul_prod_erase T (fun j => (w j : A)) hx).symm
      calc t₁ * x = (∏ j ∈ T.erase x, (w j : A)) * ((w x : A) * x) := by rw [h]; ring
        _ = _ := by rw [hwr x hxI]; ring
    | zero => exact ⟨0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨rx, hrx⟩ := hx
      obtain ⟨ry, hry⟩ := hy
      exact ⟨rx + ry, by rw [mul_add, hrx, hry, add_mul]⟩
    | smul a x _ hx =>
      obtain ⟨rx, hrx⟩ := hx
      exact ⟨a * rx, by rw [smul_eq_mul, mul_left_comm, hrx]; ring⟩
  -- `t₂ • Ann(c) = 0`
  let Ann : Ideal A := LinearMap.ker (LinearMap.mulRight A c)
  have hAnn : ∀ b, b ∈ Ann ↔ b * c = 0 := fun b => by simp [Ann]
  have key2 : ∀ b ∈ Ann, ∃ w : P.primeCompl, (w : A) * b = 0 := by
    intro b hb
    have h0 : algebraMap A S b * algebraMap A S c = 0 := by
      rw [← map_mul, (hAnn b).mp hb, map_zero]
    have h1 : algebraMap A S b = 0 := (mem_nonZeroDivisors_iff_right.mp hcnzd) _ h0
    exact (IsLocalization.map_eq_zero_iff P.primeCompl S b).mp h1
  obtain ⟨T', hT'⟩ := IsNoetherian.noetherian Ann
  choose! w' hw' using key2
  set t₂ : A := ∏ i ∈ T', (w' i : A) with ht₂
  have ht₂mem : t₂ ∈ P.primeCompl := Submonoid.prod_mem _ fun i _ => (w' i).2
  have hA2 : ∀ b ∈ Ann, t₂ * b = 0 := by
    intro b hb
    rw [← hT'] at hb
    induction hb using Submodule.span_induction with
    | mem x hx =>
      have hxA : x ∈ Ann := hT' ▸ Ideal.subset_span hx
      have h : t₂ = (w' x : A) * ∏ j ∈ T'.erase x, (w' j : A) :=
        (Finset.mul_prod_erase T' (fun j => (w' j : A)) hx).symm
      calc t₂ * x = (∏ j ∈ T'.erase x, (w' j : A)) * ((w' x : A) * x) := by rw [h]; ring
        _ = 0 := by rw [hw' x hxA, mul_zero]
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]
  refine ⟨t₁ * t₂, c, (P.primeCompl.mul_mem ht₁mem ht₂mem), hc, ?_, ?_⟩
  · intro i hi
    obtain ⟨ri, hri⟩ := hI1 i hi
    exact ⟨t₂ * ri, by rw [mul_assoc, mul_left_comm, hri]; ring⟩
  · intro b hb
    rw [mul_assoc, hA2 b ((hAnn b).mpr hb), mul_zero]

/-- Away form: if `t • I ⊆ (c)` and `t • Ann(c) = 0`, then over any localization `B` of `A` away
from `t` the ideal `I B` is generated by the non-zero-divisor `c`.

Deviation from the paper (gap filled): see `exists_mul_mem_span_and_mul_eq_zero_of_map_eq_span`. -/
@[blueprint "lem:0.2-codim-one-spread-away"
  (statement := /-- Let $I\subseteq A$ be an ideal, $c\in I$ and $t\in A$ with $tI\subseteq(c)$
    and $t\cdot\operatorname{Ann}(c)=0$. Then in every localization $B$ of $A$ away from $t$,
    $IB=(c)$ and $c$ is a non-zero-divisor of $B$. -/)
  (proof := /-- $t$ is a unit of $B$, so $IB\subseteq(c)B$. If $yc=0$ in $B$ write
    $y=b/t^n$; then $t^mbc=0$, hence $t^{m+1}b=0$ and $y=0$. -/)
  (latexEnv := "lemma")]
theorem map_eq_span_and_mem_nonZeroDivisors_of_away {t c : A} {I : Ideal A} (hcI : c ∈ I)
    (h1 : ∀ i ∈ I, ∃ r, t * i = r * c) (h2 : ∀ b, b * c = 0 → t * b = 0)
    (B : Type v) [CommRing B] [Algebra A B] [IsLocalization.Away t B] :
    I.map (algebraMap A B) = Ideal.span {algebraMap A B c} ∧ algebraMap A B c ∈ B⁰ := by
  have ht : IsUnit (algebraMap A B t) := IsLocalization.Away.algebraMap_isUnit t
  obtain ⟨u, hu⟩ := ht
  refine ⟨le_antisymm ?_ ?_, ?_⟩
  · rw [Ideal.map_le_iff_le_comap]
    intro i hi
    obtain ⟨r, hr⟩ := h1 i hi
    rw [Ideal.mem_comap, Ideal.mem_span_singleton']
    refine ⟨↑u⁻¹ * algebraMap A B r, ?_⟩
    have h : algebraMap A B t * algebraMap A B i = algebraMap A B r * algebraMap A B c := by
      rw [← map_mul, ← map_mul, hr]
    calc ↑u⁻¹ * algebraMap A B r * algebraMap A B c
        = ↑u⁻¹ * (algebraMap A B t * algebraMap A B i) := by rw [h]; ring
      _ = algebraMap A B i := by rw [← hu, ← mul_assoc, Units.inv_mul, one_mul]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ hcI
  · rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    obtain ⟨⟨b, s⟩, hb⟩ := IsLocalization.surj (Submonoid.powers t) y
    have hb' : algebraMap A B (b * c) = 0 := by
      rw [map_mul, ← hb, mul_right_comm, hy, zero_mul]
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers t) B _).mp hb'
    obtain ⟨k, hk⟩ := m.2
    have hm' : t ^ k * b * c = 0 := by
      have : (m : A) * (b * c) = 0 := hm
      rw [← hk] at this
      rw [mul_assoc]; exact this
    have h3 : t * (t ^ k * b) = 0 := h2 _ hm'
    have h4 : t ^ (k + 1) * b = 0 := by
      rw [pow_succ, mul_comm (t ^ k) t, mul_assoc]; exact h3
    have hunit : IsUnit (algebraMap A B (t ^ (k + 1))) := by
      rw [map_pow]; exact IsUnit.pow _ ⟨u, hu⟩
    have h5 : algebraMap A B b = 0 := by
      have : algebraMap A B (t ^ (k + 1) * b) = 0 := by rw [h4, map_zero]
      rw [map_mul] at this
      exact hunit.mul_right_eq_zero.mp this
    have h6 : y * algebraMap A B (s : A) = 0 := by rw [hb, h5]
    exact (IsLocalization.map_units B s).mul_left_eq_zero.mp h6

end Spreading

/-! ### Principal radical ideals in a unique factorization domain -/

section UFD

variable {R : Type u} [CommRing R]

/-- The meet of finitely many pairwise incomparable principal prime ideals is principal. -/
@[blueprint "lem:0.2-codim-one-inf-principal-primes"
  (statement := /-- In an integral domain, the intersection of finitely many pairwise
    incomparable principal prime ideals $(\pi_1),\dots,(\pi_k)$ is the principal ideal
    $(\pi_1\cdots\pi_k)$. -/)
  (proof := /-- Induction on $k$: if $\pi\nmid y$ then $(\pi)\cap(y)=(\pi y)$, because $\pi$ is
    prime; and $\pi\nmid\pi_1\cdots\pi_{k-1}$ since otherwise some $(\pi_i)\subseteq(\pi)$
    (prime avoidance for the intersection). -/)
  (latexEnv := "lemma")]
theorem isPrincipal_sInf_finset_of_forall_exists_prime :
    ∀ (S : Finset (Ideal R)), (∀ P ∈ S, ∃ π : R, Prime π ∧ P = Ideal.span {π}) →
      (∀ P ∈ S, ∀ Q ∈ S, P ≤ Q → P = Q) → (sInf (S : Set (Ideal R))).IsPrincipal := by
  classical
  intro S
  induction S using Finset.induction_on with
  | empty =>
    intro _ _
    simpa using (⟨⟨1, (Ideal.span_singleton_one).symm⟩⟩ : (⊤ : Ideal R).IsPrincipal)
  | insert P S hPS ih =>
    intro hS hinc
    obtain ⟨π, hπ, rfl⟩ := hS P (Finset.mem_insert_self _ _)
    obtain ⟨y, hy⟩ := ih (fun Q hQ => hS Q (Finset.mem_insert_of_mem hQ))
      (fun Q hQ Q' hQ' => hinc Q (Finset.mem_insert_of_mem hQ) Q' (Finset.mem_insert_of_mem hQ'))
    have hprime : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
    have hπy : ¬ π ∣ y := by
      intro hdvd
      have h1 : S.inf id ≤ Ideal.span {π} := by
        rw [Finset.inf_id_eq_sInf, hy]
        exact Ideal.span_singleton_le_span_singleton.mpr hdvd
      obtain ⟨Q, hQS, hQle⟩ := (Ideal.IsPrime.inf_le' hprime).mp h1
      have := hinc Q (Finset.mem_insert_of_mem hQS) _ (Finset.mem_insert_self _ _) hQle
      exact hPS (this ▸ hQS)
    refine ⟨⟨π * y, ?_⟩⟩
    rw [Finset.coe_insert, sInf_insert, hy]
    ext z
    simp only [Ideal.mem_inf, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨hπz, ⟨w, rfl⟩⟩
      have : π ∣ w := ((hπ.dvd_or_dvd hπz).resolve_left hπy)
      obtain ⟨v, rfl⟩ := this
      exact ⟨v, by ring⟩
    · intro h
      exact ⟨(dvd_mul_right π y).trans h, (dvd_mul_left y π).trans h⟩

variable [IsDomain R] [IsNoetherianRing R] [UniqueFactorizationMonoid R]

/-- In a noetherian unique factorization domain, a radical ideal all of whose minimal primes have
height one is principal: it is the intersection of finitely many principal prime ideals
`(π_1), …, (π_k)`, which are pairwise incomparable, hence equal to `(π_1 ⋯ π_k)`.

Deviation from the paper (gap filled): used in the proof of the equivalence of Def. 2, p. 141
(see `Subscheme.isEverywhereCodimOne_iff_isInvertibleIdeal_of_isNonsingular`). -/
@[blueprint "lem:0.2-codim-one-radical-principal-ufd"
  (statement := /-- Let $R$ be a noetherian unique factorization domain and $I\subseteq R$ a
    radical ideal all of whose minimal primes have height one. Then $I$ is principal. -/)
  (proof := /-- $I$ is the intersection of its finitely many minimal primes. Each is principal
    (height-one primes of a unique factorization domain are generated by a prime element) and
    they are pairwise incomparable, so the intersection is generated by the product of the
    prime generators (\cref{lem:0.2-codim-one-inf-principal-primes}). -/)
  (proofUses := ["lem:0.2-codim-one-inf-principal-primes"])
  (latexEnv := "lemma")]
theorem isPrincipal_of_isRadical_of_forall_height_eq_one {I : Ideal R} (hI : I.IsRadical)
    (h : ∀ P ∈ I.minimalPrimes, P.height = 1) : I.IsPrincipal := by
  classical
  have hfin : I.minimalPrimes.Finite := Ideal.finite_minimalPrimes_of_isNoetherianRing R I
  have hsInf : sInf I.minimalPrimes = I := by
    rw [Ideal.sInf_minimalPrimes]; exact hI.radical
  have key := isPrincipal_sInf_finset_of_forall_exists_prime (R := R) hfin.toFinset ?_ ?_
  · rw [Set.Finite.coe_toFinset, hsInf] at key
    exact key
  · intro P hP
    rw [Set.Finite.mem_toFinset] at hP
    have hPprime : P.IsPrime := hP.isPrime
    obtain ⟨⟨π, hπ⟩⟩ := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one (h P hP)
    have hπ0 : π ≠ 0 := by
      rintro rfl
      exact Ideal.ne_bot_of_height_eq_one (h P hP) (by simpa using hπ)
    refine ⟨π, ?_, by simpa using hπ⟩
    rw [hπ] at hPprime
    exact (Ideal.span_singleton_prime hπ0).mp hPprime
  · intro P hP Q hQ hPQ
    rw [Set.Finite.mem_toFinset] at hP hQ
    exact le_antisymm hPQ (hQ.2 ⟨hP.isPrime, hP.1.2⟩ hPQ)

end UFD

/-! ### Height of an ideal with a maximal minimal prime -/

/-- In a local ring, if the maximal ideal is a minimal prime of `I` (i.e. it is the only prime over
`I`), then `I` and the maximal ideal have the same height. -/
@[blueprint "lem:0.2-codim-one-height-maximal-minimal-prime"
  (statement := /-- Let $R$ be a local ring and $I\subseteq R$ an ideal having the maximal ideal
    $\mathfrak m$ as a minimal prime. Then $\operatorname{ht}I=\operatorname{ht}\mathfrak m$. -/)
  (proof := /-- Every prime containing $I$ lies in $\mathfrak m$, hence equals $\mathfrak m$ by
    minimality; so $\mathfrak m$ is the only minimal prime of $I$. -/)
  (latexEnv := "lemma")]
theorem height_eq_of_maximalIdeal_mem_minimalPrimes {R : Type u} [CommRing R] [IsLocalRing R]
    {I : Ideal R} (hI : maximalIdeal R ∈ I.minimalPrimes) :
    I.height = (maximalIdeal R).height := by
  refine le_antisymm (Ideal.height_mono hI.1.2) ?_
  rw [I.height_eq_inf_minimalPrimes]
  refine le_iInf₂ fun P hP => ?_
  have hPle : P ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal hP.1.1.ne_top
  have hle : maximalIdeal R ≤ P := hI.2 ⟨hP.1.1, hP.1.2⟩ hPle
  rw [le_antisymm hPle hle]

namespace Subscheme

variable {X : Scheme.{u}}

/-! ### Invertible ideals are stalkwise principal on non-zero-divisors -/

/-- If the stalk of the ideal sheaf of `D` at `x` is generated by a non-zero-divisor `g` of
`O_{X,x}`, then on some affine neighbourhood `V` of `x` the ideal of sections of `D` is generated
by a non-zero-divisor of `Γ(X, V)`.  (`X` is locally noetherian.)

Deviation from the paper (gap filled): the paper asserts the invertibility of the ideal sheaf of
`E` (Def. 2, p. 141) without proof or citation; this is the passage from stalks to a
neighbourhood. -/
@[blueprint "lem:0.2-codim-one-spread"
  (statement := /-- Let $X$ be a locally noetherian scheme, $D$ a subscheme and $x\in X$ such
    that the stalk $D_x\subseteq\mathcal O_{X,x}$ of the ideal sheaf is generated by a
    non-zero-divisor. Then on an affine neighbourhood $V$ of $x$ the ideal $D(V)$ is generated by
    a non-zero-divisor of $\Gamma(X,V)$. -/)
  (proof := /-- Take an affine neighbourhood $U=\operatorname{Spec}A$ of $x$, $x\leftrightarrow P$,
    so $D_x=D(U)A_P$. Apply \cref{lem:0.2-codim-one-spread-ring} and
    \cref{lem:0.2-codim-one-spread-away} to $V=D(t)$, using $D(V)=D(U)\Gamma(X,V)$.
    \textbf{Deviation from the paper (gap filled).} The paper asserts the invertibility of the ideal sheaf of $E$ (Def.~2, p.~141) without proof or citation; this is the passage from stalks to a neighbourhood. -/)
  (proofUses := ["lem:0.2-codim-one-spread-ring", "lem:0.2-codim-one-spread-away"])
  (latexEnv := "lemma")]
theorem exists_ideal_eq_span_of_stalkIdeal_eq_span [IsLocallyNoetherian X] (D : Subscheme X)
    {x : X} {g : X.presheaf.stalk x} (hg : g ∈ (X.presheaf.stalk x)⁰)
    (h : D.stalkIdeal x = Ideal.span {g}) :
    ∃ (V : X.affineOpens) (_ : x ∈ (V : Opens X)) (a : Γ(X, V)),
      D.ideal V = Ideal.span {a} ∧ a ∈ nonZeroDivisors Γ(X, V) := by
  obtain ⟨U, hxU⟩ := exists_affineOpen_mem x
  have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian U
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxU⟩ : (U : Opens X))
  have hloc := U.2.isLocalization_stalk ⟨x, hxU⟩
  have hmap : (D.ideal U).map (algebraMap Γ(X, U) (X.presheaf.stalk x)) = Ideal.span {g} := by
    rw [← h, stalkIdeal_eq_map_germ_affine D U hxU]; rfl
  obtain ⟨t, c, htP, hcI, h1, h2⟩ :=
    exists_mul_mem_span_and_mul_eq_zero_of_map_eq_span (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal
      (D.ideal U) hg hmap
  have hxt : x ∈ X.basicOpen t := (X.mem_basicOpen _ _ hxU).mpr
    (IsLocalization.map_units (X.presheaf.stalk x)
      (⟨t, htP⟩ : (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl))
  have := U.2.isLocalization_basicOpen t
  obtain ⟨hspan, hnzd⟩ := map_eq_span_and_mem_nonZeroDivisors_of_away hcI h1 h2 Γ(X, X.basicOpen t)
  refine ⟨X.affineBasicOpen t, hxt, algebraMap Γ(X, U) Γ(X, X.basicOpen t) c, ?_, hnzd⟩
  rw [← D.map_ideal_basicOpen U t]
  exact hspan

/-- A subscheme of a locally noetherian scheme has an invertible sheaf of ideals iff every stalk of
the ideal is generated by a non-zero-divisor of the local ring. -/
@[blueprint "lem:0.2-codim-one-invertible-stalkwise"
  (statement := /-- On a locally noetherian scheme the ideal sheaf of a subscheme is invertible
    if and only if each stalk of the ideal is generated by a non-zero-divisor of the local
    ring. -/)
  (proof := /-- ($\Rightarrow$) the generator over an affine open germs to a non-zero-divisor
    of the stalk. ($\Leftarrow$) \cref{lem:0.2-codim-one-spread}. -/)
  (proofUses := ["lem:0.2-codim-one-spread"])
  (latexEnv := "lemma")]
theorem isInvertibleIdeal_iff_forall_exists_stalkIdeal_eq_span [IsLocallyNoetherian X]
    (D : Subscheme X) :
    D.IsInvertibleIdeal ↔ ∀ x, ∃ g ∈ (X.presheaf.stalk x)⁰, D.stalkIdeal x = Ideal.span {g} := by
  constructor
  · intro hD x
    obtain ⟨g, hgx, hg⟩ := hD.exists_stalkIdeal_eq_span x
    exact ⟨g, hg, hgx⟩
  · intro h x
    obtain ⟨g, hg, hgx⟩ := h x
    exact exists_ideal_eq_span_of_stalkIdeal_eq_span D hg hgx

/-! ### Invertible implies codimension one (Krull's principal ideal theorem) -/

/-- On a non-singular scheme an invertible sheaf of ideals defines a subscheme everywhere of
codimension one: at a point `x` of `E` the stalk `E_x` is generated by a non-zero-divisor, which is
a non-unit, so `E_x` has height one by Krull's principal ideal theorem.

Deviation from the paper (gap filled): the "only if" half of Def. 2, p. 141 ("or, equivalently"),
which the paper does not prove. -/
@[blueprint "lem:0.2-invertible-implies-codim-one"
  (statement := /-- Let $X$ be a non-singular noetherian scheme and $E\subseteq X$ a subscheme
    whose sheaf of ideals is invertible. Then $E$ is everywhere of codimension one on $X$. -/)
  (proof := /-- At a point $x\in E$ the stalk $E_x$ is generated by a non-zero-divisor $g$ of
    $\mathcal O_{X,x}$, which is a non-unit since $x\in E$. By Krull's principal ideal theorem
    the height of $(g)$ is at most one; it is at least one since $g\ne0$ and
    $\mathcal O_{X,x}$ is a domain. \textbf{Deviation from the paper (gap filled).} This is the ``only if'' half of Def.~2, p.~141 (``or, equivalently''), which the paper does not prove. -/)
  (latexEnv := "lemma")]
theorem isEverywhereCodimOne_of_isInvertibleIdeal (hX : X.IsNonsingular) {E : Subscheme X}
    (hE : E.IsInvertibleIdeal) : E.IsEverywhereCodimOne := by
  intro x hx
  obtain ⟨g, hgx, hg⟩ := hE.exists_stalkIdeal_eq_span x
  have hreg : IsRegularLocalRing (X.presheaf.stalk x) := hX x
  have : IsNoetherianRing (X.presheaf.stalk x) := inferInstance
  have hne : E.stalkIdeal x ≠ ⊤ := mem_pts_iff_stalkIdeal_ne_top.mp hx
  have hnu : ¬ IsUnit g := fun hu => hne (by rw [hgx]; exact Ideal.span_singleton_eq_top.mpr hu)
  show (E.stalkIdeal x).height = ((1 : ℕ) : ℕ∞)
  rw [hgx, Nat.cast_one]
  exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors hg hnu

/-! ### Codimension one implies invertible -/

/-- At the point of `U` given by a minimal prime `q` of the sections of `E` over an affine open
`U`, the stalk of the ideal of `E` has the same height as `q`: the maximal ideal `q · O_{X,ξ}` is
the only prime of `O_{X,ξ}` over `E_ξ`. -/
theorem height_stalkIdeal_fromSpec_eq {E : Subscheme X} {U : X.Opens} (hU : IsAffineOpen U)
    {q : PrimeSpectrum Γ(X, U)} (hq : q.asIdeal ∈ (E.ideal ⟨U, hU⟩).minimalPrimes) :
    (E.stalkIdeal (hU.fromSpec q)).height = q.asIdeal.height := by
  have hξU : hU.fromSpec q ∈ U := by
    rw [← SetLike.mem_coe, ← hU.range_fromSpec]; exact ⟨_, rfl⟩
  have hC := compStalk_ofClosed_mem_irreducibleComponents E hU hq
  have hξC : hU.fromSpec q ∈
      (ofClosed ⟨closure {hU.fromSpec q}, isClosed_closure⟩).pts := by
    rw [pts_ofClosed]; exact subset_closure rfl
  have hmin := stalkIdeal_mem_minimalPrimes hC hξC
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨hU.fromSpec q, hξU⟩ : U)
  have : IsLocalization.AtPrime (X.presheaf.stalk (hU.fromSpec q)) q.asIdeal :=
    hU.isLocalization_stalk' q hξU
  have hCξ : (ofClosed ⟨closure {hU.fromSpec q}, isClosed_closure⟩).stalkIdeal (hU.fromSpec q) =
      maximalIdeal (X.presheaf.stalk (hU.fromSpec q)) := by
    rw [compStalk_stalkIdeal_ofClosed_closure hU hξU q]
    exact IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal _
  rw [hCξ] at hmin
  rw [height_eq_of_maximalIdeal_mem_minimalPrimes hmin,
    ← IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal (X.presheaf.stalk (hU.fromSpec q))]
  exact IsLocalization.height_map_of_disjoint q.asIdeal.primeCompl q.asIdeal
    (Set.disjoint_left.mpr fun a ha haq => ha haq)

/-- Localizing at a prime `x` of `U` over `q` does not change the height of `q`. -/
theorem height_map_germ_eq {U : X.Opens} (hU : IsAffineOpen U) {x : X}
    (hxW : x ∈ U) {q : PrimeSpectrum Γ(X, U)}
    (hqx : q.asIdeal ≤ (hU.primeIdealOf ⟨x, hxW⟩).asIdeal) :
    (q.asIdeal.map (X.presheaf.germ U x hxW).hom).height = q.asIdeal.height := by
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : U)
  have := hU.isLocalization_stalk ⟨x, hxW⟩
  exact IsLocalization.height_map_of_disjoint (hU.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
    q.asIdeal (Set.disjoint_left.mpr fun a ha haq => ha (hqx haq))

/-- The generic-point argument: on a scheme where `E` is everywhere of codimension one, every
minimal prime of the stalk `E_x` has height one.  Such a minimal prime is `q · O_{X,x}` for a
minimal prime `q` of the sections of `E` over an affine neighbourhood `U` of `x`; the point
`ξ` of `U` given by `q` lies on `E`, and `E_ξ` has the maximal ideal `q · O_{X,ξ}` of `O_{X,ξ}` as
its only minimal prime, so `1 = codim_ξ E = ht E_ξ = ht q = ht (q · O_{X,x})`.

Deviation from the paper (gap filled): the passage "everywhere of codimension one" ⇒ "every
component through `x` has codimension one" (via generic points of components) is not made in the
paper (p. 163 defines the codimension at a point of `E` only). -/
@[blueprint "lem:0.2-codim-one-height-one-minimal-primes"
  (statement := /-- Let $E$ be a subscheme of $X$ everywhere of codimension one. Then for every
    $x\in X$ every minimal prime of the stalk $E_x\subseteq\mathcal O_{X,x}$ has height one. -/)
  (proof := /-- A minimal prime $p$ of $E_x$ is $q\mathcal O_{X,x}$ for a minimal prime $q$ of
    $E(U)$, $U$ an affine neighbourhood of $x$. The point $\xi\in U$ given by $q$ lies on $E$,
    and the maximal ideal $q\mathcal O_{X,\xi}$ is the only prime of $\mathcal O_{X,\xi}$ over
    $E_\xi$, so $1=\operatorname{codim}_\xi E=\operatorname{ht}E_\xi=\operatorname{ht}q=
    \operatorname{ht}p$. \textbf{Deviation from the paper (gap filled).} The passage from ``everywhere of codimension one'' to the statement that every component of $E$ through $x$ has codimension one (via generic points of components) is not made in the paper (p.~163 defines the codimension only at a point of $E$). -/)
  (latexEnv := "lemma")]
theorem height_eq_one_of_mem_minimalPrimes_stalkIdeal {E : Subscheme X}
    (hE : E.IsEverywhereCodimOne) {x : X} {p : Ideal (X.presheaf.stalk x)}
    (hp : p ∈ (E.stalkIdeal x).minimalPrimes) : p.height = 1 := by
  obtain ⟨⟨U, hU⟩, hxW⟩ := exists_affineOpen_mem x
  replace hxW : x ∈ U := hxW
  obtain ⟨C, hC, hxC, hCp⟩ := exists_mem_irreducibleComponents_of_mem_minimalPrimes E x hp
  obtain ⟨q, hqmin, hqx, rfl⟩ := compStalk_exists_prime E hU hxW hC hxC
  have hξE : hU.fromSpec q ∈ E.pts := (compStalk_fromSpec_mem_pts_iff E hU q).mpr hqmin.1.2
  have hcodim : (E.stalkIdeal (hU.fromSpec q)).height = 1 := by
    have := hE _ hξE
    exact_mod_cast this
  rw [← hCp, compStalk_stalkIdeal_ofClosed_closure hU hxW q, height_map_germ_eq hU hxW hqx,
    ← height_stalkIdeal_fromSpec_eq hU hqmin, hcodim]

/-- At each point the stalk of the ideal of a reduced subscheme everywhere of codimension one on
a non-singular scheme is generated by a non-zero-divisor.  (At a point of `E`: the stalk is
radical, all its minimal primes have height one, hence are principal as `O_{X,x}` is a unique
factorization domain (Auslander-Buchsbaum, **cited**:
`IsRegularLocalRing.uniqueFactorizationMonoid`), and so the stalk is principal; off `E` it is the
unit ideal.)

Deviation from the paper (gap filled): the "if" half of Def. 2, p. 141 ("or, equivalently"), which
the paper does not prove. -/
@[blueprint "lem:0.2-codim-one-stalk-principal"
  (statement := /-- Let $X$ be a non-singular scheme and $E\subseteq X$ a reduced subscheme
    everywhere of codimension one. Then every stalk $E_x$ is generated by a non-zero-divisor of
    $\mathcal O_{X,x}$. -/)
  (proof := /-- For $x\notin E$, $E_x=(1)$. For $x\in E$: $E_x$ is radical since $E$ is reduced,
    and all its minimal primes have height one
    (\cref{lem:0.2-codim-one-height-one-minimal-primes}). The regular local ring
    $\mathcal O_{X,x}$ is a unique factorization domain (\cref{lem:regular-local-ring-ufd}), so
    $E_x$ is principal (\cref{lem:0.2-codim-one-radical-principal-ufd}), generated by a non-zero
    element, i.e.\ a non-zero-divisor. \textbf{Deviation from the paper (gap filled).} This is the ``if'' half of Def.~2, p.~141 (``or, equivalently''), which the paper does not prove. -/)
  (proofUses := ["lem:0.2-codim-one-height-one-minimal-primes", "lem:regular-local-ring-ufd",
    "lem:0.2-codim-one-radical-principal-ufd"])
  (latexEnv := "lemma")]
theorem exists_stalkIdeal_eq_span_of_isEverywhereCodimOne [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] (hX : X.IsNonsingular)
    {E : Subscheme X} (hE : E.IsReduced) (h : E.IsEverywhereCodimOne) (x : X) :
    ∃ g ∈ (X.presheaf.stalk x)⁰, E.stalkIdeal x = Ideal.span {g} := by
  by_cases hx : x ∈ E.pts
  · have hreg : IsRegularLocalRing (X.presheaf.stalk x) := hX x
    have : IsNoetherianRing (X.presheaf.stalk x) := inferInstance
    have := isDomain_of_isRegularLocalRing (X.presheaf.stalk x)
    have := IsRegularLocalRing.uniqueFactorizationMonoid (X.presheaf.stalk x)
    have hrad := isRadical_stalkIdeal_of_isReduced hE x
    have hh : (E.stalkIdeal x).height = 1 := by
      have := h x hx
      exact_mod_cast this
    obtain ⟨⟨g, hg⟩⟩ := isPrincipal_of_isRadical_of_forall_height_eq_one hrad
      fun p hp => height_eq_one_of_mem_minimalPrimes_stalkIdeal h hp
    have hg0 : g ≠ 0 := by
      rintro rfl
      exact Ideal.ne_bot_of_height_eq_one hh (by simpa using hg)
    exact ⟨g, mem_nonZeroDivisors_of_ne_zero hg0, hg⟩
  · refine ⟨1, one_mem _, ?_⟩
    rw [stalkIdeal_eq_top_of_notMem_pts hx, Ideal.span_singleton_one]

/-- Def. 2, p. 141: for a reduced subscheme `E` of a non-singular algebraic scheme `X`, "the sheaf
of ideals of E on X is invertible (or, equivalently, E is everywhere of codimension one on X in
the sense specified in a later chapter)".  Hironaka states the equivalence without proof or
citation; the later chapter (p. 163) defines the codimension but does not prove it.

Deviation from the paper (gap filled): the equivalence is proved here; the argument is the
standard one (the paper gives none).  "Invertible ⇒ codimension one": at `x ∈ E` the stalk `E_x`
is generated by a non-zero-divisor, a non-unit of the domain `O_{X,x}`, so it has height one by
Krull's principal ideal theorem.  "Codimension one ⇒ invertible": `E_x` is radical (`E` reduced),
its minimal primes are the stalks of the irreducible components of `E` through `x`, which have
height one by the generic-point argument (at the generic point `ξ` of a component, `E_ξ` is the
maximal ideal of `O_{X,ξ}`); each is principal because the regular local ring `O_{X,x}` is a
unique factorization domain (Auslander–Buchsbaum, 1959: **cited**, as part of the theory of local
rings which footnote 3 of the Introduction, p. 116, cites as a whole:
`IsRegularLocalRing.uniqueFactorizationMonoid`; Mathlib does not have it), so `E_x` is a radical
ideal with finitely many principal height-one minimal primes, hence principal.  A local generator
of the stalk spreads to an affine neighbourhood, where it generates the ideal and is a
non-zero-divisor (finite generation of the ideal and of an annihilator; `X` is noetherian).  The
only unproved input is the cited UFD theorem.

Outline: at `x ∈ E` the ideal of `E` is the intersection of the
primes of the components of `E` through `x`, all of height one; in the regular local ring
`O_{X,x}`, a unique factorization domain, height-one primes are principal, so the ideal is
principal, generated by a non-zero element.  Conversely a non-zero principal ideal of a regular
local ring has height one by Krull's principal ideal theorem.

Def. 2 assumes `X` a non-singular *algebraic* scheme, and the Lean statement carries the hypothesis
`[IsAlgebraicScheme X]`; without it the statement is false: for `X = Spec A`, `A` an almost Dedekind domain which is not Dedekind, and
`E = V(m)` for a maximal ideal `m` which is not finitely generated, `E` is reduced and
everywhere of codimension one but its ideal sheaf is not invertible.  (The hypothesis is used only
through `IsAlgebraicScheme.isNoetherian`.) -/
@[blueprint "lem:0.2-codim-one-iff-invertible"
  (statement := /-- Let $X$ be a non-singular algebraic scheme and $E\subseteq X$ reduced. Then
    the sheaf of ideals of $E$ on $X$ is invertible if and only if $E$ is everywhere of
    codimension one on $X$. (Def.~2, p.~141: ``or, equivalently''.)
    Formalization note: ``algebraic'' is needed; without it the statement is false (almost Dedekind
    domains). -/)
  (proof := /-- Asserted without proof or citation on p.~141 (``or, equivalently''); p.~163
    defines the codimension but does not prove the equivalence.

    \textbf{Deviation from the paper (gap filled).} The equivalence is proved here by the
    standard argument. ($\Leftarrow$, invertible $\Rightarrow$ codimension one.) At $x\in E$ the
    stalk $E_x$ is generated by a non-zero-divisor, a non-unit of the domain
    $\mathcal O_{X,x}$, so its height is one by Krull's principal ideal theorem
    (\cref{lem:0.2-invertible-implies-codim-one}). ($\Rightarrow$, codimension one
    $\Rightarrow$ invertible.) The stalk $E_x$ is radical as $E$ is reduced; its minimal primes
    are the stalks of the irreducible components of $E$ through $x$, all of height one by the
    generic-point argument (\cref{lem:0.2-codim-one-height-one-minimal-primes}); the regular
    local ring $\mathcal O_{X,x}$ is a unique factorization domain
    (\cref{lem:regular-local-ring-ufd}, \emph{cited}: Auslander--Buchsbaum, which belongs to the
    theory of local rings cited through footnote~3 of the Introduction, p.~116, Zariski--Samuel
    Ch.~VII--VIII and Nagata [15]), so $E_x$ is a principal radical ideal
    (\cref{lem:0.2-codim-one-radical-principal-ufd,lem:0.2-codim-one-stalk-principal}); a local
    generator spreads to an affine neighbourhood, where it generates the ideal and is a
    non-zero-divisor (\cref{lem:0.2-codim-one-invertible-stalkwise}). The algebraicity of $X$
    is used only to know that $X$ is noetherian. -/)
  (proofUses := ["lem:0.2-invertible-implies-codim-one", "lem:0.2-codim-one-stalk-principal",
    "lem:0.2-codim-one-invertible-stalkwise"])
  (latexEnv := "lemma")]
theorem isEverywhereCodimOne_iff_isInvertibleIdeal_of_isNonsingular [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] [IsAlgebraicScheme X]
    (hX : X.IsNonsingular) (E : Subscheme X) (hE : E.IsReduced) :
    E.IsEverywhereCodimOne ↔ E.IsInvertibleIdeal := by
  have := IsAlgebraicScheme.isNoetherian X
  constructor
  · intro h
    exact (isInvertibleIdeal_iff_forall_exists_stalkIdeal_eq_span E).mpr
      (exists_stalkIdeal_eq_span_of_isEverywhereCodimOne hX hE h)
  · exact isEverywhereCodimOne_of_isInvertibleIdeal hX

end Subscheme

end Hironaka

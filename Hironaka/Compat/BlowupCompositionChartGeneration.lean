module

public import Hironaka.Compat.BlowupCompositionGeneration

/-!
# Ch. 0 §3 (p. 133): chart computations for the sheaf of ideals `J(m)`

"for a sufficiently large integer `m` there exists a coherent sheaf of ideals `J(m)` on `X₀` such
that `f₀⁻¹(J(m)) = f₀⁻¹(J₀)ᵐ J₁`."

This file contains the local steps of the proof (the assembly is in
`Hironaka.Compat.BlowupCompositionMain`):

* the chart `V_a` is a chart domain for `a` (the exceptional ideal is generated there by the
  non-zero-divisor `a`);
* a criterion for a section to lie in the push-forward `(L.map f)(U)` of a sheaf of ideals along a
  quasi-compact morphism, by testing on an affine cover of `f⁻¹(U)`;
* the pair lemma: a section `x/aᵏ` of `J₁` on the chart `V_a` extends, after multiplication by a
  power of `a`, to a section of `f⁻¹(J₀)ᵐ J₁` on every other chart `V_{a'}`.

No ampleness or cohomology is used: the sections of the chart ring `A[I/a]` are the explicit
fractions `x/aᵏ`, `x ∈ Iᵏ`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Filter
open scoped nonZeroDivisors

namespace Hironaka

universe u

/-! ### Push-forward of a sheaf of ideals: a criterion on an affine cover -/

section Map

variable {X X' : Scheme.{u}}

/-- Restriction of `appLE` to a smaller open. -/
theorem appLE_res (f : X' ⟶ X) {U : X.Opens} {V W : X'.Opens} (hV : V ≤ f ⁻¹ᵁ U)
    (hWV : W ≤ V) (y : Γ(X, U)) :
    X'.presheaf.map (homOfLE hWV).op (f.appLE U V hV y) = f.appLE U W (hWV.trans hV) y := by
  rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]

/-- A section `s` of `X` over an affine open `U` lies in the push-forward `(L.map f)(U)` of a
sheaf of ideals `L` along a quasi-compact morphism `f` as soon as its images lie in `L` on the
members of an affine cover of `f⁻¹(U)`.  (Mathlib's `IdealSheafData.ideal_map` needs `f⁻¹(U)`
affine, which fails for a blow-up.) -/
theorem mem_ideal_map_of_forall_appLE_mem (f : X' ⟶ X) [QuasiCompact f]
    (L : X'.IdealSheafData) (U : X.affineOpens) {ι : Type*} (V : ι → X'.affineOpens)
    (hV : ∀ i, (V i : X'.Opens) ≤ f ⁻¹ᵁ U)
    (hcov : ∀ y ∈ f ⁻¹ᵁ (U : X.Opens), ∃ i, y ∈ (V i : X'.Opens)) {s : Γ(X, U)}
    (hs : ∀ i, f.appLE U (V i) (hV i) s ∈ L.ideal (V i)) :
    s ∈ (L.map f).ideal U := by
  rw [Scheme.IdealSheafData.map, Scheme.Hom.ker_apply, RingHom.mem_ker]
  apply L.subscheme.IsSheaf.section_ext
  intro z hz
  obtain ⟨i, hi⟩ := hcov _ hz
  have hle : L.subschemeι ⁻¹ᵁ (V i : X'.Opens) ≤ (L.subschemeι ≫ f) ⁻¹ᵁ (U : X.Opens) :=
    fun w hw => hV i hw
  refine ⟨_, hle, hi, ?_⟩
  rw [map_zero, ← CommRingCat.comp_apply, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
    ← Scheme.Hom.appLE_comp_appLE L.subschemeι f U (V i) _ (hV i) le_rfl, CommRingCat.comp_apply,
    ← Scheme.Hom.app_eq_appLE, ← RingHom.mem_ker, L.ker_subschemeι_app]
  exact hs i

end Map

namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X} (t : MonoidalTransformation X B) (U : X.affineOpens)
  {a : Γ(X, U)}

/-! ### The chart `V_a` is a chart domain for `a` -/

/-- The ring map `Γ(X, U) → Γ(X', V_a)` factors as `Γ(X, U) → Γ(X, U)[I/a] ≅ Γ(X', V_a)`. -/
theorem appLE_chartV_hom (ha : a ∈ B.ideal U) :
    (t.f.appLE U (t.chartV U ha) (t.chartV_le U ha)).hom =
      (t.chartVEquiv U ha : chartAlgebra (B.ideal U) a →+* Γ(t.X', t.chartV U ha)).comp
        (algebraMap Γ(X, U) (chartAlgebra (B.ideal U) a)) :=
  RingHom.ext fun y => (t.chartVEquiv_algebraMap U ha y).symm

/-- The image of `a` on the chart `V_a`. -/
theorem chartVEquiv_algebraMap_mem_nonZeroDivisors (ha : a ∈ B.ideal U) :
    t.f.appLE U (t.chartV U ha) (t.chartV_le U ha) a ∈ Γ(t.X', t.chartV U ha)⁰ := by
  rw [← t.chartVEquiv_algebraMap U ha, ← MulEquivClass.map_nonZeroDivisors (t.chartVEquiv U ha)]
  exact Submonoid.mem_map_of_mem _ algebraMap_mem_nonZeroDivisors_chartAlgebra

/-- (P3a) On the chart `V_a` the exceptional ideal `f⁻¹(B)` is generated by the
non-zero-divisor `a`. -/
theorem isChartDomain_chartAff (ha : a ∈ B.ideal U) : t.IsChartDomain U a (t.chartAff U ha) := by
  refine ⟨t.chartV_le U ha, ?_, t.chartVEquiv_algebraMap_mem_nonZeroDivisors U ha⟩
  rw [exceptional_eq_comap, ideal_comap_eq_map_appLE t.f B U _ (t.chartV_le U ha)]
  change (B.ideal U).map (t.f.appLE U (t.chartV U ha) (t.chartV_le U ha)).hom = _
  rw [t.appLE_chartV_hom U ha, ← Ideal.map_map, map_algebraMap_chartAlgebra ha, Ideal.map_span,
    Set.image_singleton]
  exact congrArg (fun z => Ideal.span {z}) (t.chartVEquiv_algebraMap U ha a)

/-- The chart `V_a` is contained in every chart open on which `a` generates. -/
theorem le_chartV_of_isChartDomain (ha : a ∈ B.ideal U) {W : t.X'.affineOpens}
    (hW : t.IsChartDomain U a W) : (W : t.X'.Opens) ≤ t.chartV U ha := by
  rw [t.chartV_eq_chartOpen U ha]
  exact le_iSup₂ (f := fun (W : t.X'.affineOpens) (_ : t.IsChartDomain U a W) => W.1) W hW

theorem chartAff_le (ha : a ∈ B.ideal U) : (t.chartAff U ha : t.X'.Opens) ≤ t.f ⁻¹ᵁ U :=
  t.chartV_le U ha

/-- Every section of the chart ring is a fraction `x/aᵏ` with `x ∈ Iᵏ`: on `V_a`,
`aᵏ g = x`. -/
theorem exists_pow_mul_eq_appLE (ha : a ∈ B.ideal U) (g : Γ(t.X', (t.chartAff U ha : t.X'.Opens))) :
    ∃ (k : ℕ) (x : Γ(X, U)), x ∈ B.ideal U ^ k ∧
      t.f.appLE U _ (t.chartAff_le U ha) a ^ k * g = t.f.appLE U _ (t.chartAff_le U ha) x := by
  obtain ⟨r, rfl⟩ : ∃ r, t.chartVEquiv U ha r = g := ⟨_, RingEquiv.apply_symm_apply _ _⟩
  obtain ⟨k, x, hx, hr⟩ := (mem_chartAlgebra_iff ha).mp r.2
  refine ⟨k, x, hx, ?_⟩
  have hr' : algebraMap Γ(X, U) (chartAlgebra (B.ideal U) a) a ^ k * r =
      algebraMap Γ(X, U) (chartAlgebra (B.ideal U) a) x := by
    apply Subtype.ext
    change algebraMap Γ(X, U) (Localization.Away a) a ^ k * (r : Localization.Away a) =
      algebraMap Γ(X, U) (Localization.Away a) x
    rw [hr, mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
  have := congrArg (t.chartVEquiv U ha) hr'
  rw [map_mul, map_pow, t.chartVEquiv_algebraMap, t.chartVEquiv_algebraMap] at this
  exact this

/-! ### The pair lemma -/

variable (D₁ : Subscheme t.X')

/-- (P3c) The pair lemma.  Let `g = x/aᵏ` (`x ∈ Iᵏ`) be a section of `D₁` on the chart `V_a`.
Then for every other chart `V_{a'}` and all large `n`, the image of `aⁿ x` on `V_{a'}` lies in
`f⁻¹(B)^(n+k) D₁`.

Write `b = a/a'` on `V_{a'}` and `σ₀ = x/a'ᵏ`.  On `W = D_{V_{a'}}(b)` we have `a = a' b` with `b`
a unit, so `W ⊆ V_a` (`isChartDomain_basicOpen`), and there `a'ᵏ σ₀ = x = aᵏ g = a'ᵏ bᵏ g`;
cancelling the non-zero-divisor `a'ᵏ`, `σ₀ = bᵏ g ∈ D₁(W) = D₁(V_{a'})_b`.  Hence
`b^N σ₀ ∈ D₁(V_{a'})` for some `N`, and `aⁿ x = a'^(n+k) (bⁿ σ₀)` for `n ≥ N`. -/
theorem eventually_appLE_pow_mul_mem (ha : a ∈ B.ideal U) {a' : Γ(X, U)} (ha' : a' ∈ B.ideal U)
    {k : ℕ} {x : Γ(X, U)} (hx : x ∈ B.ideal U ^ k)
    {g : Γ(t.X', (t.chartAff U ha : t.X'.Opens))} (hg : g ∈ D₁.ideal (t.chartAff U ha))
    (hgx : t.f.appLE U _ (t.chartAff_le U ha) a ^ k * g = t.f.appLE U _ (t.chartAff_le U ha) x) :
    ∀ᶠ n in atTop, t.f.appLE U _ (t.chartAff_le U ha') (a ^ n * x) ∈
      (t.exceptional ^ (n + k) * D₁).ideal (t.chartAff U ha') := by
  set V' := t.chartAff U ha'
  have hV' : (V' : t.X'.Opens) ≤ t.f ⁻¹ᵁ U := t.chartAff_le U ha'
  set c' : Γ(t.X', (V' : t.X'.Opens)) := t.f.appLE U (V' : t.X'.Opens) hV' a'
  -- `σ₀ = x/a'ᵏ`
  set σ₀ : Γ(t.X', (V' : t.X'.Opens)) :=
    t.chartVEquiv U ha' ⟨_, algebraMap_mul_invSelf_pow_mem_chartAlgebra hx⟩
  have hσ₀ : c' ^ k * σ₀ = t.f.appLE U (V' : t.X'.Opens) hV' x := by
    have : t.f.appLE U (t.chartV U ha') (t.chartV_le U ha') a' ^ k *
        t.chartVEquiv U ha' ⟨_, algebraMap_mul_invSelf_pow_mem_chartAlgebra hx⟩ =
        t.f.appLE U (t.chartV U ha') (t.chartV_le U ha') x := by
      rw [← t.chartVEquiv_algebraMap U ha', ← t.chartVEquiv_algebraMap U ha', ← map_pow,
        ← map_mul]
      congr 1
      apply Subtype.ext
      change algebraMap Γ(X, U) (Localization.Away a') a' ^ k *
          (algebraMap Γ(X, U) (Localization.Away a') x * IsLocalization.Away.invSelf a' ^ k) =
        algebraMap Γ(X, U) (Localization.Away a') x
      rw [mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
    exact this
  -- `u = a/a'`
  set u : Γ(t.X', (V' : t.X'.Opens)) := t.chartVEquiv U ha' (chartAlgebra.frac (a := a') ha)
  have hu : t.f.appLE U (V' : t.X'.Opens) hV' a = c' * u := by
    have : t.f.appLE U (t.chartV U ha') (t.chartV_le U ha') a =
        t.f.appLE U (t.chartV U ha') (t.chartV_le U ha') a' *
          t.chartVEquiv U ha' (chartAlgebra.frac (a := a') ha) := by
      rw [← t.chartVEquiv_algebraMap U ha', ← t.chartVEquiv_algebraMap U ha', ← map_mul,
        chartAlgebra.algebraMap_mul_frac]
    exact this
  obtain ⟨_, hE', hc'⟩ := t.isChartDomain_chartAff U ha'
  have hc'' : c' ∈ Γ(t.X', (V' : t.X'.Opens))⁰ := hc'
  -- `W = D(u)` is a chart domain for `a`, hence lies in `V_a`
  have hW := t.isChartDomain_basicOpen U hV' (s := c') hE' hc'' hu
  set W : t.X'.affineOpens := affBasicOpen V' u
  have hWV : (W : t.X'.Opens) ≤ (t.chartAff U ha : t.X'.Opens) :=
    t.le_chartV_of_isChartDomain U ha hW
  have hWV' : (W : t.X'.Opens) ≤ (V' : t.X'.Opens) := t.X'.basicOpen_le u
  set ρ := t.X'.presheaf.map (homOfLE hWV').op
  set ρi := t.X'.presheaf.map (homOfLE hWV).op
  -- `σ₀ = uᵏ g` on `W`
  have hρc' : ρ c' ∈ Γ(t.X', (W : t.X'.Opens))⁰ := res_basicOpen_mem_nonZeroDivisors V' hc'' u
  have h1 : ρ c' ^ k * ρ σ₀ = t.f.appLE U (W : t.X'.Opens) (hWV'.trans hV') x := by
    rw [← map_pow, ← map_mul, hσ₀, appLE_res]
  have h2 : (ρ c' * ρ u) ^ k * ρi g = t.f.appLE U (W : t.X'.Opens) (hWV'.trans hV') x := by
    rw [← map_mul, ← hu, appLE_res, ← appLE_res t.f (t.chartAff_le U ha) hWV a, ← map_pow,
      ← map_mul, hgx, appLE_res]
  have h3 : ρ σ₀ = ρ u ^ k * ρi g := by
    have : ρ c' ^ k * (ρ σ₀ - ρ u ^ k * ρi g) = 0 := by
      rw [mul_sub, h1, ← mul_assoc, ← mul_pow, h2, sub_self]
    exact sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hρc' k)).mp this)
  have hρσ₀ : ρ σ₀ ∈ D₁.ideal W := by
    rw [h3]
    refine Ideal.mul_mem_left _ _ ?_
    rw [← D₁.map_ideal' (U := W) (V := t.chartAff U ha) (homOfLE hWV).op]
    exact Ideal.mem_map_of_mem _ hg
  -- localization: `u^N σ₀ ∈ D₁(V')`
  have hloc := V'.2.isLocalization_basicOpen u
  have hmem : ρ σ₀ ∈ (D₁.ideal V').map ρ.hom := (D₁.map_ideal_basicOpen V' u).ge hρσ₀
  obtain ⟨_, ⟨N, rfl⟩, hN⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers u)
      (S := Γ(t.X', t.X'.basicOpen u)) _ _).mp hmem
  refine eventually_atTop.mpr ⟨N, fun n hn => ?_⟩
  have key : t.f.appLE U (V' : t.X'.Opens) hV' (a ^ n * x) =
      c' ^ (n + k) * (u ^ (n - N) * (u ^ N * σ₀)) := by
    rw [map_mul, map_pow, hu, ← hσ₀, ← mul_assoc (u ^ (n - N)), ← pow_add, Nat.sub_add_cancel hn]
    ring
  rw [key]
  change _ ∈ t.exceptional.ideal V' ^ (n + k) * D₁.ideal V'
  rw [hE']
  exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) _)
    (Ideal.mul_mem_left _ _ hN)

end MonoidalTransformation

end Hironaka

module

public import Mathlib.RingTheory.Ideal.UFD
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Architect
public import Hironaka.Compat.RegularLocalRing
public import Hironaka.Compat.RegularQuotient
public import Hironaka.Statements

/-!
# Compatibility layer: a regular local ring is a unique factorization domain (cited)

The factoriality of regular local rings (Auslander--Buchsbaum, 1959) is not named in the paper but
belongs to the theory of local rings, which the paper cites as a whole in footnote 3 of the
Introduction (p. 116).  Mathlib does not have it.  It is used to prove that, on a non-singular
algebraic scheme, a reduced subscheme everywhere of codimension one has an invertible sheaf of
ideals (Ch. 0 §5, Def. 2, p. 141; see `Hironaka/Compat/CodimOneInvertible.lean`).

* `IsRegularLocalRing.uniqueFactorizationMonoid` (**cited leaf**): a regular local ring (which is
  a domain: `Hironaka.isDomain_of_isRegularLocalRing`) is a unique factorization domain.
* `IsRegularLocalRing.isPrincipal_of_height_eq_one`: a height-one prime of a regular local ring is
  principal (from the leaf and Mathlib's `UniqueFactorizationMonoid.isPrincipal_of_height_eq_one`).
-/

@[expose] public section

namespace Hironaka

universe u


/-- **Cited**: a regular local ring is a unique factorization domain
(M. Auslander and D. A. Buchsbaum, *Unique factorization in regular local rings*,
Proc. Nat. Acad. Sci. U.S.A. 45 (1959), 733--734).

The paper does not name this fact; it is part of the theory of local rings, which footnote 3 of
the Introduction (p. 116) cites: "The two chapters, VII and VIII, of Samuel-Zariski, [18], should
cover all that we need from the theory of local rings. A complete reference to the theory may be
obtained from M. Nagata [15]."  Mathlib does not have the statement.  The domain hypothesis is
automatic (`Hironaka.isDomain_of_isRegularLocalRing`); it is a binder only so that
`UniqueFactorizationMonoid R` makes sense. -/
@[blueprint "lem:regular-local-ring-ufd"
  (statement := /-- A regular local ring is a unique factorization domain. -/)
  (proof := /-- Cited, not proved in the paper: footnote~3 of the Introduction (p.~116):
    ``The two chapters, VII and VIII, of Samuel-Zariski, [18], should cover all that we need
    from the theory of local rings. A complete reference to the theory may be obtained from
    M.~Nagata [15].'' The theorem is due to M.~Auslander and D.~A.~Buchsbaum, \emph{Unique
    factorization in regular local rings}, Proc.\ Nat.\ Acad.\ Sci.\ U.S.A.\ 45 (1959),
    733--734. It belongs to the theory of local rings that footnote~3 of the Introduction
    (p.~116) cites (Zariski--Samuel, Ch.~VII--VIII; Nagata [15]); Mathlib does not have it. Used for the equivalence in Def.~2, p.~141 (see
    \cref{lem:0.2-codim-one-iff-invertible}), which the paper states without proof or
    citation. -/)
  (latexEnv := "lemma")]
theorem IsRegularLocalRing.uniqueFactorizationMonoid [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] :
    ∀ (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [IsDomain R],
    UniqueFactorizationMonoid R :=
  @Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.uniqueFactorizationMonoid _

/-- A height-one prime ideal of a regular local ring is principal: it is generated by a prime
element.  (A regular local ring is a unique factorization domain.) -/
@[blueprint "lem:regular-local-ring-height-one-principal"
  (statement := /-- In a regular local ring every prime ideal of height one is principal. -/)
  (proof := /-- By \cref{lem:regular-local-ring-ufd}, the ring is a unique factorization domain.
    Let $P$ be a prime of height one and $0\neq f\in P$; some prime factor $\pi$ of $f$ lies in
    $P$, and $0\subsetneq(\pi)\subseteq P$ with $\operatorname{ht}P=1$ forces $P=(\pi)$. -/)
  (proofUses := ["lem:regular-local-ring-ufd"])
  (latexEnv := "lemma")]
theorem IsRegularLocalRing.isPrincipal_of_height_eq_one [Hironaka.Cited.IsRegularLocalRingUniqueFactorizationMonoid.{u}] {R : Type u} [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] (P : Ideal R) [P.IsPrime] (hP : P.height = 1) :
    P.IsPrincipal := by
  have := IsRegularLocalRing.uniqueFactorizationMonoid R
  exact UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hP

end Hironaka

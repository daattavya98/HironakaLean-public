/-!
# An ideal sheaf on `Proj H` is generated by finitely many forms of one degree (step L1a of the p. 132 lemma)

Step L1a of the proof of `MonoidalTransformation.isProjectiveOver` (`Hironaka/Compat/BlowupProjective.lean`, the
unproved, uncited step "a monoidal transformation of a projective scheme is projective" of the Corollary on p. 132):
for `H` graded, `u₀, …, u_{n-1} ∈ H₁`, and an ideal sheaf `D` on `Proj H` whose ideals on the standard charts
`D₊(uᵢ) = Spec H_(uᵢ)` are finitely generated, there are a degree `e` and finitely many forms `g_a ∈ H_e` such that on
every chart `D₊(uᵢ)` the ideal of `D` is generated by the fractions `g_a / uᵢ^e`.

* `ProjChart.exists_forms_of_compatible`: the commutative algebra.  Compatible finitely generated ideals
  `Iᵢ ⊆ H_(uᵢ)` (`Iᵢ H_(uᵢuⱼ) = Iⱼ H_(uᵢuⱼ)`) are all generated by `g_a / uᵢ^e` for one family of forms `g_a ∈ H_e`.
  If `h/uᵢ^d ∈ Iᵢ`, then `uᵢ^k h / uⱼ^{d+k} ∈ Iⱼ` for `k ≫ 0` (`H_(uᵢuⱼ)` is the localization of `H_(uⱼ)` at `uᵢ/uⱼ`),
  and the forms `g = h uᵢ^{e-d}` for a common large `e` do it.
* `ProjChart.map_chartIdeal`: the ideals `chartIdeal D` of `D` on the charts (pulled back to `H_(f)` along
  `H_(f) ≅ Γ(D₊(f))`) are compatible (restriction of an ideal sheaf).
* `ProjChart.exists_forms_generating`: the result on `Proj H` for any graded ring with Noetherian chart rings.
* `quotientGrading.exists_forms_generating`: the case `H = B[T₀, …, T_{n-1}] ⧸ 𝔞` of p. 132, `uᵢ` the images of the
  variables, for any homogeneous ideal `𝔞` (not necessarily prime).

Nothing here is printed: it is part of the proof of a gap filled.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization

namespace Hironaka

universe u

namespace ProjChart

section Algebra

variable {σ : Type*} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The fraction `x / f ^ e` in `A_(f)`, for `f` of degree one and `x` of degree `e`. -/
noncomputable def frac {f : A} (hf : f ∈ 𝒜 1) (e : ℕ) (x : A) (hx : x ∈ 𝒜 e) : Away 𝒜 f :=
  Away.mk 𝒜 hf e x (by rwa [smul_eq_mul, mul_one])

/-- `frac` is `Away.mk` (with the degree written `e • 1`). -/
theorem frac_eq_mk {f : A} (hf : f ∈ 𝒜 1) (e : ℕ) (x : A) (hx : x ∈ 𝒜 e) (hx' : x ∈ 𝒜 (e • 1)) :
    frac 𝒜 hf e x hx = Away.mk 𝒜 hf e x hx' := rfl

/-- `Away.mk` depends only on the exponent and the numerator. -/
theorem away_mk_congr {f : A} {d : ℕ} (hf : f ∈ 𝒜 d) {n₁ n₂ : ℕ} {x₁ x₂ : A} (hn : n₁ = n₂)
    (hx : x₁ = x₂) (h₁ : x₁ ∈ 𝒜 (n₁ • d)) (h₂ : x₂ ∈ 𝒜 (n₂ • d)) :
    Away.mk 𝒜 hf n₁ x₁ h₁ = Away.mk 𝒜 hf n₂ x₂ h₂ := by
  subst hn hx
  rfl

/-- `x f^k / f^{n+k} = x / f^n`. -/
theorem away_mk_mul_pow {f : A} {d : ℕ} (hf : f ∈ 𝒜 d) (n k : ℕ) {x : A} (hx : x ∈ 𝒜 (n • d))
    (hx' : x * f ^ k ∈ 𝒜 ((n + k) • d)) :
    Away.mk 𝒜 hf (n + k) (x * f ^ k) hx' = Away.mk 𝒜 hf n x hx := by
  ext
  simp only [Away.val_mk]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, pow_add]; ring⟩

/-- `x v^k ∈ 𝒜 ((n + k) • 1)` for `x ∈ 𝒜 (n • 1)` and `v ∈ 𝒜 1`. -/
theorem mul_pow_mem {v x : A} (hv : v ∈ 𝒜 1) {n : ℕ} (hx : x ∈ 𝒜 (n • 1)) (k : ℕ) :
    x * v ^ k ∈ 𝒜 ((n + k) • 1) := by
  rw [add_smul]
  exact SetLike.mul_mem_graded hx (SetLike.pow_mem_graded k hv)

variable {ι : Type*} {u : ι → A} (hu : ∀ i, u i ∈ 𝒜 1)

/-- The compatibility of a family of ideals `Iᵢ ⊆ A_(uᵢ)` on the overlaps `D₊(uᵢ uⱼ)`:
`Iᵢ A_(uᵢuⱼ) = Iⱼ A_(uᵢuⱼ)`. -/
def IsCompatible (I : ∀ i, Ideal (Away 𝒜 (u i))) : Prop :=
  ∀ i j, (I i).map (awayMap 𝒜 (hu j) (rfl : u i * u j = u i * u j)) =
    (I j).map (awayMap 𝒜 (hu i) (mul_comm (u i) (u j)))

/-- The extension of sections from `D₊(uᵢ)` to `D₊(uⱼ)`: if `h / uᵢ^n ∈ Iᵢ`, then `h uᵢ^k / uⱼ^{n+k} ∈ Iⱼ` for all
large `k`. -/
theorem exists_mem_of_mem {I : ∀ i, Ideal (Away 𝒜 (u i))} (hI : IsCompatible 𝒜 hu I) {i : ι} {n : ℕ} {h : A}
    (hh : h ∈ 𝒜 (n • 1)) (hx : Away.mk 𝒜 (hu i) n h hh ∈ I i) (j : ι) :
    ∃ K, ∀ k, K ≤ k → Away.mk 𝒜 (hu j) (n + k) (h * u i ^ k) (mul_pow_mem 𝒜 (hu i) hh k) ∈ I j := by
  let φj := awayMap 𝒜 (hu i) (mul_comm (u i) (u j))
  let φi := awayMap 𝒜 (hu j) (rfl : u i * u j = u i * u j)
  let := φj.toAlgebra
  have hloc := Away.isLocalization_mul (hu j) (hu i) (mul_comm (u i) (u j)) one_ne_zero
  set t := Away.isLocalizationElem (hu j) (hu i)
  -- the image of `w = h / uⱼ^n` in `A_(uᵢuⱼ)` is `φᵢ(h / uᵢ^n) · φⱼ(t)^n`
  have hw : algebraMap (Away 𝒜 (u j)) (Away 𝒜 (u i * u j)) (Away.mk 𝒜 (hu j) n h hh) =
      φi (Away.mk 𝒜 (hu i) n h hh) * algebraMap _ _ t ^ n := by
    rw [RingHom.algebraMap_toAlgebra]
    ext
    simp only [φi, φj, t, awayMap_mk, val_mul, val_pow, Away.val_mk, Localization.mk_pow,
      Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul,
      SubmonoidClass.coe_pow]; ring⟩
  have key : algebraMap (Away 𝒜 (u j)) (Away 𝒜 (u i * u j)) (Away.mk 𝒜 (hu j) n h hh) ∈
      (I j).map (algebraMap _ _) := by
    rw [hw]
    refine Ideal.mul_mem_right _ _ ?_
    have : φi (Away.mk 𝒜 (hu i) n h hh) ∈ (I i).map φi := Ideal.mem_map_of_mem _ hx
    rwa [hI i j] at this
  obtain ⟨m, ⟨K, rfl⟩, hm⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff (M := Submonoid.powers t)
      (S := Away 𝒜 (u i * u j)) (I j) _).mp key
  refine ⟨K, fun k hk => ?_⟩
  obtain ⟨l, rfl⟩ := Nat.exists_eq_add_of_le hk
  have e : Away.mk 𝒜 (hu j) (n + (K + l)) (h * u i ^ (K + l)) (mul_pow_mem 𝒜 (hu i) hh _) =
      t ^ l * (t ^ K * Away.mk 𝒜 (hu j) n h hh) := by
    ext
    simp only [t, val_mul, val_pow, Away.val_mk, Localization.mk_pow, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul,
      SubmonoidClass.coe_pow, pow_one, pow_add]; ring⟩
  rw [e]
  exact Ideal.mul_mem_left _ _ hm

/-- **Common forms for compatible ideals.**  Finitely generated compatible ideals `Iᵢ ⊆ A_(uᵢ)` (`uᵢ ∈ A₁`, finitely
many) are all generated by the fractions `g_a / uᵢ^e` of one finite family of forms `g_a ∈ A_e`. -/
theorem exists_forms_of_compatible [Finite ι] {I : ∀ i, Ideal (Away 𝒜 (u i))} (hI : IsCompatible 𝒜 hu I)
    (hfg : ∀ i, (I i).FG) :
    ∃ (e N : ℕ) (g : Fin N → A) (hg : ∀ a, g a ∈ 𝒜 e),
      ∀ i, I i = Ideal.span (Set.range fun a => frac 𝒜 (hu i) e (g a) (hg a)) := by
  classical
  have := Fintype.ofFinite ι
  choose m gen hgen using fun i => Submodule.fg_iff_exists_fin_generating_family.mp (hfg i)
  choose nn hh hhm hmk using fun c : Σ i, Fin (m i) => Away.mk_surjective 𝒜 (hu c.1) (gen c.1 c.2)
  have hmemI : ∀ c : Σ i, Fin (m i), Away.mk 𝒜 (hu c.1) (nn c) (hh c) (hhm c) ∈ I c.1 := by
    intro c
    rw [hmk c, ← hgen c.1]
    exact Submodule.subset_span ⟨c.2, rfl⟩
  choose K hK using fun (c : Σ i, Fin (m i)) (j : ι) => exists_mem_of_mem 𝒜 hu hI (hhm c) (hmemI c) j
  let e := Finset.univ.sup fun c : Σ i, Fin (m i) => nn c + Finset.univ.sup fun j => K c j
  have hle' : ∀ c, nn c + Finset.univ.sup (fun j => K c j) ≤ e := fun c =>
    Finset.le_sup (f := fun c : Σ i, Fin (m i) => nn c + Finset.univ.sup fun j => K c j)
      (Finset.mem_univ c)
  have hle : ∀ c j, nn c + K c j ≤ e := fun c j =>
    (Nat.add_le_add_left (Finset.le_sup (f := fun j => K c j) (Finset.mem_univ j)) _).trans (hle' c)
  have hne : ∀ c, nn c + (e - nn c) = e := fun c => by
    have := hle' c; omega
  let g' : (Σ i, Fin (m i)) → A := fun c => hh c * u c.1 ^ (e - nn c)
  have hg' : ∀ c, g' c ∈ 𝒜 e := fun c => by
    have := mul_pow_mem 𝒜 (hu c.1) (hhm c) (e - nn c)
    rwa [hne c, smul_eq_mul, mul_one] at this
  have hall : ∀ c j, frac 𝒜 (hu j) e (g' c) (hg' c) ∈ I j := fun c j => by
    have := hK c j (e - nn c) (by have := hle c j; omega)
    rwa [away_mk_congr 𝒜 (hu j) (hne c) rfl _ (by rw [smul_eq_mul, mul_one]; exact hg' c)] at this
  have hself : ∀ c, frac 𝒜 (hu c.1) e (g' c) (hg' c) = gen c.1 c.2 := fun c => by
    rw [← hmk c, frac, ← away_mk_mul_pow 𝒜 (hu c.1) (nn c) (e - nn c) (hhm c)
      (mul_pow_mem 𝒜 (hu c.1) (hhm c) _)]
    exact away_mk_congr 𝒜 (hu c.1) (hne c).symm rfl _ _
  let eqv := Fintype.equivFin (Σ i, Fin (m i))
  refine ⟨e, Fintype.card (Σ i, Fin (m i)), fun a => g' (eqv.symm a), fun a => hg' _, fun i => ?_⟩
  refine le_antisymm ?_ ?_
  · rw [← hgen i]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨a, rfl⟩
    refine Submodule.subset_span ⟨eqv ⟨i, a⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hself ⟨i, a⟩
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨a, rfl⟩
    exact hall _ i

end Algebra


section Sheaf

variable {σ : Type*} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The standard chart `D₊(f)` of `Proj A` as an affine open, for `f` homogeneous of positive degree. -/
def basicAffineOpen {f : A} {m : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m) : (Proj 𝒜).affineOpens :=
  ⟨Proj.basicOpen 𝒜 f, Proj.isAffineOpen_basicOpen 𝒜 f hf hm⟩

/-- `A_(f) → Γ(Proj A, D₊(f))` is bijective (`Proj.basicOpenIsoAway`). -/
theorem bijective_awayToSection {f : A} {m : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m) :
    Function.Bijective (Proj.awayToSection 𝒜 f).hom := by
  rw [← Proj.basicOpenIsoAway_hom 𝒜 f hf hm]
  exact ConcreteCategory.bijective_of_isIso _

variable {𝒜} (D : (Proj 𝒜).IdealSheafData)

/-- The ideal of the ideal sheaf `D` on the chart `D₊(f) = Spec A_(f)`, as an ideal of `A_(f)` (pulled back along
`A_(f) ≅ Γ(Proj A, D₊(f))`). -/
noncomputable def chartIdeal {f : A} {m : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m) : Ideal (Away 𝒜 f) :=
  (D.ideal (basicAffineOpen 𝒜 hf hm)).comap (Proj.awayToSection 𝒜 f).hom

/-- Pushing `chartIdeal D` forward along `A_(f) ≅ Γ(Proj A, D₊(f))` gives back the ideal of `D` on `D₊(f)`. -/
theorem map_awayToSection_chartIdeal {f : A} {m : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m) :
    (chartIdeal D hf hm).map (Proj.awayToSection 𝒜 f).hom = D.ideal (basicAffineOpen 𝒜 hf hm) :=
  Ideal.map_comap_of_surjective _ (bijective_awayToSection 𝒜 hf hm).2 _

/-- Restriction of `D` from `D₊(f)` to `D₊(fg)`: `chartIdeal D (f) · A_(fg) = chartIdeal D (fg)`. -/
theorem map_chartIdeal {f g x : A} {m m' k : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m) (hg : g ∈ 𝒜 m')
    (hx : x = f * g) (hxk : x ∈ 𝒜 k) (hk : 0 < k) :
    (chartIdeal D hf hm).map (awayMap 𝒜 hg hx) = chartIdeal D hxk hk := by
  have sq := congrArg CommRingCat.Hom.hom (Proj.awayMap_awayToSection 𝒜 hg hx)
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at sq
  rw [← Ideal.comap_map_of_bijective _ (bijective_awayToSection 𝒜 hxk hk)
    (I := (chartIdeal D hf hm).map (awayMap 𝒜 hg hx)), Ideal.map_map, sq, ← Ideal.map_map,
    map_awayToSection_chartIdeal]
  exact congrArg (Ideal.comap (Proj.awayToSection 𝒜 x).hom)
    (D.map_ideal' (U := basicAffineOpen 𝒜 hxk hk) (V := basicAffineOpen 𝒜 hf hm) _)

/-- The chart ideals of `D` on the charts `D₊(uᵢ)` (`uᵢ ∈ A₁`) are compatible. -/
theorem isCompatible_chartIdeal {ι : Type*} {u : ι → A} (hu : ∀ i, u i ∈ 𝒜 1) :
    IsCompatible 𝒜 hu fun i => chartIdeal D (hu i) one_pos := fun i j => by
  rw [map_chartIdeal D (hu i) one_pos (hu j) rfl (SetLike.mul_mem_graded (hu i) (hu j)) two_pos,
    map_chartIdeal D (hu j) one_pos (hu i) (mul_comm (u i) (u j))
      (SetLike.mul_mem_graded (hu i) (hu j)) two_pos]

/-- **L1a on `Proj A`.**  Let `u : ι → A₁` be a finite family of elements of degree one whose chart rings `A_(uᵢ)` are
Noetherian, and `D` an ideal sheaf on `Proj A`.  There are a degree `e` and finitely many forms `g_a ∈ A_e` such that
on every chart `D₊(uᵢ)` the ideal of `D` is generated by the fractions `g_a / uᵢ^e`, both as an ideal of `A_(uᵢ)`
(`chartIdeal`) and as an ideal of `Γ(Proj A, D₊(uᵢ))`. -/
theorem exists_forms_generating {ι : Type*} [Finite ι] {u : ι → A} (hu : ∀ i, u i ∈ 𝒜 1)
    (hN : ∀ i, IsNoetherianRing (Away 𝒜 (u i))) :
    ∃ (e N : ℕ) (g : Fin N → A) (hg : ∀ a, g a ∈ 𝒜 e), ∀ i,
      chartIdeal D (hu i) one_pos = Ideal.span (Set.range fun a => frac 𝒜 (hu i) e (g a) (hg a)) ∧
      D.ideal (basicAffineOpen 𝒜 (hu i) one_pos) =
        Ideal.span (Set.range fun a => (Proj.awayToSection 𝒜 (u i)).hom (frac 𝒜 (hu i) e (g a) (hg a))) := by
  obtain ⟨e, N, g, hg, h⟩ := exists_forms_of_compatible 𝒜 hu (isCompatible_chartIdeal D hu)
    fun i => (hN i).noetherian _
  refine ⟨e, N, g, hg, fun i => ⟨h i, ?_⟩⟩
  rw [← map_awayToSection_chartIdeal, h i, Ideal.map_span, ← Set.range_comp]
  rfl

end Sheaf

end ProjChart

section Quotient

attribute [local instance] MvPolynomial.gradedAlgebra

open MvPolynomial

variable {B : Type u} [Field B] {n : ℕ} (𝔞 : HomogeneousIdeal (homogeneousSubmodule (Fin n) B))

namespace quotientGrading

/-- The homogeneous coordinate `Tᵢ` of `H = B[T₀, …, T_{n-1}] ⧸ 𝔞`. -/
noncomputable def var (i : Fin n) : MvPolynomial (Fin n) B ⧸ 𝔞.toIdeal := Ideal.Quotient.mk _ (X i)

/-- The coordinates `Tᵢ` have degree one. -/
theorem var_mem (i : Fin n) : var 𝔞 i ∈ quotientGrading 𝔞 1 :=
  mk_mem_quotientGrading _ (isHomogeneous_X B i)

/-- The coordinates generate `H` over `H₀`. -/
theorem adjoin_range_var :
    Algebra.adjoin (quotientGrading 𝔞 0) (Set.range (var 𝔞)) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction p using MvPolynomial.induction_on with
  | C b =>
    have : Ideal.Quotient.mk 𝔞.toIdeal (C b) =
        algebraMap (quotientGrading 𝔞 0) _ (algebraMap B (quotientGrading 𝔞 0) b) :=
      (IsScalarTower.algebraMap_apply B (quotientGrading 𝔞 0)
        (MvPolynomial (Fin n) B ⧸ 𝔞.toIdeal) b).symm ▸ rfl
    rw [this]
    exact Subalgebra.algebraMap_mem _ _
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p i hp => rw [map_mul]; exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- The standard charts `D₊(Tᵢ)` cover `Proj H`. -/
theorem iSup_basicOpen_var :
    ⨆ i, Proj.basicOpen (quotientGrading 𝔞) (var 𝔞 i) = ⊤ :=
  Proj.iSup_basicOpen_eq_top' _ _ (fun i => ⟨1, var_mem 𝔞 i⟩) (adjoin_range_var 𝔞)

/-- The chart rings `H_(f)` of `Proj H` are Noetherian (finitely generated over the field `H₀`). -/
theorem isNoetherianRing_away {f : MvPolynomial (Fin n) B ⧸ 𝔞.toIdeal} {d : ℕ} (hf : f ∈ quotientGrading 𝔞 d) :
    IsNoetherianRing (Away (quotientGrading 𝔞) f) := by
  have : IsNoetherianRing (quotientGrading 𝔞 0) :=
    isNoetherianRing_of_surjective B _ (algebraMap B (quotientGrading 𝔞 0))
      (algebraMap_quotientGrading_zero_surjective 𝔞)
  have := Away.finiteType f d hf
  exact Algebra.FiniteType.isNoetherianRing (quotientGrading 𝔞 0) _

/-- **L1a** (step of `MonoidalTransformation.isProjectiveOver`, p. 132).  Let `H = B[T₀, …, T_{n-1}] ⧸ 𝔞` with its
natural grading (`𝔞` any homogeneous ideal) and `D` a subscheme (ideal sheaf) of `Proj H`.  There are a degree `e` and
finitely many forms `g_a ∈ H_e` such that on every standard chart `D₊(Tᵢ) = Spec H_(Tᵢ)` the ideal of `D` is generated
by the fractions `g_a / Tᵢ^e`, both as an ideal of `H_(Tᵢ)` and as an ideal of `Γ(Proj H, D₊(Tᵢ))`. -/
@[blueprint "lem:0-blowup-projective-forms"
  (statement := /-- Let $H=B[T_0,\dots,T_{n-1}]/\mathfrak a$ with its natural grading ($\mathfrak a$ any homogeneous
    ideal) and $D$ a subscheme of $\operatorname{Proj}H$. There are $e\ge 0$ and finitely many forms
    $g_1,\dots,g_N\in H_e$ such that on every standard chart $D_+(T_i)=\operatorname{Spec}H_{(T_i)}$ the ideal of $D$ is
    generated by $g_1/T_i^e,\dots,g_N/T_i^e$. (Step of \cref{lem:0-blowup-projective}; not printed.) -/)
  (proof := /-- The chart ideals $I_i\subseteq H_{(T_i)}$ are finitely generated ($H_{(T_i)}$ is of finite type over
    the field $H_0$) and compatible: $I_iH_{(T_iT_j)}=I_jH_{(T_iT_j)}$, and $H_{(T_iT_j)}$ is the localization of
    $H_{(T_j)}$ at $T_i/T_j$. So if $h/T_i^d\in I_i$ then $hT_i^k/T_j^{d+k}\in I_j$ for all $j$ and all $k\gg0$. For
    generators $h_{i,c}/T_i^{d_{i,c}}$ of the $I_i$ and a common large $e$, the forms
    $g_{i,c}=h_{i,c}T_i^{e-d_{i,c}}$ lie in $H_e$, satisfy $g_{i,c}/T_j^e\in I_j$ for all $j$, and
    $g_{i,c}/T_i^e=h_{i,c}/T_i^{d_{i,c}}$; so they generate every $I_j$. -/)
  (latexEnv := "lemma")]
theorem exists_forms_generating (D : (Proj (quotientGrading 𝔞)).IdealSheafData) :
    ∃ (e N : ℕ) (g : Fin N → MvPolynomial (Fin n) B ⧸ 𝔞.toIdeal) (hg : ∀ a, g a ∈ quotientGrading 𝔞 e),
      ∀ i, ProjChart.chartIdeal D (var_mem 𝔞 i) one_pos =
          Ideal.span (Set.range fun a => ProjChart.frac _ (var_mem 𝔞 i) e (g a) (hg a)) ∧
        D.ideal (ProjChart.basicAffineOpen _ (var_mem 𝔞 i) one_pos) =
          Ideal.span (Set.range fun a =>
            (Proj.awayToSection _ (var 𝔞 i)).hom (ProjChart.frac _ (var_mem 𝔞 i) e (g a) (hg a))) :=
  ProjChart.exists_forms_generating D (var_mem 𝔞) fun i => isNoetherianRing_away 𝔞 (var_mem 𝔞 i)

end quotientGrading

end Quotient

end Hironaka

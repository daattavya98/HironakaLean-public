/-!
# Compatibility layer: `τ`-parameters lying over a prime (Ch. III §8, pp. 258–259)

> "In fact, let us choose a minimal base `(x, z₁, …, z_t)` of `Q`, …
> By Lemma 14, § 5, … Therefore, the
> initial forms of the `h_j` in `gr_M(R)` must belong to the `(R/M)`-subalgebra of `gr_M(R)`
> generated by the initial forms of the `z_i` `(1 ≤ i ≤ t)`. It is then easily seen that, by
> applying a suitable `k`-linear transformation to the system `(z₁, …, z_t)`, we can assume `(z₁,
> …, z_r)` `(r ≤ t)` to be a regular system of `τ`-parameters of `R` for `J`. … we can choose the above `(z₁, …,
> z_r)` in such a way that the transform `(S₁; z₁/x, …, z_r/x)` is a regular `τ`-frame of `R₁` for
> `J₁`. (See the proof of Lemma 16, § 5.) … `z_j/x ∈ P₁` for all `j` `(1 ≤ j ≤ r)`. (See Lemma 11,
> § 4.)" (Proof of Proposition 2, pp. 258–259)

The main declaration is `exists_tauParameters_mem_prime`; its proof is organised as the steps
(a)–(d) of the printed text, each an exported lemma:

* (a) `TransformCoord.tauSubmodule_le_span_classX` (Lemma 14: the `τ`-submodules lie in the span of
  the classes of `z₁, …, z_t`);
* (b) `TransformCoord.exists_kLinear_quotientPair` (the `k`-linear transformation);
* (c) `TransformCoord.exists_sub_eq_of_ρ_eq`, `TransformCoord.exists_adjust_quotient` and
  `TransformCoord.rho_tauSubmodule` (the proof of Lemma 16);
* (d) `tauSubmodule_top_le_span_of_le_span` (Lemma 11) and
  `TransformCoord.exists_adjust_quotientPair_mem_prime` (`z/x ∈ P₁`).
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u



section GradedAux

/-- The class in `gr¹_I(A)` of a linear combination `Σ cᵢ qᵢ` of elements `qᵢ ∈ I` is the
corresponding linear combination of the classes of the `qᵢ` over `A/I`. -/
theorem AssocGraded.mk_one_sum_mul {A : Type*} [CommRing A] (I : Ideal A) {ι : Type*}
    (s : Finset ι) (c q : ι → A) (hq : ∀ i, q i ∈ I ^ 1)
    (h : ∑ i ∈ s, c i * q i ∈ I ^ 1) :
    AssocGraded.mk I 1 (∑ i ∈ s, c i * q i) h =
      ∑ i ∈ s, (Ideal.Quotient.mk I (c i)) • AssocGraded.mk I 1 (q i) (hq i) := by
  classical
  have h2 : ∀ i, c i * q i ∈ I ^ 1 := fun i => Ideal.mul_mem_left _ _ (hq i)
  rw [AssocGraded.mk_sum I 1 s (fun i => c i * q i) h2]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [AssocGraded.smul_mk]

end GradedAux

section PrimeCoordinates

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] {T : MonoidalTransform R Q} [IsLocalHom T.toRing]
  [IsRegularLocalRing T.ring] (C : TransformCoord T)
  {P : Ideal R} {P₁ : Ideal T.ring} [P₁.IsPrime]

omit [Q.IsPrime] [IsLocalHom T.toRing] [IsRegularLocalRing T.ring] [P₁.IsPrime] in
/-- The denominator `x₁ = x₀` of the coordinates is not in a prime `P₁` of `R₁` lying over a prime
`P ⊊ Q` (otherwise `QR₁ = (x₁) ⊆ P₁` and `Q ⊆ P₁ ∩ R = P`). -/
theorem TransformCoord.x₁_notMem_of_comap_eq (hPQ : P ≤ Q) (hQP : Q ≠ P)
    (hP₁ : P₁.comap T.toRing = P) : C.x₁ ∉ P₁ := by
  intro hx
  apply hQP
  refine le_antisymm (fun q hq => ?_) hPQ
  have h1 : T.toRing q ∈ Q.map T.toRing := Ideal.mem_map_of_mem _ hq
  rw [← C.span_x₁, Ideal.mem_span_singleton'] at h1
  obtain ⟨b, hb⟩ := h1
  rw [← hP₁, Ideal.mem_comap, ← hb]
  exact Ideal.mul_mem_left _ _ hx

omit [Q.IsPrime] [IsLocalHom T.toRing] [IsRegularLocalRing T.ring] in
/-- For `q ∈ P` (`P ⊆ Q`) the quotient `q/x₁` exists in `R₁` and lies in `P₁`
(`x₁ ∉ P₁` and `x₁ · (q/x₁) = q ∈ P₁`). -/
theorem TransformCoord.exists_quotient_mem (hPQ : P ≤ Q) (hQP : Q ≠ P)
    (hP₁ : P₁.comap T.toRing = P) {q : R} (hq : q ∈ P) :
    ∃ u ∈ P₁, C.x₁ * u = T.toRing q := by
  have h1 : T.toRing q ∈ Q.map T.toRing := Ideal.mem_map_of_mem _ (hPQ hq)
  rw [← C.span_x₁, Ideal.mem_span_singleton'] at h1
  obtain ⟨b, hb⟩ := h1
  refine ⟨b, ?_, by rw [mul_comm]; exact hb⟩
  have hqP₁ : T.toRing q ∈ P₁ := by rw [← Ideal.mem_comap, hP₁]; exact hq
  rw [← hb] at hqP₁
  exact ((inferInstance : P₁.IsPrime).mem_or_mem hqP₁).resolve_right
    (C.x₁_notMem_of_comap_eq hPQ hQP hP₁)

end PrimeCoordinates

section PrimeCoordinates2

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] {T : MonoidalTransform R Q} [IsLocalHom T.toRing]
  [IsRegularLocalRing T.ring] (C : TransformCoord T)
  {P : Ideal R} {P₁ : Ideal T.ring} [P₁.IsPrime]

omit [Q.IsPrime] in
/-- The classes of the quotients `u_q = q/x₁` (`q` running through a minimal base of `P`, part of a
regular system of parameters) together with `x₁` are linearly independent in `M₁/M₁²`
(`ρ` maps the `u_q` to the independent classes of the `q` and kills `x₁`; proof of Proposition 1,
p. 237). -/
theorem TransformCoord.linearIndependent_quotients
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {S₀ TQ : Finset R} (hS₀ : IsRegularSystemOfParameters R S₀) (hTS : TQ ⊆ S₀)
    (u : TQ → T.ring) (hu1 : ∀ q, u q ∈ maximalIdeal T.ring ^ 1)
    (huord : ∀ q, Ideal.ordElem (maximalIdeal T.ring) (u q) = 1)
    (hρu : ∀ q, C.ρ hrat (initialForm (maximalIdeal T.ring) (u q)) =
      initialForm (maximalIdeal R) (q : R))
    (hqM : ∀ q : TQ, Ideal.ordElem (maximalIdeal R) (q : R) = 1) :
    LinearIndependent (R ⧸ maximalIdeal R) (fun q : TQ => initialForm (maximalIdeal R) (q : R)) ∧
    LinearIndependent (T.ring ⧸ maximalIdeal T.ring) (fun o : Option TQ =>
      Option.casesOn' o (initialForm (maximalIdeal T.ring) C.x₁)
        (fun q => AssocGraded.mk (maximalIdeal T.ring) 1 (u q) (hu1 q))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  have hliQ : LinearIndependent (R ⧸ maximalIdeal R) fun q : TQ =>
      initialForm (maximalIdeal R) (q : R) := by
    have h1 := (linearIndependent_mk_of_isRegularSystemOfParameters hS₀).comp
      (fun q : TQ => (⟨q, hTS q.2⟩ : S₀)) (fun a b hab => by
        apply Subtype.ext
        have := congrArg Subtype.val hab
        exact this)
    convert h1 using 1
    funext q
    exact initialForm_eq_mk _ (hqM q)
  let W : TQ → AssocGraded (maximalIdeal T.ring) := fun q =>
    AssocGraded.mk (maximalIdeal T.ring) 1 (u q) (hu1 q)
  have hWin : ∀ q, W q = initialForm (maximalIdeal T.ring) (u q) := fun q =>
    (initialForm_eq_mk _ (huord q)).symm
  have hliW : LinearIndependent (R ⧸ maximalIdeal R) fun q => C.ρ hrat (W q) := by
    convert hliQ using 1
    funext q
    rw [hWin, hρu]
  refine ⟨hliQ, ?_⟩
  have hWli := C.linearIndependent_of_ρ hrat W hliW
  have hnot : initialForm (maximalIdeal T.ring) C.x₁ ∉
      Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) := by
    intro hmem
    obtain ⟨c, hc⟩ := Submodule.mem_span_range_iff_exists_fun _ |>.mp hmem
    have h1 := congrArg (C.ρ hrat) hc
    rw [C.ρ_initialForm_x₁, map_sum] at h1
    simp only [TransformCoord.ρ_smul] at h1
    have h2 := Fintype.linearIndependent_iff.mp hliW _ h1
    have h3 : ∀ q, c q = 0 := fun q => by simpa using h2 q
    rw [Finset.sum_eq_zero fun q _ => by rw [h3 q, zero_smul]] at hc
    have h4 := C.initialForm_x₁
    rw [← hc] at h4
    have h5 : C.e₁ (MvPolynomial.X none) ≠ 0 := by
      rw [← map_zero C.e₁]
      exact fun h => MvPolynomial.X_ne_zero _ (C.e₁_bijective.1 h)
    exact h5 h4.2.symm
  have := hWli.option hnot
  convert this using 1

end PrimeCoordinates2

section PrimeCoordinates3

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] [IsRegularLocalRing (R ⧸ Q)] {T : MonoidalTransform R Q}
  [IsLocalHom T.toRing] [IsRegularLocalRing T.ring] (C : TransformCoord T)
  {P : Ideal R} {P₁ : Ideal T.ring} [P₁.IsPrime]

omit [IsLocalHom T.toRing] [P₁.IsPrime] in
/-- The ideal `U = (q/x₁)_q R₁` generated by the quotients of a minimal base of `P` is prime, does
not contain `x₁`, and contains every prime `P₁` of `R₁` lying over `P` (proof of Proposition 1,
p. 237: `Q₁ ⊆ (x₁/x, …, x_r/x)R₁`; here `P₁ ⊆ U`, as `P₁` is contained in the strict transform of
`P`). -/
theorem TransformCoord.prime_span_quotients_and_le [IsRegularLocalRing (R ⧸ P)] [P.IsPrime]
    {TQ : Finset R} (hTQ : Ideal.span (TQ : Set R) = P)
    (hP₁ : P₁.comap T.toRing = P) (u : TQ → T.ring)
    (hxu : ∀ q, C.x₁ * u q = T.toRing q) (hu1 : ∀ q, u q ∈ maximalIdeal T.ring ^ 1)
    (hli : LinearIndependent (T.ring ⧸ maximalIdeal T.ring) (fun o : Option TQ =>
      Option.casesOn' o (initialForm (maximalIdeal T.ring) C.x₁)
        (fun q => AssocGraded.mk (maximalIdeal T.ring) 1 (u q) (hu1 q)))) :
    (Ideal.span (Set.range u)).IsPrime ∧ C.x₁ ∉ Ideal.span (Set.range u) ∧
      P₁ ≤ Ideal.span (Set.range u) := by
  classical
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  have hx₁M : C.x₁ ∈ maximalIdeal T.ring := by
    have := C.z₁_mem none
    rwa [pow_one] at this
  let z : Option TQ → maximalIdeal T.ring := fun o =>
    Option.casesOn' o ⟨C.x₁, hx₁M⟩ fun q => ⟨u q, by simpa [pow_one] using hu1 q⟩
  have hzli : LinearIndependent (T.ring ⧸ maximalIdeal T.ring) fun o =>
      AssocGraded.mk (maximalIdeal T.ring) 1 (z o) (by rw [pow_one]; exact (z o).2) := by
    convert hli using 1
    funext o
    rcases o with _ | q
    · exact (initialForm_eq_mk _ C.initialForm_x₁.1).symm
    · rfl
  have hzext := extendsToRSOP_of_linearIndependent z hzli
  set U := Ideal.span (Set.range u) with hU
  have hK'sub : (Finset.univ.image u) ⊆ Finset.univ.image fun o => (z o : T.ring) := by
    intro y hy
    obtain ⟨q, -, rfl⟩ := Finset.mem_image.mp hy
    exact Finset.mem_image.mpr ⟨some q, Finset.mem_univ _, rfl⟩
  have hUprime : U.IsPrime := by
    have := (ExtendsToRSOP.mono hzext hK'sub).isPrime_span
    rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ] at this
  have hx₁U : C.x₁ ∉ U := by
    obtain ⟨Z, hKZ, hZ⟩ := hzext
    have hx₁Z : C.x₁ ∈ Z := hKZ (Finset.mem_image.mpr ⟨none, Finset.mem_univ _, rfl⟩)
    have hnot : C.x₁ ∉ Finset.univ.image u := by
      intro hmem
      obtain ⟨q, -, hq⟩ := Finset.mem_image.mp hmem
      have := hzli.injective (a₁ := none) (a₂ := some q) (AssocGraded.mk_congr _ _ hq.symm)
      cases this
    have := rsop_notMem_span hZ (hK'sub.trans hKZ) hx₁Z hnot
    rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ] at this
  have hx₁pow : ∀ n, C.x₁ ^ n ∉ U := by
    intro n
    induction n with
    | zero => rw [pow_zero]; exact fun h => hUprime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    | succ n ih =>
      rw [pow_succ]
      intro hmem
      rcases hUprime.mem_or_mem hmem with h1 | h1
      · exact ih h1
      · exact hx₁U h1
  have hx₁0 : C.x₁ ≠ 0 := fun h0 => hx₁U (h0 ▸ zero_mem _)
  refine ⟨hUprime, hx₁U, ?_⟩
  -- `P₁ ⊆ U`: `P₁` lies in the strict transform of `P`
  have hQ₁s : P₁ ≤ strictTransformIdeal T P :=
    le_strictTransformIdeal_of_comap_le T P₁ (le_of_eq hP₁)
  refine hQ₁s.trans (Ideal.span_le.mpr ?_)
  rintro y ⟨x, hx, f', hf', ν, -, hxy⟩
  rw [← C.span_x₁] at hx
  obtain ⟨v, hv⟩ := Ideal.span_singleton_eq_span_singleton.mp hx
  have hf'U : T.toRing f' ∈ Ideal.span {C.x₁} * U := by
    have h1 := Ideal.mem_map_of_mem T.toRing (show f' ∈ Ideal.span (TQ : Set R) from hTQ ▸ hf')
    rw [Ideal.map_span] at h1
    refine (Ideal.span_le.mpr ?_) h1
    rintro _ ⟨q, hq, rfl⟩
    rw [← hxu ⟨q, hq⟩]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) (Ideal.subset_span ⟨⟨q, hq⟩, rfl⟩)
  obtain ⟨w, hw, hxw⟩ := Ideal.mem_span_singleton_mul.mp hf'U
  -- `x = x₁ v⁻¹`
  have hxx : x = C.x₁ * ↑v⁻¹ := by rw [← hv, mul_assoc, Units.mul_inv, mul_one]
  set y' := (↑v⁻¹ : T.ring) ^ ν * y with hy'
  have hy'eq : C.x₁ ^ ν * y' = C.x₁ * w := by
    rw [hxw, ← hxy, hxx, hy', mul_pow]
    ring
  have hy'U : y' ∈ U := by
    rcases ν with _ | n
    · rw [pow_zero, one_mul] at hy'eq
      rw [hy'eq]
      exact Ideal.mul_mem_left _ _ hw
    · have h1 : C.x₁ * (C.x₁ ^ n * y' - w) = 0 := by rw [mul_sub, ← mul_assoc, ← pow_succ',
        hy'eq, sub_self]
      have h2 : C.x₁ ^ n * y' = w := sub_eq_zero.mp
        ((mul_eq_zero.mp h1).resolve_left hx₁0)
      rcases hUprime.mem_or_mem (h2 ▸ hw) with h3 | h3
      · exact absurd h3 (hx₁pow n)
      · exact h3
  have : y = (↑v : T.ring) ^ ν * y' := by
    rw [hy', ← mul_assoc, ← mul_pow, Units.mul_inv, one_pow, one_mul]
  rw [this]
  exact Ideal.mul_mem_left _ _ hy'U

end PrimeCoordinates3

section XClasses

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} {T : MonoidalTransform R Q} (C : TransformCoord T)

/-- The class `[z_i] ∈ gr¹_M(R)` of the `i`-th element `z_i = x_i` of the minimal base
`(x, z₁, …, z_t)` of `Q` of the coordinates `C` (p. 258, "a minimal base `(x, z₁, …, z_t)` of
`Q`"). -/
noncomputable def TransformCoord.classX (i : Fin C.r) : AssocGraded (maximalIdeal R) :=
  AssocGraded.mk (maximalIdeal R) 1 (C.x i) (C.z_mem (some (Sum.inl i)))

theorem TransformCoord.classX_eq (i : Fin C.r) :
    C.classX i = C.e (MvPolynomial.X (some (Sum.inl i))) := by
  rw [TransformCoord.e, MvPolynomial.aeval_X]
  rfl

theorem TransformCoord.classX_mem_homogeneous (i : Fin C.r) :
    C.classX i ∈ AssocGraded.homogeneous (maximalIdeal R) 1 :=
  AssocGraded.mk_mem_homogeneous _ _

/-- The `(R/M)`-subalgebra of `gr_M(R)` generated by the initial forms of the `z_i`
(`1 ≤ i ≤ t`): "the `(R/M)`-subalgebra of `gr_M(R)` generated by the initial forms of the `z_i`"
(p. 258). -/
theorem TransformCoord.e_mem_adjoin_classX {p : MvPolynomial (CoordIndex C.r C.s)
    (R ⧸ maximalIdeal R)} (hp : ∀ β ∈ p.support, IsPure β) :
    C.e p ∈ Algebra.adjoin (R ⧸ maximalIdeal R) (Set.range C.classX) := by
  classical
  have h : C.e p = ∑ β ∈ p.support, C.e (MvPolynomial.monomial β (p.coeff β)) := by
    conv_lhs => rw [p.as_sum]
    rw [map_sum]
  rw [h]
  refine Subalgebra.sum_mem _ fun β hβ => ?_
  simp only [TransformCoord.e, MvPolynomial.aeval_monomial]
  refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) ?_
  refine Subalgebra.prod_mem _ fun v hv => ?_
  refine Subalgebra.pow_mem _ ?_ _
  have hw : xWeight v = 1 := (isPure_iff_forall_mem_support β).mp (hp β hβ) v hv
  rcases v with _ | (i | j)
  · simp [xWeight] at hw
  · exact Algebra.subset_adjoin ⟨i, rfl⟩
  · simp [xWeight] at hw

end XClasses

section TauSubmoduleInSubalgebra

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- **The `τ`-submodules lie in any submodule `W` of `gr¹_M(R)` whose subalgebra contains the
initial
forms of a standard base** (the argument of the proof of Lemma 11, p. 223: "By (i), it is clear that
the initial form of `f_j` belongs to the `K`-subalgebra `K[T]`. Hence by (ii) we have
`gr^μ_M(J, R) = gr^μ_M(R) ∩ (gr_M(J, R) ∩ K[T]) gr_M(R)` for all `μ`. Hence the `K`-modules `T_i`
are all contained in `T`"). -/
theorem tauSubmodule_le_of_initialForm_mem_adjoin (J : Ideal R) {m : ℕ} (g : Fin m → R)
    (hg : IsStandardBase R J g)
    (W : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)))
    (hW : W ≤ AssocGraded.homogeneous (maximalIdeal R) 1)
    (hgW : ∀ j, initialForm (maximalIdeal R) (g j) ∈
      Algebra.adjoin (R ⧸ maximalIdeal R) (W : Set (AssocGraded (maximalIdeal R)))) (a : ℕ) :
    tauSubmodule R J a ≤ W := by
  have hgrK : grIdeal (maximalIdeal R) J =
      Ideal.span (Set.range fun j => initialForm (maximalIdeal R) (g j)) := hg.2.2.2.1
  refine tauSubmodule_le R J a W ⟨hW, fun μ _ ψ _ => ⟨fun hψ => ?_, fun hψ => ?_⟩⟩
  · rw [hgrK] at hψ
    refine (Ideal.span_le.mpr ?_) hψ
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨hgrK ▸ Ideal.subset_span ⟨j, rfl⟩, hgW j⟩
  · exact (Ideal.span_le.mpr fun x hx => hx.1) hψ

end TauSubmoduleInSubalgebra

section InitialFormsInSubalgebra

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] [IsRegularLocalRing (R ⧸ Q)]

omit [IsRegularLocalRing (R ⧸ Q)] in
/-- **Step (a) of the choice of the `τ`-frame, p. 258**: "By Lemma 14, § 5, we have a standard
base `(h₁, …, h_m)` of `J` such that, if `ν_j = ν_M(h_j) = ν^{(j)}(J)`, then `ν_Q(h_j) = ν_j` and
`ν_{M₁}(x^{-ν_j}h_j) = ν_j` for all `j`. Therefore, the initial forms of the `h_j` in `gr_M(R)`
must belong to the `(R/M)`-subalgebra of `gr_M(R)` generated by the initial forms of the `z_i`
`(1 ≤ i ≤ t)`."  Here `(x, z₁, …, z_t) = (x₀, x₁, …, x_r)` is the minimal base of `Q` of the
coordinates `C` (`z_i/x ∈ M₁`).  Consequently (Corollary to Lemma 10, the argument of Lemma 11) all
`τ`-submodules `T_a` of `J` lie in the span `T = ⟨[z₁], …, [z_t]⟩ ⊆ gr¹_M(R)`.

Gap in the paper filled: "must belong" is proved from the output of Lemma 14 and the weight
computation of its proof (`ordElem_le_and_rho_initialForm_eq`: if `ν_{M₁}(x^{-ν}f) = ν` then the
initial form of `f` is `e(p)` for a form `p` in `X₁, …, X_t` only). -/
theorem TransformCoord.tauSubmodule_le_span_classX {T : MonoidalTransform R Q}
    [IsLocalHom T.toRing] [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (C : TransformCoord T) (J : Ideal R) (hJQ : J ≤ Q) (hQperm : IsPermissibleCenter R J Q)
    (hnu : nuStar T.ring (strictTransformIdeal T J) = nuStar R J) (a : ℕ) (ha : 1 ≤ a)
    (hat : a ≤ t R J) :
    tauSubmodule R J a ≤ Submodule.span (R ⧸ maximalIdeal R) (Set.range C.classX) := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  have hnuI : ∀ i, nuI T.ring J₁ i = nuI R J i := fun i => congrFun (toLex.injective hnu) i
  obtain ⟨-, -, hS, hNF⟩ := hQperm.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  have _ : IsRegularLocalRing (R ⧸ Q) := hS
  -- (ii)**: a standard base `(f_j)` of `J` with `ν_Q(f_j) = ν^{(j)}(J)`
  obtain ⟨m, f, h₁, h₂⟩ := ((isPermissibleCenter_tfae R J Q hJQ).out 1 3).mp hNF
  obtain ⟨i₀, hi₀⟩ := exists_isGreatest_nuI_eq_mu J a ha hat
  have hm : 0 < m := by
    by_contra hm0
    have hm0' : m = 0 := Nat.eq_zero_of_not_pos hm0
    have h1 := (nuI_eq_of_hasLemma1Properties R J _ h₁.2).2 i₀ (by have := i₀.pos; omega)
    have h2 := hi₀.1
    simp only [Set.mem_ofPred_eq] at h2
    rw [h1] at h2
    exact ENat.top_ne_natCast _ h2
  have hftop : ∀ j : Fin m, Ideal.ordElem (maximalIdeal R) (f j) ≠ ⊤ := by
    intro j htop
    apply h₁.2.2.2.2 j
    dsimp only
    rw [show initialForm (maximalIdeal R) (f j) = 0 by rw [initialForm, dite_eq_left htop]]
    exact zero_mem _
  let ν : Fin m → ℕ := fun j => (Ideal.ordElem (maximalIdeal R) (f j)).toNat
  have hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat) := fun j =>
    (ENat.natCast_toNat (hftop j)).trans (ordElem_eq_nuI_of_isStandardBase J f h₁ j)
  -- Lemma 14 with `i = m`
  let i : ℕ+ := ⟨m, hm⟩
  have him : (i : ℕ) ≤ m := le_rfl
  have hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
      toLex fun j : Fin (i : ℕ) => nuI T.ring J₁ ((j : ℕ).succPNat) :=
    le_of_eq (congrArg toLex (funext fun j => (hnuI _).symm))
  obtain ⟨⟨g, hg, -, hx⟩, -⟩ := exists_standardBase_extendsToStandardBase R Q J hJQ T hrat f i him
    ν hν h₁ (fun j _ => (h₂ j).trans (hν j).symm) hlex
  obtain ⟨h, hgh, hhν, -⟩ := hx C.x₁ C.span_x₁
  have hgM : ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j := fun j =>
    (ordElem_eq_nuI_of_isStandardBase J g hg j).trans (hν j).symm
  -- the initial forms of the `g_j` lie in the subalgebra generated by the `[z_i]`
  have hgW : ∀ j : Fin m, initialForm (maximalIdeal R) (g j) ∈
      Algebra.adjoin (R ⧸ maximalIdeal R)
        ((Submodule.span (R ⧸ maximalIdeal R) (Set.range C.classX) :
          Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))) :
          Set (AssocGraded (maximalIdeal R))) := by
    intro j
    obtain ⟨⟨p, hpe, hpure⟩, -⟩ := (C.ordElem_le_and_rho_initialForm_eq hrat (g j) (ν j) (hgM j)
      (h ⟨j, j.2⟩) (hgh ⟨j, j.2⟩)).2 (hhν ⟨j, j.2⟩)
    rw [← hpe]
    exact Algebra.adjoin_mono Submodule.subset_span (C.e_mem_adjoin_classX hpure)
  refine tauSubmodule_le_of_initialForm_mem_adjoin J g hg _ ?_ hgW a
  exact Submodule.span_le.mpr (by
    rintro _ ⟨i, rfl⟩
    exact C.classX_mem_homogeneous i)

end InitialFormsInSubalgebra

section KLinear

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] {T : MonoidalTransform R Q} [IsLocalHom T.toRing]
  [IsRegularLocalRing T.ring] (C : TransformCoord T)

omit [Q.IsPrime] [IsLocalHom T.toRing] [IsRegularLocalRing T.ring] in
/-- `z_i = x_i ∈ M ∖ M²`, with initial form `[z_i]`. -/
theorem TransformCoord.ordElem_x (i : Fin C.r) :
    Ideal.ordElem (maximalIdeal R) (C.x i) = 1 ∧
      initialForm (maximalIdeal R) (C.x i) = C.classX i := by
  have hmem : C.x i ∈ maximalIdeal R ^ 1 := C.z_mem (some (Sum.inl i))
  have hne : C.classX i ≠ 0 := by
    rw [C.classX_eq, ← map_zero C.e]
    exact fun h => MvPolynomial.X_ne_zero _ (C.e_bijective.1 h)
  obtain ⟨h1, h2⟩ := Ideal.ordElem_eq_of_mk_ne_zero _ hmem hne
  exact ⟨h1, h2⟩

omit [Q.IsPrime] in
/-- The quotient `u = q/x₁` of an element `q ∈ M ∖ M²` which lies in `M₁` has order one in `R₁` and
`ρ(in(u)) = in(q)` (Lemma 8 and the proof of Lemma 15, p. 231). -/
theorem TransformCoord.ordElem_quotient_eq_one (hrat : RingHom.IsResiduallyRational
    (R := R) (R' := T.ring) T.toRing) {q : R} (hqM : Ideal.ordElem (maximalIdeal R) q = 1)
    {u : T.ring} (hu : u ∈ maximalIdeal T.ring) (hxu : C.x₁ * u = T.toRing q) :
    Ideal.ordElem (maximalIdeal T.ring) u = 1 ∧
      C.ρ hrat (initialForm (maximalIdeal T.ring) u) = initialForm (maximalIdeal R) q := by
  have hle := (C.ordElem_le_and_rho_initialForm_eq hrat q 1 (by exact_mod_cast hqM) u
    (by rw [pow_one]; exact hxu)).1
  have hge : (1 : ℕ∞) ≤ Ideal.ordElem (maximalIdeal T.ring) u := by
    have hM : u ∈ maximalIdeal T.ring ^ 1 := by rwa [pow_one]
    exact_mod_cast Ideal.le_ordElem hM
  have h1 : Ideal.ordElem (maximalIdeal T.ring) u = 1 := le_antisymm (by exact_mod_cast hle) hge
  exact ⟨h1, ((C.ordElem_le_and_rho_initialForm_eq hrat q 1 (by exact_mod_cast hqM) u
    (by rw [pow_one]; exact hxu)).2 (by exact_mod_cast h1)).2⟩

omit [Q.IsPrime] in
/-- `ρ` maps the class of `z_i/x` to the class of `z_i`. -/
theorem TransformCoord.ρ_mk_x' (hrat : RingHom.IsResiduallyRational
    (R := R) (R' := T.ring) T.toRing) (i : Fin C.r) :
    C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 (C.x' i) (C.z₁_mem (some (Sum.inl i)))) =
      C.classX i := by
  have hu : C.x' i ∈ maximalIdeal T.ring := by
    have := C.z₁_mem (some (Sum.inl i))
    rwa [pow_one] at this
  obtain ⟨h1, h2⟩ := C.ordElem_quotient_eq_one hrat (C.ordElem_x i).1 hu (C.hx' i)
  rw [← (C.ordElem_x i).2, ← h2, initialForm_eq_mk _ h1]

omit [Q.IsPrime] in
/-- **Step (b) of the choice of the `τ`-frame, p. 258**: "It is then easily seen that, by applying a
suitable `k`-linear transformation to the system `(z₁, …, z_t)`, we can assume `(z₁, …, z_r)`
`(r ≤ t)` to be a regular system of `τ`-parameters of `R` for `J`."  Here `σ` is the coefficient
field `k = σ(R/M)` ("We have a subfield `k` of `R` such that `R = k{x, z₁, …, z_t, y₁, …, y_s}`").
Given elements `ζ_l` of the span `T = ⟨[z₁], …, [z_t]⟩ ⊆ gr¹_M(R)` (for instance an adapted basis
of the flag of `τ`-submodules, which lie in `T` by step (a)), the `k`-linear combinations
`z'_l = Σ_i σ(a_{li}) z_i` of the `z_i` have the classes `[z'_l] = ζ_l`; their quotients
`z'_l/x = Σ_i σ(a_{li}) (z_i/x)` lie in `M₁` and their classes in `gr¹_{M₁}(R₁)` satisfy
`ρ[z'_l/x] = ζ_l`.  (The remaining `z'_i`, `i > r`, of the transformation are any completion of
`ζ_1, …, ζ_r` to a basis of `T`; they are not used, as the extension of `(x, z'_1, …, z'_r)` to a
regular system of parameters is taken as `ExtendsToRSOP` below.) -/
theorem TransformCoord.exists_kLinear_quotientPair
    (σ : R ⧸ maximalIdeal R →+* R) (hσ : ∀ a, Ideal.Quotient.mk (maximalIdeal R) (σ a) = a)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) {n : ℕ}
    (ζ : Fin n → AssocGraded (maximalIdeal R))
    (hζ : ∀ l, ζ l ∈ Submodule.span (R ⧸ maximalIdeal R) (Set.range C.classX)) :
    ∃ (A : Fin n → Fin C.r → R ⧸ maximalIdeal R) (z : Fin n → R) (w : Fin n → T.ring),
      (∀ l, z l = ∑ i, σ (A l i) * C.x i) ∧
      (∀ l, w l = ∑ i, T.toRing (σ (A l i)) * C.x' i) ∧
      (∀ l, C.x₁ * w l = T.toRing (z l)) ∧
      ∃ (hz : ∀ l, z l ∈ maximalIdeal R ^ 1) (hw : ∀ l, w l ∈ maximalIdeal T.ring ^ 1),
        (∀ l, AssocGraded.mk (maximalIdeal R) 1 (z l) (hz l) = ζ l) ∧
        ∀ l, C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 (w l) (hw l)) = ζ l := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  have hco : ∀ l, ∃ a : Fin C.r → R ⧸ maximalIdeal R, ∑ i, a i • C.classX i = ζ l := fun l =>
    (Submodule.mem_span_range_iff_exists_fun _).mp (hζ l)
  choose A hA using hco
  have hxM : ∀ i, C.x i ∈ maximalIdeal R ^ 1 := fun i => C.z_mem (some (Sum.inl i))
  have hx'M : ∀ i, C.x' i ∈ maximalIdeal T.ring ^ 1 := fun i => C.z₁_mem (some (Sum.inl i))
  have hzM : ∀ l, ∑ i, σ (A l i) * C.x i ∈ maximalIdeal R ^ 1 := fun l =>
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hxM i)
  have hwM : ∀ l, ∑ i, T.toRing (σ (A l i)) * C.x' i ∈ maximalIdeal T.ring ^ 1 := fun l =>
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hx'M i)
  refine ⟨A, fun l => ∑ i, σ (A l i) * C.x i, fun l => ∑ i, T.toRing (σ (A l i)) * C.x' i,
    fun l => rfl, fun l => rfl, fun l => ?_, hzM, hwM, fun l => ?_, fun l => ?_⟩
  · simp only [map_sum, map_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [mul_left_comm, TransformCoord.x₁, C.hx' i]
  · have := AssocGraded.mk_one_sum_mul (maximalIdeal R) Finset.univ (fun i => σ (A l i))
      (fun i => C.x i) hxM (hzM l)
    rw [this, ← hA l]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hσ]
    rfl
  · have := AssocGraded.mk_one_sum_mul (maximalIdeal T.ring) Finset.univ
      (fun i => T.toRing (σ (A l i))) (fun i => C.x' i) hx'M (hwM l)
    rw [this, map_sum, ← hA l]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [TransformCoord.ρ_smul, C.ρ_mk_x' hrat i]
    congr 1
    have h1 : Ideal.Quotient.mk (maximalIdeal T.ring) (T.toRing (σ (A l i))) =
        T.residueEquiv hrat (A l i) := by
      have := T.residueEquiv_mk hrat (σ (A l i))
      rw [hσ] at this
      exact this.symm
    rw [h1]
    exact (T.residueEquiv hrat).symm_apply_apply _

omit [Q.IsPrime] [IsLocalHom T.toRing] [IsRegularLocalRing T.ring] in
/-- The classes `e(X_v) = [z_v]` of the regular system of parameters `(x, z₁, …, z_t, y₁, …, y_s)`
are linearly independent in `gr¹_M(R)`. -/
theorem TransformCoord.linearIndependent_e_X :
    LinearIndependent (R ⧸ maximalIdeal R)
      (fun v : CoordIndex C.r C.s => C.e (MvPolynomial.X v)) := by
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  exact LinearIndependent.map' (MvPolynomial.linearIndependent_X _ _)
    C.e.toLinearMap (LinearMap.ker_eq_bot.mpr C.e_bijective.1)

omit [Q.IsPrime] [IsLocalHom T.toRing] [IsRegularLocalRing T.ring] in
/-- The class of `x = x₀` in `gr¹_M(R)` is not in the span of the classes `[z_i]` of the other
elements `z₁, …, z_t` of the minimal base of `Q`. -/
theorem TransformCoord.mk_x₀_notMem_span_classX :
    AssocGraded.mk (maximalIdeal R) 1 C.x₀ (C.z_mem none) ∉
      Submodule.span (R ⧸ maximalIdeal R) (Set.range C.classX) := by
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  have h := C.linearIndependent_e_X.notMem_span_image (s := {v | v ≠ none}) (x := none)
    (by simp)
  intro hmem
  apply h
  have h0 : AssocGraded.mk (maximalIdeal R) 1 C.x₀ (C.z_mem none) =
      C.e (MvPolynomial.X none) := by
    rw [TransformCoord.e, MvPolynomial.aeval_X]
    rfl
  rw [← h0]
  refine Submodule.span_mono ?_ hmem
  rintro _ ⟨i, rfl⟩
  exact ⟨some (Sum.inl i), by simp, (C.classX_eq i).symm⟩

end KLinear

section KerRho

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] {T : MonoidalTransform R Q} [IsLocalHom T.toRing]
  [IsRegularLocalRing T.ring] (C : TransformCoord T)

omit [Q.IsPrime] in
/-- **`ker ρ ∩ gr¹_{M₁}(R₁) = ⟨[x], [y₁], …, [y_s]⟩`** (proof of Lemma 16, p. 232: "`ρ(X) = ρ(Y_j) =
0`
and `ρ(X_j) = X_j`"; p. 233: "First of all, it follows that `X, Y₁, …, Y_s` are linearly independent
modulo `T̃_a`"): two linear forms of `gr_{M₁}(R₁)` with the same image under `ρ` differ by a
`k₁`-linear combination of the classes of `x` and of the `y_j`. -/
theorem TransformCoord.exists_sub_eq_of_ρ_eq
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {y y' : AssocGraded (maximalIdeal T.ring)} (hy : y ∈ AssocGraded.homogeneous _ 1)
    (hy' : y' ∈ AssocGraded.homogeneous _ 1) (h : C.ρ hrat y = C.ρ hrat y') :
    ∃ (α : T.ring ⧸ maximalIdeal T.ring) (β : Fin C.s → T.ring ⧸ maximalIdeal T.ring),
      y = y' + α • C.e₁ (MvPolynomial.X none) +
        ∑ j, β j • C.e₁ (MvPolynomial.X (some (Sum.inr j))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  have hd : y - y' ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := sub_mem hy hy'
  obtain ⟨q, hq, hqd⟩ := C.exists_e₁_eq hd
  set c : CoordIndex C.r C.s → T.ring ⧸ maximalIdeal T.ring :=
    fun v => q.coeff (Finsupp.single v 1) with hc
  have hqsum : q = ∑ v, c v • MvPolynomial.X v := eq_sum_smul_X_of_isHomogeneous_one hq
  have hdsum : y - y' = ∑ v, c v • C.e₁ (MvPolynomial.X v) := by
    rw [← hqd, hqsum, map_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    rw [map_smul]
  -- `ρ(y - y') = 0` and linear independence of the `e(X_v)`
  have hρd : C.ρ hrat (y - y') = 0 := by rw [map_sub, h, sub_self]
  have hρsum : C.ρ hrat (y - y') = ∑ v, (if xWeight v = 1 then (T.residueEquiv hrat).symm (c v)
      else 0) • C.e (MvPolynomial.X v) := by
    rw [hdsum, map_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    rw [TransformCoord.ρ_smul, TransformCoord.ρ_e₁, MvPolynomial.map_X, pureSubst,
      MvPolynomial.aeval_X]
    split_ifs with hv
    · rfl
    · simp
  have hli : LinearIndependent (R ⧸ maximalIdeal R)
      (fun v : CoordIndex C.r C.s => C.e (MvPolynomial.X v)) :=
    LinearIndependent.map' (MvPolynomial.linearIndependent_X _ _)
      C.e.toLinearMap (LinearMap.ker_eq_bot.mpr C.e_bijective.1)
  have hc0 : ∀ v, xWeight v = 1 → c v = 0 := by
    intro v hv
    have := Fintype.linearIndependent_iff.mp hli _ (hρsum ▸ hρd) v
    simp only [hv, ↓reduceIte] at this
    exact (map_eq_zero_iff _ (T.residueEquiv hrat).symm.injective).mp this
  -- hence `y - y'` is a combination of `e₁(X none)` and `e₁(X (inr j))`
  refine ⟨c none, fun j => c (some (Sum.inr j)), ?_⟩
  have : y = y' + (y - y') := by abel
  rw [this, hdsum, Fintype.sum_option, Fintype.sum_sum_type]
  have hinl : ∑ i : Fin C.r, c (some (Sum.inl i)) • C.e₁ (MvPolynomial.X (some (Sum.inl i))) = 0 :=
    Finset.sum_eq_zero fun i _ => by rw [hc0 _ (by simp [xWeight]), zero_smul]
  rw [hinl, zero_add, add_assoc]

omit [Q.IsPrime] in
/-- **Step (c) of the choice of the `τ`-frame, p. 259**: "Moreover, by Proposition 1, § 5, we have
`τ*(J₁) = τ*(J)`, and therefore we can choose the above `(z₁, …, z_r)` in such a way that the
transform `(S₁; z₁/x, …, z_r/x)` is a regular `τ`-frame of `R₁` for `J₁`.  (See the proof of
Lemma 16, § 5.)"  The proof of Lemma 16 chooses a base `Z̃₁, …, Z̃_r̄, X, Y₁, …, Y_s` of
`gr¹_{M₁}(R₁)` such that `T̃_b` is generated by `Z̃₁, …, Z̃_{τ_b}`, where `ρ(Z̃_j) = Z_j`: the
`Z̃_j` differ from the classes of the `z_j/x` by linear combinations of `X` and the `Y_j`.  This is
realized by changing the element `z` to `z + x ℓ` with `ℓ ∈ M`, i.e. `z/x` to `z/x + ℓ`: given a
pair `(z, w)` with `x w = z` and a linear form `y` with `ρ(y) = ρ[w]`, there is `ℓ ∈ M` with
`[w + ℓ] = y` (and `[z + x ℓ] = [z]` in `gr¹_M(R)`, as `x ℓ ∈ M²`). -/
theorem TransformCoord.exists_adjust_quotient
    (σ : R ⧸ maximalIdeal R →+* R) (hσ : ∀ a, Ideal.Quotient.mk (maximalIdeal R) (σ a) = a)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {w : T.ring} (hw : w ∈ maximalIdeal T.ring ^ 1) {y : AssocGraded (maximalIdeal T.ring)}
    (hy : y ∈ AssocGraded.homogeneous _ 1)
    (h : C.ρ hrat y = C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 w hw)) :
    ∃ ℓ ∈ maximalIdeal R, ∃ hw' : w + T.toRing ℓ ∈ maximalIdeal T.ring ^ 1,
      AssocGraded.mk (maximalIdeal T.ring) 1 (w + T.toRing ℓ) hw' = y := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  obtain ⟨α, β, hαβ⟩ := C.exists_sub_eq_of_ρ_eq hrat hy (AssocGraded.mk_mem_homogeneous _ _) h
  set lift' : T.ring ⧸ maximalIdeal T.ring → R := fun a => σ ((T.residueEquiv hrat).symm a)
    with hlift'
  have hlift'mk : ∀ a, Ideal.Quotient.mk (maximalIdeal T.ring) (T.toRing (lift' a)) = a := by
    intro a
    have := T.residueEquiv_mk hrat (lift' a)
    rw [hlift', hσ, RingEquiv.apply_symm_apply] at this
    exact this.symm
  set ℓ : R := lift' α * C.x₀ + ∑ j, lift' (β j) * C.y j with hℓ
  have hx₀M : C.x₀ ∈ maximalIdeal R := by
    have := C.z_mem none
    rwa [pow_one] at this
  have hyM : ∀ j, C.y j ∈ maximalIdeal R := fun j => by
    have := C.z_mem (some (Sum.inr j))
    rwa [pow_one] at this
  have hℓM : ℓ ∈ maximalIdeal R :=
    add_mem (Ideal.mul_mem_left _ _ hx₀M)
      (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hyM j))
  have hℓ1 : T.toRing ℓ ∈ maximalIdeal T.ring ^ 1 := by
    rw [pow_one]
    exact (IsLocalHom.map_mem_maximalIdeal_iff T.toRing _).mpr hℓM
  refine ⟨ℓ, hℓM, add_mem hw hℓ1, ?_⟩
  -- the class of `T.toRing ℓ`
  have h1 : T.toRing (lift' α * C.x₀) ∈ maximalIdeal T.ring ^ 1 := by
    rw [pow_one]
    exact (IsLocalHom.map_mem_maximalIdeal_iff T.toRing _).mpr (Ideal.mul_mem_left _ _ hx₀M)
  have hx₁1 : C.x₁ ∈ maximalIdeal T.ring ^ 1 := C.z₁_mem none
  have hy1 : ∀ j, T.toRing (C.y j) ∈ maximalIdeal T.ring ^ 1 := fun j => C.z₁_mem (some (Sum.inr j))
  have h2 : ∑ j, T.toRing (lift' (β j)) * T.toRing (C.y j) ∈ maximalIdeal T.ring ^ 1 :=
    Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hy1 j)
  have hT : T.toRing ℓ = T.toRing (lift' α) * C.x₁ +
      ∑ j, T.toRing (lift' (β j)) * T.toRing (C.y j) := by
    rw [hℓ, map_add, map_mul, map_sum]
    simp only [map_mul]
    rfl
  have hc1 : T.toRing (lift' α) * C.x₁ ∈ maximalIdeal T.ring ^ 1 := Ideal.mul_mem_left _ _ hx₁1
  have hcls : AssocGraded.mk (maximalIdeal T.ring) 1 (T.toRing ℓ) hℓ1 =
      α • C.e₁ (MvPolynomial.X none) + ∑ j, β j • C.e₁ (MvPolynomial.X (some (Sum.inr j))) := by
    have e1 : ∀ v, C.e₁ (MvPolynomial.X v) =
        AssocGraded.mk (maximalIdeal T.ring) 1 (C.z₁ v) (C.z₁_mem v) := by
      intro v
      rw [TransformCoord.e₁, MvPolynomial.aeval_X]
    rw [e1, AssocGraded.mk_congr _ hℓ1 hT, AssocGraded.mk_add _ 1 _ _ hc1 h2]
    congr 1
    · rw [← AssocGraded.smul_mk (maximalIdeal T.ring) 1 (T.toRing (lift' α)) C.x₁ hx₁1, hlift'mk]
      rfl
    · rw [AssocGraded.mk_one_sum_mul (maximalIdeal T.ring) Finset.univ
        (fun j => T.toRing (lift' (β j))) (fun j => T.toRing (C.y j)) hy1 h2]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hlift'mk, e1]
      rfl
  rw [AssocGraded.mk_add _ 1 _ _ hw hℓ1, hcls, hαβ]
  abel

end KerRho

section Lemma11Step

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- For a regular system of `τ`-parameters `(p_i)`, the `τ`-submodule `T_t` is the span of the
classes `[p_i] ∈ gr¹_M`. -/
theorem tauSubmodule_eq_span_of_isRegularSystemOfTauParameters (J : Ideal S)
    (p : Fin (tau S J (t S J)) → maximalIdeal S) (hp : IsRegularSystemOfTauParameters S J (t S J) p)
    (ht : 1 ≤ t S J) :
    tauSubmodule S J (t S J) = Submodule.span (S ⧸ maximalIdeal S)
      (Set.range fun i => AssocGraded.mk (maximalIdeal S) 1 (p i : S)
        (by rw [pow_one]; exact (p i).2)) := by
  have h := hp (t S J) ht le_rfl
  have hrange : (Set.range fun i : {i : Fin (tau S J (t S J)) // (i : ℕ) < tau S J (t S J)} =>
      AssocGraded.mk (maximalIdeal S) 1 (p i.1 : S) (by rw [pow_one]; exact (p i.1).2)) =
      Set.range fun i => AssocGraded.mk (maximalIdeal S) 1 (p i : S)
        (by rw [pow_one]; exact (p i).2) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.1, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨⟨i, i.2⟩, rfl⟩
  rw [hrange] at h
  exact ((tauSubmodule_spec S J (t S J) ht le_rfl).2.2 _
    (fun i => AssocGraded.mk_mem_homogeneous _ _) h).symm

/-- **Lemma 11 and `P₁ ⊆ (u_q)R₁`** (p. 259: "By the assumption that `P₁` is a permissible center
for
`J₁`, we can choose it in such a way that `z_j/x ∈ P₁` for all `j`. (See Lemma 11, § 4.)"): if `P₁`
is a permissible center for `J₁` with regular quotient and `P₁ ⊆ (u_i)_i`, where the `u_i` lie in
`M₁`, then the `τ`-submodule `T̃_t` of `J₁` lies in the span of the classes `[u_i] ∈ gr¹_{M₁}(R₁)`.
By Lemma 11 `T̃_t` is spanned by the classes of a regular system of `τ`-parameters lying in `P₁`,
and an element of `P₁ ⊆ (u_i)` has the class `Σ ā_i [u_i]`. -/
theorem tauSubmodule_top_le_span_of_le_span (J : Ideal S) (P : Ideal S) [P.IsPrime] (hJP : J ≤ P)
    (hP : IsRegularLocalRing (S ⧸ P)) (hperm : IsPermissibleCenter S J P) {ι : Type*} [Fintype ι]
    (u : ι → S) (hu1 : ∀ i, u i ∈ maximalIdeal S ^ 1) (hPU : P ≤ Ideal.span (Set.range u))
    (ht : 1 ≤ t S J) :
    tauSubmodule S J (t S J) ≤ Submodule.span (S ⧸ maximalIdeal S)
      (Set.range fun i => AssocGraded.mk (maximalIdeal S) 1 (u i) (hu1 i)) := by
  classical
  obtain ⟨-, -, -, hNF⟩ := hperm.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  obtain ⟨m, f, hf, hfP⟩ := ((isPermissibleCenter_tfae S J P hJP).out 1 3).mp hNF
  obtain ⟨p, hp, hpP⟩ := exists_regularSystemOfTauParameters_mem_prime S J P hJP hP f hf.1
    (fun j => (ordElem_eq_nuI_of_isStandardBase J f hf j).trans (hfP j).symm) hf.2.2.2.1.symm
  rw [tauSubmodule_eq_span_of_isRegularSystemOfTauParameters J p hp ht]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  have hpU : (p i : S) ∈ Ideal.span (Set.range u) := hPU (hpP i)
  obtain ⟨a, ha⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hpU
  have hsum : ∑ j, a j * u j ∈ maximalIdeal S ^ 1 := by rw [ha]; rw [pow_one]; exact (p i).2
  have := AssocGraded.mk_one_sum_mul (maximalIdeal S) Finset.univ a u hu1 hsum
  have hmk : AssocGraded.mk (maximalIdeal S) 1 (p i : S) (by rw [pow_one]; exact (p i).2) =
      AssocGraded.mk (maximalIdeal S) 1 (∑ j, a j * u j) hsum := by
    refine AssocGraded.mk_congr _ _ ?_
    exact ha.symm
  show AssocGraded.mk (maximalIdeal S) 1 (p i : S) (by rw [pow_one]; exact (p i).2) ∈ _
  rw [hmk, this]
  exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

end Lemma11Step

section QuotientPairInPrime

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] {T : MonoidalTransform R Q} [IsLocalHom T.toRing]
  [IsRegularLocalRing T.ring] (C : TransformCoord T)

omit [Q.IsPrime] in
/-- **Step (d) of the choice of the `τ`-frame, p. 259** (the filling of "(See Lemma 11, § 4.)"):
let `(q)_q` be a minimal base of the prime `P ⊆ Q`, `u_q = q/x ∈ P₁` its quotients, and `y` a linear
form in the span of the classes `[u_q]` of `gr¹_{M₁}(R₁)`.  Then there are `z ∈ P` and
`w = z/x ∈ P₁` (so that `z/x ∈ P₁`) with `[w] = y` and `[z] = ρ(y)`.  In particular, if `(z', w')`
is the pair obtained in step (c) with `[w'] = y` and `[z'] = ρ(y)`, the pair `(z, w)` is an
adjustment of it: `z − z' ∈ M²` and `w − w' ∈ M₁²`, so that the properties of (b) and (c) are
preserved while `z/x ∈ P₁`. -/
theorem TransformCoord.exists_quotientPair_mem_prime
    (σ : R ⧸ maximalIdeal R →+* R) (hσ : ∀ a, Ideal.Quotient.mk (maximalIdeal R) (σ a) = a)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {P : Ideal R} {P₁ : Ideal T.ring} {ι : Type*} [Fintype ι] (q : ι → R) (u : ι → T.ring)
    (hqP : ∀ i, q i ∈ P) (huP₁ : ∀ i, u i ∈ P₁) (hxu : ∀ i, C.x₁ * u i = T.toRing (q i))
    (hq1 : ∀ i, q i ∈ maximalIdeal R ^ 1) (hu1 : ∀ i, u i ∈ maximalIdeal T.ring ^ 1)
    (hρu : ∀ i, C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 (u i) (hu1 i)) =
      AssocGraded.mk (maximalIdeal R) 1 (q i) (hq1 i))
    {y : AssocGraded (maximalIdeal T.ring)}
    (hy : y ∈ Submodule.span (T.ring ⧸ maximalIdeal T.ring)
      (Set.range fun i => AssocGraded.mk (maximalIdeal T.ring) 1 (u i) (hu1 i))) :
    ∃ (z : R) (w : T.ring) (hz : z ∈ maximalIdeal R ^ 1) (hw : w ∈ maximalIdeal T.ring ^ 1),
      z ∈ P ∧ w ∈ P₁ ∧ C.x₁ * w = T.toRing z ∧
        AssocGraded.mk (maximalIdeal T.ring) 1 w hw = y ∧
        AssocGraded.mk (maximalIdeal R) 1 z hz = C.ρ hrat y := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hy
  set lift' : T.ring ⧸ maximalIdeal T.ring → R := fun a => σ ((T.residueEquiv hrat).symm a)
    with hlift'
  have hlift'mk : ∀ a, Ideal.Quotient.mk (maximalIdeal T.ring) (T.toRing (lift' a)) = a := by
    intro a
    have := T.residueEquiv_mk hrat (lift' a)
    rw [hlift', hσ, RingEquiv.apply_symm_apply] at this
    exact this.symm
  have hlift'mk' : ∀ a, Ideal.Quotient.mk (maximalIdeal R) (lift' a) =
      (T.residueEquiv hrat).symm a := fun a => by rw [hlift', hσ]
  have hzM : ∑ i, lift' (c i) * q i ∈ maximalIdeal R ^ 1 :=
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hq1 i)
  have hwM : ∑ i, T.toRing (lift' (c i)) * u i ∈ maximalIdeal T.ring ^ 1 :=
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hu1 i)
  refine ⟨∑ i, lift' (c i) * q i, ∑ i, T.toRing (lift' (c i)) * u i, hzM, hwM,
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hqP i),
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (huP₁ i), ?_, ?_, ?_⟩
  · simp only [map_sum, map_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [mul_left_comm, hxu i]
  · have := AssocGraded.mk_one_sum_mul (maximalIdeal T.ring) Finset.univ
      (fun i => T.toRing (lift' (c i))) u hu1 hwM
    rw [this, ← hc]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hlift'mk]
  · have := AssocGraded.mk_one_sum_mul (maximalIdeal R) Finset.univ (fun i => lift' (c i)) q hq1 hzM
    rw [this, ← hc, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [TransformCoord.ρ_smul, hρu i, hlift'mk']

omit [Q.IsPrime] in
/-- **Step (d), as an adjustment of the pair of step (c)**: let `(z', w')` be a pair with `x w' =
z'`,
`ρ[w'] = [z']` (as obtained in steps (b) and (c)) and `[w']` in the span of the classes `[u_q]`
(as `[w'] ∈ T̃_t`, by Lemma 11 and `P₁ ⊆ (u_q)`).  Then there is a pair `(z, w)` with `z ∈ P`,
`w ∈ P₁`, `x w = z`, `z − z' ∈ M²` and `w − w' ∈ M₁²`: the classes of `z` and of `w`, in `gr¹_M(R)`
and in `gr¹_{M₁}(R₁)`, are those of `z'` and of `w'`. -/
theorem TransformCoord.exists_adjust_quotientPair_mem_prime
    (σ : R ⧸ maximalIdeal R →+* R) (hσ : ∀ a, Ideal.Quotient.mk (maximalIdeal R) (σ a) = a)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {P : Ideal R} {P₁ : Ideal T.ring} {ι : Type*} [Fintype ι] (q : ι → R) (u : ι → T.ring)
    (hqP : ∀ i, q i ∈ P) (huP₁ : ∀ i, u i ∈ P₁) (hxu : ∀ i, C.x₁ * u i = T.toRing (q i))
    (hq1 : ∀ i, q i ∈ maximalIdeal R ^ 1) (hu1 : ∀ i, u i ∈ maximalIdeal T.ring ^ 1)
    (hρu : ∀ i, C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 (u i) (hu1 i)) =
      AssocGraded.mk (maximalIdeal R) 1 (q i) (hq1 i))
    {z' : R} {w' : T.ring} (hz' : z' ∈ maximalIdeal R ^ 1) (hw' : w' ∈ maximalIdeal T.ring ^ 1)
    (hρ : C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 w' hw') =
      AssocGraded.mk (maximalIdeal R) 1 z' hz')
    (hy : AssocGraded.mk (maximalIdeal T.ring) 1 w' hw' ∈
      Submodule.span (T.ring ⧸ maximalIdeal T.ring)
        (Set.range fun i => AssocGraded.mk (maximalIdeal T.ring) 1 (u i) (hu1 i))) :
    ∃ (z : R) (w : T.ring), z ∈ P ∧ w ∈ P₁ ∧ C.x₁ * w = T.toRing z ∧
      z - z' ∈ maximalIdeal R ^ (1 + 1) ∧ w - w' ∈ maximalIdeal T.ring ^ (1 + 1) := by
  obtain ⟨z, w, hz, hw, hzP, hwP₁, hzw, hwcls, hzcls⟩ :=
    C.exists_quotientPair_mem_prime σ hσ hrat q u hqP huP₁ hxu hq1 hu1 hρu hy
  refine ⟨z, w, hzP, hwP₁, hzw, ?_, ?_⟩
  · rw [← AssocGraded.mk_eq_zero_iff (maximalIdeal R) (sub_mem hz hz'),
      AssocGraded.mk_sub _ 1 z z' hz hz', hzcls, hρ, sub_self]
  · rw [← AssocGraded.mk_eq_zero_iff (maximalIdeal T.ring) (sub_mem hw hw'),
      AssocGraded.mk_sub _ 1 w w' hw hw', hwcls, sub_self]

end QuotientPairInPrime

section RhoTauSubmodule

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]
  {Q : Ideal R} [Q.IsPrime] [IsRegularLocalRing (R ⧸ Q)]

omit [IsRegularLocalRing (R ⧸ Q)] in
/-- **`ρ(T̃_a) = T_a`** (proof of Lemma 16, p. 232, "As near the end of the proof of Lemma 15,
`T_b ⊆ ρ(T̃_b)` and `τ_b = rank T_b ≤ rank ρ(T̃_b) ≤ rank T̃_b = τ_b`; hence `T_b = ρ(T̃_b)`"):
for a permissible center `Q` of `J`, a residually rational monoidal transform with centre `Q`, and
`ν*(J₁) = ν*(J)`, `τ^{(b)}(J₁) = τ^{(b)}(J)` for all `b`, the homomorphism `ρ : gr_{M₁}(R₁) →
gr_M(R)` of the coordinates `C` maps the `τ`-submodule `T̃_a` of `J₁` onto the `τ`-submodule
`T_a` of `J`.  This is the first half of the proof of
`exists_gradedRingEquiv_strictTransform` (which only exports the abstract isomorphism `σ`). -/
theorem TransformCoord.rho_tauSubmodule {T : MonoidalTransform R Q} [IsLocalHom T.toRing]
    [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (C : TransformCoord T) (J : Ideal R) (hJQ : J ≤ Q) (hQperm : IsPermissibleCenter R J Q)
    (hnu : nuStar T.ring (strictTransformIdeal T J) = nuStar R J)
    (htau : ∀ b, 1 ≤ b → b ≤ t R J → tau T.ring (strictTransformIdeal T J) b = tau R J b)
    (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t R J) :
    (∀ y ∈ tauSubmodule T.ring (strictTransformIdeal T J) a,
        C.ρ hrat y ∈ tauSubmodule R J a) ∧
      (∀ ζ ∈ tauSubmodule R J a, ∃ y ∈ tauSubmodule T.ring (strictTransformIdeal T J) a,
        C.ρ hrat y = ζ) ∧
      ∀ y ∈ tauSubmodule T.ring (strictTransformIdeal T J) a, C.ρ hrat y = 0 → y = 0 := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  have hnuI : ∀ i, nuI T.ring J₁ i = nuI R J i := fun i => congrFun (toLex.injective hnu) i
  have hmuSet : muSet T.ring J₁ = muSet R J := by
    ext μ
    simp only [muSet, Set.mem_ofPred_eq, hnuI]
  have ht : t T.ring J₁ = t R J := by rw [t, t, hmuSet]
  have hat₁ : a ≤ t T.ring J₁ := ht ▸ hat
  have heq : ∀ j : ℕ+, nuI R J j = nuI T.ring J₁ j := fun j => (hnuI j).symm
  obtain ⟨-, -, hS, hNF⟩ := hQperm.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  have _ : IsRegularLocalRing (R ⧸ Q) := hS
  -- (ii)**: a standard base `(f_j)` of `J` with `ν_Q(f_j) = ν^{(j)}(J)`
  obtain ⟨m, f, h₁, h₂⟩ := ((isPermissibleCenter_tfae R J Q hJQ).out 1 3).mp hNF
  obtain ⟨i, hi⟩ := exists_isGreatest_nuI_eq_mu J a ha hat
  set μb := mu R J a with hμb
  have hftop : ∀ j : Fin m, Ideal.ordElem (maximalIdeal R) (f j) ≠ ⊤ := by
    intro j htop
    apply h₁.2.2.2.2 j
    dsimp only
    rw [show initialForm (maximalIdeal R) (f j) = 0 by rw [initialForm, dite_eq_left htop]]
    exact zero_mem _
  let ν : Fin m → ℕ := fun j => (Ideal.ordElem (maximalIdeal R) (f j)).toNat
  have hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat) := fun j =>
    (ENat.natCast_toNat (hftop j)).trans (ordElem_eq_nuI_of_isStandardBase J f h₁ j)
  have him : (i : ℕ) ≤ m := by
    by_contra hlt
    have := (nuI_eq_of_hasLemma1Properties R J _ h₁.2).2 i (by omega)
    have h1 := hi.1
    simp only [Set.mem_ofPred_eq] at h1
    rw [this] at h1
    exact ENat.top_ne_natCast _ h1
  have hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
      toLex fun j : Fin (i : ℕ) => nuI T.ring J₁ ((j : ℕ).succPNat) :=
    le_of_eq (congrArg toLex (funext fun j => heq _))
  obtain ⟨⟨g, hg, -, hx⟩, -⟩ := exists_standardBase_extendsToStandardBase R Q J hJQ T hrat f i him
    ν hν h₁ (fun j _ => (h₂ j).trans (hν j).symm) hlex
  obtain ⟨h, hgh, hhν, hext⟩ := hx C.x₁ C.span_x₁
  have hgM : ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j := fun j =>
    (ordElem_eq_nuI_of_isStandardBase J g hg j).trans (hν j).symm
  obtain ⟨dg, hdg, hmonog⟩ := hg.2.2.1
  have hdgν : ∀ j, dg j = ν j := fun j => by
    have := (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J g hg dg hdg j).symm.trans
      (hgM j)
    exact_mod_cast this
  have hνgt : ∀ j : Fin m, (i : ℕ) ≤ j → μb < ν j := by
    intro j hj
    have h1 : nuI R J i ≤ nuI R J (j : ℕ).succPNat :=
      nuI_mono J (by rw [← PNat.coe_le_coe]; simp; omega)
    have h2 : nuI R J i = μb := hi.1
    rw [h2, ← hν j, Nat.cast_le] at h1
    rcases h1.lt_or_eq with h3 | h3
    · exact h3
    · exfalso
      have := hi.2 (show (j : ℕ).succPNat ∈ {k : ℕ+ | nuI R J k = (μb : ℕ∞)} by
        simp only [Set.mem_ofPred_eq]; rw [← hν j, h3])
      rw [← PNat.coe_le_coe] at this
      simp at this
      omega
  have hi1 : (i : ℕ) - 1 < (i : ℕ) := by have := i.pos; omega
  have hνi : ν (Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩) = μb := by
    have h1 := hν (Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩)
    have h2 : ((Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩ : Fin m) : ℕ).succPNat = i := by
      apply PNat.eq; simp; have := i.pos; omega
    rw [h2, hi.1] at h1
    exact_mod_cast h1
  have hνle : ∀ s : Fin (i : ℕ), ν (Fin.castLE him s) ≤ μb := fun s => by
    rw [← hνi, ← hdgν, ← hdgν]
    exact hmonog (Fin.le_def.mpr (by simp; omega))
  have hmu : mu T.ring J₁ a = μb := mu_eq_of_nuI_eq J J₁ a ha hat i hi (fun j _ => heq j)
  obtain ⟨W, hW1, hW⟩ := tau_spec T.ring J₁ a
  have hWspan : Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) =
      tauSubmodule T.ring J₁ a :=
    (tauSubmodule_spec T.ring J₁ a ha hat₁).2.2 W hW1 hW
  rw [hmu] at hW
  have hprop := TransformCoord.isTauSubmodule_span_rho R Q J T hrat C g hg i him ν hgM h hgh hhν
    hext μb hνle ⟨(i : ℕ) - 1, hi1⟩ hνi hνgt W hW1 hW
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  have hcard : tau T.ring J₁ a = tau R J a := htau a ha hat
  obtain ⟨-, hrank, huniq⟩ := tauSubmodule_spec R J a ha hat
  let W' : Fin (tau R J a) → AssocGraded (maximalIdeal R) := fun l =>
    C.ρ hrat (W (Fin.cast hcard.symm l))
  have hrange : Set.range W' = Set.range fun l => C.ρ hrat (W l) := by
    ext y
    constructor
    · rintro ⟨l, rfl⟩
      exact ⟨_, rfl⟩
    · rintro ⟨l, rfl⟩
      exact ⟨Fin.cast hcard l, by simp [W']⟩
  have hspan := huniq W' (fun l => C.ρ_mem_homogeneous hrat (hW1 _))
    (by rw [hrange]; exact hprop)
  rw [hrange] at hspan
  -- `ρ(Z̄_1), …, ρ(Z̄_{τ_a})` are linearly independent (`τ_a(J) = rank T_a`)
  have hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (W l) := by
    rw [linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin, Set.finrank, hspan, hrank,
      hcard]
  refine ⟨?_, ?_, ?_⟩
  · intro y hy
    rw [← hWspan] at hy
    rw [← hspan]
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l, rfl⟩ := hy
      exact Submodule.subset_span ⟨l, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul c y _ hy =>
      rw [TransformCoord.ρ_smul]
      exact Submodule.smul_mem _ _ hy
  · intro ζ hζ
    rw [← hspan] at hζ
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hζ
    refine ⟨∑ l, (T.residueEquiv hrat) (c l) • W l, ?_, ?_⟩
    · rw [← hWspan]
      exact Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
    · rw [map_sum]
      simp only [TransformCoord.ρ_smul, RingEquiv.symm_apply_apply]
      exact hc
  · intro y hy hρy
    rw [← hWspan] at hy
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hy
    rw [map_sum] at hρy
    simp only [TransformCoord.ρ_smul] at hρy
    have h2 := Fintype.linearIndependent_iff.mp hli _ hρy
    have h3 : ∀ l, c l = 0 := fun l => by
      have := h2 l
      simpa using this
    simp [h3]

end RhoTauSubmodule

section TauParametersFromClasses

variable {A : Type u} [CommRing A] [IsRegularLocalRing A]

/-- A system `z` of elements of `M` whose classes in `gr¹_M(A)` are a family `ζ` adapted to the
flag of `τ`-submodules (`span (ζ_l)_{l<τ_b} = T_b` for `b ≤ t`) is a regular system of
`τ`-parameters (Definition 7); `n` is any index set cardinality equal to `τ^{(t)}(J)`. -/
theorem isRegularSystemOfTauParameters_of_mk_eq (J : Ideal A) {n : ℕ} (h : tau A J (t A J) = n)
    (z : Fin n → A) (hz : ∀ l, z l ∈ maximalIdeal A)
    (ζ : Fin n → AssocGraded (maximalIdeal A))
    (hζ : ∀ b, 1 ≤ b → b ≤ t A J → Submodule.span (A ⧸ maximalIdeal A)
      (Set.range fun l : {l : Fin n // (l : ℕ) < tau A J b} => ζ l.1) = tauSubmodule A J b)
    (hzclass : ∀ l, AssocGraded.mk (maximalIdeal A) 1 (z l) (by simpa using hz l) = ζ l) :
    IsRegularSystemOfTauParameters A J (t A J) (fun l => ⟨z (Fin.cast h l), hz _⟩) := by
  subst h
  intro b hb hbt
  have hrange : (Set.range fun i : {i : Fin (tau A J (t A J)) // (i : ℕ) < tau A J b} =>
      AssocGraded.mk (maximalIdeal A) 1 ((⟨z (Fin.cast rfl i.1), hz _⟩ : maximalIdeal A) : A)
        (by rw [pow_one]; exact (⟨z (Fin.cast rfl i.1), hz _⟩ : maximalIdeal A).2)) =
      Set.range fun l : {l : Fin (tau A J (t A J)) // (l : ℕ) < tau A J b} => ζ l.1 := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i, (hzclass i.1).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, hzclass i.1⟩
  show IsTauSubmodule A J (Submodule.span (A ⧸ maximalIdeal A) (Set.range fun
    i : {i : Fin (tau A J (t A J)) // (i : ℕ) < tau A J b} =>
      AssocGraded.mk (maximalIdeal A) 1 ((⟨z (Fin.cast rfl i.1), hz _⟩ : maximalIdeal A) : A)
        (by rw [pow_one]; exact (⟨z (Fin.cast rfl i.1), hz _⟩ : maximalIdeal A).2))) (mu A J b)
  rw [hrange, hζ b hb hbt]
  exact (tauSubmodule_spec A J b hb hbt).1

end TauParametersFromClasses

section TauParametersInPrime

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]

open Classical in
/-- **The choice of the regular `τ`-frame in the proof of Proposition 2** (pp. 258–259), along the
printed text.  Notation: `R` is complete with coefficient field `k = σ(R/M)`, `P ⊊ Q`, `R₁` a
residually rational monoidal transform of `R` with center `Q`, `P₁ ⊆ R₁` a prime with `P₁ ∩ R = P`.

(a) "let us choose a minimal base `(x, z₁, …, z_t)` of `Q`, where `t = dim(R_Q) − 1`, such that
`(x)R₁ = QR₁` and all the `z_i/x` `(1 ≤ i ≤ t)` are contained in the maximal ideal of `R₁`", and
"By Lemma 14, § 5, we have a standard base `(h₁, …, h_m)` of `J` such that, if
`ν_j = ν_M(h_j) = ν^{(j)}(J)`, then `ν_Q(h_j) = ν_j` and `ν_{M₁}(x^{-ν_j}h_j) = ν_j` for all `j`.
Therefore, the initial forms of the `h_j` in `gr_M(R)` must belong to the `(R/M)`-subalgebra of
`gr_M(R)` generated by the initial forms of the `z_i`": the coordinates `C` of `T`
(`TransformCoord.nonempty`) are the minimal base, and `TransformCoord.tauSubmodule_le_span_classX`
gives `T_a ⊆ ⟨[z₁], …, [z_t]⟩`.

(b) "It is then easily seen that, by applying a suitable `k`-linear transformation to the system
`(z₁, …, z_t)`, we can assume `(z₁, …, z_r)` `(r ≤ t)` to be a regular system of `τ`-parameters of
`R`
for `J`" (`TransformCoord.exists_kLinear_quotientPair`, with an adapted basis `ζ_1, …, ζ_r` of the
flag `T_1 ⊆ … ⊆ T_t`).

(c) "Moreover, by Proposition 1, § 5, we have `τ*(J₁) = τ*(J)`, and therefore we can choose the
above
`(z₁, …, z_r)` in such a way that the transform `(S₁; z₁/x, …, z_r/x)` is a regular `τ`-frame of
`R₁`
for `J₁`.  (See the proof of Lemma 16, § 5.)": `ρ(T̃_b) = T_b` and `ρ` is injective on `T̃_t`
(`TransformCoord.rho_tauSubmodule`, the first half of the proof of Lemma 16), and
`z_l + xℓ_l` with `ℓ_l ∈ M` (`TransformCoord.exists_adjust_quotient`).

(d) "By the assumption that `P₁` is a permissible center for `J₁`, we can choose it in such a way
that
`z_j/x ∈ P₁` for all `j` `(1 ≤ j ≤ r)`.  (See Lemma 11, § 4.)": Lemma 11 for `(R₁, J₁, P₁)` shows
that
`T̃_t` is spanned by classes of elements of `P₁`; as `P₁ ⊆ (q/x)R₁` for a minimal base `(q)` of
`P`, they are linear combinations of the classes of the quotients `q/x`
(`tauSubmodule_top_le_span_of_le_span`), and the pair of step (c) is adjusted to a pair
`(z, w = z/x)` with `z ∈ P` and `w ∈ P₁`, with the same classes in `gr¹_M(R)` and `gr¹_{M₁}(R₁)`
(`TransformCoord.exists_adjust_quotientPair_mem_prime`).

The conclusion is the output of the paragraph: `x = x₀ ∈ Q ∖ P` with `QR₁ = (x₀)R₁`, elements `z_l ∈
P`
with `z_l/x ∈ P₁`, `(z_l)` a regular system of `τ`-parameters of `R` for `J` and `(z_l/x)` one of
`R₁`
for `J₁`, and `(x₀, z_1, …, z_r)` part of a regular system of parameters of `R`.

Gaps of the paper filled: "it is then easily seen" (b), the two "See …" of (c) and (d) (the
sentence "(See Lemma 11)" does not by itself give that the `τ`-parameters of `R₁` in `P₁` are
quotients `z_j/x` of elements of `P`), and the existence of `ℓ_l` in (c).  Not materialized: the
remaining vectors `z_{r+1}, …, z_t` of the `k`-linear transformation, and the elements `y_j`, since
the
extension of `(x, z₁, …, z_r)` to a regular system of parameters is taken as `ExtendsToRSOP`. -/
@[blueprint "lem:III.8-2-tau-parameters"
  (statement := /-- Let $R$ be a regular local ring with a coefficient field $k$, $J$ an ideal and
    $P\subsetneq Q$ prime ideals of $R$ with $J\subseteq P$, $R/P$ and $R/Q$ regular and $Q$ a
    permissible center for $J$. Let $R_1$ be a monoidal transform of $R$ with center $Q$,
    residually rational over $R$, $P_1$ a prime ideal of $R_1$ with $P_1\cap R=P$ which is a
    permissible center for $J_1$, with $\nu^*(J_1)=\nu^*(J)$ and $J\ne(0)$. Then there are
    $x_0\in Q\smallsetminus P$ with $QR_1=(x_0)R_1$ and $z_1,\dots,z_r\in P$
    $(r=\tau^{(t)}(J))$ such that $z_j/x_0\in P_1$, $(x_0,z_1,\dots,z_r)$ can be extended to a
    regular system of parameters of $R$, $(z_1,\dots,z_r)$ is a regular system of $\tau$-parameters
    of $R$ for $J$, and $(z_1/x_0,\dots,z_r/x_0)$ is a regular system of $\tau$-parameters of
    $R_1$ for $J_1$. (Proof of Proposition~2, pp.~258--259.) -/)
  (proof := /-- (a) Take the coordinates of $R_1$: a minimal base $(x,z_1,\dots,z_t)$ of $Q$ with
    $(x)R_1=QR_1$ and $z_i/x\in M_1$. By Lemma~14 (\cref{lem:III.14}) the initial forms of a
    standard base of $J$ lie in the $(R/M)$-subalgebra generated by the classes $[z_i]$, hence the
    $\tau$-submodules $T_a$ lie in $T=\langle[z_1],\dots,[z_t]\rangle$ (Lemma~11's argument).
    (b) Take a basis $\zeta_1,\dots,\zeta_r$ of $T_t$ adapted to the flag
    $T_1\subseteq\dots\subseteq
    T_t$ ($\zeta_l\in T$); the $k$-linear combinations $z'_l=\sum_i\sigma(a_{li})z_i$ with
    $[z'_l]=\zeta_l$ satisfy $\rho[z'_l/x]=\zeta_l$. (c) By Proposition~1 $\tau^*(J_1)=\tau^*(J)$
    (\cref{prop:III.5-1}), and by the first half of the proof of Lemma~16 (\cref{lem:III.16})
    $\rho(\tilde T_b)=T_b$, with $\rho$ injective on $\tilde T_t$; choose $y_l\in\tilde T_t$ with
    $\rho(y_l)=\zeta_l$. As $\ker\rho\cap\operatorname{gr}^1_{M_1}(R_1)=\langle[x],[y_j]\rangle$,
    there is
    $\ell_l\in M$ with $[z'_l/x+\ell_l]=y_l$; then $(z'_l+x\ell_l)/x$ are regular $\tau$-parameters
    of
    $R_1$ for $J_1$, with $[z'_l+x\ell_l]=\zeta_l$. (d) By Lemma~11 (\cref{lem:III.11}) for
    $(R_1,J_1,P_1)$, $\tilde T_t$ is spanned by classes of elements of $P_1$; let $(q)$ be a minimal
    base of $P$ and $u_q=q/x\in P_1$; as in the proof of \cref{prop:III.5-1}, $U=(u_q)R_1$ is a
    prime ideal containing $P_1$ but not $x$, so these classes are combinations of the $[u_q]$. Put
    $z_l=\sum\tilde c_{lq}q\in P$ and $w_l=\sum\tilde c_{lq}u_q\in P_1$ with $[w_l]=y_l$ and
    $[z_l]=\rho(y_l)=\zeta_l$: the pair $(z_l,w_l)$ differs from $(z'_l+x\ell_l,\,z'_l/x+\ell_l)$ by
    elements of $M^2$ and $M_1^2$.

    \textbf{Gaps in the paper filled.} ``It is then easily seen that \dots a suitable $k$-linear
    transformation'' (b); ``(See the proof of Lemma 16)'' (c); ``(See Lemma 11)'' (d), which does
    not
    by itself give that the $\tau$-parameters of $R_1$ in $P_1$ are the quotients $z_j/x$ of
    elements
    of $P$. -/)
  (latexEnv := "lemma")]
theorem exists_tauParameters_mem_prime
    (σ : R ⧸ maximalIdeal R →+* R) (hσ : ∀ a, Ideal.Quotient.mk (maximalIdeal R) (σ a) = a)
    (J P Q : Ideal R) [P.IsPrime] [Q.IsPrime]
    (hPQ : P ≤ Q) (hJP : J ≤ P) (hQP : Q ≠ P) [IsRegularLocalRing (R ⧸ P)]
    [IsRegularLocalRing (R ⧸ Q)] (hQperm : IsPermissibleCenter R J Q)
    (T : MonoidalTransform R Q) [IsLocalHom T.toRing] [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (P₁ : Ideal T.ring) [P₁.IsPrime] (hP₁ : P₁.comap T.toRing = P)
    (hnu : nuStar T.ring (strictTransformIdeal T J) = nuStar R J)
    (hperm₁ : IsPermissibleCenter T.ring (strictTransformIdeal T J) P₁) (ht0 : 0 < t R J) :
    ∃ (x₀ : R) (z : Fin (tau R J (t R J)) → R) (w : Fin (tau R J (t R J)) → T.ring),
      x₀ ∈ Q ∧ x₀ ∉ P ∧ Q.map T.toRing = Ideal.span {T.toRing x₀} ∧
      (∀ l, z l ∈ P) ∧ (∀ l, T.toRing x₀ * w l = T.toRing (z l)) ∧ (∀ l, w l ∈ P₁) ∧
      Function.Injective z ∧ ExtendsToRSOP R (insert x₀ (Finset.image z Finset.univ)) ∧
      (∃ hz : ∀ l, z l ∈ maximalIdeal R,
        IsRegularSystemOfTauParameters R J (t R J) (fun l => ⟨z l, hz l⟩)) ∧
      ∃ (h : tau T.ring (strictTransformIdeal T J) (t T.ring (strictTransformIdeal T J)) =
          tau R J (t R J)) (hw : ∀ l, w l ∈ maximalIdeal T.ring),
        IsRegularSystemOfTauParameters T.ring (strictTransformIdeal T J)
          (t T.ring (strictTransformIdeal T J)) (fun i => ⟨w (Fin.cast h i), hw _⟩) := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  have hJQ : J ≤ Q := hJP.trans hPQ
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  obtain ⟨hJ₁P₁, hP₁reg, -⟩ : J₁ ≤ P₁ ∧ IsRegularLocalRing (T.ring ⧸ P₁) ∧
      IsNormallyFlatAlongIdeal (P₁.map (Ideal.Quotient.mk J₁)) := by
    rcases hperm₁ with h | ⟨-, h1, h2, h3⟩
    · exact absurd h (Ideal.IsPrime.ne_top inferInstance)
    · exact ⟨h1, h2, h3⟩
  -- (a) the minimal base `(x, z₁, …, z_t)` of `Q`: the coordinates of the transform
  obtain ⟨C⟩ := TransformCoord.nonempty T hrat
  have hx₁P₁ : C.x₁ ∉ P₁ := C.x₁_notMem_of_comap_eq hPQ hQP hP₁
  have hPP₁ : P.map T.toRing ≤ P₁ := by
    rw [Ideal.map_le_iff_le_comap, ← hP₁]
  have hQP₁ : ¬ Q.map T.toRing ≤ P₁ := fun h => hx₁P₁ (h (by
    rw [← C.span_x₁]; exact Ideal.mem_span_singleton_self _))
  have hP₁s : P₁ ≤ strictTransformIdeal T P :=
    le_strictTransformIdeal_of_comap_le T P₁ (le_of_eq hP₁)
  -- Proposition 1: `τ*(J₁) = τ*(J)`
  obtain ⟨ht, htau⟩ := tauStar_strictTransform_eq_of_isResiduallyRational R Q P J hPQ hJP hQperm T
    hrat P₁ hPP₁ hQP₁ hP₁s hnu hperm₁
  have ht₁ : 1 ≤ t T.ring J₁ := ht ▸ ht0
  -- Lemma 14: the `τ`-submodules `T_a` lie in `⟨[z₁], …, [z_t]⟩`
  have hTa : ∀ a, 1 ≤ a → a ≤ t R J →
      tauSubmodule R J a ≤ Submodule.span (R ⧸ maximalIdeal R) (Set.range C.classX) :=
    fun a ha hat => C.tauSubmodule_le_span_classX hrat J hJQ hQperm hnu a ha hat
  -- the flag `T₁ ⊆ … ⊆ T_t` of `τ`-submodules of `J` and an adapted basis `ζ`
  have hfin : ∀ a, FiniteDimensional (R ⧸ maximalIdeal R) (tauSubmodule R J a) := fun a =>
    finiteDimensional_tauSubmodule J a
  obtain ⟨ζ, hζ⟩ := exists_flag_family_of_monotone
    (fun b => tauSubmodule R J (min (b + 1) (t R J)))
    (fun b b' hbb' => tauSubmodule_mono_of_le J (by omega) (by omega) (by omega))
    (fun b => hfin _) (t R J - 1)
  have hζa : ∀ a, 1 ≤ a → a ≤ t R J → Submodule.span (R ⧸ maximalIdeal R)
      (ζ '' Set.Iio (tau R J a)) = tauSubmodule R J a := by
    intro a ha hat
    have h := hζ (a - 1) (by omega)
    rw [show min (a - 1 + 1) (t R J) = a by omega,
      (tauSubmodule_spec R J a ha hat).2.1] at h
    exact h
  have hζT : ∀ n, n < tau R J (t R J) → ζ n ∈ tauSubmodule R J (t R J) := by
    intro n hn
    rw [← hζa (t R J) ht0 le_rfl]
    exact Submodule.subset_span ⟨n, hn, rfl⟩
  have hτb : ∀ b, 1 ≤ b → b ≤ t R J → tau R J b ≤ tau R J (t R J) := by
    intro b hb hbt
    rw [← (tauSubmodule_spec R J b hb hbt).2.1, ← (tauSubmodule_spec R J _ ht0 le_rfl).2.1]
    have := hfin (t R J)
    exact Submodule.finrank_mono (tauSubmodule_mono_of_le J hb hbt le_rfl)
  -- the `T_b` as spans of the subtype-indexed families `ζ_l`
  have hTb : ∀ b, 1 ≤ b → b ≤ t R J → Submodule.span (R ⧸ maximalIdeal R)
      (Set.range fun l : {l : Fin (tau R J (t R J)) // (l : ℕ) < tau R J b} => ζ l.1) =
        tauSubmodule R J b := by
    intro b hb hbt
    rw [← hζa b hb hbt]
    congr 1
    ext x
    constructor
    · rintro ⟨⟨l, hl⟩, rfl⟩
      exact ⟨l, hl, rfl⟩
    · rintro ⟨n, hn, rfl⟩
      exact ⟨⟨⟨n, lt_of_lt_of_le hn (hτb b hb hbt)⟩, hn⟩, rfl⟩
  have hζli : LinearIndependent (R ⧸ maximalIdeal R) (fun l : Fin (tau R J (t R J)) => ζ l) := by
    rw [linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin]
    have : Set.range (fun l : Fin (tau R J (t R J)) => ζ l) = ζ '' Set.Iio (tau R J (t R J)) := by
      ext x
      constructor
      · rintro ⟨l, rfl⟩
        exact ⟨l, l.2, rfl⟩
      · rintro ⟨n, hn, rfl⟩
        exact ⟨⟨n, hn⟩, rfl⟩
    rw [Set.finrank, this, hζa (t R J) ht0 le_rfl, (tauSubmodule_spec R J _ ht0 le_rfl).2.1]
  have hζX : ∀ l : Fin (tau R J (t R J)),
      ζ l ∈ Submodule.span (R ⧸ maximalIdeal R) (Set.range C.classX) := fun l =>
    hTa _ ht0 le_rfl (hζT l l.2)
  -- (b) the `k`-linear transformation: `z^b_l = Σ_i σ(a_{li}) z_i`, with `[z^b_l] = ζ_l`
  obtain ⟨-, zb, wb, -, -, hbzw, hzb, hwb, hbzcls, hbwρ⟩ :=
    C.exists_kLinear_quotientPair σ hσ hrat (fun l : Fin (tau R J (t R J)) => ζ l) hζX
  -- (c) the proof of Lemma 16: `ρ(T̃_b) = T_b`, `ρ` injective on `T̃_b`
  have hρT := fun b (hb : 1 ≤ b) (hbt : b ≤ t R J) =>
    TransformCoord.rho_tauSubmodule hrat C J hJQ hQperm hnu htau b hb hbt
  have hy : ∀ l : Fin (tau R J (t R J)), ∃ y ∈ tauSubmodule T.ring J₁ (t R J),
      C.ρ hrat y = ζ l := fun l => (hρT _ ht0 le_rfl).2.1 _ (hζT l l.2)
  choose y hyT hyρ using hy
  have hy1 : ∀ l, y l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := fun l =>
    (tauSubmodule_spec T.ring J₁ (t R J) ht0 ht.ge).1.1 (hyT l)
  -- the adjustments `z^c_l = z^b_l + x ℓ_l`, `w^c_l = w^b_l + ℓ_l`, `[w^c_l] = y_l`
  have hc : ∀ l, ∃ ℓ ∈ maximalIdeal R, ∃ hw' : wb l + T.toRing ℓ ∈ maximalIdeal T.ring ^ 1,
      AssocGraded.mk (maximalIdeal T.ring) 1 (wb l + T.toRing ℓ) hw' = y l := fun l =>
    C.exists_adjust_quotient σ hσ hrat (hwb l) (hy1 l) (by rw [hyρ l, hbwρ l])
  choose ℓ hℓM hwc hwccls using hc
  have hx₀M : C.x₀ ∈ maximalIdeal R := by
    have := C.z_mem none
    rwa [pow_one] at this
  have hxℓ : ∀ l, C.x₀ * ℓ l ∈ maximalIdeal R ^ (1 + 1) := fun l => by
    rw [pow_add, pow_one]
    exact Ideal.mul_mem_mul hx₀M (hℓM l)
  have hzc : ∀ l, zb l + C.x₀ * ℓ l ∈ maximalIdeal R ^ 1 := fun l =>
    add_mem (hzb l) (by rw [pow_one]; exact Ideal.mul_mem_right _ _ hx₀M)
  have hzcw : ∀ l, C.x₁ * (wb l + T.toRing (ℓ l)) = T.toRing (zb l + C.x₀ * ℓ l) := fun l => by
    rw [mul_add, hbzw l, map_add, map_mul]
    rfl
  have hzccls : ∀ l, AssocGraded.mk (maximalIdeal R) 1 (zb l + C.x₀ * ℓ l) (hzc l) = ζ l := by
    intro l
    rw [← hbzcls l]
    refine AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ _ _ ?_
    rw [add_sub_cancel_left]
    exact hxℓ l
  have hρc : ∀ l, C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 (wb l + T.toRing (ℓ l))
      (hwc l)) = AssocGraded.mk (maximalIdeal R) 1 (zb l + C.x₀ * ℓ l) (hzc l) := by
    intro l
    rw [hwccls l, hyρ l, hzccls l]
  -- (d) Lemma 11 and `P₁ ⊆ (q/x)R₁`: a minimal base `TQ` of `P` and the quotients `q/x`
  obtain ⟨S₀, TQ, hS₀M, hS₀card, hTS, hTQ⟩ := exists_finset_span_eq_prime R P inferInstance
  have hS₀ : IsRegularSystemOfParameters R S₀ := rsop_of_span_of_card_le hS₀M hS₀card.le
  have hqP : ∀ q : TQ, (q : R) ∈ P := fun q => hTQ ▸ Ideal.subset_span q.2
  have hqM : ∀ q : TQ, Ideal.ordElem (maximalIdeal R) (q : R) = 1 := by
    intro q
    have hq1 : (q : R) ∈ maximalIdeal R ^ 1 := by
      rw [pow_one, ← hS₀M]; exact Ideal.subset_span (hTS q.2)
    have hq2 : (q : R) ∉ maximalIdeal R ^ (1 + 1) :=
      (ExtendsToRSOP.of_isRegularSystemOfParameters hS₀).notMem_maximalIdeal_sq (hTS q.2)
    exact le_antisymm (by exact_mod_cast Ideal.ordElem_le_of_notMem hq2)
      (by exact_mod_cast Ideal.le_ordElem hq1)
  have hq1 : ∀ q : TQ, (q : R) ∈ maximalIdeal R ^ 1 := fun q => by
    rw [pow_one]; exact le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance) (hqP q)
  have hu : ∀ q : TQ, ∃ u ∈ P₁, C.x₁ * u = T.toRing q := fun q =>
    C.exists_quotient_mem hPQ hQP hP₁ (hqP q)
  choose u huP₁ hxu using hu
  have hu1 : ∀ q, u q ∈ maximalIdeal T.ring ^ 1 := fun q => by
    rw [pow_one]; exact le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance) (huP₁ q)
  have hord := fun q => C.ordElem_quotient_eq_one hrat (hqM q)
    (by simpa [pow_one] using hu1 q) (hxu q)
  have hρu : ∀ q : TQ, C.ρ hrat (AssocGraded.mk (maximalIdeal T.ring) 1 (u q) (hu1 q)) =
      AssocGraded.mk (maximalIdeal R) 1 (q : R) (hq1 q) := by
    intro q
    have h1 : AssocGraded.mk (maximalIdeal T.ring) 1 (u q) (hu1 q) =
        initialForm (maximalIdeal T.ring) (u q) := (initialForm_eq_mk _ (hord q).1).symm
    rw [h1, (hord q).2, initialForm_eq_mk _ (hqM q)]
  obtain ⟨hliQ, hliX⟩ := C.linearIndependent_quotients hrat hS₀ hTS u hu1 (fun q => (hord q).1)
    (fun q => (hord q).2) hqM
  obtain ⟨hUprime, hx₁U, hP₁U⟩ := C.prime_span_quotients_and_le hTQ hP₁ u hxu hu1 hliX
  -- Lemma 11: `T̃_t ⊆ ⟨[q/x]⟩`
  have hTW : tauSubmodule T.ring J₁ (t R J) ≤ Submodule.span (T.ring ⧸ maximalIdeal T.ring)
      (Set.range fun q : TQ => AssocGraded.mk (maximalIdeal T.ring) 1 (u q) (hu1 q)) := by
    rw [← ht]
    exact tauSubmodule_top_le_span_of_le_span J₁ P₁ hJ₁P₁ hP₁reg hperm₁ u hu1 hP₁U ht₁
  -- the adjustment `(z_l, w_l)` of `(z^c_l, w^c_l)` with `z_l ∈ P` and `w_l = z_l/x ∈ P₁`
  have hd : ∀ l, ∃ (z : R) (w : T.ring), z ∈ P ∧ w ∈ P₁ ∧ C.x₁ * w = T.toRing z ∧
      z - (zb l + C.x₀ * ℓ l) ∈ maximalIdeal R ^ (1 + 1) ∧
      w - (wb l + T.toRing (ℓ l)) ∈ maximalIdeal T.ring ^ (1 + 1) := fun l =>
    C.exists_adjust_quotientPair_mem_prime σ hσ hrat (fun q : TQ => (q : R)) u hqP huP₁ hxu hq1
      hu1 hρu (hzc l) (hwc l) (hρc l) (by rw [hwccls l]; exact hTW (hyT l))
  choose z w hzP hwP₁ hzw hzcl hwcl using hd
  have hzM : ∀ l, z l ∈ maximalIdeal R ^ 1 := fun l => by
    rw [pow_one]; exact le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance) (hzP l)
  have hwM : ∀ l, w l ∈ maximalIdeal T.ring ^ 1 := fun l => by
    rw [pow_one]; exact le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance) (hwP₁ l)
  have hzclass : ∀ l, AssocGraded.mk (maximalIdeal R) 1 (z l) (hzM l) = ζ l := fun l =>
    (AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ (hzM l) (hzc l) (hzcl l)).trans (hzccls l)
  have hwclass : ∀ l, AssocGraded.mk (maximalIdeal T.ring) 1 (w l) (hwM l) = y l := fun l =>
    (AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ (hwM l) (hwc l) (hwcl l)).trans (hwccls l)
  -- the classes of `T̃_b` and of the `y_l`
  have hunique : ∀ b, 1 ≤ b → b ≤ t R J → ∀ (l : Fin (tau R J (t R J))),
      (l : ℕ) < tau R J b → y l ∈ tauSubmodule T.ring J₁ b := by
    intro b hb hbt l hl
    have hζl : ζ l ∈ tauSubmodule R J b := by
      rw [← hTb b hb hbt]
      exact Submodule.subset_span ⟨⟨l, hl⟩, rfl⟩
    obtain ⟨y', hy'T, hy'ρ⟩ := (hρT b hb hbt).2.1 _ hζl
    have hy'T' : y' ∈ tauSubmodule T.ring J₁ (t R J) :=
      tauSubmodule_mono_of_le J₁ hb hbt ht.ge hy'T
    have : y l - y' = 0 := (hρT _ ht0 le_rfl).2.2 _ (sub_mem (hyT l) hy'T') (by
      rw [map_sub, hyρ, hy'ρ, sub_self])
    rw [sub_eq_zero.mp this]
    exact hy'T
  have hkey : ∀ b, 1 ≤ b → b ≤ t R J → Submodule.span (T.ring ⧸ maximalIdeal T.ring)
      (Set.range fun l : {l : Fin (tau R J (t R J)) // (l : ℕ) < tau R J b} => y l.1) =
        tauSubmodule T.ring J₁ b := by
    intro b hb hbt
    refine le_antisymm (Submodule.span_le.mpr ?_) fun yt hyt => ?_
    · rintro _ ⟨⟨l, hl⟩, rfl⟩
      exact hunique b hb hbt l hl
    · have hyt' : yt ∈ tauSubmodule T.ring J₁ (t R J) :=
        tauSubmodule_mono_of_le J₁ hb hbt ht.ge hyt
      obtain ⟨a', ha'⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp
        ((hTb b hb hbt).symm ▸ (hρT b hb hbt).1 yt hyt)
      have hsub : yt - ∑ l, (T.residueEquiv hrat) (a' l) • y l.1 = 0 := by
        refine (hρT _ ht0 le_rfl).2.2 _ (sub_mem hyt' (Submodule.sum_mem _ fun l _ =>
          Submodule.smul_mem _ _ (hyT _))) ?_
        rw [map_sub, map_sum]
        simp only [TransformCoord.ρ_smul, RingEquiv.symm_apply_apply, hyρ]
        rw [ha', sub_self]
      rw [sub_eq_zero.mp hsub]
      exact Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _
        (Submodule.subset_span ⟨l, rfl⟩)
  -- arity: `τ(J₁) = τ(J)`
  have hr : tau T.ring J₁ (t T.ring J₁) = tau R J (t R J) := by
    rw [ht]; exact htau _ ht0 le_rfl
  have hx₀P : C.x₀ ∉ P := fun h => hx₁P₁ (by
    show T.toRing C.x₀ ∈ P₁
    rw [← Ideal.mem_comap, hP₁]; exact h)
  have hzinj : Function.Injective z := by
    intro l l' h
    refine hζli.injective ?_
    show ζ l = ζ l'
    rw [← hzclass l, ← hzclass l']
    exact AssocGraded.mk_congr _ (hzM l) h
  -- `(x₀, z_1, …, z_r)` extends to a regular system of parameters: the classes `[x₀], ζ_1, …, ζ_r`
  -- are linearly independent
  have hx₀M1 : C.x₀ ∈ maximalIdeal R ^ 1 := C.z_mem none
  have hx₀cls : AssocGraded.mk (maximalIdeal R) 1 C.x₀ hx₀M1 ∉
      Submodule.span (R ⧸ maximalIdeal R) (Set.range fun l : Fin (tau R J (t R J)) => ζ l) :=
    fun hmem => C.mk_x₀_notMem_span_classX
      (Submodule.span_le.mpr (by rintro _ ⟨l, rfl⟩; exact hζX l) hmem)
  have hx₀li : LinearIndependent (R ⧸ maximalIdeal R) (fun o : Option (Fin (tau R J (t R J))) =>
      Option.casesOn' o (AssocGraded.mk (maximalIdeal R) 1 C.x₀ hx₀M1) (fun l => ζ l)) :=
    hζli.option hx₀cls
  let z' : Option (Fin (tau R J (t R J))) → maximalIdeal R := fun o =>
    Option.casesOn' o ⟨C.x₀, by simpa using hx₀M1⟩ (fun l => ⟨z l, by simpa using hzM l⟩)
  have hext := extendsToRSOP_of_linearIndependent z' (by
    convert hx₀li using 1
    funext o
    rcases o with _ | l
    · rfl
    · exact hzclass l)
  have hzmax : ∀ l, z l ∈ maximalIdeal R := fun l => by simpa using hzM l
  have hwmax : ∀ l, w l ∈ maximalIdeal T.ring := fun l => by simpa using hwM l
  refine ⟨C.x₀, z, w, C.x₀_mem, hx₀P, C.span_x₁.symm, hzP, ?_, hwP₁, hzinj, ?_, ⟨hzmax, ?_⟩,
    hr, hwmax, ?_⟩
  · intro l
    exact hzw l
  · convert hext using 1
    ext x
    simp only [Finset.mem_insert, Finset.mem_image, Finset.mem_univ, true_and, z']
    constructor
    · rintro (rfl | ⟨l, rfl⟩)
      · exact ⟨none, rfl⟩
      · exact ⟨some l, rfl⟩
    · rintro ⟨o, rfl⟩
      rcases o with _ | l
      · exact Or.inl rfl
      · exact Or.inr ⟨l, rfl⟩
  · -- the `τ`-parameters of `R`
    exact isRegularSystemOfTauParameters_of_mk_eq J rfl z hzmax (fun l => ζ l) hTb hzclass
  · -- the `τ`-parameters of `R₁`
    refine isRegularSystemOfTauParameters_of_mk_eq J₁ hr w hwmax y ?_ hwclass
    intro b hb hbt₁
    have hbt : b ≤ t R J := ht ▸ hbt₁
    have hb₁ : tau T.ring J₁ b = tau R J b := htau b hb hbt
    have := hkey b hb hbt
    rwa [← hb₁] at this

end TauParametersInPrime

end Hironaka

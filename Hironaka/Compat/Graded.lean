/-!
# Associated graded pieces (Ch. II §1, p. 180)

> Let A be a noetherian ring and I an ideal in A. Then we associate with I the following graded
> A/I-algebra of finite type: gr_I(A) = ⊕_{m≥0} I^m/I^{m+1}. The homogeneous part of degree m
> of gr_I(A) is the A/I-module of finite type I^m/I^{m+1} and will be denoted by gr^m_I(A).
> If M is an A-module, then we associate the following graded gr_I(A)-module:
> gr_I(M) = ⊕_{m≥0} I^m M/I^{m+1} M.  (p. 180)

This file provides the homogeneous pieces `GrPiece I m = Iᵐ/Iᵐ⁺¹` as `A/I`-modules, which is
all that Definition 1 of Ch. 0 (normal flatness) and the Hilbert–Samuel function of Ch. 0 §4
need.  The further constructions of Ch. II (the graded algebra itself, `gr_I(M)`, initial
forms, `gr_I(J, A)`) are added below in the order in which the paper introduces them.

## Encoding of the graded algebra `gr_I(A)`

The paper's `gr_I(A) = ⊕_{m≥0} Iᵐ/Iᵐ⁺¹` is realised as an honest commutative ring via Mathlib's
Rees algebra: `reesAlgebra I ⊆ A[X]` is the subalgebra `⊕_{m≥0} Iᵐ Xᵐ` of polynomials whose
`m`-th coefficient lies in `Iᵐ`, and we set

  `AssocGraded I := reesAlgebra I ⧸ I · reesAlgebra I`.

The ideal `I · reesAlgebra I` is `⊕_{m≥0} Iᵐ⁺¹ Xᵐ` (Mathlib: `mem_map_algebraMap_reesAlgebra_iff`),
so the quotient is `⊕_{m≥0} (Iᵐ/Iᵐ⁺¹) Xᵐ`, i.e. exactly `gr_I(A)` with its ring structure
(`[a Xᵐ]·[b Xⁿ] = [ab Xᵐ⁺ⁿ]`, the usual multiplication on the associated graded ring) and its
`A/I`-algebra structure (the coefficient `I` of degree `0` acts by `0`).  The homogeneous part
`grⁿ_I(A)` is the image of the classes of the monomials `a Xⁿ`, `a ∈ Iⁿ`; it is `A/I`-linearly
isomorphic to `GrPiece I n = Iⁿ/Iⁿ⁺¹` (`AssocGraded.homogeneous_equiv_grPiece`).  The initial form
of `f` with `ν_I(f) = ν < ∞` is the class of `f Xᵛ`.
-/

@[expose] public section

namespace Hironaka

universe u

section Pieces

variable {O : Type u} [CommRing O]




/-- The `O/P`-module structure on `Pᵖ/Pᵖ⁺¹` is compatible with the `O`-module structure:
`(a mod P) • x = a • x`. -/
instance GrPiece.isScalarTower (P : Ideal O) (p : ℕ) :
    IsScalarTower O (O ⧸ P) (GrPiece P p) :=
  IsScalarTower.of_algebraMap_smul fun _ _ => rfl

/-- For noetherian `O`, `Pᵖ/Pᵖ⁺¹` is a finitely generated `O`-module (`Pᵖ` is finitely
generated, and finiteness passes to quotients). -/
instance GrPiece.finite [IsNoetherianRing O] (P : Ideal O) (p : ℕ) :
    Module.Finite O (GrPiece P p) :=
  inferInstance

/-- For noetherian `O`, `Pᵖ/Pᵖ⁺¹` is a finitely generated `O/P`-module (p. 180: "the
`A/I`-module of finite type `Iᵐ/Iᵐ⁺¹`"). -/
instance GrPiece.finite_quotient [IsNoetherianRing O] (P : Ideal O) (p : ℕ) :
    Module.Finite (O ⧸ P) (GrPiece P p) :=
  Module.Finite.of_restrictScalars_finite O (O ⧸ P) (GrPiece P p)

end Pieces

/-! ## The associated graded algebra `gr_I(A)` (Ch. II §1, p. 180) -/

noncomputable section GradedAlgebra

open Polynomial

variable {A : Type u} [CommRing A]

/-- The associated graded algebra `gr_I(A) = ⊕_{m≥0} Iᵐ/Iᵐ⁺¹` (p. 180: "Let A be a noetherian ring
and I an ideal in A. Then we associate with I the following graded A/I-algebra of finite type:
gr_I(A) = Σ_{m≥0} Iᵐ/Iᵐ⁺¹").

Encoding: the quotient of the Rees algebra `reesAlgebra I = ⊕ Iᵐ Xᵐ ⊆ A[X]` by the ideal
generated by `I` (in degree `0`), which is `⊕ Iᵐ⁺¹ Xᵐ`; see the module docstring. -/
@[blueprint "def:II.1-associated-graded-algebra"
  (statement := /-- Let $A$ be a noetherian ring and $I$ an ideal in $A$. The \emph{associated
    graded algebra} of $I$ is the graded $A/I$-algebra of finite type
    $\operatorname{gr}_I(A)=\sum_{m\ge0}I^m/I^{m+1}$; its homogeneous part of degree $m$ is the
    $A/I$-module of finite type $I^m/I^{m+1}$, denoted $\operatorname{gr}^m_I(A)$. (p.~180.)
    Formalised as the quotient of the Rees algebra $\bigoplus_m I^mX^m\subseteq A[X]$ by the
    ideal $I\cdot\bigoplus_m I^mX^m=\bigoplus_m I^{m+1}X^m$. -/)
  (latexEnv := "definition")]
def AssocGraded (I : Ideal A) : Type u :=
  reesAlgebra I ⧸ Ideal.map (algebraMap A (reesAlgebra I)) I

namespace AssocGraded

variable (I : Ideal A)

instance instCommRing : CommRing (AssocGraded I) :=
  inferInstanceAs (CommRing (reesAlgebra I ⧸ Ideal.map (algebraMap A (reesAlgebra I)) I))

/-- `gr_I(A)` is an `R`-algebra for every ring `R` over which `A` is an algebra (in particular an
`A`-algebra), via `R → A → reesAlgebra I → gr_I(A)`. -/
instance instAlgebra {R : Type*} [CommSemiring R] [Algebra R A] : Algebra R (AssocGraded I) :=
  inferInstanceAs (Algebra R (reesAlgebra I ⧸ Ideal.map (algebraMap A (reesAlgebra I)) I))

instance instIsScalarTower {R : Type*} [CommSemiring R] [Algebra R A] :
    IsScalarTower R A (AssocGraded I) :=
  inferInstanceAs (IsScalarTower R A (reesAlgebra I ⧸ Ideal.map (algebraMap A (reesAlgebra I)) I))

theorem algebraMap_apply (a : A) :
    algebraMap A (AssocGraded I) a = Ideal.Quotient.mk _ (algebraMap A (reesAlgebra I) a) := rfl

/-- The structure map `A/I → gr_I(A)`: `A → gr_I(A)` kills `I` (which is the degree-`0` part of
the ideal we quotient by), so it factors through `A/I`. -/
def algebraMapQuot : A ⧸ I →+* AssocGraded I :=
  Ideal.Quotient.lift I (algebraMap A (AssocGraded I)) fun a ha => by
    rw [algebraMap_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)

/-- `gr_I(A)` is an `A/I`-algebra (p. 180: "graded A/I-algebra"). -/
instance instAlgebraQuotient : Algebra (A ⧸ I) (AssocGraded I) := (algebraMapQuot I).toAlgebra

/-- The `A/I`-algebra structure on `gr_I(A)` is compatible with the `A`-algebra structure. -/
instance instIsScalarTowerQuotient : IsScalarTower A (A ⧸ I) (AssocGraded I) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

/-- The class in `gr_I(A)` of the monomial `a Xⁿ` with `a ∈ Iⁿ`: the image of `a` in
`grⁿ_I(A) = Iⁿ/Iⁿ⁺¹`. -/
def mk (n : ℕ) (a : A) (ha : a ∈ I ^ n) : AssocGraded I :=
  Ideal.Quotient.mk _ ⟨monomial n a, reesAlgebra.monomial_mem.mpr ha⟩

/-- The class of `a Xⁿ` (`a ∈ Iⁿ`) vanishes in `gr_I(A)` iff `a ∈ Iⁿ⁺¹`: the degree-`n` part of
`gr_I(A)` is `Iⁿ/Iⁿ⁺¹`. -/
theorem mk_eq_zero_iff {n : ℕ} {a : A} (ha : a ∈ I ^ n) : mk I n a ha = 0 ↔ a ∈ I ^ (n + 1) := by
  refine (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.map (algebraMap A (reesAlgebra I)) I)).trans ?_
  rw [mem_map_algebraMap_reesAlgebra_iff]
  constructor
  · intro h
    simpa using h n
  · intro h m
    simp only [coeff_monomial]
    split_ifs with hm
    · subst hm; exact h
    · exact zero_mem _

/-- `a ↦ a Xⁿ` as an `A`-linear map `Iⁿ → reesAlgebra I`. -/
def monomialLinear (n : ℕ) : ↥(I ^ n) →ₗ[A] reesAlgebra I where
  toFun a := ⟨monomial n a, reesAlgebra.monomial_mem.mpr a.2⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' r x := Subtype.ext (by simp [Polynomial.smul_monomial])

/-- `a ↦ [a Xⁿ]` is `A`-linear on `Iⁿ`. -/
def mkLinear (n : ℕ) : ↥(I ^ n) →ₗ[A] AssocGraded I :=
  (Ideal.Quotient.mkₐ A (Ideal.map (algebraMap A (reesAlgebra I)) I)).toLinearMap.comp
    (monomialLinear I n)

theorem mkLinear_apply (n : ℕ) (a : ↥(I ^ n)) : mkLinear I n a = mk I n a a.2 := rfl

/-- The canonical `A/I`-linear map `Iⁿ/Iⁿ⁺¹ → gr_I(A)`, `[a] ↦ [a Xⁿ]`. -/
def ofGrPiece (n : ℕ) : GrPiece I n →ₗ[A ⧸ I] AssocGraded I :=
  LinearMap.extendScalarsOfSurjective (Ideal.Quotient.mk_surjective (I := I))
    (Submodule.liftQ _ (mkLinear I n) fun x hx =>
      LinearMap.mem_ker.mpr ((mk_eq_zero_iff I x.2).mpr hx))

@[simp]
theorem ofGrPiece_mk (n : ℕ) (a : ↥(I ^ n)) :
    ofGrPiece I n (Submodule.Quotient.mk a) = mk I n a a.2 := rfl

/-- The homogeneous part of degree `n` of `gr_I(A)` (p. 180: "The homogeneous part of degree m of
gr_I(A) is the A/I-module of finite type Iᵐ/Iᵐ⁺¹ and will be denoted by grᵐ_I(A)"): the
`A/I`-submodule of `gr_I(A)` consisting of the classes of the monomials `a Xⁿ`, `a ∈ Iⁿ`, i.e.
the image of `Iⁿ/Iⁿ⁺¹ → gr_I(A)`. -/
def homogeneous (n : ℕ) : Submodule (A ⧸ I) (AssocGraded I) := LinearMap.range (ofGrPiece I n)

theorem mk_mem_homogeneous {n : ℕ} {a : A} (ha : a ∈ I ^ n) : mk I n a ha ∈ homogeneous I n :=
  LinearMap.mem_range.mpr ⟨Submodule.Quotient.mk ⟨a, ha⟩, rfl⟩

theorem ofGrPiece_injective (n : ℕ) : Function.Injective (ofGrPiece I n) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro m hm
  induction m using Submodule.Quotient.induction_on with
  | H x =>
    rw [Submodule.Quotient.mk_eq_zero]
    exact (mk_eq_zero_iff I x.2).mp hm

/-- `grⁿ_I(A) ≅ Iⁿ/Iⁿ⁺¹` as `A/I`-modules: the homogeneous part of degree `n` of the Rees-algebra
model of `gr_I(A)` is the `n`-th graded piece `GrPiece I n`. -/
theorem homogeneous_equiv_grPiece (n : ℕ) :
    Nonempty (GrPiece I n ≃ₗ[A ⧸ I] homogeneous I n) :=
  ⟨LinearEquiv.ofInjective _ (ofGrPiece_injective I n)⟩

end AssocGraded

/-! ## Orders of elements, initial forms and `gr_I(J, A)` (Ch. II §2, p. 189) -/

/-- The order `ν_I(f)` of an element (p. 189: "For each element f ∈ A, we define the symbol ν_I(f)
as follows: ν_I(f) is the largest integer ν ≥ 0 such that f ∈ Iᵛ, if it exists, and ν_I(f) = ∞ if
f ∈ Iᵛ for all positive integers ν"), as the supremum in `ℕ∞` of the exponents `ν` with
`f ∈ Iᵛ`. -/
@[blueprint "def:II.2-order-element"
  (statement := /-- Let $A$ be a noetherian ring and $I\ne A$ an ideal. For $f\in A$, $\nu_I(f)$
    is the largest integer $\nu\ge0$ with $f\in I^\nu$ if it exists, and $\nu_I(f)=\infty$ if
    $f\in I^\nu$ for all $\nu$. (p.~189.) -/)
  (latexEnv := "definition")]
noncomputable def Ideal.ordElem (I : Ideal A) (f : A) : ℕ∞ :=
  ⨆ (ν : ℕ) (_ : f ∈ I ^ ν), (ν : ℕ∞)

/-- `ν ≤ ν_I(f)` as soon as `f ∈ Iᵛ`. -/
theorem Ideal.le_ordElem {I : Ideal A} {f : A} {ν : ℕ} (h : f ∈ I ^ ν) :
    (ν : ℕ∞) ≤ Ideal.ordElem I f :=
  le_iSup₂ (f := fun (ν : ℕ) (_ : f ∈ I ^ ν) => (ν : ℕ∞)) ν h

/-- `ν_I(f) ≤ a` as soon as every exponent `ν` with `f ∈ Iᵛ` satisfies `ν ≤ a`. -/
theorem Ideal.ordElem_le {I : Ideal A} {f : A} {a : ℕ∞}
    (h : ∀ ν : ℕ, f ∈ I ^ ν → (ν : ℕ∞) ≤ a) : Ideal.ordElem I f ≤ a :=
  iSup₂_le h

/-- If `f ∉ Iᵐ⁺¹` then `ν_I(f) ≤ m` (the set of exponents `ν` with `f ∈ Iᵛ` is downward closed
since `Iᵛ ⊆ Iᵐ⁺¹` for `ν ≥ m + 1`). -/
theorem Ideal.ordElem_le_of_notMem {I : Ideal A} {f : A} {m : ℕ} (h : f ∉ I ^ (m + 1)) :
    Ideal.ordElem I f ≤ m :=
  Ideal.ordElem_le fun ν hν => by
    by_contra hlt
    rw [not_le, Nat.cast_lt] at hlt
    exact h (Ideal.pow_le_pow_right (Nat.succ_le_of_lt hlt) hν)

/-- The supremum defining `ν_I(f)` is attained: if `ν_I(f) = ν < ∞` then `f ∈ Iᵛ`. -/
theorem Ideal.mem_pow_of_ordElem {I : Ideal A} {f : A} {ν : ℕ} (h : Ideal.ordElem I f = ν) :
    f ∈ I ^ ν := by
  cases ν with
  | zero => simp
  | succ m =>
    by_contra hf
    have := Ideal.ordElem_le_of_notMem hf
    rw [h, Nat.cast_le] at this
    omega

/-- `ν_I(f) = ∞` iff `f ∈ Iᵛ` for all `ν`. -/
theorem Ideal.ordElem_eq_top_iff {I : Ideal A} {f : A} :
    Ideal.ordElem I f = ⊤ ↔ ∀ ν : ℕ, f ∈ I ^ ν := by
  constructor
  · intro h ν
    by_contra hf
    cases ν with
    | zero => exact hf (by simp)
    | succ m =>
      have := Ideal.ordElem_le_of_notMem hf
      rw [h, top_le_iff] at this
      exact ENat.natCast_ne_top m this
  · intro h
    exact ENat.eq_top_iff_forall_ge.mpr fun m => Ideal.le_ordElem (h m)

/-- p. 189: "If A is a local ring, then ν_I(f) = ∞ implies that f = 0" (for `I ≠ A`; Krull's
intersection theorem for noetherian local rings). -/
theorem Ideal.ordElem_eq_top_iff_eq_zero [IsLocalRing A] [IsNoetherianRing A] {I : Ideal A}
    (hI : I ≠ ⊤) {f : A} : Ideal.ordElem I f = ⊤ ↔ f = 0 := by
  rw [Ideal.ordElem_eq_top_iff, ← Ideal.mem_bot, ← Ideal.iInf_pow_eq_bot_of_isLocalRing I hI,
    Ideal.mem_iInf]

/-- The initial form of `f` in `gr_I(A)` (p. 189: "If ν = ν_I(f) is a non-negative integer, then
the class of f in Iᵛ/Iᵛ⁺¹ will be called the initial form of f in gr_I(A). For the sake of
convenience, we define the initial form of f with ν_I(f) = ∞ to be the zero element of
gr_I(A)"). -/
@[blueprint "def:II.2-initial-form"
  (statement := /-- If $\nu=\nu_I(f)$ is a non-negative integer, the class of $f$ in
    $I^\nu/I^{\nu+1}$ is called the \emph{initial form} of $f$ in $\operatorname{gr}_I(A)$; if
    $\nu_I(f)=\infty$ the initial form of $f$ is defined to be $0$. (p.~189.) -/)
  (latexEnv := "definition")]
noncomputable def initialForm (I : Ideal A) (f : A) : AssocGraded I :=
  if h : Ideal.ordElem I f = ⊤ then 0
  else AssocGraded.mk I (Ideal.ordElem I f).toNat f
    (Ideal.mem_pow_of_ordElem (ENat.natCast_toNat h).symm)

/-- The graded ideal `gr_I(J, A)` (p. 189: "If J is an ideal in A, then we shall denote by
gr_I(J, A) the graded ideal in gr_I(A) generated by the initial forms of elements of J"). -/
@[blueprint "def:II.2-graded-ideal"
  (statement := /-- For an ideal $J$ of $A$, $\operatorname{gr}_I(J,A)$ is the graded ideal of
    $\operatorname{gr}_I(A)$ generated by the initial forms of the elements of $J$. One has
    $\operatorname{gr}_I(J,A)=\sum_n((J\cap I^n)+I^{n+1})/I^{n+1}$, and
    $\operatorname{gr}^n_I(J,A)$ denotes the homogeneous part of degree $n$. (p.~189.)

    \textbf{Gap in the paper filled.} The paper asserts the displayed identity (``We can
    write''). The formalization proves it as one identity (\cref{lem:II.2-graded-ideal-sum}),
    and in its homogeneous form: a homogeneous element of degree $n$ lies in
    $\operatorname{gr}_I(J,A)$ iff it is the class of an element of $J\cap I^n$. -/)
  (latexEnv := "definition")]
noncomputable def grIdeal (I J : Ideal A) : Ideal (AssocGraded I) :=
  Ideal.span (initialForm I '' (J : Set A))

/-! ### Auxiliary: the degree-`n` projections `gr_I(A) → Iⁿ/Iⁿ⁺¹` and the graded decomposition. -/

/-! ### Degree components of `gr_I(A)`

Public API for working with homogeneous components: `grProj I n` is the projection of `gr_I(A)`
onto its degree-`n` part `Iⁿ/Iⁿ⁺¹` (`GrPiece`), `mk_eq_sum_mk` writes an element as the sum of
its homogeneous components, `toGr I` is the isomorphism `⊕ₙ Iⁿ/Iⁿ⁺¹ ≅ gr_I(A)`
(`toGr_bijective`), and `initialForm_eq_mk`, `mk_mem_grIdeal` relate initial forms, the classes
`AssocGraded.mk`, and the graded ideal `gr_I(J, A)`. -/

section GrProj

variable (I : Ideal A)

/-- The `n`-th coefficient `p ↦ (coeff p n : Iⁿ)` of an element of the Rees algebra, `A`-linearly. -/
def reesCoeff (n : ℕ) : reesAlgebra I →ₗ[A] ↥(I ^ n) where
  toFun p := ⟨(p : A[X]).coeff n, (mem_reesAlgebra_iff I p).mp p.2 n⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' r x := Subtype.ext (by simp)

theorem reesCoeff_apply (n : ℕ) (p : reesAlgebra I) :
    (reesCoeff I n p : A) = (p : A[X]).coeff n := rfl

/-- The `A`-linear degree-`n` projection `gr_I(A) → Iⁿ/Iⁿ⁺¹`, `[p] ↦ [coeff p n]`. -/
def grProjA (n : ℕ) : AssocGraded I →ₗ[A] GrPiece I n :=
  (Submodule.liftQ ((Ideal.map (algebraMap A (reesAlgebra I)) I).restrictScalars A)
      ((Submodule.mkQ _).comp (reesCoeff I n)) (fun p hp => by
        rw [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
          Submodule.Quotient.mk_eq_zero]
        exact ((mem_map_algebraMap_reesAlgebra_iff p).mp hp) n)).comp
    (Submodule.Quotient.restrictScalarsEquiv A _).symm.toLinearMap

/-- The `A/I`-linear degree-`n` projection `gr_I(A) → Iⁿ/Iⁿ⁺¹`. -/
def grProj (n : ℕ) : AssocGraded I →ₗ[A ⧸ I] GrPiece I n :=
  LinearMap.extendScalarsOfSurjective (Ideal.Quotient.mk_surjective (I := I)) (grProjA I n)

theorem grProj_mk (n : ℕ) (p : reesAlgebra I) :
    grProj I n (Ideal.Quotient.mk _ p) = Submodule.Quotient.mk (reesCoeff I n p) := rfl

theorem grProj_mk_same (n : ℕ) (a : A) (ha : a ∈ I ^ n) :
    grProj I n (AssocGraded.mk I n a ha) = Submodule.Quotient.mk ⟨a, ha⟩ := by
  rw [AssocGraded.mk, grProj_mk]
  congr 1
  exact Subtype.ext (by simp [reesCoeff_apply])

theorem grProj_mk_ne {n i : ℕ} (h : i ≠ n) (a : A) (ha : a ∈ I ^ i) :
    grProj I n (AssocGraded.mk I i a ha) = 0 := by
  rw [AssocGraded.mk, grProj_mk, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
    Submodule.subtype_apply, reesCoeff_apply]
  simp [coeff_monomial, h]

theorem grProj_ofGrPiece_same (n : ℕ) (y : GrPiece I n) :
    grProj I n (AssocGraded.ofGrPiece I n y) = y := by
  induction y using Submodule.Quotient.induction_on with
  | H x => rw [AssocGraded.ofGrPiece_mk, grProj_mk_same]

theorem grProj_ofGrPiece_ne {n i : ℕ} (h : i ≠ n) (y : GrPiece I i) :
    grProj I n (AssocGraded.ofGrPiece I i y) = 0 := by
  induction y using Submodule.Quotient.induction_on with
  | H x => rw [AssocGraded.ofGrPiece_mk, grProj_mk_ne I h]

/-- Every element of `gr_I(A)` is a finite sum of homogeneous elements `[coeff p i · Xⁱ]`. -/
theorem mk_eq_sum_mk (p : reesAlgebra I) :
    Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I) p =
      ∑ i ∈ (p : A[X]).support,
        AssocGraded.mk I i ((p : A[X]).coeff i) ((mem_reesAlgebra_iff I p).mp p.2 i) := by
  show Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I) p =
    ∑ i ∈ (p : A[X]).support, Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I)
      ⟨monomial i ((p : A[X]).coeff i),
        reesAlgebra.monomial_mem.mpr ((mem_reesAlgebra_iff I p).mp p.2 i)⟩
  have hsum : p = ∑ i ∈ (p : A[X]).support, (⟨monomial i ((p : A[X]).coeff i),
      reesAlgebra.monomial_mem.mpr ((mem_reesAlgebra_iff I p).mp p.2 i)⟩ : reesAlgebra I) := by
    apply Subtype.ext
    rw [AddSubmonoidClass.coe_finsetSum]
    exact (p : A[X]).as_sum_support
  exact (congrArg (Ideal.Quotient.mk _) hsum).trans
    (map_sum (Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I)).toAddMonoidHom _ _)

/-- `[(a + b) Xⁿ] = [a Xⁿ] + [b Xⁿ]`. -/
theorem AssocGraded.mk_add (n : ℕ) (a b : A) (ha : a ∈ I ^ n) (hb : b ∈ I ^ n) :
    AssocGraded.mk I n (a + b) (add_mem ha hb) =
      AssocGraded.mk I n a ha + AssocGraded.mk I n b hb := by
  show AssocGraded.mkLinear I n ⟨a + b, add_mem ha hb⟩ =
    AssocGraded.mkLinear I n ⟨a, ha⟩ + AssocGraded.mkLinear I n ⟨b, hb⟩
  rw [← map_add]
  rfl

/-- If `ν_I(a) = n` then the initial form of `a` is the class of `a Xⁿ`. -/
theorem initialForm_eq_mk {a : A} {n : ℕ} (h : Ideal.ordElem I a = n) :
    initialForm I a = AssocGraded.mk I n a (Ideal.mem_pow_of_ordElem h) := by
  have hne : Ideal.ordElem I a ≠ ⊤ := by rw [h]; exact ENat.natCast_ne_top n
  have key : (Ideal.ordElem I a).toNat = n := by rw [h, ENat.toNat_natCast]
  rw [initialForm, dite_eq_right hne]
  simp only [AssocGraded.mk]
  exact congrArg (Ideal.Quotient.mk _) (Subtype.ext (congrArg (fun k => monomial k a) key))

/-- The class of `a Xⁿ` with `a ∈ J ∩ Iⁿ` lies in `gr_I(J, A)`: it is either the initial form of
`a` (if `ν_I(a) = n`) or zero (if `ν_I(a) > n`, i.e. `a ∈ Iⁿ⁺¹`). -/
theorem mk_mem_grIdeal {J : Ideal A} {n : ℕ} {a : A} (haJ : a ∈ J) (ha : a ∈ I ^ n) :
    AssocGraded.mk I n a ha ∈ grIdeal I J := by
  by_cases htop : Ideal.ordElem I a = ⊤
  · rw [(AssocGraded.mk_eq_zero_iff I ha).mpr (Ideal.ordElem_eq_top_iff.mp htop (n + 1))]
    exact zero_mem _
  · obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp htop
    have hnm : n ≤ m := by
      have := Ideal.le_ordElem ha
      rw [← hm, Nat.cast_le] at this
      exact this
    rcases hnm.lt_or_eq with hlt | rfl
    · rw [(AssocGraded.mk_eq_zero_iff I ha).mpr
        (Ideal.pow_le_pow_right hlt (Ideal.mem_pow_of_ordElem hm.symm))]
      exact zero_mem _
    · have := Ideal.subset_span (Set.mem_image_of_mem (initialForm I) haJ)
      rw [initialForm_eq_mk I hm.symm] at this
      exact this

/-- The predicate "`x ∈ Iⁿ/Iⁿ⁺¹` is the class of an element of `J ∩ Iⁿ`". -/
def inJ (J : Ideal A) (n : ℕ) (x : GrPiece I n) : Prop :=
  ∃ a ∈ J, ∃ ha : a ∈ I ^ n, Submodule.Quotient.mk ⟨a, ha⟩ = x

theorem inJ_zero (J : Ideal A) (n : ℕ) : inJ I J n 0 :=
  ⟨0, zero_mem _, zero_mem _, (Submodule.Quotient.mk_eq_zero _).mpr (zero_mem _)⟩

theorem inJ_add {J : Ideal A} {n : ℕ} {x y : GrPiece I n} (hx : inJ I J n x)
    (hy : inJ I J n y) : inJ I J n (x + y) := by
  obtain ⟨a, haJ, ha, rfl⟩ := hx
  obtain ⟨b, hbJ, hb, rfl⟩ := hy
  exact ⟨a + b, add_mem haJ hbJ, add_mem ha hb, by rw [← Submodule.Quotient.mk_add]; rfl⟩

theorem inJ_sum {J : Ideal A} {n : ℕ} {ι : Type*} (s : Finset ι) (f : ι → GrPiece I n)
    (h : ∀ i ∈ s, inJ I J n (f i)) : inJ I J n (∑ i ∈ s, f i) :=
  Finset.sum_induction f (inJ I J n) (fun _ _ => inJ_add I) (inJ_zero I J n) h

/-- The key computation: if all homogeneous components of `ψ` are classes of elements of `J`,
so are those of `[b Xⁱ] · ψ` (the degree-`m` component of `[b Xⁱ] · ψ` is `b · (coeff ψ (m - i))`,
and `b · (a + r) = b a + b r` with `b a ∈ J ∩ Iᵐ` and `b r ∈ Iᵐ⁺¹`). -/
theorem inJ_grProj_mk_mul {J : Ideal A} {i : ℕ} (b : A) (hb : b ∈ I ^ i)
    (ψ : AssocGraded I) (hψ : ∀ m, inJ I J m (grProj I m ψ)) (m : ℕ) :
    inJ I J m (grProj I m (AssocGraded.mk I i b hb * ψ)) := by
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective ψ
  have key : grProj I m (AssocGraded.mk I i b hb * ψ) = Submodule.Quotient.mk
      (reesCoeff I m (⟨monomial i b, reesAlgebra.monomial_mem.mpr hb⟩ * p)) := by
    rw [← hp]
    rfl
  rw [key]
  by_cases him : i ≤ m
  · obtain ⟨a, haJ, ha, hmk⟩ := hψ (m - i)
    rw [← hp, grProj_mk, Submodule.Quotient.eq] at hmk
    have hmk' : a - (p : A[X]).coeff (m - i) ∈ I ^ (m - i + 1) := hmk
    refine ⟨b * a, J.mul_mem_left b haJ, ?_, ?_⟩
    · have : I ^ i * I ^ (m - i) = I ^ m := by rw [← pow_add, Nat.add_sub_cancel' him]
      rw [← this]
      exact Ideal.mul_mem_mul hb ha
    · rw [Submodule.Quotient.eq]
      show b * a - (monomial i b * (p : A[X])).coeff m ∈ I ^ (m + 1)
      rw [← C_mul_X_pow_eq_monomial, mul_assoc, coeff_C_mul, coeff_X_pow_mul', ite_eq_left him,
        ← mul_sub]
      have : I ^ i * I ^ (m - i + 1) = I ^ (m + 1) := by
        rw [← pow_add]
        congr 1
        omega
      rw [← this]
      exact Ideal.mul_mem_mul hb hmk'
  · refine ⟨0, zero_mem _, zero_mem _, ?_⟩
    rw [Submodule.Quotient.eq]
    show 0 - (monomial i b * (p : A[X])).coeff m ∈ I ^ (m + 1)
    rw [← C_mul_X_pow_eq_monomial, mul_assoc, coeff_C_mul, coeff_X_pow_mul', ite_eq_right him]
    simp

/-- The ideal `Σ_n ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹` of `gr_I(A)`: the elements all of whose homogeneous
components are classes of elements of `J`. -/
def grIdealBound (J : Ideal A) : Ideal (AssocGraded I) where
  carrier := {ψ | ∀ m, inJ I J m (grProj I m ψ)}
  zero_mem' := fun m => by rw [map_zero]; exact inJ_zero I J m
  add_mem' := fun {x y} hx hy m => by rw [map_add]; exact inJ_add I (hx m) (hy m)
  smul_mem' := fun c ψ hψ m => by
    rw [smul_eq_mul]
    obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective c
    rw [← hp, mk_eq_sum_mk, Finset.sum_mul, map_sum]
    exact inJ_sum I _ _ fun i _ => inJ_grProj_mk_mul I _ _ ψ hψ m

/-- `gr_I(J, A) ⊆ Σ_n ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹`: the generators (initial forms of elements of `J`)
lie in the latter ideal. -/
theorem grIdeal_le_bound (J : Ideal A) : grIdeal I J ≤ grIdealBound I J := by
  rw [grIdeal, Ideal.span_le]
  rintro _ ⟨g, hgJ, rfl⟩
  refine fun m => ?_
  by_cases htop : Ideal.ordElem I g = ⊤
  · rw [initialForm, dite_eq_left htop, map_zero]
    exact inJ_zero I J m
  · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
    rw [initialForm_eq_mk I hν.symm]
    by_cases hνm : ν = m
    · subst hνm
      rw [grProj_mk_same]
      exact ⟨g, hgJ, _, rfl⟩
    · rw [grProj_mk_ne I hνm]
      exact inJ_zero I J m

end GrProj

/-- p. 189: "We can write gr_I(J, A) = Σ_n ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹": a homogeneous element of
degree `n` lies in `gr_I(J, A)` iff it is the class of some `a ∈ J ∩ Iⁿ`.

Deviation from the paper (gap filled): the paper asserts the identity without argument; it is
proved here in its homogeneous form (the inclusion `⊆` for all elements is `grIdeal_le_bound`), and
as the single identity `grIdeal_restrictScalars_eq_iSup` just below. -/
theorem grIdeal_homogeneous_eq (I J : Ideal A) (n : ℕ) (φ : AssocGraded I)
    (hφ : φ ∈ AssocGraded.homogeneous I n) :
    φ ∈ grIdeal I J ↔ ∃ a ∈ J ⊓ I ^ n, ∃ ha : a ∈ I ^ n, AssocGraded.mk I n a ha = φ := by
  constructor
  · intro h
    obtain ⟨a, haJ, ha, hmk⟩ := grIdeal_le_bound I J h n
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hφ
    rw [grProj_ofGrPiece_same] at hmk
    exact ⟨a, ⟨haJ, ha⟩, ha, by rw [← hmk]; rfl⟩
  · rintro ⟨a, ⟨haJ, -⟩, ha, rfl⟩
    exact mk_mem_grIdeal I haJ ha

/-- The map of Rees algebras `⊕ Iⁿ Xⁿ → ⊕ Īⁿ Xⁿ` induced by `A → Ā = A/J`, `Ī = IĀ`
(coefficientwise reduction mod `J`). -/
def reesMapQuot (I J : Ideal A) : reesAlgebra I →ₐ[A] reesAlgebra (I.map (Ideal.Quotient.mk J)) where
  toFun p := ⟨(p : A[X]).map (Ideal.Quotient.mk J), (mem_reesAlgebra_iff _ _).mpr fun i => by
    rw [coeff_map, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ ((mem_reesAlgebra_iff I _).mp p.2 i)⟩
  map_one' := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)
  commutes' r := Subtype.ext (by simp [Polynomial.algebraMap_apply])

theorem reesMapQuot_apply_coe (I J : Ideal A) (p : reesAlgebra I) :
    (reesMapQuot I J p : (A ⧸ J)[X]) = (p : A[X]).map (Ideal.Quotient.mk J) := rfl

/-- The canonical homomorphism `gr_I(A) → gr_Ī(Ā)` of p. 189–190, where `Ā = A/J` and
`Ī = IĀ = (I + J)/J`, induced by `A → Ā`. -/
def grMapQuot (I J : Ideal A) : AssocGraded I →ₐ[A] AssocGraded (I.map (Ideal.Quotient.mk J)) :=
  Ideal.quotientMapₐ (I := Ideal.map (algebraMap A (reesAlgebra I)) I) _ (reesMapQuot I J) (by
    intro x hx
    rw [Ideal.mem_comap, mem_map_algebraMap_reesAlgebra_iff]
    rw [mem_map_algebraMap_reesAlgebra_iff] at hx
    intro n
    rw [reesMapQuot_apply_coe, coeff_map, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ (hx n))

/-- `gr_I(A) → gr_Ī(Ā)` sends the class of `a Xⁿ` to the class of `ā Xⁿ`. -/
theorem grMapQuot_mk (I J : Ideal A) (n : ℕ) (a : A) (ha : a ∈ I ^ n) :
    grMapQuot I J (AssocGraded.mk I n a ha) =
      AssocGraded.mk (I.map (Ideal.Quotient.mk J)) n (Ideal.Quotient.mk J a)
        (by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ ha) := by
  show Ideal.Quotient.mk _ (reesMapQuot I J ⟨monomial n a, reesAlgebra.monomial_mem.mpr ha⟩) =
    Ideal.Quotient.mk _ ⟨monomial n (Ideal.Quotient.mk J a), _⟩
  exact congrArg (Ideal.Quotient.mk _)
    (Subtype.ext (by rw [reesMapQuot_apply_coe]; exact Polynomial.map_monomial _))

/-! ### Lemma 5 (p. 190): the diagram and the `3 × 3` lemma

Hironaka's proof of Lemma 5 is the following (p. 190, continuing the definition of `Ā = A/J`,
`Ī = IĀ = (I + J)/J` at the end of p. 189):

> In view of the canonical isomorphism Ī^n = (I^n + J)/J ≈ I^n/I^n ∩ J, we have the following
> commutative diagram: [the `3 × 3` diagram] where the vertical sequences and the first two
> horizontal sequences are exact. The exactness of the last horizontal sequence follows, namely:
> LEMMA 5. Notation being as above, we have a canonical exact sequence of graded gr_I(A)-modules:
> 0 → gr_I(J, A) → gr_I(A) → gr_Ī(Ā) → 0.

The paper's "follows" is the `3 × 3` lemma, which is proved below once and for all
(`IsShortExact.of_three_by_three`; Mathlib has the snake lemma but not the `3 × 3` lemma).  The
diagram is then built as `A`-linear maps (namespace `GrQuotDiagram`), for each `n`, with the
printed rows and columns; exactness of all columns and of the first two rows is checked, and the
last row is exact by the `3 × 3` lemma.  Finally all maps respect the grading `gr_I(A) = ⊕ₙ Iⁿ/Iⁿ⁺¹`,
so exactness of the sequence of graded modules is exactness in each degree
(`grMapQuot_surjective`, `ker_grMapQuot`). -/

section ThreeByThree

variable {R : Type*} [CommRing R]

/-- `0 → M → N → P → 0` is a short exact sequence of `R`-linear maps. -/
structure IsShortExact {M N P : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup P] [Module R P] (f : M →ₗ[R] N) (g : N →ₗ[R] P) : Prop where
  injective : Function.Injective f
  exact : Function.Exact f g
  surjective : Function.Surjective g

variable {M₁₁ M₁₂ M₁₃ M₂₁ M₂₂ M₂₃ M₃₁ M₃₂ M₃₃ : Type*}
  [AddCommGroup M₁₁] [Module R M₁₁] [AddCommGroup M₁₂] [Module R M₁₂]
  [AddCommGroup M₁₃] [Module R M₁₃] [AddCommGroup M₂₁] [Module R M₂₁]
  [AddCommGroup M₂₂] [Module R M₂₂] [AddCommGroup M₂₃] [Module R M₂₃]
  [AddCommGroup M₃₁] [Module R M₃₁] [AddCommGroup M₃₂] [Module R M₃₂]
  [AddCommGroup M₃₃] [Module R M₃₃]
  {f₁ : M₁₁ →ₗ[R] M₁₂} {f₂ : M₁₂ →ₗ[R] M₁₃} {g₁ : M₂₁ →ₗ[R] M₂₂} {g₂ : M₂₂ →ₗ[R] M₂₃}
  {h₁ : M₃₁ →ₗ[R] M₃₂} {h₂ : M₃₂ →ₗ[R] M₃₃}
  {i₁ : M₁₁ →ₗ[R] M₂₁} {i₂ : M₁₂ →ₗ[R] M₂₂} {i₃ : M₁₃ →ₗ[R] M₂₃}
  {j₁ : M₂₁ →ₗ[R] M₃₁} {j₂ : M₂₂ →ₗ[R] M₃₂} {j₃ : M₂₃ →ₗ[R] M₃₃}

/-- **The `3 × 3` lemma.** In a commutative diagram of linear maps
```
0     0     0
↓     ↓     ↓
M₁₁ → M₁₂ → M₁₃
↓     ↓     ↓
M₂₁ → M₂₂ → M₂₃
↓     ↓     ↓
M₃₁ → M₃₂ → M₃₃
↓     ↓     ↓
0     0     0
```
whose three columns and first two rows are short exact, the last row is short exact too.  This is
the step "The exactness of the last horizontal sequence follows" of Lemma 5 (Hironaka, p. 190),
where the diagram is the one with rows `0 → Iⁿ⁺¹ ∩ J → Iⁿ⁺¹ → Īⁿ⁺¹ → 0`,
`0 → Iⁿ ∩ J → Iⁿ → Īⁿ → 0`, `0 → grⁿ_I(J, A) → grⁿ_I(A) → grⁿ_Ī(Ā) → 0`.

Gap filled: the paper uses the lemma without naming it or proving it. -/
theorem IsShortExact.of_three_by_three (hf : IsShortExact f₁ f₂) (hg : IsShortExact g₁ g₂)
    (hc₁ : IsShortExact i₁ j₁) (hc₂ : IsShortExact i₂ j₂) (hc₃ : IsShortExact i₃ j₃)
    (c₁ : g₁ ∘ₗ i₁ = i₂ ∘ₗ f₁) (c₂ : g₂ ∘ₗ i₂ = i₃ ∘ₗ f₂)
    (d₁ : h₁ ∘ₗ j₁ = j₂ ∘ₗ g₁) (d₂ : h₂ ∘ₗ j₂ = j₃ ∘ₗ g₂) :
    IsShortExact h₁ h₂ := by
  have c₁' : ∀ x, g₁ (i₁ x) = i₂ (f₁ x) := fun x => LinearMap.congr_fun c₁ x
  have c₂' : ∀ x, g₂ (i₂ x) = i₃ (f₂ x) := fun x => LinearMap.congr_fun c₂ x
  have d₁' : ∀ x, h₁ (j₁ x) = j₂ (g₁ x) := fun x => LinearMap.congr_fun d₁ x
  have d₂' : ∀ x, h₂ (j₂ x) = j₃ (g₂ x) := fun x => LinearMap.congr_fun d₂ x
  refine ⟨?_, ?_, ?_⟩
  · -- `h₁` is injective
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro c hc
    obtain ⟨y₁, rfl⟩ := hc₁.surjective c
    have h1 : j₂ (g₁ y₁) = 0 := by rw [← d₁']; exact hc
    obtain ⟨x₂, hx₂⟩ := (hc₂.exact _).mp h1
    have h2 : f₂ x₂ = 0 := by
      apply hc₃.injective
      rw [← c₂', hx₂, map_zero, hg.exact.apply_apply_eq_zero]
    obtain ⟨x₁, hx₁⟩ := (hf.exact _).mp h2
    have h3 : y₁ = i₁ x₁ := hg.injective (by rw [c₁', hx₁, hx₂])
    rw [h3]
    exact hc₁.exact.apply_apply_eq_zero x₁
  · -- exactness in the middle
    intro c
    constructor
    · intro hc
      obtain ⟨y₂, rfl⟩ := hc₂.surjective c
      have h1 : j₃ (g₂ y₂) = 0 := by rw [← d₂']; exact hc
      obtain ⟨x₃, hx₃⟩ := (hc₃.exact _).mp h1
      obtain ⟨x₂, rfl⟩ := hf.surjective x₃
      have h2 : g₂ (y₂ - i₂ x₂) = 0 := by rw [map_sub, c₂', hx₃, sub_self]
      obtain ⟨y₁, hy₁⟩ := (hg.exact _).mp h2
      refine ⟨j₁ y₁, ?_⟩
      rw [d₁', hy₁, map_sub, hc₂.exact.apply_apply_eq_zero, sub_zero]
    · rintro ⟨c₁, rfl⟩
      obtain ⟨y₁, rfl⟩ := hc₁.surjective c₁
      rw [d₁', d₂', hg.exact.apply_apply_eq_zero, map_zero]
  · -- `h₂` is surjective
    intro c₃
    obtain ⟨y₃, rfl⟩ := hc₃.surjective c₃
    obtain ⟨y₂, rfl⟩ := hg.surjective y₃
    exact ⟨j₂ y₂, d₂' y₂⟩

end ThreeByThree

namespace GrQuotDiagram

section Generic

variable {O : Type u} [CommRing O] (P : Ideal O)

/-- The inclusion `Pⁿ⁺¹ → Pⁿ` (the vertical arrows of the first two columns of the diagram of
p. 190, for `P = I`, and of the third column, for `P = Ī`). -/
def powSuccToPow (n : ℕ) : ↥(P ^ (n + 1)) →ₗ[O] ↥(P ^ n) :=
  Submodule.inclusion (Ideal.pow_le_pow_right n.le_succ)

/-- The quotient map `Pⁿ → Pⁿ/Pⁿ⁺¹ = grⁿ_P(O)` (p. 180: "The homogeneous part of degree m of
gr_I(A) is the A/I-module of finite type I^m/I^{m+1} and will be denoted by gr^m_I(A)"). -/
def powToGrPiece (n : ℕ) : ↥(P ^ n) →ₗ[O] GrPiece P n :=
  Submodule.mkQ _

/-- The vertical sequences `0 → Pⁿ⁺¹ → Pⁿ → grⁿ_P(O) → 0` of the diagram are exact: the kernel of
`Pⁿ → Pⁿ/Pⁿ⁺¹` is `Pⁿ⁺¹`. -/
theorem isShortExact_powSuccToPow (n : ℕ) :
    IsShortExact (powSuccToPow P n) (powToGrPiece P n) := by
  refine ⟨Submodule.inclusion_injective _, fun y => ?_, Submodule.mkQ_surjective _⟩
  rw [powToGrPiece, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
  constructor
  · intro h
    exact ⟨⟨y, h⟩, rfl⟩
  · rintro ⟨z, rfl⟩
    exact z.2

end Generic

variable (I J : Ideal A)

/-- First arrow of the first two rows of the diagram: `Iᵏ ∩ J → Iᵏ`. -/
def interPowToPow (k : ℕ) : ↥(I ^ k ⊓ J) →ₗ[A] ↥(I ^ k) :=
  Submodule.inclusion inf_le_left

/-- Second arrow of the first two rows of the diagram: `Iᵏ → Īᵏ`, reduction modulo `J`
(`Ā = A/J`, `Ī = IĀ`). -/
def powToQuotPow (k : ℕ) : ↥(I ^ k) →ₗ[A] ↥(I.map (Ideal.Quotient.mk J) ^ k) where
  toFun x := ⟨Ideal.Quotient.mk J x, by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ x.2⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' r x := Subtype.ext (by simp [Algebra.smul_def, Ideal.Quotient.algebraMap_eq])

/-- The first two horizontal sequences `0 → Iᵏ ∩ J → Iᵏ → Īᵏ → 0` are exact; the surjectivity of
`Iᵏ → Īᵏ` is the canonical isomorphism of p. 190, "Ī^n = (I^n + J)/J ≈ I^n/I^n ∩ J". -/
theorem isShortExact_interPowToPow (k : ℕ) :
    IsShortExact (interPowToPow I J k) (powToQuotPow I J k) := by
  refine ⟨Submodule.inclusion_injective _, fun y => ?_, fun q => ?_⟩
  · have : powToQuotPow I J k y = 0 ↔ (y : A) ∈ J := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, Subtype.ext_iff]
      rfl
    rw [this]
    constructor
    · intro h
      exact ⟨⟨y, y.2, h⟩, rfl⟩
    · rintro ⟨z, rfl⟩
      exact z.2.2
  · have h : (q : A ⧸ J) ∈ (I ^ k).map (Ideal.Quotient.mk J) := by
      rw [Ideal.map_pow]
      exact q.2
    rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at h
    obtain ⟨a, ha, h⟩ := h
    exact ⟨⟨a, ha⟩, Subtype.ext h⟩

/-- The graded piece `grⁿ_I(J, A)` of the diagram: the homogeneous part of degree `n` of the
graded ideal `gr_I(J, A)` (p. 189: "We denote by gr^n_I(J, A) the homogeneous part of degree n of
the graded ideal gr_I(J, A)"), as an `A`-submodule of `grⁿ_I(A) = Iⁿ/Iⁿ⁺¹`. -/
def grIdealPiece (n : ℕ) : Submodule A (GrPiece I n) :=
  Submodule.comap ((AssocGraded.ofGrPiece I n).restrictScalars A)
    ((grIdeal I J).restrictScalars A)

/-- p. 189: "We can write gr_I(J, A) = Σ_n ((J ∩ I^n) + I^{n+1})/I^{n+1}", in degree `n`: the
elements of `grⁿ_I(J, A)` are the classes of the elements of `Iⁿ ∩ J` (this is
`grIdeal_homogeneous_eq`, the gap filled for that line). -/
theorem mem_grIdealPiece_iff (n : ℕ) (x : GrPiece I n) :
    x ∈ grIdealPiece I J n ↔
      ∃ a ∈ I ^ n ⊓ J, ∃ ha : a ∈ I ^ n, Submodule.Quotient.mk ⟨a, ha⟩ = x := by
  have h := grIdeal_homogeneous_eq I J n (AssocGraded.ofGrPiece I n x)
    (LinearMap.mem_range_self _ x)
  rw [inf_comm] at h
  rw [grIdealPiece, Submodule.mem_comap]
  refine h.trans ?_
  refine exists_congr fun a => and_congr_right fun _ => exists_congr fun ha => ?_
  rw [← AssocGraded.ofGrPiece_injective I n |>.eq_iff]
  rfl

/-- The vertical arrow `Iⁿ ∩ J → grⁿ_I(J, A)` of the first column (third row): `a ↦ [a]`. -/
def interToGrIdealPiece (n : ℕ) : ↥(I ^ n ⊓ J) →ₗ[A] ↥(grIdealPiece I J n) :=
  ((powToGrPiece I n).comp (interPowToPow I J n)).codRestrict (grIdealPiece I J n) fun x =>
    (mem_grIdealPiece_iff I J n _).mpr ⟨x, x.2, x.2.1, rfl⟩

/-- The vertical arrow `Iⁿ⁺¹ ∩ J → Iⁿ ∩ J` of the first column. -/
def interSuccToInter (n : ℕ) : ↥(I ^ (n + 1) ⊓ J) →ₗ[A] ↥(I ^ n ⊓ J) :=
  Submodule.inclusion (inf_le_inf_right J (Ideal.pow_le_pow_right n.le_succ))

/-- The first vertical sequence `0 → Iⁿ⁺¹ ∩ J → Iⁿ ∩ J → grⁿ_I(J, A) → 0` is exact (this is
the surjectivity `Iⁿ ∩ J → ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹` of the displayed formula of p. 189 and the
computation of its kernel). -/
theorem isShortExact_interSuccToInter (n : ℕ) :
    IsShortExact (interSuccToInter I J n) (interToGrIdealPiece I J n) := by
  refine ⟨Submodule.inclusion_injective _, fun y => ?_, fun z => ?_⟩
  · have : interToGrIdealPiece I J n y = 0 ↔ (y : A) ∈ I ^ (n + 1) := by
      rw [Subtype.ext_iff]
      exact Submodule.Quotient.mk_eq_zero _
    rw [this]
    constructor
    · intro h
      exact ⟨⟨y, h, y.2.2⟩, rfl⟩
    · rintro ⟨w, rfl⟩
      exact w.2.1
  · obtain ⟨a, haJ, ha, h⟩ := (mem_grIdealPiece_iff I J n z.1).mp z.2
    exact ⟨⟨a, haJ⟩, Subtype.ext h⟩

/-- The third vertical sequence `0 → Īⁿ⁺¹ → Īⁿ → grⁿ_Ī(Ā) → 0` is exact (`isShortExact_powSuccToPow`
for the ideal `Ī` of `Ā = A/J`), regarded as a sequence of `A`-modules. -/
theorem isShortExact_restrictScalars_powSuccToPow (n : ℕ) :
    IsShortExact ((powSuccToPow (I.map (Ideal.Quotient.mk J)) n).restrictScalars A)
      ((powToGrPiece (I.map (Ideal.Quotient.mk J)) n).restrictScalars A) :=
  ⟨(isShortExact_powSuccToPow _ n).injective, (isShortExact_powSuccToPow _ n).exact,
    (isShortExact_powSuccToPow _ n).surjective⟩

/-- The bottom-right arrow `grⁿ_I(A) → grⁿ_Ī(Ā)`, i.e. `Iⁿ/Iⁿ⁺¹ → Īⁿ/Īⁿ⁺¹`, induced by
`A → Ā = A/J`. -/
def grPieceMap (n : ℕ) : GrPiece I n →ₗ[A] GrPiece (I.map (Ideal.Quotient.mk J)) n :=
  Submodule.liftQ _ ((powToGrPiece (I.map (Ideal.Quotient.mk J)) n).restrictScalars A ∘ₗ
    powToQuotPow I J n) fun x hx => by
    rw [LinearMap.mem_ker]
    show powToGrPiece (I.map (Ideal.Quotient.mk J)) n (powToQuotPow I J n x) = 0
    rw [powToGrPiece, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
    rw [Submodule.mem_comap] at hx
    show Ideal.Quotient.mk J x ∈ I.map (Ideal.Quotient.mk J) ^ (n + 1)
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hx

/-- **The diagram of p. 190.** For every `n` the last horizontal sequence
`0 → grⁿ_I(J, A) → grⁿ_I(A) → grⁿ_Ī(Ā) → 0` is exact: it is the last row of the commutative
`3 × 3` diagram of `A`-modules

```
0 → Iⁿ⁺¹ ∩ J → Iⁿ⁺¹ → Īⁿ⁺¹ → 0
      ↓          ↓       ↓
0 → Iⁿ ∩ J   → Iⁿ   → Īⁿ   → 0
      ↓          ↓       ↓
0 → grⁿ_I(J,A) → grⁿ_I(A) → grⁿ_Ī(Ā) → 0
```

whose vertical sequences (`isShortExact_interSuccToInter`, `isShortExact_powSuccToPow`,
`isShortExact_restrictScalars_powSuccToPow`) and first two horizontal sequences
(`isShortExact_interPowToPow`) are exact ("where the vertical sequences and the first two
horizontal sequences are exact"); its exactness follows by the `3 × 3` lemma
(`IsShortExact.of_three_by_three`). -/
@[blueprint "lem:II.2-5-degree"
  (statement := /-- (Part of Lemma 5, p.~190.) Let $A$ be a ring, $I$ and $J$ ideals in $A$,
    $\bar A=A/J$, $\bar I=I\bar A$. For each $n\ge0$, the last horizontal sequence
    $0\to\operatorname{gr}^n_I(J,A)\to\operatorname{gr}^n_I(A)\to\operatorname{gr}^n_{\bar I}(\bar A)
    \to0$ of the commutative diagram of p.~190 is exact. -/)
  (proof := /-- In view of the canonical isomorphism $\bar I^n=(I^n+J)/J\approx I^n/I^n\cap J$ one
    has the commutative diagram
    \[\begin{array}{ccccccccc}
    0&\to&I^{n+1}\cap J&\to&I^{n+1}&\to&\bar I^{n+1}&\to&0\\
    &&\downarrow&&\downarrow&&\downarrow&&\\
    0&\to&I^n\cap J&\to&I^n&\to&\bar I^n&\to&0\\
    &&\downarrow&&\downarrow&&\downarrow&&\\
    0&\to&\operatorname{gr}^n_I(J,A)&\to&\operatorname{gr}^n_I(A)&\to&\operatorname{gr}^n_{\bar I}(\bar A)&\to&0
    \end{array}\]
    where the vertical sequences and the first two horizontal sequences are exact: the vertical
    sequences are the kernels $I^{n+1}\cap J$, $I^{n+1}$, $\bar I^{n+1}$ of the maps onto
    $\operatorname{gr}^n_I(J,A)=((J\cap I^n)+I^{n+1})/I^{n+1}$, $I^n/I^{n+1}$, $\bar I^n/\bar I^{n+1}$
    (the first by the displayed formula of p.~189), and the rows are $I^k\cap J\to I^k\to\bar I^k$
    with $\bar I^k=(I^k+J)/J$. The exactness of the last horizontal sequence follows from the
    $3\times3$ lemma. -/)
  (latexEnv := "lemma")]
theorem isShortExact_grPiece (n : ℕ) :
    IsShortExact (grIdealPiece I J n).subtype (grPieceMap I J n) :=
  IsShortExact.of_three_by_three
    (f₁ := interPowToPow I J (n + 1)) (f₂ := powToQuotPow I J (n + 1))
    (g₁ := interPowToPow I J n) (g₂ := powToQuotPow I J n)
    (i₁ := interSuccToInter I J n) (i₂ := powSuccToPow I n)
    (i₃ := (powSuccToPow (I.map (Ideal.Quotient.mk J)) n).restrictScalars A)
    (j₁ := interToGrIdealPiece I J n) (j₂ := powToGrPiece I n)
    (j₃ := (powToGrPiece (I.map (Ideal.Quotient.mk J)) n).restrictScalars A)
    (isShortExact_interPowToPow I J (n + 1)) (isShortExact_interPowToPow I J n)
    (isShortExact_interSuccToInter I J n) (isShortExact_powSuccToPow I n)
    (isShortExact_restrictScalars_powSuccToPow I J n)
    (LinearMap.ext fun _ => rfl) (LinearMap.ext fun _ => rfl)
    (LinearMap.ext fun _ => rfl) (LinearMap.ext fun _ => rfl)

/-- Every element of `gr_I(A)` is the finite sum of its homogeneous components: `gr_I(A)` is
graded, `gr_I(A) = Σₙ Iⁿ/Iⁿ⁺¹` (p. 180). -/
theorem exists_eq_sum_ofGrPiece_grProj (φ : AssocGraded I) :
    ∃ S : Finset ℕ, φ = ∑ i ∈ S, AssocGraded.ofGrPiece I i (grProj I i φ) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective φ
  exact ⟨(p : A[X]).support, mk_eq_sum_mk I p⟩

/-- The arrows `grⁿ_I(A) → grⁿ_Ī(Ā)` of the diagram are the homogeneous components of the map
`gr_I(A) → gr_Ī(Ā)` induced by `A → Ā` (on the degree-`n` piece). -/
theorem grMapQuot_ofGrPiece (n : ℕ) (x : GrPiece I n) :
    grMapQuot I J (AssocGraded.ofGrPiece I n x) =
      AssocGraded.ofGrPiece (I.map (Ideal.Quotient.mk J)) n (grPieceMap I J n x) := by
  induction x using Submodule.Quotient.induction_on with
  | H a =>
    rw [AssocGraded.ofGrPiece_mk, grMapQuot_mk]
    rfl

/-- `gr_I(A) → gr_Ī(Ā)` respects the grading: its degree-`n` component is `grPieceMap`. -/
theorem grProj_grMapQuot (n : ℕ) (φ : AssocGraded I) :
    grProj (I.map (Ideal.Quotient.mk J)) n (grMapQuot I J φ) = grPieceMap I J n (grProj I n φ) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective φ
  show grProj _ n (Ideal.Quotient.mk _ (reesMapQuot I J p)) =
    grPieceMap I J n (Submodule.Quotient.mk (reesCoeff I n p))
  rw [grProj_mk]
  show Submodule.Quotient.mk _ = Submodule.Quotient.mk (powToQuotPow I J n (reesCoeff I n p))
  congr 1
  exact Subtype.ext (by simp [reesCoeff_apply, reesMapQuot_apply_coe, coeff_map, powToQuotPow])

end GrQuotDiagram

/-- p. 189: "We can write `gr_I(J, A) = Σ_n ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹`", as one identity.  In `gr_I(A)` the
summand `((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹ ⊆ Iⁿ/Iⁿ⁺¹ = grⁿ_I(A)` is the set of classes `[a Xⁿ]` of the elements
`a ∈ J ∩ Iⁿ`, the image of `J ∩ Iⁿ` under `AssocGraded.mkLinear I n`; the sum is the supremum of these
`A`-submodules, and the left side is the ideal `gr_I(J, A)`, viewed as an `A`-submodule.

Deviation from the paper (gap filled): the paper asserts the identity ("We can write") without
argument.  Proof: `⊇`: each class `[a Xⁿ]`, `a ∈ J ∩ Iⁿ`, lies in `gr_I(J, A)`
(`mk_mem_grIdeal`).  `⊆`: write an element of `gr_I(J, A)` as the sum of its homogeneous components
(`GrQuotDiagram.exists_eq_sum_ofGrPiece_grProj`); by `grIdeal_le_bound` the degree-`n` component is the class of an
element of `J ∩ Iⁿ`. -/
@[blueprint "lem:II.2-graded-ideal-sum"
  (statement := /-- For ideals $I,J$ of a noetherian ring $A$,
    $\operatorname{gr}_I(J,A)=\sum_n\bigl((J\cap I^n)+I^{n+1}\bigr)/I^{n+1}$, where the $n$-th
    summand is the set of classes in $\operatorname{gr}_I(A)$ of the elements of $J\cap I^n$. (p.~189:
    ``We can write'' this identity.) \textbf{Gap in the paper filled.} The paper asserts the identity without argument; the proof below supplies it. -/)
  (proof := /-- ($\supseteq$) The class of $a\in J\cap I^n$ in $I^n/I^{n+1}$ is the initial form of
    $a$ or zero, so it lies in $\operatorname{gr}_I(J,A)$. ($\subseteq$) An element of
    $\operatorname{gr}_I(J,A)$ is the sum of its homogeneous components, and each homogeneous
    component of an element of $\operatorname{gr}_I(J,A)$ is the class of an element of $J\cap I^n$
    (it is so for the generators, the initial forms of elements of $J$, and the property is stable under
    sums and under multiplication by homogeneous elements). -/)
  (latexEnv := "lemma")]
theorem grIdeal_restrictScalars_eq_iSup (I J : Ideal A) :
    (grIdeal I J).restrictScalars A =
      ⨆ n : ℕ, Submodule.map (AssocGraded.mkLinear I n) (Submodule.comap (I ^ n).subtype J) := by
  refine le_antisymm (fun φ hφ => ?_) (iSup_le fun n => ?_)
  · have hb := grIdeal_le_bound I J (Submodule.restrictScalars_mem A _ _ |>.mp hφ)
    obtain ⟨S, hS⟩ := GrQuotDiagram.exists_eq_sum_ofGrPiece_grProj I φ
    rw [hS]
    refine Submodule.sum_mem _ fun n _ => ?_
    obtain ⟨a, haJ, ha, hmk⟩ := hb n
    have h : AssocGraded.ofGrPiece I n (grProj I n φ) = AssocGraded.mk I n a ha := by
      rw [← hmk, AssocGraded.ofGrPiece_mk]
    rw [h]
    exact Submodule.mem_iSup_of_mem n ⟨⟨a, ha⟩, haJ, rfl⟩
  · rintro _ ⟨⟨a, ha⟩, haJ, rfl⟩
    exact mk_mem_grIdeal I haJ ha

/-- Lemma 5 (p. 190), surjectivity part: `gr_I(A) → gr_Ī(Ā)` is onto.  Proof as printed: the last
arrow `grⁿ_I(A) → grⁿ_Ī(Ā)` of the last horizontal sequence of the diagram is onto for every `n`
(`GrQuotDiagram.isShortExact_grPiece`), and `gr_Ī(Ā)` is the sum of its homogeneous parts. -/
@[blueprint "lem:II.2-5-surjective"
  (statement := /-- (Part of Lemma 5, p.~190.) With $\bar A=A/J$ and $\bar I=I\bar A$, the
    canonical homomorphism $\operatorname{gr}_I(A)\to\operatorname{gr}_{\bar I}(\bar A)$ is
    surjective. -/)
  (proof := /-- By the diagram of p.~190 (\cref{lem:II.2-5-degree}) the last arrow
    $\operatorname{gr}^n_I(A)\to\operatorname{gr}^n_{\bar I}(\bar A)$ of the last horizontal
    sequence is surjective for every $n$; these are the homogeneous components of the map, and
    $\operatorname{gr}_{\bar I}(\bar A)$ is the sum of its homogeneous parts. -/)
  (latexEnv := "lemma")]
theorem grMapQuot_surjective (I J : Ideal A) : Function.Surjective (grMapQuot I J) := by
  intro φ'
  obtain ⟨S, hS⟩ := GrQuotDiagram.exists_eq_sum_ofGrPiece_grProj
    (I.map (Ideal.Quotient.mk J)) φ'
  choose z hz using fun i =>
    (GrQuotDiagram.isShortExact_grPiece I J i).surjective
      (grProj (I.map (Ideal.Quotient.mk J)) i φ')
  refine ⟨∑ i ∈ S, AssocGraded.ofGrPiece I i (z i), ?_⟩
  rw [map_sum, hS]
  exact Finset.sum_congr rfl fun i _ => by rw [GrQuotDiagram.grMapQuot_ofGrPiece, hz]

/-- Lemma 5 (p. 190): "we have a canonical exact sequence of graded gr_I(A)-modules
0 → gr_I(J, A) → gr_I(A) → gr_Ī(Ā) → 0", i.e. the kernel of `gr_I(A) → gr_Ī(Ā)` is
`gr_I(J, A)` (together with `grMapQuot_surjective`).

Proof as printed (p. 190): "In view of the canonical isomorphism Ī^n = (I^n + J)/J ≈ I^n/I^n ∩ J,
we have the following commutative diagram [...] where the vertical sequences and the first two
horizontal sequences are exact. The exactness of the last horizontal sequence follows". The
diagram is `GrQuotDiagram` and the exactness of its last row is
`GrQuotDiagram.isShortExact_grPiece` (by the `3 × 3` lemma `IsShortExact.of_three_by_three`).
All maps respect the grading, so the sequence of graded modules is exact because it is exact in
each degree: a homogeneous component of an element of the kernel lies in the kernel of
`grⁿ_I(A) → grⁿ_Ī(Ā)`, i.e. in `grⁿ_I(J, A)`; conversely the components of an element of
`gr_I(J, A) = Σₙ ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹` (p. 189) lie in the image of `grⁿ_I(J, A)`.

Deviation from the paper (statement modified): no hypothesis on `A` or `I` is needed (the
paper's standing assumptions "`A` noetherian, `I ≠ A`" are dropped); exactness is split into
`grMapQuot_surjective` and this kernel statement. -/
@[blueprint "lem:II.2-5"
  (statement := /-- Let $A$ be a noetherian ring, $I\ne A$ and $J$ ideals in $A$, $\bar A=A/J$
    and $\bar I=I\bar A=(I+J)/J$. Then there is a canonical exact sequence of graded
    $\operatorname{gr}_I(A)$-modules
    $0\to\operatorname{gr}_I(J,A)\to\operatorname{gr}_I(A)\to\operatorname{gr}_{\bar I}(\bar A)
    \to0$. (Lemma 5, p.~190.) -/)
  (proof := /-- In view of the canonical isomorphism $\bar I^n=(I^n+J)/J\cong I^n/(I^n\cap J)$
    one has, for each $n$, the commutative diagram of p.~190 with exact rows
    $0\to I^{n+1}\cap J\to I^{n+1}\to\bar I^{n+1}\to0$ and
    $0\to I^n\cap J\to I^n\to\bar I^n\to0$ and exact columns, whose last horizontal sequence
    $0\to\operatorname{gr}^n_I(J,A)\to\operatorname{gr}^n_I(A)\to
    \operatorname{gr}^n_{\bar I}(\bar A)\to0$ is exact (\cref{lem:II.2-5-degree}). All maps respect
    the grading, so the sequence of graded modules is exact in each degree, hence exact. The
    formal statement drops the standing hypotheses ($A$ noetherian, $I\ne A$), which are not
    needed (statement modified). -/)
  (latexEnv := "lemma")]
theorem ker_grMapQuot (I J : Ideal A) : RingHom.ker (grMapQuot I J) = grIdeal I J := by
  apply le_antisymm
  · intro φ hφ
    rw [RingHom.mem_ker] at hφ
    obtain ⟨S, hS⟩ := GrQuotDiagram.exists_eq_sum_ofGrPiece_grProj I φ
    rw [hS]
    refine sum_mem fun i _ => ?_
    have h0 : GrQuotDiagram.grPieceMap I J i (grProj I i φ) = 0 := by
      rw [← GrQuotDiagram.grProj_grMapQuot, hφ, map_zero]
    obtain ⟨x, hx⟩ := ((GrQuotDiagram.isShortExact_grPiece I J i).exact _).mp h0
    have : grProj I i φ ∈ GrQuotDiagram.grIdealPiece I J i := by rw [← hx]; exact x.2
    exact this
  · intro φ hφ
    rw [RingHom.mem_ker]
    obtain ⟨S, hS⟩ := GrQuotDiagram.exists_eq_sum_ofGrPiece_grProj
      (I.map (Ideal.Quotient.mk J)) (grMapQuot I J φ)
    rw [hS]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hmem : grProj I i φ ∈ GrQuotDiagram.grIdealPiece I J i := by
      obtain ⟨a, haJ, ha, h⟩ := grIdeal_le_bound I J hφ i
      show AssocGraded.ofGrPiece I i (grProj I i φ) ∈ grIdeal I J
      rw [← h]
      exact mk_mem_grIdeal I haJ ha
    have h0 : GrQuotDiagram.grPieceMap I J i (grProj I i φ) = 0 :=
      ((GrQuotDiagram.isShortExact_grPiece I J i).exact _).mpr ⟨⟨_, hmem⟩, rfl⟩
    rw [GrQuotDiagram.grProj_grMapQuot, h0, map_zero]

/-- "`gr_I(A)` is flat over `A/I`" (the condition of Ch. II §1 and of normal flatness). -/
def IsGrFlat (I : Ideal A) : Prop := Module.Flat (A ⧸ I) (AssocGraded I)

/-- `⨁ₙ Iⁿ/Iⁿ⁺¹ → gr_I(A)`, `A/I`-linearly, assembling the `AssocGraded.ofGrPiece I n`. -/
def toGr (I : Ideal A) : DirectSum ℕ (fun n => GrPiece I n) →ₗ[A ⧸ I] AssocGraded I :=
  DirectSum.toModule (A ⧸ I) ℕ (AssocGraded I) (AssocGraded.ofGrPiece I)

theorem grProj_toGr (I : Ideal A) (n : ℕ) (x : DirectSum ℕ (fun n => GrPiece I n)) :
    grProj I n (toGr I x) = x n := by
  have : (grProj I n).comp (toGr I) = DirectSum.component (A ⧸ I) ℕ (fun n => GrPiece I n) n := by
    refine DirectSum.linearMap_ext _ fun i => LinearMap.ext fun y => ?_
    simp only [LinearMap.comp_apply, toGr, DirectSum.toModule_lof, DirectSum.component.of]
    split_ifs with h
    · subst h
      exact grProj_ofGrPiece_same I i y
    · exact grProj_ofGrPiece_ne I h y
  exact LinearMap.congr_fun this x

theorem toGr_bijective (I : Ideal A) : Function.Bijective (toGr I) := by
  constructor
  · intro x y hxy
    refine DirectSum.ext fun n => ?_
    rw [← grProj_toGr I n x, ← grProj_toGr I n y, hxy]
  · intro φ
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective φ
    refine ⟨∑ i ∈ (p : A[X]).support, DirectSum.lof (A ⧸ I) ℕ (fun n => GrPiece I n) i
      (Submodule.Quotient.mk (reesCoeff I i p)), ?_⟩
    rw [map_sum, mk_eq_sum_mk]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [toGr, DirectSum.toModule_lof, AssocGraded.ofGrPiece_mk]
    rfl

/-- `gr_I(A)` is flat over `A/I` iff each homogeneous piece `Iⁿ/Iⁿ⁺¹` is (a direct sum is flat
iff each summand is; cf. the proof of the Corollary to Lemma 2, p. 182). -/
theorem isGrFlat_iff_forall_flat_piece (I : Ideal A) :
    IsGrFlat I ↔ ∀ n, Module.Flat (A ⧸ I) (GrPiece I n) := by
  rw [IsGrFlat, ← Module.Flat.directSum_iff]
  exact (Module.Flat.equiv_iff (LinearEquiv.ofBijective (toGr I) (toGr_bijective I))).symm

end GradedAlgebra

end Hironaka


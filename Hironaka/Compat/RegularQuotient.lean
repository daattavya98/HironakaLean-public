module

public import Mathlib.Order.CompletePartialOrder
public import Mathlib.RingTheory.KrullDimension.NonZeroDivisors
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Architect
public import Hironaka.Compat.RegularLocalRing

/-!
# Compatibility layer: regular local rings are domains; primes with regular quotient

Facts about a regular local ring `R` with maximal ideal `M` that Hironaka uses without comment
and that Mathlib does not provide:

* if `x ∈ M \ M²`, then `R/xR` is regular and its maximal ideal needs one generator less;
* `R` is a domain (used tacitly whenever the paper speaks of "the field of quotients of `R`",
  p. 209);
* if `P` is a prime of `R` such that `R/P` is regular, then `P` is generated by part of a
  regular system of parameters of `R`, and every power `Pᵛ` is `P`-primary, so that
  `PᵛR_P ∩ R = Pᵛ` (p. 217).

The proofs are inductions on the number of generators of `M`, using Mathlib's dimension theory
(`ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank`), prime avoidance and Nakayama's lemma.
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

/-- A quotient of a local ring by an ideal contained in the maximal ideal is local. -/
theorem isLocalRing_quotient_of_le {A : Type u} [CommRing A] [IsLocalRing A]
    {I : Ideal A} (hI : I ≤ maximalIdeal A) : IsLocalRing (A ⧸ I) := by
  have : Nontrivial (A ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top (maximalIdeal.isMaximal A).ne_top hI)
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective

/-- If `M = span S`, `x ∈ S` and `x ∈ span (S \ {x}) ⊔ M²`, then `M = span (S \ {x})`
(Nakayama). -/
theorem span_erase_eq_of_mem {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] [DecidableEq A] {S : Finset A}
    (hS : Ideal.span (S : Set A) = maximalIdeal A) {x : A} (hxS : x ∈ S)
    (hx : x ∈ Ideal.span ((S.erase x : Finset A) : Set A) ⊔ maximalIdeal A ^ 2) :
    Ideal.span ((S.erase x : Finset A) : Set A) = maximalIdeal A := by
  refine le_antisymm (hS ▸ Ideal.span_mono (Finset.erase_subset _ _)) ?_
  refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := maximalIdeal A)
    (IsNoetherian.noetherian _) (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
  rw [← hS, Ideal.span_le]
  intro y hy
  by_cases hyx : y = x
  · subst hyx
    rw [hS, smul_eq_mul, ← pow_two]
    exact hx
  · exact Ideal.mem_sup_left (Ideal.subset_span (Finset.mem_erase.mpr ⟨hyx, hy⟩))

/-- A natural-number valued sandwich for the Krull dimension of a nontrivial ring. -/
theorem exists_nat_ringKrullDim_eq {A : Type u} [CommRing A] [Nontrivial A] {m : ℕ}
    (h : ringKrullDim A ≤ m) : ∃ k : ℕ, k ≤ m ∧ ringKrullDim A = k := by
  have h0 : (0 : WithBot ℕ∞) ≤ ringKrullDim A := ringKrullDim_nonneg_of_nontrivial
  obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp (ne_bot_of_le_ne_bot (by simp) h0)
  rw [← he] at h
  have he' : e ≤ m := by exact_mod_cast h
  obtain ⟨k, rfl⟩ := ENat.ne_top_iff_exists.mp (ne_top_of_le_ne_top (ENat.natCast_ne_top m) he')
  exact ⟨k, by exact_mod_cast he', by rw [← he]; rfl⟩

/-- If `x ∈ M \ M²` in a regular local ring `A`, then `A/xA` is a regular local ring whose
maximal ideal needs one generator less. -/
@[blueprint "lem:regular-quotient-hyperplane"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$ and
    $x\in M\setminus M^2$. Then $R/xR$ is a regular local ring, and its maximal ideal needs one
    generator less than $M$. -/)
  (proof := /-- Write $x=\sum_ic_is_i$ in a minimal system $S$ of generators of $M$; since
    $x\notin M^2$ some $c_{i_0}$ is a unit, so $x$ may replace $s_{i_0}$ in $S$, and the images
    of the remaining elements generate the maximal ideal of $R/xR$. On the other hand
    $\dim R\le\dim R/xR+1$ (Krull's principal ideal theorem), so the maximal ideal of $R/xR$
    is generated by $\dim R/xR$ elements. -/)
  (latexEnv := "lemma")]
theorem quotient_span_singleton_regular {A : Type u} [CommRing A] [IsRegularLocalRing A]
    {x : A} (hx : x ∈ maximalIdeal A) (hx2 : x ∉ maximalIdeal A ^ 2)
    [IsLocalRing (A ⧸ Ideal.span {x})] :
    IsRegularLocalRing (A ⧸ Ideal.span {x}) ∧
      (maximalIdeal (A ⧸ Ideal.span {x})).spanFinrank + 1 = (maximalIdeal A).spanFinrank := by
  classical
  set mk := Ideal.Quotient.mk (Ideal.span {x})
  obtain ⟨S, hS_card, hS_span⟩ :=
    (IsNoetherian.noetherian (maximalIdeal A)).exists_span_finset_card_eq_spanFinrank
  have hS : Ideal.span (S : Set A) = maximalIdeal A := hS_span
  -- write `x = Σ c_i s_i`; some coefficient is a unit since `x ∉ M²`
  obtain ⟨c, -, hc⟩ :=
    Submodule.mem_span_finset.mp (hS_span ▸ hx : x ∈ Submodule.span A (S : Set A))
  obtain ⟨i₀, hi₀S, hi₀⟩ : ∃ i ∈ S, c i ∉ maximalIdeal A := by
    by_contra! h
    apply hx2
    rw [← hc, pow_two]
    exact Ideal.sum_mem _ fun i hi => Ideal.mul_mem_mul (h i hi) (hS ▸ Ideal.subset_span hi)
  -- hence `M = span (insert x (S \ {i₀}))`
  have hi₀mem : i₀ ∈ Ideal.span (insert x ((S.erase i₀ : Finset A) : Set A)) := by
    have hsum := Finset.add_sum_erase S (fun i => c i • i) hi₀S
    rw [hc] at hsum
    have : c i₀ * i₀ = x - ∑ i ∈ S.erase i₀, c i • i := by
      rw [← hsum, smul_eq_mul]; ring
    refine (Ideal.unit_mul_mem_iff_mem _ ((IsLocalRing.notMem_maximalIdeal).mp hi₀)).mp ?_
    rw [this]
    refine sub_mem (Ideal.subset_span (Set.mem_insert _ _)) (Ideal.sum_mem _ fun i hi => ?_)
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ hi))
  have hM : maximalIdeal (A ⧸ Ideal.span {x}) =
      Ideal.span (mk '' ((S.erase i₀ : Finset A) : Set A)) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective]
    refine le_antisymm ?_ ?_
    · rw [Ideal.map_le_iff_le_comap, ← hS, Ideal.span_le]
      intro i hi
      have hi' : i ∈ Ideal.span (insert x ((S.erase i₀ : Finset A) : Set A)) := by
        by_cases h : i = i₀
        · exact h ▸ hi₀mem
        · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Finset.mem_erase.mpr ⟨h, hi⟩))
      have := Ideal.mem_map_of_mem mk hi'
      rw [Ideal.map_span, Set.image_insert_eq, Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_span_singleton_self x), Ideal.span_insert, Ideal.span_singleton_eq_bot.mpr rfl,
        bot_sup_eq] at this
      exact this
    · rw [Ideal.span_le]
      rintro _ ⟨i, hi, rfl⟩
      exact Ideal.mem_map_of_mem mk (hS ▸ Ideal.subset_span (Finset.mem_of_mem_erase hi))
  -- numerical consequences
  set n := (maximalIdeal A).spanFinrank with hn
  set m := (maximalIdeal (A ⧸ Ideal.span {x})).spanFinrank with hm
  have hmle : m + 1 ≤ n := by
    have h1 : m ≤ (mk '' ((S.erase i₀ : Finset A) : Set A)).ncard := by
      rw [hm, hM]
      exact Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)
    have h2 : (mk '' ((S.erase i₀ : Finset A) : Set A)).ncard ≤ (S.erase i₀).card := by
      rw [← Set.ncard_coe_finset]
      exact Set.ncard_image_le (Finset.finite_toSet _)
    have h3 := Finset.card_erase_add_one hi₀S
    omega
  have hdim1 : ringKrullDim A ≤ ringKrullDim (A ⧸ Ideal.span {x}) + 1 := by
    have h := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (Ideal.span {x})
      (by rw [← Ideal.jacobson_bot, IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top,
        Ideal.span_singleton_le_iff_mem]; exact hx)
    have h' : (Ideal.span {x}).spanFinrank ≤ 1 := by
      have := Submodule.spanFinrank_span_le_ncard_of_finite (R := A) (Set.finite_singleton x)
      rwa [Set.ncard_singleton] at this
    refine h.trans (add_le_add_right ?_ _)
    exact_mod_cast h'
  have hdim2 : ringKrullDim (A ⧸ Ideal.span {x}) ≤ m :=
    ringKrullDim_le_spanFinrank_maximalIdeal _
  obtain ⟨k, hkm, hk⟩ := exists_nat_ringKrullDim_eq hdim2
  have hnA : (n : WithBot ℕ∞) = ringKrullDim A := IsRegularLocalRing.spanFinrank_maximalIdeal
  rw [← hnA, hk] at hdim1
  have hnk : n ≤ k + 1 := by exact_mod_cast hdim1
  refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, by omega⟩
  rw [hk]
  exact_mod_cast (by omega : m ≤ k)

/-- A regular local ring is a domain.  Induction on the number `n` of generators of `M`: for
`n > 0` choose `x ∈ M \ M²` outside the (finitely many) minimal primes; `A/xA` is regular with
`n - 1` generators, hence a domain, so `xA` is prime and a minimal prime `Q ⊆ xA` satisfies
`Q = xQ`, whence `Q = 0` by Nakayama. -/
theorem isDomain_of_spanFinrank_eq (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A],
      (maximalIdeal A).spanFinrank = n → IsDomain A := by
  induction n with
  | zero =>
    intro A _ _ hn
    have hM : maximalIdeal A = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)).mp hn
    exact (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hM).isDomain
  | succ n ih =>
    intro A _ _ hn
    classical
    have hjac : maximalIdeal A ≤ (⊥ : Ideal A).jacobson :=
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
    have hMne : maximalIdeal A ≠ ⊥ := by
      intro h
      rw [h, Submodule.spanFinrank_bot] at hn
      omega
    -- `M ⊄ M²` (Nakayama)
    have hM2 : ¬ maximalIdeal A ≤ maximalIdeal A ^ 2 := by
      intro h
      refine hMne (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal A) _
        (IsNoetherian.noetherian _) ?_ hjac)
      rwa [smul_eq_mul, ← pow_two]
    -- `M` is not contained in a minimal prime, since `dim A = n + 1 > 0`
    have hMmin : ∀ Q ∈ minimalPrimes A, ¬ maximalIdeal A ≤ Q := by
      intro Q hQ hMQ
      have hQprime : Q.IsPrime := hQ.1.1
      have hQM : Q = maximalIdeal A :=
        le_antisymm (IsLocalRing.le_maximalIdeal hQprime.ne_top) hMQ
      have h0 : (maximalIdeal A).height = 0 := Ideal.height_eq_zero_iff.mpr (hQM ▸ hQ)
      have hdim : ringKrullDim A = 0 := by
        rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h0]; rfl
      have hnA : ((maximalIdeal A).spanFinrank : WithBot ℕ∞) = ringKrullDim A :=
        IsRegularLocalRing.spanFinrank_maximalIdeal
      rw [hdim, hn] at hnA
      exact absurd hnA (by norm_cast)
    -- prime avoidance: some `x ∈ M` avoids `M²` and all minimal primes
    have hfin := minimalPrimes.finite_of_isNoetherianRing A
    obtain ⟨x, hxM, hxnot⟩ : ∃ x ∈ maximalIdeal A,
        x ∉ maximalIdeal A ^ 2 ∧ ∀ Q ∈ minimalPrimes A, x ∉ Q := by
      let f : Option (Ideal A) → Ideal A := fun o => o.elim (maximalIdeal A ^ 2) id
      let s : Finset (Option (Ideal A)) := insert none (hfin.toFinset.image some)
      have hprime : ∀ i ∈ s, i ≠ none → i ≠ none → (f i).IsPrime := by
        intro i hi hne _
        obtain ⟨Q, hQ, rfl⟩ : ∃ Q ∈ hfin.toFinset, some Q = i := by
          simpa [s, hne] using hi
        exact (hfin.mem_toFinset.mp hQ).1.1
      have hnot : ¬ ((maximalIdeal A : Set A) ⊆
          ⋃ i ∈ (s : Set (Option (Ideal A))), (f i : Set A)) := by
        rw [Ideal.subset_union_prime none none hprime]
        rintro ⟨i, hi, hle⟩
        rcases Finset.mem_insert.mp hi with rfl | hi
        · exact hM2 hle
        · obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.mp hi
          exact hMmin Q (hfin.mem_toFinset.mp hQ) hle
      obtain ⟨x, hxM, hx⟩ := Set.not_subset.mp hnot
      refine ⟨x, hxM, fun h => hx ?_, fun Q hQ h => hx ?_⟩
      · exact Set.mem_biUnion (x := none) (Finset.mem_insert_self _ _) h
      · exact Set.mem_biUnion (x := some Q)
          (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (hfin.mem_toFinset.mpr hQ))) h
    -- `A/xA` is regular with `n` generators, hence a domain
    have := isLocalRing_quotient_of_le ((Ideal.span_singleton_le_iff_mem _).mpr hxM)
    obtain ⟨hreg, hrank⟩ := quotient_span_singleton_regular hxM hxnot.1
    have := hreg
    have hdom : IsDomain (A ⧸ Ideal.span {x}) := ih _ (by omega)
    have hxprime : (Ideal.span {x}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdom
    -- a minimal prime `Q ⊆ xA` satisfies `Q = xQ`, hence `Q = 0`
    obtain ⟨Q, hQ, hQx⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ Ideal.span {x})
    have hQprime : Q.IsPrime := hQ.1.1
    have hxQ : x ∉ Q := hxnot.2 Q hQ
    have hQle : Q ≤ Ideal.span {x} • Q := by
      intro q hq
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp (hQx hq)
      have ha : a ∈ Q := (hQprime.mem_or_mem hq).resolve_right hxQ
      rw [smul_eq_mul, mul_comm (Ideal.span {x}) Q]
      exact Ideal.mul_mem_mul ha (Ideal.mem_span_singleton_self x)
    have hQbot : Q = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (Ideal.span {x}) Q
      (IsNoetherian.noetherian _) hQle
      (((Ideal.span_singleton_le_iff_mem _).mpr hxM).trans hjac)
    have : (⊥ : Ideal A).IsPrime := hQbot ▸ hQprime
    exact IsDomain.of_bot_isPrime A

/-- A regular local ring is a domain. -/
@[blueprint "lem:regular-local-domain"
  (statement := /-- A regular local ring is an integral domain. -/)
  (proof := /-- Induction on the number $n$ of generators of the maximal ideal $M$. For $n=0$
    the ring is a field. For $n>0$ choose, by prime avoidance, $x\in M\setminus M^2$ outside
    the finitely many minimal primes of $R$. By \cref{lem:regular-quotient-hyperplane} and
    induction, $R/xR$ is a domain, so $xR$ is prime; a minimal prime $Q\subseteq xR$ then
    satisfies $Q=xQ$, whence $Q=0$ by Nakayama's lemma, and $(0)$ is prime. -/)
  (latexEnv := "lemma")]
theorem isDomain_of_isRegularLocalRing (A : Type u) [CommRing A] [IsRegularLocalRing A] :
    IsDomain A :=
  isDomain_of_spanFinrank_eq _ A rfl

/-- Lifting along `A → A/xA`: if the class of `a` lies in the ideal generated by a finset `V`,
then `a` lies in the ideal generated by `x` and chosen preimages of the elements of `V`. -/
theorem mem_span_insert_image_surjInv {A : Type u} [CommRing A] [DecidableEq A] (x a : A)
    (V : Finset (A ⧸ Ideal.span {x}))
    (ha : Ideal.Quotient.mk (Ideal.span {x}) a ∈ Ideal.span (V : Set (A ⧸ Ideal.span {x}))) :
    a ∈ Ideal.span ((insert x (V.image (Function.surjInv Ideal.Quotient.mk_surjective)) :
      Finset A) : Set A) := by
  set σ := Function.surjInv (Ideal.Quotient.mk_surjective (I := Ideal.span {x}))
  have hV : Ideal.span (V : Set (A ⧸ Ideal.span {x})) =
      (Ideal.span ((V.image σ : Finset A) : Set A)).map (Ideal.Quotient.mk (Ideal.span {x})) := by
    rw [Ideal.map_span, Finset.coe_image, Set.image_image]
    simp only [σ, Function.surjInv_eq, Set.image_id']
  rw [hV, Ideal.mem_quotient_iff_mem_sup] at ha
  rw [Finset.coe_insert, Ideal.span_insert, sup_comm]
  exact ha

/-- Generators of a prime with regular quotient.  If `P` is a prime of the regular local ring
`A` such that `A/P` is regular, then `P` is generated by a subset `T` of a minimal system `S` of
generators of `M` (i.e. by part of a regular system of parameters).  Induction on the number of
generators of `M`: if `P ⊆ M²` then `P = 0` by a dimension count; otherwise pick `x ∈ P \ M²`
and pass to `A/xA`. -/
theorem exists_finset_span_eq_prime_of_spanFinrank_eq (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] (P : Ideal A) [P.IsPrime],
      IsRegularLocalRing (A ⧸ P) → (maximalIdeal A).spanFinrank = n →
      ∃ S T : Finset A, Ideal.span (S : Set A) = maximalIdeal A ∧
        S.card = (maximalIdeal A).spanFinrank ∧ T ⊆ S ∧ Ideal.span (T : Set A) = P := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro A _ _ P _ hPreg hn
  classical
  have hPM : P ≤ maximalIdeal A := IsLocalRing.le_maximalIdeal Ideal.IsPrime.ne_top'
  by_cases hP2 : P ≤ maximalIdeal A ^ 2
  · -- `P ⊆ M²` forces `P = 0`
    obtain ⟨S, hS_card, hS_span⟩ :=
      (IsNoetherian.noetherian (maximalIdeal A)).exists_span_finset_card_eq_spanFinrank
    refine ⟨S, ∅, hS_span, hS_card, Finset.empty_subset _, ?_⟩
    rw [Finset.coe_empty, Ideal.span_empty]
    symm
    by_contra hPne
    set mk := Ideal.Quotient.mk P
    set σ := Function.surjInv (Ideal.Quotient.mk_surjective (I := P))
    -- lifting generators of `M/P` gives generators of `M`, so `n ≤ spanFinrank (M/P)`
    obtain ⟨U, hU_card, hU_span⟩ :=
      (IsNoetherian.noetherian (maximalIdeal (A ⧸ P))).exists_span_finset_card_eq_spanFinrank
    have hMbar : (maximalIdeal A).map mk = maximalIdeal (A ⧸ P) :=
      IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective
    have hU : Ideal.span (U : Set (A ⧸ P)) =
        (Ideal.span ((U.image σ : Finset A) : Set A)).map mk := by
      rw [Ideal.map_span, Finset.coe_image, Set.image_image]
      simp only [σ, mk, Function.surjInv_eq, Set.image_id']
    have hle : Ideal.span ((U.image σ : Finset A) : Set A) ≤ maximalIdeal A := by
      rw [Ideal.span_le]
      rintro _ hy
      obtain ⟨y, hyU, rfl⟩ := Finset.mem_image.mp hy
      have : mk (σ y) ∈ (maximalIdeal A).map mk := by
        rw [hMbar, show mk (σ y) = y from Function.surjInv_eq _ y, ← hU_span]
        exact Submodule.subset_span hyU
      rw [Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr hPM] at this
      exact this
    have hMeq : Ideal.span ((U.image σ : Finset A) : Set A) = maximalIdeal A := by
      refine le_antisymm hle (Submodule.le_of_le_smul_of_le_jacobson_bot (I := maximalIdeal A)
        (IsNoetherian.noetherian _) (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_)
      intro m hm
      have : mk m ∈ Ideal.span (U : Set (A ⧸ P)) := by
        have hU' : Ideal.span (U : Set (A ⧸ P)) = maximalIdeal (A ⧸ P) := hU_span
        rw [hU', ← hMbar]
        exact Ideal.mem_map_of_mem mk hm
      rw [hU, Ideal.mem_quotient_iff_mem_sup] at this
      exact (sup_le_sup_left (hP2.trans (by rw [smul_eq_mul, pow_two])) _) this
    have hne : (maximalIdeal A).spanFinrank ≤ (maximalIdeal (A ⧸ P)).spanFinrank := by
      rw [← hMeq, ← hU_card]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)).trans ?_
      rw [Set.ncard_coe_finset]
      exact Finset.card_image_le
    -- but `dim A/P + 1 ≤ dim A` since `A` is a domain and `P ≠ 0`
    have := isDomain_of_isRegularLocalRing A
    obtain ⟨r, hrP, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hPne
    have hdim := ringKrullDim_succ_le_of_surjective mk Ideal.Quotient.mk_surjective
      (mem_nonZeroDivisors_of_ne_zero hr0) (Ideal.Quotient.eq_zero_iff_mem.mpr hrP)
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal (R := A),
      ← IsRegularLocalRing.spanFinrank_maximalIdeal (R := A ⧸ P)] at hdim
    have : (maximalIdeal (A ⧸ P)).spanFinrank + 1 ≤ (maximalIdeal A).spanFinrank := by
      exact_mod_cast hdim
    omega
  · -- pick `x ∈ P \ M²` and pass to `A/xA`
    obtain ⟨x, hxP, hx2⟩ := Set.not_subset.mp hP2
    have hxM : x ∈ maximalIdeal A := hPM hxP
    have hxP' : Ideal.span {x} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hxP
    have := isLocalRing_quotient_of_le ((Ideal.span_singleton_le_iff_mem _).mpr hxM)
    obtain ⟨hreg, hrank⟩ := quotient_span_singleton_regular hxM hx2
    have := hreg
    set mk := Ideal.Quotient.mk (Ideal.span {x})
    set σ := Function.surjInv (Ideal.Quotient.mk_surjective (I := Ideal.span {x}))
    have hP'prime : (P.map mk).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hxP')
    have e : (A ⧸ Ideal.span {x}) ⧸ P.map mk ≃+* A ⧸ P :=
      (DoubleQuot.quotQuotEquivQuotSup (Ideal.span {x}) P).trans
        (Ideal.quotEquivOfEq (sup_eq_right.mpr hxP'))
    have hP'reg : IsRegularLocalRing ((A ⧸ Ideal.span {x}) ⧸ P.map mk) :=
      IsRegularLocalRing.of_ringEquiv e.symm
    obtain ⟨S', T', hS'span, hS'card, hT'S', hT'span⟩ :=
      ih _ (by omega) (A ⧸ Ideal.span {x}) (P.map mk) hP'reg rfl
    have hMbar : (maximalIdeal A).map mk = maximalIdeal (A ⧸ Ideal.span {x}) :=
      IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective
    have hSspan : Ideal.span ((insert x (S'.image σ) : Finset A) : Set A) = maximalIdeal A := by
      refine le_antisymm ?_ ?_
      · rw [Ideal.span_le, Finset.coe_insert]
        refine Set.insert_subset hxM ?_
        intro _ hy
        obtain ⟨y, hyS', rfl⟩ := Finset.mem_image.mp hy
        have : mk (σ y) ∈ (maximalIdeal A).map mk := by
          rw [hMbar, show mk (σ y) = y from Function.surjInv_eq _ y, ← hS'span]
          exact Ideal.subset_span hyS'
        rw [Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr
          ((Ideal.span_singleton_le_iff_mem _).mpr hxM)] at this
        exact this
      · intro m hm
        refine mem_span_insert_image_surjInv x m S' ?_
        rw [hS'span, ← hMbar]
        exact Ideal.mem_map_of_mem mk hm
    refine ⟨insert x (S'.image σ), insert x (T'.image σ), hSspan, ?_, ?_, ?_⟩
    · refine le_antisymm ?_ ?_
      · refine (Finset.card_insert_le _ _).trans ?_
        have := Finset.card_image_le (s := S') (f := σ)
        omega
      · calc (maximalIdeal A).spanFinrank
            = (Ideal.span ((insert x (S'.image σ) : Finset A) : Set A)).spanFinrank := by
              rw [hSspan]
          _ ≤ ((insert x (S'.image σ) : Finset A) : Set A).ncard :=
              Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)
          _ = (insert x (S'.image σ)).card := Set.ncard_coe_finset _
    · exact Finset.insert_subset_insert _ (Finset.image_subset_image hT'S')
    · refine le_antisymm ?_ ?_
      · rw [Ideal.span_le, Finset.coe_insert]
        refine Set.insert_subset hxP ?_
        intro _ hy
        obtain ⟨y, hyT', rfl⟩ := Finset.mem_image.mp hy
        have : mk (σ y) ∈ P.map mk := by
          rw [show mk (σ y) = y from Function.surjInv_eq _ y, ← hT'span]
          exact Ideal.subset_span hyT'
        rw [Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr hxP'] at this
        exact this
      · intro p hp
        refine mem_span_insert_image_surjInv x p T' ?_
        rw [hT'span]
        exact Ideal.mem_map_of_mem mk hp

/-- If `P` is a prime of the regular local ring `A` such that `A/P` is regular, then `P` is
generated by part of a regular system of parameters of `A`: there are a minimal system `S` of
generators of the maximal ideal (so `#S = dim A`) and `T ⊆ S` with `P = (T)`. -/
@[blueprint "lem:regular-quotient-rsop"
  (statement := /-- Let $R$ be a regular local ring and $P$ a prime ideal in $R$ such that $R/P$
    is regular. Then $P$ is generated by part of a regular system of parameters of $R$: there
    are a minimal system of generators $S$ of the maximal ideal and a subset $T\subseteq S$
    such that $P=(T)R$. (Used tacitly throughout Ch.~III.) -/)
  (proof := /-- Induction on the number of generators of the maximal ideal $M$. If
    $P\subseteq M^2$, a dimension count shows $P=0$. Otherwise choose $x\in P\setminus M^2$:
    $R/xR$ is regular and its maximal ideal needs one generator less
    (\cref{lem:regular-quotient-hyperplane}), and $P/xR$ is a prime of $R/xR$ with regular
    quotient $R/P$, so the induction hypothesis applies to it; lifting its generators and
    adding $x$ gives the claim. -/)
  (latexEnv := "lemma")]
theorem exists_finset_span_eq_prime (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (P : Ideal A) [P.IsPrime] (hP : IsRegularLocalRing (A ⧸ P)) :
    ∃ S T : Finset A, Ideal.span (S : Set A) = maximalIdeal A ∧
      S.card = (maximalIdeal A).spanFinrank ∧ T ⊆ S ∧ Ideal.span (T : Set A) = P :=
  exists_finset_span_eq_prime_of_spanFinrank_eq _ A P hP rfl

/-- Powers of an ideal generated by part of a minimal system of generators of `M` in a regular
local ring are primary.  If `span S = M` with `#S = spanFinrank M` and `P = span T` with
`T ⊆ S`, then `a ∉ P` and `a b ∈ Pᵛ` imply `b ∈ Pᵛ`.  Induction on `#T`: for `x ∈ T`
and `P' = span (T \ {x})`, the statement for `P'` gives `(P^(ν+1) : x) = Pᵛ` (as
`P^(ν+1) ⊆ P'^(ν+1) + x Pᵛ` and `x ∉ P'`), and the statement for `P/xA` in the regular
local ring `A/xA` gives `b ∈ P^(ν+1) + xA`; together with induction on `ν` this gives
`b ∈ P^(ν+1)`. -/
theorem mem_pow_of_mul_mem_pow_of_card_eq (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] (S T : Finset A),
      Ideal.span (S : Set A) = maximalIdeal A → S.card = (maximalIdeal A).spanFinrank →
      T ⊆ S → T.card = n → ∀ (ν : ℕ) (a b : A), a ∉ Ideal.span (T : Set A) →
        a * b ∈ Ideal.span (T : Set A) ^ ν → b ∈ Ideal.span (T : Set A) ^ ν := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro A _ _ S T hS hScard hTS hTcard
  classical
  rcases T.eq_empty_or_nonempty with rfl | ⟨x, hxT⟩
  · -- `T = ∅`: `A` is a domain
    have := isDomain_of_isRegularLocalRing A
    intro ν a b ha hab
    rw [Finset.coe_empty, Ideal.span_empty] at ha hab ⊢
    rcases Nat.eq_zero_or_pos ν with rfl | hν
    · simp
    · rw [Ideal.bot_pow hν.ne', Ideal.mem_bot] at hab ⊢
      rw [Ideal.mem_bot] at ha
      exact (mul_eq_zero.mp hab).resolve_left ha
  set P := Ideal.span (T : Set A) with hPdef
  set P' := Ideal.span ((T.erase x : Finset A) : Set A) with hP'def
  have hxS : x ∈ S := hTS hxT
  have hxM : x ∈ maximalIdeal A := hS ▸ Ideal.subset_span hxS
  have hxP : x ∈ P := Ideal.subset_span hxT
  have hP'P : P' ≤ P := Ideal.span_mono (Finset.erase_subset x T)
  -- `x ∉ span (S \ {x}) + M²`, by minimality of `S`
  have hxmin : x ∉ Ideal.span ((S.erase x : Finset A) : Set A) ⊔ maximalIdeal A ^ 2 := by
    intro h
    have h1 := span_erase_eq_of_mem hS hxS h
    have h2 : (maximalIdeal A).spanFinrank ≤ (S.erase x).card := by
      rw [← h1, ← Set.ncard_coe_finset]
      exact Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)
    have h3 := Finset.card_erase_add_one hxS
    omega
  have hx2 : x ∉ maximalIdeal A ^ 2 := fun h => hxmin (Ideal.mem_sup_right h)
  have hxP' : x ∉ P' := fun h => hxmin (Ideal.mem_sup_left
    (Ideal.span_mono (Finset.erase_subset_erase x hTS) h))
  -- the statement for `P'` in `A`
  have hTe : (T.erase x).card < n := by
    rw [Finset.card_erase_of_mem hxT]
    have := Finset.card_pos.mpr ⟨x, hxT⟩
    omega
  have hP' := ih _ hTe A S (T.erase x) hS hScard ((Finset.erase_subset x T).trans hTS) rfl
  -- `P = P' + xA`
  have hPeq : P = P' ⊔ Ideal.span {x} := by
    rw [hPdef, hP'def, sup_comm, ← Ideal.span_insert, ← Finset.coe_insert,
      Finset.insert_erase hxT]
  -- `P^(ν+1) ⊆ P'^(ν+1) + x Pᵛ`
  have hpow : ∀ ν : ℕ, P ^ (ν + 1) ≤ P' ^ (ν + 1) ⊔ Ideal.span {x} * P ^ ν := by
    intro ν
    induction ν with
    | zero => rw [zero_add, pow_one, pow_one, pow_zero, Ideal.one_eq_top, Ideal.mul_top, hPeq]
    | succ ν ihν =>
      calc P ^ (ν + 1 + 1) = P ^ (ν + 1) * P := pow_succ _ _
        _ ≤ (P' ^ (ν + 1) ⊔ Ideal.span {x} * P ^ ν) * P := Ideal.mul_mono_left ihν
        _ = P' ^ (ν + 1) * P ⊔ Ideal.span {x} * P ^ (ν + 1) := by
            rw [Ideal.sup_mul, mul_assoc, ← pow_succ]
        _ ≤ P' ^ (ν + 1 + 1) ⊔ Ideal.span {x} * P ^ (ν + 1) := by
            refine sup_le ?_ le_sup_right
            conv_lhs => rw [hPeq]
            rw [Ideal.mul_sup, ← pow_succ]
            refine sup_le le_sup_left (le_sup_of_le_right ?_)
            rw [mul_comm]
            exact Ideal.mul_mono_right (Ideal.pow_right_mono hP'P _)
  -- `(P^(ν+1) : x) ⊆ Pᵛ`
  have hcolon : ∀ (ν : ℕ) (z : A), x * z ∈ P ^ (ν + 1) → z ∈ P ^ ν := by
    intro ν z hz
    obtain ⟨q, hq, w, hw, hqw⟩ := Submodule.mem_sup.mp (hpow ν hz)
    obtain ⟨p, hp, rfl⟩ := Ideal.mem_span_singleton_mul.mp hw
    have h1 : x * (z - p) ∈ P' ^ (ν + 1) := by
      have : x * (z - p) = q := by rw [mul_sub, ← hqw]; ring
      rw [this]
      exact hq
    have h2 : z - p ∈ P ^ ν :=
      Ideal.pow_le_pow_right (Nat.le_succ ν) (Ideal.pow_right_mono hP'P _ (hP' _ x _ hxP' h1))
    simpa using add_mem h2 hp
  -- the quotient `A/xA`
  have := isLocalRing_quotient_of_le ((Ideal.span_singleton_le_iff_mem _).mpr hxM)
  obtain ⟨hreg, hrank⟩ := quotient_span_singleton_regular hxM hx2
  have := hreg
  set mk := Ideal.Quotient.mk (Ideal.span {x}) with hmk
  have hmkx : mk x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
  have hmap : ∀ V : Finset A, x ∈ V →
      (Ideal.span (V : Set A)).map mk = Ideal.span (((V.erase x).image mk : Finset _) : Set _) := by
    intro V hxV
    rw [Finset.coe_image]
    conv_lhs => rw [← Finset.insert_erase hxV]
    rw [Ideal.map_span, Finset.coe_insert, Set.image_insert_eq, hmkx, Ideal.span_insert,
      Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq]
  have hMbar : (maximalIdeal A).map mk = maximalIdeal (A ⧸ Ideal.span {x}) :=
    IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective
  have hS'span : Ideal.span ((((S.erase x).image mk) : Finset _) : Set (A ⧸ Ideal.span {x})) =
      maximalIdeal (A ⧸ Ideal.span {x}) := by
    rw [← hmap S hxS, hS, hMbar]
  have hS'card :
      ((S.erase x).image mk).card = (maximalIdeal (A ⧸ Ideal.span {x})).spanFinrank := by
    refine le_antisymm ?_ ?_
    · have h1 := Finset.card_image_le (s := S.erase x) (f := mk)
      have h2 := Finset.card_erase_add_one hxS
      omega
    · rw [← hS'span, ← Set.ncard_coe_finset]
      exact Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)
  have hT'card : ((T.erase x).image mk).card < n :=
    (Finset.card_image_le).trans_lt hTe
  have hQ := ih _ hT'card (A ⧸ Ideal.span {x}) ((S.erase x).image mk) ((T.erase x).image mk)
    hS'span hS'card (Finset.image_subset_image (Finset.erase_subset_erase x hTS)) rfl
  rw [← hmap T hxT] at hQ
  -- induction on `ν`
  intro ν
  induction ν with
  | zero => intro a b _ _; simp
  | succ ν ihν =>
    intro a b ha hab
    -- modulo `x`
    have hmkb : mk b ∈ (P.map mk) ^ (ν + 1) := by
      refine hQ (ν + 1) (mk a) (mk b) ?_ ?_
      · rw [Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr
          ((Ideal.span_singleton_le_iff_mem _).mpr hxP)]
        exact ha
      · rw [← map_mul, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem mk hab
    rw [← Ideal.map_pow, Ideal.mem_quotient_iff_mem_sup] at hmkb
    obtain ⟨c, hc, w, hw, rfl⟩ := Submodule.mem_sup.mp hmkb
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hw
    -- `x (a r) ∈ P^(ν+1)`, hence `a r ∈ Pᵛ`, hence `r ∈ Pᵛ`
    have h1 : x * (a * r) ∈ P ^ (ν + 1) := by
      have : a * (c + r * x) - a * c = x * (a * r) := by ring
      rw [← this]
      exact sub_mem hab (Ideal.mul_mem_left _ _ hc)
    have h3 : r ∈ P ^ ν := ihν a r ha (hcolon ν _ h1)
    exact add_mem hc (by rw [pow_succ]; exact Ideal.mul_mem_mul h3 hxP)

/-- If `Q` is a prime of the regular local ring `A` such that `A/Q` is regular, then every power
`Qᵛ` is `Q`-primary: `a ∉ Q` and `a b ∈ Qᵛ` imply `b ∈ Qᵛ`. -/
@[blueprint "lem:regular-quotient-primary-powers"
  (statement := /-- Let $R$ be a regular local ring and $P$ a prime ideal in $R$ such that $R/P$
    is regular. Then every power $P^\nu$ is $P$-primary: if $a\notin P$ and $ab\in P^\nu$, then
    $b\in P^\nu$. In particular $P^\nu R_P\cap R=P^\nu$. (Used on p.~217.) -/)
  (proof := /-- By \cref{lem:regular-quotient-rsop}, $P=(T)R$ with $T$ part of a minimal system
    $S$ of generators of $M$. Induction on $\#T$; for $T=\emptyset$ this is
    \cref{lem:regular-local-domain}. For $x\in T$ and $P'=(T\setminus\{x\})R$, the statement
    for $P'$ gives $(P^{\nu+1}:x)=P^\nu$ (as $P^{\nu+1}\subseteq P'^{\nu+1}+xP^\nu$ and
    $x\notin P'$), and the statement for $P/xR$ in the regular local ring $R/xR$ gives
    $b\in P^{\nu+1}+xR$; together with induction on $\nu$ this gives $b\in P^{\nu+1}$. -/)
  (latexEnv := "lemma")]
theorem mem_pow_of_mul_mem_pow_of_isRegularLocalRing_quotient {A : Type u} [CommRing A]
    [IsRegularLocalRing A] (Q : Ideal A) [Q.IsPrime] (hQ : IsRegularLocalRing (A ⧸ Q))
    (ν : ℕ) (a b : A) (ha : a ∉ Q) (hab : a * b ∈ Q ^ ν) : b ∈ Q ^ ν := by
  obtain ⟨S, T, hS, hScard, hTS, hT⟩ := exists_finset_span_eq_prime A Q hQ
  rw [← hT] at ha hab ⊢
  exact mem_pow_of_mul_mem_pow_of_card_eq _ A S T hS hScard hTS rfl ν a b ha hab

end Hironaka


module

public import Mathlib.Order.CompletePartialOrder
public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.KrullDimension.NonZeroDivisors
public import Mathlib.RingTheory.MvPowerSeries.Equiv
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.SimpleRing.Principal
public import Mathlib.RingTheory.MvPowerSeries.Inverse
public import Architect

/-!
# Compatibility layer: the formal power series ring `k⟦t₁,…,t_n⟧` is a regular local ring

Footnote 30 (p. 161) reduces property (c) of the class 𝔅 to "a homomorphic image of a polynomial
ring over such a formal power series ring" (over a field of characteristic zero), and uses without
comment that such rings are regular.  Mathlib has neither the dimension of `MvPowerSeries` nor its
regularity, so they are proved here:

* `mvPowerSeries_mem_span_X_of_constantCoeff_eq_zero`: a series with zero constant term is
  `Σ Xᵢ gᵢ`, so the maximal ideal is generated by the `n` variables;
* `ringKrullDim_powerSeries_ge`, `le_ringKrullDim_mvPowerSeries`: `dim R⟦X⟧ ≥ dim R + 1` (Krull
  dimension, via `R⟦X⟧/(X) ≅ R`), hence `dim k⟦t₁..t_n⟧ ≥ n`;
* `isRegularLocalRing_mvPowerSeries`: `k⟦t₁,…,t_n⟧` is a regular local ring (`n` generators of the
  maximal ideal, `dim ≥ n`, and always `dim ≤` number of generators).
-/

@[expose] public section

open MvPowerSeries IsLocalRing

noncomputable section

namespace Hironaka

universe u

section MaximalIdeal

variable {k : Type u} [Field k]

/-- A formal power series in `n` variables with zero constant term lies in the ideal generated by
the variables: `f = Σ Xᵢ gᵢ` with `gᵢ(m) = f(m + eᵢ)` if `mⱼ = 0` for all `j < i`, and `0`
otherwise. -/
theorem mvPowerSeries_mem_span_X_of_constantCoeff_eq_zero {n : ℕ} {f : MvPowerSeries (Fin n) k}
    (hf : constantCoeff f = 0) :
    f ∈ Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) k)) := by
  classical
  let g : Fin n → MvPowerSeries (Fin n) k := fun i m =>
    if ∀ j < i, m j = 0 then coeff (m + Finsupp.single i 1) f else 0
  have hg : ∀ (i : Fin n) (m' : Fin n →₀ ℕ), coeff m' (g i) =
      if ∀ j < i, m' j = 0 then coeff (m' + Finsupp.single i 1) f else 0 := fun _ _ => rfl
  have key : f = ∑ i, X i * g i := by
    ext m
    rw [map_sum]
    simp only [X, coeff_monomial_mul]
    by_cases hm0 : m = 0
    · subst hm0
      rw [coeff_zero_eq_constantCoeff_apply, hf]
      symm
      refine Finset.sum_eq_zero fun x _ => ?_
      have hx : ¬ (Finsupp.single x 1 ≤ (0 : Fin n →₀ ℕ)) := by
        intro hx
        have := Finsupp.single_le_iff.mp hx
        simp at this
      simp [hx]
    · obtain ⟨i₀, hi₀, hmin⟩ : ∃ i₀ : Fin n, 1 ≤ m i₀ ∧ ∀ j < i₀, m j = 0 := by
        have hne : (Finset.univ.filter fun i : Fin n => 1 ≤ m i).Nonempty := by
          by_contra hcon
          apply hm0
          ext i
          by_contra hi
          refine hcon ⟨i, ?_⟩
          simp only [Finset.mem_filter, Finset.mem_univ, true_and]
          simp at hi
          omega
        obtain ⟨i₀, hi₀mem, hi₀min⟩ := Finset.exists_min_image _ id hne
        refine ⟨i₀, (Finset.mem_filter.mp hi₀mem).2, fun j hj => ?_⟩
        by_contra hjm
        have : j ∈ Finset.univ.filter fun i : Fin n => 1 ≤ m i := by simp; omega
        exact absurd (hi₀min j this) (not_le.mpr hj)
      rw [Finset.sum_eq_single i₀]
      · have hle : Finsupp.single i₀ 1 ≤ m := Finsupp.single_le_iff.mpr hi₀
        have hcond : ∀ j < i₀, ((m - Finsupp.single i₀ 1 : Fin n →₀ ℕ) j) = 0 := by
          intro j hj
          simp [hj.ne, hmin j hj]
        simp only [hle, ↓reduceIte, one_mul]
        rw [hg]
        split_ifs
        rw [tsub_add_cancel_of_le hle]
      · intro i _ hne
        by_cases hle : Finsupp.single i 1 ≤ m
        · have hnot : ¬ ∀ j < i, ((m - Finsupp.single i 1 : Fin n →₀ ℕ) j) = 0 := by
            intro hall
            rcases lt_or_gt_of_ne hne with hlt | hlt
            · have := hmin i hlt
              have h1 := Finsupp.single_le_iff.mp hle
              omega
            · have := hall i₀ hlt
              simp [hlt.ne] at this
              omega
          simp only [hle, ↓reduceIte, one_mul]
          rw [hg]
          split_ifs
          rfl
        · simp [hle]
      · intro h; exact absurd (Finset.mem_univ _) h
  rw [key]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)

end MaximalIdeal

section DimLowerBound

variable (R : Type u) [CommRing R]

theorem powerSeriesX_mem_nonZeroDivisors :
    (PowerSeries.X : PowerSeries R) ∈ nonZeroDivisors (PowerSeries R) := by
  rw [mem_nonZeroDivisors_iff]
  refine ⟨fun y hy => ?_, fun y hy => ?_⟩
  · exact PowerSeries.X_mul_cancel (by rw [mul_zero]; exact hy)
  · exact PowerSeries.X_mul_cancel (by rw [mul_zero, mul_comm]; exact hy)

/-- `R⟦X⟧/(X) ≅ R`. -/
def powerSeriesQuotientXEquiv :
    PowerSeries R ⧸ Ideal.span {(PowerSeries.X : PowerSeries R)} ≃+* R :=
  (Ideal.quotEquivOfEq (by
      ext φ
      rw [RingHom.mem_ker, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff] :
        Ideal.span {(PowerSeries.X : PowerSeries R)} =
          RingHom.ker (PowerSeries.constantCoeff (R := R)))).trans
    (RingHom.quotientKerEquivOfSurjective (f := (PowerSeries.constantCoeff (R := R)))
      (fun r => ⟨PowerSeries.C r, by simp⟩))

theorem ringKrullDim_powerSeries_ge : ringKrullDim R + 1 ≤ ringKrullDim (PowerSeries R) := by
  have h := ringKrullDim_quotient_succ_le_of_nonZeroDivisor (powerSeriesX_mem_nonZeroDivisors R)
  rwa [ringKrullDim_eq_of_ringEquiv (powerSeriesQuotientXEquiv R)] at h

end DimLowerBound

section Regular

variable (k : Type u) [Field k]

theorem le_ringKrullDim_mvPowerSeries : ∀ n : ℕ,
    (n : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin n) k) := by
  intro n
  induction n with
  | zero => simpa using ringKrullDim_nonneg_of_nontrivial (R := MvPowerSeries (Fin 0) k)
  | succ n ih =>
    rw [ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv (R := k) n).toRingEquiv]
    have h := ringKrullDim_powerSeries_ge (MvPowerSeries (Fin n) k)
    refine le_trans ?_ h
    push_cast
    exact add_le_add_left ih 1

theorem mvPowerSeriesMaximalIdeal_eq_span_X (n : ℕ) :
    maximalIdeal (MvPowerSeries (Fin n) k) =
      Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) k)) := by
  ext f
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
    isUnit_iff_ne_zero, not_not]
  constructor
  · exact mvPowerSeries_mem_span_X_of_constantCoeff_eq_zero
  · intro hf
    have hle : Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) k)) ≤
        RingHom.ker (constantCoeff (σ := Fin n) (R := k)) :=
      Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; simp)
    exact RingHom.mem_ker.mp (hle hf)

/-- **The formal power series ring `k⟦t₁,…,t_n⟧` over a field is a regular local ring.** -/
@[blueprint "lem:mv-power-series-regular"
  (statement := /-- Let $k$ be a field. The formal power series ring $k[[t_1,\dots,t_n]]$ is a
    regular local ring. -/)
  (proof := /-- It is a noetherian local ring whose maximal ideal is generated by
    $t_1,\dots,t_n$ (a series with zero constant term is $\sum t_ig_i$). Its Krull dimension is
    at least $n$ since $\dim R[[X]]\ge\dim R+1$ ($R[[X]]/(X)\cong R$ and $X$ is a
    non-zero-divisor). Since $\dim\le$ the number of generators of the maximal ideal (Krull),
    the maximal ideal needs exactly $\dim$ generators. \textbf{Deviation from the paper (gap
    filled).} Footnote~30 (p.~161) speaks of ``a homomorphic image of a formal power series ring
    over a field of characteristic zero'' and uses its regularity without comment. -/)
  (latexEnv := "lemma")]
theorem isRegularLocalRing_mvPowerSeries (n : ℕ) :
    IsRegularLocalRing (MvPowerSeries (Fin n) k) := by
  classical
  have hdim := le_ringKrullDim_mvPowerSeries k n
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le (MvPowerSeries (Fin n) k)
    (le_trans ?_ hdim)
  rw [mvPowerSeriesMaximalIdeal_eq_span_X]
  have hle := Submodule.spanFinrank_span_le_ncard_of_finite
    (R := MvPowerSeries (Fin n) k) (Set.finite_range (X : Fin n → MvPowerSeries (Fin n) k))
  have hcard : (Set.range (X : Fin n → MvPowerSeries (Fin n) k)).ncard ≤ n := by
    calc (Set.range (X : Fin n → MvPowerSeries (Fin n) k)).ncard
        ≤ (Finset.univ : Finset (Fin n)).card := by
          rw [← Set.image_univ, ← Finset.coe_univ, ← Finset.coe_image, Set.ncard_coe_finset]
          exact Finset.card_image_le
      _ = n := by simp
  exact_mod_cast hle.trans hcard

end Regular

end Hironaka

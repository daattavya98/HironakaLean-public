/-!
# Compatibility layer: localization of a regular frame (Ch. III § 9, used in Ch. IV § 3)

The localization of a regular frame `(S; z)` (`r = 1`) of a regular local ring `R` at a prime
`P ∋ z` of `R` is a regular frame `(S_{P ∩ S}; z)` of `R_P` (`RegularFrame.localizeAtPrime`).
This is the statement used on p. 303 in the proof of Lemma (AB.5): "if `T_0` denotes the
localization of `T` with respect to the prime ideal `P̂_0 ∩ T`, then `(T_0; z)` is a regular
frame of `Ŝ_0`".  The paper asserts it without proof.

* `exists_localization_quotient_equiv_apply`: `R_p/(I R_p) ≅ (R/I)_{p/I}`, compatible with the
  maps from `R`;
* `isRegularLocalRing_localization_quotient_span_singleton`: `R_P/(z)` is regular when `z` is a
  member of a regular system of parameters of `R` and `z ∈ P`;
* `extendsToRSOP_singleton_of_isRegularLocalRing_quotient`: a nonzero `y ∈ M` with `R/(y)`
  regular extends to a regular system of parameters;
* `bijective_quotient_comp_localRingHom`: `S_p → R_P → R_P/(z)` is bijective;
* `maximalIdeal_eq_span_sup_map`, `exists_extendsToRSOP_insert`: `M_R = (z) + M_S R`, and
  `M_S R` is generated by part of a regular system of parameters;
* `ordElem_pow_add_sum_eq`: `ν_M(z^ν + c_1 z^{ν-1} + ⋯ + c_ν) = ν` for `c_i ∈ M_S^i` (the step
  "(b) of (2) follows from (3) and (4)", p. 304);
* `MonoidalTransform.exists_isResiduallySeparableAlgebraic_localization_equiv`: a monoidal
  transform is a localization of a residually separable algebraic one (a closed point of the
  fibre; p. 305);
* `MonoidalTransform.strictTransformIdeal_eq_map_of_comp_eq`: the strict transform commutes with
  the passage to a localization of the transform;
* `ordElem_and_grIdeal_localization_of_frame`: (a) and (b) of (2) at the first stage of the proof
  of Lemma (AB.5): in `R_P` the elements `g_k = z^{ν_k} + ⋯` have order `ν_k` and their initial
  forms generate `gr(J R_P)` (`cor:III.thm5-3c`).
-/

@[expose] public section

open IsLocalRing

namespace Hironaka
universe u
noncomputable section

namespace RegularFrame

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

theorem exists_localization_quotient_equiv_apply {R : Type u} [CommRing R] (I p : Ideal R) [p.IsPrime]
    (hp : I ≤ p) :
    have : (p.map (Ideal.Quotient.mk I)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
        rw [Ideal.mk_ker]; exact hp)
    ∃ e : (Localization.AtPrime p ⧸ I.map (algebraMap R (Localization.AtPrime p))) ≃+*
      Localization.AtPrime (p.map (Ideal.Quotient.mk I)), ∀ r : R,
        e (Ideal.Quotient.mk _ (algebraMap R (Localization.AtPrime p) r)) =
          algebraMap (R ⧸ I) _ (Ideal.Quotient.mk I r) := by
  have : (p.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
      rw [Ideal.mk_ker]; exact hp)
  have hcomap : p = (p.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) := by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective p,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact (sup_eq_left.mpr hp).symm
  let φ := Localization.localRingHom p (p.map (Ideal.Quotient.mk I)) (Ideal.Quotient.mk I) hcomap
  have hφ : Function.Surjective φ := by
    intro y
    obtain ⟨b, s, rfl⟩ := IsLocalization.exists_mk'_eq (p.map (Ideal.Quotient.mk I)).primeCompl y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨s0, hs0⟩ := Ideal.Quotient.mk_surjective (s : R ⧸ I)
    have hs0p : s0 ∉ p := fun h => s.2 (hs0 ▸ Ideal.mem_map_of_mem _ h)
    refine ⟨IsLocalization.mk' (Localization.AtPrime p) a (⟨s0, hs0p⟩ : p.primeCompl), ?_⟩
    simp only [φ, Localization.localRingHom, IsLocalization.map_mk']
    congr 1
    exact Subtype.ext hs0
  have hker : RingHom.ker φ = I.map (algebraMap R (Localization.AtPrime p)) := by
    refine le_antisymm ?_ ?_
    · intro x hx
      obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq p.primeCompl x
      simp only [RingHom.mem_ker, φ, Localization.localRingHom, IsLocalization.map_mk'] at hx
      rw [IsLocalization.mk'_eq_zero_iff] at hx
      obtain ⟨t, ht⟩ := hx
      obtain ⟨t0, ht0e⟩ := Ideal.Quotient.mk_surjective (t : R ⧸ I)
      have ht0 : t0 ∉ p := fun h => t.2 (ht0e ▸ Ideal.mem_map_of_mem _ h)
      have hmem : t0 * a ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, ht0e]
        simpa [mul_comm] using ht
      have : IsLocalization.mk' (Localization.AtPrime p) a s =
          IsLocalization.mk' (Localization.AtPrime p) (t0 * a) (⟨t0, ht0⟩ * s) := by
        rw [IsLocalization.mk'_eq_iff_eq]
        simp only [Submonoid.coe_mul]
        ring_nf
      rw [this, IsLocalization.mk'_eq_mul_mk'_one]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)
    · rw [Ideal.map_le_iff_le_comap]
      intro i hi
      rw [Ideal.mem_comap, RingHom.mem_ker]
      simp only [φ, Localization.localRingHom_to_map]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hi, map_zero]
  refine ⟨(Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hφ), fun r => ?_⟩
  simp only [RingEquiv.trans_apply]
  show φ (algebraMap R _ r) = _
  simp only [φ, Localization.localRingHom_to_map]


/-- The quotient `R_P/(z)` of a localization of a regular local ring `R` at a prime `P ∋ z`,
for `z` a member of a regular system of parameters of `R`, is a regular local ring (Serre:
`R_P/(z) ≅ (R/(z))_{P/(z)}`). -/
theorem isRegularLocalRing_localization_quotient_span_singleton [Hironaka.HironakaCitedResults.{u}] {z : R}
    (hz : ExtendsToRSOP R {z}) (P : Ideal R) [P.IsPrime] (hzP : z ∈ P) :
    IsRegularLocalRing (Localization.AtPrime P ⧸
      Ideal.span {algebraMap R (Localization.AtPrime P) z}) := by
  have hreg : IsRegularLocalRing (R ⧸ Ideal.span {z}) :=
    hz.isRegularLocalRing_quotient_span_singleton (Finset.mem_singleton_self _)
  have hle : Ideal.span {z} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hzP
  obtain ⟨e⟩ := nonempty_localization_quotient_equiv (Ideal.span {z}) P hle
  have : (P.map (Ideal.Quotient.mk (Ideal.span {z}))).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
      rw [Ideal.mk_ker]; exact hle)
  have h := isRegularLocalRing_localization_of_isRegularLocalRing (R ⧸ Ideal.span {z})
    (P.map (Ideal.Quotient.mk (Ideal.span {z})))
  have hmap : (Ideal.span {z}).map (algebraMap R (Localization.AtPrime P)) =
      Ideal.span {algebraMap R (Localization.AtPrime P) z} := by
    rw [Ideal.map_span, Set.image_singleton]
  rw [hmap] at e
  exact IsRegularLocalRing.of_ringEquiv e.symm

/-- Converse of `isRegularLocalRing_quotient_span_singleton`: `y ≠ 0` in the maximal ideal with
`R/(y)` regular extends to a regular system of parameters. -/
theorem extendsToRSOP_singleton_of_isRegularLocalRing_quotient {y : R}
    (hy : y ∈ maximalIdeal R) (hy0 : y ≠ 0) [IsRegularLocalRing (R ⧸ Ideal.span {y})] :
    ExtendsToRSOP R {y} := by
  classical
  obtain ⟨-, W, hW⟩ :=
    (isRegularLocalRing_iff_exists_rsop (R ⧸ Ideal.span {y})).mp inferInstance
  have h := rsop_extends_insert_of_quotient hy hy0 (V := ∅)
    (by rw [Finset.image_empty]; exact ⟨W, Finset.empty_subset _, hW⟩) (by simp)
  simpa using h


/-- The localization of a frame `(S; z)` (`r = 1`) at a prime `P ∋ z`:
`S_{P ∩ S} → R_P → R_P/(z)` is bijective. -/
theorem bijective_quotient_comp_localRingHom (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (P : Ideal R) [P.IsPrime] (hzP : z ∈ P) :
    Function.Bijective ((Ideal.Quotient.mk (Ideal.span {algebraMap R (Localization.AtPrime P) z})).comp
      (Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl)) := by
  classical
  have hrange : Set.range F.z = {z} := by
    ext w
    constructor
    · rintro ⟨i, rfl⟩; exact hz i
    · rintro rfl
      have : 0 < F.r := by omega
      exact ⟨⟨0, this⟩, hz _⟩
  have hφ0 : Function.Bijective ((Ideal.Quotient.mk (Ideal.span {z})).comp (algebraMap F.S R)) := by
    have := F.quot_bijective
    rwa [show Ideal.span (Set.range F.z) = Ideal.span {z} by rw [hrange]] at this
  have hle : Ideal.span {z} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hzP
  have hP' : (P.map (Ideal.Quotient.mk (Ideal.span {z}))).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by
      rw [Ideal.mk_ker]; exact hle)
  obtain ⟨e, he⟩ := exists_localization_quotient_equiv_apply (Ideal.span {z}) P hle
  set I := Ideal.span {z} with hI
  set P' := P.map (Ideal.Quotient.mk I) with hP'def
  set φ0 := (Ideal.Quotient.mk I).comp (algebraMap F.S R) with hφ0def
  have hmapz : I.map (algebraMap R (Localization.AtPrime P)) =
      Ideal.span {algebraMap R (Localization.AtPrime P) z} := by
    rw [hI, Ideal.map_span, Set.image_singleton]
  have hcomapP : P'.comap (Ideal.Quotient.mk I) = P := by
    rw [hP'def, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective P,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact sup_eq_left.mpr hle
  have hpP' : P.comap (algebraMap F.S R) = P'.comap φ0 := by
    rw [hφ0def, ← Ideal.comap_comap, hcomapP]
  -- `S_p ≅ (R/(z))_{P'}`
  let φ0e : F.S ≃+* R ⧸ I := RingEquiv.ofBijective φ0 hφ0
  have hH : (P.comap (algebraMap F.S R)).primeCompl.map φ0e.toMonoidHom = P'.primeCompl := by
    ext x
    constructor
    · rintro ⟨s, hs, rfl⟩ hmem
      apply hs
      show s ∈ P.comap (algebraMap F.S R)
      rw [hpP']
      exact hmem
    · intro hx
      refine ⟨φ0e.symm x, ?_, by simp⟩
      intro hmem
      apply hx
      have h1 : φ0e.symm x ∈ P'.comap φ0 := by rw [← hpP']; exact hmem
      rw [Ideal.mem_comap] at h1
      have e1 : φ0 (φ0e.symm x) = x := φ0e.apply_symm_apply x
      rwa [e1] at h1
  let L := IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (P.comap (algebraMap F.S R)))
    (Localization.AtPrime P') φ0e hH
  let e' := (Ideal.quotEquivOfEq hmapz.symm).trans e
  have key : ∀ x, e' ((Ideal.Quotient.mk (Ideal.span {algebraMap R (Localization.AtPrime P) z})).comp
      (Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl) x) = L x := by
    intro x
    have hext : (e'.toRingHom.comp ((Ideal.Quotient.mk _).comp (Localization.localRingHom
        (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl))).comp
          (algebraMap F.S (Localization.AtPrime (P.comap (algebraMap F.S R)))) =
        L.toRingHom.comp (algebraMap F.S (Localization.AtPrime (P.comap (algebraMap F.S R)))) := by
      ext s
      simp only [RingHom.comp_apply]
      rw [Localization.localRingHom_to_map]
      show e (Ideal.quotEquivOfEq hmapz.symm _) = _
      rw [Ideal.quotEquivOfEq_mk, he]
      exact (IsLocalization.ringEquivOfRingEquiv_eq (S := Localization.AtPrime
        (P.comap (algebraMap F.S R))) (Q := Localization.AtPrime P') hH s).symm
    exact DFunLike.congr_fun (IsLocalization.ringHom_ext (P.comap (algebraMap F.S R)).primeCompl
      hext) x
  have hbij : Function.Bijective (fun x => e' ((Ideal.Quotient.mk (Ideal.span
      {algebraMap R (Localization.AtPrime P) z})).comp
      (Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl) x)) := by
    have : (fun x => e' ((Ideal.Quotient.mk (Ideal.span
      {algebraMap R (Localization.AtPrime P) z})).comp
      (Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl) x)) = L := by
      funext x; exact key x
    rw [this]
    exact L.bijective
  have h2 : Function.Bijective ((Ideal.Quotient.mk (Ideal.span
      {algebraMap R (Localization.AtPrime P) z})).comp
      (Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl)) := by
    have := e'.symm.bijective.comp hbij
    convert this using 1
    funext x
    simp
  exact h2


/-- A frame with `r = 1` and `z_1 = z` has `z` extending to a regular system of parameters. -/
theorem extendsToRSOP_singleton_of_r_eq_one (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) : ExtendsToRSOP R {z} := by
  classical
  have h : Finset.image F.z Finset.univ = {z} := by
    ext w
    simp only [Finset.mem_image, Finset.mem_univ, true_and, Finset.mem_singleton]
    constructor
    · rintro ⟨i, rfl⟩; exact hz i
    · rintro rfl
      have : 0 < F.r := by omega
      exact ⟨⟨0, this⟩, hz _⟩
  have := F.extends_rsop
  rwa [h] at this


/-- **The localization `(S_p; z)` of a regular frame `(S; z)` (`r = 1`) of `R`** at a prime `P ∋ z`
of `R`, `p = P ∩ S`, as a regular frame of the regular local ring `R_P` (p. 303: "if `T_0`
denotes the localization of `T` with respect to the prime ideal `P̂_0 ∩ T`, then `(T_0; z)` is a
regular frame of `Ŝ_0`").

\textbf{Deviation from the paper (gap filled).} The paper asserts that `(T_0; z)` is a regular
frame of `Ŝ_0` without proof.  Here: `S_p` is regular (Serre, the cited leaf), `z` is a regular
parameter of `R_P` because `R_P/(z) ≅ (R/(z))_{P/(z)}` is regular (Serre), and
`S_p → R_P → R_P/(z)` is the localization at `p` of the bijection `S → R → R/(z)`
(`bijective_quotient_comp_localRingHom`). -/
@[blueprint "def:IV.AB-5-frame-localization"
  (statement := /-- Let $(S;z)$ be a regular frame of a regular local ring $R$ with one
    element ($r=1$), and $P$ a prime ideal of $R$ with $z\in P$. Then $(S_{P\cap S};z)$ is a
    regular frame of the regular local ring $R_P$. (p.~303: ``if $T_0$ denotes the localization
    of $T$ with respect to the prime ideal $\hat P_0\cap T$, then $(T_0;z)$ is a regular frame of
    $\hat S_0$''.) -/)
  (proof := /-- $S_{P\cap S}$ is regular (Serre, \cref{lem:regular-localization-serre}); $R_P/(z)\cong
    (R/(z))_{P/(z)}$ is regular (Serre), so $z$ is part of a regular system of parameters of
    $R_P$; and $S_{P\cap S}\to R_P\to R_P/(z)$ is the localization at $P\cap S$ of the bijection
    $S\to R\to R/(z)$.

    \textbf{Deviation from the paper (gap filled).} The paper asserts that $(T_0;z)$ is a
    regular frame of $\hat S_0$ without proof (p.~303). -/)
  (proofUses := ["lem:regular-localization-serre"])
  (latexEnv := "definition")]
noncomputable def localizeAtPrime [Hironaka.HironakaCitedResults.{u}] (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (P : Ideal R) [P.IsPrime] (hzP : z ∈ P)
    [IsRegularLocalRing (Localization.AtPrime P)] :
    RegularFrame (Localization.AtPrime P) where
  S := Localization.AtPrime (P.comap (algebraMap F.S R))
  commRing := inferInstance
  isRegular := isRegularLocalRing_localization_of_isRegularLocalRing F.S _
  algebra := (Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R)
    rfl).toAlgebra
  isLocalHom := by
    show IsLocalHom (Localization.localRingHom (P.comap (algebraMap F.S R)) P
      (algebraMap F.S R) rfl)
    infer_instance
  r := 1
  z := fun _ => algebraMap R (Localization.AtPrime P) z
  z_injective := Function.injective_of_subsingleton _
  extends_rsop := by
    classical
    have hz' := extendsToRSOP_singleton_of_r_eq_one F z hr hz
    have hz0 : algebraMap R (Localization.AtPrime P) z ≠ 0 := by
      have : IsDomain R := isDomain_of_isRegularLocalRing R
      exact fun h => hz'.ne_zero (Finset.mem_singleton_self _)
        (IsLocalization.injective (Localization.AtPrime P)
          (Ideal.primeCompl_le_nonZeroDivisors P) (h.trans (map_zero _).symm))
    have hzM : algebraMap R (Localization.AtPrime P) z ∈ maximalIdeal (Localization.AtPrime P) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff _ P z).mpr hzP
    have := isRegularLocalRing_localization_quotient_span_singleton hz' P hzP
    have h := extendsToRSOP_singleton_of_isRegularLocalRing_quotient hzM hz0
    have himg : Finset.image (fun _ : Fin 1 => algebraMap R (Localization.AtPrime P) z)
        Finset.univ = {algebraMap R (Localization.AtPrime P) z} := by
      ext w; simp
    rw [himg]; exact h
  quot_bijective := by
    have hrange : Set.range (fun _ : Fin 1 => algebraMap R (Localization.AtPrime P) z) =
        {algebraMap R (Localization.AtPrime P) z} := by
      ext w; simp
    rw [hrange]
    exact bijective_quotient_comp_localRingHom F z hr hz P hzP

/-- For a frame `(S; z)` with `r = 1`, the maximal ideal of `R` is `(z) + M_S R`. -/
theorem maximalIdeal_eq_span_sup_map (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (hzM : z ∈ maximalIdeal R) :
    maximalIdeal R = Ideal.span {z} ⊔ (maximalIdeal F.S).map (algebraMap F.S R) := by
  have h := eq_span_sup_map_comap_of_mem F z hz hr (maximalIdeal R) hzM
  have hc : (maximalIdeal R).comap (algebraMap F.S R) = maximalIdeal F.S := by
    ext a
    simp only [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff]
    exact not_congr ⟨fun hu => isUnit_of_map_unit _ _ hu, fun hu => hu.map _⟩
  rw [hc] at h
  exact h

open Classical in
/-- The ideal `M_S R` is generated by part `V` of a regular system of parameters of `R`
containing `z`, with `z ∉ V` (take a regular system of parameters of `S ≅ R/(z)` and lift). -/
theorem exists_extendsToRSOP_insert (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) :
    ∃ V : Finset R, Ideal.span (V : Set R) = (maximalIdeal F.S).map (algebraMap F.S R) ∧
      z ∉ V ∧ ExtendsToRSOP R (insert z V) := by
  have hz' := extendsToRSOP_singleton_of_r_eq_one F z hr hz
  have hzM : z ∈ maximalIdeal R := hz'.mem_maximalIdeal (Finset.mem_singleton_self _)
  have hz0 : z ≠ 0 := hz'.ne_zero (Finset.mem_singleton_self _)
  have hregq : IsRegularLocalRing (R ⧸ Ideal.span {z}) :=
    hz'.isRegularLocalRing_quotient_span_singleton (Finset.mem_singleton_self _)
  have hrange : Set.range F.z = {z} := by
    ext w
    constructor
    · rintro ⟨i, rfl⟩; exact hz i
    · rintro rfl
      have : 0 < F.r := by omega
      exact ⟨⟨0, this⟩, hz _⟩
  have hφ0 : Function.Bijective ((Ideal.Quotient.mk (Ideal.span {z})).comp (algebraMap F.S R)) := by
    have := F.quot_bijective
    rwa [show Ideal.span (Set.range F.z) = Ideal.span {z} by rw [hrange]] at this
  let φ0e : F.S ≃+* R ⧸ Ideal.span {z} := RingEquiv.ofBijective _ hφ0
  obtain ⟨-, Y, hY⟩ := (isRegularLocalRing_iff_exists_rsop F.S).mp inferInstance
  set V : Finset R := Y.image (algebraMap F.S R) with hV
  have hVq : V.image (Ideal.Quotient.mk (Ideal.span {z})) = Y.image φ0e := by
    rw [hV, Finset.image_image]; rfl
  have hinj : Set.InjOn (Ideal.Quotient.mk (Ideal.span {z})) (V : Set R) := by
    intro a ha b hb hab
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨y', hy', rfl⟩ := Finset.mem_image.mp hb
    have : φ0e y = φ0e y' := hab
    rw [φ0e.injective this]
  have hext : ExtendsToRSOP (R ⧸ Ideal.span {z}) (V.image (Ideal.Quotient.mk (Ideal.span {z}))) := by
    rw [hVq]
    exact ⟨Y.image φ0e, subset_rfl, isRegularSystemOfParameters_image_ringEquiv φ0e hY⟩
  have hins := rsop_extends_insert_of_quotient hzM hz0 hext hinj
  refine ⟨V, ?_, ?_, hins⟩
  · rw [hV, Finset.coe_image, ← Ideal.map_span, hY.1]
  · intro hzV
    have hzq : Ideal.Quotient.mk (Ideal.span {z}) z ∈ V.image (Ideal.Quotient.mk (Ideal.span {z})) :=
      Finset.mem_image_of_mem _ hzV
    have h0 : Ideal.Quotient.mk (Ideal.span {z}) z = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self z)
    exact hext.ne_zero hzq h0

/-- **The order of `z^ν + c_1 z^{ν-1} + ⋯ + c_ν`** for a frame `(S; z)` (`r = 1`) of `R` and
coefficients `c_i ∈ M_S^i`: its order along the maximal ideal of `R` is exactly `ν`.  This is
the step "(b) of (2) follows from (3) and (4)" of the proof of Lemma (AB.5) (p. 304): from
`ν(J̄(t)_{x̂'_t}) ≥ b` one gets `ν_{T̄}(g_{jki}) ≥ i`, hence `ν_M(g_{jk}(t)) = ν_{jk}`.

\textbf{Deviation from the paper (gap filled).} The paper does not argue.  Proof: `≥ ν` is clear;
for `≤ ν`, modulo `M_S R` (generated by part `V` of a regular system of parameters) the element
becomes `z^ν`, and `R/M_S R` is a regular local ring (a domain) with maximal ideal `(z)` and
`z ≠ 0`, so `z^ν ∉ (z)^{ν+1}`. -/
@[blueprint "lem:IV.AB-5-frame-order"
  (statement := /-- Let $(S;z)$ be a regular frame of a regular local ring $R$ with $r=1$, and
    $c_i\in M_S^{\,i}$ $(1\le i\le\nu)$. Then
    $\nu_M(z^\nu+c_1z^{\nu-1}+\dots+c_\nu)=\nu$, $M$ the maximal ideal of $R$.
    (p.~304: ``(b) of (2) follows from (3) and (4)''.) -/)
  (proof := /-- $\ge\nu$ is clear. Modulo $M_SR$, which is generated by part $V$ of a regular
    system of parameters of $R$ not containing $z$, the element becomes $z^\nu$, and $R/(V)$ is a
    regular local ring (hence a domain) with maximal ideal $(\bar z)$, $\bar z\ne0$; so
    $\bar z^\nu\notin(\bar z)^{\nu+1}$.

    \textbf{Deviation from the paper (gap filled).} The paper does not argue (p.~304). -/)
  (latexEnv := "lemma")]
theorem ordElem_pow_add_sum_eq (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (ν : ℕ) (c : Fin ν → F.S)
    (hc : ∀ i : Fin ν, c i ∈ maximalIdeal F.S ^ ((i : ℕ) + 1)) :
    Ideal.ordElem (maximalIdeal R)
      (z ^ ν + ∑ i : Fin ν, algebraMap F.S R (c i) * z ^ (ν - ((i : ℕ) + 1))) = ν := by
  classical
  have hz' := extendsToRSOP_singleton_of_r_eq_one F z hr hz
  have hzM : z ∈ maximalIdeal R := hz'.mem_maximalIdeal (Finset.mem_singleton_self _)
  set g := z ^ ν + ∑ i : Fin ν, algebraMap F.S R (c i) * z ^ (ν - ((i : ℕ) + 1)) with hg
  have hle : ∀ k, algebraMap F.S R '' ((maximalIdeal F.S ^ k : Ideal F.S) : Set F.S) ⊆
      (maximalIdeal R ^ k : Ideal R) := by
    intro k
    rintro _ ⟨a, ha, rfl⟩
    have h1 : maximalIdeal F.S ≤ (maximalIdeal R).comap (algebraMap F.S R) := by
      intro a ha
      rw [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => (mem_maximalIdeal _).mp ha (isUnit_of_map_unit _ _ hu)
    exact Ideal.le_comap_pow _ _ (Ideal.pow_right_mono h1 k ha)
  have hmem : g ∈ maximalIdeal R ^ ν := by
    refine Ideal.add_mem _ (Ideal.pow_mem_pow hzM ν) (Ideal.sum_mem _ fun (i : Fin ν) _ => ?_)
    have h1 := hle _ ⟨c i, hc i, rfl⟩
    have h2 := Ideal.pow_mem_pow hzM (ν - ((i : ℕ) + 1))
    have := Ideal.mul_mem_mul h1 h2
    rwa [← pow_add, Nat.add_sub_of_le (Nat.succ_le_of_lt i.2)] at this
  refine le_antisymm ?_ (Ideal.le_ordElem hmem)
  refine Ideal.ordElem_le_of_notMem (m := ν) fun hmem' => ?_
  obtain ⟨V, hVspan, hzV, hins⟩ := exists_extendsToRSOP_insert F z hr hz
  set N : Ideal R := (maximalIdeal F.S).map (algebraMap F.S R) with hN
  have hVext : ExtendsToRSOP R V := hins.mono (Finset.subset_insert _ _)
  have hreg : IsRegularLocalRing (R ⧸ Ideal.span (V : Set R)) := hVext.isRegularLocalRing_quotient
  have hdom : IsDomain (R ⧸ Ideal.span (V : Set R)) := isDomain_of_isRegularLocalRing _
  rw [hVspan] at hreg hdom
  set mk := Ideal.Quotient.mk N with hmk
  have hzN : z ∉ N := by
    rw [← hVspan]
    obtain ⟨Z, hsub, hZ⟩ := hins
    exact rsop_notMem_span hZ (fun x hx => hsub (Finset.mem_insert_of_mem hx))
      (hsub (Finset.mem_insert_self _ _)) hzV
  have hz0 : mk z ≠ 0 := fun h => hzN (Ideal.Quotient.eq_zero_iff_mem.mp h)
  -- `ḡ = z̄^ν`
  have hcN : ∀ i : Fin ν, algebraMap F.S R (c i) ∈ N := fun i =>
    Ideal.mem_map_of_mem _ (Ideal.pow_le_self (Nat.succ_ne_zero _) (hc i))
  have hgbar : mk g = mk z ^ ν := by
    rw [hg, map_add, map_sum, Finset.sum_eq_zero, add_zero, map_pow]
    intro i _
    rw [map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (hcN i), zero_mul]
  -- `M̄ = (z̄)`
  have hMeq := maximalIdeal_eq_span_sup_map F z hr hz hzM
  have hmap : (maximalIdeal R).map mk = Ideal.span {mk z} := by
    rw [hMeq, Ideal.map_sup, Ideal.map_span, Set.image_singleton, ← hN,
      Ideal.map_quotient_self, sup_bot_eq]
  have hbar : mk g ∈ (Ideal.span {mk z}) ^ (ν + 1) := by
    rw [← hmap, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hmem'
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton', hgbar] at hbar
  obtain ⟨a, ha⟩ := hbar
  have h1 : mk z ^ ν * (1 - mk z * a) = 0 := by
    have : a * mk z ^ (ν + 1) = mk z ^ ν := ha
    rw [mul_sub, mul_one]
    have : mk z ^ ν * (mk z * a) = a * mk z ^ (ν + 1) := by ring
    rw [this, ha, sub_self]
  rcases mul_eq_zero.mp h1 with h | h
  · exact hz0 (pow_eq_zero_iff'.mp h).1
  · have hu : IsUnit (mk z) := ⟨⟨mk z, a, by linear_combination (-1 : _) * h, by linear_combination (-1 : _) * h⟩, rfl⟩
    have hloc : IsLocalHom mk := IsLocalHom.of_surjective mk Ideal.Quotient.mk_surjective
    have : IsUnit z := isUnit_of_map_unit mk z hu
    exact (mem_maximalIdeal _).mp hzM this

omit [IsRegularLocalRing R] in
theorem isUnit_algebraMap_of_notMem {P : Ideal R} [P.IsPrime] {a : R} (ha : a ∉ P) :
    IsUnit (algebraMap R (Localization.AtPrime P) a) :=
  IsLocalization.map_units (Localization.AtPrime P) (⟨a, ha⟩ : P.primeCompl)

/-- `gr(⊤) = ⊤` is generated by the initial form of any unit. -/
theorem grIdeal_top_eq_span_of_isUnit {A : Type u} [CommRing A] [IsRegularLocalRing A] {m : ℕ}
    (g : Fin m → A) (k : Fin m) (hk : IsUnit (g k)) :
    grIdeal (maximalIdeal A) (⊤ : Ideal A) =
      Ideal.span (Set.range fun j => initialForm (maximalIdeal A) (g j)) := by
  obtain ⟨u, hu⟩ := hk
  have hunit : IsUnit (initialForm (maximalIdeal A) (g k)) := by
    rw [← hu, initialForm_maximalIdeal_unit]
    exact (Ideal.Quotient.mk (maximalIdeal A) |>.isUnit_map u.isUnit).map _
  have h1 : initialForm (maximalIdeal A) (g k) ∈ grIdeal (maximalIdeal A) (⊤ : Ideal A) :=
    Ideal.subset_span ⟨g k, Submodule.mem_top, rfl⟩
  have h2 : initialForm (maximalIdeal A) (g k) ∈
      Ideal.span (Set.range fun j => initialForm (maximalIdeal A) (g j)) :=
    Ideal.subset_span ⟨k, rfl⟩
  exact (Ideal.eq_top_of_isUnit_mem _ h1 hunit).trans (Ideal.eq_top_of_isUnit_mem _ h2 hunit).symm

/-- The order in `R_P` of the localized monic polynomial `g = z^ν + Σ c_i z^{ν-i}` is `ν` when the
coefficients lie in the powers of the maximal ideal of `S_{P∩S}` (`ordElem_pow_add_sum_eq` for
the localized frame `localizeAtPrime`). -/
theorem ordElem_algebraMap_localization_eq [Hironaka.HironakaCitedResults.{u}] (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (P : Ideal R) [P.IsPrime] (hzP : z ∈ P)
    [IsRegularLocalRing (Localization.AtPrime P)] (ν : ℕ) (co : Fin ν → F.S)
    (hco : ∀ i : Fin ν, algebraMap F.S (Localization.AtPrime (P.comap (algebraMap F.S R)))
      (co i) ∈ maximalIdeal (Localization.AtPrime (P.comap (algebraMap F.S R))) ^ ((i : ℕ) + 1)) :
    Ideal.ordElem (maximalIdeal (Localization.AtPrime P))
      (algebraMap R (Localization.AtPrime P)
        (z ^ ν + ∑ i : Fin ν, algebraMap F.S R (co i) * z ^ (ν - ((i : ℕ) + 1)))) = ν := by
  have h := ordElem_pow_add_sum_eq (F.localizeAtPrime z hr hz P hzP)
    (algebraMap R (Localization.AtPrime P) z) rfl (fun _ => rfl) ν
    (fun i => algebraMap F.S (Localization.AtPrime (P.comap (algebraMap F.S R))) (co i)) hco
  convert h using 2
  rw [map_add, map_pow, map_sum]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_mul, map_pow]
  congr 1
  show _ = Localization.localRingHom (P.comap (algebraMap F.S R)) P (algebraMap F.S R) rfl
    (algebraMap F.S (Localization.AtPrime (P.comap (algebraMap F.S R))) (co i))
  rw [Localization.localRingHom_to_map]

/-- **(a) and (b) of (2) at the first stage of the proof of Lemma (AB.5)** (p. 304), ring-level:
let `g_1, …, g_m` be a standard base of `J` in the complete regular local ring `R` of
characteristic zero, with `ν_M(g_k) = ν_k`, of the form `z^{ν_k} + Σ c_{ki} z^{ν_k - i}`, `c_{ki}` in
the frame ring `S`, and let `P ∋ z` be a prime of `R` such that the `c_{ki}` lie in the powers
`M_{S_p}^i` in the localization `S_p` (`p = P ∩ S`).  Then in `R_P`: `ν_{M}(g_k) = ν_k` ("(b) of
(2) follows from (3) and (4)") and the initial forms of the `g_k` generate `gr_M(J R_P, R_P)`
("(b) of (2) implies (a) of (2) by Corollary 3 of Theorem 5, § 6, Ch. III").

\textbf{Deviation from the paper (gap filled).} The paper does not argue (p. 304).  Here (b) is
`ordElem_algebraMap_localization_eq` and (a) is `cor:III.thm5-3c` (the assertion (c), for the
complete ring `R`, `Q = P`, using the finiteness of the integral closures of footnote 10) applied
to the system `g` with (i) the standard base property and (ii) `ν_M(g_k) = ν_k = ν_{PR_P}(g_k)`;
when `J ⊄ P` (that is, `x_0 ∉ V_j`), `J R_P` is the unit ideal and a member of the system is a
unit. -/
theorem ordElem_and_grIdeal_localization_of_frame [Hironaka.HironakaCitedResults.{u}] [IsAdicComplete (maximalIdeal R) R]
    [CharZero (ResidueField R)] (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (P : Ideal R) [P.IsPrime] (hzP : z ∈ P)
    [IsRegularLocalRing (Localization.AtPrime P)] (J : Ideal R) {m : ℕ} (g : Fin m → R)
    (hstd : IsStandardBase R J g) (ν : Fin m → ℕ)
    (hord : ∀ k, Ideal.ordElem (maximalIdeal R) (g k) = ν k) (co : ∀ k, Fin (ν k) → F.S)
    (hshape : ∀ k, g k = z ^ ν k + ∑ i : Fin (ν k),
      algebraMap F.S R (co k i) * z ^ (ν k - ((i : ℕ) + 1)))
    (hco : ∀ k (i : Fin (ν k)), algebraMap F.S
      (Localization.AtPrime (P.comap (algebraMap F.S R))) (co k i) ∈
        maximalIdeal (Localization.AtPrime (P.comap (algebraMap F.S R))) ^ ((i : ℕ) + 1)) :
    (∀ k, Ideal.ordElem (maximalIdeal (Localization.AtPrime P))
      (algebraMap R (Localization.AtPrime P) (g k)) = ν k) ∧
    grIdeal (maximalIdeal (Localization.AtPrime P)) (J.map (algebraMap R (Localization.AtPrime P))) =
      Ideal.span (Set.range fun k => initialForm (maximalIdeal (Localization.AtPrime P))
        (algebraMap R (Localization.AtPrime P) (g k))) := by
  classical
  have hb : ∀ k, Ideal.ordElem (maximalIdeal (Localization.AtPrime P))
      (algebraMap R (Localization.AtPrime P) (g k)) = ν k := fun k => by
    rw [hshape k]
    exact ordElem_algebraMap_localization_eq F z hr hz P hzP (ν k) (co k) (hco k)
  refine ⟨hb, ?_⟩
  by_cases hJP : J ≤ P
  · have hg : IsLocallyAdaptedSystem R P J g := by
      refine ⟨hstd.1, hstd.2.2.2.1, fun k => ?_⟩
      rw [hord k, ← hb k, Localization.AtPrime.map_eq_maximalIdeal]
    have hfin : ∀ (Q' Q'' : Ideal R) [Q'.IsPrime] [Q''.IsPrime], Q'' ≤ Q' →
        Module.Finite (Localization.AtPrime Q' ⧸ Q''.map (algebraMap R (Localization.AtPrime Q')))
          (integralClosure (Localization.AtPrime Q' ⧸
            Q''.map (algebraMap R (Localization.AtPrime Q')))
            (FractionRing (Localization.AtPrime Q' ⧸
              Q''.map (algebraMap R (Localization.AtPrime Q'))))) :=
      fun Q' Q'' _ _ h => finite_integralClosure_localization_quotient_of_isAdicComplete Q' Q'' h
    have h := grIdeal_localization_eq_span_initialForm_of_finite hfin P J hJP g hg
    rwa [Localization.AtPrime.map_eq_maximalIdeal] at h
  · -- `J R_P = (1)`
    have hspan := span_eq_of_isStandardBase R J g hstd
    have hk : ∃ k, g k ∉ P := by
      by_contra hcon
      push Not at hcon
      exact hJP (by rw [← hspan, Ideal.span_le]; rintro _ ⟨k, rfl⟩; exact hcon k)
    obtain ⟨k, hkP⟩ := hk
    have htop : J.map (algebraMap R (Localization.AtPrime P)) = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ (hstd.1 k))
        (isUnit_algebraMap_of_notMem hkP)
    rw [htop]
    exact grIdeal_top_eq_span_of_isUnit (fun k => algebraMap R (Localization.AtPrime P) (g k)) k
      (isUnit_algebraMap_of_notMem hkP)

omit [IsRegularLocalRing R] in
theorem comap_maximalIdeal_eq {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing A]
    [IsLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] :
    (maximalIdeal B).comap (algebraMap A B) = maximalIdeal A := by
  ext a
  simp only [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff]
  exact not_congr ⟨fun hu => isUnit_of_map_unit _ _ hu, fun hu => hu.map _⟩

/-- If `a ∈ S` and `a^k ∈ M^{ks} + (z)` in `R`, then `a ∈ M_S^s`: `S ∩ (M^{ks} + (z)) = M_S^{ks}`
(`mem_comap_pow_of_mem_pow_sup`) and `ν_{M_S}(a^k) = k ν_{M_S}(a)` in the regular local ring `S`. -/
theorem mem_pow_of_pow_mem_pow_sup (F : RegularFrame R) (z : R) (hr : F.r = 1)
    (hz : ∀ i, F.z i = z) (hzM : z ∈ maximalIdeal R) (a : F.S) {k s : ℕ} (hk : 0 < k)
    (h : algebraMap F.S R a ^ k ∈ maximalIdeal R ^ (k * s) ⊔ Ideal.span {z}) :
    a ∈ maximalIdeal F.S ^ s := by
  have h1 := mem_comap_pow_of_mem_pow_sup F z hz hr (maximalIdeal R) hzM (k * s) (a ^ k)
    (by rwa [map_pow])
  rw [comap_maximalIdeal_eq] at h1
  have h2 : ((k * s : ℕ) : ℕ∞) ≤ Ideal.ordElem (maximalIdeal F.S) (a ^ k) := Ideal.le_ordElem h1
  rw [StableOrder.ordElem_pow_maximalIdeal] at h2
  refine Ideal.mem_pow_of_le_ordElem ?_
  rcases eq_or_ne (Ideal.ordElem (maximalIdeal F.S) a) ⊤ with h3 | h3
  · rw [h3]; exact le_top
  · obtain ⟨t, ht⟩ := ENat.ne_top_iff_exists.mp h3
    rw [← ht] at h2 ⊢
    have : k * s ≤ k * t := by exact_mod_cast h2
    exact_mod_cast Nat.le_of_mul_le_mul_left this hk

end RegularFrame

namespace MonoidalTransform

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- **A closed-point refinement of a monoidal transform.**  Let `T₁` be a monoidal transform of a
regular local ring `R` of characteristic zero with a prime center `Q` (`R/Q` regular), given by a
prime `M'₁` of the chart `R[x⁻¹Q]`.  Any maximal ideal `M'₂ ⊇ M'₁` of the chart gives a
monoidal transform `T₂` with the same `x` which is residually separable algebraic over `R`
(a closed point of the fibre), and `T₁.ring` is the localization of `T₂.ring` at the prime
`M'₁ T₂.ring` (the point `x̂'_{t+1}` is a generization of a closed point of the fibre; p. 305:
"a monoidal transform of `Ŝ_t` with center `Q̂_t` which is residually algebraic over `S_t` and such
that `S_{t+1}` is a localization of the transform"). -/
theorem exists_isResiduallySeparableAlgebraic_localization_equiv [IsDomain R]
    [CharZero (ResidueField R)] (Q : Ideal R) [Q.IsPrime] (T₁ : MonoidalTransform R Q) :
    ∃ (T₂ : MonoidalTransform R Q) (Q₁ : Ideal T₂.ring) (_ : Q₁.IsPrime)
      (L : Localization.AtPrime Q₁ ≃+* T₁.ring),
      T₂.x = T₁.x ∧ RingHom.IsResiduallySeparableAlgebraic T₂.toRing ∧
        ∀ a : R, L (algebraMap T₂.ring (Localization.AtPrime Q₁) (T₂.toRing a)) = T₁.toRing a := by
  classical
  obtain ⟨M₂, hM₂, hle⟩ := Ideal.exists_le_maximal T₁.M' T₁.isPrime.ne_top
  let T₂ : MonoidalTransform R Q :=
    { x := T₁.x, x_mem := T₁.x_mem, x_ne_zero := T₁.x_ne_zero, M' := M₂,
      isPrime := hM₂.isPrime, le := T₁.le.trans hle }
  have hsep : RingHom.IsResiduallySeparableAlgebraic T₂.toRing := by
    have halg := (T₂.isMaximal_iff_isResiduallyAlgebraic).mp hM₂
    unfold RingHom.IsResiduallyAlgebraic at halg
    unfold RingHom.IsResiduallySeparableAlgebraic
    let _ := (ResidueField.map T₂.toRing).toAlgebra
    exact Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hdisj : Disjoint (M₂.primeCompl : Set (blowupAlgebra R Q T₁.x)) T₁.M' :=
    Set.disjoint_left.mpr fun a ha haQ => ha (hle haQ)
  have hQ₁p : (T₁.M'.map (algebraMap (blowupAlgebra R Q T₁.x) (Localization.AtPrime M₂))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint M₂.primeCompl (Localization.AtPrime M₂) T₁.M'
      inferInstance hdisj
  have hcomap : T₁.M' = (T₁.M'.map (algebraMap (blowupAlgebra R Q T₁.x)
      (Localization.AtPrime M₂))).comap (algebraMap (blowupAlgebra R Q T₁.x)
        (Localization.AtPrime M₂)) :=
    (IsLocalization.under_map_of_isPrime_disjoint M₂.primeCompl (Localization.AtPrime M₂)
      inferInstance hdisj).symm
  have hψ := Localization.localRingHom_bijective_of_eq_comap_map T₁.M' M₂ hcomap
  refine ⟨T₂, T₁.M'.map (algebraMap (blowupAlgebra R Q T₁.x) (Localization.AtPrime M₂)), hQ₁p,
    (RingEquiv.ofBijective _ hψ).symm, rfl, hsep, fun a => ?_⟩
  refine (RingEquiv.symm_apply_eq _).mpr ?_
  show _ = Localization.localRingHom T₁.M' _ (algebraMap _ _) hcomap
    (algebraMap (blowupAlgebra R Q T₁.x) (Localization.AtPrime T₁.M')
      (algebraMap R (blowupAlgebra R Q T₁.x) a))
  rw [Localization.localRingHom_to_map]
  rfl

section StrictTransform

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]

/-- **The strict transform commutes with the passage to a localization of the transform.**  If
`T₁`, `T₂` are monoidal transforms of `R` with the same center `Q` and `λ : T₂.ring → T₁.ring` is a
ring homomorphism compatible with the maps from `R` (the localization of
`exists_isResiduallySeparableAlgebraic_localization_equiv`), then the strict transform of `J` in
`T₁` is generated by the image of the strict transform in `T₂`. -/
theorem strictTransformIdeal_eq_map_of_comp_eq (Q : Ideal R) [Q.IsPrime]
    (T₁ T₂ : MonoidalTransform R Q) (lam : T₂.ring →+* T₁.ring)
    (hlam : ∀ a : R, lam (T₂.toRing a) = T₁.toRing a) (J : Ideal R) :
    strictTransformIdeal T₁ J = (strictTransformIdeal T₂ J).map lam := by
  have h1 : Ideal.span {T₁.xR} = Q.map T₁.toRing := T₁.span_xR_eq_map
  have h2 : Ideal.span {T₂.xR} = Q.map T₂.toRing := T₂.span_xR_eq_map
  have hmapQ : (Q.map T₂.toRing).map lam = Q.map T₁.toRing := by
    rw [Ideal.map_map]
    congr 1
    exact RingHom.ext hlam
  have hT1 : Function.Injective T₁.toRing := MonoidalTransform.toRing_injective T₁
  have hxR1 : T₁.xR ≠ 0 := fun h0 => T₁.x_ne_zero (hT1 (by rw [map_zero]; exact h0))
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro y ⟨x₁, hx₁, f, hf, ν, hν, hy⟩
    have hfQ : f ∈ Q ^ ν := Ideal.mem_pow_of_le_ordElem hν
    have hfx : T₂.toRing f ∈ Ideal.span {T₂.xR ^ ν} := by
      rw [← Ideal.span_singleton_pow, h2, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hfQ
    obtain ⟨y₂, hy₂⟩ := Ideal.mem_span_singleton'.mp hfx
    have hass : Ideal.span {lam T₂.xR} = Ideal.span {x₁} := by
      rw [← Set.image_singleton (f := lam), ← Ideal.map_span, h2, hmapQ, hx₁]
    obtain ⟨u, hu⟩ : Associated (lam T₂.xR) x₁ := Ideal.span_singleton_eq_span_singleton.mp hass
    have hx0 : x₁ ≠ 0 := by
      intro h0
      have : T₁.xR ∈ Ideal.span {x₁} := by
        rw [hx₁, ← h1]; exact Ideal.mem_span_singleton_self _
      rw [h0, Ideal.span_singleton_eq_bot.mpr rfl, Ideal.mem_bot] at this
      exact hxR1 this
    have hlx0 : lam T₂.xR ≠ 0 := by
      intro h0; apply hx0; rw [← hu, h0, zero_mul]
    have hkey : lam T₂.xR ^ ν * ((u : T₁.ring) ^ ν * y - lam y₂) = 0 := by
      have e1 : T₁.toRing f = lam (T₂.toRing f) := (hlam f).symm
      rw [← hy₂, map_mul, map_pow] at e1
      rw [← hu, mul_pow] at hy
      linear_combination hy + e1
    rcases mul_eq_zero.mp hkey with h | h
    · exact absurd (pow_eq_zero_iff'.mp h).1 hlx0
    · have hy' : y = ((u⁻¹ : (T₁.ring)ˣ) : T₁.ring) ^ ν * lam y₂ := by
        have : (u : T₁.ring) ^ ν * y = lam y₂ := sub_eq_zero.mp h
        rw [← this, ← mul_assoc, ← mul_pow, Units.inv_mul, one_pow, one_mul]
      rw [hy']
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span
        ⟨T₂.xR, h2, f, hf, ν, hν, hy₂.symm ▸ by rw [mul_comm]⟩))
  · unfold strictTransformIdeal
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨y₂, ⟨x₂', hx₂', f, hf, ν, hν, hy₂⟩, rfl⟩
    refine Ideal.subset_span ⟨lam x₂', ?_, f, hf, ν, hν, ?_⟩
    · rw [← Set.image_singleton (f := lam), ← Ideal.map_span, hx₂', hmapQ]
    · rw [← map_pow, ← map_mul, hy₂, hlam]

end StrictTransform

end MonoidalTransform

end

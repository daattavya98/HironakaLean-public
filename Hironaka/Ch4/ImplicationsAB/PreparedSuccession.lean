variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} {𝒮 : Frame hS}

/-- At the points of `U_s ∩ X̄_s`, the boundary `⋃_{i ∈ bdry} Ê_i(s)` of the model datum has only
normal crossings with `X̄_s` (p. 308: "It is clear that `Ê'_{α+1}(s) ∪ ⋯ ∪ Ê'_{α+s}(s)` has only
normal crossings with `X̄'_s` on `X̂'_s`"; in the closed case, "`E'_1(s) ∪ ⋯ ∪ E'_{α+s}(s)` has only
normal crossings with `X̄'_s` on `X̂'_s` because `X̄'_s = c_s⁻¹(F(s)) ∩ X̂'_s`").  Gap filled; see
`RemovalFamily.modelDatum_boundary_local`. -/
theorem RemovalFamily.hasOnlyNormalCrossingsWithAt_iInf_eHat_bdry [Hironaka.HironakaCitedResults.{u}] (R : 𝒮.RemovalFamily) (s : ℕ)
    {xh : 𝒮.tHat.X s} (hxU : xh ∈ (R.U s : Set (𝒮.tHat.X s))) (hxW : xh ∈ (𝒮.xBar s).pts) :
    (⨅ i : Fin (bdryCard r P.α s), 𝒮.eHat s (bdryIdx r P.α s i)).HasOnlyNormalCrossingsWithAt
      (𝒮.xBar s) xh := by
  refine (Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_congr ?_ _ _).mp
    ((R.modelDatum_boundary_local s).2 xh hxU hxW)
  rw [pts_transformI_modelDatum_E, Subscheme.pts_iInf]
  rw [← pts_iInf_bdryIdx (Z := 𝒮.tHat.X s) r P.α s (𝒮.eHat s), Subscheme.pts_iInf]

/-- **Remark 2, points of `Ū_s`** (p. 308): at a point of `Ū_s`, the traces `Ẽ_j = Ê_j(s) ∩ X̄_s` of
the boundary divisors have only normal crossings on `X̄_s`, and each is simple of codimension one
in `X̄_s` at its points ("In both cases, we see that `Ẽ_1, ⋯, Ẽ_α̃` are non-singular … subschemes of
`X̄'_s` of codimension 1, and that `Ẽ_1 ∪ ⋯ ∪ Ẽ_α̃` has only normal crossings on `X̄'_s`"; the
irreducibility is false).

Gap filled ("we see"): `X̄_s` is irreducible and not contained in the boundary (`W_s ⊄ E_s`,
`not_subset_transformI_modelDatum_E`; this is where `hFE` is used), hence transversal to each `Ê_i(s)`, and the traces are given by pulling back
the stalk presentations along the immersion `X̄_s → X̂_s` (`Subscheme.hasOnlyNormalCrossingsAt_iInf_totalTransform_ι`). -/
@[blueprint "lem:IV.3-rem2-traces"
  (statement := /-- In the situation of \cref{lem:IV.3-rem2-model-boundary}, assume that $F$ is
    contained in none of the $E_i$ in the closed case. At a point $\bar x$ of $\bar U_s=U_s\cap\bar X_s$,
    the traces $\tilde E_j=\hat E_j(s)\cap\bar X_s$ of the boundary divisors have only normal crossings
    on $\bar X_s$, and each $\tilde E_j$ through $\bar x$ is non-singular and of codimension $1$
    in $\bar X_s$ at $\bar x$. -/)
  (proof := /-- By \cref{lem:IV.3-rem2-model-boundary} the boundary has only normal crossings with
    $\bar X_s$ at the image of $\bar x$, and by \cref{lem:IV.3-rem2-transversal} the irreducible
    $\bar X_s$ is not contained in any $\hat E_j(s)$, so that the stalk of $\hat E_j(s)$ is not
    contained in that of $\bar X_s$. Pulling back the stalk presentations along the immersion
    $\bar X_s\to\hat X_s$ gives the claims.
    \textbf{Deviation from the paper (gap filled).} ``In both cases, we see that
    $\tilde E_1,\dots,\tilde E_{\tilde\alpha}$ are non-singular \dots\ of codimension 1, and that
    $\tilde E_1\cup\dots\cup\tilde E_{\tilde\alpha}$ has only normal crossings on $\bar X'_s$''
    (p.~308); the irreducibility is false and the codimension
    claim needs $F\not\subseteq E_i$. -/)
  (proofUses := ["lem:IV.3-rem2-model-boundary", "lem:IV.3-rem2-transversal",
    "lem:IV.4-tilde-facts-local"])
  (latexEnv := "lemma")]
theorem RemovalFamily.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry [Hironaka.HironakaCitedResults.{u}] (R : 𝒮.RemovalFamily)
    (hFE : ∀ F, r = .closed F → ∀ i : Fin P.α, ¬ F.pts ⊆ (P.E i).pts) (s : ℕ)
    (xb : (𝒮.xBar s).toScheme) (hxb : xb ∈ R.uBar s) :
    (⨅ i : Fin (bdryCard r P.α s),
        Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).HasOnlyNormalCrossingsAt
      xb ∧
    ∀ i, xb ∈ (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).pts →
      (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).IsSimpleAt xb ∧
      (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).codimAt xb = 1 := by
  have hx : (𝒮.xBar s).ι xb ∈ (𝒮.xBar s).pts := by
    show _ ∈ ((𝒮.xBar s).support : Set (𝒮.tHat.X s))
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨xb, rfl⟩
  have hne : (𝒮.xBar s).pts.Nonempty := ⟨_, hx⟩
  have hirr : _root_.IsIrreducible (𝒮.xBar s).pts :=
    Subscheme.isIrreducible_pts _ (Frame.RemovalFamily.isIrreducible_xBar_of_isIrreducible_zero
      (𝒮 := 𝒮) (fun _ => 𝒮.xBar_zero_isNonsingular_and_isIrreducible.2) s hne)
  have hns := 𝒮.not_subset_transformI_modelDatum_E hFE s hne
  have : IsRegularLocalRing ((𝒮.tHat.X s).presheaf.stalk ((𝒮.xBar s).ι xb)) :=
    𝒮.isNonsingular_tHat_X s _
  have hE : (⨅ i : Fin (bdryCard r P.α s), 𝒮.eHat s (bdryIdx r P.α s i)).IsReduced :=
    Subscheme.isReduced_iInf_of_isNonsingular _ fun i => 𝒮.isNonsingular_eHat s _
  have hNC := R.hasOnlyNormalCrossingsWithAt_iInf_eHat_bdry s hxb hx
  have hsimple : ∀ i, (𝒮.xBar s).ι xb ∈ (𝒮.eHat s (bdryIdx r P.α s i)).pts →
      (𝒮.eHat s (bdryIdx r P.α s i)).IsSimpleAt ((𝒮.xBar s).ι xb) ∧
        (𝒮.eHat s (bdryIdx r P.α s i)).codimAt ((𝒮.xBar s).ι xb) = 1 := fun i hi =>
    𝒮.isSimpleAt_and_codimAt_eq_one_totalTransform_c s (hS.isNonsingular_esys s _)
      (hS.exists_stalkIdeal_esys s _) _ hi
  have hT : ∀ i, (𝒮.xBar s).ι xb ∈ (𝒮.eHat s (bdryIdx r P.α s i)).pts →
      ¬ (𝒮.eHat s (bdryIdx r P.α s i)).stalkIdeal ((𝒮.xBar s).ι xb) ≤
        (𝒮.xBar s).stalkIdeal ((𝒮.xBar s).ι xb) := fun i _ => by
    refine Subscheme.not_stalkIdeal_le_of_isIrreducible_not_subset hirr (E := 𝒮.eHat s (bdryIdx r P.α s i))
      (fun hsub => hns ?_) le_rfl hx
    rw [pts_transformI_modelDatum_E]
    exact hsub.trans (Set.subset_biUnion_of_mem (u := fun j : Fin (P.α + s) => (𝒮.eHat s j).pts)
      (show bdryIdx r P.α s i ∈ {j : Fin (P.α + s) | inBdry r P.α s j} from
        inBdry_bdryIdx r P.α s i))
  exact ⟨Hironaka.Subscheme.hasOnlyNormalCrossingsAt_iInf_totalTransform_ι hE xb hNC hsimple hT,
    fun i hi => Hironaka.Subscheme.isSimpleAt_and_codimAt_eq_one_totalTransform_ι hE xb hNC
      hsimple hT i hi⟩

end Frame

end Rem2Generic

/-- **Remark 2** (p. 308) for an arbitrary open family with removals `U_s`
(`Frame.RemovalFamily`), with `U_s`, `Ū_s = U_s ∩ X̄_s` in place of `X̂'_s`, `X̄'_s`; the printed
Remark 2 is the instance `U_s = X̂'_s` (`Frame.hasOnlyNormalCrossings_etilde_of_prepHyp`).

Proved.  The paper's argument ("It is clear that ... on `X̂'_s`", "we see that ...", p. 308) is the
induction along `ĝ_s` of the datum `(E_0; ; V(z_0))` on `X̂_0`
(`RemovalFamily.modelDatum_boundary_local`: off `Bad_t` the center `B̂_t` lies in `X̄_t`, and
`U_{t+1}` lies over `U_t − Bad_t`), the transversality `X̄_s ⊄ E_s`
(`not_subset_transformI_modelDatum_E`, where `hFE` enters) and the pull-back along `X̄_s → X̂_s`
(`RemovalFamily.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry`).  Gap filled.  The irreducibility of the `Ẽ_j` is omitted as in
the printed statement (see there).

\textbf{Statement false as printed ($F=E_i$).} In the closed case \( \tilde E_j = \hat E_j'(s)\cap\bar X_s'\)
and \( \bar X_s' = c_s^{-1}(F(s))\cap\hat X_s'\); if \(F=E_i\) (allowed by Definition 5 (I.1),
p. 166) then \(\tilde E_i=\bar X_s'\), which is not of codimension one in \(\bar X_s'\) and is not in
normal crossings with it.  Counterexample: \(X=\mathbb A^2\), \(x_0=0\), \(E_1=F=V(x)\), \(W=V(y)\),
\(N=2\), \(n=1\), \(s=0\).  Statement corrected: the Lean theorem has the extra hypothesis `hFE`
(no closed restriction `F` is contained in an `E_i`); the repaired form without it is
`rem:IV.3-2-repaired`.  The counterexample to the irreducibility of the `Ẽ_j` is in the docstring of
`Frame.hasOnlyNormalCrossings_etilde_of_prepHyp` (`rem:IV.3-2`).
 -/
@[blueprint "rem:IV.3-2-generic"
  (statement := /-- Notation as in \cref{rem:IV.3-2}, for an arbitrary open family with
    removals $U_s\subseteq\hat X_s$ (\cref{lem:IV.3-construction-facts-generic}), with $U_s$ and
    $\bar U_s=U_s\cap\bar X_s$ in place of $\hat X_s'$ and $\bar X_s'$: the assertions of
    \cref{rem:IV.3-2} hold with $\hat E_j'(s)=c_s^{-1}(E_j(s))\cap U_s$ and
    $\tilde E_j=\hat E_j'(s)\cap\bar U_s$ (resp.\ $\hat E_{\alpha+j}'(s)\cap\bar U_s$), the
    irreducibility of the $\tilde E_j$ excepted. (Formalization note: the printed Remark~2 is
    the instance $U_s=\hat X_s'$; the corrected construction of
    \cref{def:IV.3-construction-componentwise} is the instance $U_s=\hat X_s^{*\prime}$.) 

    \textbf{Statement false as printed ($F=E_i$).} If $F=E_i$ in the closed case (allowed by
    Definition~5 (I.1), p.~166) then $\tilde E_i=\bar U_s$, which is not of codimension one and
    does not have normal crossings; counterexample $X=\mathbb A^2$, $x_0=0$, $E_1=F=V(x)$,
    $W=V(y)$, $N=2$, $n=1$, $s=0$. The Lean statement has the extra hypothesis that no closed restriction $F$
    is contained in an $E_i$. -/)
  (proof := /-- The proof of \cref{rem:IV.3-2} applies verbatim: at the points of $U_s$ the
    centers $\hat B_t$ were contained in $\bar X_t$ (off $\mathrm{Bad}_t$) or removed, so that
    $\bar U_s$ is transversal to the $\hat E_{\alpha+j}'(s)$.

    In Lean: \cref{lem:IV.3-rem2-model-boundary} (the induction along $\hat g_s$ for the datum
    $(E_0;\,;V(z_0))$ on $\hat X_0$, localized to $U_s$), \cref{lem:IV.3-rem2-transversal}
    ($W_s\not\subseteq E_s$, using $F\not\subseteq E_i$) and \cref{lem:IV.3-rem2-traces} (the traces
    $\tilde E_j$). \textbf{Deviation from the paper (gap filled).} ``It is clear that \dots'' and
    ``we see that \dots'' (p.~308). -/)
  (proofUses := ["lem:IV.AB-2", "lem:IV.3-construction-facts-generic", "lem:IV.3-rem2-model-boundary",
    "lem:IV.3-rem2-transversal", "lem:IV.3-rem2-traces"])
  (latexEnv := "remark")]
theorem Frame.RemovalFamily.hasOnlyNormalCrossings_etilde_of_prepHyp [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {X : Scheme.{u}}
    {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} {T : Tower X} {x₀ : X} {hS : Standing N n ℜ P r T x₀}
    {𝒮 : Frame hS} (R : 𝒮.RemovalFamily) (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s)
    (hFE : ∀ F, r = .closed F → ∀ i : Fin P.α, ¬ F.pts ⊆ (P.E i).pts) :
    (∀ xh ∈ (R.U s : Set (𝒮.tHat.X s)) ∩ (𝒮.xBar s).pts,
      (⨅ j : Fin s, Subscheme.totalTransform (𝒮.c s)
        (T.Esys P.E s (Fin.natAdd P.α j))).HasOnlyNormalCrossingsWithAt (𝒮.xBar s) xh) ∧
    (∀ F, r = .closed F → ∀ xh ∈ (R.U s : Set (𝒮.tHat.X s)) ∩ (𝒮.xBar s).pts,
      (⨅ j : Fin (P.α + s), Subscheme.totalTransform (𝒮.c s)
        (T.Esys P.E s j)).HasOnlyNormalCrossingsWithAt (𝒮.xBar s) xh) ∧
    (∀ j, IsNonsingCodimOneOn ((𝒮.eTilde s).2 j) (R.uBar s : Set (𝒮.xBar s).toScheme)) ∧
    ∀ xb ∈ R.uBar s, (⨅ j, (𝒮.eTilde s).2 j).HasOnlyNormalCrossingsAt xb := by

  cases r with
  | closed F =>
    refine ⟨fun xh hxh => ?_, fun F' _ xh hxh => ?_, fun j => ⟨fun x hx => ?_, fun x hx => ?_⟩,
      fun xb hxb => ?_⟩
    · have hfull := R.hasOnlyNormalCrossingsWithAt_iInf_eHat_bdry s hxh.1 hxh.2
      have : IsRegularLocalRing ((𝒮.tHat.X s).presheaf.stalk xh) := 𝒮.isNonsingular_tHat_X s xh
      have hred : (⨅ j : Fin (P.α + s), 𝒮.eHat s j).IsReduced :=
        Subscheme.isReduced_iInf_of_isNonsingular _ fun j => 𝒮.isNonsingular_eHat s j
      exact Subscheme.hasOnlyNormalCrossingsWithAt_iInf_comp (σ := Fin.natAdd P.α)
        (E := 𝒮.eHat s) hred hfull (fun j hj =>
          𝒮.isSimpleAt_and_codimAt_eq_one_totalTransform_c s (hS.isNonsingular_esys s j)
            (hS.exists_stalkIdeal_esys s j) _ hj)
    · exact R.hasOnlyNormalCrossingsWithAt_iInf_eHat_bdry s hxh.1 hxh.2
    · exact ((R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry hFE s x hx.2).2 j hx.1).1
    · exact ((R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry hFE s x hx.2).2 j hx.1).2
    · exact (R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry hFE s xb hxb).1
  | opn U =>
    refine ⟨fun xh hxh => ?_, ?_, fun j => ⟨fun x hx => ?_, fun x hx => ?_⟩, fun xb hxb => ?_⟩
    · exact R.hasOnlyNormalCrossingsWithAt_iInf_eHat_bdry s hxh.1 hxh.2
    · intro F' h
      cases h
    · exact ((R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry hFE s x hx.2).2 j hx.1).1
    · exact ((R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry hFE s x hx.2).2 j hx.1).2
    · exact (R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry hFE s xb hxb).1

/-- **Remark 2** (p. 308).

In Lean: the instance `U_s = X̂'_s` (`Frame.removalFamily`) of
`Frame.RemovalFamily.hasOnlyNormalCrossings_etilde_of_prepHyp` (`rem:IV.3-2-generic`).

Statement false as printed (the irreducibility): "In both cases, we see that `Ẽ_1, ⋯, Ẽ_α̃` are
non-singular irreducible subschemes of `X̄'_s` of codimension 1, and that `Ẽ_1 ∪ ⋯ ∪ Ẽ_α̃` has
only normal crossings on `X̄'_s`" (p. 308).  The `Ẽ_j` need not be irreducible (the mechanism of
Lemma (AB.4): `B̂_t` and hence the exceptional divisors over it can be reducible); the Lean
statement asserts only that each `Ẽ_j` is non-singular and everywhere of codimension 1 on `X̄'_s`
(`IsNonsingCodimOneOn`).

\textbf{Statement false as printed ($F=E_i$).} In the closed case \( \tilde E_j = \hat E_j'(s)\cap\bar X_s'\)
and \( \bar X_s' = c_s^{-1}(F(s))\cap\hat X_s'\); if \(F=E_i\) (allowed by Definition 5 (I.1),
p. 166) then \(\tilde E_i=\bar X_s'\), which is not of codimension one in \(\bar X_s'\) and is not in
normal crossings with it.  Counterexample: \(X=\mathbb A^2\), \(x_0=0\), \(E_1=F=V(x)\), \(W=V(y)\),
\(N=2\), \(n=1\), \(s=0\).  Statement corrected: the Lean theorem has the extra hypothesis `hFE`
(no closed restriction `F` is contained in an `E_i`); the repaired form without it is
`rem:IV.3-2-repaired`.

\textbf{Counterexample to the irreducibility.}  Over a field of characteristic 0 let `X = 𝔸³` with
coordinates `(u, v, w)`, `g = v² − u²(1 + u)` (as in the counterexample of Lemma (AB.4),
`lem:IV.AB-4-componentwise`), `W = {w² = u g²}`, `C = {w = g = 0}` the nodal curve with node `x₀`, and the datum
`(ℜ^{3,2}_I, U)` with `E = ∅` and `U = W − C`.  Blow up `x₀`, then the strict transform `C'` of `C`.
At the end a point satisfies (1)–(3) of Lemma (AB.4) (the case the paper is "only interested in"),
condition [g] holds at both stages, `X̄'_2 = X̄_2`, and `Ẽ_2 ≅ B̂_1`; since `C' → C` is finite,
`B̂_1 = Spec Ô_{C',x} ⊔ Spec Ô_{C',y}`, so `Ẽ_2` is non-singular of codimension 1 but has two
components, contrary to the printed "irreducible".  Here [g] holds, so the example does not depend on
the containments of the printed (AB.4) on all of `B̂_s`.
 -/
@[blueprint "rem:IV.3-2"
  (statement := /-- \textbf{Remark 2.} Let $g_s$ and $x_0$ be as in \cref{def:IV.3-conditions}
    and, with reference to $x_0$ and $g_s$, construct $\hat g_s$, $c_t$, $b$, $X_t'$,
    $\hat X_t'$, $\bar X_t$, $\bar X_t'$ and $\bar J(t)$ $(0\le t\le s)$ as before
    (\cref{def:IV.3-setup}, \cref{def:IV.3-frame}, \cref{def:IV.3-construction}). Let
    $\hat E_j'(s)=c_s^{-1}(E_j(s))\cap\hat X_s'$ for $1\le j\le\alpha+s$. It is clear that
    $\hat E_{\alpha+1}'(s)\cup\dots\cup\hat E_{\alpha+s}'(s)$ has only normal crossings with
    $\bar X_s'$ on $\hat X_s'$ (\cref{def:0.2-normal-crossings-with-at}). For the case in which
    $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},F)$, $\hat E_1'(s)\cup\dots\cup
    \hat E_{\alpha+s}'(s)$ has only normal crossings with $\bar X_s'$ on $\hat X_s'$ because
    $\bar X_s'=c_s^{-1}(F(s))\cap\hat X_s'$. We define $\tilde E_j$ for
    $1\le j\le\tilde\alpha$ as follows: (i) in case $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},
    F)$, $\tilde E_j=\hat E_j'(s)\cap\bar X_s'$ for $1\le j\le\alpha+s$, and
    $\tilde\alpha=\alpha+s$; (ii) in case $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},U)$,
    $\tilde E_j=\hat E_{\alpha+j}'(s)\cap\bar X_s'$ for $1\le j\le s$, and $\tilde\alpha=s$. In
    both cases, we see that $\tilde E_1,\dots,\tilde E_{\tilde\alpha}$ are non-singular
    irreducible subschemes of $\bar X_s'$ of codimension $1$, and that
    $\tilde E_1\cup\dots\cup\tilde E_{\tilde\alpha}$ has only normal crossings on $\bar X_s'$.
    (p.~308.)

    \textbf{Paper misprint.} In the sentence beginning ``For the case in which'' the paper
    writes $E_1'(s)\cup\dots\cup E_{\alpha+s}'(s)$ (without hats); meant is
    $\hat E_1'(s)\cup\dots\cup\hat E_{\alpha+s}'(s)$.

    (Formalization notes (encoding): the $\hat E_j'(s)$ and $\tilde E_j$ are the total transforms on $\hat X_s$, resp.\
    $\bar X_s$, and the assertions are made at the points of $\hat X_s'$, resp.\ $\bar X_s'$;
    the empty subscheme counts as non-singular of codimension one.)

    \textbf{Statement false as printed (the irreducibility).} The paper: ``In both cases, we see
    that $\tilde E_1,\cdots,\tilde E_{\tilde\alpha}$ are non-singular irreducible subschemes of
    $\bar X_s'$ of codimension 1, and that $\tilde E_1\cup\cdots\cup\tilde E_{\tilde\alpha}$
    has only normal crossings on $\bar X_s'$'' (p.~308). The $\tilde E_j$ need not be
    irreducible; the Lean statement asserts that each $\tilde E_j$ is non-singular and
    everywhere of codimension $1$ on $\bar X_s'$. 

    \textbf{Statement false as printed ($F=E_i$).} If $F=E_i$ in the closed case (allowed by
    Definition~5 (I.1), p.~166) then $\tilde E_i=\bar X_s'$, which is not of codimension one in
    $\bar X_s'$ and does not have normal crossings with it; counterexample $X=\mathbb A^2$,
    $x_0=0$, $E_1=F=V(x)$, $W=V(y)$, $N=2$, $n=1$, $s=0$. Statement corrected: the Lean
    statement has the extra hypothesis that no closed restriction $F$ is contained in an $E_i$
    (the repaired form is \cref{rem:IV.3-2-repaired}).

    \textbf{Counterexample to the irreducibility.} Over a field of characteristic $0$ let
    $X=\mathbb A^3$ with coordinates $(u,v,w)$, $g=v^2-u^2(1+u)$ (as in the counterexample of
    \cref{lem:IV.AB-4-componentwise}), $W=\{w^2=ug^2\}$, $C=\{w=g=0\}$ the nodal curve with node $x_0$, and the
    datum $(\mathfrak R^{3,2}_{\mathrm I},U)$ with $E=\emptyset$ and $U=W-C$. Blow up $x_0$, then the
    strict transform $C'$ of $C$. At the end a point satisfies (1)--(3) of Lemma (AB.4) (the case
    the paper is ``only interested in''), condition [g] holds at both stages, $\bar X_2'=\bar X_2$,
    and $\tilde E_2\cong\hat B_1$; since $C'\to C$ is finite, $\hat B_1=\operatorname{Spec}
    \hat{\mathcal O}_{C',x}\sqcup\operatorname{Spec}\hat{\mathcal O}_{C',y}$, so $\tilde E_2$ is
    non-singular of codimension $1$ but has two components, contrary to the printed
    ``irreducible''. Since [g] holds here, the example does not depend on the containments of the
    printed Lemma (AB.4) on all of $\hat B_s$. -/)
  (proof := /-- The exceptional subschemes $E_{\alpha+1}(s),\dots,E_{\alpha+s}(s)$ of the
    permissible succession $g_s$ have only normal crossings with the non-singular $X_s$ and
    with the centers, and $c_s^{-1}$ preserves this because the local homomorphisms induced by
    $c_s$ transform regular systems of parameters into such systems (\cref{lem:IV.AB-2});
    $\bar X_s$ is the strict transform of $\bar X_0=V(z)$, and at the points of $\hat X_s'$ the
    centers $\hat B_t$ were contained in $\bar X_t$ (case [g]) or removed (case [h]), so that
    $\bar X_s'$ is transversal to the $\hat E_{\alpha+j}'(s)$. In the closed case
    $\bar X_s'=c_s^{-1}(F(s))\cap\hat X_s'$ and $\bigcup_iE_i(s)\cup F(s)$ has only normal
    crossings (Definition~5 (I.1) and Remark~1, \S1, Ch.~I). Restricting to $\bar X_s'$ gives
    the assertions on the $\tilde E_j$.

    (Formalization note: in Lean this is the instance $U_s=\hat X_s'$ of
    \cref{rem:IV.3-2-generic}, the remark for an arbitrary open family with removals.) -/)
  (proofUses := ["lem:IV.AB-2", "rem:IV.3-2-generic"])
  (latexEnv := "remark")]
theorem Frame.hasOnlyNormalCrossings_etilde_of_prepHyp [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} {T : Tower X} {x₀ : X} {hS : Standing N n ℜ P r T x₀}
    (𝒮 : Frame hS) (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s)
    (hFE : ∀ F, r = .closed F → ∀ i : Fin P.α, ¬ F.pts ⊆ (P.E i).pts) :
    (∀ xh ∈ (𝒮.xHatPrime s : Set (𝒮.tHat.X s)) ∩ (𝒮.xBar s).pts,
      (⨅ j : Fin s, Subscheme.totalTransform (𝒮.c s)
        (T.Esys P.E s (Fin.natAdd P.α j))).HasOnlyNormalCrossingsWithAt (𝒮.xBar s) xh) ∧
    (∀ F, r = .closed F → ∀ xh ∈ (𝒮.xHatPrime s : Set (𝒮.tHat.X s)) ∩ (𝒮.xBar s).pts,
      (⨅ j : Fin (P.α + s), Subscheme.totalTransform (𝒮.c s)
        (T.Esys P.E s j)).HasOnlyNormalCrossingsWithAt (𝒮.xBar s) xh) ∧
    (∀ j, IsNonsingCodimOneOn ((𝒮.eTilde s).2 j) (𝒮.xBarPrime s : Set (𝒮.xBar s).toScheme)) ∧
    ∀ xb ∈ 𝒮.xBarPrime s, (⨅ j, (𝒮.eTilde s).2 j).HasOnlyNormalCrossingsAt xb :=
  𝒮.removalFamily.hasOnlyNormalCrossings_etilde_of_prepHyp s hprep hFE

end AB

/-! ## Gap fills (pp. 307–310): `J̃ ≠ 0` and `X̃` ambient of dimension `N - 1`

The auxiliary datum `ℜ^{N-1}_II` of p. 308 is a resolution datum only if `J̃ ≠ 0` on `X̃`
(`Frame.RemovalFamily.stalkIdeal_jBarT_ne_bot`) and `X̃` is a non-singular irreducible algebraic scheme
of dimension `N - 1` (`Frame.RemovalFamily.isAmbient_xTilde`); the paper asserts neither. -/

section NormalFlatnessPrincipal

variable {R : Type u} [CommRing R]

/-- Normal flatness along a principal ideal `(z)` of the quotient `R/J`: if for every `p` either
`z^p ∈ J`, or `a z^p ∈ (z^{p+1}) + J` implies `a ∈ (z)`, then `R/J` is normally flat along `(z)`:
the piece `(z^p)/(z^{p+1})` is zero in the first case and free of rank one over `R/(z)` in the
second. -/
theorem isNormallyFlatAlongIdeal_map_span_singleton_of_forall (z : R) (J : Ideal R)
    (h : ∀ p : ℕ, z ^ p ∈ J ∨
      ∀ a : R, a * z ^ p ∈ Ideal.span {z ^ (p + 1)} ⊔ J → a ∈ Ideal.span {z}) :
    IsNormallyFlatAlongIdeal ((Ideal.span {z}).map (Ideal.Quotient.mk J)) := by
  intro p
  set O := R ⧸ J with hO
  set zb : O := Ideal.Quotient.mk J z with hzb
  set P : Ideal O := (Ideal.span {z}).map (Ideal.Quotient.mk J) with hPdef
  have hP : P = Ideal.span {zb} := by rw [hPdef, Ideal.map_span, Set.image_singleton]
  have hPp : ∀ q, P ^ q = Ideal.span {zb ^ q} := fun q => by rw [hP, Ideal.span_singleton_pow]
  rcases h p with hp | hp
  · -- `P ^ p = ⊥`
    have h0 : zb ^ p = 0 := by
      rw [hzb, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hp
    have : Subsingleton ↥(P ^ p) := by
      rw [hPp, h0, Ideal.span_singleton_eq_bot.mpr rfl] 
      infer_instance
    have : Subsingleton (GrPiece P p) :=
      Function.Surjective.subsingleton (Submodule.Quotient.mk_surjective _)
    infer_instance
  · -- the piece is generated by the class of `zb ^ p`, with no relation
    have hmem : zb ^ p ∈ P ^ p := by rw [hPp]; exact Ideal.mem_span_singleton_self _
    set m : GrPiece P p := Submodule.Quotient.mk ⟨zb ^ p, hmem⟩ with hm
    have hsmul : ∀ r : O, (Ideal.Quotient.mk P r) • m =
        Submodule.Quotient.mk ⟨r * zb ^ p, by
          rw [hPp]; exact Ideal.mem_span_singleton'.mpr ⟨r, rfl⟩⟩ := by
      intro r
      have h1 : (Ideal.Quotient.mk P r) • m = r • m :=
        IsScalarTower.algebraMap_smul (O ⧸ P) r m
      rw [h1, hm, ← Submodule.Quotient.mk_smul]
      rfl
    have hli : LinearIndependent (O ⧸ P) (fun _ : Unit => m) := by
      refine LinearIndependent.of_subsingleton' () fun a ha => ?_
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [hsmul, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap] at ha
      have ha' : r * zb ^ p ∈ P ^ (p + 1) := ha
      rw [hPp, Ideal.mem_span_singleton'] at ha'
      obtain ⟨s, hs⟩ := ha'
      obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective r
      obtain ⟨s', rfl⟩ := Ideal.Quotient.mk_surjective s
      have hdiff : r' * z ^ p - s' * z ^ (p + 1) ∈ J := by
        rw [← Ideal.Quotient.eq, map_mul, map_mul, map_pow, map_pow]
        exact hs.symm
      have hmem' : r' * z ^ p ∈ Ideal.span {z ^ (p + 1)} ⊔ J := by
        have : r' * z ^ p = s' * z ^ (p + 1) + (r' * z ^ p - s' * z ^ (p + 1)) := by ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨s', rfl⟩))
          (Ideal.mem_sup_right hdiff)
      have hr' := hp r' hmem'
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ hr'
    have hsp : ⊤ ≤ Submodule.span (O ⧸ P) (Set.range fun _ : Unit => m) := by
      rintro x -
      induction x using Submodule.Quotient.induction_on with
      | H t =>
        obtain ⟨t, ht⟩ := t
        have ht' := ht
        rw [hPp, Ideal.mem_span_singleton'] at ht'
        obtain ⟨r, rfl⟩ := ht'
        have := hsmul r
        rw [← this]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(), rfl⟩)
    exact Module.Free.of_basis (Module.Basis.mk hli hsp)

/-- In a domain, `R/J` is normally flat along `(z)` when `J = 0` or `J = (z^c)` with `c ≥ 1`:
the thickenings `V(z^c)` of the hypersurface `V(z)` are normally flat along it. -/
theorem isNormallyFlatAlongIdeal_map_span_singleton_of_eq_bot_or_eq_span_pow [IsDomain R]
    {z : R} (hz : z ≠ 0) {J : Ideal R} (hJ : J = ⊥ ∨ ∃ c : ℕ, 1 ≤ c ∧ J = Ideal.span {z ^ c}) :
    IsNormallyFlatAlongIdeal ((Ideal.span {z}).map (Ideal.Quotient.mk J)) := by
  refine isNormallyFlatAlongIdeal_map_span_singleton_of_forall z J fun p => ?_
  have hzp : z ^ p ≠ 0 := pow_ne_zero p hz
  have key : ∀ (a s u : R) (k : ℕ), a * z ^ p = s * z ^ (p + 1) + u * z ^ (p + k) →
      a = s * z + u * z ^ k := fun a s u k h => by
    apply mul_right_cancel₀ hzp
    calc a * z ^ p = s * z ^ (p + 1) + u * z ^ (p + k) := h
      _ = (s * z + u * z ^ k) * z ^ p := by ring
  rcases hJ with rfl | ⟨c, hc, rfl⟩
  · right
    intro a ha
    rw [Submodule.mem_sup] at ha
    obtain ⟨y, hy, w, hw, hyw⟩ := ha
    rw [Ideal.mem_bot] at hw
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    rw [hw, add_zero] at hyw
    have := key a s 0 0 (by rw [← hyw]; ring)
    rw [this]
    exact Ideal.mem_span_singleton'.mpr ⟨s, by ring⟩
  · by_cases hpc : c ≤ p
    · left
      exact Ideal.mem_span_singleton'.mpr ⟨z ^ (p - c), by rw [← pow_add]; congr 2; omega⟩
    · right
      intro a ha
      rw [Submodule.mem_sup] at ha
      obtain ⟨y, hy, w, hw, hyw⟩ := ha
      obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton'.mp hw
      have hk : p + (c - p) = c := by omega
      have := key a s u (c - p) (by rw [hk, ← hyw])
      rw [this]
      refine Ideal.add_mem _ (Ideal.mem_span_singleton'.mpr ⟨s, by ring⟩) ?_
      refine Ideal.mem_span_singleton'.mpr ⟨u * z ^ (c - p - 1), ?_⟩
      have : c - p = (c - p - 1) + 1 := by omega
      conv_rhs => rw [this, pow_succ]
      ring

/-- If `A` is a domain and `A/(π^c)` is a domain for a non-zero non-unit `π`, then `c ≤ 1`. -/
theorem le_one_of_isDomain_quotient_span_pow {A : Type u} [CommRing A] [IsDomain A] {π : A}
    (hπ0 : π ≠ 0) (hπu : ¬ IsUnit π) {c : ℕ} (h : IsDomain (A ⧸ Ideal.span {π ^ c})) :
    c ≤ 1 := by
  by_contra hc
  push Not at hc
  have h0 : (Ideal.Quotient.mk (Ideal.span {π ^ c}) π) ^ c = 0 := by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _
  have h1 : Ideal.Quotient.mk (Ideal.span {π ^ c}) π = 0 :=
    (pow_eq_zero_iff (by omega)).mp h0
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h1
  obtain ⟨w, hw⟩ := h1
  apply hπu
  have hpc : π ^ c = π * π ^ (c - 1) := by
    rw [← pow_succ']; congr 1; omega
  have h2 : π * (1 - π ^ (c - 1) * w) = 0 := by
    calc π * (1 - π ^ (c - 1) * w) = π - π ^ c * w := by rw [hpc]; ring
      _ = 0 := by rw [← hw]; ring
  have h3 := (mul_eq_zero.mp h2).resolve_left hπ0
  have h4 : π ^ (c - 1) * w = 1 := by linear_combination -h3
  refine IsUnit.of_mul_eq_one (π ^ (c - 2) * w) ?_
  calc π * (π ^ (c - 2) * w) = π ^ (c - 1) * w := by
        rw [← mul_assoc, ← pow_succ']; congr 2; omega
    _ = 1 := h4

/-- An ideal generated by a finite family of powers of `z` is `0` or generated by a single power
of `z`. -/
theorem span_range_pow_eq_bot_or_exists {z : R} {m : ℕ} (ν : Fin m → ℕ) :
    Ideal.span (Set.range fun k : Fin m => z ^ ν k) = ⊥ ∨
      ∃ c : ℕ, Ideal.span (Set.range fun k : Fin m => z ^ ν k) = Ideal.span {z ^ c} := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · left
    simp
  · right
    have : Nonempty (Fin m) := ⟨⟨0, hm⟩⟩
    obtain ⟨k₀, -, hk₀⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty ν
    refine ⟨ν k₀, le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)⟩
    · rintro _ ⟨k, rfl⟩
      have hle : ν k₀ ≤ ν k := by
        rw [← hk₀]; exact Finset.inf'_le _ (Finset.mem_univ k)
      exact Ideal.mem_span_singleton'.mpr ⟨z ^ (ν k - ν k₀), by rw [← pow_add]; congr 1; omega⟩
    · rintro _ rfl
      exact Ideal.subset_span ⟨k₀, rfl⟩

end NormalFlatnessPrincipal

/-- The stalk maps of the morphism `Z' → Z` induced by a monoidal transformation on a strict
transform `Z'` are injective at the points where `Z` is regular. -/
theorem MonoidalTransformation.injective_stalkMap_strictTransform [Hironaka.HironakaCitedResults.{u}] {Y : Scheme.{u}}
    {B : Subscheme Y} (t : MonoidalTransformation Y B) (Z : Subscheme Y)
    (fb : (Subscheme.strictTransform t Z).toScheme ⟶ Z.toScheme)
    (hfb : fb ≫ Z.ι = (Subscheme.strictTransform t Z).ι ≫ t.f)
    (q : (Subscheme.strictTransform t Z).toScheme)
    [IsRegularLocalRing (Z.toScheme.presheaf.stalk (fb q))] :
    Function.Injective (fb.stalkMap q).hom := by
  obtain ⟨⟨s⟩, hs⟩ := Subscheme.nonempty_monoidalTransformation_strictTransform t Z
  obtain ⟨e, he⟩ := hs s
  have hef : e.hom ≫ fb = s.f := by
    rw [← cancel_mono Z.ι, Category.assoc, hfb]; exact he
  obtain ⟨y, rfl⟩ : ∃ y, e.hom y = q := ⟨e.inv q, by rw [← Scheme.Hom.comp_apply]; simp⟩
  have hx : s.f y = fb (e.hom y) := by rw [← hef]; rfl
  have hreg : IsRegularLocalRing (Z.toScheme.presheaf.stalk (s.f y)) :=
    IsRegularLocalRing.of_ringEquiv
      (Z.toScheme.presheaf.stalkCongr (.of_eq hx.symm)).commRingCatIsoToRingEquiv
  have hdom := isDomain_of_isRegularLocalRing (Z.toScheme.presheaf.stalk (s.f y))
  obtain ⟨σ, ε, hε⟩ := s.exists_monoidalTransform_stalk y
  have hinj : Function.Injective (s.f.stalkMap y).hom := by
    rw [← hε]
    exact ε.injective.comp σ.toRing_injective
  have h1 : s.f.stalkMap y = (Z.toScheme.presheaf.stalkCongr (.of_eq hx)).hom ≫
      (fb.stalkMap (e.hom y) ≫ e.hom.stalkMap y) := by
    rw [← Scheme.Hom.stalkMap_comp]
    exact Scheme.Hom.stalkMap_congr_hom _ _ hef.symm y
  rw [h1] at hinj
  intro a b hab
  have hc : Function.Bijective (Z.toScheme.presheaf.stalkCongr (.of_eq hx)).hom :=
    (ConcreteCategory.isIso_iff_bijective _).mp inferInstance
  obtain ⟨a', rfl⟩ := hc.2 a
  obtain ⟨b', rfl⟩ := hc.2 b
  have : a' = b' := hinj (by
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
    rw [hab])
  rw [this]

/-- `a + 1 = m + 1` implies `a = m` in `WithBot ℕ∞`. -/
theorem eq_of_add_one_eq_withBot_enat {a : WithBot ℕ∞} {m : ℕ}
    (h : a + 1 = ((m + 1 : ℕ) : WithBot ℕ∞)) : a = (m : WithBot ℕ∞) := by
  induction a using WithBot.recBotCoe with
  | bot =>
    exfalso
    rw [WithBot.bot_add] at h
    exact WithBot.bot_ne_coe h
  | coe a =>
    induction a using ENat.recTopCoe with
    | top =>
      exfalso
      have : ((⊤ : ℕ∞) : WithBot ℕ∞) + 1 = ((⊤ : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add, top_add]
      rw [this] at h
      exact ENat.top_ne_natCast (m + 1) (WithBot.coe_inj.mp h)
    | coe k =>
      have h' : ((k + 1 : ℕ) : WithBot ℕ∞) = ((m + 1 : ℕ) : WithBot ℕ∞) := by
        rw [← h]; norm_cast
      have := Nat.succ_injective (by exact_mod_cast h' : k + 1 = m + 1)
      rw [this]
      rfl

/-- `a + 1 ≤ m + 1` implies `a ≤ m` in `WithBot ℕ∞`. -/
theorem le_of_add_one_le_withBot_enat {a : WithBot ℕ∞} {m : ℕ}
    (h : a + 1 ≤ ((m + 1 : ℕ) : WithBot ℕ∞)) : a ≤ (m : WithBot ℕ∞) := by
  induction a using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe a =>
    induction a using ENat.recTopCoe with
    | top =>
      exfalso
      have : ((⊤ : ℕ∞) : WithBot ℕ∞) + 1 = ((⊤ : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add, top_add]
      rw [this] at h
      have := WithBot.coe_le_coe.mp h
      simp at this
    | coe k =>
      have h' : ((k + 1 : ℕ) : WithBot ℕ∞) ≤ ((m + 1 : ℕ) : WithBot ℕ∞) := by
        convert h using 1
        norm_cast
      exact_mod_cast (Nat.succ_le_succ_iff.mp (by exact_mod_cast h') : k ≤ m)

namespace AB

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X} {T : Tower X} {x₀ : X} {hS : Standing N n ℜ P r T x₀}
  (𝒮 : Frame hS)

/-- `(z)` is a prime ideal of `Ŝ`, and `z` is a non-zero member of the maximal ideal. -/
theorem Frame.isPrime_span_z_and_ne_zero_and_mem_maximalIdeal
    [IsRegularLocalRing (Shat X x₀)] :
    (Ideal.span {𝒮.z}).IsPrime ∧ 𝒮.z ≠ 0 ∧ 𝒮.z ∈ maximalIdeal (Shat X x₀) := by
  classical
  obtain ⟨Fr, h1, hz, -⟩ := 𝒮.frame
  obtain ⟨K, hK, hrsop⟩ := Fr.extends_rsop
  have hzK : 𝒮.z ∈ K := hK (hz ▸ Finset.mem_image_of_mem _ (Finset.mem_univ _))
  have hzM : 𝒮.z ∈ maximalIdeal (Shat X x₀) := hrsop.1 ▸ Ideal.subset_span hzK
  have hext : ExtendsToRSOP (Shat X x₀) {𝒮.z} :=
    ⟨K, Finset.singleton_subset_iff.mpr hzK, hrsop⟩
  have hreg : IsRegularLocalRing (Shat X x₀ ⧸ Ideal.span {𝒮.z}) :=
    hext.isRegularLocalRing_quotient_span_singleton (Finset.mem_singleton_self _)
  have hz0 : 𝒮.z ≠ 0 := hext.ne_zero (Finset.mem_singleton_self _)
  have : IsDomain (Shat X x₀ ⧸ Ideal.span {𝒮.z}) := isDomain_of_isRegularLocalRing _
  exact ⟨(Ideal.Quotient.isDomain_iff_prime _).mp this, hz0, hzM⟩

/-- If the stalk of `J̄(0)` at a point of `X̄_0` is zero, every generator `g_{jki}^{b/i}` of `J̄`
lies in `(z)Ŝ`. -/
theorem Frame.mem_span_z_of_stalkIdeal_jBar_zero_eq_bot [IsRegularLocalRing (Shat X x₀)]
    (xb : (𝒮.xBar 0).toScheme)
    (h : (𝒮.jBar 0).stalkIdeal xb = ⊥) : ∀ y ∈ 𝒮.jGen, y ∈ Ideal.span {𝒮.z} := by
  classical
  obtain ⟨hzprime, -, -⟩ := 𝒮.isPrime_span_z_and_ne_zero_and_mem_maximalIdeal
  set xh : 𝒮.tHat.X 0 := (𝒮.xBar 0).ι.base xb with hxh
  let Pr : PrimeSpectrum (Shat X x₀) := xh
  let Pi : Ideal (Shat X x₀) := Pr.asIdeal
  have : Pi.IsPrime := Pr.isPrime
  have hzP : 𝒮.z ∈ Pi := by
    have hmem : xh ∈ (𝒮.xBar 0).pts := Subscheme.mem_pts_ι (𝒮.xBar 0) xb
    have := (mem_pts_ofIdealTop_spec (CommRingCat.of (Shat X x₀)) (Ideal.span {𝒮.z}) xh).mp hmem
    exact this (Ideal.mem_span_singleton_self _)
  let e : Localization.AtPrime Pi ≃+* (𝒮.tHat.X 0).presheaf.stalk xh :=
    (Spec.stalkIso (CommRingCat.of (Shat X x₀)) Pr).symm.commRingCatIsoToRingEquiv
  have hX0 : (𝒮.xBar 0).stalkIdeal xh = Ideal.span {e (algebraMap _ _ 𝒮.z)} := by
    have h2 := stalkIdeal_ofIdealTop_spec (CommRingCat.of (Shat X x₀)) (Ideal.span {𝒮.z}) Pr
    refine Eq.trans (show Subscheme.stalkIdeal (vZ X x₀ 𝒮.z) xh = _ from h2) ?_
    rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
    rfl
  let O : Subscheme (𝒮.tHat.X 0) := Scheme.IdealSheafData.ofIdealTop ((Ideal.span 𝒮.jGen).map
      (Scheme.ΓSpecIso (CommRingCat.of (Shat X x₀))).inv.hom)
  have hO : Subscheme.stalkIdeal O xh =
      ((Ideal.span 𝒮.jGen).map (algebraMap (Shat X x₀) (Localization.AtPrime Pi))).map e :=
    stalkIdeal_ofIdealTop_spec (CommRingCat.of (Shat X x₀)) (Ideal.span 𝒮.jGen) Pr
  set φ := ((𝒮.xBar 0).ι.stalkMap xb).hom with hφ
  have hJ : (𝒮.jBar 0).stalkIdeal xb = (O.stalkIdeal xh).map φ := by
    show (Subscheme.totalTransform (𝒮.xBar 0).ι O).stalkIdeal xb = _
    rw [stalkIdeal_totalTransform]
  have hφker : RingHom.ker φ = Ideal.span {e (algebraMap _ _ 𝒮.z)} := by
    rw [← hX0]
    exact (stalkIdeal_eq_ker_stalkMap (𝒮.xBar 0) xb).symm
  intro y hy
  have hy1 : e (algebraMap _ _ y) ∈ O.stalkIdeal xh := by
    rw [hO]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (Ideal.subset_span hy))
  have hy2 : φ (e (algebraMap _ _ y)) ∈ (𝒮.jBar 0).stalkIdeal xb := by
    rw [hJ]
    exact Ideal.mem_map_of_mem _ hy1
  rw [h, Ideal.mem_bot] at hy2
  have hy3 : e (algebraMap _ _ y) ∈ RingHom.ker φ := hy2
  rw [hφker, Ideal.mem_span_singleton] at hy3
  obtain ⟨c, hc⟩ := hy3
  have hy4 : algebraMap (Shat X x₀) (Localization.AtPrime Pi) y ∈
      (Ideal.span {𝒮.z}).map (algebraMap (Shat X x₀) (Localization.AtPrime Pi)) := by
    rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
    exact ⟨e.symm c, by
      apply e.injective
      rw [map_mul, RingEquiv.apply_symm_apply]
      exact hc⟩
  have hdisj : Disjoint (Pi.primeCompl : Set (Shat X x₀)) (Ideal.span {𝒮.z} : Set (Shat X x₀)) :=
    Set.disjoint_left.mpr fun a ha haz =>
      ha ((Ideal.span_singleton_le_iff_mem Pi).mpr hzP haz)
  have := IsLocalization.under_map_of_isPrime_disjoint Pi.primeCompl (Localization.AtPrime Pi)
    hzprime hdisj
  rw [← this]
  exact hy4

/-- If all the generators `g_{jki}^{b/i}` of `J̄` lie in `(z)Ŝ` then all `g_{jki}` vanish, so the
standard bases of the `Ĵ_j` consist of unit multiples of powers of `z`, and each `Ĵ_j` is
generated by powers of `z`. -/
theorem Frame.exists_jHat_eq_span_pow_of_jGen_subset [IsRegularLocalRing (Shat X x₀)]
    (H : ∀ y ∈ 𝒮.jGen, y ∈ Ideal.span {𝒮.z}) :
    ∃ (m : Fin (ℜ.β + 1) → ℕ) (ν : ∀ j, Fin (m j) → ℕ), ∀ j,
      (jSys ℜ x₀ j).map (algebraMap (X.presheaf.stalk x₀) (Shat X x₀)) =
        Ideal.span (Set.range fun k : Fin (m j) => 𝒮.z ^ ν j k) := by
  classical
  obtain ⟨hzprime, hz0, hzM⟩ := 𝒮.isPrime_span_z_and_ne_zero_and_mem_maximalIdeal
  obtain ⟨Fr, h1, hFz, -, -, m, g, v, ν, co, hstd, -, -, hshape, -, hjGen⟩ := 𝒮.frame
  have hrange : Set.range Fr.z = {𝒮.z} := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      have : i = ⟨0, by rw [h1]; exact Nat.one_pos⟩ := Fin.ext (by have := i.2; omega)
      rw [this, hFz]; rfl
    · rintro rfl
      exact ⟨⟨0, by rw [h1]; exact Nat.one_pos⟩, hFz⟩
  have hinj : Function.Injective ((Ideal.Quotient.mk (Ideal.span (Set.range Fr.z))).comp
      (algebraMap Fr.S (Shat X x₀))) := Fr.quot_bijective.1
  have : IsDomain Fr.S := isDomain_of_isRegularLocalRing Fr.S
  have hco : ∀ j k i, co j k i = 0 := by
    intro j k i
    have hy : algebraMap Fr.S (Shat X x₀) (co j k i) ^ (𝒮.b / ((i : ℕ) + 1)) ∈ 𝒮.jGen := by
      rw [hjGen]; exact ⟨j, k, i, rfl⟩
    have hy' := H _ hy
    rw [← map_pow] at hy'
    have h0 : ((Ideal.Quotient.mk (Ideal.span (Set.range Fr.z))).comp
        (algebraMap Fr.S (Shat X x₀))) (co j k i ^ (𝒮.b / ((i : ℕ) + 1))) =
        ((Ideal.Quotient.mk (Ideal.span (Set.range Fr.z))).comp
          (algebraMap Fr.S (Shat X x₀))) 0 := by
      rw [map_zero, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hrange]
      exact hy'
    have h2 := hinj h0
    rcases Nat.eq_zero_or_pos (𝒮.b / ((i : ℕ) + 1)) with he | he
    · rw [he, pow_zero] at h2
      exact absurd h2 one_ne_zero
    · exact pow_eq_zero_iff he.ne' |>.mp h2
  refine ⟨m, ν, fun j => ?_⟩
  have hgj : ∀ k, g j k = (v j k : Shat X x₀) * 𝒮.z ^ ν j k := fun k => by
    rw [hshape j k]
    simp [hco]
  refine (span_eq_of_isStandardBase (Shat X x₀) _ (g j) (hstd j)).symm.trans ?_
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    rw [hgj k]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    have : 𝒮.z ^ ν j k = ((v j k)⁻¹ : (Shat X x₀)ˣ) * g j k := by
      rw [hgj k, ← mul_assoc, Units.inv_mul, one_mul]
    show 𝒮.z ^ ν j k ∈ _
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)

/-- The stalk of `W` at `x_0` is non-zero: `dim W = n < N = dim X`, so the generic point of `X` is
not on `W`. -/
theorem Standing.stalkIdeal_W_ne_bot (hS : Standing N n ℜ P r T x₀) :
    ℜ.W.stalkIdeal x₀ ≠ ⊥ := by
  have hlt : ℜ.W.dim < X.dim := by
    rw [hS.ambient.2.2.2]
    exact (show ℜ.W.dim = n from hS.dim_W).trans_lt (by exact_mod_cast hS.lt)
  have := hS.ambient.2.2.1
  exact Subscheme.stalkIdeal_ne_bot_of_genericPoint_notMem ℜ.W
    (LocSucc.genericPoint_notMem_of_dim_lt hlt) x₀

/-- Closed case of the non-vanishing of `J̄(0)`: if all the generators of `J̄` lay in `(z)Ŝ`, then
`Ĵ_0` would be generated by powers of `z = α(z_0)`, so `z_0^a ∈ J_0` for some `a`, hence `z_0 ∈ J_0`
(`W` is reduced) and `W ⊆ F` near `x_0` (contradicting the density of `W − F` in `W`). -/
theorem Frame.false_of_jGen_subset_span_z_of_closed [IsRegularLocalRing (Shat X x₀)]
    {F : Subscheme X} (hr : r = .closed F) (H : ∀ y ∈ 𝒮.jGen, y ∈ Ideal.span {𝒮.z}) : False := by
  classical
  have hx0 := hS.ambient.2.1 x₀
  have : IsRegularLocalRing (X.presheaf.stalk x₀) := hx0
  have := hS.ambient.1
  have := IsAlgebraicScheme.noetherianSpace X
  let α := algebraMap (X.presheaf.stalk x₀) (Shat X x₀)
  have hFF := faithfullyFlat_adicCompletion_maximalIdeal (X.presheaf.stalk x₀)
  obtain ⟨m, ν, hJ⟩ := 𝒮.exists_jHat_eq_span_pow_of_jGen_subset H
  have hJ0 : (ℜ.W.stalkIdeal x₀).map α =
      Ideal.span (Set.range fun k : Fin (m 0) => 𝒮.z ^ ν 0 k) := by
    have := hJ 0
    simpa only [jSys, Fin.cons_zero] using this
  have hW0 := hS.stalkIdeal_W_ne_bot
  have hm : m 0 ≠ 0 := by
    intro hm0
    apply hW0
    have : (ℜ.W.stalkIdeal x₀).map α = ⊥ := by
      rw [hJ0]
      have : IsEmpty (Fin (m 0)) := by rw [hm0]; infer_instance
      simp
    rw [Ideal.map_eq_bot_iff_le_ker] at this
    have hinj : Function.Injective α := RingHom.MapsRSOP.injective α mapsRSOP_algebraMap_adicCompletion
    rw [(RingHom.injective_iff_ker_eq_bot α).mp hinj] at this
    exact le_bot_iff.mp this
  obtain ⟨Fr, h1, hFz, hF, -⟩ := 𝒮.frame
  obtain ⟨z₀, hz₀, hFz₀⟩ := hF F hr
  let k0 : Fin (m 0) := ⟨0, Nat.pos_of_ne_zero hm⟩
  have hmem : α (z₀ ^ ν 0 k0) ∈ (ℜ.W.stalkIdeal x₀).map α := by
    rw [hJ0, map_pow, hz₀]
    exact Ideal.subset_span ⟨k0, rfl⟩
  have hmem' : z₀ ^ ν 0 k0 ∈ ℜ.W.stalkIdeal x₀ := by
    have := Ideal.comap_map_eq_self_of_faithfullyFlat (B := Shat X x₀) (ℜ.W.stalkIdeal x₀)
    rw [← this]
    exact hmem
  have hz₀W : z₀ ∈ ℜ.W.stalkIdeal x₀ :=
    (Subscheme.isRadical_stalkIdeal_of_isReduced hS.isDatum.2.2.2.1 x₀) ⟨ν 0 k0, hmem'⟩
  have hFW : F.stalkIdeal x₀ ≤ ℜ.W.stalkIdeal x₀ := by
    rw [hFz₀, Ideal.span_singleton_le_iff_mem]
    exact hz₀W
  subst hr
  have hxW : x₀ ∈ ℜ.W.pts := hS.mem_wStar.1
  have hdense : ℜ.W.pts ⊆ closure (ℜ.W.pts \ F.pts) := (show ℜ.IsClosedRestriction F from hS.isFor).2.2
  obtain ⟨G, hG, hxG⟩ := Subscheme.exists_mem_irreducibleComponents_of_mem_pts ℜ.W hxW
  have hGmin := Subscheme.stalkIdeal_mem_minimalPrimes hG hxG
  have hsub : G.pts ⊆ F.pts :=
    PrepSetting.pts_subset_of_stalkIdeal_le_of_mem_irreducibleComponents hG hxG
      (hFW.trans hGmin.1.2)
  exact Subscheme.not_pts_subset_of_mem_irreducibleComponents_of_subset_closure_diff hG hdense hsub

/-- `Ŝ/(z)` is a regular local ring. -/
theorem Frame.isRegularLocalRing_quotient_span_z [IsRegularLocalRing (Shat X x₀)] :
    IsRegularLocalRing (Shat X x₀ ⧸ Ideal.span {𝒮.z}) := by
  classical
  obtain ⟨Fr, h1, hz, -⟩ := 𝒮.frame
  obtain ⟨K, hK, hrsop⟩ := Fr.extends_rsop
  have hzK : 𝒮.z ∈ K := hK (hz ▸ Finset.mem_image_of_mem _ (Finset.mem_univ _))
  have hext : ExtendsToRSOP (Shat X x₀) {𝒮.z} :=
    ⟨K, Finset.singleton_subset_iff.mpr hzK, hrsop⟩
  exact hext.isRegularLocalRing_quotient_span_singleton (Finset.mem_singleton_self _)

/-- The points of the total transform `c_0⁻¹(V)` of a subscheme `V` of `X` in `X̂_0 = Spec Ŝ`: a
prime `Q` of `Ŝ` lies on it iff it contains `V_{x_0}Ŝ`. -/
theorem mem_pts_totalTransform_c0_iff (V : Subscheme X) (Q : xHat0 X x₀) :
    Q ∈ (Subscheme.totalTransform (c0 X x₀) V).pts ↔
      (V.stalkIdeal x₀).map (algebraMap (X.presheaf.stalk x₀) (Shat X x₀)) ≤
        (show PrimeSpectrum (Shat X x₀) from Q).asIdeal := by
  classical
  let Pi : Ideal (Shat X x₀) := (show PrimeSpectrum (Shat X x₀) from Q).asIdeal
  have : Pi.IsPrime := (show PrimeSpectrum (Shat X x₀) from Q).isPrime
  set I := (V.stalkIdeal x₀).map (algebraMap (X.presheaf.stalk x₀) (Shat X x₀)) with hI
  let e' := (Spec.stalkIso (CommRingCat.of (Shat X x₀)) (show PrimeSpectrum (Shat X x₀) from Q)).inv
  have hbij : Function.Bijective e'.hom := (ConcreteCategory.isIso_iff_bijective _).mp inferInstance
  rw [Subscheme.mem_pts_iff_stalkIdeal_ne_top, Frame.stalkIdeal_totalTransform_c0_stalkIso x₀ V Q]
  have h1 : (I.map (algebraMap (Shat X x₀) (Localization.AtPrime Pi))).map e'.hom = ⊤ ↔
      I.map (algebraMap (Shat X x₀) (Localization.AtPrime Pi)) = ⊤ := by
    constructor
    · intro h
      have := Ideal.comap_map_of_bijective e'.hom hbij (I := I.map (algebraMap (Shat X x₀)
        (Localization.AtPrime Pi)))
      rw [h, Ideal.comap_top] at this
      exact this.symm
    · intro h
      rw [h, Ideal.map_top]
  refine ⟨fun h => ?_, fun h hh => ?_⟩
  · by_contra hnle
    exact h (h1.mpr (IsLocalization.AtPrime.map_eq_top_of_not_le
      (S := Localization.AtPrime Pi) hnle))
  · have h2 := h1.mp hh
    have h3 := (IsLocalization.map_algebraMap_ne_top_iff_disjoint Pi.primeCompl
      (Localization.AtPrime Pi) I).mpr (Set.disjoint_left.mpr fun a ha haI => ha (h haI))
    exact h3 h2

/-- If all the generators of `J̄` lie in `(z)Ŝ`, and `x_0 ∈ W`, then `Ĵ_0 = (z)`: `Ĵ_0` is a power
`(z^c)` of `(z)` with `c ≥ 1`; the prime `(z)` of `Ŝ` lies over a point `y` of `W` with no proper
generization in `W` (`Ŝ` is flat over `S`, so generizations lift, and `V(Ĵ_0) = V(z)`), where `W`
is reduced, so `W_y` is the maximal ideal of `O_{X,y}`; by class 𝔅 (`(K5)`) the local ring
`Ŝ_{(z)}/(z^c)` is regular, hence a domain, whence `c ≤ 1`. -/
theorem Frame.map_stalkIdeal_W_eq_span_z_of_jGen_subset [Hironaka.HironakaCitedResults.{u}] [IsRegularLocalRing (Shat X x₀)]
    (hxW : x₀ ∈ ℜ.W.pts) (H : ∀ y ∈ 𝒮.jGen, y ∈ Ideal.span {𝒮.z}) :
    (ℜ.W.stalkIdeal x₀).map (algebraMap (X.presheaf.stalk x₀) (Shat X x₀)) =
      Ideal.span {𝒮.z} := by
  classical
  have hx0 := hS.ambient.2.1 x₀
  have : IsRegularLocalRing (X.presheaf.stalk x₀) := hx0
  have : IsAlgebraicScheme X := hS.ambient.1
  have : IsHironakaBase (X.presheaf.stalk x₀) := isHironakaBase_stalk X x₀
  obtain ⟨hzprime, hz0, hzM⟩ := 𝒮.isPrime_span_z_and_ne_zero_and_mem_maximalIdeal
  have : IsDomain (Shat X x₀) := isDomain_of_isRegularLocalRing _
  let α := algebraMap (X.presheaf.stalk x₀) (Shat X x₀)
  have hinj : Function.Injective α := RingHom.MapsRSOP.injective α mapsRSOP_algebraMap_adicCompletion
  have hFF := faithfullyFlat_adicCompletion_maximalIdeal (X.presheaf.stalk x₀)
  obtain ⟨m, ν, hJ⟩ := 𝒮.exists_jHat_eq_span_pow_of_jGen_subset H
  have hJ0 : (ℜ.W.stalkIdeal x₀).map α =
      Ideal.span (Set.range fun k : Fin (m 0) => 𝒮.z ^ ν 0 k) := by
    have := hJ 0
    simpa only [jSys, Fin.cons_zero] using this
  have hJ0ne : (ℜ.W.stalkIdeal x₀).map α ≠ ⊥ := by
    intro h
    rw [Ideal.map_eq_bot_iff_le_ker, (RingHom.injective_iff_ker_eq_bot α).mp hinj] at h
    exact hS.stalkIdeal_W_ne_bot (le_bot_iff.mp h)
  obtain ⟨c, hc⟩ := (span_range_pow_eq_bot_or_exists (z := 𝒮.z) (ν 0)).resolve_left
    (hJ0 ▸ hJ0ne)
  rw [hc] at hJ0
  -- `c ≥ 1`
  have hc1 : 1 ≤ c := by
    rcases Nat.eq_zero_or_pos c with rfl | h
    · exfalso
      rw [pow_zero, Ideal.span_singleton_one] at hJ0
      have := Ideal.comap_map_eq_self_of_faithfullyFlat (B := Shat X x₀) (ℜ.W.stalkIdeal x₀)
      rw [hJ0, Ideal.comap_top] at this
      exact (Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hxW) this.symm
    · exact h
  -- the point `ŷ = (z)` of `X̂_0` and its image `y` in `X`
  let ŷ : xHat0 X x₀ := (⟨Ideal.span {𝒮.z}, hzprime⟩ : PrimeSpectrum (Shat X x₀))
  have hŷ : (show PrimeSpectrum (Shat X x₀) from ŷ).asIdeal = Ideal.span {𝒮.z} := rfl
  have hpts : ∀ Q : xHat0 X x₀, Q ∈ (Subscheme.totalTransform (c0 X x₀) ℜ.W).pts ↔
      𝒮.z ∈ (show PrimeSpectrum (Shat X x₀) from Q).asIdeal := by
    intro Q
    rw [mem_pts_totalTransform_c0_iff, hJ0, Ideal.span_singleton_le_iff_mem]
    exact (show PrimeSpectrum (Shat X x₀) from Q).isPrime.pow_mem_iff_mem c hc1
  have hŷmem : ŷ ∈ (Subscheme.totalTransform (c0 X x₀) ℜ.W).pts :=
    (hpts ŷ).mpr (by rw [hŷ]; exact Ideal.mem_span_singleton_self _)
  have hyW : (c0 X x₀).base ŷ ∈ ℜ.W.pts := by
    rw [Subscheme.pts_totalTransform_eq_preimage] at hŷmem
    exact hŷmem
  have hflat : Flat (c0 X x₀) := flat_c0 X x₀ hx0
  have hmin : ∀ y' ∈ ℜ.W.pts, y' ⤳ (c0 X x₀).base ŷ → y' = (c0 X x₀).base ŷ := by
    intro y' hy'W hy'y
    obtain ⟨ŷ', hŷ'ŷ, hcŷ'⟩ := Flat.generalizingMap (c0 X x₀) hy'y
    have hŷ'mem : ŷ' ∈ (Subscheme.totalTransform (c0 X x₀) ℜ.W).pts := by
      rw [Subscheme.pts_totalTransform_eq_preimage]
      show (c0 X x₀).base ŷ' ∈ ℜ.W.pts
      rw [hcŷ']
      exact hy'W
    have hz' := (hpts ŷ').mp hŷ'mem
    have hle : (show PrimeSpectrum (Shat X x₀) from ŷ') ≤ (show PrimeSpectrum (Shat X x₀) from ŷ) :=
      (PrimeSpectrum.le_iff_specializes _ _).mpr hŷ'ŷ
    have heq : (show PrimeSpectrum (Shat X x₀) from ŷ') = (show PrimeSpectrum (Shat X x₀) from ŷ) :=
      PrimeSpectrum.ext (le_antisymm hle ((Ideal.span_singleton_le_iff_mem _).mpr hz'))
    rw [← hcŷ']
    exact congrArg (c0 X x₀).base heq
  have hWy := Subscheme.stalkIdeal_eq_maximalIdeal_of_forall_specializes
    hS.isDatum.2.2.2.1 hyW hmin
  have hreg : IsRegularLocalRing (X.presheaf.stalk ((c0 X x₀).base ŷ) ⧸
      ℜ.W.stalkIdeal ((c0 X x₀).base ŷ)) := by
    have hfield : IsRegularLocalRing (X.presheaf.stalk ((c0 X x₀).base ŷ) ⧸
        maximalIdeal (X.presheaf.stalk ((c0 X x₀).base ŷ))) := by
      let _ : Field (X.presheaf.stalk ((c0 X x₀).base ŷ) ⧸
        maximalIdeal (X.presheaf.stalk ((c0 X x₀).base ŷ))) := Ideal.Quotient.field _
      infer_instance
    exact IsRegularLocalRing.of_ringEquiv (Ideal.quotEquivOfEq hWy.symm) 
  have hH : IsPullback (c0 X x₀) (𝟙 (xHat0 X x₀)) (𝟙 X)
      (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x₀) (Shat X x₀))) ≫
        X.fromSpecStalk x₀) :=
    IsPullback.of_vert_isIso ⟨by simp [c0]⟩
  have hK5 := isRegularLocalRing_quotient_stalk_totalTransform_of_isPullback_completion x₀ (𝟙 X)
    (c0 X x₀) (𝟙 (xHat0 X x₀)) hH ℜ.W ŷ hreg
  -- the stalk of `c_0⁻¹(W)` at `ŷ` is `(π^c)`, `π = z` in the localization `Ŝ_{(z)}`
  let Pi : Ideal (Shat X x₀) := (show PrimeSpectrum (Shat X x₀) from ŷ).asIdeal
  have hPi : Pi = Ideal.span {𝒮.z} := rfl
  have : Pi.IsPrime := (show PrimeSpectrum (Shat X x₀) from ŷ).isPrime
  let e : Localization.AtPrime Pi ≃+* (xHat0 X x₀).presheaf.stalk ŷ :=
    (Spec.stalkIso (CommRingCat.of (Shat X x₀)) (show PrimeSpectrum (Shat X x₀) from ŷ)).symm.commRingCatIsoToRingEquiv
  set π : Localization.AtPrime Pi := algebraMap (Shat X x₀) (Localization.AtPrime Pi) 𝒮.z with hπ
  have hst : (Subscheme.totalTransform (c0 X x₀) ℜ.W).stalkIdeal ŷ =
      (Ideal.span {π ^ c}).map (e : _ →+* _) := by
    rw [Frame.stalkIdeal_totalTransform_c0_stalkIso x₀ ℜ.W ŷ, hJ0]
    congr 1
    rw [Ideal.map_span, Set.image_singleton, map_pow]
  have e2 : (Localization.AtPrime Pi ⧸ Ideal.span {π ^ c}) ≃+*
      ((xHat0 X x₀).presheaf.stalk ŷ ⧸
        (Subscheme.totalTransform (c0 X x₀) ℜ.W).stalkIdeal ŷ) :=
    Ideal.quotientEquiv _ _ e hst
  have hK5' : IsRegularLocalRing (Localization.AtPrime Pi ⧸ Ideal.span {π ^ c}) :=
    IsRegularLocalRing.of_ringEquiv (R := (xHat0 X x₀).presheaf.stalk ŷ ⧸
      (Subscheme.totalTransform (c0 X x₀) ℜ.W).stalkIdeal ŷ) e2.symm
  have hdom : IsDomain (Localization.AtPrime Pi ⧸ Ideal.span {π ^ c}) :=
    isDomain_of_isRegularLocalRing _
  have hπ0 : π ≠ 0 := fun h => hz0 (IsLocalization.injective (Localization.AtPrime Pi)
    (Ideal.primeCompl_le_nonZeroDivisors Pi) (h.trans (map_zero _).symm))
  have hπu : ¬ IsUnit π := (mem_maximalIdeal _).mp
    ((IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Pi) Pi _).mpr
      (by rw [hPi]; exact Ideal.mem_span_singleton_self _))
  have hcle : c ≤ 1 := le_one_of_isDomain_quotient_span_pow hπ0 hπu hdom
  rw [hJ0, show c = 1 by omega, pow_one]

/-- Open case of the non-vanishing of `J̄(0)`: if all the generators of `J̄` lay in `(z)Ŝ`, then
`Ĵ_0 = (z)` and each `Ĵ_j` is generated by a power of `z` (or zero), so `W` is simple at `x_0` and
all the `V_j` are normally flat along `W` at `x_0` (a thickening of a regular hypersurface is
normally flat along it, and normal flatness descends along `S → Ŝ`), contradicting Remark 1. -/
theorem Frame.false_of_jGen_subset_span_z_of_opn [Hironaka.HironakaCitedResults.{u}] [IsRegularLocalRing (Shat X x₀)] {U : Set X}
    (hr : r = .opn U) (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s)
    (H : ∀ y ∈ 𝒮.jGen, y ∈ Ideal.span {𝒮.z}) : False := by
  classical
  have hx0 := hS.ambient.2.1 x₀
  have : IsRegularLocalRing (X.presheaf.stalk x₀) := hx0
  obtain ⟨hzprime, hz0, hzM⟩ := 𝒮.isPrime_span_z_and_ne_zero_and_mem_maximalIdeal
  have : IsDomain (Shat X x₀) := isDomain_of_isRegularLocalRing _
  let α := algebraMap (X.presheaf.stalk x₀) (Shat X x₀)
  have hFF := faithfullyFlat_adicCompletion_maximalIdeal (X.presheaf.stalk x₀)
  have hxW : x₀ ∈ ℜ.W.pts := by
    have h := hS.mem_wStar
    rw [hr] at h
    exact h.1
  have hJ1 := 𝒮.map_stalkIdeal_W_eq_span_z_of_jGen_subset hxW H
  have hWne : ℜ.W.stalkIdeal x₀ ≠ ⊤ := Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hxW
  -- `W` is simple at `x_0`
  have hregz := 𝒮.isRegularLocalRing_quotient_span_z
  have hsimple : ℜ.W.IsSimpleAt x₀ :=
    ⟨hxW, isRegularLocalRing_quotient_of_isRegularLocalRing_quotient_map_adicCompletion
      (ℜ.W.stalkIdeal x₀) (IsRegularLocalRing.of_ringEquiv (Ideal.quotEquivOfEq hJ1.symm))⟩
  -- the `V_j` are normally flat along `W` at `x_0`
  obtain ⟨m, ν, hJ⟩ := 𝒮.exists_jHat_eq_span_pow_of_jGen_subset H
  have hNF : ∀ j, Subscheme.IsNormallyFlatAlongAt' (ℜ.V j) ℜ.W x₀ := by
    intro j
    have hWV : ℜ.W.IsContainedIn (ℜ.V j) := hS.isDatum.2.2.2.2 j
    have hle : (ℜ.V j).stalkIdeal x₀ ≤ ℜ.W.stalkIdeal x₀ :=
      Subscheme.stalkIdeal_le_stalkIdeal_of_isContainedIn hWV x₀
    have hVj : ((ℜ.V j).stalkIdeal x₀).map α =
        Ideal.span (Set.range fun k : Fin (m j.succ) => 𝒮.z ^ ν j.succ k) := by
      have := hJ j.succ
      simpa only [jSys, Fin.cons_succ] using this
    have hNFhat : IsNormallyFlatAlongIdeal (((ℜ.W.stalkIdeal x₀).map α).map
        (Ideal.Quotient.mk (((ℜ.V j).stalkIdeal x₀).map α))) := by
      rw [hJ1]
      rcases span_range_pow_eq_bot_or_exists (z := 𝒮.z) (ν j.succ) with h0 | ⟨c', hc'⟩
      · exact isNormallyFlatAlongIdeal_map_span_singleton_of_eq_bot_or_eq_span_pow hz0
          (Or.inl (hVj.trans h0))
      · have hVj' := hVj.trans hc'
        have hc'1 : 1 ≤ c' := by
          rcases Nat.eq_zero_or_pos c' with rfl | h
          · exfalso
            have h2 := Ideal.map_mono (f := α) hle
            rw [hVj', hJ1, pow_zero, Ideal.span_singleton_one] at h2
            exact hzprime.ne_top (top_le_iff.mp h2)
          · exact h
        exact isNormallyFlatAlongIdeal_map_span_singleton_of_eq_bot_or_eq_span_pow hz0
          (Or.inr ⟨c', hc'1, hVj'⟩)
    have hdesc := (isNormallyFlatAlongIdeal_map_iff (R := X.presheaf.stalk x₀)
      (R' := Shat X x₀) ((ℜ.V j).stalkIdeal x₀) (ℜ.W.stalkIdeal x₀) hle hWne).mpr hNFhat
    exact (Subscheme.isNormallyFlatAlongAt'_iff (ℜ.V j) ℜ.W hWV x₀).mpr ⟨hxW, hdesc⟩
  rcases Standing.not_isSimpleAt_or_exists_not_isNormallyFlatAlongAt_of_prepHyp hS s U hr hprep
    with h | ⟨j, hj⟩
  · exact h hsimple
  · exact hj (hNF j)

/-- Non-vanishing of `J̄(0)`: for the prepared stage `s` (`x_0 ∈ g_s(S(ℜ(s)))`, [(1)], [(2)]),
the stalks of `J̄(0)` at all points of `X̄_0` are non-zero.  Closed case: otherwise all the
generators of `J̄` would lie in `(z)Ŝ`, `W ⊆ F` near `x_0`.  Open case: `W` would be simple at `x_0`
and all the `V_j` normally flat along it (Remark 1). -/
theorem Frame.stalkIdeal_jBar_zero_ne_bot [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s)
    (xb : (𝒮.xBar 0).toScheme) : (𝒮.jBar 0).stalkIdeal xb ≠ ⊥ := by
  have := 𝒮.regShat
  intro h
  have H := 𝒮.mem_span_z_of_stalkIdeal_jBar_zero_eq_bot xb h
  have hr : (∃ F, r = .closed F) ∨ ∃ U, r = .opn U := by
    cases r with
    | closed F => exact Or.inl ⟨F, rfl⟩
    | opn U => exact Or.inr ⟨U, rfl⟩
  rcases hr with ⟨F, hF⟩ | ⟨U, hU⟩
  · exact 𝒮.false_of_jGen_subset_span_z_of_closed hF H
  · exact 𝒮.false_of_jGen_subset_span_z_of_opn hU s hprep H

namespace Frame.RemovalFamily

variable {𝒮} (R : 𝒮.RemovalFamily)

/-- `J̄(s)` has non-zero stalks on `Ū_s`: the division of `f̄_s⁻¹(J̄(s))` by the `b`-th power of the
exceptional divisor does not kill a non-zero stalk, as the stalk maps of `f̄_s` are injective at the
points of `Ū_{s+1}` (`X̄_s` is regular there). -/
theorem stalkIdeal_jBar_ne_bot [Hironaka.HironakaCitedResults.{u}] (s₀ : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s₀) :
    ∀ (s : ℕ), ∀ xb ∈ R.uBar s, (𝒮.jBar s).stalkIdeal xb ≠ ⊥
  | 0 => fun xb _ => 𝒮.stalkIdeal_jBar_zero_ne_bot s₀ hprep xb
  | s + 1 => fun xb hxb => by
    have hx := R.mem_diff_of_mem_uBar_succ s xb hxb
    have hIH := stalkIdeal_jBar_ne_bot s₀ hprep s ((𝒮.fBar s).base xb) hx.1
    have hsimple := ((R.isSimpleAt_and_isIrreducible_and_isNonsingCodimOneOn s).1
      ((𝒮.fBar s).base xb) hx.1)
    have : IsRegularLocalRing ((𝒮.xBar s).toScheme.presheaf.stalk ((𝒮.fBar s).base xb)) := hsimple
    have hinj := MonoidalTransformation.injective_stalkMap_strictTransform
      (𝒮.tHat.monoidalTransformation s) (𝒮.xBar s) (𝒮.fBar s) (𝒮.fBar_comm s) xb
    rw [𝒮.jBar_succ s, Subscheme.stalkIdeal_divPow_of_isLocallyPrincipal
      (𝒮.isLocallyPrincipal_totalTransform_fBar_bBarOn s)]
    intro h
    apply hIH
    rw [eq_bot_iff]
    intro a ha
    have h1 : ((𝒮.fBar s).stalkMap xb).hom a ∈
        (Subscheme.totalTransform (𝒮.fBar s) (𝒮.jBar s)).stalkIdeal xb := by
      rw [stalkIdeal_totalTransform]
      exact Ideal.mem_map_of_mem _ ha
    have h2 := Ideal.le_colon (S := (((Subscheme.totalTransform (𝒮.fBar s) (𝒮.bBarOn s)).stalkIdeal xb ^
      𝒮.b : Ideal _) : Set _)) h1
    rw [h, Submodule.mem_bot] at h2
    exact (Submodule.mem_bot _).mpr (hinj (h2.trans (map_zero _).symm))

/-- **`J̃ = J̄(s)|_{X̃}` has non-zero stalks** (p. 308).

\textbf{Deviation from the paper (gap filled).} The paper (p. 308): "Let us consider a resolution
datum `ℜ^{N-1}_II` on `X̃` (without restriction) of the following form: `(Ẽ_1, …, Ẽ_α̃ | J̃, b |
a_1, …, a_α̃)` where `b` is the positive integer defined above; the integers `a_j ≥ 0` and the coherent
sheaf of ideals `J̃` on `X̃` are such that `J̄(s) = J̃ · ∏ P̃_j^{a_j}` … (For example, we may choose
`a_j = 0` for all `j`.)" and never says that `J̄(s)` is a sheaf of **non-zero** ideals, which
Definition 3 (II) (p. 165) requires of a resolution datum ("`J` is a coherent sheaf of non-zero ideals
on `X`").  Lean proves it for `a_j = 0`, i.e. `J̃ = J̄(s)|_{X̃}`.  (i) `J̄(0) ≠ 0`: if the generators
`g_{jki}^{b/i}` of `J̄` all lay in `(z)Ŝ` then all `g_{jki}` vanish and `Ĵ_j` is generated by a power
of `z`.  In the closed case a power of `z_0` would lie in `J_0` (faithful flatness), hence `z_0 ∈ J_0`
(`W` is reduced), i.e. `W ⊆ F` near `x_0`, contradicting the density of `W − F` in `W` (Definition 5
(I.1)).  In the open case `Ĵ_0` would be `(z)` (class 𝔅: `Ŝ_{(z)}/(z^c)` regular forces `c ≤ 1`, at the
prime `(z)` which lies over a point of `W` without proper generization in `W`), so `W` is simple at
`x_0` and every `V_j` is normally flat along `W` at `x_0` (a thickening of a regular hypersurface; normal
flatness descends along `S → Ŝ`), which contradicts Remark 1 (p. 307), this is where the preparation
`[(1)]`, `[(2)]` is used.  (ii) the stalk maps of `f̄_s` are injective at the points of `Ū_{s+1}`, so
division by the `b`-th power of the exceptional divisor does not make a non-zero stalk zero. -/
@[blueprint "lem:IV.3-jbar-nonzero"
  (statement := /-- Notation as in \cref{def:IV.3-conditions}, \cref{def:IV.3-construction} and
    \cref{rem:IV.3-2}: for an arbitrary open family with removals, the sheaf of ideals
    $\tilde J=\bar J(s)|_{\tilde X}$ on $\tilde X=\bar U_s$ has non-zero stalks. (Needed for
    $\mathfrak R^{N-1}_{\mathrm{II}}$ to be a resolution datum, Definition~3 (II), p.~165.) -/)
  (proof := /-- If $\bar J(0)$ were zero at a point, all the generators $g_{jki}^{b/i}$ would lie in
    $(z)\hat S$, so all $g_{jki}=0$ and every $\hat J_j$ is generated by a power of $z$. Closed case:
    $z_0^a\in J_0$, so $z_0\in J_0$ ($W$ reduced) and $W\subseteq F$ near $x_0$, contradicting
    Definition~5 (I.1). Open case: $\hat J_0=(z)$ (class $\mathfrak B$ and the flatness of
    $S\to\hat S$), so $W$ is simple at $x_0$ and the $V_j$ are normally flat along $W$ at $x_0$,
    contradicting Remark~1 (p.~307). For $s>0$, $\bar J(s+1)=\bar f_s^{-1}(\bar J(s))\cdot P^{-b}$
    and the stalk maps of $\bar f_s$ are injective at the points of $\bar U_{s+1}$.

    \textbf{Deviation from the paper (gap filled).} The paper never says that $\bar J(s)$ is a sheaf
    of non-zero ideals, which a resolution datum of type II requires (Definition~3 (II)). -/)
  (latexEnv := "lemma")]
theorem stalkIdeal_jBarT_ne_bot [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s) (xt : R.xTilde s) :
    (R.jBarT s).stalkIdeal xt ≠ ⊥ := by
  let xt' : (R.uBar s : Scheme.{u}) := xt
  have hxb : (R.uBar s).ι.base xt' ∈ R.uBar s := xt.2
  have hne := R.stalkIdeal_jBar_ne_bot s hprep s _ hxb
  have : IsIso ((R.uBar s).ι.stalkMap xt') := inferInstance
  have hinj : Function.Injective ((R.uBar s).ι.stalkMap xt').hom :=
    ((ConcreteCategory.isIso_iff_bijective _).mp this).1
  show (Subscheme.totalTransform (R.uBar s).ι (𝒮.jBar s)).stalkIdeal xt' ≠ ⊥
  rw [stalkIdeal_totalTransform]
  intro h
  exact hne ((Ideal.map_eq_bot_iff_of_injective hinj).mp h)

end Frame.RemovalFamily

open StrictDim in
/-- `dim V(I) ≤ dim R/I` (the dimension of the closed subscheme `V(I)` of `Spec R`). -/
theorem dim_ofIdealTop_spec_le (R : CommRingCat.{u}) (I : Ideal R) :
    Subscheme.dim (Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso R).inv.hom) : Subscheme (Spec R)) ≤ ringKrullDim (R ⧸ I) := by
  refine StrictDim.dim_le_of_forall _ fun x hx => ?_
  have hle := (mem_pts_ofIdealTop_spec R I x).mp hx
  rw [height_spec_eq_coheight, coheight_eq_ringKrullDim_quotient]
  exact ringKrullDim_le_of_surjective _ (Ideal.Quotient.factor_surjective hle)

/-! ### `X̃` is an ambient scheme of dimension `N - 1` -/

/-- `dim X̄_0 ≤ N - 1`: `X̄_0 = V(z)` and `z` is a non-zero-divisor of the local ring `Ŝ` of
dimension `N`. -/
theorem Frame.dim_xBar_zero_le [IsRegularLocalRing (Shat X x₀)] :
    (𝒮.xBar 0).dim ≤ ((N - 1 : ℕ) : WithBot ℕ∞) := by
  classical
  obtain ⟨hzprime, hz0, hzM⟩ := 𝒮.isPrime_span_z_and_ne_zero_and_mem_maximalIdeal
  have : IsRegularLocalRing (X.presheaf.stalk x₀) := hS.ambient.2.1 x₀
  have : IsDomain (Shat X x₀) := isDomain_of_isRegularLocalRing _
  have hN : ringKrullDim (Shat X x₀) = (N : WithBot ℕ∞) := by
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, AdicCompletion.spanFinrank_maximalIdeal_eq,
      IsRegularLocalRing.spanFinrank_maximalIdeal]
    exact hS.dimAt_x₀
  have hq : ringKrullDim (Shat X x₀ ⧸ Ideal.span {𝒮.z}) + 1 ≤ ringKrullDim (Shat X x₀) :=
    ringKrullDim_quotient_succ_le_of_nonZeroDivisor (mem_nonZeroDivisors_of_ne_zero hz0)
  have hD : (𝒮.xBar 0).dim ≤ ringKrullDim (Shat X x₀ ⧸ Ideal.span {𝒮.z}) :=
    dim_ofIdealTop_spec_le (CommRingCat.of (Shat X x₀)) (Ideal.span {𝒮.z})
  obtain ⟨N', hN'⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hS.lt; omega⟩
  subst hN'
  rw [hN] at hq
  exact hD.trans (le_of_add_one_le_withBot_enat hq)

/-- `dim X̄_s ≤ N - 1`: the strict transform does not raise the dimension. -/
theorem Frame.dim_xBar_le [Hironaka.HironakaCitedResults.{u}] [IsRegularLocalRing (Shat X x₀)] (s : ℕ) :
    (𝒮.xBar s).dim ≤ ((N - 1 : ℕ) : WithBot ℕ∞) := by
  induction s with
  | zero => exact 𝒮.dim_xBar_zero_le
  | succ s ih =>
    have := 𝒮.isAlgebraicScheme_tHat_X' s
    exact ((𝒮.tHat.monoidalTransformation s).dim_strictTransform_le (𝒮.xBar s)).trans ih

/-- At the point `x̂` of `X̂_s` over a point `x` satisfying (1), (2), (3) of Lemma (AB.4) (and, in the
closed case, lying on `F(s)`), a point `x̂_b` of `X̄_s` over `x̂` has dimension `N - 1`:
`O_{X̄_s,x̂_b} = O_{X̂_s,x̂}/(z_s)` with `z_s` a regular parameter of the regular local ring
`O_{X̂_s,x̂}` of dimension `N` (the dimension of `S_s` at `x`, since `S_s → O_{X̂_s,x̂}` transforms a
regular system of parameters into one). -/
theorem Frame.dimAt_xBar_eq_of_cond [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (xb : (𝒮.xBar s).toScheme)
    (hx : Cond N ℜ T x₀ (hS.ambient.2.1 x₀) s ((𝒮.c s).base ((𝒮.xBar s).ι.base xb)))
    (hF : ∀ F, r = .closed F → (𝒮.c s).base ((𝒮.xBar s).ι.base xb) ∈
      ((T.pre s).strictTransform F).pts) :
    (𝒮.xBar s).toScheme.dimAt xb = ((N - 1 : ℕ) : WithBot ℕ∞) := by
  classical
  have := 𝒮.regShat
  have : IsRegularLocalRing ((T.X s).presheaf.stalk ((𝒮.c s).base ((𝒮.xBar s).ι.base xb))) :=
    hS.isNonsingular_X s _
  set xh : 𝒮.tHat.X s := (𝒮.xBar s).ι.base xb with hxh
  obtain ⟨F, z, m, ν, g, co, hr, hz, hX, -⟩ := 𝒮.exists_regularFrame_stalk_of_cond s xh hx hF
  have hreg : IsRegularLocalRing ((𝒮.tHat.X s).presheaf.stalk xh) :=
    Frame.instIsRegularLocalRingStalk 𝒮 s xh
  have hdom : IsDomain ((𝒮.tHat.X s).presheaf.stalk xh) := isDomain_of_isRegularLocalRing _
  have hy : (𝒮.tHat.pre s).composite.base xh = hS.xh :=
    𝒮.composite_tHat_eq_xhat0 (hS.ambient.2.1 x₀) s xh hx.2.1
  obtain ⟨-, hmaps⟩ := 𝒮.isRegularLocalRing_and_mapsRSOP_stalkMap_c s xh hy
  have hdimR : ringKrullDim ((𝒮.tHat.X s).presheaf.stalk xh) = (N : WithBot ℕ∞) := by
    rw [hmaps.ringKrullDim_eq]
    exact hx.1
  have hzmem : z ∈ maximalIdeal ((𝒮.tHat.X s).presheaf.stalk xh) := by
    rw [← hz ⟨0, by rw [hr]; exact Nat.one_pos⟩]
    exact F.extends_rsop.mem_maximalIdeal (Finset.mem_image_of_mem _ (Finset.mem_univ _))
  have hz0 : z ≠ 0 := by
    rw [← hz ⟨0, by rw [hr]; exact Nat.one_pos⟩]
    exact F.extends_rsop.ne_zero (Finset.mem_image_of_mem _ (Finset.mem_univ _))
  have hq := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero hz0) hzmem
  rw [hdimR] at hq
  obtain ⟨N', hN'⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by have := hS.lt; omega⟩
  subst hN'
  have hq' := eq_of_add_one_eq_withBot_enat hq
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv (𝒮.xBar s) xb
  show ringKrullDim ((𝒮.xBar s).toScheme.presheaf.stalk xb) = _
  rw [← ringKrullDim_eq_of_ringEquiv e]
  have e2 : ((𝒮.tHat.X s).presheaf.stalk xh ⧸ (𝒮.xBar s).stalkIdeal xh) ≃+*
      ((𝒮.tHat.X s).presheaf.stalk xh ⧸ Ideal.span {z}) := Ideal.quotEquivOfEq hX
  rw [ringKrullDim_eq_of_ringEquiv e2, hq']
  simp

namespace Frame.RemovalFamily

variable {𝒮} (R : 𝒮.RemovalFamily)

/-- The local ring of `X̃ = Ū_s` at a point is that of `X̄_s` at its image. -/
theorem dimAt_xTilde (s : ℕ) (xt : R.xTilde s) :
    (R.xTilde s).dimAt xt = (𝒮.xBar s).toScheme.dimAt ((R.uBar s).ι.base xt) := by
  let xt' : (R.uBar s : Scheme.{u}) := xt
  have : IsIso ((R.uBar s).ι.stalkMap xt') := inferInstance
  exact (ringKrullDim_eq_of_ringEquiv
    (asIso ((R.uBar s).ι.stalkMap xt')).commRingCatIsoToRingEquiv).symm

/-- `dim X̃ ≤ N - 1`. -/
theorem dim_xTilde_le [Hironaka.HironakaCitedResults.{u}] (s : ℕ) : (R.xTilde s).dim ≤ ((N - 1 : ℕ) : WithBot ℕ∞) := by
  have := 𝒮.regShat
  refine iSup_le fun xt => ?_
  rw [R.dimAt_xTilde s xt]
  exact (le_iSup (fun x => (𝒮.xBar s).toScheme.dimAt x) _).trans (𝒮.dim_xBar_le s)

/-- `dim X̃ = N - 1` as soon as `X̃` has a point at which it has dimension `N - 1`
(the hypothesis `hdim` of Remarks 3-5). -/
theorem dim_xTilde_eq [Hironaka.HironakaCitedResults.{u}] (s : ℕ)
    (h : ∃ xt : R.xTilde s, (R.xTilde s).dimAt xt = ((N - 1 : ℕ) : WithBot ℕ∞)) :
    (R.xTilde s).dim = ((N - 1 : ℕ) : WithBot ℕ∞) := by
  obtain ⟨xt, hxt⟩ := h
  exact le_antisymm (R.dim_xTilde_le s) (hxt ▸ le_iSup (fun x => (R.xTilde s).dimAt x) xt)

/-- If a point `x̂_b ∈ Ū_s` of `X̄_s` lies over a point `x` of `X_s` with the properties (1), (2), (3) of
Lemma (AB.4) (and on `F(s)` in the closed case), then `X̃` has dimension `N - 1` at it. -/
theorem exists_dimAt_xTilde_eq_of_cond [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (xb : (𝒮.xBar s).toScheme) (hxb : xb ∈ R.uBar s)
    (hx : Cond N ℜ T x₀ (hS.ambient.2.1 x₀) s ((𝒮.c s).base ((𝒮.xBar s).ι.base xb)))
    (hF : ∀ F, r = .closed F → (𝒮.c s).base ((𝒮.xBar s).ι.base xb) ∈
      ((T.pre s).strictTransform F).pts) :
    ∃ xt : R.xTilde s, (R.xTilde s).dimAt xt = ((N - 1 : ℕ) : WithBot ℕ∞) :=
  ⟨⟨xb, hxb⟩, by
    rw [R.dimAt_xTilde s ⟨xb, hxb⟩]
    exact 𝒮.dimAt_xBar_eq_of_cond s xb hx hF⟩

/-- **`X̃` is an ambient scheme of dimension `N - 1`** (p. 308), as soon as it has a point at which it
has dimension `N - 1`.

\textbf{Deviation from the paper (gap filled / statement modified).} The paper (p. 308): "We shall be
only interested in the case in which `X̃` has dimension `N - 1`.  This is the case, if there exists at
least one point `x` of `S(ℜ(s))` having the properties (1), (2) and (3) of Lemma (AB.4)."  It then
applies Theorem `II₂^{N-1}` to a datum on `X̃`, which needs `X̃` to be a non-singular irreducible
algebraic scheme of dimension `N - 1`: none of this is said.  Lean proves: `X̃` is algebraic (open in a
closed subscheme of the algebraic `X̂_s`), non-singular (Lemma `lem:IV.3-construction-facts-generic`),
irreducible when non-empty (that lemma), and of dimension `≤ N - 1` (`dim X̄_0 ≤ N - 1` and strict
transforms do not raise the dimension).  The dimension is `N - 1` exactly when `X̃` has a point of
dimension `N - 1`, the proviso of the paper (this holds when a point `x` satisfies (1), (2), (3),
`Frame.RemovalFamily.exists_dimAt_xTilde_eq_of_cond`).  Lean does not claim the statement for every
non-empty `X̃`: nothing in the construction prevents `X̃` from being non-empty of smaller dimension
(at a step of type [h] the points of `X̂_s` over the removed centre are deleted), and the paper itself
restricts to the case `dim X̃ = N - 1`. -/
@[blueprint "lem:IV.3-xtilde-ambient"
  (statement := /-- Notation as in \cref{rem:IV.3-2}. If $\tilde X=\bar U_s$ has a point at which it
    has dimension $N-1$ (e.g.\ if some point of $S(\mathfrak R(s))$ has the properties (1), (2), (3)
    of Lemma (AB.4), \cref{lem:IV.AB-4-componentwise}), then $\tilde X$ is a non-singular
    irreducible algebraic scheme of dimension $N-1$. (p.~308: ``We shall be only interested in the
    case in which $\tilde X$ has dimension $N-1$.'') -/)
  (proof := /-- $\tilde X$ is open in the closed subscheme $\bar X_s$ of the algebraic scheme
    $\hat X_s$; it is non-singular and irreducible by \cref{lem:IV.3-construction-facts-generic}.
    $\dim\bar X_0\le N-1$ as $\bar X_0=V(z)$, $z$ a non-zero-divisor of the local ring $\hat S$ of
    dimension $N$, and strict transforms do not raise the dimension (Remark~1, p.~169); hence
    $\dim\tilde X\le N-1$, with equality by the hypothesis.

    \textbf{Deviation from the paper (gap filled).} The paper does not say that $\tilde X$ is an
    ambient scheme. -/)
  (latexEnv := "lemma")]
theorem isAmbient_xTilde [Hironaka.HironakaCitedResults.{u}] (s : ℕ)
    (h : ∃ xt : R.xTilde s, (R.xTilde s).dimAt xt = ((N - 1 : ℕ) : WithBot ℕ∞)) :
    IsAmbient (R.xTilde s) (N - 1) := by
  obtain ⟨xt, hxt⟩ := h
  have := 𝒮.regShat
  have hfacts := R.isSimpleAt_and_isIrreducible_and_isNonsingCodimOneOn s
  refine ⟨?_, ?_, ?_, ?_⟩
  · have := 𝒮.isAlgebraicScheme_tHat_X' s
    have := isAlgebraicScheme_toScheme (𝒮.xBar s)
    show IsAlgebraicScheme (R.uBar s : Scheme.{u})
    exact isAlgebraicScheme_of_isOpenImmersion (V := (R.uBar s : Scheme.{u})) (R.uBar s).ι
  · intro xt
    let xt' : (R.uBar s : Scheme.{u}) := xt
    have h' := hfacts.1 ((R.uBar s).ι.base xt') xt'.2
    have h'' : IsRegularLocalRing ((𝒮.xBar s).toScheme.presheaf.stalk ((R.uBar s).ι.base xt')) :=
      h'
    have : IsIso ((R.uBar s).ι.stalkMap xt') := inferInstance
    exact IsRegularLocalRing.of_ringEquiv (asIso ((R.uBar s).ι.stalkMap xt')).commRingCatIsoToRingEquiv
  · exact Subtype.irreducibleSpace (hfacts.2.1 ⟨(R.uBar s).ι.base xt, xt.2⟩)
  · exact R.dim_xTilde_eq s ⟨xt, hxt⟩

end Frame.RemovalFamily

/-! ## Repair of the paper's error on the subschemes `Ẽ_j`, AB side (pp. 308-310): the traces `Ẽ_j`

The paper (p. 308): "In both cases, we see that `Ẽ_1, ⋯, Ẽ_α̃` are non-singular irreducible
subschemes of `X̄'_s` of codimension 1, and that `Ẽ_1 ∪ ⋯ ∪ Ẽ_α̃` has only normal crossings on
`X̄'_s`", and (p. 310) "Thus, applying Theorem `II₂^{N-1}` to the resolution datum `ℜ^{N-1}_II` on
`X̃` (without restriction)". Both are false as printed: the `Ẽ_j`
can be reducible, and `Ẽ_i = X̃` if `F = E_i`. The repair: a trace is the whole space of `X̄_s` or
non-singular and everywhere of codimension one, the traces other than the whole space have only
normal crossings, and Theorem `II₂^{N-1}` is applied to the weak datum obtained by emptying the
whole-space traces (`DatumII.Raw.resolvable_of_isWeakDatum`, `Compat/DatumRefinement.lean`). All the
declarations below are "proof corrected (repair of the paper's error on the subschemes `Ẽ_j`)". -/

end AB

section OpenPullback

variable {Y : Scheme.{u}} (U : Y.Opens)

/-- Along an open immersion, the total transform commutes with finite intersections of ideal
sheaves. -/
theorem Subscheme.totalTransform_opens_ι_iInf {ι : Type*} [Fintype ι] (E : ι → Subscheme Y) :
    Subscheme.totalTransform U.ι (⨅ i, E i) = ⨅ i, Subscheme.totalTransform U.ι (E i) := by
  refine Subscheme.ext_stalkIdeal fun z => ?_
  rw [DatumTransform.stalkIdeal_iInf_fintype, FlatPreimm.stalkIdeal_totalTransform,
    DatumTransform.stalkIdeal_iInf_fintype]
  have h1 : ∀ i, (Subscheme.totalTransform U.ι (E i)).stalkIdeal z =
      ((E i).stalkIdeal (U.ι z)).map (FlatPreimm.stalkEquiv U.ι z) := fun i =>
    FlatPreimm.stalkIdeal_totalTransform U.ι (E i) z
  simp only [h1]
  rw [← Ideal.map_coe (FlatPreimm.stalkEquiv U.ι z)]
  simp only [← Ideal.map_coe (FlatPreimm.stalkEquiv U.ι z), Ideal.map_comap_of_equiv,
    Ideal.comap_iInf]

end OpenPullback

namespace AB

section Traces

variable {Y : Scheme.{u}} (U : Y.Opens)

/-- A subscheme which is non-singular and everywhere of codimension one on the open set `U`
restricts to a non-singular divisor of the open subscheme `U`. -/
theorem isNonsingularDivisor_totalTransform_opens_ι {D : Subscheme Y}
    (hD : IsNonsingCodimOneOn D (U : Set Y)) :
    (Subscheme.totalTransform U.ι D).IsNonsingularDivisor := by
  refine ⟨Subscheme.isNonsingular_of_stalk_quot _ fun z hz => ?_, fun z hz => ?_⟩
  · have hzD : U.ι z ∈ D.pts := by rwa [FlatPreimm.pts_totalTransform] at hz
    have hsimple : D.IsSimpleAt (U.ι z) := hD.1 _ ⟨hzD, z.2⟩
    exact ((FlatPreimm.isSimpleAt_totalTransform_iff U.ι D z).mpr hsimple).2
  · have hzD : U.ι z ∈ D.pts := by rwa [FlatPreimm.pts_totalTransform] at hz
    rw [FlatPreimm.codimAt_totalTransform]
    exact hD.2 _ ⟨hzD, z.2⟩

open Classical in
/-- The bookkeeping for the traces on an open subscheme `U` of `Y`: given subschemes `tr i` of `Y`,
a predicate `κ` ("kept") outside which `tr i` is the whole space, with the kept `tr i` non-singular
and everywhere of codimension one on `U` and having only normal crossings together on `U`, the
pull-backs `tr i ∩ U` are the whole space or non-singular divisors of `U`, and the union of those
pull-backs which are not the whole space has only normal crossings. -/
theorem eq_bot_or_isNonsingularDivisor_and_hasOnlyNormalCrossings_totalTransform_opens_ι
    {ι : Type*} [Fintype ι] (tr : ι → Subscheme Y) (κ : ι → Prop)
    (h1 : ∀ i, ¬ κ i → tr i = ⊥) (h2 : ∀ i, κ i → IsNonsingCodimOneOn (tr i) (U : Set Y))
    (h3 : ∀ y ∈ U, (⨅ i : {i // κ i}, tr i.1).HasOnlyNormalCrossingsAt y) :
    (∀ i, Subscheme.totalTransform U.ι (tr i) = ⊥ ∨
      (Subscheme.totalTransform U.ι (tr i)).IsNonsingularDivisor) ∧
    (⨅ i, (Subscheme.totalTransform U.ι (tr i)).emptyIfBot).HasOnlyNormalCrossings := by
  have hbot : Subscheme.totalTransform U.ι (⊥ : Subscheme Y) = ⊥ :=
    Scheme.IdealSheafData.comap_bot _
  refine ⟨fun i => ?_, fun z => ?_⟩
  · by_cases hκ : κ i
    · exact Or.inr (isNonsingularDivisor_totalTransform_opens_ι U (h2 i hκ))
    · left
      rw [h1 i hκ, hbot]
  · -- the kept pull-backs are not the whole space
    have hne : ∀ i, κ i → (Subscheme.totalTransform U.ι (tr i)).stalkIdeal z ≠ ⊥ := by
      intro i hκ hz
      rw [FlatPreimm.stalkIdeal_totalTransform] at hz
      have h0 : (tr i).stalkIdeal (U.ι z) = ⊥ :=
        (Ideal.map_eq_bot_iff_of_injective (FlatPreimm.stalkEquiv U.ι z).injective).mp hz
      have hy : U.ι z ∈ (tr i).pts :=
        Subscheme.mem_pts_iff_stalkIdeal_ne_top.mpr (by rw [h0]; exact bot_ne_top)
      have := (h2 i hκ).2 _ ⟨hy, z.2⟩
      rw [Subscheme.codimAt, h0, Ideal.height_bot] at this
      exact zero_ne_one this
    have hE_ne : ∀ i, κ i → Subscheme.totalTransform U.ι (tr i) ≠ ⊥ := fun i hκ h =>
      hne i hκ (by rw [h]; exact Subscheme.stalkIdeal_bot_eq z)
    have hEq : (⨅ i, (Subscheme.totalTransform U.ι (tr i)).emptyIfBot) =
        Subscheme.totalTransform U.ι (⨅ i : {i // κ i}, tr i.1) := by
      rw [Subscheme.totalTransform_opens_ι_iInf]
      apply le_antisymm
      · refine le_iInf fun i => ?_
        refine (iInf_le _ i.1).trans ?_
        rw [Subscheme.emptyIfBot_of_ne_bot (hE_ne i.1 i.2)]
      · refine le_iInf fun i => ?_
        by_cases hκ : κ i
        · rw [Subscheme.emptyIfBot_of_ne_bot (hE_ne i hκ)]
          exact iInf_le (fun j : {i // κ i} => Subscheme.totalTransform U.ι (tr j.1)) ⟨i, hκ⟩
        · rw [h1 i hκ, hbot, Subscheme.emptyIfBot_bot]
          exact le_top
    rw [hEq]
    unfold Subscheme.HasOnlyNormalCrossingsAt
    rw [← hbot]
    exact (FlatPreimm.hasOnlyNormalCrossingsWithAt_totalTransform_iff U.ι _ ⊥ z).mpr
      (h3 _ z.2)

end Traces

/-! ### Reducedness of `X̄_s`, and the traces equal to the whole space -/

/-- The stalk of the radical of an ideal sheaf lies in the radical of the stalk. -/
theorem _root_.Hironaka.Subscheme.stalkIdeal_radical_le_radical_stalkIdeal {Y : Scheme.{u}}
    (D : Subscheme Y) (y : Y) :
    Subscheme.stalkIdeal (Scheme.IdealSheafData.radical D) y ≤ (D.stalkIdeal y).radical := by
  obtain ⟨W, hW⟩ := Subscheme.exists_affineOpen_mem y
  rw [Subscheme.stalkIdeal_eq_map_germ_affine _ W hW,
    Subscheme.stalkIdeal_eq_map_germ_affine _ W hW]
  exact Ideal.map_radical_le _

/-- The strict transform of a reduced subscheme `V` of a non-singular scheme is reduced: the ideal
sheaf of the strict transform is the largest one agreeing with `f⁻¹(V)` off the exceptional
divisor, where `f` is a local isomorphism and `f⁻¹(V)` is reduced; hence it equals its radical.

Deviation from the paper (gap filled): the paper (p. 316) says only "we see" (this is the argument
of `Hironaka.MonoidalTransformation.isReduced_strictTransform` of the Chapter-IV file, which cannot
be imported here). -/
theorem _root_.Hironaka.MonoidalTransformation.isReduced_strictTransform_of_isNonsingular
    {X : Scheme.{u}} {B : Subscheme X}
    (hX : X.IsNonsingular) (t : MonoidalTransformation X B) (V : Subscheme X)
    (hV : V.IsReduced) : (Subscheme.strictTransform t V).IsReduced := by
  set D := Subscheme.strictTransform t V with hD
  have hle : D ≤ Scheme.IdealSheafData.radical D := by
    intro U
    exact Ideal.le_radical
  have hmem : Scheme.IdealSheafData.radical D ∈
      {V' : Subscheme t.X' | ∀ x' : t.X', x' ∉ t.exceptional.pts →
        V'.stalkIdeal x' = (Subscheme.totalTransform t.f V).stalkIdeal x'} := by
    intro x' hx'
    have hfx : t.f.base x' ∉ B.pts := fun h => hx' (by rw [t.pts_exceptional]; exact h)
    have : IsRegularLocalRing (X.presheaf.stalk (t.f.base x')) := hX _
    have hbij := _root_.Hironaka.MonoidalTransformation.bijective_stalkMap_of_notMem t x' hfx
    have hDx : D.stalkIdeal x' = (Subscheme.totalTransform t.f V).stalkIdeal x' :=
      _root_.Hironaka.MonoidalTransformation.strictTransform_stalkIdeal_of_notMem t V hx'
    have hrad : ((Subscheme.totalTransform t.f V).stalkIdeal x').IsRadical := by
      rw [stalkIdeal_totalTransform]
      have h1 := Subscheme.isRadical_stalkIdeal_of_isReduced hV (t.f.base x')
      have hsurj : Function.Surjective (t.f.stalkMap x').hom := hbij.2
      have hker : RingHom.ker (t.f.stalkMap x').hom ≤ V.stalkIdeal (t.f.base x') := by
        rw [(RingHom.injective_iff_ker_eq_bot _).mp hbij.1]; exact bot_le
      have h2 := Ideal.map_radical_of_surjective hsurj hker
      rw [h1.radical] at h2
      exact Ideal.radical_eq_iff.mp h2.symm
    apply le_antisymm
    · calc Subscheme.stalkIdeal (Scheme.IdealSheafData.radical D) x' ≤ (D.stalkIdeal x').radical :=
            Subscheme.stalkIdeal_radical_le_radical_stalkIdeal D x'
        _ = D.stalkIdeal x' := by rw [hDx]; exact hrad.radical
        _ = _ := hDx
    · rw [← hDx]
      exact Subscheme.stalkIdeal_mono hle x'
  have h2 : Scheme.IdealSheafData.radical D ≤ D := le_sSup hmem
  exact Subscheme.isReduced_of_radical_eq D (le_antisymm h2 hle)

section FrameRepair

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X} {T : Tower X} {x₀ : X} {hS : Standing N n ℜ P r T x₀}

/-- `b > 0`: the integer `b` of [d] is a product of factorials.

The paper calls `b` "the positive integer defined above" in the datum `ℜ^{N-1}_II` (p. 308); this
is the proof of that positivity, which a resolution datum (and the weak datum of the repair) needs.
-/
@[blueprint "lem:IV.3-b-pos"
  (statement := /-- In the situation of \cref{def:IV.3-frame}, the integer $b$ is positive. -/)
  (proof := /-- $b=\prod_{j,k}\nu_{jk}!$ is a product of factorials, by [d] of the frame. -/)
  (latexEnv := "lemma")]
theorem Frame.b_pos (𝒮 : Frame hS) : 0 < 𝒮.b := by
  obtain ⟨Fr, h1, hz, -, -, m, g, v, ν, co, -, -, -, -, hbprod, -⟩ := 𝒮.frame
  rw [hbprod]
  exact Finset.prod_pos fun j _ => Finset.prod_pos fun k _ => Nat.factorial_pos _

namespace Frame

variable (𝒮 : Frame hS)

/-- `X̄_s` is a reduced subscheme: `X̄_0` is non-singular, hence reduced, and the strict transform
of a reduced subscheme of a non-singular scheme is reduced
(`MonoidalTransformation.isReduced_strictTransform_of_isNonsingular`).

Deviation from the paper (gap filled): the AB part of the paper does not say that `X̄_s` is reduced;
it is asserted (with "we see") on p. 316 for the construction of §4, and used here for the
dichotomy of the traces `Ẽ_j` (`Frame.totalTransform_ι_eHat_eq_bot_iff`). -/
@[blueprint "lem:IV.3-frame-reduced"
  (statement := /-- In the situation of \cref{def:IV.3-frame}, $\bar X_s$ is a reduced subscheme of
    $\hat X_s$ for every $s\ge0$. -/)
  (proof := /-- $\bar X_0=V(z)$ is non-singular (\cref{lem:IV.3-construction-facts-generic}), hence
    reduced. The strict transform of a reduced subscheme of the non-singular scheme $\hat X_s$ by a
    monoidal transformation is reduced: its ideal sheaf is the largest agreeing with the total
    transform off the exceptional divisor, where the monoidal transformation is a local isomorphism
    and the total transform is reduced; so it equals its radical.

    \textbf{Deviation from the paper (gap filled).} The AB part of the paper does not say that
    $\bar X_s$ is reduced (the same is asserted with ``we see'' on p.~316). -/)
  (latexEnv := "lemma")]
theorem isReduced_xBar [Hironaka.HironakaCitedResults.{u}] (s : ℕ) : (𝒮.xBar s).IsReduced := by
  induction s with
  | zero =>
    exact DatumTransform.isReduced_of_isNonsingular
      𝒮.xBar_zero_isNonsingular_and_isIrreducible.1
  | succ s ih =>
    exact MonoidalTransformation.isReduced_strictTransform_of_isNonsingular
      (𝒮.isNonsingular_tHat_X s) (𝒮.tHat.monoidalTransformation s) (𝒮.xBar s) ih

/-- The trace `Ẽ_j = Ê_j(s) ∩ X̄_s` of a boundary divisor is the whole space `X̄_s` exactly when
`Ê_j(s)` contains `X̄_s` (this happens in the case `F = E_i` of Definition 5 (I.1), p. 166, in which
the trace of the printed Remark 2 is not of codimension one).  Not in the paper: it is the dichotomy
on which the repair of the paper's error on the subschemes `Ẽ_j` rests. -/
theorem totalTransform_ι_eHat_eq_bot_iff [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (j : Fin (P.α + s)) :
    Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s j) = ⊥ ↔
      (𝒮.xBar s).pts ⊆ (𝒮.eHat s j).pts := by
  constructor
  · intro h y hy
    obtain ⟨y', rfl⟩ := Subscheme.exists_ι_eq_of_mem_pts _ hy
    have hy' : y' ∈ (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s j)).pts := by
      rw [h]; exact Subscheme.mem_pts_bot y'
    rwa [Subscheme.pts_totalTransform_eq_preimage] at hy'
  · intro h
    refine Subscheme.ext_stalkIdeal fun y => ?_
    rw [stalkIdeal_totalTransform, Subscheme.stalkIdeal_bot_eq, Ideal.map_eq_bot_iff_le_ker,
      ← stalkIdeal_eq_ker_stalkMap]
    exact DatumTransform.stalkIdeal_le_of_pts_subset (𝒮.isReduced_xBar s) h _

namespace RemovalFamily

variable {𝒮} (R : 𝒮.RemovalFamily)

open Classical in
/-- **Remark 2, repaired (p. 308), points of `Ū_s`: the traces which are not all of `X̄_s`.**  Let
`κ` be a set of boundary divisors `Ê_i(s)` none of which contains `X̄_s`.  At a point of `Ū_s`, the
traces `Ẽ_i = Ê_i(s) ∩ X̄_s`, `i ∈ κ`, have only normal crossings on `X̄_s`, and each is simple of
codimension one at its points.  No hypothesis `hFE`: the transversality of `Ê_i(s)` and `X̄_s` is
the assumption on `κ` together with the irreducibility of `X̄_s`.

Deviation from the paper (proof corrected, repair of the paper's error on the subschemes `Ẽ_j`): the paper (p. 308)
"In both cases, we see that `Ẽ_1, ⋯, Ẽ_α̃` are non-singular irreducible subschemes of `X̄'_s` of
codimension 1, and that `Ẽ_1 ∪ ⋯ ∪ Ẽ_α̃` has only normal crossings on `X̄'_s`" is false when
`Ẽ_i = X̄'_s` (`F = E_i`); the statement is made for the traces which are not the whole space. -/
@[blueprint "lem:IV.3-rem2-traces-kept"
  (statement := /-- In the situation of \cref{lem:IV.3-rem2-traces}, let $\kappa$ be a set of
    boundary divisors $\hat E_j(s)$ none of which contains $\bar X_s$. At a point $\bar x$ of $\bar
    U_s$, the traces $\tilde E_j=\hat E_j(s)\cap\bar X_s$, $j\in\kappa$, have only normal crossings
    on $\bar X_s$, and each $\tilde E_j$ through $\bar x$ is non-singular and of codimension $1$ in
    $\bar X_s$ at $\bar x$. No hypothesis on the restriction $F$. -/)
  (proof := /-- As \cref{lem:IV.3-rem2-traces}, but the transversality of $\bar X_s$ and $\hat
    E_j(s)$, $j\in\kappa$, is the irreducibility of $\bar X_s$ together with $\bar
    X_s\not\subseteq\hat E_j(s)$ instead of $\bar X_s\not\subseteq E_s$; the normal crossings of the
    whole boundary with $\bar X_s$ restrict to the subfamily $\kappa$.

    \textbf{Deviation from the paper (proof corrected; repair of the paper's error on the subschemes $\tilde E_j$).}
    ``In both cases, we see that $\tilde E_1,\dots,\tilde E_{\tilde\alpha}$ are non-singular
    irreducible subschemes of $\bar X_s'$ of codimension 1, and that
    $\tilde E_1\cup\dots\cup\tilde E_{\tilde\alpha}$ has only normal crossings on $\bar X_s'$''
    (p.~308) is false when $\tilde E_i=\bar X_s'$ ($F=E_i$). -/)
  (proofUses := ["lem:IV.3-rem2-traces", "lem:IV.3-rem2-model-boundary"])
  (latexEnv := "lemma")]
theorem hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry_of_forall_not_subset [Hironaka.HironakaCitedResults.{u}] (s : ℕ)
    (xb : (𝒮.xBar s).toScheme) (hxb : xb ∈ R.uBar s)
    (κ : Fin (bdryCard r P.α s) → Prop)
    (hκ : ∀ i, κ i → ¬ (𝒮.xBar s).pts ⊆ (𝒮.eHat s (bdryIdx r P.α s i)).pts) :
    (⨅ i : {i : Fin (bdryCard r P.α s) // κ i},
      Subscheme.totalTransform (𝒮.xBar s).ι
        (𝒮.eHat s (bdryIdx r P.α s i.1))).HasOnlyNormalCrossingsAt xb ∧
    ∀ i : Fin (bdryCard r P.α s), κ i →
      xb ∈ (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).pts →
      (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).IsSimpleAt xb ∧
      (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i))).codimAt xb = 1 := by
  have hx : (𝒮.xBar s).ι xb ∈ (𝒮.xBar s).pts := Subscheme.mem_pts_ι _ xb
  have hne : (𝒮.xBar s).pts.Nonempty := ⟨_, hx⟩
  have hirr : _root_.IsIrreducible (𝒮.xBar s).pts :=
    Subscheme.isIrreducible_pts _ (Frame.RemovalFamily.isIrreducible_xBar_of_isIrreducible_zero
      (𝒮 := 𝒮) (fun _ => 𝒮.xBar_zero_isNonsingular_and_isIrreducible.2) s hne)
  have : IsRegularLocalRing ((𝒮.tHat.X s).presheaf.stalk ((𝒮.xBar s).ι xb)) :=
    𝒮.isNonsingular_tHat_X s _
  have hE : (⨅ i : Fin (bdryCard r P.α s), 𝒮.eHat s (bdryIdx r P.α s i)).IsReduced :=
    Subscheme.isReduced_iInf_of_isNonsingular _ fun i => 𝒮.isNonsingular_eHat s _
  have hNC := R.hasOnlyNormalCrossingsWithAt_iInf_eHat_bdry s hxb hx
  have hsimple : ∀ i, (𝒮.xBar s).ι xb ∈ (𝒮.eHat s (bdryIdx r P.α s i)).pts →
      (𝒮.eHat s (bdryIdx r P.α s i)).IsSimpleAt ((𝒮.xBar s).ι xb) ∧
        (𝒮.eHat s (bdryIdx r P.α s i)).codimAt ((𝒮.xBar s).ι xb) = 1 := fun i hi =>
    𝒮.isSimpleAt_and_codimAt_eq_one_totalTransform_c s (hS.isNonsingular_esys s _)
      (hS.exists_stalkIdeal_esys s _) _ hi
  let Eb : Fin (bdryCard r P.α s) → Subscheme (𝒮.tHat.X s) :=
    fun i => 𝒮.eHat s (bdryIdx r P.α s i)
  let K := {i : Fin (bdryCard r P.α s) // κ i}
  have hEK : (⨅ i : K, Eb i.1).IsReduced :=
    Subscheme.isReduced_iInf_of_forall_isReduced _ fun i =>
      DatumTransform.isReduced_of_isNonsingular (𝒮.isNonsingular_eHat s _)
  have hNCK : (⨅ i : K, Eb i.1).HasOnlyNormalCrossingsWithAt (𝒮.xBar s)
      ((𝒮.xBar s).ι xb) :=
    Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_iInf_comp (σ := fun i : K => i.1) (E := Eb)
      hE hNC hsimple
  have hsimpleK : ∀ i : K, (𝒮.xBar s).ι xb ∈ (Eb i.1).pts →
      (Eb i.1).IsSimpleAt ((𝒮.xBar s).ι xb) ∧ (Eb i.1).codimAt ((𝒮.xBar s).ι xb) = 1 :=
    fun i hi => hsimple i.1 hi
  have hTK : ∀ i : K, (𝒮.xBar s).ι xb ∈ (Eb i.1).pts →
      ¬ (Eb i.1).stalkIdeal ((𝒮.xBar s).ι xb) ≤ (𝒮.xBar s).stalkIdeal ((𝒮.xBar s).ι xb) :=
    fun i hi => Subscheme.not_stalkIdeal_le_of_isIrreducible_not_subset hirr (hκ i.1 i.2) le_rfl hx
  exact ⟨Hironaka.Subscheme.hasOnlyNormalCrossingsAt_iInf_totalTransform_ι hEK xb hNCK hsimpleK hTK,
    fun i hi hxi => Hironaka.Subscheme.isSimpleAt_and_codimAt_eq_one_totalTransform_ι hEK xb hNCK
      hsimpleK hTK ⟨i, hi⟩ hxi⟩

open Classical in
/-- **Remark 2, repaired (p. 308), boundary-index form.**  Each trace `Ẽ_i = Ê_i(s) ∩ X̄_s` of a
boundary divisor is the whole space `X̄_s` (when `Ê_i(s) ⊇ X̄_s`) or non-singular and everywhere of
codimension one on `Ū_s`, and the traces other than the whole space have only normal crossings on
`Ū_s`. -/
theorem eq_bot_or_isNonsingCodimOneOn_and_hasOnlyNormalCrossings_bdry [Hironaka.HironakaCitedResults.{u}] (s : ℕ) :
    (∀ i : Fin (bdryCard r P.α s),
      Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i)) = ⊥ ∨
      IsNonsingCodimOneOn
        (Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i)))
        (R.uBar s : Set (𝒮.xBar s).toScheme)) ∧
    ∀ xb ∈ R.uBar s, (⨅ i : {i : Fin (bdryCard r P.α s) //
        Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i)) ≠ ⊥},
      Subscheme.totalTransform (𝒮.xBar s).ι
        (𝒮.eHat s (bdryIdx r P.α s i.1))).HasOnlyNormalCrossingsAt xb := by
  have hκ : ∀ i : Fin (bdryCard r P.α s),
      Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i)) ≠ ⊥ →
      ¬ (𝒮.xBar s).pts ⊆ (𝒮.eHat s (bdryIdx r P.α s i)).pts := fun i hi h =>
    hi ((𝒮.totalTransform_ι_eHat_eq_bot_iff s _).mpr h)
  refine ⟨fun i => ?_, fun xb hxb => ?_⟩
  · by_cases hi : Subscheme.totalTransform (𝒮.xBar s).ι (𝒮.eHat s (bdryIdx r P.α s i)) = ⊥
    · exact Or.inl hi
    · refine Or.inr ⟨fun x hx => ?_, fun x hx => ?_⟩
      · exact (R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry_of_forall_not_subset s x
          hx.2 _ hκ).2 i hi hx.1 |>.1
      · exact (R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry_of_forall_not_subset s x
          hx.2 _ hκ).2 i hi hx.1 |>.2
  · exact (R.hasOnlyNormalCrossingsAt_and_isSimpleAt_iInf_eHat_bdry_of_forall_not_subset s xb hxb _
      hκ).1

open Classical in
/-- **Remark 2, repaired** (p. 308) for an arbitrary open family with removals `U_s`. The traces
`Ẽ_j` of the frame (`Frame.eTilde`) are the whole space `X̄_s` or non-singular and everywhere of
codimension one on `Ū_s`, and the traces which are not the whole space have only normal crossings on
`Ū_s`. There is no hypothesis on the restriction `F` (compare
`hasOnlyNormalCrossings_etilde_of_prepHyp`, which assumes `hFE`).

\textbf{Deviation from the paper (proof corrected, repair of the paper's error on the subschemes $\tilde E_j$).} The paper (p.
308): "In both cases, we see that `Ẽ_1, ⋯, Ẽ_α̃` are non-singular irreducible subschemes of `X̄'_s`
of codimension 1, and that `Ẽ_1 ∪ ⋯ ∪ Ẽ_α̃` has only normal crossings on `X̄'_s`." This is false as
printed: the `Ẽ_j` need not be irreducible, and `Ẽ_i` is the whole
of `X̄'_s` if `F = E_i` (counterexamples in the docstring and blueprint text of `rem:IV.3-2`). Repaired: a trace is the whole space (exactly
when `Ê_j(s) ⊇ X̄_s`, `Frame.totalTransform_ι_eHat_eq_bot_iff`) or, `X̄_s` being irreducible and not
contained in `Ê_j(s)`, transversal to it, hence non-singular of codimension one; the traces other
than the whole space have only normal crossings. -/
@[blueprint "rem:IV.3-2-repaired"
  (statement := /-- Notation as in \cref{rem:IV.3-2-generic}, for an arbitrary open family with
    removals $U_s\subseteq\hat X_s$, with $\bar U_s=U_s\cap\bar X_s$. Every trace $\tilde E_j$ is
    either the whole space $\bar X_s$ (this happens exactly when $\hat E_j'(s)\supseteq\bar X_s$,
    for instance if $F=E_i$ in the closed case) or non-singular and everywhere of codimension $1$ on
    $\bar U_s$; and the union of those $\tilde E_j$ which are not the whole space has only normal
    crossings on $\bar U_s$. No hypothesis on the restriction $F$. (The irreducibility of the
    $\tilde E_j$ is not asserted; it is false in general.) -/)
  (proof := /-- Since $\bar X_s$ is reduced and irreducible, a component $\hat E_j'(s)$ either
    contains $\bar X_s$, so that $\tilde E_j$ is the whole space (\cref{lem:IV.3-frame-reduced}), or
    does not, and then it is transversal to $\bar X_s$ and \cref{lem:IV.3-rem2-traces-kept} applies
    to the set of the $j$ with $\tilde E_j$ not the whole space.

    \textbf{Deviation from the paper (proof corrected; repair of the paper's error on the subschemes $\tilde E_j$).} The paper
    (p.~308): ``In both cases, we see that $\tilde E_1,\dots,\tilde E_{\tilde\alpha}$ are
    non-singular irreducible subschemes of $\bar X_s'$ of codimension 1, and that
    $\tilde E_1\cup\dots\cup\tilde E_{\tilde\alpha}$ has only normal crossings on $\bar X_s'$.''
    This is false as printed (the irreducibility; and
    $\tilde E_i=\bar X_s'$ if $F=E_i$). -/)
  (proofUses := ["lem:IV.3-rem2-traces-kept", "lem:IV.3-frame-reduced", "rem:IV.3-2-generic"])
  (latexEnv := "remark")]
theorem eTilde_eq_bot_or_isNonsingCodimOneOn_and_hasOnlyNormalCrossings [Hironaka.HironakaCitedResults.{u}] (s : ℕ) :
    (∀ j, (𝒮.eTilde s).2 j = ⊥ ∨
      IsNonsingCodimOneOn ((𝒮.eTilde s).2 j) (R.uBar s : Set (𝒮.xBar s).toScheme)) ∧
    ∀ xb ∈ R.uBar s,
      (⨅ j : {j // (𝒮.eTilde s).2 j ≠ ⊥}, (𝒮.eTilde s).2 j.1).HasOnlyNormalCrossingsAt xb := by
  cases r with
  | closed F => exact R.eq_bot_or_isNonsingCodimOneOn_and_hasOnlyNormalCrossings_bdry s
  | opn U => exact R.eq_bot_or_isNonsingCodimOneOn_and_hasOnlyNormalCrossings_bdry s

/-- The entries of the auxiliary datum `ℜ^{N-1}_II` of p. 308 are the whole space or non-singular
divisors of `X̃`, and the union of the entries other than the whole space has only normal crossings:
the clauses of Definition 3 (II) which the frame delivers (repair of the paper's error on the subschemes `Ẽ_j`). -/
theorem datumII_E_eq_bot_or_isNonsingularDivisor_and_hasOnlyNormalCrossings_emptyIfBot [Hironaka.HironakaCitedResults.{u}] (s : ℕ)
    (a : Fin (𝒮.eTilde s).1 → ℕ) (Jt : Subscheme (R.xTilde s)) :
    (∀ j, (R.datumII s a Jt).E j = ⊥ ∨ ((R.datumII s a Jt).E j).IsNonsingularDivisor) ∧
    (R.datumII s a Jt).emptyIfBot.eUnion.HasOnlyNormalCrossings := by
  obtain ⟨h1, h3⟩ := R.eTilde_eq_bot_or_isNonsingCodimOneOn_and_hasOnlyNormalCrossings s
  exact eq_bot_or_isNonsingularDivisor_and_hasOnlyNormalCrossings_totalTransform_opens_ι
    (R.uBar s) (𝒮.eTilde s).2 (fun j => (𝒮.eTilde s).2 j ≠ ⊥)
    (fun i h => not_not.mp h) (fun i hκ => (h1 i).resolve_left hκ) (fun y hy => h3 y hy)

/-- **The auxiliary datum has the weak clauses** (p. 308, repair of the paper's error on the subschemes `Ẽ_j`): with
the entries equal to the whole space replaced by the empty subscheme, `ℜ^{N-1}_II` satisfies `b >
0`, each `Ẽ_j` is empty or non-singular and everywhere of codimension one (possibly reducible), the
union has only normal crossings, and `J̃_x ≠ 0`.

\textbf{Deviation from the paper (proof corrected, repair of the paper's error on the subschemes $\tilde E_j$).} The paper
(p. 308): "Let us consider a resolution datum `ℜ^{N-1}_II` on `X̃` (without restriction) of the
following form: `(Ẽ_1, …, Ẽ_α̃ | J̃, b | a_1, …, a_α̃)`".  This is not a resolution datum in general
(its `Ẽ_j` can be reducible, and `Ẽ_i = X̃` if `F = E_i`), so Lean states the weak clauses
`DatumII.Raw.IsWeakDatum` for the datum with the whole-space entries emptied
(`Compat/DatumRefinement.lean`). -/
@[blueprint "lem:IV.3-datumII-weak"
  (statement := /-- Notation as in \cref{rem:IV.3-2-generic}. For any integers $a_j\ge0$ and any
  sheaf
    of ideals $\tilde J$ on $\tilde X=\bar U_s$ with non-zero stalks, the datum $(\tilde
    E_1,\dots,\tilde E_{\tilde\alpha}\,|\,\tilde J,b\,|\,a_1,\dots,a_{\tilde\alpha})$ in which every
    $\tilde E_j$ equal to $\tilde X$ is replaced by the empty subscheme satisfies: $b>0$; every
    $\tilde E_j$ is empty or non-singular and everywhere of codimension $1$ in $\tilde X$; their
    union has only normal crossings on $\tilde X$; $\tilde J_x\neq0$ for all $x$. -/)
  (proof := /-- \cref{lem:IV.3-b-pos}; the entries and their union by \cref{rem:IV.3-2-repaired}
    pulled back along the open immersion $\bar U_s\to\bar X_s$ (finite intersections commute with
    total transforms along open immersions; a non-singular divisor of $\bar X_s$ on $\bar U_s$ is a
    non-singular divisor of the open subscheme $\bar U_s$).

    \textbf{Deviation from the paper (proof corrected; repair of the paper's error on the subschemes $\tilde E_j$).} The paper
    (p.~308): ``Let us consider a resolution datum $\mathfrak R^{N-1}_{\mathrm{II}}$ on $\tilde X$
    (without restriction) of the following form: $(\tilde E_1,\dots,\tilde
    E_{\tilde\alpha}\,|\,\tilde J,b\,|\,a_1,\dots,a_{\tilde\alpha})$''. It is not a resolution datum
    in general (the $\tilde E_j$ can be reducible, and $\tilde E_i=\tilde X$ if $F=E_i$). -/)
  (proofUses := ["lem:IV.3-b-pos", "rem:IV.3-2-repaired"])
  (latexEnv := "lemma")]
theorem isWeakDatum_emptyIfBot_datumII [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (a : Fin (𝒮.eTilde s).1 → ℕ)
    (Jt : Subscheme (R.xTilde s)) (hJt : ∀ xt : R.xTilde s, Jt.stalkIdeal xt ≠ ⊥) :
    (R.datumII s a Jt).emptyIfBot.IsWeakDatum := by
  obtain ⟨hE, hNC⟩ :=
    R.datumII_E_eq_bot_or_isNonsingularDivisor_and_hasOnlyNormalCrossings_emptyIfBot s a Jt
  exact DatumII.Raw.isWeakDatum_emptyIfBot 𝒮.b_pos hE hNC hJt

/-- **The interface of the repair, discharged** (pp. 308-310, "Thus, applying Theorem
`II₂^{N-1}` to the resolution datum `ℜ^{N-1}_II` on `X̃`"): if `X̃` has a point at which it has
dimension `N - 1` (the case in which the paper is interested, p. 308), Theorem `II₂^{N-1}` resolves
the auxiliary datum with `a_j = 0`, `J̃ = J̄(s)|_{X̃}` and the whole-space entries emptied.

\textbf{Deviation from the paper (proof corrected, repair of the paper's error on the subschemes $\tilde E_j$).} The paper
applies Theorem `II₂^{N-1}` to `ℜ^{N-1}_II` itself, "the resolution datum `ℜ^{N-1}_II` on `X̃`
(without restriction)" (p. 310), which is not a resolution datum in general; Lean applies it to the
weak datum (`DatumII.Raw.resolvable_of_isWeakDatum`, which splits it into a resolution datum). The
dimension hypothesis replaces "`X̃` has dimension `N - 1`" (`lem:IV.3-xtilde-ambient`). -/
@[blueprint "lem:IV.3-datumII-resolvable"
  (statement := /-- Notation as in \cref{rem:IV.3-2-generic} and assume Theorem
    $\mathrm{II}_2^{N-1}$ (\cref{thm:I.2-II2}). If the preparation hypotheses hold at stage $s$ and
    $\tilde X=\bar U_s$ has a point at which it has dimension $N-1$, then the datum $(\tilde
    E_1,\dots,\tilde E_{\tilde\alpha}\,|\,\bar J(s)|_{\tilde X},b\,|\,0,\dots,0)$, with every
    $\tilde E_j$ equal to $\tilde X$ replaced by the empty subscheme, is resolvable: there is a
    finite permissible succession of monoidal transformations of $\tilde X$ after which it is
    resolved everywhere. -/)
  (proof := /-- $\tilde X$ is an ambient scheme of dimension $N-1$ (\cref{lem:IV.3-xtilde-ambient}),
    $\bar J(s)|_{\tilde X}$ has non-zero stalks (\cref{lem:IV.3-jbar-nonzero}) and the datum is weak
    (\cref{lem:IV.3-datumII-weak}); apply \cref{lem:IV.tilde-resolvable}.

    \textbf{Deviation from the paper (proof corrected; repair of the paper's error on the subschemes $\tilde E_j$).} The paper
    (p.~310): ``Thus, applying Theorem $\mathrm{II}_2^{N-1}$ to the resolution datum
    $\mathfrak R^{N-1}_{\mathrm{II}}$ on $\tilde X$ (without restriction)''; the datum is not a
    resolution datum in general. -/)
  (proofUses := ["lem:IV.3-xtilde-ambient", "lem:IV.3-jbar-nonzero", "lem:IV.3-datumII-weak",
    "lem:IV.tilde-resolvable"])
  (latexEnv := "lemma")]
theorem resolvable_datumII_emptyIfBot [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s)
    (hII₂ : FundamentalTheorem.II₂.{u} (N - 1))
    (h : ∃ xt : R.xTilde s, (R.xTilde s).dimAt xt = ((N - 1 : ℕ) : WithBot ℕ∞)) :
    ((R.datumII s (fun _ => 0) (R.jBarT s)).emptyIfBot).Resolvable :=
  DatumII.Raw.resolvable_of_isWeakDatum hII₂ (R.isAmbient_xTilde s h)
    (R.isWeakDatum_emptyIfBot_datumII s _ _ (R.stalkIdeal_jBarT_ne_bot s hprep))

end RemovalFamily

end Frame

end FrameRepair

/-! ## Stability of the properties (i), (ii) of Theorems A*, B* under permissible extensions (p.
310)

The paper's last sentence (p. 310): "Now, `g_s(S(ℜ(s)))` consists of a finite number of points at
which `X` has dimension `N`, and therefore, repeating the above process at most a finite number of
times, we achieve the demonstration of Theorems A* and B*".  The repetition needs that extending
`g_s` does not enlarge the image of `S` and does not destroy the improvement already achieved at a
point; neither is said.  Gap filled below. -/

section Stability

/-- **Theorem 3, §5, Ch. III along a permissible succession** (p. 299, recalled for the standing
tower in `Standing.nuStarSystemAt_le_and_tauStarSystemAt_ge_of_nuStarSystemEq`): if `y` is a point
of `Y` at which `Y` has dimension `N`, `X` being non-singular algebraic of dimension at most `N`
everywhere, then `ν*_y(g*(ℜ)) ≤ ν*_{g(y)}(ℜ)` member by member, and if the `ν*` agree then
`τ*_y(g*(ℜ)) ≥ τ*_{g(y)}(ℜ)`.

Not in the paper in this form (gap filled): the paper compares the characters along the standing
tower only; the same one-step induction (`DatumI.Raw.nuStarAt_strictTransform_le_and_tauAt_le`) is
needed for a succession `h` which extends `g_s` (p. 310, "repeating the above process"), where no
standing tower is at hand. -/
theorem nuStarSystemAt_succSystem_le_and_tauStarSystemAt_ge [Hironaka.HironakaCitedResults.{u}] {N : ℕ} {X Y : Scheme.{u}}
    (g : MonoidalSuccession X Y) :
    ∀ {ℜ : DatumI.Raw X} [IsAlgebraicScheme X], X.IsNonsingular →
      (∀ x : X, X.dimAt x ≤ (N : WithBot ℕ∞)) → g.IsPermissibleI ℜ →
      ∀ (y : Y), Y.dimAt y = (N : WithBot ℕ∞) → ∀ (hy : Y.IsSimpleAt y) (x : X),
        g.composite.base y = x → ∀ hx : X.IsSimpleAt x,
      (∀ j, nuStarSystemAt (succSystem g ℜ) y hy j ≤ nuStarSystemAt (datumSystem ℜ) x hx j) ∧
      (NuStarSystemEq (datumSystem ℜ) x hx (succSystem g ℜ) y hy →
        ∀ j i, tauStarSystemAt (datumSystem ℜ) x hx j i ≤
          tauStarSystemAt (succSystem g ℜ) y hy j i) := by
  induction g with
  | nil X =>
    intro ℜ _ _ _ _ y _ hy x hxy hx
    subst hxy
    exact ⟨fun j => le_rfl, fun _ j i => le_rfl⟩
  | @cons X₀ B t Y₀ rest ih =>
    intro ℜ _ hX hN hg y hdim hy x hxy hx
    obtain ⟨hB, hrest⟩ := hg
    have hBns : B.IsNonsingular := hB.1.isNonsingular
    have hX' : t.X'.IsNonsingular := (t.isNonsingular_and_isNonsingular_exceptional hX hBns).1
    have : IsAlgebraicScheme t.X' := t.isAlgebraicScheme
    have hN' : ∀ x : t.X', t.X'.dimAt x ≤ (N : WithBot ℕ∞) := fun x =>
      (MonoidalTransformation.dimAt_le hX hBns t x).trans (hN _)
    set y₁ := rest.composite.base y with hy₁
    have hdim₁ : t.X'.dimAt y₁ = (N : WithBot ℕ∞) := le_antisymm (hN' y₁)
      (hdim ▸ MonoidalSuccession.dimAt_le_composite_of_isAlgebraicScheme rest y)
    have hy₁s : t.X'.IsSimpleAt y₁ := hX' y₁
    have hxy' : t.f.base y₁ = x := by
      rw [← hxy, MonoidalSuccession.composite_cons, Scheme.Hom.comp_apply]
    subst hxy'
    have hdimX : t.X'.dimAt y₁ = X₀.dimAt (t.f.base y₁) :=
      le_antisymm (MonoidalTransformation.dimAt_le hX hBns t y₁) (hdim₁ ▸ hN _)
    obtain ⟨ihν, ihτ⟩ := ih hX' hN' hrest y hdim hy y₁ rfl hy₁s
    have hsys : ∀ j, succSystem (MonoidalSuccession.cons B t rest) ℜ j =
        succSystem rest (ℜ.transform t) j := fun j => by
      simp only [succSystem, datumSystem_transform]
      rfl
    have hstep := fun j => DatumI.Raw.nuStarAt_strictTransform_le_and_tauAt_le hX hB t y₁ hy₁s
      hdimX j
    have hν1 : ∀ j, ((succSystem (MonoidalSuccession.cons B t rest) ℜ) j).nuStarAt y hy ≤
        (Subscheme.strictTransform t (datumSystem ℜ j)).nuStarAt y₁ hy₁s := fun j => by
      have h := ihν j
      simp only [nuStarSystemAt, datumSystem_transform] at h
      rw [hsys j]
      exact h
    refine ⟨fun j => (hν1 j).trans (hstep j).1, fun heq j i => ?_⟩
    have hmid : ∀ j, (Subscheme.strictTransform t (datumSystem ℜ j)).nuStarAt y₁ hy₁s =
        (datumSystem ℜ j).nuStarAt (t.f.base y₁) hx := fun j =>
      le_antisymm (hstep j).1 (((heq j).symm.le).trans (hν1 j))
    have heqs : NuStarSystemEq (datumSystem (ℜ.transform t)) y₁ hy₁s
        (succSystem rest (ℜ.transform t)) y hy := fun j => by
      refine le_antisymm (ihν j) ?_
      show (datumSystem (ℜ.transform t) j).nuStarAt y₁ hy₁s ≤
        (succSystem rest (ℜ.transform t) j).nuStarAt y hy
      have h3 : ((succSystem (MonoidalSuccession.cons B t rest) ℜ) j).nuStarAt y hy =
          (datumSystem ℜ j).nuStarAt (t.f.base y₁) hx := heq j
      rw [hsys j] at h3
      rw [datumSystem_transform ℜ t j, hmid j, ← h3]
    have hτ := ihτ heqs j i
    have hτs := (hstep j).2 (hmid j) (i : ℕ) i.pos
    show (datumSystem ℜ j).tauAt (t.f.base y₁) hx (i : ℕ) ≤
      ((succSystem (MonoidalSuccession.cons B t rest) ℜ) j).tauAt y hy (i : ℕ)
    rw [hsys j]
    refine le_trans hτs ?_
    have hτ' : (datumSystem (ℜ.transform t) j).tauAt y₁ hy₁s (i : ℕ) ≤
        ((succSystem rest (ℜ.transform t)) j).tauAt y hy (i : ℕ) := hτ
    rwa [datumSystem_transform ℜ t j] at hτ'

variable {X Y Z : Scheme.{u}}

/-- The system of the composite succession is the system of the second succession for the datum
transformed by the first, up to the reindexing `β_transformI`. -/
theorem succSystem_append_cast (g : MonoidalSuccession X Y) (h : MonoidalSuccession Y Z)
    (ℜ : DatumI.Raw X) (j : Fin (ℜ.β + 1)) :
    succSystem (g.append h) ℜ j = succSystem h (g.transformI ℜ)
      (Fin.cast (congrArg (· + 1) (MonoidalSuccession.β_transformI g ℜ).symm) j) := by
  show (g.append h).strictTransform (datumSystem ℜ j) =
    h.strictTransform (datumSystem (g.transformI ℜ) _)
  rw [MonoidalSuccession.strictTransform_append, datumSystem_transformI_cast]
  rfl

/-- **Theorem 3, §5, Ch. III for a permissible extension** `g ++ h`: at a point `z` of `Z` at which
`Z` has dimension `N`, the characters of `(g ++ h)*(ℜ)` at `z` are at most those of `g*(ℜ)` at
`h(z)` member by member, and if the `ν*` agree, the `τ*` are at least those. -/
theorem nuStarSystemAt_succSystem_append_le_and_tauStarSystemAt_ge [Hironaka.HironakaCitedResults.{u}] {N n : ℕ}
    (g : MonoidalSuccession X Y) (h : MonoidalSuccession Y Z) {ℜ : DatumI.Raw X}
    {r : Restriction X} (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ)
    (hg : r.IsPermissibleSucc (g.append h) ℜ) (z : Z) (hdim : Z.dimAt z = (N : WithBot ℕ∞))
    (hz : Z.IsSimpleAt z) (hy : Y.IsSimpleAt (h.composite.base z)) :
    (∀ j, nuStarSystemAt (succSystem (g.append h) ℜ) z hz j ≤
      nuStarSystemAt (succSystem g ℜ) (h.composite.base z) hy j) ∧
    (NuStarSystemEq (succSystem g ℜ) (h.composite.base z) hy (succSystem (g.append h) ℜ) z hz →
      ∀ j i, tauStarSystemAt (succSystem g ℜ) (h.composite.base z) hy j i ≤
        tauStarSystemAt (succSystem (g.append h) ℜ) z hz j i) := by
  obtain ⟨hg1, hh⟩ := (Restriction.isPermissibleSucc_append r g h ℜ).mp hg
  obtain ⟨hgood, hrr⟩ := isGoodDatumI_transformI_and_isFor_transformSucc g hℜ hr hg1
  have : IsAlgebraicScheme Y := hgood.1.1
  obtain ⟨H1, H2⟩ := nuStarSystemAt_succSystem_le_and_tauStarSystemAt_ge h (N := N)
    (ℜ := g.transformI ℜ) hgood.1.2.1
    (fun x => (LocSucc.dimAt_le_dim x).trans hgood.1.2.2.2.le) hh.isPermissibleI z hdim hz _ rfl hy
  have hcast := congrArg (· + 1) (MonoidalSuccession.β_transformI g ℜ).symm
  refine ⟨fun j => ?_, fun heq j i => ?_⟩
  · have := H1 (Fin.cast hcast j)
    show ((succSystem (g.append h) ℜ) j).nuStarAt z hz ≤ ((succSystem g ℜ) j).nuStarAt _ hy
    rw [succSystem_append_cast, ← datumSystem_transformI_cast g ℜ j]
    exact this
  · have heq' : NuStarSystemEq (datumSystem (g.transformI ℜ)) (h.composite.base z) hy
        (succSystem h (g.transformI ℜ)) z hz := fun j' => by
      have e : Fin.cast hcast (Fin.cast hcast.symm j') = j' := Fin.ext rfl
      have := heq (Fin.cast hcast.symm j')
      show ((succSystem h (g.transformI ℜ)) j').nuStarAt z hz =
        ((datumSystem (g.transformI ℜ)) j').nuStarAt _ hy
      rw [← e]
      have h2 : ((succSystem (g.append h) ℜ) (Fin.cast hcast.symm j')).nuStarAt z hz =
          ((succSystem g ℜ) (Fin.cast hcast.symm j')).nuStarAt _ hy := this
      rw [succSystem_append_cast, ← datumSystem_transformI_cast g ℜ] at h2
      exact h2
    have := H2 heq' (Fin.cast hcast j) i
    show ((succSystem g ℜ) j).tauAt _ hy (i : ℕ) ≤
      ((succSystem (g.append h) ℜ) j).tauAt z hz (i : ℕ)
    rw [succSystem_append_cast, ← datumSystem_transformI_cast g ℜ j]
    exact this

/-- Property (i) of Theorems A*, B* (p. 293): `f(S(ℜ'))` is a finite set of points of `X` at which
`X` has dimension `N`. -/
def HasFiniteImageOfDimEq (N : ℕ) (ℜ : DatumI.Raw X) (r : Restriction X)
    (f : MonoidalSuccession X Y) : Prop :=
  (f.composite.base '' S (f.transformI ℜ) (r.transformSucc f)).Finite ∧
  ∀ y ∈ f.composite.base '' S (f.transformI ℜ) (r.transformSucc f),
    X.dimAt y = (N : WithBot ℕ∞)

/-- Property (ii) of Theorems A*, B* (p. 294) at the point `x₁` of `X`: every point `x'` of
`S(ℜ')` at which `Y` has dimension `N` and which lies over `x₁` has `ν*` strictly smaller, or `ν*`
equal and `τ*` strictly larger, than `x₁`. -/
def IsImprovedAt (N : ℕ) (ℜ : DatumI.Raw X) (r : Restriction X) (f : MonoidalSuccession X Y)
    (x₁ : X) : Prop :=
  ∀ x' ∈ S (f.transformI ℜ) (r.transformSucc f), Y.dimAt x' = (N : WithBot ℕ∞) →
    f.composite.base x' = x₁ →
    ∀ (hx' : Y.IsSimpleAt x') (hx : X.IsSimpleAt (f.composite.base x')),
      NuStarSystemGT (datumSystem ℜ) (f.composite.base x') hx (succSystem f ℜ) x' hx' ∨
        (NuStarSystemEq (datumSystem ℜ) (f.composite.base x') hx (succSystem f ℜ) x' hx' ∧
          TauStarSystemLT (datumSystem ℜ) (f.composite.base x') hx (succSystem f ℜ) x' hx')

/-- The points of the image `f(S(ℜ'))` at which (ii) of Theorems A*, B* fails. -/
def notImprovedSet (N : ℕ) (ℜ : DatumI.Raw X) (r : Restriction X) (f : MonoidalSuccession X Y) :
    Set X :=
  {x₁ ∈ f.composite.base '' S (f.transformI ℜ) (r.transformSucc f) | ¬ IsImprovedAt N ℜ r f x₁}

/-- `HasEffectiveProperties` is (i) together with (ii) at every point. -/
theorem hasEffectiveProperties_iff_hasFiniteImageOfDimEq_and_forall_isImprovedAt (N : ℕ)
    (ℜ : DatumI.Raw X) (r : Restriction X) (f : MonoidalSuccession X Y) :
    HasEffectiveProperties N ℜ r f ↔
      HasFiniteImageOfDimEq N ℜ r f ∧ ∀ x₁, IsImprovedAt N ℜ r f x₁ := by
  constructor
  · rintro ⟨h1, h2, h3⟩
    exact ⟨⟨h1, h2⟩, fun x₁ x' hx' hdim _ => h3 x' hx' hdim⟩
  · rintro ⟨⟨h1, h2⟩, h3⟩
    exact ⟨h1, h2, fun x' hx' hdim hs hx => h3 _ x' hx' hdim rfl hs hx⟩

/-- `HasEffectiveProperties` means: (i) and no point of the image fails (ii). -/
theorem hasEffectiveProperties_iff_hasFiniteImageOfDimEq_and_notImprovedSet_eq_empty (N : ℕ)
    (ℜ : DatumI.Raw X) (r : Restriction X) (f : MonoidalSuccession X Y) :
    HasEffectiveProperties N ℜ r f ↔
      HasFiniteImageOfDimEq N ℜ r f ∧ notImprovedSet N ℜ r f = ∅ := by
  rw [hasEffectiveProperties_iff_hasFiniteImageOfDimEq_and_forall_isImprovedAt]
  refine and_congr_right fun _ => ?_
  constructor
  · intro h
    refine Set.eq_empty_of_forall_notMem fun x₁ hx₁ => hx₁.2 (h x₁)
  · intro h x₁
    by_contra hcon
    have hcon' := hcon
    unfold IsImprovedAt at hcon'
    push Not at hcon'
    obtain ⟨x', hx', hdim, hxx, -⟩ := hcon'
    exact (Set.eq_empty_iff_forall_notMem.mp h) x₁ ⟨⟨x', hx', hxx⟩, hcon⟩

/-- **Stability of the image of `S` under extension** (p. 294: "Since `f_i : X_{i+1} → X_i` is a
permissible succession of monoidal transformations of `X_i` for `ℜ_i`, we have `f_i(S(ℜ_{i+1})) ⊆
S(ℜ_i)`", applied to the extension `h` of `g` for the datum `g*(ℜ)`): the image of `S` under a
permissible extension `g ++ h` lies in the image of `S` under `g`.

\textbf{Deviation from the paper (gap filled).} The paper (p. 310): "Now, `g_s(S(ℜ(s)))` consists of
a finite number of points at which `X` has dimension `N`, and therefore, repeating the above process
at most a finite number of times, we achieve the demonstration of Theorems A* and B*" does not
say that the finiteness and the dimension `N` of the image persist when `g_s` is extended. -/
@[blueprint "lem:IV.3-image-S-append"
  (statement := /-- Let $g\colon X'\to X$ be a finite succession of monoidal transformations and
    $h\colon X''\to X'$ a finite succession such that $g\circ h$ is permissible for $\mathfrak R$
    (with its restriction). Then $(gh)(S((gh)^*\mathfrak R))\subseteq g(S(g^*\mathfrak R))$. -/)
  (proof := /-- $gh$ permissible means that $g$ is permissible for $\mathfrak R$ and $h$ for
    $g^*\mathfrak R$; apply $h(S(h^*(g^*\mathfrak R)))\subseteq S(g^*\mathfrak R)$
    (\cref{def:IV.3-effective-modification}, p.~294) and push forward by $g$.

    \textbf{Deviation from the paper (gap filled).} The paper (p.~310): ``Now,
    $g_s(S(\mathfrak R(s)))$ consists of a finite number of points at which $X$ has dimension $N$,
    and therefore, repeating the above process at most a finite number of times, we achieve the
    demonstration of Theorems A* and B*'' does not say that this finite set can only shrink when
    $g_s$ is extended. -/)
  (latexEnv := "lemma")]
theorem image_S_append_subset [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} (g : MonoidalSuccession X Y) (h : MonoidalSuccession Y Z)
    {ℜ : DatumI.Raw X} {r : Restriction X} (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ)
    (hg : r.IsPermissibleSucc (g.append h) ℜ) :
    (g.append h).composite.base '' S ((g.append h).transformI ℜ) (r.transformSucc (g.append h)) ⊆
      g.composite.base '' S (g.transformI ℜ) (r.transformSucc g) := by
  obtain ⟨hg1, hh⟩ := (Restriction.isPermissibleSucc_append r g h ℜ).mp hg
  obtain ⟨hgood, hrr⟩ := isGoodDatumI_transformI_and_isFor_transformSucc g hℜ hr hg1
  rw [MonoidalSuccession.transformI_append, Restriction.transformSucc_append,
    MonoidalSuccession.composite_append]
  rintro _ ⟨z, hz, rfl⟩
  exact ⟨h.composite.base z, composite_image_S_subset h hgood hrr hh ⟨z, hz, rfl⟩, rfl⟩

/-- Property (i) of Theorems A*, B* is stable under permissible extensions. -/
theorem HasFiniteImageOfDimEq.append [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {g : MonoidalSuccession X Y}
    (h : MonoidalSuccession Y Z) {ℜ : DatumI.Raw X} {r : Restriction X}
    (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) (hg : r.IsPermissibleSucc (g.append h) ℜ)
    (hi : HasFiniteImageOfDimEq N ℜ r g) : HasFiniteImageOfDimEq N ℜ r (g.append h) :=
  ⟨hi.1.subset (image_S_append_subset g h hℜ hr hg),
    fun y hy => hi.2 y (image_S_append_subset g h hℜ hr hg hy)⟩

/-- **Stability of "improved" under extension**: if (ii) of Theorems A*, B* holds at the point `x₁`
for `g`, it holds at `x₁` for every permissible extension `g ++ h`. (The characters can only improve
along `h`: Theorem 3, §5, Ch. III, `nuStarSystemAt_succSystem_append_le_and_tauStarSystemAt_ge`.)

\textbf{Deviation from the paper (gap filled).} The paper (p. 310) achieves "either
`ν*_x(V_1(s), …, W(s)/X_s) < ν*_{x_0}(V_1, …, W/X)` or, if they are equal, `τ* >`" at the points
`x` of `X_s` over the chosen `x_0 ∈ g_s(S(ℜ(s)))`, replaces `g_s` by an extension, and then says
"repeating the above process at most a finite number of times".  That the points already improved
stay improved after the extension is not said; it follows from Theorem 3, §5, Ch. III. -/
@[blueprint "lem:IV.3-improved-append"
  (statement := /-- In the situation of \cref{lem:IV.3-image-S-append}, if the property (ii) of
    Theorems A*, B* holds for $g$ at the point $x_1$ of $X$ (every $x'\in S(g^*\mathfrak R)$ over
    $x_1$ at which $X'$ has dimension $N$ has $\nu^*$ smaller, or $\nu^*$ equal and $\tau^*$ larger,
    than $x_1$), then it holds for $gh$ at $x_1$. -/)
  (proof := /-- A point $x''$ of $S((gh)^*\mathfrak R)$ over $x_1$ at which $X''$ has dimension $N$
    maps to a point $x'$ of $S(g^*\mathfrak R)$ over $x_1$ at which $X'$ has dimension $N$
    (\cref{lem:IV.3-image-S-append}). The characters at $x''$ are $\le$ those at $x'$, and $\tau^*$
    is $\ge$ if the $\nu^*$ agree (Theorem~3, \S5, Ch.~III, \cref{lem:IV.3-thm3-consequence});
    compose with the hypothesis at $x'$.

    \textbf{Deviation from the paper (gap filled).} The paper (p.~310) does not say that the
    improvement persists when $g_s$ is extended. -/)
  (proofUses := ["lem:IV.3-image-S-append", "lem:IV.3-thm3-consequence"])
  (latexEnv := "lemma")]
theorem IsImprovedAt.append [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {g : MonoidalSuccession X Y} (h : MonoidalSuccession Y Z)
    {ℜ : DatumI.Raw X} {r : Restriction X} (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ)
    (hg : r.IsPermissibleSucc (g.append h) ℜ) {x₁ : X} (himp : IsImprovedAt N ℜ r g x₁) :
    IsImprovedAt N ℜ r (g.append h) x₁ := by
  intro z hz hdim hz₁ hzs
  obtain ⟨hg1, hh⟩ := (Restriction.isPermissibleSucc_append r g h ℜ).mp hg
  obtain ⟨hgood, hrr⟩ := isGoodDatumI_transformI_and_isFor_transformSucc g hℜ hr hg1
  have : IsAlgebraicScheme Y := hgood.1.1
  have hzS : z ∈ S (h.transformI (g.transformI ℜ)) ((r.transformSucc g).transformSucc h) := by
    rwa [MonoidalSuccession.transformI_append, Restriction.transformSucc_append] at hz
  have hyS : h.composite.base z ∈ S (g.transformI ℜ) (r.transformSucc g) :=
    composite_image_S_subset h hgood hrr hh ⟨z, hzS, rfl⟩
  have hcomp : (g.append h).composite.base z = g.composite.base (h.composite.base z) := by
    rw [MonoidalSuccession.composite_append, Scheme.Hom.comp_apply]
  have hYdim : Y.dimAt (h.composite.base z) = (N : WithBot ℕ∞) := by
    refine le_antisymm ((LocSucc.dimAt_le_dim _).trans hgood.1.2.2.2.le) ?_
    exact hdim ▸ MonoidalSuccession.dimAt_le_composite_of_isAlgebraicScheme h z
  have hYs : Y.IsSimpleAt (h.composite.base z) := hgood.1.2.1 _
  have hX : X.IsSimpleAt (g.composite.base (h.composite.base z)) := hℜ.1.2.1 _
  have himp' := himp _ hyS hYdim (hcomp ▸ hz₁) hYs hX
  obtain ⟨hν, hτ⟩ := nuStarSystemAt_succSystem_append_le_and_tauStarSystemAt_ge g h hℜ hr hg z
    hdim hzs hYs
  intro hx
  revert hx
  rw [hcomp]
  intro hx
  rcases himp' with hGT | ⟨hEq, hLT⟩
  · left
    exact ⟨fun j => (hν j).trans (hGT.1 j), by
      obtain ⟨j₀, hj₀⟩ := hGT.2
      exact ⟨j₀, lt_of_le_of_lt (hν j₀) hj₀⟩⟩
  · by_cases hCB : NuStarSystemEq (succSystem g ℜ) (h.composite.base z) hYs
        (succSystem (g.append h) ℜ) z hzs
    · right
      refine ⟨fun j => (hCB j).trans (hEq j), fun j i => (hLT.1 j i).trans (hτ hCB j i), ?_⟩
      obtain ⟨j₀, i₀, hj₀⟩ := hLT.2
      exact ⟨j₀, i₀, lt_of_lt_of_le hj₀ (hτ hCB j₀ i₀)⟩
    · left
      refine ⟨fun j => (hν j).trans (hEq j).le, ?_⟩
      have hex : ∃ j₁, ¬ (nuStarSystemAt (succSystem (g.append h) ℜ) z hzs j₁ =
          nuStarSystemAt (succSystem g ℜ) (h.composite.base z) hYs j₁) :=
        not_forall.mp hCB
      obtain ⟨j₁, hj₁⟩ := hex
      exact ⟨j₁, lt_of_lt_of_eq (lt_of_le_of_ne (hν j₁) hj₁) (hEq j₁)⟩

/-- The points of the image at which (ii) of Theorems A*, B* fails can only disappear under a
permissible extension. -/
theorem notImprovedSet_append_subset [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {g : MonoidalSuccession X Y}
    (h : MonoidalSuccession Y Z) {ℜ : DatumI.Raw X} {r : Restriction X}
    (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) (hg : r.IsPermissibleSucc (g.append h) ℜ) :
    notImprovedSet N ℜ r (g.append h) ⊆ notImprovedSet N ℜ r g :=
  fun _ hx => ⟨image_S_append_subset g h hℜ hr hg hx.1, fun hi => hx.2 (hi.append h hℜ hr hg)⟩

/-- If (i) holds, only finitely many points of the image fail (ii). -/
theorem notImprovedSet_finite {N : ℕ} {ℜ : DatumI.Raw X} {r : Restriction X}
    {g : MonoidalSuccession X Y} (hi : HasFiniteImageOfDimEq N ℜ r g) :
    (notImprovedSet N ℜ r g).Finite :=
  hi.1.subset fun _ hx => hx.1

/-- Effective properties (Theorems A*, B*, p. 293-294) are stable under permissible extensions. -/
theorem HasEffectiveProperties.append [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {g : MonoidalSuccession X Y}
    (h : MonoidalSuccession Y Z) {ℜ : DatumI.Raw X} {r : Restriction X}
    (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) (hg : r.IsPermissibleSucc (g.append h) ℜ)
    (hE : HasEffectiveProperties N ℜ r g) : HasEffectiveProperties N ℜ r (g.append h) := by
  rw [hasEffectiveProperties_iff_hasFiniteImageOfDimEq_and_forall_isImprovedAt] at hE ⊢
  exact ⟨hE.1.append h hℜ hr hg, fun x₁ => (hE.2 x₁).append h hℜ hr hg⟩

end Stability

/-! ## The succession `g_s` of p. 307: [(1)] and [(2)] (Localization and Preparation Theorems)

"First of all, by Localization Theorems (Propositions 1 and 2 of §1, Ch. IV) and Preparation
Theorem (Proposition 5 of §2, Ch. IV), we can find a permissible succession of monoidal
transformations `g_s` ... such that [(1)] ... [(2)] ... (For [(2)], we apply Preparation Theorem
`α` times repeatedly.)" (p. 307). -/

end AB

section Components

variable {Y : Scheme.{u}} {B : Subscheme Y}

namespace MonoidalTransformation

/-- One monoidal transformation: an irreducible component `W₂` of the strict transform of `W` lies
over an irreducible component `W₁` of `W`, and lies in the strict transform of every `E ⊇ W₁`. -/
theorem exists_mem_irreducibleComponents_of_mem_irreducibleComponents_strictTransform
    [TopologicalSpace.NoetherianSpace Y] (t : MonoidalTransformation Y B) (W : Subscheme Y)
    {W₂ : Subscheme t.X'} (hW₂ : W₂ ∈ (Subscheme.strictTransform t W).irreducibleComponents) :
    ∃ W₁ ∈ W.irreducibleComponents, t.f.base '' W₂.pts ⊆ W₁.pts ∧
      ∀ E : Subscheme Y, W₁.pts ⊆ E.pts → W₂.pts ⊆ (Subscheme.strictTransform t E).pts := by
  obtain ⟨Z, hZ, rfl⟩ := hW₂
  have hZirr : _root_.IsIrreducible (Z : Set t.X') := hZ.1.1
  have hZcl : IsClosed (Z : Set t.X') := Z.isClosed
  set η : t.X' := hZirr.genericPoint with hη
  have hηgen : IsGenericPoint η (Z : Set t.X') := by
    have := hZirr.isGenericPoint_genericPoint_closure
    rwa [hZcl.closure_eq] at this
  have hηZ : η ∈ (Z : Set t.X') := hηgen.mem
  have hηW : η ∈ (Subscheme.strictTransform t W).pts := hZ.1.2 hηZ
  obtain ⟨q, hq, hqE, hqη⟩ := t.exists_generization_notMem_exceptional W hηW
  -- `q` is a generic point of `Z`
  have hclq : closure {q} = (Z : Set t.X') := by
    have h1 : (Z : Set t.X') ⊆ closure {q} := by
      rw [← hηgen.def]
      exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hqη))
        isClosed_closure
    have h2 : closure {q} ⊆ (Subscheme.strictTransform t W).pts :=
      closure_minimal (Set.singleton_subset_iff.mpr hq)
        (Subscheme.strictTransform t W).support.isClosed
    have h3 := hZ.2 (y := ⟨closure {q}, isClosed_closure⟩)
      ⟨isIrreducible_singleton.closure, h2⟩ h1
    exact le_antisymm h3 h1
  have hfq : t.f.base q ∈ W.pts := t.pts_strictTransform_subset W hq
  obtain ⟨W₁, hW₁, hqW₁⟩ := Subscheme.exists_mem_irreducibleComponents_of_mem_pts W hfq
  have hW₁cl : IsClosed W₁.pts := W₁.support.isClosed
  refine ⟨W₁, hW₁, ?_, fun E hE => ?_⟩
  · rw [Subscheme.pts_ofClosed, ← hclq]
    refine (image_closure_subset_closure_image t.f.base.hom.continuous).trans
      (closure_minimal ?_ hW₁cl)
    rw [Set.image_singleton]
    exact Set.singleton_subset_iff.mpr hqW₁
  · rw [Subscheme.pts_ofClosed, ← hclq]
    refine closure_minimal (Set.singleton_subset_iff.mpr ?_)
      (Subscheme.strictTransform t E).support.isClosed
    exact (t.mem_pts_strictTransform_iff_of_notMem E hqE).mpr (hE hqW₁)

end MonoidalTransformation

namespace MonoidalSuccession

/-- A succession: an irreducible component `W₂` of the strict transform of `W` lies over an
irreducible component `W₁` of `W`, and lies in the strict transform of every `E ⊇ W₁`.

Not in the paper (tacit): used for the stability of [(2)] (p. 307) when the succession `g_s` is
extended, and for the iteration of the Preparation Theorem. -/
@[blueprint "lem:IV.3-components-strict-transform"
  (statement := /-- Let $g\colon X'\to X$ be a finite succession of monoidal transformations of an
    algebraic scheme $X$, $W$ a subscheme of $X$ and $W_2$ an irreducible component of the strict
    transform $g^*W$. Then there is an irreducible component $W_1$ of $W$ such that $g(W_2)\subseteq
    W_1$, and $W_2\subseteq g^*E$ for every subscheme $E$ of $X$ containing $W_1$. -/)
  (proof := /-- One monoidal transformation $t$: the generic point $\eta$ of $W_2$ is not in the
    exceptional divisor: the strict transform is the closure of its part off the exceptional
    divisor, so $\eta$ has a generization in $g^*W$ off the exceptional divisor, which is again a
    generic point of $W_2$. Let $W_1$ be an irreducible component of $W$ through $t(\eta)$. Then
    $t(W_2)=t(\overline{\{\eta\}}) \subseteq\overline{\{t(\eta)\}}\subseteq W_1$, and if
    $W_1\subseteq E$ then $\eta$ lies in $t^{-1}(E)$ off the exceptional divisor, hence in the
    strict transform of $E$, and so does $W_2=\overline{\{\eta\}}$. A succession: induction. -/)
  (latexEnv := "lemma")]
theorem exists_mem_irreducibleComponents_of_mem_irreducibleComponents_strictTransform [Hironaka.HironakaCitedResults.{u}]
    {X Y : Scheme.{u}} (s : MonoidalSuccession X Y) :
    ∀ [IsAlgebraicScheme X] (W : Subscheme X) {W₂ : Subscheme Y},
      W₂ ∈ (s.strictTransform W).irreducibleComponents →
      ∃ W₁ ∈ W.irreducibleComponents, s.composite.base '' W₂.pts ⊆ W₁.pts ∧
        ∀ E : Subscheme X, W₁.pts ⊆ E.pts → W₂.pts ⊆ (s.strictTransform E).pts := by
  induction s with
  | nil X =>
    intro _ W W₂ hW₂
    exact ⟨W₂, hW₂, fun y hy => by simpa using hy, fun E hE => hE⟩
  | @cons X₀ B t Y₀ rest ih =>
    intro _ W W₂ hW₂
    have : IsAlgebraicScheme t.X' := t.isAlgebraicScheme
    have := IsAlgebraicScheme.noetherianSpace X₀
    obtain ⟨Wm, hWm, hm1, hm2⟩ := ih (Subscheme.strictTransform t W) hW₂
    obtain ⟨W₁, hW₁, h1, h2⟩ :=
      t.exists_mem_irreducibleComponents_of_mem_irreducibleComponents_strictTransform W
        hWm
    refine ⟨W₁, hW₁, ?_, fun E hE => hm2 _ (h2 E hE)⟩
    rintro _ ⟨y, hy, rfl⟩
    rw [MonoidalSuccession.composite_cons, Scheme.Hom.comp_apply]
    exact h1 ⟨_, hm1 ⟨y, hy, rfl⟩, rfl⟩

end MonoidalSuccession

end Components

namespace AB

section Prepared

variable {X Y Z : Scheme.{u}}

/-- The condition [(2)] of p. 307 for the component `E_i` of the presentation `P` of `ℜ`, along
the succession `g`: if `r = (ℜ, U)` is an open restriction, then for every irreducible component
`W₁(s)` of `W(s)`, either `W₁(s) ⊆ E_i(s)` or `E_i(s) ∩ W₁(s) ∩ S(ℜ(s))` is empty. -/
def IsPreparedAt {ℜ : DatumI.Raw X} (P : DatumI.Presentation ℜ) (r : Restriction X)
    (g : MonoidalSuccession X Y) (i : Fin P.α) : Prop :=
  ∀ U, r = .opn U → ∀ W₁ ∈ (g.transformI ℜ).W.irreducibleComponents,
    W₁.IsContainedIn (g.strictTransform (P.E i)) ∨
      (g.strictTransform (P.E i)).pts ∩ W₁.pts ∩
        S (g.transformI ℜ) (r.transformSucc g) = ∅

/-- The condition [(2)] of p. 307 for all the components `E_1, …, E_α`. -/
def HasPreparedBoundary {ℜ : DatumI.Raw X} (P : DatumI.Presentation ℜ) (r : Restriction X)
    (g : MonoidalSuccession X Y) : Prop :=
  ∀ i, IsPreparedAt P r g i

/-- **Stability of [(2)] under extension** (p. 307; the paper says nothing about it): if the
condition [(2)] for `E_i` holds along `g`, it holds along every permissible extension `g ++ h`.

\textbf{Deviation from the paper (gap filled).} The paper (p. 307, p. 310) establishes [(2)] by
"applying Preparation Theorem `α` times repeatedly" and then extends `g_s` ("repeating the above
process"); that [(2)] persists is not said.  A component of the transformed `W` lies over a
component of `W` (blueprint `lem:IV.3-components-strict-transform`), and the image of `S` can only
shrink (`composite_image_S_subset`). -/
@[blueprint "lem:IV.3-prepared-append"
  (statement := /-- In the situation of \cref{lem:IV.3-image-S-append} for an open restriction, if
    the condition [(2)] (\cref{def:IV.3-conditions}) holds for $E_i$ along $g$ (every irreducible
    component $W_1$ of $W(g)$ is contained in $E_i(g)$ or $E_i(g)\cap W_1\cap S(g^*\mathfrak R)$ is
    empty), it holds for $E_i$ along $gh$. -/)
  (proof := /-- A component $W_2$ of $W(gh)=h^*W(g)$ lies over a component $W_1$ of $W(g)$ and lies
  in
    $h^*E$ for every $E\supseteq W_1$ (\cref{lem:IV.3-components-strict-transform}). If
    $W_1\subseteq E_i(g)$ then $W_2\subseteq E_i(gh)$. Otherwise a point of $E_i(gh)\cap W_2\cap
    S((gh)^*\mathfrak R)$ maps to a point of $E_i(g)\cap W_1\cap S(g^*\mathfrak R)$
    (\cref{lem:IV.3-image-S-append}), which is empty.

    \textbf{Deviation from the paper (gap filled).} The paper does not say that [(2)] persists when
    $g_s$ is extended. -/)
  (proofUses := ["lem:IV.3-components-strict-transform", "lem:IV.3-image-S-append"])
  (latexEnv := "lemma")]
theorem IsPreparedAt.append [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} {g : MonoidalSuccession X Y} (h : MonoidalSuccession Y Z)
    (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) (hg : r.IsPermissibleSucc (g.append h) ℜ)
    {i : Fin P.α} (hi : IsPreparedAt P r g i) : IsPreparedAt P r (g.append h) i := by
  intro U hU W₂ hW₂
  obtain ⟨hg1, hh⟩ := (Restriction.isPermissibleSucc_append r g h ℜ).mp hg
  obtain ⟨hgood, hrr⟩ := isGoodDatumI_transformI_and_isFor_transformSucc g hℜ hr hg1
  have : IsAlgebraicScheme Y := hgood.1.1
  rw [MonoidalSuccession.transformI_append, MonoidalSuccession.transformI_W] at hW₂
  obtain ⟨W₁, hW₁, h1, h2⟩ :=
    h.exists_mem_irreducibleComponents_of_mem_irreducibleComponents_strictTransform
      (g.transformI ℜ).W hW₂
  have hred : W₂.IsReduced := Subscheme.isReduced_of_mem_irreducibleComponents hW₂
  rw [MonoidalSuccession.strictTransform_append]
  rcases hi U hU W₁ hW₁ with hc | hempty
  · left
    exact Subscheme.isContainedIn_of_pts_subset hred
      (h2 _ (pts_subset_of_isContainedIn hc))
  · right
    refine Set.eq_empty_iff_forall_notMem.mpr fun z ⟨⟨hzE, hzW⟩, hzS⟩ => ?_
    rw [MonoidalSuccession.transformI_append, Restriction.transformSucc_append] at hzS
    have hE : h.composite.base z ∈ (g.strictTransform (P.E i)).pts :=
      h.pts_strictTransform_subset _ hzE
    have hW : h.composite.base z ∈ W₁.pts := h1 ⟨z, hzW, rfl⟩
    have hS := composite_image_S_subset h hgood hrr hh ⟨z, hzS, rfl⟩
    exact (Set.eq_empty_iff_forall_notMem.mp hempty) _ ⟨⟨hE, hW⟩, hS⟩

/-- The condition [(2)] for all the components is stable under permissible extensions. -/
theorem HasPreparedBoundary.append [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} {g : MonoidalSuccession X Y} (h : MonoidalSuccession Y Z)
    (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) (hg : r.IsPermissibleSucc (g.append h) ℜ)
    (hp : HasPreparedBoundary P r g) : HasPreparedBoundary P r (g.append h) :=
  fun i => (hp i).append h hℜ hr hg

/-- The conditions [(1)] and [(2)] of p. 307 on a succession `g` (without the choice of `x_0`). -/
def IsPrepared (N : ℕ) {ℜ : DatumI.Raw X} (P : DatumI.Presentation ℜ) (r : Restriction X)
    (g : MonoidalSuccession X Y) : Prop :=
  HasFiniteImageOfDimEq N ℜ r g ∧ HasPreparedBoundary P r g

/-- **[(1)] and [(2)] are stable under permissible extensions** (p. 307, 310: the proof of Theorems
A*, B* replaces `g_s` by an extension and repeats the process; the conditions persist). -/
theorem IsPrepared.append [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} {g : MonoidalSuccession X Y} (h : MonoidalSuccession Y Z)
    (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) (hg : r.IsPermissibleSucc (g.append h) ℜ)
    (hp : IsPrepared N P r g) : IsPrepared N P r (g.append h) :=
  ⟨hp.1.append h hℜ hr hg, hp.2.append h hℜ hr hg⟩

/-- [(1)] along the succession of Proposition 1 (closed case): the image in `X` of `S(ℜ(s)) = F(s) ∩
W(s)` is a finite set of points at which `X` has dimension `N`. (The proof of Theorems A*, B*, p.
307: "by Localization Theorems (Propositions 1 and 2 of §1, Ch. IV) ... we can find a permissible
succession `g_s` such that [(1)] the image in `X = X_0` of `S(ℜ(s))` consists of a finite number of
points, at which `X` has dimension `N`".) -/
theorem exists_isPermissibleIClosed_hasFiniteImageOfDimEq [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' < N → n' ≤ n → FundamentalTheorem.I₁.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X)
    (hE : (ℜ : DatumI.Raw X).IsUnionOfDivisors) (F : Subscheme X)
    (hF : (ℜ : DatumI.Raw X).IsClosedRestriction F)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞)) :
    ∃ (Y : Scheme.{u}) (g : MonoidalSuccession X Y),
      g.IsPermissibleIClosed ℜ F ∧ HasFiniteImageOfDimEq N ℜ (.closed F) g := by
  obtain ⟨Y, s, hs, hfin, hdim⟩ :=
    exists_isPermissibleIClosed_finite_image_dimAt_eq N n hNn hI₁ hI₂ X hX ℜ hE F hF hn
  have hS : S (s.transformI ℜ) ((Restriction.closed F).transformSucc s) =
      (s.strictTransform F).pts ∩ (s.transformI ℜ).W.pts := Set.inter_comm _ _
  refine ⟨Y, s, hs, ?_, ?_⟩
  · rw [hS]; exact hfin
  · rw [hS]; exact hdim

/-- [(1)] along the succession of Proposition 2 (open case): the image in `X` of the closed subset
of `W(s)` of the points at which `ℜ(s)` is not resolved is a finite set of points at which `X` has
dimension `N`. -/
theorem exists_isPermissibleIOpen_hasFiniteImageOfDimEq [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₂' : ∀ N' n' : ℕ, n' < N' → N' < N → n' ≤ n → FundamentalTheorem.I₂.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X)
    (hE : (ℜ : DatumI.Raw X).IsUnionOfDivisors) (U : Set X)
    (hU : (ℜ : DatumI.Raw X).IsOpenRestriction U)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞)) :
    ∃ (Y : Scheme.{u}) (g : MonoidalSuccession X Y),
      g.IsPermissibleIOpen ℜ U ∧ HasFiniteImageOfDimEq N ℜ (.opn U) g := by
  obtain ⟨Y, s, hs, F, hF, hFdim, hres⟩ :=
    exists_isPermissibleIOpen_finite_dimAt_eq_resolvedAt_of_notMem_preimage N n hNn hI₂' hI₂ X hX
      ℜ hE U hU hn
  have hsub : s.composite.base '' S (s.transformI ℜ) ((Restriction.opn U).transformSucc s) ⊆ F := by
    rintro _ ⟨y, ⟨hyW, hyres⟩, rfl⟩
    by_contra hy
    exact hyres (hres y hyW hy)
  exact ⟨Y, s, hs, hF.subset hsub, fun y hy => hFdim y (hsub hy)⟩

/-- The union of a family of subschemes is unchanged by a permutation of the index type. -/
theorem _root_.Hironaka.Subscheme.unionFam_comp_equiv {Y : Scheme.{u}} {ι : Type*} (σ : ι ≃ ι)
    (E : ι → Subscheme Y) : Subscheme.unionFam (fun i => E (σ i)) = Subscheme.unionFam E := by
  unfold Subscheme.unionFam
  exact Equiv.iInf_comp (g := E) σ

/-- **The Preparation Theorem applied `k` times** (p. 307: "For [(2)], we apply Preparation Theorem
`α` times repeatedly"): after Proposition 2 (which gives [(1)]), each application of Proposition 5
to the transform of the datum, with the transform of `E_k` as first member of a presentation of the
transformed boundary, establishes [(2)] for `E_k`; [(1)] is stable under permissible extensions and
so is [(2)] for the earlier `E_i`.

Deviation from the paper (gap filled): the paper says only "we apply Preparation Theorem `α` times
repeatedly".  Lean supplies the choice of the presentation of the transformed boundary with the
transform of `E_k` first (`MonoidalSuccession.exists_presentation_transformI_tail` and a permutation
of the index), the case `W(s) = ∅`, the replacement of `n` by `dim W(s) ≤ n` (Proposition 5 assumes
`dim W = n`), and the stability of [(1)] and of [(2)] for the earlier `E_i` under the extension. -/
theorem exists_isPermissibleIOpen_hasFiniteImageOfDimEq_and_isPreparedAt_lt [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' ≤ N → n' ≤ n → FundamentalTheorem.I₁.{u} N' n')
    (hI₂' : ∀ N' n' : ℕ, n' < N' → N' < N → n' ≤ n → FundamentalTheorem.I₂.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X)
    (P : DatumI.Presentation (ℜ : DatumI.Raw X)) (U : Set X)
    (hU : (ℜ : DatumI.Raw X).IsOpenRestriction U)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞)) (k : ℕ) (hk : k ≤ P.α) :
    ∃ (Y : Scheme.{u}) (g : MonoidalSuccession X Y),
      g.IsPermissibleIOpen ℜ U ∧ HasFiniteImageOfDimEq N ℜ (.opn U) g ∧
        ∀ i : Fin P.α, i.val < k → IsPreparedAt P (.opn U) g i := by
  induction k with
  | zero =>
    obtain ⟨Y, g, hg, hfin⟩ := exists_isPermissibleIOpen_hasFiniteImageOfDimEq N n hNn hI₂' hI₂ X
      hX ℜ ⟨P.α, P.E, P.E_codimOne, P.E_union⟩ U hU hn
    exact ⟨Y, g, hg, hfin, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  | succ k ih =>
    obtain ⟨Y, g, hperm, hfin, hprep⟩ := ih (by omega)
    have hgood : IsGoodDatumI N n X ℜ := ⟨hX, ℜ.2, hn.le⟩
    obtain ⟨hgood', hU'⟩ := IsGoodDatumI.succession_open g hgood hU hperm
    have hk' : k < P.α := by omega
    set ℜ' := g.transformI ℜ with hℜ'
    by_cases hWe : ℜ'.W.pts = ∅
    · -- `W(s)` is empty: [(2)] is vacuous
      refine ⟨Y, g, hperm, hfin, fun i hi => ?_⟩
      by_cases hik : i.val < k
      · exact hprep i hik
      · intro U₀ _ W₁ hW₁
        obtain ⟨y, hy⟩ := Subscheme.nonempty_pts_of_mem_irreducibleComponents hW₁
        have := Subscheme.pts_subset_of_mem_irreducibleComponents hW₁ hy
        rw [hWe] at this
        exact absurd this (Set.notMem_empty y)
    · have hWne : ℜ'.W.pts.Nonempty := Set.nonempty_iff_ne_empty.mpr hWe
      have hWn : ℜ'.W.dim ≤ (n : WithBot ℕ∞) := hgood'.2.2
      obtain ⟨n', hn', hn'le⟩ := LocSucc.exists_nat_of_le (Subscheme.dim_ne_bot hWne) hWn
      have := hgood'.1.1
      have := hX.1
      -- a presentation of the transformed boundary with the transform of `E_k` first
      obtain ⟨α', hle, E', hE', hEq', hcs', -⟩ :=
        g.exists_presentation_transformI_tail hX.1 hX.2.1 P.E P.E_codimOne ℜ ℜ.2 P.E_union
          hperm.isPermissibleI Set.univ
      have hα0 : 0 < α' := lt_of_lt_of_le (Nat.lt_of_le_of_lt (Nat.zero_le k) hk') hle
      let z : Fin α' := ⟨0, hα0⟩
      let c : Fin α' := Fin.castLE hle ⟨k, hk'⟩
      let σ : Fin α' ≃ Fin α' := Equiv.swap z c
      let E'' : Fin α' → Subscheme Y := fun j => E' (σ j)
      have hE'' : ∀ j, (E'' j).IsNonsingularIrreducibleCodimOne := fun j => hE' _
      have hEu'' : ℜ'.E = Subscheme.unionFam E'' := by
        rw [hEq']
        exact (Subscheme.unionFam_comp_equiv σ E').symm
      have hz : E'' z = g.strictTransform (P.E ⟨k, hk'⟩) := by
        show E' (Equiv.swap z c z) = _
        rw [Equiv.swap_apply_left]
        exact hcs' ⟨k, hk'⟩
      have hNn' : n' < N := lt_of_le_of_lt hn'le hNn
      obtain ⟨Z, s₂, hperm₂, U'', ⟨V, hVo, hU''eq⟩, hsub, hres, hcomp⟩ :=
        exists_isPermissibleIOpen_isOpen_resolvedAt_of_unionFam (X := Y) N n' hgood'.1 hNn'
          (fun N'' n'' h1 h2 h3 => hI₁ N'' n'' h1 h2 (h3.trans hn'le))
          (fun n'' h => hI₂ n'' (lt_of_lt_of_le h hn'le))
          α' hα0 E'' hE'' ℜ' hgood'.2.1 hEu'' hn' (g.transformOpen U) hU'
      have hperm2 : (Restriction.opn U).IsPermissibleSucc (g.append s₂) ℜ :=
        (MonoidalSuccession.isPermissibleIOpen_append g s₂ ℜ U).mpr ⟨hperm, hperm₂⟩
      have hr : (Restriction.opn U).IsFor (ℜ : DatumI.Raw X) := hU
      refine ⟨Z, g.append s₂, hperm2, hfin.append s₂ hgood hr hperm2, fun i hi => ?_⟩
      by_cases hik : i.val < k
      · exact (hprep i hik).append s₂ hgood hr hperm2
      · have hieq : i = ⟨k, hk'⟩ := Fin.ext (show i.val = k by omega)
        subst hieq
        intro U₀ _ W₁ hW₁
        rw [MonoidalSuccession.transformI_append] at hW₁
        rw [MonoidalSuccession.strictTransform_append, ← hz]
        rcases hcomp W₁ hW₁ with hc | hsubU
        · exact Or.inl hc
        · right
          refine Set.eq_empty_iff_forall_notMem.mpr fun y ⟨⟨hyE, hyW⟩, hyS⟩ => ?_
          have hyU : y ∈ U'' := hsubU (Subscheme.mem_pts_inter_iff.mpr ⟨hyW, hyE⟩)
          have hres' := hres y hyU
          rw [MonoidalSuccession.transformI_append] at hyS
          exact hyS.2 hres'

/-- **The succession `g_s` of p. 307 exists** ([(1)] and [(2)] of the proof of Theorems A*, B*):
"First of all, by Localization Theorems (Propositions 1 and 2 of §1, Ch. IV) and Preparation
Theorem (Proposition 5 of §2, Ch. IV), we can find a permissible succession of monoidal
transformations `g_s = {f_t : X_{t+1} → X_t}` (`0 ≤ t < s`) such that ... [(1)] the image in
`X = X_0` of `S(ℜ(s))` ... consists of a finite number of points, at which `X` has dimension `N`,
[(2)] for the case in which `ℜ = (ℜ^{N,n}_I, U)`, if `W_1(s)` is any irreducible component of
`W(s)` and if `i` is any integer such that `1 ≤ i ≤ α`, then either `W_1(s) ⊆ E_i(s)` or
`E_i(s) ∩ W_1(s) ∩ S(ℜ(s))` is empty.  (For [(2)], we apply Preparation Theorem `α` times
repeatedly.)"  Closed case: Proposition 1; open case: Proposition 2, then Proposition 5 `α`
times.  The hypotheses are those of Propositions 1, 2, 5 (each implied by those of Theorems A*, B*).

\textbf{Deviation from the paper (gap filled).} The paper does not say how the `α` applications of
the Preparation Theorem are combined: Lean chooses, at the `k`th application, a presentation of the
transformed boundary which has the transform of `E_k` first, and proves that [(1)] and the condition
[(2)] for the earlier `E_i` persist along the further successions (`HasFiniteImageOfDimEq.append`,
`IsPreparedAt.append`, which uses that a component of the strict transform of `W` lies over a
component of `W`, blueprint `lem:IV.3-components-strict-transform`). -/
@[blueprint "lem:IV.3-conditions-exist"
  (statement := /-- Let $X$, $N>n$ and the Theorems $\mathrm I_1$, $\mathrm I_2$ be as in
    \cref{prop:IV.1-1}, \cref{prop:IV.1-2}, \cref{prop:IV.2-5} (they follow from the assumptions of
    Theorems A and B), $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},F)$ (resp.\
    $(\mathfrak R^{N,n}_{\mathrm I},U)$) with $\mathfrak R^{N,n}_{\mathrm I}=(\bigcup_{i=1}^\alpha
    E_i;V_1,\dots,V_\beta;W)$.
    There is a permissible succession $g\colon X'\to X$ of monoidal transformations of $X$ for
    $\mathfrak R$ such that [(1)] the image in $X$ of $S(g^*\mathfrak R)$ consists of a finite
    number of points at which $X$ has dimension $N$ and, in the open case, [(2)] if $W_1'$ is any
    irreducible component of $W'$ and $1\le i\le\alpha$ then either $W_1'\subseteq E_i'$ or
    $E_i'\cap W_1'\cap S(g^*\mathfrak R)=\emptyset$ (\cref{def:IV.3-conditions}). -/)
  (proof := /-- Closed case: \cref{prop:IV.1-1}. Open case: \cref{prop:IV.1-2} gives [(1)]; then
    apply the Preparation Theorem (\cref{prop:IV.2-5}) successively to $E_1,\dots,E_\alpha$: at the
    $k$th step to the transform of the datum, with the transform of $E_k$ as the first member of a
    presentation of the transformed boundary; the property [(1)] and the property [(2)] for $E_i$,
    $i<k$, are stable under permissible extensions
    (\cref{lem:IV.3-image-S-append}, \cref{lem:IV.3-prepared-append}).

    \textbf{Deviation from the paper (gap filled).} ``For [(2)], we apply Preparation Theorem
    $\alpha$ times repeatedly'' (p.~307) does not say how the applications are combined. -/)
  (proofUses := ["prop:IV.1-1", "prop:IV.1-2", "prop:IV.2-5", "lem:IV.3-image-S-append",
    "lem:IV.3-prepared-append"])
  (latexEnv := "lemma")]
theorem exists_isPermissibleSucc_hasFiniteImageOfDimEq_and_hasPreparedBoundary [Hironaka.HironakaCitedResults.{u}] (N n : ℕ)
    (hNn : n < N)
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' ≤ N → n' ≤ n → FundamentalTheorem.I₁.{u} N' n')
    (hI₂' : ∀ N' n' : ℕ, n' < N' → N' < N → n' ≤ n → FundamentalTheorem.I₂.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X)
    (P : DatumI.Presentation (ℜ : DatumI.Raw X)) (r : Restriction X)
    (hr : r.IsFor (ℜ : DatumI.Raw X)) (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞)) :
    ∃ (Y : Scheme.{u}) (g : MonoidalSuccession X Y),
      r.IsPermissibleSucc g ℜ ∧ HasFiniteImageOfDimEq N ℜ r g ∧ HasPreparedBoundary P r g := by
  cases r with
  | closed F =>
    obtain ⟨Y, g, hg, hfin⟩ := exists_isPermissibleIClosed_hasFiniteImageOfDimEq N n hNn
      (fun N' n' h1 h2 h3 => hI₁ N' n' h1 h2.le h3) hI₂ X hX ℜ
      ⟨P.α, P.E, P.E_codimOne, P.E_union⟩ F hr hn
    exact ⟨Y, g, hg, hfin, fun i U hU => nomatch hU⟩
  | opn U =>
    obtain ⟨Y, g, hg, hfin, hprep⟩ :=
      exists_isPermissibleIOpen_hasFiniteImageOfDimEq_and_isPreparedAt_lt N n hNn hI₁ hI₂' hI₂ X
        hX ℜ P U hr hn P.α le_rfl
    exact ⟨Y, g, hg, hfin, fun i => hprep i i.2⟩

/-- `PrepHyp` is [(1)], [(2)] and the choice of `x_0` in the image. -/
theorem prepHyp_iff_hasFiniteImageOfDimEq_and_hasPreparedBoundary {N : ℕ} {X : Scheme.{u}}
    {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X} {T : Tower X} {x₀ : X}
    {s : ℕ} :
    PrepHyp N ℜ P r T x₀ s ↔ HasFiniteImageOfDimEq N ℜ r (T.pre s) ∧
      HasPreparedBoundary P r (T.pre s) ∧
      x₀ ∈ (T.pre s).composite.base '' S ((T.pre s).transformI ℜ) (r.transformSucc (T.pre s)) :=
  ⟨fun ⟨h1, h2, h3, h4⟩ => ⟨⟨h1, h2⟩, fun i U hU W₁ hW₁ => h3 U hU W₁ hW₁ i, h4⟩,
    fun ⟨⟨h1, h2⟩, h3, h4⟩ => ⟨h1, h2, fun U hU W₁ hW₁ i => h3 i U hU W₁ hW₁, h4⟩⟩


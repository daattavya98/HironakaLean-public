variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

/-- Stage `0` of the transversality (p. 308: `W_s ⊄ E_s`): `X̄_0 = V(z_0)` is not contained in the
boundary `⋃ Ê_i(0)` of the model datum.  In the closed case this is where `hFE` is used: `X̄_0` is
the total transform of `F`, and `F ⊆ E_i` is excluded (faithful flatness of `c_0` at `x̂_0`). -/
theorem not_subset_modelDatum_E_zero [Hironaka.HironakaCitedResults.{u}]
    (hFE : ∀ F, r = .closed F → ∀ i : Fin P.α, ¬ F.pts ⊆ (P.E i).pts)
    (hne : (𝒮.xBar 0).pts.Nonempty) :
    ¬ (𝒮.xBar 0).pts ⊆ 𝒮.modelDatum.E.pts := by
  cases r with
  | opn U =>
    rw [𝒮.modelDatum_E_open rfl, Subscheme.pts_empty]
    intro h
    obtain ⟨x, hx⟩ := hne
    exact h hx
  | closed F =>
    intro hsub
    rw [𝒮.modelDatum_E_closed rfl] at hsub
    have hsub' : (vZ X x₀ 𝒮.z).pts ⊆ (⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j).pts := hsub
    replace hsub' := hsub'.trans (Subscheme.pts_iInf (Z := 𝒮.tHat.X 0)
      (fun j : Fin (P.α + 0) => 𝒮.eHat 0 j)).le
    have hirr := 𝒮.isIrreducible_pts_vZ
    have hcl : IsClosed (vZ X x₀ 𝒮.z).pts := (vZ X x₀ 𝒮.z).support.isClosed
    have hη : closure {hirr.genericPoint} = (vZ X x₀ 𝒮.z).pts := hirr.closure_genericPoint hcl
    have hηW : hirr.genericPoint ∈ (vZ X x₀ 𝒮.z).pts := hη.le (subset_closure rfl)
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (hsub' hηW)
    have hsubj : (vZ X x₀ 𝒮.z).pts ⊆ (𝒮.eHat 0 j).pts := by
      rw [← hη]
      exact closure_minimal (Set.singleton_subset_iff.mpr hj) (𝒮.eHat 0 j).support.isClosed
    let xh : 𝒮.tHat.X 0 := hS.xh
    have hle := DatumTransform.stalkIdeal_le_of_pts_subset (X := 𝒮.tHat.X 0) 𝒮.isReduced_vZ
      hsubj xh
    have hv : vZ X x₀ 𝒮.z = Subscheme.totalTransform (𝒮.c 0) F :=
      𝒮.xBar_eq_totalTransform_of_closed 0 F rfl
    rw [hv] at hle
    unfold eHat at hle
    have e2 : (Subscheme.totalTransform (𝒮.c 0) (F : Subscheme (T.X 0))).stalkIdeal xh =
        ((F : Subscheme (T.X 0)).stalkIdeal ((𝒮.c 0).base xh)).map
          ((𝒮.c 0).stalkMap xh).hom := stalkIdeal_totalTransform _ _ _
    rw [stalkIdeal_totalTransform, e2] at hle
    obtain ⟨hreg, hα⟩ := 𝒮.isRegularLocalRing_and_mapsRSOP_stalkMap_c 0 xh rfl
    have : IsRegularLocalRing ((T.X 0).presheaf.stalk ((𝒮.c 0).base xh)) := hS.isNonsingular_X 0 _
    have hloc : IsLocalHom ((𝒮.c 0).stalkMap xh).hom := inferInstance
    have hle' : (T.Esys P.E 0 j).stalkIdeal ((𝒮.c 0).base hS.xh) ≤
        F.stalkIdeal ((𝒮.c 0).base hS.xh) := hα.le_of_map_le_map hle
    have hFr : F.IsNonsingularIrreducibleCodimOne := by
      have := hS.isFor; exact this.1
    have hFx : x₀ ∈ F.pts := hS.mem_pts_closed_x₀ rfl
    have hFirr : _root_.IsIrreducible F.pts := by
      rcases hFr with h | ⟨-, h, -⟩
      · rw [h, Subscheme.pts_empty] at hFx; exact hFx.elim
      · exact Subscheme.isIrreducible_pts F h
    exact Subscheme.not_stalkIdeal_le_of_isIrreducible_not_subset hFirr
      (hFE F rfl j) (le_rfl : (T.Esys P.E 0 j).pts ⊆ (T.Esys P.E 0 j).pts) (by
        rw [𝒮.c_zero_base_xh]; exact hFx) hle'

/-- **Transversality along `ĝ_s`** (p. 308: "`W_s ⊄ E_s`"): if `X̄_s` is non-empty then it is not
contained in the boundary of the transform of the model datum.  Induction on `s`: the strict
transform of an irreducible `W ⊄ E`, `W ⊄ B` is not contained in `E' ∪ E_exc`. -/
@[blueprint "lem:IV.3-rem2-transversal"
  (statement := /-- In the situation of \cref{lem:IV.3-rem2-model-boundary}, if $\bar X_s$ is non-empty
    then $\bar X_s$ is not contained in the boundary $E_s$ of $\hat{\mathfrak R}_s$ (that is,
    $W_s\not\subseteq E_s$). In the closed case this uses that $F$ is contained in none of the $E_i$. -/)
  (proof := /-- Induction on $s$. The strict transform of an irreducible $W\not\subseteq E$ with
    $W\not\subseteq B$ is not contained in $E'\cup E_{\mathrm{exc}}$, since a point of $W-(E\cup B)$
    lifts to $W'$ off the exceptional divisor; $\bar X_s$ is irreducible, and $\bar X_{s+1}\neq\emptyset$
    forces $\bar X_s\not\subseteq\hat B_s$. For $s=0$ in the closed case, $\bar X_0=c_0^{-1}(F)$ and
    $c_0^{-1}(F)\subseteq c_0^{-1}(E_i)$ would give $F\subseteq E_i$ near $x_0$ by faithful
    flatness of $c_0$ at $\hat x_0$, hence $F\subseteq E_i$ since $F$ is irreducible, excluded by
    the hypothesis; in the open case $E_0=\emptyset$.
    \textbf{Deviation from the paper (gap filled).} Used silently in ``we see that
    $\tilde E_1,\dots,\tilde E_{\tilde\alpha}$ are non-singular \dots\ subschemes of $\bar X'_s$ of
    codimension 1'' (p.~308); false without the hypothesis on $F$. -/)
  (latexEnv := "lemma")]
theorem not_subset_transformI_modelDatum_E [Hironaka.HironakaCitedResults.{u}]
    (hFE : ∀ F, r = .closed F → ∀ i : Fin P.α, ¬ F.pts ⊆ (P.E i).pts) :
    ∀ s : ℕ, (𝒮.xBar s).pts.Nonempty →
      ¬ (𝒮.xBar s).pts ⊆ ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).E.pts
  | 0 => fun hne => 𝒮.not_subset_modelDatum_E_zero hFE hne
  | s + 1 => fun hne => by
    have e : (𝒮.tHat.pre (s + 1)).transformI 𝒮.modelDatum =
        ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).transform
          (𝒮.tHat.monoidalTransformation s) :=
      MonoidalSuccession.transformI_snoc _ _ _ _
    have hne1 : (Subscheme.strictTransform (𝒮.tHat.monoidalTransformation s)
        (𝒮.xBar s)).pts.Nonempty := hne
    have hne' : (𝒮.xBar s).pts.Nonempty :=
      (𝒮.tHat.monoidalTransformation s).pts_nonempty_of_strictTransform _ hne1
    have ih := not_subset_transformI_modelDatum_E hFE s hne'
    have hirr : _root_.IsIrreducible (𝒮.xBar s).pts :=
      Subscheme.isIrreducible_pts _ (Frame.RemovalFamily.isIrreducible_xBar_of_isIrreducible_zero
        (𝒮 := 𝒮) (fun _ => 𝒮.xBar_zero_isNonsingular_and_isIrreducible.2) s hne')
    have hWB : ¬ (𝒮.xBar s).pts ⊆ (𝒮.tHat.B s).pts := fun h => by
      have h0 := (𝒮.tHat.monoidalTransformation s).pts_strictTransform_eq_empty_of_subset _ h
      rw [h0] at hne1
      exact Set.not_nonempty_empty hne1
    rw [e]
    exact (𝒮.tHat.monoidalTransformation s).not_pts_strictTransform_subset_strictTransform_inf_exceptional
      hirr ih hWB

end Frame


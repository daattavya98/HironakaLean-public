/-!
# Ch. IV §3 (pp. 307–310): the prepared succession `g_s`, and Remarks 1 and 2

The prepared succession `g_s` with [(1)], [(2)] and the point `x_0`, Remarks 1 and 2 and the objects of
p. 308 (`X̃`, `Ẽ_j`, the datum `ℜ^{N-1}_II`) (pp. 307–310), the gap fills `J̃ ≠ 0` and `X̃` ambient of
dimension `N - 1`, the repair on the subschemes `Ẽ_j`, the stability of the properties (i), (ii) of
Theorems A*, B* under permissible extensions, and the existence of the succession `g_s` of p. 307.

This is part 3 of 3 of `Hironaka.Ch4.ImplicationsAB`, which imports all parts; its description holds the
notation and the formalization notes for the whole section.
-/

@[expose] public section

open AlgebraicGeometry IsLocalRing CategoryTheory CategoryTheory.Limits

open scoped TensorProduct

namespace Hironaka

universe u

noncomputable section

namespace AB

/-! ## The prepared succession `g_s` and Remarks 1–5 (pp. 307–310) -/

/-- p. 307: the conditions [(1)], [(2)] on the succession `g_s = {f_t}_{0 ≤ t < s}` (the initial
segment of the tower), and the choice of `x_0` in `g_s(S(ℜ(s)))`. -/
@[blueprint "def:IV.3-conditions"
  (statement := /-- ``First of all, by Localization Theorems (Propositions 1 and 2 of \S1,
    Ch.~IV, \cref{prop:IV.1-1}, \cref{prop:IV.1-2}) and Preparation Theorem (Proposition 5 of
    \S2, Ch.~IV, \cref{prop:IV.2-5}), we can find a permissible succession of monoidal
    transformations $g_s=\{f_t\colon X_{t+1}\to X_t\}$ $(0\le t<s)$ such that, the notations
    $\mathfrak R(s)$ $(=$ either $(\mathfrak R^{N,n}_{\mathrm I}(s),F(s))$ or
    $(\mathfrak R^{N,n}_{\mathrm I}(s),U(s)))$, and $\mathfrak R^{N,n}_{\mathrm I}(s)=
    (\bigcup_{i=1}^{\alpha+s}E_i(s);V_1(s),\dots,V_\beta(s);W(s))$ being as above, we have
    [(1)] the image in $X=X_0$ of $S(\mathfrak R(s))$ ($=$ either $F(s)\cap W(s)$ or the closed
    subset of $W(s)$ of those points at which $\mathfrak R(s)$ is not resolved) consists of a
    finite number of points, at which $X$ has dimension $N$, [(2)] for the case in which
    $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},U)$, if $W_1(s)$ is any irreducible component
    of $W(s)$ and if $i$ is any integer such that $1\le i\le\alpha$, then either
    $W_1(s)\subseteq E_i(s)$ or $E_i(s)\cap W_1(s)\cap S(\mathfrak R(s))$ is empty. (For
    [(2)], we apply Preparation Theorem $\alpha$ times repeatedly.) Let $x_0$ be any point of
    $X$ which is in the image $g_s(S(\mathfrak R(s)))$'' (p.~307, \cref{def:IV.3-succession},
    \cref{def:IV.3-S}). (Formalization note (encoding): $g_s$ is the initial segment of the succession
    of \cref{def:IV.3-succession}; the conditions [(1)], [(2)] and $x_0\in
    g_s(S(\mathfrak R(s)))$ are the hypotheses of Remarks 1--5; the existence of such a $g_s$
    is part of the proofs of Theorems A* and B*.) -/)
  (latexEnv := "definition")]
def PrepHyp (N : ℕ) {X : Scheme.{u}} (ℜ : DatumI.Raw X) (P : DatumI.Presentation ℜ)
    (r : Restriction X) (T : Tower X) (x₀ : X) (s : ℕ) : Prop :=
  ((T.pre s).composite.base '' S ((T.pre s).transformI ℜ) (r.transformSucc (T.pre s))).Finite ∧
  (∀ y ∈ (T.pre s).composite.base '' S ((T.pre s).transformI ℜ) (r.transformSucc (T.pre s)),
    X.dimAt y = (N : WithBot ℕ∞)) ∧
  (∀ U, r = .opn U → ∀ W₁ ∈ ((T.pre s).transformI ℜ).W.irreducibleComponents,
    ∀ i : Fin P.α, W₁.IsContainedIn ((T.pre s).strictTransform (P.E i)) ∨
      ((T.pre s).strictTransform (P.E i)).pts ∩ W₁.pts ∩
        S ((T.pre s).transformI ℜ) (r.transformSucc (T.pre s)) = ∅) ∧
  x₀ ∈ (T.pre s).composite.base '' S ((T.pre s).transformI ℜ) (r.transformSucc (T.pre s))

/-- The empty boundary has only normal crossings with `W` at a simple point `x` of `W`: the ideal
of `W` at `x` is generated by part of a regular system of parameters
(`exists_finset_span_eq_prime`).  (Used for Remark 1, p. 307: the datum `(∅; V_1, …, V_β; W)` is
resolved at a point where `W` is simple and the `V_j` are normally flat along `W`.) -/
theorem _root_.Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_empty {X : Scheme.{u}} {x : X}
    (hX : X.IsSimpleAt x) {W : Subscheme X} (hW : W.IsSimpleAt x) :
    Subscheme.empty.HasOnlyNormalCrossingsWithAt W x := by
  classical
  have : IsRegularLocalRing (X.presheaf.stalk x) := hX
  have hreg : IsRegularLocalRing (X.presheaf.stalk x ⧸ W.stalkIdeal x) := hW.2
  have : IsDomain (X.presheaf.stalk x ⧸ W.stalkIdeal x) :=
    Transforms.isDomain_of_isRegularLocalRing _
  have hP : (W.stalkIdeal x).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp this
  obtain ⟨S, T, hS, hScard, hTS, hT⟩ := exists_finset_span_eq_prime _ (W.stalkIdeal x) hreg
  refine ⟨S, ⟨hS, by rw [hScard]; exact IsRegularLocalRing.spanFinrank_maximalIdeal⟩,
    fun C hC hxC => ?_, T, hTS, hT.symm⟩
  have := Subscheme.pts_subset_of_mem_irreducibleComponents hC hxC
  rw [Subscheme.pts_empty] at this
  exact this.elim

/-- **Remark 1** (p. 307): "For the case in which `ℜ = (ℜ^{N,n}_I, U)`, either `W` is singular at
`x_0` or at least one of the `V_j` (`1 ≤ j ≤ β`) is not normally flat along `W` at `x_0`. In fact,
if otherwise, for every point `x` of `W(s)` with `g_s(x) = x_0`, `x` is simple point of `W(s)`
and all the `V_j(s)` (`1 ≤ j ≤ β`) are normally flat along `W(s)` at `x`. Moreover, by Lemma 4,
§ 2, `⋃_{i=α+1}^{α+s} E_i(s)` has only normal crossings with `W(s)` at `x`, and therefore, by
[(2)], `⋃_{i=1}^{α+s} E_i(s)` has only normal crossings with `W(s)` at `x`. Hence
`x ∉ S(ℜ(s))`. This contradicts the assumption: `x_0 ∈ g_s(S(ℜ(s)))`."

\textbf{Deviation from the paper (gap filled).} The first two steps are carried out together
through the datum `(∅; V_1, …, V_β; W)`, resolved at `x_0` (`W` simple, the `V_j` normally flat,
and the empty boundary has normal crossings with `W`:
`Subscheme.hasOnlyNormalCrossingsWithAt_empty`), whose transform along `g_s` has boundary
`⋃_{i=α+1}^{α+s} E_i(s)` and is resolved at `x` (`MonoidalSuccession.resolvedAt_transformI_tail`
of `Preparation.lean`: Corollary 2 of Theorem 5, Ch. III and Lemma 4, § 2,
`lem:IV.2-4`, itself, applied on a neighbourhood of each point where its hypotheses hold, as the citation
implicitly does (`DatumI.Raw.hasOnlyNormalCrossingsWithAt_transform_of_resolvedAt_localized`, see
`lem:IV.AB-1`), iterated along the succession; the paper gives no reference for the simplicity and
normal flatness at `x`, and Corollary 2 does not state the simplicity of `W(s)`).  The step "by [(2)]" is spelled out: the
component `W_1(s)` of `W(s)` through `x` has the stalk of `W(s)` at `x` (`W(s)` is simple there),
so by [(2)] each `E_i(s)`, `i ≤ α`, contains `W(s)` near `x` or misses `x`; these components are
added one at a time by Lemma 3, § 2 in pointwise form
(`Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_of_stalkIdeal_le`,
`Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_of_stalkIdeal_eq_top`), using that `E(s)` has
only normal crossings at `x` (`ℜ(s)` is a datum) and the presentation of `E(s)` by
`E_1(s), …, E_{α+s}(s)` (`MonoidalSuccession.exists_presentation_transformI_tail`). -/
@[blueprint "rem:IV.3-1"
  (statement := /-- \textbf{Remark 1.} Let $g_s$ and $x_0\in g_s(S(\mathfrak R(s)))$ be as in
    \cref{def:IV.3-conditions}. For the case in which
    $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},U)$, either $W$ is singular at $x_0$ or at
    least one of the $V_j$ $(1\le j\le\beta)$ is not normally flat along $W$ at $x_0$
    (\cref{def:0.1-normally-flat-at}). (p.~307.) -/)
  (proof := /-- In fact, if otherwise, for every point $x$ of $W(s)$ with $g_s(x)=x_0$, $x$
    is a simple point of $W(s)$ and all the $V_j(s)$ $(1\le j\le\beta)$ are normally flat along
    $W(s)$ at $x$ (\cref{cor:III.thm5-2}). Moreover, by Lemma~4, \S2 (\cref{lem:IV.2-4}),
    $\bigcup_{i=\alpha+1}^{\alpha+s}E_i(s)$ has only normal crossings with $W(s)$ at $x$, and
    therefore, by [(2)], $\bigcup_{i=1}^{\alpha+s}E_i(s)$ has only normal crossings with $W(s)$
    at $x$ (\cref{lem:IV.2-3}). Hence $x\notin S(\mathfrak R(s))$. This contradicts the
    assumption $x_0\in g_s(S(\mathfrak R(s)))$.

    \textbf{Deviation from the paper (gap filled).} The paper gives no reference for the
    simplicity of $W(s)$ and the normal flatness of the $V_j(s)$ at $x$, and Corollary~2 of
    Theorem~5 (\cref{cor:III.thm5-2}) gives only the normal flatness. Lean obtains both, together
    with the normal crossings of $\bigcup_{i=\alpha+1}^{\alpha+s}E_i(s)$ with $W(s)$ at $x$, from
    the datum $(\emptyset;V_1,\dots,V_\beta;W)$, which is resolved at $x_0$ (the empty boundary
    has normal crossings with $W$ at a simple point) and whose transform along $g_s$ has the
    boundary $\bigcup_{i=\alpha+1}^{\alpha+s}E_i(s)$; Corollary~2 and Lemma~4 (the latter itself,
    applied on a neighbourhood of the point on which its hypotheses hold, the implicit localization of
    the citation, as in \cref{lem:IV.AB-1}) are iterated along the succession for it. ``By [(2)]'' is spelled out: the irreducible component $W_1(s)$ of
    $W(s)$ through $x$ has the local ring of $W(s)$ at $x$ ($W(s)$ is simple there), so each
    $E_i(s)$, $i\le\alpha$, contains $W(s)$ near $x$ or does not pass through $x$; these are added
    one at a time by Lemma~3 in pointwise form, using that $E(s)=\bigcup_{i=1}^{\alpha+s}E_i(s)$
    has only normal crossings at $x$. -/)
  (proofUses := ["cor:III.thm5-2", "lem:IV.2-4", "lem:IV.2-3"])
  (latexEnv := "remark")]
theorem Standing.not_isSimpleAt_or_exists_not_isNormallyFlatAlongAt_of_prepHyp [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} {T : Tower X} {x₀ : X} (hS : Standing N n ℜ P r T x₀) (s : ℕ)
    (U : Set X) (hU : r = .opn U) (hprep : PrepHyp N ℜ P r T x₀ s) :
    ¬ ℜ.W.IsSimpleAt x₀ ∨ ∃ j, ¬ Subscheme.IsNormallyFlatAlongAt' (ℜ.V j) ℜ.W x₀ := by
  classical
  subst hU
  by_contra hcon
  push Not at hcon
  obtain ⟨hWx₀, hNFx₀⟩ := hcon
  -- a point `x` of `S(ℜ(s))` over `x₀`: `W(s)` passes through `x` and `ℜ(s)` is not resolved there
  obtain ⟨x, hxS, hgx⟩ := hprep.2.2.2
  have hxS' : x ∈ ((T.pre s).transformI ℜ).unresolvedSet := hxS
  obtain ⟨hxW, hnres⟩ := hxS'
  apply hnres
  have := hS.ambient.1
  have hX := hS.isNonsingular_X s
  have hgood : IsGoodDatumI N n X ℜ := ⟨hS.ambient, hS.isDatum, hS.dim_W.le⟩
  have hUr : ℜ.IsOpenRestriction U := hS.isFor
  have hs : (T.pre s).IsPermissibleIOpen ℜ U := hS.permissible s
  have hEu : ℜ.E = Subscheme.unionFam P.E := P.E_union
  -- the datum `(∅; V_1, …, V_β; W)`: its transform has the exceptional divisors as boundary
  let J : Set (Fin P.α) := ∅
  have hres0 : ({ ℜ with E := Subscheme.unionFam (fun i : J => P.E i) } :
      DatumI.Raw X).ResolvedAt ((T.pre s).composite.base x) := by
    rw [hgx]
    refine ⟨hWx₀, hNFx₀, ?_⟩
    show (Subscheme.unionFam (fun i : J => P.E i)).HasOnlyNormalCrossingsWithAt ℜ.W x₀
    rw [Subscheme.unionFam_of_isEmpty]
    exact Subscheme.hasOnlyNormalCrossingsWithAt_empty (hS.ambient.2.1 x₀) hWx₀
  have hrs := MonoidalSuccession.resolvedAt_transformI_tail (T.pre s) P.E P.E_codimOne hgood
    hEu hUr hs J hxW hres0
  obtain ⟨α', hα', E', hE', hEq', hcs, J', hJ1, hJ2, hJ3, -⟩ :=
    (T.pre s).exists_presentation_transformI_tail hS.ambient.1 hS.ambient.2.1 P.E P.E_codimOne ℜ
      hS.isDatum hEu hs.isPermissibleI J
  rw [MonoidalSuccession.transformI_withE] at hrs
  obtain ⟨hWs, hNFs, hNCexc⟩ := hrs
  set W' := ((T.pre s).transformI ℜ).W with hW'
  have hNCexc' : (Subscheme.unionFam (fun j : J' => E' j)).HasOnlyNormalCrossingsWithAt W' x := by
    rw [← hJ3]
    exact hNCexc
  refine ⟨hWs, hNFs, ?_⟩
  rw [hEq']
  -- `E(s)` has only normal crossings at `x` (`ℜ(s)` is a datum)
  have hEall : (Subscheme.unionFam E').HasOnlyNormalCrossingsAt x := by
    have h := (MonoidalSuccession.transformI_isDatum (T.pre s) hS.ambient.2.1 ℜ hS.isDatum
      hs.isPermissibleI).2.2.1 x
    rwa [hEq'] at h
  -- [(2)]: each original `E_i(s)` contains `W(s)` near `x` or misses `x`
  obtain ⟨W₁, hW₁, hxW₁⟩ := Subscheme.exists_mem_irreducibleComponents_of_mem_pts W' hxW
  have hW₁x : W₁.stalkIdeal x = W'.stalkIdeal x := by
    have : IsRegularLocalRing ((T.X s).presheaf.stalk x) := hX x
    have : IsRegularLocalRing ((T.X s).presheaf.stalk x ⧸ W'.stalkIdeal x) := hWs.2
    have : IsDomain ((T.X s).presheaf.stalk x ⧸ W'.stalkIdeal x) :=
      Transforms.isDomain_of_isRegularLocalRing _
    have hP : (W'.stalkIdeal x).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp this
    have hq := Subscheme.stalkIdeal_mem_minimalPrimes hW₁ hxW₁
    exact le_antisymm (hq.2 ⟨hP, le_rfl⟩ hq.1.2) hq.1.2
  have horig : ∀ i : Fin P.α,
      ((T.pre s).strictTransform (P.E i)).stalkIdeal x ≤ W'.stalkIdeal x ∨
        ((T.pre s).strictTransform (P.E i)).stalkIdeal x = ⊤ := by
    intro i
    rcases hprep.2.2.1 U rfl W₁ hW₁ i with hc | hempty
    · left
      rw [← hW₁x]
      exact Subscheme.stalkIdeal_mono (fun V => hc V) x
    · right
      refine Subscheme.stalkIdeal_eq_top_of_notMem_pts fun hxE => ?_
      have hmem : x ∈ ((T.pre s).strictTransform (P.E i)).pts ∩ W₁.pts ∩
          S ((T.pre s).transformI ℜ) ((Restriction.opn U).transformSucc (T.pre s)) :=
        ⟨⟨hxE, hxW₁⟩, hxS⟩
      rw [hempty] at hmem
      exact hmem
  -- adding the original components one at a time (Lemma 3, pointwise)
  have key : ∀ k, k ≤ P.α → (Subscheme.unionFam (fun j : {j : Fin α' // P.α ≤ j.val ∨ j.val < k} =>
      E' j.1)).HasOnlyNormalCrossingsWithAt W' x := by
    intro k
    induction k with
    | zero =>
      intro _
      exact Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_comp hX (fun j : J' => E' j)
        (fun j => hE' j) (fun j : {j : Fin α' // P.α ≤ j.val ∨ j.val < 0} =>
          (⟨j.1, hJ2 j.1 (j.2.resolve_right (Nat.not_lt_zero _))⟩ : J')) hNCexc'
    | succ k ih =>
      intro hk
      have ihk := ih (by omega)
      let I := {j : Fin α' // P.α ≤ j.val ∨ j.val < k + 1}
      let eqv := Fintype.equivFin I
      let G : Fin (Fintype.card I) → Subscheme (T.X s) := fun a => E' (eqv.symm a).1
      have hG : ∀ a, (G a).IsNonsingularIrreducibleCodimOne := fun a => hE' _
      let jk : Fin α' := Fin.castLE hα' ⟨k, by omega⟩
      have hjk : (jk : ℕ) = k := rfl
      let i₀ : Fin (Fintype.card I) := eqv ⟨jk, Or.inr (by omega)⟩
      have hGi₀ : G i₀ = (T.pre s).strictTransform (P.E ⟨k, by omega⟩) := by
        show E' (eqv.symm (eqv _)).1 = _
        rw [Equiv.symm_apply_apply]
        exact hcs _
      have hred : (Subscheme.unionFam G).IsReduced := Subscheme.isReduced_unionFam G hG
      have hi : (Subscheme.unionFam G).HasOnlyNormalCrossingsAt x :=
        Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_comp hX E' hE'
          (fun a => (eqv.symm a).1) hEall
      have hrest : (prepERest G i₀).HasOnlyNormalCrossingsWithAt W' x := by
        refine Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_comp hX
          (fun j : {j : Fin α' // P.α ≤ j.val ∨ j.val < k} => E' j.1) (fun j => hE' _)
          (fun i : {i // G i ≠ G i₀} => (⟨(eqv.symm i.1).1, ?_⟩ :
            {j : Fin α' // P.α ≤ j.val ∨ j.val < k})) ihk
        rcases (eqv.symm i.1).2 with h | h
        · exact Or.inl h
        · refine Or.inr (lt_of_le_of_ne (Nat.lt_succ_iff.mp h) fun hkk => i.2 ?_)
          have : (eqv.symm i.1).1 = jk := Fin.ext (by rw [hjk]; exact hkk)
          show E' (eqv.symm i.1).1 = E' (eqv.symm i₀).1
          rw [this, Equiv.symm_apply_apply]
      have hG' : (Subscheme.unionFam G).HasOnlyNormalCrossingsWithAt W' x := by
        rcases horig ⟨k, by omega⟩ with hz | htop
        · exact Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_of_stalkIdeal_le hX G hG i₀ hred
            hxW hi hrest (by rw [hGi₀]; exact hz)
        · exact Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_of_stalkIdeal_eq_top hX G hG i₀
            hred hrest (by rw [hGi₀]; exact htop)
      have := Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_comp hX G hG (fun j : I => eqv j) hG'
      simpa only [G, Equiv.symm_apply_apply] using this
  exact Subscheme.hasOnlyNormalCrossingsWithAt_unionFam_comp hX
    (fun j : {j : Fin α' // P.α ≤ j.val ∨ j.val < P.α} => E' j.1) (fun j => hE' _)
    (fun j : Fin α' => (⟨j, (le_or_gt P.α j.val)⟩ :
      {j : Fin α' // P.α ≤ j.val ∨ j.val < P.α})) (key P.α le_rfl)

namespace Frame

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X} {T : Tower X} {x₀ : X} {hS : Standing N n ℜ P r T x₀}
  (𝒮 : Frame hS)

/-- Remark 2 (p. 308): `Ẽ_j = Ê'_j(s) ∩ X̄'_s` with `Ê'_j(s) = c_s⁻¹(E_j(s)) ∩ X̂'_s`:
`1 ≤ j ≤ α + s` in the closed case, `Ẽ_j = Ê'_{α+j}(s) ∩ X̄'_s`, `1 ≤ j ≤ s`, in the open case.
As subschemes of `X̄_s`; their restrictions to `X̄'_s` are the paper's. -/
def eTilde (s : ℕ) : Σ m : ℕ, Fin m → Subscheme (𝒮.xBar s).toScheme :=
  match r with
  | .closed _ => ⟨P.α + s, fun j => Subscheme.totalTransform (𝒮.xBar s).ι
      (Subscheme.totalTransform (𝒮.c s) (T.Esys P.E s j))⟩
  | .opn _ => ⟨s, fun j => Subscheme.totalTransform (𝒮.xBar s).ι
      (Subscheme.totalTransform (𝒮.c s) (T.Esys P.E s (Fin.natAdd P.α j)))⟩

/-- `X̃ = X̄'_s` (p. 308), the open subscheme of `X̄_s`. -/
def xTilde (s : ℕ) : Scheme.{u} := (𝒮.xBarPrime s : Scheme.{u})

/-- The morphism `X̃ → X_s` induced by `c_s`. -/
def cTilde (s : ℕ) : 𝒮.xTilde s ⟶ T.X s := (𝒮.xBarPrime s).ι ≫ 𝒮.cBar s

/-- `g̃ = ḡ'_s : X̃ → Spec(Ŝ) = X̂_0` (p. 309). -/
def gTilde (s : ℕ) : 𝒮.xTilde s ⟶ xHat0 X x₀ := (𝒮.xBarPrime s).ι ≫ (𝒮.xBar s).ι ≫ (𝒮.tHat.pre s).composite

/-- `J̄(s)` as a sheaf of ideals on `X̃ = X̄'_s`. -/
def jBarT (s : ℕ) : Subscheme (𝒮.xTilde s) := Subscheme.totalTransform (𝒮.xBarPrime s).ι (𝒮.jBar s)

/-- p. 308: the resolution datum `ℜ^{N-1}_II = (Ẽ_1, …, Ẽ_α̃ | J̃, b | a_1, …, a_α̃)` on `X̃`
(without restriction), for given `a_j` and `J̃`. -/
def datumII (s : ℕ) (a : Fin (𝒮.eTilde s).1 → ℕ) (Jt : Subscheme (𝒮.xTilde s)) :
    DatumII.Raw (𝒮.xTilde s) where
  α := (𝒮.eTilde s).1
  E := fun j => Subscheme.totalTransform (𝒮.xBarPrime s).ι ((𝒮.eTilde s).2 j)
  a := a
  J := Jt
  b := 𝒮.b

namespace RemovalFamily

variable {𝒮} (R : 𝒮.RemovalFamily)

/-- `X̃ = Ū_s = U_s ∩ X̄_s` (p. 308) for an open family with removals; for the printed family
this is `X̄'_s` (`Frame.xTilde`). -/
def xTilde (s : ℕ) : Scheme.{u} := (R.uBar s : Scheme.{u})

/-- The morphism `X̃ → X_s` induced by `c_s`. -/
def cTilde (s : ℕ) : R.xTilde s ⟶ T.X s := (R.uBar s).ι ≫ 𝒮.cBar s

/-- `g̃ : X̃ → Spec(Ŝ) = X̂_0` (p. 309). -/
def gTilde (s : ℕ) : R.xTilde s ⟶ xHat0 X x₀ :=
  (R.uBar s).ι ≫ (𝒮.xBar s).ι ≫ (𝒮.tHat.pre s).composite

/-- `J̄(s)` as a sheaf of ideals on `X̃ = Ū_s`. -/
def jBarT (s : ℕ) : Subscheme (R.xTilde s) := Subscheme.totalTransform (R.uBar s).ι (𝒮.jBar s)

/-- p. 308: the resolution datum `ℜ^{N-1}_II = (Ẽ_1, …, Ẽ_α̃ | J̃, b | a_1, …, a_α̃)` on
`X̃ = Ū_s` (without restriction), for given `a_j` and `J̃`. -/
def datumII (s : ℕ) (a : Fin (𝒮.eTilde s).1 → ℕ) (Jt : Subscheme (R.xTilde s)) :
    DatumII.Raw (R.xTilde s) where
  α := (𝒮.eTilde s).1
  E := fun j => Subscheme.totalTransform (R.uBar s).ι ((𝒮.eTilde s).2 j)
  a := a
  J := Jt
  b := 𝒮.b

end RemovalFamily

end Frame

section Rem2Generic

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X} {T : Tower X} {x₀ : X}

namespace Tower

theorem esys_succ_castSucc {α : ℕ} (E : Fin α → Subscheme X) (s : ℕ) (j : Fin (α + s)) :
    T.Esys E (s + 1) (Fin.castSucc j) =
      Subscheme.strictTransform (T.monoidalTransformation s) (T.Esys E s j) := by
  show Fin.snoc (α := fun _ => Subscheme (T.X (s + 1))) _ _ (Fin.castSucc j) = _
  exact Fin.snoc_castSucc _ _ _

theorem esys_succ_last {α : ℕ} (E : Fin α → Subscheme X) (s : ℕ) :
    T.Esys E (s + 1) (Fin.last (α + s)) = (T.monoidalTransformation s).exceptional := by
  show Fin.snoc (α := fun _ => Subscheme (T.X (s + 1))) _ _ (Fin.last (α + s)) = _
  exact Fin.snoc_last _ _

/-- The union of the divisors `E_j(s)` has the points of the boundary of `ℜ(s)`. -/
theorem pts_transformI_E_eq_iUnion_esys (ℜ : DatumI.Raw X) (P : DatumI.Presentation ℜ) (T : Tower X)
    (s : ℕ) : ((T.pre s).transformI ℜ).E.pts = ⋃ j : Fin (P.α + s), (T.Esys P.E s j).pts := by
  induction s with
  | zero =>
    show ℜ.E.pts = ⋃ j : Fin P.α, (P.E j).pts
    rw [P.E_union, Subscheme.pts_iInf]
  | succ s ih =>
    show ((MonoidalSuccession.snoc (T.pre s) (T.B s) (T.monoidalTransformation s)).transformI ℜ).E.pts
      = _
    rw [MonoidalSuccession.transformI_snoc]
    show (Subscheme.strictTransform (T.monoidalTransformation s)
      ((T.pre s).transformI ℜ).E ⊓ (T.monoidalTransformation s).exceptional).pts = _
    rw [Subscheme.pts_inf, MonoidalTransformation.pts_strictTransform_of_pts_eq_iUnion _ ih]
    refine Set.Subset.antisymm ?_ ?_
    · intro (x : T.X (s + 1)) hx
      rcases hx with hx | hx
      · obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hx
        exact Set.mem_iUnion.mpr ⟨Fin.castSucc j, by
          rw [esys_succ_castSucc (T := T) P.E s j]; exact hj⟩
      · exact Set.mem_iUnion.mpr ⟨Fin.last (P.α + s), by
          rw [esys_succ_last (T := T) P.E s]; exact hx⟩
    · intro (x : T.X (s + 1)) hx
      obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hx
      induction j using Fin.lastCases with
      | last =>
        right
        exact (Set.ext_iff.mp (congrArg Subscheme.pts (esys_succ_last (T := T) P.E s)) x).mp hj
      | cast i =>
        left
        exact Set.mem_iUnion.mpr ⟨i,
          (Set.ext_iff.mp (congrArg Subscheme.pts (esys_succ_castSucc (T := T) P.E s i)) x).mp hj⟩

end Tower

/-- The divisors `E_j(s)` are non-singular irreducible of codimension one and their union has only
normal crossings (Remark 1, p. 169, applied to the presentation `E_1(s), …, E_{α+s}(s)`). -/
theorem Standing.esys_isNonsingularIrreducibleCodimOne_and_hasOnlyNormalCrossings [Hironaka.HironakaCitedResults.{u}]
    {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
    (hS : Standing N n ℜ P r T x₀) (s : ℕ) :
    (∀ j, (T.Esys P.E s j).IsNonsingularIrreducibleCodimOne) ∧
      (⨅ j, T.Esys P.E s j).HasOnlyNormalCrossings := by
  induction s with
  | zero =>
    refine ⟨P.E_codimOne, ?_⟩
    have := hS.isDatum.2.2.1
    rw [P.E_union] at this
    exact this
  | succ s ih =>
    have := hS.isAlgebraicScheme_X s
    have hperm := isPermissible_transformI_of_isPermissibleI_snoc (T.pre s) (T.B s)
      (T.monoidalTransformation s) ℜ (hS.permissible (s + 1)).isPermissibleI
    have hNCB : (⨅ j, T.Esys P.E s j).HasOnlyNormalCrossingsWith (T.B s) := by
      intro x hx
      refine (Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_congr ?_ _ _).mp
        (hperm.2.2 x hx).2.2
      show ((T.pre s).transformI ℜ).E.pts = _
      rw [Tower.pts_transformI_E_eq_iUnion_esys ℜ P T s, Subscheme.pts_iInf]
    exact DatumTransform.isNonsingularIrreducibleCodimOne_and_hasOnlyNormalCrossings_snoc_transform
      (T.Esys P.E s) (hS.isNonsingular_X s) ih.1 ih.2 hperm.1 hNCB (T.monoidalTransformation s)

namespace Frame

variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

theorem isRegularLocalRing_and_mapsRSOP_stalkMap_c (s : ℕ) (y : 𝒮.tHat.X s)
    (hy : (𝒮.tHat.pre s).composite.base y = hS.xh) :
    IsRegularLocalRing ((𝒮.tHat.X s).presheaf.stalk y) ∧
      RingHom.MapsRSOP ((𝒮.c s).stalkMap y).hom := by
  obtain ⟨h1, h2, -⟩ := 𝒮.toCompletion.isRegularLocalRing_and_mapsRSOP_stalkMap
    (hS.ambient.2.1 x₀) hS.isNonsingular_X hS.isNonsingular_B s y hy
  exact ⟨h1, h2⟩

theorem exists_specializes_over [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (y : 𝒮.tHat.X s) :
    ∃ y', y ⤳ y' ∧ (𝒮.tHat.pre s).composite.base y' = hS.xh :=
  𝒮.toCompletion.exists_specializes_xhat0 (hS.ambient.2.1 x₀) s y

theorem isNonsingular_tHat_X [Hironaka.HironakaCitedResults.{u}] (s : ℕ) : (𝒮.tHat.X s).IsNonsingular :=
  𝒮.toCompletion.isNonsingular_tHat (hS.ambient.2.1 x₀) hS.isNonsingular_X hS.isNonsingular_B s

theorem isAlgebraicScheme_tHat_X' [Hironaka.HironakaCitedResults.{u}] : ∀ s : ℕ, IsAlgebraicScheme (𝒮.tHat.X s)
  | 0 => by
    have := hS.ambient.1
    exact isAlgebraicScheme_xHat0 X x₀
  | s + 1 => by
    have := isAlgebraicScheme_tHat_X' s
    exact (𝒮.tHat.monoidalTransformation s).isAlgebraicScheme

/-- `c_s⁻¹` of a non-singular subscheme is non-singular. -/
theorem isNonsingular_totalTransform_c [Hironaka.HironakaCitedResults.{u}] (s : ℕ) {D : Subscheme (T.X s)} (hD : D.IsNonsingular) :
    (Subscheme.totalTransform (𝒮.c s) D).IsNonsingular := by
  intro z
  have := isLocallyNoetherian_xHat0 (hS.ambient.2.1 x₀)
  have := MonoidalSuccession.isProper_composite (𝒮.tHat.pre s)
  obtain ⟨z', hsp, he⟩ := exists_specializes_xhat0_of_universallyClosed (hS.ambient.2.1 x₀)
    ((Subscheme.totalTransform (𝒮.c s) D).ι ≫ (𝒮.tHat.pre s).composite) z
  suffices h : IsRegularLocalRing ((Subscheme.totalTransform (𝒮.c s) D).toScheme.presheaf.stalk z')
    from isRegularLocalRing_stalk_of_specializes hsp
  set yh := (Subscheme.totalTransform (𝒮.c s) D).ι.base z'
  obtain ⟨hreg, hα⟩ := 𝒮.isRegularLocalRing_and_mapsRSOP_stalkMap_c s yh he
  have hyh : yh ∈ (Subscheme.totalTransform (𝒮.c s) D).pts := by
    show _ ∈ ((Subscheme.totalTransform (𝒮.c s) D).support : Set (𝒮.tHat.X s))
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨z', rfl⟩
  have hy : (𝒮.c s).base yh ∈ D.pts := by
    by_contra hy
    apply Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hyh
    rw [stalkIdeal_totalTransform, Subscheme.stalkIdeal_eq_top_of_notMem_pts hy, Ideal.map_top]
  have : IsRegularLocalRing ((T.X s).presheaf.stalk ((𝒮.c s).base yh)) := hS.isNonsingular_X s _
  have hQ := Subscheme.isPrime_stalkIdeal_of_isNonsingular hD hy
  have hQreg := Subscheme.isRegularLocalRing_quotient_of_isNonsingular hD hy
  have hq := (hα.isPrime_map_and_isRegularLocalRing_quotient hQ hQreg).2
  have hstalk : (Subscheme.totalTransform (𝒮.c s) D).stalkIdeal yh =
      (D.stalkIdeal ((𝒮.c s).base yh)).map ((𝒮.c s).stalkMap yh).hom := by
    rw [stalkIdeal_totalTransform]
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv (Subscheme.totalTransform (𝒮.c s) D) z'
  rw [← hstalk] at hq
  exact IsRegularLocalRing.of_ringEquiv e

end Frame

theorem Standing.isNonsingular_esys [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} (hS : Standing N n ℜ P r T x₀) (s : ℕ) (j : Fin (P.α + s)) :
    (T.Esys P.E s j).IsNonsingular :=
  (hS.esys_isNonsingularIrreducibleCodimOne_and_hasOnlyNormalCrossings s).1 j |>.isNonsingular

/-- Stalk presentation of every `E_j(s)` by a member of a regular system of parameters. -/
theorem Standing.exists_stalkIdeal_esys [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} (hS : Standing N n ℜ P r T x₀) (s : ℕ) (j : Fin (P.α + s)) (x : T.X s) :
    (T.Esys P.E s j).stalkIdeal x = ⊤ ∨
      ∃ a, ExtendsToRSOP _ {a} ∧ (T.Esys P.E s j).stalkIdeal x = Ideal.span {a} := by
  obtain ⟨hE, hNC⟩ := hS.esys_isNonsingularIrreducibleCodimOne_and_hasOnlyNormalCrossings s
  have : IsRegularLocalRing ((T.X s).presheaf.stalk x) := hS.isNonsingular_X s x
  obtain ⟨Z, hZ, -, hE'⟩ := DatumTransform.exists_rsop_adapted_of_isDatum (B := ⊥)
    (T.Esys P.E s) (hS.isNonsingular_X s) hE hNC (fun x _ => hNC x) x
  rcases hE' j with h | ⟨a, haZ, h⟩
  · exact Or.inl h
  · exact Or.inr ⟨a, ⟨Z, by simpa using haZ, hZ⟩, h⟩

theorem Standing.mem_pts_closed_x₀ {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
    {r : Restriction X} (hS : Standing N n ℜ P r T x₀) {F : Subscheme X} (hr : r = .closed F) :
    x₀ ∈ F.pts := by
  subst hr
  exact hS.mem_wStar.2

namespace Frame

variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

/-- `Ê_j(s) = c_s⁻¹(E_j(s))`. -/
noncomputable def eHat (s : ℕ) (j : Fin (P.α + s)) : Subscheme (𝒮.tHat.X s) :=
  Subscheme.totalTransform (𝒮.c s) (T.Esys P.E s j)

theorem eHat_succ_castSucc (s : ℕ) (j : Fin (P.α + s)) :
    𝒮.eHat (s + 1) (Fin.castSucc j) =
      Subscheme.strictTransform (𝒮.tHat.monoidalTransformation s) (𝒮.eHat s j) := by
  have : Flat (show (𝒮.tHat.monoidalTransformation s).X' ⟶ (T.monoidalTransformation s).X' from
      𝒮.c (s + 1)) := 𝒮.toCompletion.flat_c (hS.ambient.2.1 x₀) (s + 1)
  have key := MonoidalTransformation.totalTransform_strictTransform_of_flat_square
    (T.monoidalTransformation s) (𝒮.tHat.monoidalTransformation s) (𝒮.c s) (𝒮.c (s + 1))
    (𝒮.c_comm s).symm (𝒮.B_hat s).symm (T.Esys P.E s j)
  simp only [eHat]
  rw [Tower.esys_succ_castSucc]
  exact key

theorem eHat_succ_last (s : ℕ) :
    𝒮.eHat (s + 1) (Fin.last (P.α + s)) = (𝒮.tHat.monoidalTransformation s).exceptional := by
  simp only [eHat]
  rw [Tower.esys_succ_last]
  exact MonoidalTransformation.totalTransform_exceptional_of_square (T.monoidalTransformation s)
    (𝒮.tHat.monoidalTransformation s) (𝒮.c s) (𝒮.c (s + 1)) (𝒮.c_comm s).symm (𝒮.B_hat s).symm

theorem isNonsingular_eHat [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (j : Fin (P.α + s)) : (𝒮.eHat s j).IsNonsingular :=
  𝒮.isNonsingular_totalTransform_c s (hS.isNonsingular_esys s j)

/-- `c_s⁻¹` of a divisor given locally by a member of a regular system of parameters is simple
and of codimension one at each of its points. -/
theorem isSimpleAt_and_codimAt_eq_one_totalTransform_c [Hironaka.HironakaCitedResults.{u}] (s : ℕ) {D : Subscheme (T.X s)}
    (hD : D.IsNonsingular)
    (hP : ∀ x, D.stalkIdeal x = ⊤ ∨ ∃ a, ExtendsToRSOP _ {a} ∧ D.stalkIdeal x = Ideal.span {a}) :
    ∀ y ∈ (Subscheme.totalTransform (𝒮.c s) D).pts,
      (Subscheme.totalTransform (𝒮.c s) D).IsSimpleAt y ∧
        (Subscheme.totalTransform (𝒮.c s) D).codimAt y = 1 := by
  classical
  intro y hy
  have hns := 𝒮.isNonsingular_totalTransform_c s hD
  have hsimple : (Subscheme.totalTransform (𝒮.c s) D).IsSimpleAt y :=
    ⟨hy, Subscheme.isRegularLocalRing_quotient_of_isNonsingular hns hy⟩
  refine ⟨hsimple, ?_⟩
  obtain ⟨y', hsp, he⟩ := 𝒮.exists_specializes_over s y
  have hy' : y' ∈ (Subscheme.totalTransform (𝒮.c s) D).pts :=
    hsp.mem_closed (Subscheme.totalTransform (𝒮.c s) D).support.isClosed hy
  obtain ⟨hreg, hα⟩ := 𝒮.isRegularLocalRing_and_mapsRSOP_stalkMap_c s y' he
  have hx : (𝒮.c s).base y' ∈ D.pts := by
    by_contra hx
    apply Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hy'
    rw [stalkIdeal_totalTransform, Subscheme.stalkIdeal_eq_top_of_notMem_pts hx, Ideal.map_top]
  have : IsRegularLocalRing ((T.X s).presheaf.stalk ((𝒮.c s).base y')) := hS.isNonsingular_X s _
  obtain ⟨a, ha, hDa⟩ := (hP _).resolve_left (Subscheme.mem_pts_iff_stalkIdeal_ne_top.mp hx)
  obtain ⟨Z, haZ, hZ⟩ := ha
  have hZ' := (hα.isRegularSystemOfParameters_image hZ).1
  have haZ' : ({((𝒮.c s).stalkMap y').hom a} : Finset _) ⊆ Z.image ((𝒮.c s).stalkMap y').hom := by
    intro b hb
    rw [Finset.mem_singleton] at hb
    subst hb
    exact Finset.mem_image_of_mem _ (haZ (Finset.mem_singleton_self a))
  have hst : (Subscheme.totalTransform (𝒮.c s) D).stalkIdeal y' =
      Ideal.span {((𝒮.c s).stalkMap y').hom a} := by
    rw [stalkIdeal_totalTransform, hDa, Ideal.map_span, Set.image_singleton]
  have : IsRegularLocalRing ((𝒮.tHat.X s).presheaf.stalk y) := 𝒮.isNonsingular_tHat_X s y
  have hprime : ((Subscheme.totalTransform (𝒮.c s) D).stalkIdeal y).IsPrime :=
    Subscheme.isPrime_stalkIdeal_of_isNonsingular hns hy
  exact Subscheme.codimAt_eq_one_of_specializes hsp ⟨_, haZ', hZ'⟩ hst hprime

end Frame

/-- The indices `j` such that `E_j(s)` belongs to the boundary of the model datum on `X̂_s`: all of
them in the closed case, `α < j ≤ α + s` in the open case (p. 308). -/
def inBdry (r : Restriction X) (α s : ℕ) (j : Fin (α + s)) : Prop :=
  match r with
  | .closed _ => True
  | .opn _ => α ≤ j.val

theorem inBdry_succ (r : Restriction X) (α s : ℕ) (j : Fin (α + (s + 1))) :
    inBdry r α (s + 1) j ↔ j.val = α + s ∨ ∃ h : j.val < α + s, inBdry r α s ⟨j.val, h⟩ := by
  cases r with
  | closed F =>
    simp only [inBdry, true_iff]
    by_cases h : j.val < α + s
    · exact Or.inr ⟨h, trivial⟩
    · left; have := j.2; omega
  | opn U =>
    simp only [inBdry]
    constructor
    · intro h1
      by_cases h : j.val < α + s
      · exact Or.inr ⟨h, h1⟩
      · left; have := j.2; omega
    · rintro (h | ⟨h, h2⟩)
      · omega
      · exact h2

/-- The number of the boundary divisors: `α + s` in the closed case, `s` in the open case. -/
def bdryCard : Restriction X → ℕ → ℕ → ℕ
  | .closed _, α, s => α + s
  | .opn _, _, s => s

/-- The index of the `j`th boundary divisor among the `E_i(s)`. -/
def bdryIdx : (r : Restriction X) → (α s : ℕ) → Fin (bdryCard r α s) → Fin (α + s)
  | .closed _, _, _, j => j
  | .opn _, α, _, j => Fin.natAdd α j

theorem inBdry_bdryIdx (r : Restriction X) (α s : ℕ) (i : Fin (bdryCard r α s)) :
    inBdry r α s (bdryIdx r α s i) := by
  cases r with
  | closed F => trivial
  | opn U => exact Nat.le_add_right _ _

theorem pts_iInf_bdryIdx {Z : Scheme.{u}} (r : Restriction X) (α t : ℕ)
    (E : Fin (α + t) → Subscheme Z) :
    (⨅ i : Fin (bdryCard r α t), E (bdryIdx r α t i)).pts =
      ⋃ j ∈ {j : Fin (α + t) | inBdry r α t j}, (E j).pts := by
  cases r with
  | closed F =>
    rw [show (⨅ i : Fin (bdryCard (.closed F) α t), E (bdryIdx (.closed F) α t i)) =
      ⨅ i : Fin (α + t), E i from rfl, Subscheme.pts_iInf]
    ext x
    simp [inBdry]
  | opn U =>
    rw [show (⨅ i : Fin (bdryCard (.opn U) α t), E (bdryIdx (.opn U) α t i)) =
      ⨅ i : Fin t, E (Fin.natAdd α i) from rfl, Subscheme.pts_iInf]
    ext x
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq, inBdry, exists_prop]
    constructor
    · rintro ⟨i, hi⟩
      exact ⟨Fin.natAdd α i, by simp, hi⟩
    · rintro ⟨j, hj, hx⟩
      refine ⟨⟨j.val - α, by omega⟩, ?_⟩
      have : Fin.natAdd α (⟨j.val - α, by omega⟩ : Fin t) = j := Fin.ext (by simp; omega)
      rw [this]; exact hx

namespace Frame

variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

/-- The datum `(E; ; V(z_0))` of type I on `X̂_0` for the induction of p. 308: `E = ⋃_{i ≤ α} Ê_i(0)`
in the closed case, `E = ∅` in the open case.  Its transform along `ĝ_s` has `W = X̄_s` and the
boundary `⋃ Ê_j(s)` (`j` in the boundary: `α < j ≤ α + s` in the open case, all `j` in the closed
case), by the compatibility of strict and total transforms with the flat squares `c_s`.

Gap filled (p. 308): the paper only says "It is clear that `Ê'_{α+1}(s) ∪ ⋯ ∪ Ê'_{α+s}(s)` has only
normal crossings with `X̄'_s` on `X̂'_s`" (open case) and, in the closed case, "`E'_1(s) ∪ ⋯ ∪
E'_{α+s}(s)` has only normal crossings with `X̄'_s` on `X̂'_s` because `X̄'_s = c_s⁻¹(F(s)) ∩
X̂'_s`".  Both are proved by the induction along `ĝ_s` of Lemma 4 of §2 for this datum, localized to
the opens `U_s` of a removal family (`RemovalFamily.modelDatum_boundary_local`). -/
noncomputable def modelDatum : DatumI.Raw (xHat0 X x₀) where
  E := match r with
    | .closed _ => ⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j
    | .opn _ => Subscheme.empty
  β := 0
  V := Fin.elim0
  W := vZ X x₀ 𝒮.z

theorem transformI_modelDatum_W (s : ℕ) :
    ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).W = 𝒮.xBar s := by
  rw [MonoidalSuccession.transformI_W]
  induction s with
  | zero => rfl
  | succ s ih =>
    show (MonoidalSuccession.snoc (𝒮.tHat.pre s) (𝒮.tHat.B s)
      (𝒮.tHat.monoidalTransformation s)).strictTransform _ = _
    rw [MonoidalSuccession.strictTransform_snoc, ih]
    rfl

theorem pts_transformI_modelDatum_E (s : ℕ) :
    ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).E.pts =
      ⋃ j ∈ {j : Fin (P.α + s) | inBdry r P.α s j}, (𝒮.eHat s j).pts := by
  induction s with
  | zero =>
    cases r with
    | closed F =>
      show (⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j).pts = _
      rw [Subscheme.pts_iInf]
      simp [inBdry]
    | opn U =>
      show (Subscheme.empty : Subscheme (𝒮.tHat.X 0)).pts = _
      rw [Subscheme.pts_empty]
      refine (Set.empty_subset _).antisymm ?_
      intro x hx
      obtain ⟨j, hj, -⟩ := Set.mem_iUnion₂.mp hx
      have h1 : P.α ≤ j.val := hj
      have := j.2
      omega
  | succ s ih =>
    show ((MonoidalSuccession.snoc (𝒮.tHat.pre s) (𝒮.tHat.B s)
      (𝒮.tHat.monoidalTransformation s)).transformI 𝒮.modelDatum).E.pts = _
    rw [MonoidalSuccession.transformI_snoc]
    set t := 𝒮.tHat.monoidalTransformation s
    show (Subscheme.strictTransform t _ ⊓ t.exceptional).pts = _
    rw [Subscheme.pts_inf, MonoidalTransformation.pts_strictTransform_eq_closure, ih]
    have hfin : ({j : Fin (P.α + s) | inBdry r P.α s j}).Finite := Set.toFinite _
    have hpre : t.f.base ⁻¹' (⋃ j ∈ {j : Fin (P.α + s) | inBdry r P.α s j}, (𝒮.eHat s j).pts) \
        t.exceptional.pts = ⋃ j ∈ {j : Fin (P.α + s) | inBdry r P.α s j},
          (t.f.base ⁻¹' (𝒮.eHat s j).pts \ t.exceptional.pts) := by
      ext x
      simp only [Set.mem_sdiff, Set.mem_preimage, Set.mem_iUnion, exists_prop]
      tauto
    rw [hpre, hfin.closure_biUnion]
    refine Set.Subset.antisymm ?_ ?_
    · rintro x (hx | hx)
      · obtain ⟨j, hj, hx⟩ := Set.mem_iUnion₂.mp hx
        refine Set.mem_iUnion₂.mpr ⟨Fin.castSucc j,
          (inBdry_succ r P.α s _).mpr (Or.inr ⟨j.2, hj⟩), ?_⟩
        rw [𝒮.eHat_succ_castSucc s j]
        exact (Set.ext_iff.mp (MonoidalTransformation.pts_strictTransform_eq_closure t _) x).mpr hx
      · refine Set.mem_iUnion₂.mpr ⟨Fin.last (P.α + s),
          (inBdry_succ r P.α s _).mpr (Or.inl rfl), ?_⟩
        rw [𝒮.eHat_succ_last s]
        exact hx
    · intro x hx
      obtain ⟨j, hj, hx⟩ := Set.mem_iUnion₂.mp hx
      rcases (inBdry_succ r P.α s j).mp hj with h | ⟨h, hj'⟩
      · right
        have : j = Fin.last (P.α + s) := Fin.ext h
        rw [this, 𝒮.eHat_succ_last s] at hx
        exact hx
      · left
        refine Set.mem_iUnion₂.mpr ⟨⟨j.val, h⟩, hj', ?_⟩
        have e : j = Fin.castSucc (⟨j.val, h⟩ : Fin (P.α + s)) := rfl
        rw [e, 𝒮.eHat_succ_castSucc s] at hx
        exact (Set.ext_iff.mp (MonoidalTransformation.pts_strictTransform_eq_closure t _) x).mp hx

end Frame


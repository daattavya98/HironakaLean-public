variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

theorem c_zero_base_xh : (𝒮.c 0).base hS.xh = x₀ := by
  rw [𝒮.c_zero]; exact c0_apply_xhat0 X x₀ (hS.ambient.2.1 x₀)

theorem isIrreducible_pts_vZ [Hironaka.HironakaCitedResults.{u}] : _root_.IsIrreducible (vZ X x₀ 𝒮.z).pts :=
  Subscheme.isIrreducible_pts (𝒮.xBar 0) 𝒮.xBar_zero_isNonsingular_and_isIrreducible.2

theorem isReduced_vZ [Hironaka.HironakaCitedResults.{u}] : (vZ X x₀ 𝒮.z).IsReduced :=
  DatumTransform.isReduced_of_isNonsingular 𝒮.xBar_zero_isNonsingular_and_isIrreducible.1

theorem modelDatum_E_open {U : Set X} (hr : r = .opn U) :
    𝒮.modelDatum.E = Subscheme.empty := by
  subst hr; rfl

theorem modelDatum_E_closed {F : Subscheme X} (hr : r = .closed F) :
    𝒮.modelDatum.E = ⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j := by
  subst hr; rfl

/-- Stage `0`, open case: the boundary has stalk presentations (it is empty). -/
theorem exists_stalk_presentation_modelDatum_open [Hironaka.HironakaCitedResults.{u}] {U : Set X} (hr : r = .opn U)
    (y : 𝒮.tHat.X 0) :
    ∃ K : Finset ((𝒮.tHat.X 0).presheaf.stalk y), ExtendsToRSOP _ K ∧
      𝒮.modelDatum.E.stalkIdeal y = Ideal.span {∏ k ∈ K, k} := by
  have : IsRegularLocalRing ((𝒮.tHat.X 0).presheaf.stalk y) := 𝒮.isNonsingular_tHat_X 0 y
  obtain ⟨-, Z, hZ⟩ := (isRegularLocalRing_iff_exists_rsop ((𝒮.tHat.X 0).presheaf.stalk y)).mp
    inferInstance
  refine ⟨∅, ⟨Z, Finset.empty_subset _, hZ⟩, ?_⟩
  rw [𝒮.modelDatum_E_open hr]
  show (⊤ : Subscheme (𝒮.tHat.X 0)).stalkIdeal y = _
  rw [Subscheme.stalkIdeal_top_eq, Finset.prod_empty, Ideal.span_singleton_one]

/-- The pull-back to `x̂_0` of the normal crossings at `x_0` of `⋃ E_i` with `D`. -/
theorem hasOnlyNormalCrossingsWithAt_iInf_eHat_zero [Hironaka.HironakaCitedResults.{u}] (D : Subscheme X)
    (h : (⨅ j : Fin (P.α + 0), T.Esys P.E 0 j).HasOnlyNormalCrossingsWithAt D x₀) :
    (⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j).HasOnlyNormalCrossingsWithAt
      (Subscheme.totalTransform (𝒮.c 0) D) hS.xh := by
  let xh : 𝒮.tHat.X 0 := hS.xh
  obtain ⟨hreg, hα⟩ := 𝒮.isRegularLocalRing_and_mapsRSOP_stalkMap_c 0 xh rfl
  have hx : (𝒮.c 0).base xh = x₀ := 𝒮.c_zero_base_xh
  have hEred : (⨅ j : Fin (P.α + 0), T.Esys P.E 0 j).IsReduced :=
    Subscheme.isReduced_iInf_of_isNonsingular _ fun j => hS.isNonsingular_esys 0 j
  have : IsRegularLocalRing ((T.X 0).presheaf.stalk ((𝒮.c 0).base xh)) :=
    hS.isNonsingular_X 0 _
  have h' : (⨅ j : Fin (P.α + 0), T.Esys P.E 0 j).HasOnlyNormalCrossingsWithAt D
      ((𝒮.c 0).base xh) := by rw [hx]; exact h
  have hloc : IsLocalHom ((𝒮.c 0).stalkMap xh).hom := inferInstance
  have key := Subscheme.hasOnlyNormalCrossingsWithAt_totalTransform_of_mapsRSOP (𝒮.c 0) xh hα
    hEred h'
  refine (Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_congr ?_ _ _).mp key
  rw [Subscheme.pts_totalTransform_eq_preimage, Subscheme.pts_iInf, Subscheme.pts_iInf]
  ext y
  simp only [Set.mem_preimage, Set.mem_iUnion, eHat]
  simp only [Subscheme.pts_totalTransform_eq_preimage, Set.mem_preimage]

theorem exists_stalk_presentation_modelDatum_closed [Hironaka.HironakaCitedResults.{u}] {F : Subscheme X} (hr : r = .closed F)
    (y : 𝒮.tHat.X 0) :
    ∃ K : Finset ((𝒮.tHat.X 0).presheaf.stalk y), ExtendsToRSOP _ K ∧
      𝒮.modelDatum.E.stalkIdeal y = Ideal.span {∏ k ∈ K, k} := by
  have : IsRegularLocalRing ((𝒮.tHat.X 0).presheaf.stalk y) := 𝒮.isNonsingular_tHat_X 0 y
  rw [𝒮.modelDatum_E_closed hr]
  have hUred : (⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j).IsReduced :=
    Subscheme.isReduced_iInf_of_isNonsingular _ fun j => 𝒮.isNonsingular_eHat 0 j
  have hx := 𝒮.hasOnlyNormalCrossingsWithAt_iInf_eHat_zero ⊥
    ((hS.esys_isNonsingularIrreducibleCodimOne_and_hasOnlyNormalCrossings 0).2 x₀)
  have hx' : (⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j).HasOnlyNormalCrossingsWithAt ⊥ hS.xh :=
    Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_congr_right hx
      (Subscheme.stalkIdeal_totalTransform_bot _ _)
  have hall := 𝒮.hasOnlyNormalCrossingsWithAt_of_over 0
    (E := ⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j) (D := ⊥) (fun y' _ hy' => by
      have : y' = hS.xh := hy'
      rw [this]; exact hx') y (Subscheme.mem_pts_bot y)
  obtain ⟨z, hz, ⟨J, hJz, hEJ⟩, -⟩ :=
    (Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_iff hUred this).mp hall
  exact ⟨J, (ExtendsToRSOP.of_isRegularSystemOfParameters hz).mono hJz, hEJ⟩

end Frame

namespace Frame

variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

theorem modelDatum_hres_open [Hironaka.HironakaCitedResults.{u}] {U : Set X} (hr : r = .opn U) :
    ∀ x ∈ 𝒮.modelDatum.W.pts, 𝒮.modelDatum.E.HasOnlyNormalCrossingsWithAt 𝒮.modelDatum.W x := by
  intro x hx
  rw [𝒮.modelDatum_E_open hr]
  exact Subscheme.hasOnlyNormalCrossingsWithAt_empty (𝒮.isNonsingular_tHat_X 0 x)
    ⟨hx, Subscheme.isRegularLocalRing_quotient_of_isNonsingular
      𝒮.xBar_zero_isNonsingular_and_isIrreducible.1 hx⟩

theorem modelDatum_hres_closed [Hironaka.HironakaCitedResults.{u}] {F : Subscheme X} (hr : r = .closed F) :
    ∀ x ∈ 𝒮.modelDatum.W.pts, 𝒮.modelDatum.E.HasOnlyNormalCrossingsWithAt 𝒮.modelDatum.W x := by
  have hcr : ℜ.IsClosedRestriction F := by have := hS.isFor; subst hr; exact this
  have hEF : ((⨅ i, P.E i).union F).HasOnlyNormalCrossings := by
    have := hcr.2.1; rwa [P.E_union] at this
  have hNCF := hasOnlyNormalCrossingsWith_iInf_of_isClosedRestriction (hS.ambient.2.1) P.E
    P.E_codimOne hcr.1 hEF x₀ (hS.mem_pts_closed_x₀ hr)
  have hx := 𝒮.hasOnlyNormalCrossingsWithAt_iInf_eHat_zero F hNCF
  have hv : vZ X x₀ 𝒮.z = Subscheme.totalTransform (𝒮.c 0) F :=
    𝒮.xBar_eq_totalTransform_of_closed 0 F hr
  have hx' : (⨅ j : Fin (P.α + 0), 𝒮.eHat 0 j).HasOnlyNormalCrossingsWithAt
      (vZ X x₀ 𝒮.z) hS.xh := by
    refine Hironaka.Subscheme.hasOnlyNormalCrossingsWithAt_congr_right hx ?_
    rw [hv]
  rw [𝒮.modelDatum_E_closed hr]
  exact 𝒮.hasOnlyNormalCrossingsWithAt_of_over 0 (fun y' _ hy' => by
      have : y' = hS.xh := hy'
      rw [this]; exact hx')

end Frame

namespace Frame

variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}
  {hS : Standing N n ℜ P r T x₀} {𝒮 : Frame hS}

/-- **The induction of p. 308 along `ĝ_s`, localised to an open family with removals**
(gap filled: "It is clear that `Ê'_{α+1}(s) ∪ ⋯ ∪ Ê'_{α+s}(s)` has only normal crossings with `X̄'_s`
on `X̂'_s`", p. 308): for the
datum `(E; ; V(z_0))` of type I on `X̂_0`, the boundary of its transform has the same stalk
presentations everywhere, and has only normal crossings with `X̄_s` at the points of `U_s` (the
centers `B̂_t` are contained in `X̄_t` only off `Bad_t`, and `U_{t+1}` lies over `U_t − Bad_t`). -/
@[blueprint "lem:IV.3-rem2-model-boundary"
  (statement := /-- Let $\hat{\mathfrak R}_0=(E_0;\,;V(z_0))$ be the datum of type~I on $\hat X_0$ with
    $E_0=\hat E_1(0)\cup\dots\cup\hat E_\alpha(0)$ in the closed case and $E_0=\emptyset$ in the
    open case, and $\hat{\mathfrak R}_s$ its transform along $\hat g_s$ (so $W_s=\bar X_s$ and the
    boundary of $\hat{\mathfrak R}_s$ is the union of the $\hat E_j(s)$, $1\le j\le\alpha+s$ in the closed
    case, $\alpha<j\le\alpha+s$ in the open case). For an open family with removals $U_s$: the
    stalks of the boundary $E_s$ of $\hat{\mathfrak R}_s$ at every point of $\hat X_s$ are products of
    a part of a regular system of parameters, and $E_s$ has only normal crossings with $\bar X_s$ at
    the points of $U_s\cap\bar X_s$. -/)
  (proof := /-- Induction on $s$. For $s=0$ the claims are the pull-back by the flat map $c_0$ of the
    normal crossings of $E_1\cup\dots\cup E_\alpha$ with $F$ (Definition~5 (I.1)) at $\hat x_0$,
    carried to all points of $\hat X_0$ by the openness of the normal-crossing locus (every point
    specializes to $\hat x_0$). For the step, the center $\hat B_s$ is non-singular with only normal
    crossings with $E_s$ (pull-back by $c_s$ of the permissibility of $B_s$), and over
    $U_s-\mathrm{Bad}_s$ it is contained in $\bar X_s$; the claim is the stability of normal
    crossings under the blowing-up, in the pointwise form of
    \cref{lem:IV.4-exceptional-transversal-nonsingular}.
    \textbf{Deviation from the paper (gap filled).} The paper says only ``It is clear that
    $\hat E'_{\alpha+1}(s)\cup\dots\cup\hat E'_{\alpha+s}(s)$ has only normal crossings with $\bar X'_s$
    on $\hat X'_s$'' (p.~308), and in the closed case ``because $\bar X'_s=c_s^{-1}(F(s))\cap\hat
    X'_s$''. -/)
  (proofUses := ["lem:IV.4-exceptional-transversal-nonsingular"])
  (latexEnv := "lemma")]
theorem RemovalFamily.modelDatum_boundary_local [Hironaka.HironakaCitedResults.{u}] (R : 𝒮.RemovalFamily) (s : ℕ) :
    (∀ y : 𝒮.tHat.X s, ∃ K : Finset ((𝒮.tHat.X s).presheaf.stalk y), ExtendsToRSOP _ K ∧
      ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).E.stalkIdeal y = Ideal.span {∏ k ∈ K, k}) ∧
    (∀ y ∈ (R.U s : Set (𝒮.tHat.X s)), y ∈ (𝒮.xBar s).pts →
      ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).E.HasOnlyNormalCrossingsWithAt (𝒮.xBar s) y) := by
  induction s with
  | zero =>
    refine ⟨fun y => ?_, fun y _ hy => ?_⟩
    · cases r with
      | closed F => exact 𝒮.exists_stalk_presentation_modelDatum_closed rfl y
      | opn U => exact 𝒮.exists_stalk_presentation_modelDatum_open rfl y
    · cases r with
      | closed F => exact 𝒮.modelDatum_hres_closed rfl y hy
      | opn U => exact 𝒮.modelDatum_hres_open rfl y hy
  | succ s ih =>
    have hBns : (𝒮.tHat.B s).IsNonsingular :=
      𝒮.toCompletion.isNonsingular_B (hS.ambient.2.1 x₀) hS.isNonsingular_X hS.isNonsingular_B s
    have hX := 𝒮.isNonsingular_tHat_X s
    have e : (𝒮.tHat.pre (s + 1)).transformI 𝒮.modelDatum =
        ((𝒮.tHat.pre s).transformI 𝒮.modelDatum).transform
          (𝒮.tHat.monoidalTransformation s) :=
      MonoidalSuccession.transformI_snoc _ _ _ _
    rw [e]
    refine ⟨fun y' => ?_, fun y' hyU hyW => ?_⟩
    · exact DatumTransform.exists_stalk_presentation_strictTransform_inf_exceptional hX hBns
        ih.1 (𝒮.hasOnlyNormalCrossingsWith_modelDatum_boundary_bHat s)
        (𝒮.tHat.monoidalTransformation s) y'
    · have hU := hyU
      rw [R.coe_U_succ s] at hU
      have hyW' : y' ∈ (Subscheme.strictTransform (𝒮.tHat.monoidalTransformation s)
          (𝒮.xBar s)).pts := hyW
      have hxW : (𝒮.tHat.f s).base y' ∈ (𝒮.xBar s).pts :=
        MonoidalTransformation.pts_strictTransform_subset _ _ hyW'
      exact DatumTransform.hasOnlyNormalCrossingsWithAt_strictTransform_inf_exceptional hX hBns
        ih.1 (𝒮.tHat.monoidalTransformation s) hyW'
        (ih.2 _ hU.1 hxW)
        (fun h => 𝒮.hasOnlyNormalCrossingsWith_modelDatum_boundary_bHat s _ h)
        (fun h => R.stalkIdeal_xBar_le s _ ⟨h, hU.2⟩)

end Frame


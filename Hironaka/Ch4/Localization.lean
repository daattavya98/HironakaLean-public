    (fun x => X.dimAt x ≠ (N : WithBot ℕ∞)) (fun ⟨X', f, hf⟩ x hx hxN => by
      obtain ⟨X'', f', hf', hx'⟩ :=
        exists_isPermissibleII_append_notMem_image_Snu N hII₂ hI₂ hX hℜ f hf x hx hxN
      refine ⟨⟨X'', f.append f',

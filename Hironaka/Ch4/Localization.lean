theorem exists_isPermissibleIIClosed_append_notMem_image_Snu [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [Hironaka.Cited.CurveFiniteIntegralClosure.{u}] [Hironaka.Cited.ExistsFlatIsLocalHomAdicCompletionOfFlat.{u}] [Hironaka.Cited.ExistsSurjectiveMvPowerSeriesOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationIffRankJacobianEqHeight.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] [Hironaka.Cited.IsRegularLocalRingOfFlatOfIsRegularLocalRing.{u}] (N : ℕ) (hII₁ : ∀ N' : ℕ, N' < N → FundamentalTheorem.II₁.{u} N')
    (hI₂ : ∀ n : ℕ, n < N → FundamentalTheorem.I₂.{u} N n)
    {X : Scheme.{u}} (hX : IsAmbient X N) {ℜ : DatumII.Raw X} (hℜ : ℜ.IsDatum)
    {F : Subscheme X} (hF : ℜ.IsClosedRestriction F) (hν : 0 < ℜ.nu) {X' : Scheme.{u}}
    (f : MonoidalSuccession X X') (hf : f.IsPermissibleIIClosed ℜ F) (x : X)
    (hx : x ∈ f.composite.base '' ((f.transformII ℜ).sNu ℜ.nu ∩ (f.strictTransform F).pts))
    (hxN : X.dimAt x ≠ (N : WithBot ℕ∞)) :
    ∃ (X'' : Scheme.{u}) (f' : MonoidalSuccession X' X''),
      f'.IsPermissibleIIClosed (f.transformII ℜ) (f.strictTransform F) ∧
      x ∉ (f.append f').composite.base ''
        (((f.append f').transformII ℜ).sNu ℜ.nu ∩ ((f.append f').strictTransform F).pts) := by
  obtain ⟨x', ⟨hx'S, hx'F⟩, hfx⟩ := hx
  have hfII := hf.isPermissibleII
  obtain ⟨hX', hℜ'⟩ := f.isAmbient_transformII hX ℜ hℜ hfII
  have hF' := f.isClosedRestriction_transformII hX ℜ hℜ F hF hf
  have := hX.1
  have := hX'.1
  have := hX'.2.2.1
  have := IsAlgebraicScheme.isNoetherian X
  have := f.isProper_composite
  have hν' : (f.transformII ℜ).nu ≤ ℜ.nu := f.nu_transformII_le hX.2.1 ℜ hℜ hfII
  obtain ⟨Nb, hNbN, -, hZ⟩ := exists_lt_isAmbient_localizeScheme_of_dimAt_ne_of_isPermissibleII N hX hℜ f hfII hX' x hxN
    x' hfx
  set j := localizeMap f.composite x
  have := flat_localizeMap f.composite x
  have := isPreimmersion_localizeMap f.composite x
  obtain ⟨hdatS, hFS⟩ := (localize_isDatum f.composite hX'.2.1 x).2 _ hℜ'
  set ℜS := (f.transformII ℜ).localize f.composite x with hℜS
  have hx'r : x' ∈ Set.range j.base := by
    rw [range_localizeMap]
    show f.composite x' ⤳ x
    rw [hfx]
  obtain ⟨z₀, hz₀⟩ := hx'r
  have hz₀S : z₀ ∈ ℜS.sNu ℜ.nu := by
    show z₀ ∈ ((f.transformII ℜ).pullback j).sNu ℜ.nu
    rw [DatumII.Raw.mem_sNu_pullback]
    show j z₀ ∈ _
    rw [hz₀]
    exact hx'S
  -- `ν(ℜ'_S) = ν` (p. 283)
  have hνS : ℜS.nu = ℜ.nu := by
    refine le_antisymm ((DatumII.Raw.nu_pullback_le j _).trans hν') ?_
    exact hz₀S.2.trans (le_iSup₂ (f := fun y (_ : y ∈ ℜS.S) => ℜS.nuAt y) z₀ hz₀S.1)
  -- Theorem `II₁^{N̄}` on `X'_S`
  obtain ⟨Za, sb, hsb, hempty⟩ := hII₁ Nb hNbN _ hZ ⟨ℜS, hdatS⟩ _ (hFS _ hF')
    (by show 0 < ℜS.nu; rw [hνS]; exact hν)
  have hempty' : (sb.transformII ℜS).sNu ℜ.nu ∩
      (sb.strictTransform (Subscheme.totalTransform j (f.strictTransform F))).pts = ∅ := by
    rw [Set.inter_comm, ← hνS]
    exact hempty
  -- "We may assume that this last condition is not satisfied if we omit the last transformation
  -- `f̄_{a−1}`" (p. 283)
  obtain ⟨Za', sb', hsb', hmin⟩ := MonoidalSuccession.exists_isMinimalSNuEmptyIIClosed ℜ.nu sb ℜS _
    hsb hempty'
  -- lifting `f̄` to `X'` (pp. 283–285)
  obtain ⟨X'', f', hperm, hlast⟩ := LocSucc.lift_successionII resolvedSetIsOpen_holds N hI₂ ℜ.nu sb' j
    (f.transformII ℜ) (f.strictTransform F) ℜS hX' hℜ' hν' (DatumII.Raw.SameChar.refl _)
    hsb' hmin
  refine ⟨X'', f', hperm, ?_⟩
  rintro ⟨y, ⟨hyS, hyF⟩, hgy⟩
  rw [MonoidalSuccession.composite_append, Scheme.Hom.comp_apply] at hgy
  rw [MonoidalSuccession.transformII_append] at hyS
  rw [MonoidalSuccession.strictTransform_append] at hyF
  refine hlast y ⟨hyS, hyF⟩ ?_
  rw [range_localizeMap]
  show f.composite (f'.composite y) ⤳ x
  rw [hgy]

/-- The improvement step of the proof of Proposition 4 (p. 286: "The proof is entirely similar to that
of Proposition 3"): the argument of `exists_isPermissibleIIClosed_append_notMem_image_Snu` for a
datum without restriction.  If `f(S_ν(f*ℜ))` contains a point `x` at which `X` has dimension `< N`,
then `X'_S` (`S = O_{X,x}`) is ambient of dimension `N̄ < N` and `ℜ'_S` is a datum on it
(`ν(ℜ'_S) ≤ ν`); Theorem `II₂^{N̄}` on `X'_S` (the induction hypothesis of Proposition 4, which
carries no `ν > 0` as Theorem `II₁^{N̄}` does) gives a succession `f̄` permissible for `ℜ'_S` with `f̄*ℜ'_S`
resolved everywhere, so that `S_ν(f̄*ℜ'_S) = ∅`; taking `f̄` minimal (p. 283: "we may assume that
this last condition is not satisfied if we omit the last transformation"), its lifting to `X'`
(`LocSucc.lift_successionII_unrestricted`, the pp. 283–285 argument with no `F`) removes `x`. -/
theorem exists_isPermissibleII_append_notMem_image_Snu [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [Hironaka.Cited.CurveFiniteIntegralClosure.{u}] [Hironaka.Cited.ExistsFlatIsLocalHomAdicCompletionOfFlat.{u}] [Hironaka.Cited.ExistsSurjectiveMvPowerSeriesOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationIffRankJacobianEqHeight.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] [Hironaka.Cited.IsRegularLocalRingOfFlatOfIsRegularLocalRing.{u}] (N : ℕ) (hII₂ : ∀ N' : ℕ, N' < N → FundamentalTheorem.II₂.{u} N')
    (hI₂ : ∀ n : ℕ, n < N → FundamentalTheorem.I₂.{u} N n)
    {X : Scheme.{u}} (hX : IsAmbient X N) {ℜ : DatumII.Raw X} (hℜ : ℜ.IsDatum)
    {X' : Scheme.{u}} (f : MonoidalSuccession X X') (hf : f.IsPermissibleII ℜ) (x : X)
    (hx : x ∈ f.composite.base '' (f.transformII ℜ).sNu ℜ.nu)
    (hxN : X.dimAt x ≠ (N : WithBot ℕ∞)) :
    ∃ (X'' : Scheme.{u}) (f' : MonoidalSuccession X' X''),
      f'.IsPermissibleII (f.transformII ℜ) ∧
      x ∉ (f.append f').composite.base '' ((f.append f').transformII ℜ).sNu ℜ.nu := by
  obtain ⟨x', hx'S, hfx⟩ := hx
  obtain ⟨hX', hℜ'⟩ := f.isAmbient_transformII hX ℜ hℜ hf
  have := hX.1
  have := hX'.1
  have := hX'.2.2.1
  have := IsAlgebraicScheme.isNoetherian X
  have := f.isProper_composite
  have hν' : (f.transformII ℜ).nu ≤ ℜ.nu := f.nu_transformII_le hX.2.1 ℜ hℜ hf
  obtain ⟨Nb, hNbN, -, hZ⟩ := exists_lt_isAmbient_localizeScheme_of_dimAt_ne_of_isPermissibleII N hX hℜ f hf hX' x hxN
    x' hfx
  set j := localizeMap f.composite x
  have := flat_localizeMap f.composite x
  have := isPreimmersion_localizeMap f.composite x
  obtain ⟨hdatS, -⟩ := (localize_isDatum f.composite hX'.2.1 x).2 _ hℜ'
  set ℜS := (f.transformII ℜ).localize f.composite x with hℜS
  -- Theorem `II₂^{N̄}` on `X'_S`: a succession `f̄` with `f̄*ℜ'_S` resolved, so `S_ν(f̄*ℜ'_S) = ∅`
  obtain ⟨Za, sb, hsb, hres⟩ := hII₂ Nb hNbN _ hZ ⟨ℜS, hdatS⟩
  have hempty : (sb.transformII ℜS).sNu ℜ.nu = ∅ := by
    refine Set.eq_empty_iff_forall_notMem.mpr fun z hz => ?_
    have h1 := hres z
    have h2 := hz.1
    unfold DatumII.Raw.ResolvedAt at h1
    unfold DatumII.Raw.S at h2
    exact absurd h2 (not_le.mpr h1)
  -- "We may assume that this last condition is not satisfied if we omit the last transformation
  -- `f̄_{a−1}`" (p. 283)
  obtain ⟨Za', sb', hsb', hmin⟩ := MonoidalSuccession.exists_isMinimalSNuEmptyII ℜ.nu sb ℜS hsb hempty
  -- lifting `f̄` to `X'` (pp. 283–285, with no restriction)
  obtain ⟨X'', f', hperm, hlast⟩ := LocSucc.lift_successionII_unrestricted resolvedSetIsOpen_holds N
    hI₂ ℜ.nu sb' j (f.transformII ℜ) ℜS hX' hℜ' hν' (DatumII.Raw.SameChar.refl _) hsb' hmin
  refine ⟨X'', f', hperm, ?_⟩
  rintro ⟨y, hyS, hgy⟩
  rw [MonoidalSuccession.composite_append, Scheme.Hom.comp_apply] at hgy
  rw [MonoidalSuccession.transformII_append] at hyS
  refine hlast y hyS ?_
  rw [range_localizeMap]
  show f.composite (f'.composite y) ⤳ x
  rw [hgy]

end Stage

/-! ### Proposition 1 (pp. 278–280): the localization theorem on `(ℜ^{N,n}_I, F)` -/

/-- Proposition 1, p. 278 (localization theorem on `(ℜ^{N,n}_I, F)`).

Formalization note (encoding): the hypothesis "Theorems I₁^{N',n'} with n' < N' < N and
n' ≤ n and Theorems I₂^{N,n''} with n'' < n are proved" is taken as two explicit hypotheses on
the predicates `FundamentalTheorem.I₁`, `FundamentalTheorem.I₂` of Ch. I §2.  "`f(F' ∩ W')` is at most a finite number of
points at which `X` has dimension `N`" is: the image of `F' ∩ W'` under the composite morphism
of the succession is finite and `dim_y X = N` at each of its points.  Properties (1)–(3) of the
lifting are encoded by flat preimmersions `X̄_j → X'_k` compatible with transforms
(`LocSucc.lift_succession_closed`, `Hironaka/Compat/LocalizeSuccession.lean`).

Proof as printed (pp. 278–280): `f(F' ∩ W')` and `g(F'' ∩ W'')` are closed (properness), and a
point `x` of `f(F' ∩ W')` at which `X` has dimension `< N` is removed by a further succession `f'`
(`exists_isPermissibleIClosed_append_notMem_image`), so that, there being no infinite strictly
descending sequence of closed subsets of an algebraic scheme (`LocSucc.exists_forall_not_of_improve`),
the Proposition follows.  The construction of `f'` is as printed: `N̄ = dim S` with
`dim X'_S = dim S = N̄ < N` by Remark 2 (`rem:IV.1-2`; the centers are nowhere dense), `n̄ = dim W'_S`,
Theorem `I₁^{N̄,n̄}` on `X'_S`, and the lifting "(1)–(3)" of p. 279 by induction on `j`
(`LocSucc.lift_succession_closed`): `B''` the smallest irreducible subscheme with
`B̄_b = (B'')_S`, "`dim(B'') < dim(_bW') = n`" (the stages `IsStageI` carry `dim W = n`), `U''` the
resolved points of `B''`, "an open dense subset of `B''` by Lemma 1" (both halves of Lemma 1:
`lemma_one_holds`), Theorem `I₂^{N,n''}` for `h`.

Formalization note (encoding): an empty center `B̄_b` (allowed by the agreement of p. 163, and not
addressed by the construction of `B''`) is lifted by the monoidal transformation with empty
center (`LocSucc.lift_empty`); the hypothesis `E = ⋃ E_i` is not used (nor by Lemma 1 in Lean).

Gaps in the paper filled: `n̄ < N̄` and `n̄ ≤ n` (needed to apply `I₁^{N̄,n̄}`; the paper does not
check them); the centers of a permissible succession are nowhere dense (Remark 2 is stated for
such successions); `dim(_bW') = n` along the stages (the remark of p. 169, "`B` can not contain any
irreducible component of `W` if `ℜ` has restriction either closed or open", has no argument in the
paper: `DatumI.Raw.IsPermissibleClosed.not_pts_subset_of_mem_irreducibleComponents`);
`dim(B'') < dim(_bW')` (the generic point of `B''` is a specialization of a point of
`_bW' − _bF'`, by the density of `_bW' − _bF'` in `_bW'`); the "as is easily seen" permissibility of
`h` for `_bℜ'` and the emptiness of the localized centers; `g(F'' ∩ W'') ⊆ f(F' ∩ W')`; and the
finiteness of a closed set all of whose points have `dim_y X = N`
(`LocSucc.finite_of_forall_dimAt_eq`). -/
@[blueprint "prop:IV.1-1"
  (statement := /-- \textbf{Proposition 1} (Localization theorem on
    $(\mathfrak R^{N,n}_{\mathrm I},F)$)\textbf{.} Let $(N,n)$ be a pair of integers such that
    $N>n\ge0$. Let us assume that Theorems $\mathrm I_1^{N',n'}$ with $n'<N'<N$ and $n'\le n$
    and Theorems $\mathrm I_2^{N,n''}$ with $n''<n$ are proved. Then, given a resolution datum
    $(\mathfrak R^{N,n}_{\mathrm I},F)$ with
    $\mathfrak R^{N,n}_{\mathrm I}=(\bigcup_{i=1}^\alpha E_i;V_1,\dots,V_\beta;W)$ and with
    closed restriction $F$ on a non-singular irreducible algebraic scheme $X$, there exists a
    permissible succession of monoidal transformations, say $f\colon X'\to X$, for
    $(\mathfrak R^{N,n}_{\mathrm I},F)$ such that $f(F'\cap W')$ is at most a finite number of
    points at which $X$ has dimension $N$, where
    $f^*(\mathfrak R^{N,n}_{\mathrm I})=(\bigcup_{i=1}^{\alpha'}E_i';V_1',\dots,V_\beta';W')$
    and $f^*(\mathfrak R^{N,n}_{\mathrm I},F)=(f^*(\mathfrak R^{N,n}_{\mathrm I}),F')$.
    (p.\ 278.) -/)
  (proof := /-- Let $f\colon X'\to X$ be any permissible succession of monoidal
    transformations for the given resolution datum
    $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},F)$ on $X$; here we include the case in which
    $X'=X$ and $f$ is the identity isomorphism. Let us assume that $f(F'\cap W')$ has a point
    $x$ at which $X$ has dimension $<N$. Then we shall prove that there exists a permissible
    succession $f'\colon X''\to X'$ for $f^*(\mathfrak R)$ such that, if $g=f\circ f'$ and
    $g^*(\mathfrak R)=(g^*(\mathfrak R^{N,n}_{\mathrm I}),F'')$ with
    $g^*(\mathfrak R^{N,n}_{\mathrm I})=(\bigcup_iE_i'';V_1'',\dots,V_\beta'';W'')$, then
    $g(F''\cap W'')$ does not contain $x$. First of all, a morphism obtained by a succession
    of monoidal transformations is proper (\cref{lem:succession-proper}) and therefore
    $f(W'\cap F')$ and $g(W''\cap F'')$ must be closed subschemes of $X$; obviously
    $f(W'\cap F')\supseteq g(W''\cap F'')$, so such a $g$ makes the inclusion strict, and in
    view of the fact that we do not have any infinite sequence of strictly descending closed
    subsets on an algebraic scheme, the Proposition follows immediately.
    We prove the existence of $f'$. Let $S$ be the local ring of $X$ at $x$ and
    $\bar N=\dim S$; then $\dim X'_S=\dim S=\bar N<N$ (\cref{rem:IV.1-2}). Let
    $\mathfrak R'=f^*(\mathfrak R)$ and $\mathfrak R'_S$ the induced datum on $X'_S$
    (\cref{def:IV.1}); then $\mathfrak R'_S=((f^*(\mathfrak R^{N,n}_{\mathrm I}))_S,F'_S)$
    with $(f^*(\mathfrak R^{N,n}_{\mathrm I}))_S=(\bigcup_i(E_i')_S;(V_1')_S,\dots,
    (V_\beta')_S;W'_S)$, a resolution datum of type
    $\mathfrak R^{\bar N,\bar n}_{\mathrm I}$ with closed restriction $F'_S$ on $X'_S$, where
    $\bar n=\dim W'_S$ (\cref{rem:IV.1-1}). By assumption, Theorem
    $\mathrm I_1^{\bar N,\bar n}$ is verified (\cref{thm:I.2-I1}). Therefore we can find a
    permissible succession $\bar f=\{\bar f_j\colon\bar X_{j+1}\to\bar X_j\}$
    $(0\le j\le a-1)$ of $\bar X_0=X'_S$ for $\mathfrak R'_S$ such that, if
    $\bar f^*(\mathfrak R'_S)=({}_a\bar{\mathfrak R}^{\bar N,\bar n}_{\mathrm I},{}_a\bar F)$
    with ${}_a\bar{\mathfrak R}^{\bar N,\bar n}_{\mathrm I}=(\bigcup_i({}_a\bar E_i);
    {}_a\bar V_1,\dots,{}_a\bar V_\beta;{}_a\bar W)$, then ${}_a\bar F\cap{}_a\bar W$ is
    empty. Let ${}_0\bar{\mathfrak R}=\mathfrak R'_S$ and, for $0\le b\le a$,
    ${}_b\bar{\mathfrak R}$ the transform of ${}_0\bar{\mathfrak R}$ on $\bar X_b$ by
    $\{\bar f_j\}$ $(0\le j\le b-1)$.
    We shall prove that there exists a permissible succession of monoidal transformations of
    $X'$ for $\mathfrak R'$, say $f'=\{f_k'\colon X'_{k+1}\to X_k'\}$ for
    $0\le k\le k(a)-1$ where $X_0'=X'$, such that we have a sequence of integers
    $0=k(0)<\dots<k(a)$ and
    (1) $\bar X_j=(X_k')_S$ for $k(j)\le k\le k(j+1)-1$,
    (2) the center $B_k'$ of $f_k'$ in $X_k'$ for $k(j)\le k<k(j+1)-1$ is such that
    $(B_k')_S$ is the empty subscheme of $\bar X_j$,
    (3) the center $B'_{k(j+1)-1}$ of $f'_{k(j+1)-1}$ in $X'_{k(j+1)-1}$ induces the center of
    $\bar f_j$ in $\bar X_j=(X'_{k(j+1)-1})_S$.
    As is easily seen, this $f'$ together with $X''=X'_{k(a)}$ has the property required
    above, so the proof is reduced to the existence of such a sequence, which is done by
    induction on $j$, $0\le j\le a-1$.
    Suppose we have found a permissible succession $\{f_k'\colon X'_{k+1}\to X_k'\}$
    $(0\le k\le k(b)-1)$ of $X'$ for $\mathfrak R'$ having the properties (1)–(3) for all
    $j<b$, for a certain non-negative integer $b\le a-1$ (if $b=0$ this assumption is empty).
    Let ${}_b\mathfrak R'$ be the transform of $\mathfrak R'$ on $X'_{k(b)}$ by this
    succession. Then $\bar X_b=(X'_{k(b)})_S$ and ${}_b\bar{\mathfrak R}=({}_b\mathfrak
    R')_S$. Write ${}_b\mathfrak R'=({}_b\mathfrak R'^{N,n}_{\mathrm I},{}_bF')$ with
    ${}_b\mathfrak R'^{N,n}_{\mathrm I}=(\bigcup_i({}_bE_i');{}_bV_1',\dots,{}_bV_\beta';
    {}_bW')$ and correspondingly ${}_b\bar{\mathfrak R}$ with ${}_b\bar E_i=({}_bE_i')_S$,
    ${}_b\bar V_j=({}_bV_j')_S$ and ${}_b\bar W=({}_bW')_S$. Now let $\bar B_b$ be the center
    of the permissible monoidal transformation $\bar f_b$ of $\bar X_b$ for
    ${}_b\bar{\mathfrak R}$; then $\bar B_b$ is a non-singular irreducible subscheme of
    $\bar X_b$ with $\bar B_b\subseteq{}_b\bar W\cap{}_b\bar F$. Let $B''$ be the smallest
    irreducible subscheme of $X'_{k(b)}$ such that $\bar B_b=(B'')_S$. We then have
    $B''\subseteq{}_bW'\cap{}_bF'$, and $\dim(B'')<\dim({}_bW')=n$. Let $n''=\dim(B'')$ and
    consider the resolution datum ${}_b\mathfrak R''=(\mathfrak R^{N,n''}_{\mathrm I},U'')$,
    where $\mathfrak R^{N,n''}_{\mathrm I}=(\bigcup_i({}_bE_i');{}_bV_1',\dots,{}_bV_\beta',
    {}_bW';B'')$ and $U''$ is the set of those points of $B''$ at which
    $\mathfrak R^{N,n''}_{\mathrm I}$ is resolved, an open dense subset of $B''$ by
    \cref{lem:IV.1-1}. We note that $(B''-U'')_S$ is the empty subset of $\bar X_b$, because
    the monoidal transformation of $\bar X_b$ with center $\bar B_b=(B'')_S$ is permissible
    for ${}_b\bar{\mathfrak R}=({}_b\mathfrak R')_S$. Now, by assumption, Theorem
    $\mathrm I_2^{N,n''}$ is proved (\cref{thm:I.2-I2}). Therefore we have a permissible
    succession $h=\{f_k'\colon X'_{k+1}\to X_k'\}$ $(k(b)\le k\le k(b+1)-2)$ of $X'_{k(b)}$
    for the resolution datum ${}_b\mathfrak R''$ with open restriction $U''$ such that
    $h^*(\mathfrak R^{N,n''}_{\mathrm I})$ is resolved. As is easily seen, $h$ is permissible
    for ${}_b\mathfrak R'$ and the centers of the $f_k'$ in $X_k'$ induce the empty subscheme
    of $(X_k')_S$, because $(B''-U'')_S$ is the empty subset of $(X'_{k(b)})_S$. Let
    $h^*(\mathfrak R^{N,n''}_{\mathrm I})=(\bigcup_iE_i^*;V_1^*,\dots,V_\beta^*,W^*;B^*)$,
    which is a resolved resolution datum on $X'_{k(b+1)-1}$. We have
    $(X'_{k(b+1)-1})_S=\bar X_b$ and $(B^*)_S=\bar B_b$; moreover
    $h^*({}_b\mathfrak R'^{N,n}_{\mathrm I})=(\bigcup_iE_i^*;V_1^*,\dots,V_\beta^*;W^*)$ is
    resolved at every point of $B^*$, and if $F^*$ is the strict transform of ${}_bF'$ on
    $X'_{k(b+1)-1}$ then $h^*({}_b\mathfrak R')=(h^*({}_b\mathfrak R'^{N,n}_{\mathrm I}),F^*)$
    and $B^*\subseteq W^*\cap F^*$. Let $f'_{k(b+1)-1}\colon X'_{k(b+1)}\to X'_{k(b+1)-1}$ be
    the monoidal transformation with center $B^*$. Then $\{f_k'\}$ $(0\le k\le k(b+1)-1)$ is a
    permissible succession of monoidal transformations of $X'$ for $\mathfrak R'$, and we see
    immediately that it has the properties (1)–(3) for all $j\le b$. q.e.d.

    \textbf{Formalization note (encoding).} An empty center $\bar B_b$ (allowed by the agreement
    of p.~163, and not addressed by the construction of $B''$) is lifted by the monoidal
    transformation with empty center; the hypothesis $E=\bigcup_iE_i$ is not used.

    \textbf{Gaps in the paper filled.} Lean checks $\bar n<\bar N$ and $\bar n\le n$ (needed to
    apply Theorem $\mathrm I_1^{\bar N,\bar n}$); that the centers of a permissible succession
    are nowhere dense (needed for \cref{rem:IV.1-2}); that $\dim({}_bW')=n$ along the stages
    (``Note that $B$ can not contain any irreducible component of $W$ if $\mathfrak R$ has
    restriction either closed or open'', p.~169, is stated without argument: $W-W\cap F$ is dense
    in $W$, so every irreducible component of $W$ has a point off $F$, while $B\subseteq F$);
    $\dim(B'')<\dim({}_bW')$ from the density of ${}_bW'-{}_bF'$ in ${}_bW'$; and the ``easily
    seen'' steps (permissibility of $h$ for ${}_b\mathfrak R'$, emptiness of the localized
    centers, the required property of $f'$), as well as the finiteness of a closed set all of
    whose points have $\dim_yX=N$. -/)
  (latexEnv := "proposition")]
theorem exists_isPermissibleIClosed_finite_image_dimAt_eq [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [Hironaka.Cited.ExistsFlatIsLocalHomAdicCompletionOfFlat.{u}] [Hironaka.Cited.ExistsSurjectiveMvPowerSeriesOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationIffRankJacobianEqHeight.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] [Hironaka.Cited.IsRegularLocalRingOfFlatOfIsRegularLocalRing.{u}] (N n : ℕ) (hNn : n < N)
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' < N → n' ≤ n → FundamentalTheorem.I₁.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X)
    (_hE : (ℜ : DatumI.Raw X).IsUnionOfDivisors) (F : Subscheme X)
    (hF : (ℜ : DatumI.Raw X).IsClosedRestriction F)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞)) :
    ∃ (X' : Scheme.{u}) (s : MonoidalSuccession X X'),
      s.IsPermissibleIClosed ℜ F ∧
      (s.composite.base ''
          ((s.strictTransform F).pts ∩ (s.transformI ℜ).W.pts)).Finite ∧
      ∀ y ∈ s.composite.base ''
          ((s.strictTransform F).pts ∩ (s.transformI ℜ).W.pts),
        X.dimAt y = (N : WithBot ℕ∞) := by
  have := hX.1
  have := IsAlgebraicScheme.noetherianSpace X
  have := IsAlgebraicScheme.isNoetherian X
  have hstage : IsStageI N n X ℜ := ⟨hX, ℜ.2, hn⟩
  -- the states: permissible successions for `(ℜ, F)`, with the closed sets `f(F' ∩ W')`
  let σ := Σ X' : Scheme.{u}, {s : MonoidalSuccession X X' // s.IsPermissibleIClosed ℜ F}
  let Zf : σ → Set X := fun s => s.2.1.composite.base ''
    ((s.2.1.strictTransform F).pts ∩ (s.2.1.transformI ℜ).W.pts)
  have hZ : ∀ s, IsClosed (Zf s) := fun s =>
    s.2.1.isClosed_image_composite ((s.2.1.strictTransform F).support.isClosed.inter
      (s.2.1.transformI ℜ).W.support.isClosed)
  -- no infinite strictly descending chain of closed subsets (p. 278)
  obtain ⟨⟨X', s, hs⟩, hall⟩ := LocSucc.exists_forall_not_of_improve Zf hZ
    (fun x => X.dimAt x ≠ (N : WithBot ℕ∞)) (fun ⟨X', f, hf⟩ x hx hxN => by
      obtain ⟨X'', f', hf', hx'⟩ :=
        exists_isPermissibleIClosed_append_notMem_image N n hNn hI₁ hI₂ hX hstage hF f hf x hx hxN
      refine ⟨⟨X'', f.append f',
        (MonoidalSuccession.isPermissibleIClosed_append _ _ _ _).mpr ⟨hf, hf'⟩⟩, ?_, hx'⟩
      rintro _ ⟨y, ⟨hyF, hyW⟩, rfl⟩
      show (f.append f').composite y ∈ Zf ⟨X', f, hf⟩
      rw [MonoidalSuccession.composite_append, Scheme.Hom.comp_apply]
      refine ⟨f'.composite y, ⟨?_, ?_⟩, rfl⟩
      · rw [MonoidalSuccession.strictTransform_append] at hyF
        exact f'.pts_strictTransform_subset _ hyF
      · rw [MonoidalSuccession.transformI_append, MonoidalSuccession.transformI_W] at hyW
        exact f'.pts_strictTransform_subset _ hyW)
    ⟨X, MonoidalSuccession.nil X, trivial⟩
  have hall' : ∀ y ∈ Zf ⟨X', s, hs⟩, X.dimAt y = (N : WithBot ℕ∞) := fun y hy => by
    by_contra h
    exact hall y hy h
  exact ⟨X', s, hs, LocSucc.finite_of_forall_dimAt_eq (hZ ⟨X', s, hs⟩) hall', hall'⟩

/-! ### Proposition 2 (pp. 280–282): the localization theorem on `(ℜ^{N,n}_I, U)` -/

/-- Proposition 2, p. 280 (localization theorem on `(ℜ^{N,n}_I, U)`).

Deviation from the paper (statement modified): the paper writes "`f*(ℜ^{N,n}_I)` is resolved
at every point of `X' − f⁻¹(F)`"; since "resolved at `y`" is defined only for points `y` of the
principal subscheme `W'` (Def. 4 (I), p. 165), this is read as "at every point of
`W' − f⁻¹(F)`".

The index conditions are as printed (p. 280): "Theorem I₂^{N',n'} with n' < N' < N and n' ≤ n
and Theorems I₂^{N,n''} with n'' < n" (the first family is I₂, not I₁).

Proof as printed (pp. 280–281): "essentially the same as that of Proposition 1".  `T'` is the closed
subset of `X'` where `ℜ'` is not resolved (closed by Lemma 1); "we may replace `U'` by `W' − T'`";
`N̄ = dim S = dim X'_S` (Remark 2; the centers are nowhere dense), `n̄ = dim W'_S`, Theorem
`I₂^{N̄,n̄}` on `X'_S`, and the lifting of Proposition 1 (`LocSucc.lift_succession_open`) with
`dim(_bW') = n` along the stages (`IsStageI`) and `U''` open dense in `B''` by Lemma 1.  The finite
set `F` is `f(T')` for the final succession (`exists_isPermissibleIOpen_append_notMem_image_unresolvedSet`
and the descending chain argument `LocSucc.exists_forall_not_of_improve`).  As in Proposition 1,
an empty center is lifted by the monoidal transformation with empty center (encoding) and `hE` is
not used.

Gap in the paper filled: besides the steps listed for Proposition 1, the closedness of `T'`
(from Lemma 1), the replacement of `U'` by `W' − T'` (an open restriction containing `U'`,
so that permissibility for it implies permissibility for `U'`), the nowhere density of the
centers `B ⊆ W − U` (a proper closed subscheme), and `g(T'') ⊆ f(T')`. -/
@[blueprint "prop:IV.1-2"
  (statement := /-- \textbf{Proposition 2} (Localization theorem on
    $(\mathfrak R^{N,n}_{\mathrm I},U)$)\textbf{.} Let $(N,n)$ be a pair of integers such that
    $N>n\ge0$. Let us assume that Theorem $\mathrm I_2^{N',n'}$ with $n'<N'<N$ and $n'\le n$
    and Theorems $\mathrm I_2^{N,n''}$ with $n''<n$ are proved. Then, given a resolution datum
    $\mathfrak R=(\mathfrak R^{N,n}_{\mathrm I},U)$ with
    $\mathfrak R^{N,n}_{\mathrm I}=(\bigcup_{i=1}^\alpha E_i;V_1,\dots,V_\beta;W)$ and with
    open restriction $U$ on a non-singular irreducible algebraic scheme $X$, there exists a
    permissible succession of monoidal transformations, say $f\colon X'\to X$, for
    $\mathfrak R$ such that there exists a finite set of points $F$ of $X$ at which $X$ has
    dimension $N$ and $f^*(\mathfrak R^{N,n}_{\mathrm I})$ is resolved at every point of
    $X'-f^{-1}(F)$. (pp.\ 280–281.)

    \textbf{Deviation from the paper (statement modified).} ``Resolved at every point of
    $X'-f^{-1}(F)$'' is read as ``at every point of $W'-f^{-1}(F)$'', $W'$ being the principal
    subscheme of $f^*(\mathfrak R^{N,n}_{\mathrm I})$, since resolvedness is defined at the
    points of the principal subscheme only (Definition 4 (I), p.~165). -/)
  (proof := /-- The proof of Proposition 2 is essentially the same as that of
    \cref{prop:IV.1-1}. Let $f\colon X'\to X$ be any permissible succession of monoidal
    transformations of $X$ for the given resolution datum $\mathfrak R$, and
    $\mathfrak R'=f^*(\mathfrak R)$. Let $T'$ be the closed subset of $X'$ consisting of those
    points at which $\mathfrak R'$ is not resolved. Suppose we have a point $x\in f(T')$ at
    which $X$ has dimension $<N$, let $S$ be the local ring of $X$ at $x$ and
    $\bar N=\dim(S)=\dim X'_S$ (\cref{rem:IV.1-2}). Write
    $\mathfrak R'=(f^*(\mathfrak R^{N,n}_{\mathrm I}),U')$ with
    $f^*(\mathfrak R^{N,n}_{\mathrm I})=(\bigcup_iE_i';V_1',\dots,V_\beta';W')$; in the
    following arguments we may replace $U'$ by $W'-T'$. Let $\bar n=\dim(W'_S)$. Then
    $\mathfrak R'_S$ is a resolution datum of the type
    $\mathfrak R^{\bar N,\bar n}_{\mathrm I}$ with open restriction $U'_S$ on the non-singular
    irreducible scheme $X'_S$ (\cref{rem:IV.1-1}). By Theorem $\mathrm I_2^{\bar N,\bar n}$
    (\cref{thm:I.2-I2}) we have a permissible succession
    $\bar f=\{\bar f_j\colon\bar X_{j+1}\to\bar X_j\}$ $(0\le j\le a-1)$ of $\bar X_0=X'_S$
    for $\mathfrak R'_S$ such that $\bar f^*(\bar{\mathfrak R}^{\bar N,\bar n}_{\mathrm I})$
    is resolved. Exactly as in the proof of \cref{prop:IV.1-1} one constructs a permissible
    succession $\{f_k'\colon X'_{k+1}\to X_k'\}$ $(0\le k\le k(a)-1)$ of $X_0'=X'$ for
    $\mathfrak R'$ and integers $0=k(0)<k(1)<\dots<k(a)$ with (1) $\bar X_j=(X_k')_S$ for
    $k(j)\le k\le k(j+1)-1$, (2) the center $B_k'$ of $f_k'$ in $X_k'$ induces the empty
    subscheme of $\bar X_j=(X_k')_S$ for $k(j)\le k\le k(j+1)-2$, and (3) the center
    $B'_{k(j+1)-1}$ of $f'_{k(j+1)-1}$ in $X'_{k(j+1)-1}$ induces the center $\bar B_j$ of
    $\bar f_j$ in $\bar X_j=(X'_{k(j+1)-1})_S$: given the succession up to $k(b)-1$ with
    (1)–(3) for $j<b$, let ${}_b\mathfrak R'$ be the transform of $\mathfrak R'$ on
    $X'_{k(b)}$, so that $\bar X_b=(X'_{k(b)})_S$ and
    ${}_b\bar{\mathfrak R}=({}_b\mathfrak R')_S$; let $\bar B_b$ be the center of $\bar f_b$
    and $B''$ the smallest irreducible subscheme of $X'_{k(b)}$ with $\bar B_b=(B'')_S$. Since
    $\bar B_b\subseteq{}_b\bar W-{}_b\bar U$, we get $B''\subseteq{}_bW'-{}_bU'$, and
    obviously $\dim(B'')<\dim({}_bW')=n$; with $n''=\dim(B'')$ consider
    ${}_b\mathfrak R''=(\mathfrak R^{N,n''}_{\mathrm I},U'')$ where
    $\mathfrak R^{N,n''}_{\mathrm I}=(\bigcup_i({}_bE_i');{}_bV_1',\dots,{}_bV_\beta',{}_bW';
    B'')$ and $U''$ is the open subset of $B''$ consisting of the points at which it is
    resolved (\cref{lem:IV.1-1}). Since the monoidal transformation of $\bar X_b$ with center
    $\bar B_b=(B'')_S$ is permissible for ${}_b\bar{\mathfrak R}=({}_b\mathfrak R')_S$,
    $(B''-U'')_S$ is the empty subset of $\bar X_b=(X'_{k(b)})_S$. Applying Theorem
    $\mathrm I_2^{N,n''}$ (\cref{thm:I.2-I2}) to ${}_b\mathfrak R''$ we get a permissible
    succession $h=\{f_k'\}$ $(k(b)\le k\le k(b+1)-2)$ of $X'_{k(b)}$ for ${}_b\mathfrak R''$
    such that $h^*(\mathfrak R^{N,n''}_{\mathrm I})$ is resolved; writing
    $h^*(\mathfrak R^{N,n''}_{\mathrm I})=(\bigcup_iE_i^*;V_1^*,\dots,V_\beta^*,W^*;B^*)$ and
    letting $f'_{k(b+1)-1}$ be the monoidal transformation with center $B^*$, we get a
    permissible succession of monoidal transformations of $X'$ for $\mathfrak R'$ which has
    the properties (1)–(3) for all $j\le b$. q.e.d.

    \textbf{Formalization note (encoding).} As in \cref{prop:IV.1-1}, an empty center is lifted
    by the monoidal transformation with empty center, and $E=\bigcup_iE_i$ is not used.

    \textbf{Gaps in the paper filled.} Lean proves that $T'$ is closed (\cref{lem:IV.1-1}),
    that $W'-T'$ is an open restriction for $\mathfrak R'$ containing $U'$ (which justifies
    ``we may replace $U'$ by $W'-T'$''), that the centers $B\subseteq W-U$ are nowhere dense
    (a proper closed subscheme, as $U$ is dense in $W$), that $g(T'')\subseteq f(T')$, and the
    steps listed in \cref{prop:IV.1-1}. -/)
  (latexEnv := "proposition")]
theorem exists_isPermissibleIOpen_finite_dimAt_eq_resolvedAt_of_notMem_preimage [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [Hironaka.Cited.ExistsFlatIsLocalHomAdicCompletionOfFlat.{u}] [Hironaka.Cited.ExistsSurjectiveMvPowerSeriesOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationIffRankJacobianEqHeight.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] [Hironaka.Cited.IsRegularLocalRingOfFlatOfIsRegularLocalRing.{u}] (N n : ℕ) (hNn : n < N)
    (hI₂' : ∀ N' n' : ℕ, n' < N' → N' < N → n' ≤ n → FundamentalTheorem.I₂.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X)
    (_hE : (ℜ : DatumI.Raw X).IsUnionOfDivisors) (U : Set X)
    (hU : (ℜ : DatumI.Raw X).IsOpenRestriction U)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞)) :
    ∃ (X' : Scheme.{u}) (s : MonoidalSuccession X X'),
      s.IsPermissibleIOpen ℜ U ∧
      ∃ F : Set X, F.Finite ∧ (∀ y ∈ F, X.dimAt y = (N : WithBot ℕ∞)) ∧
        ∀ y ∈ (s.transformI ℜ).W.pts, y ∉ s.composite.base ⁻¹' F →
          (s.transformI ℜ).ResolvedAt y := by
  have := hX.1
  have := IsAlgebraicScheme.noetherianSpace X
  have := IsAlgebraicScheme.isNoetherian X
  have hstage : IsStageI N n X ℜ := ⟨hX, ℜ.2, hn⟩
  -- the states: permissible successions for `(ℜ, U)`, with the closed sets `f(T')`, `T'` the
  -- set of points of `W'` at which `f*(ℜ)` is not resolved
  let σ := Σ X' : Scheme.{u}, {s : MonoidalSuccession X X' // s.IsPermissibleIOpen ℜ U}
  let Zf : σ → Set X := fun s => s.2.1.composite.base '' (s.2.1.transformI ℜ).unresolvedSet
  have hT : ∀ s : σ, IsClosed (s.2.1.transformI ℜ).unresolvedSet := by
    rintro ⟨X', f, hf⟩
    obtain ⟨hstage', -⟩ := IsStageI.succession_open f hstage hU hf
    obtain ⟨U₀, hU₀, hU₀eq⟩ :=
      resolvedSetIsOpen_holds X' hstage'.1.1 hstage'.1.2.1 _ hstage'.2.1
    have : (f.transformI ℜ).unresolvedSet = (f.transformI ℜ).W.pts ∩ U₀ᶜ := by
      ext y
      have := congrArg (y ∈ ·) hU₀eq
      simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, eq_iff_iff] at this
      simp only [DatumI.Raw.unresolvedSet, Set.mem_ofPred_eq, Set.mem_inter_iff,
        Set.mem_compl_iff]
      tauto
    rw [this]
    exact (f.transformI ℜ).W.support.isClosed.inter hU₀.isClosed_compl
  have hZ : ∀ s, IsClosed (Zf s) := fun s => s.2.1.isClosed_image_composite (hT s)
  obtain ⟨⟨X', s, hs⟩, hall⟩ := LocSucc.exists_forall_not_of_improve Zf hZ
    (fun x => X.dimAt x ≠ (N : WithBot ℕ∞)) (fun ⟨X', f, hf⟩ x hx hxN => by
      obtain ⟨X'', f', hf', hsub, hx'⟩ :=
        exists_isPermissibleIOpen_append_notMem_image_unresolvedSet N n hNn hI₂' hI₂ hX hstage hU f hf x hx hxN
      refine ⟨⟨X'', f.append f',
        (MonoidalSuccession.isPermissibleIOpen_append _ _ _ _).mpr ⟨hf, hf'⟩⟩, ?_, hx'⟩
      rintro _ ⟨y, hy, rfl⟩
      show (f.append f').composite y ∈ Zf ⟨X', f, hf⟩
      rw [MonoidalSuccession.composite_append, Scheme.Hom.comp_apply]
      exact ⟨f'.composite y, hsub ⟨y, hy, rfl⟩, rfl⟩)
    ⟨X, MonoidalSuccession.nil X, trivial⟩
  have hall' : ∀ y ∈ Zf ⟨X', s, hs⟩, X.dimAt y = (N : WithBot ℕ∞) := fun y hy => by
    by_contra h
    exact hall y hy h
  refine ⟨X', s, hs, Zf ⟨X', s, hs⟩, LocSucc.finite_of_forall_dimAt_eq (hZ ⟨X', s, hs⟩) hall',
    hall', fun y hyW hyF => ?_⟩
  by_contra hres
  exact hyF ⟨y, ⟨hyW, hres⟩, rfl⟩

/-! ### Proposition 3 (pp. 282–285): the localization theorem on `(ℜ^N_II, F)` -/

/-- Proposition 3, p. 282 (localization theorem on `(ℜ^N_II, F)`).

Formalization note (encoding): the conclusion of the paper is about `S_ν(f*(ℜ^N_II)) ∩ F'`
with `ν = ν(ℜ^N_II)` the order of the *given* datum (the subscript `ν` is printed, p. 283, and
`ν` is introduced in the hypothesis "we assume that ν = ν(ℜ^N_II) > 0"); this is
`DatumII.Raw.sNu` applied to `ν(ℜ)`, exactly as in Theorem II₁^N.

Correction of the paper (proof): the facts of p. 283 (`ν(J'_{x'}) ≤ ν(J_{f(x')})` for every
`x' ∈ X'`, `f(S_i(f*ℜ)) ⊆ S_i(ℜ)`, `ν(f*ℜ) ≤ ν(ℜ)`) are attributed by the paper to Lemma 8 of
Ch. III §3, which is stated only for monoidal transforms that are residually algebraic over
the base (p. 217); at a non-closed point of a fibre the local ring of `X'` is not.  Lean
(`Hironaka/Compat/LocalizeSuccessionII.lean`, `LocSucc.nu_weakTransformIdeal_le`) reduces the
general case to Lemma 8 by Theorem 1 of Ch. III §3 (`thm:III.1`): the monoidal transform is a
localization of a residually algebraic one.

Deviation from the paper (encoding): the paper's "`_bℜ̄ = (_bℜ')_S`" holds only up
to the identification of p. 275 ("all that are essential among its characteristics are … the
non-empty `E_i`, the integers `a(E) = ∑_{E_i = E} a_i`, `J` and `b`"): the monoidal
transformations of `X'` whose centers induce the empty subscheme of `X'_S` add components
`E_{α+1}` which are empty on `X'_S`, so the expressions differ.  Lean proves the correspondence
as `DatumII.Raw.SameChar`.

Proof as printed (pp. 282–285): `x`, `S`, `N̄ = dim S = dim X'_S < N` (Remark 2,
`exists_lt_isAmbient_localizeScheme_of_dimAt_ne_of_isPermissibleII`); `ν = ν(f*ℜ) = ν(f*ℜ)_S`;
Theorem `II₁^{N̄}` gives `f̄` with `S_ν(ᵃℜ̄) ∩ ᵃF̄ = ∅`; "we may assume that this last condition is
not satisfied if we omit the last transformation `f̄_{a−1}`"
(`MonoidalSuccession.exists_isMinimalSNuEmptyIIClosed`, `MonoidalSuccession.IsMinimalSNuEmptyIIClosed`);
then the lifting (1)–(3) by induction on `b` (`LocSucc.lift_successionII`, one step
`LocSucc.lift_stepII` and `LocSucc.lift_transformationII`): `B''` the smallest irreducible subscheme
with `B̄_b = (B'')_S`, `n'' = dim B''`, Theorem `I₂^{N,n''}` for `(⋃ _bE_i'; B'')` with `U''` the
resolved points, and the permissibility of `h` for `_bℜ'` with the printed invariant "`_kB'' ⊆
S_*(_kℜ^N_II) = S_ν(_kℜ^N_II)` as well as in `_kF'`", using "`_kC ≠ _kB''` (for `_kU''` is not
empty)" and "`_{k+1}B''` must be contained in `S_ν(_{k+1}ℜ^N_II)`"
(`MonoidalSuccession.isPermissibleIIClosed_of_isPermissibleIOpen_of_nonempty`).

Gap in the paper filled: `n'' = dim B'' < N` (as `B'' ⊆ S_ν`, which misses the
generic point); `(⋃ E_i; B'')` is a type I datum; and, for the transforms to correspond, `B*`
lies on exactly those `E_i` whose localizations contain `B̄_b` and `ν((h*ℜ)_S) = ν(h*ℜ)`. -/
@[blueprint "prop:IV.1-3"
  (statement := /-- \textbf{Proposition 3} (Localization theorem on
    $(\mathfrak R^N_{\mathrm{II}},F)$)\textbf{.} Let $N$ be a positive integer. Let us assume
    that Theorems $\mathrm{II}_1^{N'}$ with $N'<N$ and Theorems $\mathrm I_2^{N,n}$ with $n<N$
    are verified. Let $\mathfrak R=(\mathfrak R^N_{\mathrm{II}},F)$, with
    $\mathfrak R^N_{\mathrm{II}}=\big(E_1,\dots,E_\alpha\,\big|\,J,b\,\big|\,
    a_1,\dots,a_\alpha\big)$ and with closed restriction $F$, be a resolution datum on a
    non-singular irreducible algebraic scheme $X$. We assume that
    $\nu=\nu(\mathfrak R^N_{\mathrm{II}})>0$. Then there exists a permissible succession of
    monoidal transformations of $X$ for $\mathfrak R$, $f\colon X'\to X$, such that, if we
    write $f^*(\mathfrak R)=(f^*(\mathfrak R^N_{\mathrm{II}}),F')$ with
    $f^*(\mathfrak R^N_{\mathrm{II}})=\big(E_1',\dots,E_{\alpha'}'\,\big|\,J',b\,\big|\,
    a_1,\dots,a_{\alpha'}\big)$, then $f\big(S_\nu(f^*(\mathfrak R^N_{\mathrm{II}}))\cap
    F'\big)$ is a finite set of points of $X$ at which $X$ has dimension $N$.
    (pp.\ 282–283.) -/)
  (proof := /-- The principle of the proof is the same as that for \cref{prop:IV.1-1} and
    \cref{prop:IV.1-2}. Let $f\colon X'\to X$ be any permissible succession of monoidal
    transformations for the given $\mathfrak R$ and $\mathfrak R'=f^*(\mathfrak R)=
    (f^*(\mathfrak R^N_{\mathrm{II}}),F')$. We assume that
    $f(S_\nu(f^*(\mathfrak R^N_{\mathrm{II}}))\cap F')$ contains a point $x$ at which $X$ has
    dimension $\bar N<N$; let $S$ be the local ring of $X$ at $x$, so that $\dim(X'_S)=\bar N$
    (\cref{rem:IV.1-2}) and $\mathfrak R'_S$ is a resolution datum on $X'_S$ of the type
    $\mathfrak R^{\bar N}_{\mathrm{II}}$ with closed restriction $F'_S$ (\cref{rem:IV.1-1}).
    First of all we remark that, for $f\colon X'\to X$ as above in general, if $x'\in X'$ then
    $\nu(J'_{x'})\le\nu(J_{f(x')})$ by Lemma 8 of \S3, Ch.\ III (\cref{lem:III.8}), that
    $f(S(f^*(\mathfrak R^N_{\mathrm{II}})))\subseteq S(\mathfrak R^N_{\mathrm{II}})$, and
    moreover that, for every non-negative integer $i$,
    $f(S_i(f^*(\mathfrak R^N_{\mathrm{II}})))\subseteq S_i(\mathfrak R^N_{\mathrm{II}})$. Now,
    with $x$ and $S$ as above, we must have
    $\nu=\nu(f^*(\mathfrak R^N_{\mathrm{II}}))=\nu((f^*(\mathfrak R^N_{\mathrm{II}}))_S)$.
    Write $\mathfrak R'_S=(\bar{\mathfrak R}^{\bar N}_{\mathrm{II}},\bar F)$ with
    $\bar{\mathfrak R}^{\bar N}_{\mathrm{II}}=\big(\bar E_1,\dots,\bar E_{\alpha'}\,\big|\,
    \bar J,b\,\big|\,a_1,\dots,a_{\alpha'}\big)$, $\bar F=F'_S$, $\bar E_i=(E_i')_S$ and
    $\bar J=J'_S$. By Theorem $\mathrm{II}_1^{\bar N}$ (\cref{thm:I.2-II1}) we have a
    permissible succession $\bar f=\{\bar f_j\colon\bar X_{j+1}\to\bar X_j\}$
    $(0\le j\le a-1)$ of $\bar X_0=X'_S$ for $\mathfrak R'_S$ such that, if
    $\bar f^*(\mathfrak R'_S)=({}_a\bar{\mathfrak R}^{\bar N}_{\mathrm{II}},{}_a\bar F)$, then
    $S_\nu({}_a\bar{\mathfrak R}^{\bar N}_{\mathrm{II}})\cap{}_a\bar F$ is empty; we may assume
    that this last condition fails if we omit the last transformation
    $\bar f_{a-1}\colon\bar X_a\to\bar X_{a-1}$. Let ${}_b\bar{\mathfrak R}$ be the transform
    of ${}_0\bar{\mathfrak R}=\mathfrak R'_S$ on $\bar X_b$ $(0\le b\le a)$.
    We prove that there exists a permissible succession
    $\{f_k'\colon X'_{k+1}\to X_k'\}$ $(0\le k\le k(a)-1)$ of $X_0'=X'$ for $\mathfrak R'$ and
    integers $0=k(0)<k(1)<\dots<k(a)$ such that (1) $\bar X_j=(X_k')_S$ for
    $k(j)\le k\le k(j+1)-1$, (2) the center $B_k'$ of $f_k'$ in $X_k'$ induces the empty
    subscheme of $\bar X_j=(X_k')_S$ for $k(j)\le k\le k(j+1)-2$, and (3) the center
    $B'_{k(j+1)-1}$ of $f'_{k(j+1)-1}$ in $X'_{k(j+1)-1}$ induces the center $\bar B_j$ of
    $\bar f_j$ in $\bar X_j=(X'_{k(j+1)-1})_S$. Assume this found for all $j<b$, let
    ${}_b\mathfrak R'$ be the transform of $\mathfrak R'$ on $X'_{k(b)}$, so that
    $\bar X_b=(X'_{k(b)})_S$ and ${}_b\bar{\mathfrak R}=({}_b\mathfrak R')_S$, and let
    $\bar B_b$ be the center of the permissible monoidal transformation $\bar f_b$ of
    $\bar X_b$ for ${}_b\bar{\mathfrak R}$. Let $B''$ be the smallest irreducible subscheme of
    $X'_{k(b)}$ such that $\bar B_b=(B'')_S$, and $n''=\dim(B'')<N$. Consider the resolution
    datum with open restriction ${}_b\mathfrak R''=(\mathfrak R^{N,n''}_{\mathrm I},U'')$ on
    $X'_{k(b)}$, with $\mathfrak R^{N,n''}_{\mathrm I}=(\bigcup_i({}_bE_i');B'')$ where $U''$
    is the open subset of $B''$ consisting of those points at which it is resolved
    (\cref{lem:IV.1-1}); note that $(B''-U'')_S$ is empty, because $\bar f_b$ with center
    $(B'')_S$ is permissible for ${}_b\bar{\mathfrak R}=({}_b\mathfrak R')_S$. Applying
    Theorem $\mathrm I_2^{N,n''}$ (\cref{thm:I.2-I2}) to ${}_b\mathfrak R''$ we get a
    permissible succession $h=\{f_k'\}$ $(k(b)\le k\le k(b+1)-2)$ of $X'_{k(b)}$ for
    ${}_b\mathfrak R''$ such that $h^*(\mathfrak R^{N,n''}_{\mathrm I})$ is resolved. We claim
    that $h$ is permissible for ${}_b\mathfrak R'$ as well: writing, for
    $k(b)\le k\le k(b+1)-1$, ${}_k\mathfrak R''=({}_k\mathfrak R^{N,n''}_{\mathrm I},{}_kU'')$
    with ${}_k\mathfrak R^{N,n''}_{\mathrm I}=(\bigcup_i({}_kE_i');{}_kB'')$ for the
    transforms of ${}_b\mathfrak R''$, and ${}_k\mathfrak R'$ for the transforms of
    ${}_b\mathfrak R'$, suppose ${}_k\mathfrak R'=({}_k\mathfrak R^N_{\mathrm{II}},{}_kF')$
    and that ${}_kB''$ is contained in $S_*({}_k\mathfrak R^N_{\mathrm{II}})=
    S_\nu({}_k\mathfrak R^N_{\mathrm{II}})$ as well as in ${}_kF'$ (this is certainly the case
    for $k=k(b)$). The monoidal transformation $f_k'$ with center ${}_kC$, which is
    permissible for ${}_k\mathfrak R''$, is clearly permissible for ${}_k\mathfrak R'$ because
    ${}_kC\subseteq{}_kB''$; since ${}_kC\ne{}_kB''$ (for ${}_kU''$ is not empty),
    ${}_{k+1}B''$ must be contained in $S_\nu({}_{k+1}\mathfrak R^N_{\mathrm{II}})$, and hence
    $S_\nu({}_{k+1}\mathfrak R^N_{\mathrm{II}})=S_*({}_{k+1}\mathfrak R^N_{\mathrm{II}})$, and
    ${}_{k+1}\mathfrak R'$ can be written in the same way. We thus conclude that $h$ is
    permissible for ${}_b\mathfrak R'$ as well as for ${}_b\mathfrak R''$, and for the same
    reason that, if $B_*={}_kB$ [sic; ${}_kB''$ is meant] with $k=k(b+1)-1$, the monoidal
    transformation $f'_{k(b+1)-1}\colon X'_{k(b+1)}\to X'_{k(b+1)-1}$ with center $B_*$ is
    permissible for ${}_k\mathfrak R'$. Thus we get a permissible succession of monoidal
    transformations of $X'$ for $\mathfrak R'$ with the properties (1)–(3) for all $j\le b$.
    q.e.d.

    \textbf{Paper misprint.} On p.~285 the paper prints ``$B_*={}_kB$''; ${}_kB''$ (the
    strict transform of $B''$ on $X'_{k(b+1)-1}$) is meant.

    \textbf{Correction of the paper (proof).} The facts of p.~283 are attributed to Lemma~8 of
    \S3, Ch.~III (\cref{lem:III.8}), which is stated only for residually algebraic monoidal
    transforms; Lean reduces the general case to it by Theorem~1 of \S3, Ch.~III
    (\cref{thm:III.1}), a monoidal transform being a localization of a residually algebraic
    one.

    \textbf{Deviation from the paper (encoding).} The equality
    ${}_b\bar{\mathfrak R}=({}_b\mathfrak R')_S$ holds only up to the identification of p.~275
    (same non-empty $E_i$, same $a(E)$, $J$ and $b$): centers inducing the empty subscheme of
    $X'_S$ add exceptional components that are empty on $X'_S$; Lean carries this
    correspondence. The rest follows the printed route: $\bar N=\dim S=\dim X'_S$ by Remark~2, the
    minimal $a$ is chosen first and the lifting is carried out for all of $\bar f$, and the
    permissibility of $h$ for ${}_b\mathfrak R'$ is proved with the printed invariants
    (${}_kB''\subseteq S_*({}_k\mathfrak R^N_{\mathrm{II}})=S_\nu({}_k\mathfrak R^N_{\mathrm{II}})$,
    ${}_kU''\ne\emptyset$, ${}_kC\ne{}_kB''$).

    \textbf{Gap in the paper filled.} Lean checks $n''<N$, that
    $(\bigcup_i({}_bE_i');B'')$ is a resolution datum of type I, and that the lifted
    transformation reproduces the transform on $X'_S$, which needs $B_*\subseteq{}_kE_i'$ if and
    only if $\bar B_b\subseteq({}_kE_i')_S$, and
    $\nu(({}_k\mathfrak R')_S)=\nu({}_k\mathfrak R')$. -/)
  (latexEnv := "proposition")]
theorem exists_isPermissibleIIClosed_finite_image_Snu_dimAt_eq [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [Hironaka.Cited.CurveFiniteIntegralClosure.{u}] [Hironaka.Cited.ExistsFlatIsLocalHomAdicCompletionOfFlat.{u}] [Hironaka.Cited.ExistsSurjectiveMvPowerSeriesOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationIffRankJacobianEqHeight.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] [Hironaka.Cited.IsRegularLocalRingOfFlatOfIsRegularLocalRing.{u}] (N : ℕ) (_hN : 0 < N)
    (hII₁ : ∀ N' : ℕ, N' < N → FundamentalTheorem.II₁.{u} N')
    (hI₂ : ∀ n : ℕ, n < N → FundamentalTheorem.I₂.{u} N n)
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumII X) (F : Subscheme X)
    (hF : (ℜ : DatumII.Raw X).IsClosedRestriction F)
    (hν : 0 < (ℜ : DatumII.Raw X).nu) :
    ∃ (X' : Scheme.{u}) (s : MonoidalSuccession X X'),
      s.IsPermissibleIIClosed ℜ F ∧
      (s.composite.base ''
          ((s.transformII ℜ).sNu (ℜ : DatumII.Raw X).nu ∩
            (s.strictTransform F).pts)).Finite ∧
      ∀ y ∈ s.composite.base ''
          ((s.transformII ℜ).sNu (ℜ : DatumII.Raw X).nu ∩
            (s.strictTransform F).pts),
        X.dimAt y = (N : WithBot ℕ∞) := by
  have := hX.1
  have := IsAlgebraicScheme.noetherianSpace X
  have := IsAlgebraicScheme.isNoetherian X
  have hℜ : (ℜ : DatumII.Raw X).IsDatum := ℜ.2
  set ν := (ℜ : DatumII.Raw X).nu with hνdef
  -- the states: permissible successions for `(ℜ, F)`, with the closed sets `f(S_ν(f*ℜ) ∩ F')`
  let σ := Σ X' : Scheme.{u}, {s : MonoidalSuccession X X' // s.IsPermissibleIIClosed ℜ F}
  let Zf : σ → Set X := fun s => s.2.1.composite.base ''
    ((s.2.1.transformII ℜ).sNu ν ∩ (s.2.1.strictTransform F).pts)
  have hZ : ∀ s, IsClosed (Zf s) := by
    rintro ⟨X', f, hf⟩
    obtain ⟨hX', -⟩ := f.isAmbient_transformII hX ℜ hℜ hf.isPermissibleII
    have := hX'.1
    exact f.isClosed_image_composite ((LocSucc.isClosed_sNu hX'.2.1 _ ν).inter
      (f.strictTransform F).support.isClosed)
  obtain ⟨⟨X', s, hs⟩, hall⟩ := LocSucc.exists_forall_not_of_improve Zf hZ
    (fun x => X.dimAt x ≠ (N : WithBot ℕ∞)) (fun ⟨X', f, hf⟩ x hx hxN => by
      obtain ⟨X'', f', hf', hx'⟩ :=
        exists_isPermissibleIIClosed_append_notMem_image_Snu N hII₁ hI₂ hX hℜ hF hν f hf x hx hxN
      refine ⟨⟨X'', f.append f',
        (MonoidalSuccession.isPermissibleIIClosed_append _ _ _ _).mpr ⟨hf, hf'⟩⟩, ?_, hx'⟩
      obtain ⟨hX', hℜ'⟩ := f.isAmbient_transformII hX ℜ hℜ hf.isPermissibleII
      have := hX'.1
      rintro _ ⟨y, ⟨hyS, hyF⟩, rfl⟩
      show (f.append f').composite y ∈ Zf ⟨X', f, hf⟩
      rw [MonoidalSuccession.composite_append, Scheme.Hom.comp_apply]
      refine ⟨f'.composite y, ⟨?_, ?_⟩, rfl⟩
      · rw [MonoidalSuccession.transformII_append] at hyS
        exact f'.mem_sNu_of_mem_sNu_transformII hX'.2.1 _ hℜ' hf'.isPermissibleII hyS
      · rw [MonoidalSuccession.strictTransform_append] at hyF
        exact f'.pts_strictTransform_subset _ hyF)
    ⟨X, MonoidalSuccession.nil X, trivial⟩
  have hall' : ∀ y ∈ Zf ⟨X', s, hs⟩, X.dimAt y = (N : WithBot ℕ∞) := fun y hy => by
    by_contra h
    exact hall y hy h
  exact ⟨X', s, hs, LocSucc.finite_of_forall_dimAt_eq (hZ ⟨X', s, hs⟩) hall', hall'⟩

/-! ### Proposition 4 (p. 286): the localization theorem on `ℜ^N_II` -/

/-- Proposition 4, p. 286 (localization theorem on `ℜ^N_II`).

The first assumed family is II₂ as printed (p. 286: "Theorems II₂^{N'} with N' < N and
Theorems I₂^{N,n} with n < N are verified"), not II₁ as in Proposition 3; this is what the
proof needs, the datum on `X'_S` carrying no restriction.

Proof as printed (p. 286: "The proof is entirely similar to that of Proposition 3"): the argument of
Proposition 3 is carried out for a datum without restriction.  As in Proposition 3 the closed sets
`f(S_ν(f*ℜ))` of successive permissible successions are compared; a point `x` of such a set at which
`X` has dimension `< N` is removed by a further succession
(`exists_isPermissibleII_append_notMem_image_Snu`).  The latter is the argument of pp. 282–285
with no `F`: `X'_S` is ambient of dimension `N̄ < N`; Theorem `II₂^{N̄}` (the induction hypothesis of
Proposition 4, in place of `II₁^{N̄}`) gives `f̄` with `f̄*ℜ'_S` resolved, i.e. `S_ν(f̄*ℜ'_S) = ∅`;
`f̄` is made minimal ("we may assume that this last condition is not satisfied if we omit the last
transformation", `MonoidalSuccession.exists_isMinimalSNuEmptyII`) and lifted step by step
(`LocSucc.lift_successionII_unrestricted`, in
`Hironaka/Compat/LocalizeSuccessionIIUnrestricted.lean`: the centers `B'' ⊆ S_*(_kℜ)`, Theorem
`I₂^{N,n''}` on `(⋃ E_i; B'')`, the permissibility of `h` for `_bℜ'` with the printed invariants
(`MonoidalSuccession.isPermissibleII_of_isPermissibleIOpen_of_nonempty`), the correspondence of the
transforms); `N̄ = dim S` by Remark 2 as in Proposition 3.

The hypothesis `ν(ℜ) > 0` is not used: in Proposition 3 it serves to apply Theorem `II₁^{N̄}`
(which assumes `ν(ℜ̄) > 0`), while Theorem `II₂^{N̄}` assumes nothing.  The notes of Proposition 3
(Lemma 8 via Theorem 1, `SameChar`) apply. -/
@[blueprint "prop:IV.1-4"
  (statement := /-- \textbf{Proposition 4} (Localization theorem on
    $\mathfrak R^N_{\mathrm{II}}$)\textbf{.} Let $N$ be a positive integer. Let us assume that
    Theorems $\mathrm{II}_2^{N'}$ with $N'<N$ and Theorems $\mathrm I_2^{N,n}$ with $n<N$ are
    verified. Let $\mathfrak R^N_{\mathrm{II}}=\big(E_1,\dots,E_\alpha\,\big|\,J,b\,\big|\,
    a_1,\dots,a_\alpha\big)$ be a resolution datum (without restriction) on a non-singular
    irreducible algebraic scheme $X$. We assume that $\nu(\mathfrak R^N_{\mathrm{II}})>0$.
    Then there exists a permissible succession of monoidal transformations of $X$ for
    $\mathfrak R^N_{\mathrm{II}}$, say $f\colon X'\to X$, such that, if
    $\nu=\nu(\mathfrak R^N_{\mathrm{II}})$, then $f(S_\nu(f^*(\mathfrak R^N_{\mathrm{II}})))$
    is a finite set of points (at most) of $X$ at which $X$ has dimension $N$.
    (p.\ 286.) -/)
  (proof := /-- The proof is entirely similar to that of \cref{prop:IV.1-3}. (In the proof of
    Proposition 3 the datum induced on $X'_S$ carries the closed restriction $F'_S$ and
    Theorem $\mathrm{II}_1^{\bar N}$ is applied to it; here it carries no restriction and
    Theorem $\mathrm{II}_2^{\bar N}$ (\cref{thm:I.2-II2}) is applied instead, which is the
    assumption of the present proposition.)

    In Lean this is carried out as follows. As in \cref{prop:IV.1-3}, a point $x$ of
    $f(S_\nu(f^*(\mathfrak R^N_{\mathrm{II}})))$ at which $X$ has dimension $\bar N<N$ is removed by
    a further succession: $\bar N=\dim X'_S<N$; Theorem $\mathrm{II}_2^{\bar N}$ gives a succession
    $\bar f$ of $X'_S$ permissible for $\mathfrak R'_S$ with $\bar f^*(\mathfrak R'_S)$ resolved
    everywhere, so that $S_\nu({}_a\bar{\mathfrak R}^{\bar N}_{\mathrm{II}})$ is empty; $\bar f$ is
    lifted to a permissible succession of $X'$ for $\mathfrak R'$ by the construction of
    \cref{prop:IV.1-3} with no closed restriction (the centers $B''$ lie in
    $S_\nu({}_k\mathfrak R^N_{\mathrm{II}})$ only), and this succession removes $x$.

    \textbf{Note (hypothesis not used).} The hypothesis
    $\nu(\mathfrak R^N_{\mathrm{II}})>0$ is not used: in \cref{prop:IV.1-3} it serves to apply
    Theorem $\mathrm{II}_1^{\bar N}$, while Theorem $\mathrm{II}_2^{\bar N}$ needs no such
    hypothesis. The notes of \cref{prop:IV.1-3} (Lemma 8 via Theorem 1 of \S3, the
    identification of p.~275) apply. -/)
  (latexEnv := "proposition")]

/-!
# Ch. IV §3 (p. 310): the outer layers of the proof of Theorems A* and B*

The proof of Theorems A*, B* (pp. 307-310) fixes a prepared permissible succession `g_s` and a point
`x_0` of `g_s(S(ℜ(s)))` and then (p. 310)

> "Therefore, by replacing the original succession `g_s : X_s → X` to include such an additional
> succession, we may assume that `ℜ^{N-1}_II` is resolved.  This means that `ν_x(J̄(s)) < b` for
> every point `x` of `X̃ = X_s`.  By virtue of Corollary of Lemma (AB. 4), it implies that there
> exists no point `x` of `X_s` having the properties (1), (2) and (3) of Lemma (AB. 4) with
> reference to the point `x_0 ∈ g_s(S(ℜ(s)))`. … Now, `g_s(S(ℜ(s)))` consists of a finite number of
> points at which `X` has dimension `N`, and therefore, repeating the above process at most a finite
> number of times, we achieve the demonstration of Theorems A* and B*."

This file formalizes these three layers, the lifting of one block being a hypothesis
(`OneBlockHyp`, proved in `Hironaka/Ch4/AStarBStarLifting.lean`):

* `Remark 3 (a)` for the emptied weak datum (`mem_S_emptyIfBot_datumII_of_le_nu`), and
  "not improved ⟹ conditions (1), (2), (3) of Lemma (AB.4)" (`exists_cond_of_not_isImprovedAt`);
* **M11**, the end: if the emptied auxiliary datum `ℜ^{N-1}_II` is resolved at the stage `g`, then
  `x_0` is improved at `g` (`isImprovedAt_of_stageResolvable_zero`);
* **M10**, the induction on the length of the resolving succession of `X̃`
  (`exists_extension_of_resolvableLen`), with one block `OneBlockStep` at each step;
* **KP**, the one-point step (`onePointStep_of_oneBlockStep`): the base is Theorem `II₂^{N-1}`
  (`resolvable_datumII_emptyIfBot`) for the point of dimension `N - 1` given by the corrected
  Corollary of Lemma (AB.4);
* **M12**, the finite iteration (`exists_hasEffectiveProperties_of_onePointStep`), and the
  conclusions of Theorems A*, B* from the one-block lemma
  (`exists_isPermissibleIClosed_hasEffectiveProperties_of_oneBlockHyp`,
  `exists_isPermissibleIOpen_hasEffectiveProperties_of_oneBlockHyp`).

The auxiliary datum is the repaired one (repair of the paper's error on the subschemes `Ẽ_j`): the entries equal to
the whole space are emptied (`DatumII.Raw.emptyIfBot`), and Theorem `II₂^{N-1}` is applied to the
weak datum (`resolvable_datumII_emptyIfBot`).  The printed Theorems A*, B* are in
`TheoremsAB.lean`.
-/

@[expose] public section

open AlgebraicGeometry IsLocalRing CategoryTheory CategoryTheory.Limits

namespace Hironaka

universe u

noncomputable section

section WeakOrder

variable {X : Scheme.{u}}

/-- The ideal of a non-singular subscheme which is everywhere of codimension one is principal at
each of its points, generated by a regular parameter (an element of `M ∖ M²`). -/
theorem Subscheme.exists_stalkIdeal_eq_span_and_notMem_sq_of_isNonsingularDivisor
    (hX : X.IsNonsingular) {E : Subscheme X} (hE : E.IsNonsingularDivisor) {x : X}
    (hx : x ∈ E.pts) :
    ∃ e : X.presheaf.stalk x, E.stalkIdeal x = Ideal.span {e} ∧
      e ∈ maximalIdeal (X.presheaf.stalk x) ∧ e ∉ maximalIdeal (X.presheaf.stalk x) ^ 2 := by
  have : IsRegularLocalRing (X.presheaf.stalk x) := hX x
  have hEp : (E.stalkIdeal x).IsPrime := Subscheme.isPrime_stalkIdeal_of_isNonsingular hE.1 hx
  have hEreg : IsRegularLocalRing (X.presheaf.stalk x ⧸ E.stalkIdeal x) :=
    Subscheme.isRegularLocalRing_quotient_of_isNonsingular hE.1 hx
  have hE1 : (E.stalkIdeal x).height = 1 := by
    have := hE.2 x hx
    simpa [Subscheme.codimAt] using this
  have hne : E.stalkIdeal x ≠ ⊥ := fun h => by
    rw [h, Ideal.height_bot] at hE1
    exact absurd hE1 (by simp)
  obtain ⟨e, hee, he0⟩ := exists_span_singleton_of_height_le_one (E.stalkIdeal x) hEreg hne hE1.le
  have hem : e ∈ maximalIdeal (X.presheaf.stalk x) :=
    Subscheme.stalkIdeal_le_maximalIdeal E hx (hee ▸ Ideal.mem_span_singleton_self e)
  refine ⟨e, hee, hem, ?_⟩
  have : IsRegularLocalRing (X.presheaf.stalk x ⧸ Ideal.span {e}) := hee ▸ hEreg
  exact rsop_notMem_sq_of_quotient hem he0


/-- **Remark 3 (a), the converse direction, for a weak datum** (p. 308: "(or, equivalently,
`ν_x(J̄(s)) ≥ b`)"): if the entries of `D` are non-singular divisors (or empty) of a non-singular
scheme and `J̃ ∏ Ẽ_j^{a_j} = J̄`, then a point with `ν_x(J̄) ≥ b` lies in `S(D)`:
`∑_{x ∈ Ẽ_j} a_j + ν(J̃_x) ≥ ν(J̄_x)` because the order is additive on products of principal ideals
in a regular local ring (`gr_M` is a domain) and each `Ẽ_j` has order one at its points.

Deviation from the paper (gap filled, proof corrected): the paper says only "or, equivalently";
Lean proves it for the weak datum with whole-space entries emptied (repair of the paper's error on the subschemes `Ẽ_j`, p. 308), where the `Ẽ_j` may be reducible, instead of for a resolution datum. -/
theorem DatumII.Raw.mem_S_of_le_nu_of_prod_eq (hZ : X.IsNonsingular) (D : DatumII.Raw X)
    (hE : ∀ i, (D.E i).IsNonsingularDivisor) {Jbar : Subscheme X}
    (hfac : D.J * ∏ i, (D.E i) ^ (D.a i) = Jbar) {x : X}
    (hν : (D.b : ℕ∞) ≤ Ideal.nu (Jbar.stalkIdeal x)) : x ∈ D.S := by
  classical
  have : IsRegularLocalRing (X.presheaf.stalk x) := hZ x
  have hq : ∀ j, ∃ q : X.presheaf.stalk x,
      ((D.E j).stalkIdeal x) ^ (D.a j) = Ideal.span {q} ∧
        Ideal.ordElem (maximalIdeal _) q = if x ∈ (D.E j).pts then (D.a j : ℕ∞) else 0 := by
    intro j
    by_cases hx : x ∈ (D.E j).pts
    · obtain ⟨e, he, -, he2⟩ :=
        Subscheme.exists_stalkIdeal_eq_span_and_notMem_sq_of_isNonsingularDivisor hZ (hE j) hx
      have hem : e ∈ maximalIdeal (X.presheaf.stalk x) :=
        Subscheme.stalkIdeal_le_maximalIdeal _ hx (he ▸ Ideal.mem_span_singleton_self e)
      refine ⟨e ^ (D.a j), by rw [he, Ideal.span_singleton_pow], ?_⟩
      simp only [hx, ↓reduceIte]
      rw [AB.ordElem_pow_maximalIdeal,
        Ideal.ordElem_eq_one_of_mem_of_notMem_sq (maximalIdeal.isMaximal _).ne_top hem he2, mul_one]
    · refine ⟨1, ?_, ?_⟩
      · have : (D.E j).stalkIdeal x = ⊤ := by
          rw [Subscheme.mem_pts_iff_stalkIdeal_ne_top, not_not] at hx
          exact hx
        rw [this, Ideal.top_pow, Ideal.span_singleton_one]
      · simp only [hx, ↓reduceIte]
        exact Ideal.ordElem_eq_zero_of_isUnit isUnit_one
  choose q hq1 hq2 using hq
  have hprod : Jbar.stalkIdeal x = (D.J.stalkIdeal x) * Ideal.span {∏ j, q j} := by
    rw [← hfac, Subscheme.stalkIdeal_mul_eq, AB.stalkIdeal_prod_eq']
    simp only [Subscheme.stalkIdeal_pow_eq, hq1]
    rw [Ideal.prod_span_singleton]
  have hw : ((D.weight x : ℕ) : ℕ∞) = ∑ j, Ideal.ordElem (maximalIdeal _) (q j) := by
    simp only [hq2]
    unfold DatumII.Raw.weight
    rw [Nat.cast_sum, Finset.sum_filter]
  have hle : Ideal.nu (Jbar.stalkIdeal x) ≤
      ((D.weight x : ℕ) : ℕ∞) + Ideal.nu (D.J.stalkIdeal x) := by
    rw [hprod, add_comm]
    refine (AB.nu_mul_span_singleton_le _ _).trans ?_
    rw [AB.ordElem_prod_maximalIdeal, ← hw]
  exact hν.trans hle

end WeakOrder


/-- The datum `D` factorizes `J̄` (`J̃ ∏ Ẽ_j^{a_j} = J̄`, p. 308) and its version with the entries
equal to the whole space emptied is resolvable by exactly `k` monoidal transformations. -/
def DatumII.Raw.FactorsResolvableLen {Z : Scheme.{u}} (D : DatumII.Raw Z) (Jbar : Subscheme Z)
    (k : ℕ) : Prop :=
  D.J * ∏ j : Fin D.α, (D.E j) ^ (D.a j) = Jbar ∧ DatumII.Raw.ResolvableLen k D.emptyIfBot

theorem DatumII.Raw.factorsResolvableLen_congr {Z : Scheme.{u}} {D₁ D₂ : DatumII.Raw Z}
    (h : D₁ = D₂) {Jbar : Subscheme Z} {k : ℕ} :
    D₁.FactorsResolvableLen Jbar k ↔ D₂.FactorsResolvableLen Jbar k := by
  subst h
  exact Iff.rfl

namespace AB

/-- At the state `σ` the auxiliary datum `ℜ^{N-1}_II` of p. 308 (entries `Ẽ_j` read off the state,
exponents `a`, ideal `J̃`, factorizing `J̄(s)`), with the entries equal to the whole space emptied
(the repair of the paper's error on the subschemes `Ẽ_j`), is resolvable by exactly `k` monoidal transformations. -/
def StageState.AuxResolvable {Y : Scheme.{u}} (σ : StageState Y) (b α₀ k : ℕ) : Prop :=
  ∃ (hU : IsOpen σ.xHatPrimeStar) (αT : ℕ) (_ : σ.boundary.length = α₀ + αT) (a : Fin αT → ℕ)
    (Jt : Subscheme (σ.xTilde hU)),
    (σ.datumII hU b α₀ αT a Jt).FactorsResolvableLen (σ.jBarT hU) k

section Induction

variable {X : Scheme.{u}}

/-- Appending the empty succession does nothing. -/
theorem append_nil {Y : Scheme.{u}} (g : MonoidalSuccession X Y) :
    g.append (MonoidalSuccession.nil Y) = g := by
  induction g with
  | nil X => rfl
  | cons B t rest ih => exact congrArg (MonoidalSuccession.cons B t) (ih)

/-- Concatenation of successions is associative. -/
theorem append_assoc {Y Z W : Scheme.{u}} (g : MonoidalSuccession X Y)
    (h : MonoidalSuccession Y Z) (e : MonoidalSuccession Z W) :
    (g.append h).append e = g.append (h.append e) := by
  induction g with
  | nil X => rfl
  | cons B t rest ih => exact congrArg (MonoidalSuccession.cons B t) (ih h)

/-- (ii) holds vacuously at a point outside the image. -/
theorem isImprovedAt_of_notMem {N : ℕ} {Y : Scheme.{u}} {ℜ : DatumI.Raw X} {r : Restriction X}
    {f : MonoidalSuccession X Y} {x₀ : X}
    (h : x₀ ∉ f.composite.base '' S (f.transformI ℜ) (r.transformSucc f)) :
    IsImprovedAt N ℜ r f x₀ :=
  fun x' hx' _ hxx _ _ => absurd ⟨x', hx', hxx⟩ h


variable {N n : ℕ} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ} {r : Restriction X}

/-- **M10, the induction on the length of the resolving succession of `X̃`, abstractly** (p. 310:
"Thus, applying Theorem `II₂^{N-1}` to the resolution datum `ℜ^{N-1}_II` on `X̃` (without
restriction), we can prove that there exists a finite permissible succession of monoidal
transformations of `X_s` for `ℜ(s)`, which induces a permissible succession of monoidal
transformations of `X̃` for `ℜ^{N-1}_II` and which resolve the datum `ℜ^{N-1}_II`.  Therefore, by
replacing the original succession `g_s : X_s → X` to include such an additional succession, we may
assume that `ℜ^{N-1}_II` is resolved").  `Q g k` says that the auxiliary datum at the stage `g` is
resolvable by `k` monoidal transformations.  The two hypotheses are the end of the induction (M11)
and one block (M9: the replacement of `g_s` by an extension, the monoidal transformation of `X̃`
being induced by that of `X_s`).

Deviation from the paper (gap filled): the paper lifts the whole resolving succession of `X̃` and
then replaces `g_s` once; Lean replaces `g_s` one monoidal transformation of `X̃` at a time (as for
C*, D*: `CD.exists_extension_of_resolvableLen`), which is the induction the paper's sentence
needs. -/
@[blueprint "lem:IV.3-extension-induction"
  (statement := /-- In the situation of \cref{def:IV.3-conditions}, suppose that for every prepared
    permissible stage $g$ with $x_0\in g(S)$ the datum $\mathfrak R^{N-1}_{\mathrm{II}}$ resolvable
    by $0$ transformations leaves $x_0$ improved, and that, if it is resolvable by $k+1$
    transformations, then either it is resolvable by $k$ at the same stage or $g$ has a permissible
    extension at which it is resolvable by $k$. Then, if it is resolvable by $k$ transformations at
    a prepared permissible stage $g$, there is a permissible extension of $g$ at which $x_0$ is
    improved. -/)
  (proof := /-- Induction on $k$; at each step extend $g$ by the given extension (the extension
    keeps $[(1)]$, $[(2)]$ by \cref{lem:IV.3-image-S-append}, \cref{lem:IV.3-prepared-append}); if
    $x_0$ leaves the image of $S$ it is improved vacuously.

    \textbf{Deviation from the paper (gap filled).} The paper (p.~310): ``Therefore, by replacing
    the original succession $g_s\colon X_s\to X$ to include such an additional succession, we may
    assume that $\mathfrak R^{N-1}_{\mathrm{II}}$ is resolved''. Lean replaces $g_s$ one monoidal
    transformation of $\tilde X$ at a time. -/)
  (proofUses := ["lem:IV.3-image-S-append", "lem:IV.3-prepared-append",
    "lem:IV.3-improved-append"])
  (latexEnv := "lemma")]
theorem exists_extension_of_resolvableLen [Hironaka.HironakaCitedResults.{u}] (hℜ : IsGoodDatumI N n X ℜ) (hr : r.IsFor ℜ) {x₀ : X}
    (Q : ∀ {Y : Scheme.{u}}, MonoidalSuccession X Y → ℕ → Prop)
    (hend : ∀ {Y : Scheme.{u}} (g : MonoidalSuccession X Y), r.IsPermissibleSucc g ℜ →
      IsPrepared N P r g →
      x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g) → Q g 0 →
      IsImprovedAt N ℜ r g x₀)
    (hstep : ∀ {Y : Scheme.{u}} (g : MonoidalSuccession X Y) (k : ℕ), r.IsPermissibleSucc g ℜ →
      IsPrepared N P r g →
      x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g) → Q g (k + 1) →
      Q g k ∨ ∃ (Z : Scheme.{u}) (e : MonoidalSuccession Y Z),
        r.IsPermissibleSucc (g.append e) ℜ ∧
        (x₀ ∈ (g.append e).composite.base ''
            S ((g.append e).transformI ℜ) (r.transformSucc (g.append e)) → Q (g.append e) k)) :
    ∀ (k : ℕ) {Y : Scheme.{u}} (g : MonoidalSuccession X Y), r.IsPermissibleSucc g ℜ →
      IsPrepared N P r g → Q g k →
      ∃ (Z : Scheme.{u}) (e : MonoidalSuccession Y Z),
        r.IsPermissibleSucc (g.append e) ℜ ∧ IsImprovedAt N ℜ r (g.append e) x₀ := by
  intro k
  induction k with
  | zero =>
    intro Y g hg hp hQ
    by_cases hx : x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g)
    · exact ⟨Y, MonoidalSuccession.nil Y, by rwa [append_nil], by
        rw [append_nil]; exact hend g hg hp hx hQ⟩
    · exact ⟨Y, MonoidalSuccession.nil Y, by rwa [append_nil], by
        rw [append_nil]; exact isImprovedAt_of_notMem hx⟩
  | succ k ih =>
    intro Y g hg hp hQ
    by_cases hx : x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g)
    swap
    · exact ⟨Y, MonoidalSuccession.nil Y, by rwa [append_nil], by
        rw [append_nil]; exact isImprovedAt_of_notMem hx⟩
    rcases hstep g k hg hp hx hQ with hQ' | ⟨Z, e, he, hQ'⟩
    · exact ih g hg hp hQ'
    · have hp' : IsPrepared N P r (g.append e) := hp.append e hℜ hr he
      by_cases hx' : x₀ ∈ (g.append e).composite.base ''
          S ((g.append e).transformI ℜ) (r.transformSucc (g.append e))
      · obtain ⟨W, e₂, he₂, himp⟩ := ih (g.append e) he hp' (hQ' hx')
        exact ⟨W, e.append e₂, by rwa [← append_assoc], by rwa [← append_assoc]⟩
      · exact ⟨Z, e, he, isImprovedAt_of_notMem hx'⟩

/-- **KP, the one-point step** (p. 310): from a prepared permissible succession `g` and a point `x₀`
of the image of `S(g*ℜ)` which is not improved, there is a permissible extension `g ++ e` at which
`x₀` is improved (the properties (i), (ii) of Theorems A*, B* hold at `x₀`).  This is the content of
the paragraph "Now, with reference to the above `x₀ ∈ X` … `ν*(…) <` or, if they are equal, `τ* >`"
(pp. 307-310) for one point. -/
def OnePointStep (N : ℕ) {X : Scheme.{u}} (ℜ : DatumI.Raw X) (P : DatumI.Presentation ℜ)
    (r : Restriction X) : Prop :=
  ∀ {Y : Scheme.{u}} (g : MonoidalSuccession X Y), r.IsPermissibleSucc g ℜ →
    IsPrepared N P r g → ∀ x₀ ∈ notImprovedSet N ℜ r g,
    ∃ (Z : Scheme.{u}) (e : MonoidalSuccession Y Z),
      r.IsPermissibleSucc (g.append e) ℜ ∧ IsImprovedAt N ℜ r (g.append e) x₀

/-- **M12, the finite iteration** (p. 310: "Now, `g_s(S(ℜ(s)))` consists of a finite number of
points at which `X` has dimension `N`, and therefore, repeating the above process at most a finite
number of times, we achieve the demonstration of Theorems A* and B*"): from the one-point step,
every prepared permissible succession has a permissible extension with the effective properties.
Strong induction on the number of points of the finite set `notImprovedSet`, which decreases by
`notImprovedSet_append_subset` and the improvement of the chosen point.

Deviation from the paper (gap filled): "repeating the above process at most a finite number of
times" is this induction; it needs that the already improved points stay improved
(`IsImprovedAt.append`) and that `[(1)]`, `[(2)]` persist (`IsPrepared.append`). -/
@[blueprint "lem:IV.3-finite-iteration"
  (statement := /-- Suppose that for every prepared permissible succession $g$ and every point $x_0$
    of $g(S(g^*\mathfrak R))$ at which the property (ii) of Theorems A*, B* fails there is a
    permissible extension $gh$ at which (ii) holds at $x_0$. Then every prepared permissible
    succession has a permissible extension with the properties (i), (ii) of Theorems A*, B*
    (\cref{def:IV.3-effective-modification}). -/)
  (proof := /-- The set of points of $g(S(g^*\mathfrak R))$ where (ii) fails is finite, and it can
    only shrink under permissible extension (\cref{lem:IV.3-improved-append},
    \cref{lem:IV.3-image-S-append}); the chosen point leaves it. Induct on its cardinality.

    \textbf{Deviation from the paper (gap filled).} The paper (p.~310): ``Now, $g_s(S(\mathfrak
    R(s)))$ consists of a finite number of points at which $X$ has dimension $N$, and therefore,
    repeating the above process at most a finite number of times, we achieve the demonstration of
    Theorems A* and B*''. -/)
  (proofUses := ["lem:IV.3-image-S-append", "lem:IV.3-improved-append",
    "lem:IV.3-prepared-append", "def:IV.3-effective-modification"])
  (latexEnv := "lemma")]
theorem exists_hasEffectiveProperties_of_onePointStep [Hironaka.HironakaCitedResults.{u}] (hℜ : IsGoodDatumI N n X ℜ)
    (hr : r.IsFor ℜ) (hKP : OnePointStep N ℜ P r) :
    ∀ (m : ℕ) {Y : Scheme.{u}} (g : MonoidalSuccession X Y), r.IsPermissibleSucc g ℜ →
      IsPrepared N P r g → (notImprovedSet N ℜ r g).ncard ≤ m →
      ∃ (Z : Scheme.{u}) (e : MonoidalSuccession Y Z),
        r.IsPermissibleSucc (g.append e) ℜ ∧ HasEffectiveProperties N ℜ r (g.append e) := by
  intro m
  induction m with
  | zero =>
    intro Y g hg hp hm
    have hemp : notImprovedSet N ℜ r g = ∅ :=
      (Set.ncard_eq_zero (notImprovedSet_finite hp.1)).mp (Nat.le_zero.mp hm)
    refine ⟨Y, MonoidalSuccession.nil Y, by rwa [append_nil], ?_⟩
    rw [append_nil]
    exact (hasEffectiveProperties_iff_hasFiniteImageOfDimEq_and_notImprovedSet_eq_empty N ℜ r g).mpr
      ⟨hp.1, hemp⟩
  | succ m ih =>
    intro Y g hg hp hm
    by_cases hemp : notImprovedSet N ℜ r g = ∅
    · refine ⟨Y, MonoidalSuccession.nil Y, by rwa [append_nil], ?_⟩
      rw [append_nil]
      exact (hasEffectiveProperties_iff_hasFiniteImageOfDimEq_and_notImprovedSet_eq_empty
        N ℜ r g).mpr ⟨hp.1, hemp⟩
    · obtain ⟨x₀, hx₀⟩ := Set.nonempty_iff_ne_empty.mpr hemp
      obtain ⟨Z, e, he, himp⟩ := hKP g hg hp x₀ hx₀
      have hp' : IsPrepared N P r (g.append e) := hp.append e hℜ hr he
      have hsub : notImprovedSet N ℜ r (g.append e) ⊂ notImprovedSet N ℜ r g :=
        ⟨notImprovedSet_append_subset e hℜ hr he, fun hh => (hh hx₀).2 himp⟩
      have hlt := Set.ncard_lt_ncard hsub (notImprovedSet_finite hp.1)
      obtain ⟨W, e₂, he₂, hE⟩ := ih (g.append e) he hp' (by omega)
      exact ⟨W, e.append e₂, by rwa [← append_assoc], by rwa [← append_assoc]⟩

end Induction

section Bridge

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X}

/-- The number of boundary components of the fold of `g`: `α + length g`. -/
theorem StageState.length_boundary_fold (b : ℕ) {Y Z : Scheme.{u}} (g : MonoidalSuccession Y Z) :
    ∀ (σ : StageState Y),
      (StageState.fold b g σ).boundary.length = σ.boundary.length + g.length := by
  induction g with
  | nil X => intro σ; rfl
  | cons B t rest ih =>
    intro σ
    rw [StageState.fold_cons, ih]
    show (σ.boundary.map (Subscheme.strictTransform t) ++ [t.exceptional]).length +
      rest.length = σ.boundary.length + (rest.length + 1)
    simp
    omega

theorem StageState.length_boundary_fold_initial (b : ℕ) {x₀ : X} (hx₀ : X.IsSimpleAt x₀)
    (z : Shat X x₀) (Jgen : Set (Shat X x₀)) {Y : Scheme.{u}} (g : MonoidalSuccession X Y) :
    (StageState.fold b g (StageState.initial P.E hx₀ z Jgen)).boundary.length =
      P.α + g.length := by
  rw [StageState.length_boundary_fold]
  show (List.ofFn P.E).length + g.length = _
  rw [List.length_ofFn]

/-- `StageResolvable` is `StageState.AuxResolvable` of the fold (the number of components is
determined by the length of the boundary). -/
theorem stageResolvable_iff_auxResolvable (b : ℕ) {x₀ : X} (hx₀ : X.IsSimpleAt x₀)
    (z : Shat X x₀) (Jgen : Set (Shat X x₀)) {Y : Scheme.{u}} (g : MonoidalSuccession X Y)
    (k : ℕ) :
    StageResolvable b P r hx₀ z Jgen g k ↔
      (StageState.fold b g (StageState.initial P.E hx₀ z Jgen)).AuxResolvable b
        (r.eTildeOffset P.α) k := by
  have hlen := StageState.length_boundary_fold_initial (P := P) b hx₀ z Jgen g
  have hbd : r.eTildeOffset P.α + bdryCard r P.α g.length = P.α + g.length := by
    cases r <;> simp [Restriction.eTildeOffset, bdryCard]
  constructor
  · rintro ⟨hU, a, Jt, hfac, hres⟩
    exact ⟨hU, bdryCard r P.α g.length, by omega, a, Jt, hfac, hres⟩
  · rintro ⟨hU, αT, hl, a, Jt, hfac, hres⟩
    obtain rfl : αT = bdryCard r P.α g.length := by omega
    exact ⟨hU, a, Jt, hfac, hres⟩

end Bridge

section FrameLevel

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X} {T : Tower X} {x₀ : X} {hS : Standing N n ℜ P r T x₀} (𝒮 : Frame hS)

theorem Frame.boundary_length_stageOf [Hironaka.HironakaCitedResults.{u}] (s : ℕ) :
    (𝒮.stageOf s).boundary.length = 𝒮.eTildeOffset + (𝒮.eTilde s).1 := by
  show (List.ofFn (T.Esys P.E s)).length = _
  rw [List.length_ofFn]
  unfold Frame.eTildeOffset Frame.eTilde
  cases r <;> simp [Nat.add_comm]

/-- The auxiliary datum of the frame at the stage `s` (removal family `removalFamilyStar`) with its
factorization is resolvable by `k` monoidal transformations. -/
def Frame.AuxResolvable [Hironaka.HironakaCitedResults.{u}] (s k : ℕ) : Prop :=
  ∃ (a : Fin (𝒮.eTilde s).1 → ℕ) (Jt : Subscheme (𝒮.removalFamilyStar.xTilde s)),
    (𝒮.removalFamilyStar.datumII s a Jt).FactorsResolvableLen (𝒮.removalFamilyStar.jBarT s) k

theorem Frame.auxResolvable_stageOf_iff [Hironaka.HironakaCitedResults.{u}] (s k : ℕ) :
    (𝒮.stageOf s).AuxResolvable 𝒮.b 𝒮.eTildeOffset k ↔ 𝒮.AuxResolvable s k := by
  constructor
  · rintro ⟨hU, αT, hlen, a, Jt, h⟩
    have h2 := 𝒮.boundary_length_stageOf s
    obtain rfl : αT = (𝒮.eTilde s).1 := by omega
    exact ⟨a, Jt, (DatumII.Raw.factorsResolvableLen_congr (𝒮.stageOf_datumII_eq s a Jt)).mp h⟩
  · rintro ⟨a, Jt, h⟩
    exact ⟨𝒮.isOpen_stageOf_xHatPrimeStar s, (𝒮.eTilde s).1, 𝒮.boundary_length_stageOf s, a, Jt,
      (DatumII.Raw.factorsResolvableLen_congr (𝒮.stageOf_datumII_eq s a Jt)).mpr h⟩


/-- **Not improved gives the conditions (1), (2), (3) of Lemma (AB.4)** (p. 310, "Or, equivalently,
if `x` is any point of `X_s` at which `X_s` has dimension `N` and such that `g_s(x) = x_0`, we have
either `ν* <` or, if they are equal, `τ* >`"): a point `x` of `S(ℜ(s))` over `x_0` at which `X_s`
has dimension `N` and which is not improved has `ν*` and `τ*` equal to those of `x_0`
(by Theorem 3, §5, Ch. III, `nuStarSystemAt_succSystem_le_and_tauStarSystemAt_ge`: `ν* ≤` and, if
equal, `τ* ≥`), i.e. satisfies (1), (2), (3).

Deviation from the paper (gap filled): the paper states the equivalence without proof. -/
@[blueprint "lem:IV.3-cond-of-not-improved"
  (statement := /-- In the situation of \cref{def:IV.3-conditions}, let $x$ be a point of
    $S(\mathfrak R(s))$ at which $X_s$ has dimension $N$ and such that $g_s(x)=x_0$. If it is not
    true that $\nu^*_x(V_1(s),\dots,V_\beta(s),W(s)/X_s)<\nu^*_{x_0}(V_1,\dots,V_\beta,W/X)$ or, if
    they are equal, $\tau^*_x(\dots/X_s)>\tau^*_{x_0}(\dots/X)$, then $x$ has the properties (1),
    (2), (3) of Lemma (AB.4) with reference to $x_0$. -/)
  (proof := /-- By Theorem~3, \S5, Ch.~III in the form \cref{lem:IV.3-thm3-consequence}, $\nu^*_x\le
    \nu^*_{x_0}$ member by member, and $\tau^*_x\ge\tau^*_{x_0}$ if the $\nu^*$ are equal. If it is
    not true that ($<$ for some member) or (equal with $>$ for some member) then every member has
    $\nu^*_x=\nu^*_{x_0}$, and then $\tau^*_x=\tau^*_{x_0}$.

    \textbf{Deviation from the paper (gap filled).} The paper (p.~310): ``Or, equivalently, if $x$
    is any point of $X_s$ at which $X_s$ has dimension $N$ and such that $g_s(x)=x_0$, we have
    either $\nu^*<$ or, if they are equal, $\tau^*>$'' states the equivalence without proof. -/)
  (proofUses := ["lem:IV.3-thm3-consequence", "def:IV.3-conditions"])
  (latexEnv := "lemma")]
theorem exists_cond_of_not_isImprovedAt [Hironaka.HironakaCitedResults.{u}] {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X}
    {P : DatumI.Presentation ℜ} {r : Restriction X} {T : Tower X} {x₀ : X}
    (hS : Standing N n ℜ P r T x₀) (s : ℕ) (h : ¬ IsImprovedAt N ℜ r (T.pre s) x₀) :
    ∃ x : T.X s, x ∈ S ((T.pre s).transformI ℜ) (r.transformSucc (T.pre s)) ∧
      Cond N ℜ T x₀ (hS.ambient.2.1 x₀) s x := by
  classical
  unfold IsImprovedAt at h
  push Not at h
  obtain ⟨x, hxS, hdim, hcomp, hx', hx, hnot⟩ := h
  subst hcomp
  have := hS.ambient.1
  obtain ⟨hν, hτ⟩ := nuStarSystemAt_succSystem_le_and_tauStarSystemAt_ge (N := N) (T.pre s)
    hS.ambient.2.1 (fun y => (LocSucc.dimAt_le_dim y).trans hS.ambient.2.2.2.le)
    (hS.permissible s).isPermissibleI x hdim hx' _ rfl hx
  have hEq : NuStarSystemEq (datumSystem ℜ) _ hx (succSystem (T.pre s) ℜ) x hx' := by
    intro j
    refine le_antisymm (hν j) (not_lt.mp fun hlt => hnot.1 ⟨hν, j, hlt⟩)
  refine ⟨x, hxS, hdim, rfl, hx', hEq, ?_⟩
  intro j i
  refine le_antisymm (hτ hEq j i) (not_lt.mp fun hlt => hnot.2 hEq ⟨hτ hEq, j, i, hlt⟩)


namespace Frame.RemovalFamily

variable {𝒮}

/-- **Remark 3 (a) for the emptied datum** (p. 308, "(or, equivalently, `ν_x(J̄(s)) ≥ b`)"): a point
of `X̃` with `ν(J̄(s)_x̃) ≥ b` lies in `S` of the auxiliary datum with the entries equal to the
whole space emptied. The exponents `a_j` vanish on the entries equal to the whole space (`J̄(s)_x̃ ≠
0`, `stalkIdeal_jBarT_ne_bot`), so the factorization `J̃ ∏ Ẽ_j^{a_j} = J̄(s)` is that of the emptied
datum, which is weak (`isWeakDatum_emptyIfBot_datumII`).

Deviation from the paper (gap filled, proof corrected): the paper's "equivalently" is for a
resolution datum; Lean proves it for the weak datum with whole-space entries emptied (repair of the
the paper's error on the subschemes `Ẽ_j`). -/
@[blueprint "rem:IV.3-3-weak"
  (statement := /-- Notation as in \cref{rem:IV.3-3}. Let $a_j\ge0$ and $\tilde J$ be such that
    $\bar J(s)=\tilde J\prod_j\tilde P_j^{a_j}$ on $\tilde X$, and let $\mathfrak
    R^{N-1}_{\mathrm{II},\flat}$ be the datum $\mathfrak R^{N-1}_{\mathrm{II}}$ with every $\tilde
    E_j$ equal to $\tilde X$ replaced by the empty subscheme. If $\nu_{\tilde x}(\bar J(s))\ge b$
    then $\tilde x\in S(\mathfrak R^{N-1}_{\mathrm{II},\flat})$. -/)
  (proof := /-- The $a_j$ vanish on the entries equal to $\tilde X$, since $\bar J(s)\neq0$
    (\cref{lem:IV.3-jbar-nonzero}), so the factorization is that of the emptied datum, which is a
    weak datum (\cref{lem:IV.3-datumII-weak}). In the regular local ring $\mathcal O_{\tilde
    X,\tilde x}$ the order is additive on products of principal ideals ($\mathrm{gr}$ is a domain),
    and the ideal of each $\tilde E_j$ through $\tilde x$ is generated by a regular parameter (a
    non-singular divisor), so $\sum_{\tilde x\in\tilde E_j}a_j+\nu(\tilde J)\ge \nu(\bar J(s))\ge
    b$.

    \textbf{Deviation from the paper (gap filled; proof corrected, repair of the paper's error on the subschemes $\tilde E_j$).} The paper (p.~308): ``(or, equivalently, $\nu_x(\bar J(s))\ge b$)'' states the
    equivalence without proof, for the resolution datum $\mathfrak R^{N-1}_{\mathrm{II}}$; Lean
    proves it for the weak datum with whole-space entries emptied. -/)
  (proofUses := ["lem:IV.3-jbar-nonzero", "lem:IV.3-datumII-weak", "rem:IV.3-3"])
  (latexEnv := "remark")]
theorem mem_S_emptyIfBot_datumII_of_le_nu [Hironaka.HironakaCitedResults.{u}] (R : 𝒮.RemovalFamily) {s : ℕ}
    (hprep : PrepHyp N ℜ P r T x₀ s) (a : Fin (𝒮.eTilde s).1 → ℕ)
    (Jt : Subscheme (R.xTilde s))
    (hfac : Jt * ∏ j, ((R.datumII s a Jt).E j) ^ (a j) = R.jBarT s) {xt : R.xTilde s}
    (hν : (𝒮.b : ℕ∞) ≤ Ideal.nu ((R.jBarT s).stalkIdeal xt)) :
    xt ∈ (R.datumII s a Jt).emptyIfBot.S := by
  classical
  have hJne : ∀ xt' : R.xTilde s, (R.jBarT s).stalkIdeal xt' ≠ ⊥ :=
    R.stalkIdeal_jBarT_ne_bot s hprep
  have hJt : ∀ xt' : R.xTilde s, Jt.stalkIdeal xt' ≠ ⊥ := by
    intro xt' hz
    apply hJne xt'
    rw [← hfac, Subscheme.stalkIdeal_mul_eq, hz, Ideal.bot_mul]
  have hweak := R.isWeakDatum_emptyIfBot_datumII s a Jt hJt
  -- the exponents vanish on the entries equal to the whole space
  have ha : ∀ j, (R.datumII s a Jt).E j = ⊥ → a j = 0 := by
    intro j hj
    by_contra hne
    apply hJne xt
    rw [← hfac, Subscheme.stalkIdeal_mul_eq, AB.stalkIdeal_prod_eq']
    have h1 : ((R.datumII s a Jt).E j ^ a j).stalkIdeal xt = 0 := by
      rw [Subscheme.stalkIdeal_pow_eq, hj, Subscheme.stalkIdeal_bot_eq, Ideal.zero_eq_bot]
      exact Ideal.bot_pow hne
    rw [Finset.prod_eq_zero (Finset.mem_univ j) h1, mul_zero]
    exact Ideal.zero_eq_bot
  have hfac' : (R.datumII s a Jt).emptyIfBot.J * ∏ j : Fin (R.datumII s a Jt).emptyIfBot.α,
      ((R.datumII s a Jt).emptyIfBot.E j) ^ ((R.datumII s a Jt).emptyIfBot.a j) =
        R.jBarT s := by
    rw [← hfac]
    refine congrArg (Jt * ·) (Finset.prod_congr rfl fun j _ => ?_)
    show ((R.datumII s a Jt).E j).emptyIfBot ^ a j = _
    by_cases hj : (R.datumII s a Jt).E j = ⊥
    · rw [ha j hj, pow_zero, pow_zero]
    · rw [Subscheme.emptyIfBot_of_ne_bot hj]
  exact DatumII.Raw.mem_S_of_le_nu_of_prod_eq (R.isNonsingular_xTilde s) _ hweak.2.1 hfac' hν

end Frame.RemovalFamily


/-- **M11, the end of the induction** (p. 310): if the auxiliary datum `ℜ^{N-1}_II` (with the
entries equal to the whole space emptied) is resolved at the stage `s`, then `x_0` is improved at
`g_s`: "This means that `ν_x(J̄(s)) < b` for every point `x` of `X̃`.  By virtue of Corollary of
Lemma (AB.4), it implies that there exists no point `x` of `X_s` having the properties (1), (2) and
(3) of Lemma (AB.4) with reference to the point `x_0 ∈ g_s(S(ℜ(s)))`.  Or, equivalently, if `x` is
any point of `X_s` at which `X_s` has dimension `N` and such that `g_s(x) = x_0`, we have either
`ν* <` or, if they are equal, `τ* >`".

Deviation from the paper (proof corrected, repair of the paper's error on the subschemes `Ẽ_j`; gap filled): the
resolved datum is the emptied weak datum; "equivalently" is `exists_cond_of_not_isImprovedAt`, and
`ν_x̃(J̄(s)) ≥ b ⟹ x̃ ∈ S(ℜ^{N-1}_II)` (Remark 3 (a), converse direction) is
`Frame.RemovalFamily.mem_S_emptyIfBot_datumII_of_le_nu`. -/
theorem Frame.isImprovedAt_pre_of_auxResolvable_zero [Hironaka.HironakaCitedResults.{u}] (s : ℕ) (hprep : PrepHyp N ℜ P r T x₀ s)
    (h : 𝒮.AuxResolvable s 0) : IsImprovedAt N ℜ r (T.pre s) x₀ := by
  by_contra hnot
  obtain ⟨x, hxS, hcond⟩ := exists_cond_of_not_isImprovedAt hS s hnot
  have hF : ∀ F, r = .closed F → x ∈ ((T.pre s).strictTransform F).pts := by
    rintro F rfl
    exact hxS.2
  obtain ⟨xh, hcx, -, hxhU, xb, hxb, hι, hJle⟩ :=
    𝒮.exists_mem_xHatPrimeStar_and_jBar_le_maximalIdeal_pow_of_cond s x hcond hF
  obtain ⟨a, Jt, hfac, hres⟩ := h
  let xt : 𝒮.removalFamilyStar.xTilde s := ⟨xb, hxb⟩
  have hν : (𝒮.b : ℕ∞) ≤ Ideal.nu ((𝒮.removalFamilyStar.jBarT s).stalkIdeal xt) := by
    rw [𝒮.removalFamilyStar.nu_jBarT_eq s xt]
    exact Ideal.le_ord hJle
  have hmem := 𝒮.removalFamilyStar.mem_S_emptyIfBot_datumII_of_le_nu hprep a Jt hfac hν
  exact (Set.eq_empty_iff_forall_notMem.mp hres) xt hmem

end FrameLevel


section OnePoint

variable {N n : ℕ} {X : Scheme.{u}} {ℜ : DatumI.Raw X} {P : DatumI.Presentation ℜ}
  {r : Restriction X}

/-- **M9 as a hypothesis: one block** (p. 310).  At a prepared permissible stage `g` with
`x_0 ∈ g(S)`, if the emptied auxiliary datum is resolvable by `k + 1` monoidal transformations, then
either it is already resolvable by `k` (the first center is empty) or there is a permissible
extension `g ++ e` (the succession of Theorem `I₂^{N,n'}`, trivial on `X̃`, followed by the
monoidal transformation of `X_s` inducing the given one of `X̃`) at which it is resolvable by `k`
(as long as `x_0` is still in the image of `S`).  It is proved in `Hironaka/Ch4/AStarBStarLifting.lean`. -/
def OneBlockStep (N : ℕ) {X : Scheme.{u}} (ℜ : DatumI.Raw X) (P : DatumI.Presentation ℜ)
    (r : Restriction X) {x₀ : X} (hx₀ : X.IsSimpleAt x₀) (z : Shat X x₀) (b : ℕ)
    (Jgen : Set (Shat X x₀)) : Prop :=
  ∀ {Y : Scheme.{u}} (g : MonoidalSuccession X Y), r.IsPermissibleSucc g ℜ →
    HasFiniteImageOfDimEq N ℜ r g → HasPreparedBoundary P r g →
    x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g) → ∀ k : ℕ,
    StageResolvable b P r hx₀ z Jgen g (k + 1) →
    StageResolvable b P r hx₀ z Jgen g k ∨
      ∃ (Z : Scheme.{u}) (e : MonoidalSuccession Y Z), r.IsPermissibleSucc (g.append e) ℜ ∧
        (x₀ ∈ (g.append e).composite.base ''
            S ((g.append e).transformI ℜ) (r.transformSucc (g.append e)) →
          StageResolvable b P r hx₀ z Jgen (g.append e) k)

/-- The one-block lemma `OneBlockStep` for every choice of the tower-independent frame data at
every point `x_0` (the form in which `onePointStep_of_oneBlockStep` takes it). -/
def OneBlockHyp (N : ℕ) {X : Scheme.{u}} (ℜ : DatumI.Raw X) (P : DatumI.Presentation ℜ)
    (r : Restriction X) : Prop :=
  ∀ (x₀ : X) (hx₀ : X.IsSimpleAt x₀) [IsRegularLocalRing (Shat X x₀)] (z : Shat X x₀) (b : ℕ)
    (Jgen : Set (Shat X x₀)), FrameSpec x₀ hx₀ ℜ r z b Jgen → OneBlockStep N ℜ P r hx₀ z b Jgen

/-- The hypothesis of `exists_standing_prepHyp_of_prepHypSucc` in the form of the assembly. -/
theorem prepHypSucc_of_isPrepared {x₀ : X} {Y : Scheme.{u}} {g : MonoidalSuccession X Y}
    (hp : IsPrepared N P r g)
    (hx : x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g)) :
    PrepHypSucc N ℜ P r g x₀ :=
  ⟨hp.1.1, hp.1.2, fun U hU W₁ hW₁ i => hp.2 i U hU W₁ hW₁, hx⟩

/-- **M11 for successions: the end of the induction** (p. 310): at a prepared permissible stage `g`
with `x_0 ∈ g(S)`, if the emptied auxiliary datum is resolved (`k = 0`), then `x_0` is improved at
`g`: "This means that `ν_x(J̄(s)) < b` for every point `x` of `X̃`.  By virtue of Corollary of
Lemma (AB.4), it implies that there exists no point `x` of `X_s` having the properties (1), (2) and
(3) of Lemma (AB.4) with reference to the point `x_0 ∈ g_s(S(ℜ(s)))`.  Or, equivalently, if `x` is
any point of `X_s` at which `X_s` has dimension `N` and such that `g_s(x) = x_0`, we have either
`ν* <` or, if they are equal, `τ* >`".  The tower and the frame over it are provided by
`exists_standing_prepHyp_of_prepHypSucc` and `Frame.canon` with the tower-independent frame data;
the identification of the state of the fold with the state of the frame is
`Frame.canon_stageOf_eq_fold`.

Deviation from the paper (proof corrected, repair of the paper's error on the subschemes `Ẽ_j`; gap filled): the
resolved datum is the emptied weak datum (`mem_S_emptyIfBot_datumII_of_le_nu`), and the paper's
"equivalently" is `exists_cond_of_not_isImprovedAt`. -/
@[blueprint "lem:IV.3-final-step"
  (statement := /-- In the situation of \cref{def:IV.3-conditions}, with the frame data fixed, if
    the datum $\mathfrak R^{N-1}_{\mathrm{II}}$ on $\tilde X$ (with every $\tilde E_j$ equal to
    $\tilde X$ replaced by the empty subscheme) is resolved at the stage $g_s$, then for every point
    $x$ of $S(\mathfrak R(s))$ at which $X_s$ has dimension $N$ and such that $g_s(x)=x_0$ one has
    $\nu^*_x(V_1(s),\dots,V_\beta(s),W(s)/X_s)<\nu^*_{x_0}(V_1,\dots,V_\beta,W/X)$ or, if they are
    equal, $\tau^*_x(\dots/X_s)>\tau^*_{x_0}(\dots/X)$. -/)
  (proof := /-- Resolved means $S(\mathfrak R^{N-1}_{\mathrm{II},\flat})=\emptyset$, i.e.\ (by
    \cref{rem:IV.3-3-weak}) $\nu_{\tilde x}(\bar J(s))<b$ for every point $\tilde x$ of $\tilde X$.
    A point $x$ not improved has the properties (1), (2), (3) of Lemma (AB.4)
    (\cref{lem:IV.3-cond-of-not-improved}), hence by the Corollary of Lemma (AB.4)
    (\cref{cor:IV.AB-4-componentwise}) there is a point $\hat x$ of $\tilde X$ over $x$ with $\bar
    J(s)_{\hat x}\subseteq\bar M^b$, i.e.\ $\nu_{\hat x}(\bar J(s))\ge b$: a contradiction. The
    tower of $g_s$, the frame over it (with the data kept fixed) and the state $\tilde X$ of the
    stage are provided by the finite succession (\cref{lem:IV.3-trivial-step},
    \cref{lem:IV.3-blowup-step}).

    \textbf{Deviation from the paper (gap filled; proof corrected for the paper's error on the subschemes $\tilde E_j$).} The
    paper (p.~310): ``This means that $\nu_x(\bar J(s))<b$ for every point $x$ of $\tilde X=X_s$. By
    virtue of Corollary of Lemma (AB. 4), it implies that there exists no point $x$ of $X_s$ having
    the properties (1), (2) and (3) of Lemma (AB. 4) \dots''. -/)
  (proofUses := ["rem:IV.3-3-weak", "lem:IV.3-cond-of-not-improved", "cor:IV.AB-4-componentwise"])
  (latexEnv := "lemma")]
theorem isImprovedAt_of_stageResolvable_zero [Hironaka.HironakaCitedResults.{u}] (hNn : n < N) (hX : IsAmbient X N)
    (hℜ : ℜ.IsDatum) (hn : ℜ.n = (n : WithBot ℕ∞)) (hr : r.IsFor ℜ) {x₀ : X}
    (hx₀ : X.IsSimpleAt x₀) [IsRegularLocalRing (Shat X x₀)] {z : Shat X x₀} {b : ℕ}
    {Jgen : Set (Shat X x₀)} (fr : FrameSpec x₀ hx₀ ℜ r z b Jgen) {Y : Scheme.{u}}
    (g : MonoidalSuccession X Y) (hg : r.IsPermissibleSucc g ℜ) (hp : IsPrepared N P r g)
    (hx : x₀ ∈ g.composite.base '' S (g.transformI ℜ) (r.transformSucc g))
    (hQ : StageResolvable b P r hx₀ z Jgen g 0) : IsImprovedAt N ℜ r g x₀ := by
  obtain ⟨T, m, h, hpre, -, hS, hprep⟩ := exists_standing_prepHyp_of_prepHypSucc P hNn hX hℜ hn hr
    g hg (prepHypSucc_of_isPrepared hp hx)
  subst h
  have hpre' : T.pre m = g := hpre
  subst hpre'
  rw [stageResolvable_iff_auxResolvable,
    ← Frame.canon_stageOf_eq_fold (hS := hS) (z := z) (b := b) (jGen := Jgen) (fr := fr) m]
    at hQ
  set 𝒮 : Frame hS := Frame.canon hS z b Jgen fr with h𝒮
  have hAux : 𝒮.AuxResolvable m 0 :=
    (𝒮.auxResolvable_stageOf_iff m 0).mp (by rw [𝒮.eTildeOffset_eq]; exact hQ)
  exact 𝒮.isImprovedAt_pre_of_auxResolvable_zero m hprep hAux


/-- **KP, the one-point step, from one block** (pp. 307-310). Given a prepared permissible
succession `g` and a point `x_0` of `g(S(g*ℜ))` which is not improved, the corrected Corollary of
Lemma (AB.4) gives a point of `X̃` of dimension `N - 1` (the proviso of p. 308), Theorem `II₂^{N-1}`
resolves the emptied auxiliary datum (`resolvable_datumII_emptyIfBot`), and the induction on the
length of the resolving succession (`exists_extension_of_resolvableLen`, with one block
`OneBlockStep` at each step and `isImprovedAt_of_stageResolvable_zero` at the end) replaces `g` by
an extension at which `x_0` is improved.

Deviation from the paper (gap filled; proof corrected for the paper's error on the subschemes `Ẽ_j`): the last
paragraph of the proof (p. 310) is this argument; Lean makes the induction on the length of the
resolving succession of `X̃` explicit, applies `II₂^{N-1}` to the emptied weak datum, and produces
the tower, the frame and `X̃` at each stage from the finite succession (`StageState`). -/
@[blueprint "lem:IV.3-one-point-step"
  (statement := /-- In the situation of \cref{def:IV.3-conditions}, assume Theorems
    $\mathrm{II}_2^{N'}$ for $N'<N$ and the replacement of $g_s$ by an extension for one monoidal
    transformation of $\tilde X$ (\cref{lem:IV.3-extension-induction}). If $x_0\in g_s(S(\mathfrak
    R(s)))$ then $g_s$ has a permissible extension $g$ such that, for every point $x$ of
    $S(g^*\mathfrak R)$ at which the scheme has dimension $N$ and with image $x_0$,
    $\nu^*_x<\nu^*_{x_0}$ or, if they are equal, $\tau^*_x>\tau^*_{x_0}$. -/)
  (proof := /-- If $x_0$ is not improved at $g_s$, a point of $S(\mathfrak R(s))$ over $x_0$ has the
    properties (1), (2), (3) of Lemma (AB.4) (\cref{lem:IV.3-cond-of-not-improved}), so $\tilde X$
    has a point of dimension $N-1$ (\cref{lem:IV.3-xtilde-ambient}) and Theorem
    $\mathrm{II}_2^{N-1}$ resolves the datum $\mathfrak R^{N-1}_{\mathrm{II}}$ with its whole-space
    entries emptied (\cref{lem:IV.3-datumII-resolvable}). Replace $g_s$ successively by the
    extensions inducing the monoidal transformations of $\tilde X$
    (\cref{lem:IV.3-extension-induction}); at the end the datum is resolved and $x_0$ is improved
    (\cref{lem:IV.3-final-step}).

    \textbf{Deviation from the paper (gap filled; proof corrected for the paper's error on the subschemes $\tilde E_j$).}
    The paper (p.~310): ``Thus, applying Theorem $\mathrm{II}_2^{N-1}$ to the resolution datum
    $\mathfrak R^{N-1}_{\mathrm{II}}$ on $\tilde X$ (without restriction), we can prove that there
    exists a finite permissible succession of monoidal transformations of $X_s$ for
    $\mathfrak R(s)$, which induces a permissible succession of monoidal transformations of
    $\tilde X$ for $\mathfrak R^{N-1}_{\mathrm{II}}$ and which resolve the datum
    $\mathfrak R^{N-1}_{\mathrm{II}}$. Therefore, by replacing the original succession \dots\ we
    may assume that $\mathfrak R^{N-1}_{\mathrm{II}}$ is resolved''. -/)
  (proofUses := ["lem:IV.3-cond-of-not-improved", "lem:IV.3-xtilde-ambient",
    "lem:IV.3-datumII-resolvable", "lem:IV.3-extension-induction", "lem:IV.3-final-step"])
  (latexEnv := "lemma")]
theorem onePointStep_of_oneBlockStep [Hironaka.HironakaCitedResults.{u}] (hNn : n < N)
    (hII₂ : ∀ N' : ℕ, N' < N → FundamentalTheorem.II₂.{u} N') (hX : IsAmbient X N)
    (hℜ : ℜ.IsDatum) (hn : ℜ.n = (n : WithBot ℕ∞)) (hr : r.IsFor ℜ)
    (hM9 : OneBlockHyp N ℜ P r) : OnePointStep N ℜ P r := by
  intro Y g hg hp x₀ hx₀m
  obtain ⟨hx, hnot⟩ := hx₀m
  have hgood : IsGoodDatumI N n X ℜ := ⟨hX, hℜ, hn.le⟩
  obtain ⟨T, m, h, hpre, -, hS, hprep⟩ := exists_standing_prepHyp_of_prepHypSucc P hNn hX hℜ hn hr
    g hg (prepHypSucc_of_isPrepared hp hx)
  subst h
  have hpre' : T.pre m = g := hpre
  subst hpre'
  obtain ⟨reg, z, b, Jgen, ⟨fr⟩⟩ := hS.exists_frameData
  have hx₀ : X.IsSimpleAt x₀ := hS.ambient.2.1 x₀
  -- the base: the emptied auxiliary datum is resolvable
  obtain ⟨x, hxS, hcond⟩ := exists_cond_of_not_isImprovedAt hS m hnot
  have hF : ∀ F, r = .closed F → x ∈ ((T.pre m).strictTransform F).pts := by
    rintro F rfl
    exact hxS.2
  let 𝒮 : Frame hS := Frame.canon hS z b Jgen fr
  have hdim := 𝒮.exists_dimAt_xTilde_removalFamilyStar_eq_of_cond m x hcond hF
  have hres := 𝒮.removalFamilyStar.resolvable_datumII_emptyIfBot m hprep
    (hII₂ (N - 1) (by omega)) hdim
  obtain ⟨k₀, hk₀⟩ := (DatumII.Raw.resolvable_iff_exists_resolvableLen _).mp hres
  have hAux : 𝒮.AuxResolvable m k₀ :=
    ⟨fun _ => 0, 𝒮.removalFamilyStar.jBarT m, by
      show 𝒮.removalFamilyStar.jBarT m * ∏ j : Fin (𝒮.eTilde m).1,
        ((𝒮.removalFamilyStar.datumII m (fun _ => 0) (𝒮.removalFamilyStar.jBarT m)).E j) ^ 0 = _
      simp only [pow_zero, Finset.prod_const_one, mul_one], hk₀⟩
  have hQ : StageResolvable b P r hx₀ z Jgen (T.pre m) k₀ := by
    rw [stageResolvable_iff_auxResolvable,
      ← Frame.canon_stageOf_eq_fold (hS := hS) (z := z) (b := b) (jGen := Jgen) (fr := fr) m]
    have := (𝒮.auxResolvable_stageOf_iff m k₀).mpr hAux
    rwa [𝒮.eTildeOffset_eq] at this
  exact exists_extension_of_resolvableLen hgood hr (P := P) (x₀ := x₀) (Q := fun {Y'} g' k' =>
      StageResolvable b P r hx₀ z Jgen g' k')
    (fun g' hg' hp' hx' hQ' => isImprovedAt_of_stageResolvable_zero hNn hX hℜ hn hr hx₀ fr g' hg'
      hp' hx' hQ')
    (fun g' k' hg' hp' hx' hQ' => hM9 x₀ hx₀ z b Jgen fr g' hg' hp'.1 hp'.2 hx' k' hQ')
    k₀ (T.pre m) hg hp hQ


end OnePoint

/-! ### The conditional Theorems A* and B* -/

section Final

/-- **Theorem A* from the one-point step** (pp. 293-294, 307-310): the conclusion of Theorem A*
for a datum with closed restriction `F` and the hypotheses `I₁`, `I₂` of Proposition 1, if the
one-point step (KP, `OnePointStep`) holds for every presentation of the boundary.  Proposition 1
gives the initial prepared succession (`[(1)]`; `[(2)]` is vacuous in the closed case) and
`exists_hasEffectiveProperties_of_onePointStep` the finite iteration. -/
theorem exists_isPermissibleIClosed_hasEffectiveProperties_of_onePointStep [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' < N → FundamentalTheorem.I₁.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X) (F : Subscheme X)
    (hF : (ℜ : DatumI.Raw X).IsClosedRestriction F)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞))
    (hKP : ∀ P : DatumI.Presentation (ℜ : DatumI.Raw X),
      OnePointStep N (ℜ : DatumI.Raw X) P (.closed F)) :
    ∃ (X' : Scheme.{u}) (f : MonoidalSuccession X X'),
      f.IsPermissibleIClosed ℜ F ∧ HasEffectiveProperties N ℜ (.closed F) f := by
  obtain ⟨P⟩ := DatumI.nonempty_presentation hX ℜ
  have hgood : IsGoodDatumI N n X ℜ := ⟨hX, ℜ.2, hn.le⟩
  have hFr : (Restriction.closed F).IsFor (ℜ : DatumI.Raw X) := hF
  obtain ⟨Y, g, hg, hfin⟩ := exists_isPermissibleIClosed_hasFiniteImageOfDimEq N n hNn
    (fun N' n' h1 h2 _ => hI₁ N' n' h1 h2) hI₂ X hX ℜ ⟨P.α, P.E, P.E_codimOne, P.E_union⟩ F hF hn
  have hp : IsPrepared N P (.closed F) g := ⟨hfin, fun i U hU => nomatch hU⟩
  obtain ⟨Z, e, he, hE⟩ := exists_hasEffectiveProperties_of_onePointStep hgood hFr (hKP P) _ g hg
    hp le_rfl
  exact ⟨Z, g.append e, he, hE⟩

/-- **Theorem B* from the one-point step** (pp. 293-294, 307-310): the conclusion of Theorem B* for
a datum with open restriction `U` and the hypotheses `I₁`, `I₂` of Propositions 2 and 5, if the
one-point step (KP, `OnePointStep`) holds for every presentation of the boundary.  Proposition 2 and
the Preparation Theorem applied `α` times give the initial prepared succession
(`exists_isPermissibleSucc_hasFiniteImageOfDimEq_and_hasPreparedBoundary`). -/
theorem exists_isPermissibleIOpen_hasEffectiveProperties_of_onePointStep [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₂' : ∀ N' n' : ℕ, n' < N' → N' < N → FundamentalTheorem.I₂.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' ≤ N → n' ≤ n → FundamentalTheorem.I₁.{u} N' n')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X) (U : Set X)
    (hU : (ℜ : DatumI.Raw X).IsOpenRestriction U)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞))
    (hKP : ∀ P : DatumI.Presentation (ℜ : DatumI.Raw X),
      OnePointStep N (ℜ : DatumI.Raw X) P (.opn U)) :
    ∃ (X' : Scheme.{u}) (f : MonoidalSuccession X X'),
      f.IsPermissibleIOpen ℜ U ∧ HasEffectiveProperties N ℜ (.opn U) f := by
  obtain ⟨P⟩ := DatumI.nonempty_presentation hX ℜ
  have hgood : IsGoodDatumI N n X ℜ := ⟨hX, ℜ.2, hn.le⟩
  have hUr : (Restriction.opn U).IsFor (ℜ : DatumI.Raw X) := hU
  obtain ⟨Y, g, hg, hfin, hbd⟩ :=
    exists_isPermissibleSucc_hasFiniteImageOfDimEq_and_hasPreparedBoundary N n hNn hI₁
      (fun N' n' h1 h2 _ => hI₂' N' n' h1 h2) hI₂ X hX ℜ P (.opn U) hU hn
  obtain ⟨Z, e, he, hE⟩ := exists_hasEffectiveProperties_of_onePointStep hgood hUr (hKP P) _ g hg
    ⟨hfin, hbd⟩ le_rfl
  exact ⟨Z, g.append e, he, hE⟩

/-- **Theorem A* from the one-block lemma** (pp. 293-294, 307-310): the conclusion of Theorem A*
for a datum with closed restriction `F`, under the hypotheses of Theorem A and the one-block lemma
`OneBlockHyp` (M9, proved in `Hironaka/Ch4/AStarBStarLifting.lean`).
The printed Theorem A* is in `TheoremsAB.lean`; this is the same statement with
`OneBlockHyp` as an extra hypothesis.

Proof: `onePointStep_of_oneBlockStep` gives the one-point step and
`exists_isPermissibleIClosed_hasEffectiveProperties_of_onePointStep` the conclusion. -/
theorem exists_isPermissibleIClosed_hasEffectiveProperties_of_oneBlockHyp [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' < N → FundamentalTheorem.I₁.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (hII₂ : ∀ N' : ℕ, N' < N → FundamentalTheorem.II₂.{u} N')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X) (F : Subscheme X)
    (hF : (ℜ : DatumI.Raw X).IsClosedRestriction F)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞))
    (hM9 : ∀ P : DatumI.Presentation (ℜ : DatumI.Raw X),
      OneBlockHyp N (ℜ : DatumI.Raw X) P (.closed F)) :
    ∃ (X' : Scheme.{u}) (f : MonoidalSuccession X X'),
      f.IsPermissibleIClosed ℜ F ∧ HasEffectiveProperties N ℜ (.closed F) f := by
  have hFr : (Restriction.closed F).IsFor (ℜ : DatumI.Raw X) := hF
  exact exists_isPermissibleIClosed_hasEffectiveProperties_of_onePointStep N n hNn hI₁ hI₂ X hX ℜ
    F hF hn fun P => onePointStep_of_oneBlockStep hNn hII₂ hX ℜ.2 hn hFr (hM9 P)

/-- **Theorem B* from the one-block lemma** (pp. 293-294, 307-310): the conclusion of Theorem B* for
a datum with open restriction `U`, under the hypotheses of Theorem B and the one-block lemma
`OneBlockHyp`.  The printed Theorem B* is in `TheoremsAB.lean`; this is the same statement
with `OneBlockHyp` as an extra hypothesis. -/
theorem exists_isPermissibleIOpen_hasEffectiveProperties_of_oneBlockHyp [Hironaka.HironakaCitedResults.{u}] (N n : ℕ) (hNn : n < N)
    (hI₂' : ∀ N' n' : ℕ, n' < N' → N' < N → FundamentalTheorem.I₂.{u} N' n')
    (hI₂ : ∀ n'' : ℕ, n'' < n → FundamentalTheorem.I₂.{u} N n'')
    (hI₁ : ∀ N' n' : ℕ, n' < N' → N' ≤ N → n' ≤ n → FundamentalTheorem.I₁.{u} N' n')
    (hII₂ : ∀ N' : ℕ, N' < N → FundamentalTheorem.II₂.{u} N')
    (X : Scheme.{u}) (hX : IsAmbient X N) (ℜ : DatumI X) (U : Set X)
    (hU : (ℜ : DatumI.Raw X).IsOpenRestriction U)
    (hn : (ℜ : DatumI.Raw X).n = (n : WithBot ℕ∞))
    (hM9 : ∀ P : DatumI.Presentation (ℜ : DatumI.Raw X),
      OneBlockHyp N (ℜ : DatumI.Raw X) P (.opn U)) :
    ∃ (X' : Scheme.{u}) (f : MonoidalSuccession X X'),
      f.IsPermissibleIOpen ℜ U ∧ HasEffectiveProperties N ℜ (.opn U) f := by
  have hUr : (Restriction.opn U).IsFor (ℜ : DatumI.Raw X) := hU
  exact exists_isPermissibleIOpen_hasEffectiveProperties_of_onePointStep N n hNn hI₂' hI₂ hI₁ X hX
    ℜ U hU hn fun P => onePointStep_of_oneBlockStep hNn hII₂ hX ℜ.2 hn hUr (hM9 P)

end Final

end AB


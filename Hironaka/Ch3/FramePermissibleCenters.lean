section IterEStep

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The identification `{Z, X} ⊔ {Y} ≅ {Z, X, Y}` of index types, used to read `gr_M(R) =
k[Z, X, Y]` as the polynomial ring `k[Y][Z, X]` over `k[Y]` in `Z, X` (Lemma 18, p. 250: "Let
`Λ^{r+s}` be the E-function of `gr_M(R)` with respect to `(k[Y]; Z₁, …, Z_r, X₁, …, X_s)`"). -/
private def iterIndex (r s t : ℕ) : Fin (r + s) ⊕ Fin t ≃ Fin (r + (s + t)) :=
  finSumFinEquiv.trans (finCongr (Nat.add_assoc r s t))

private theorem iterIndex_inl_val (r s t : ℕ) (a : Fin (r + s)) :
    ((iterIndex r s t (Sum.inl a) : Fin (r + (s + t))) : ℕ) = a := by
  simp [iterIndex]

private theorem iterIndex_inr_val (r s t : ℕ) (b : Fin t) :
    ((iterIndex r s t (Sum.inr b) : Fin (r + (s + t))) : ℕ) = r + s + b := by
  simp [iterIndex]

private theorem iterIndex_inl_castAdd (r s t : ℕ) (i : Fin r) :
    iterIndex r s t (Sum.inl (Fin.castAdd s i)) = Fin.castAdd (s + t) i :=
  Fin.ext (by rw [iterIndex_inl_val]; rfl)

/-- `k[Y][Z, X] ≅ k[Z, X, Y]`: the polynomial ring in `Z, X` over `k[Y]` is the polynomial ring in
all the variables. -/
private noncomputable def iterEquiv (K : Type u) [CommRing K] (r s t : ℕ) :
    MvPolynomial (Fin (r + s)) (MvPolynomial (Fin t) K) ≃ₐ[K]
      MvPolynomial (Fin (r + (s + t))) K :=
  (sumAlgEquiv K (Fin (r + s)) (Fin t)).symm.trans (renameEquiv K (iterIndex r s t))

private theorem sumAlgEquiv_monomial' {K : Type*} [CommRing K] {S₁ S₂ : Type*}
    (d : (S₁ ⊕ S₂) →₀ ℕ) (c : K) :
    sumAlgEquiv K S₁ S₂ (monomial d c) =
      monomial (d.comapDomain Sum.inl Sum.inl_injective.injOn)
        (monomial (d.comapDomain Sum.inr Sum.inr_injective.injOn) c) := by
  simp [sumAlgEquiv, monomial, AddMonoidAlgebra.curryAlgEquiv_single]

/-- Every monomial of `q ∈ K[S₁ ⊕ S₂]`, read in `K[S₂][S₁]`, comes from a monomial of `q`. -/
private theorem exists_mem_support_of_mem_support_sumAlgEquiv {K : Type*} [CommRing K]
    {S₁ S₂ : Type*} (q : MvPolynomial (S₁ ⊕ S₂) K) {d' : S₁ →₀ ℕ}
    (hd' : d' ∈ (sumAlgEquiv K S₁ S₂ q).support) :
    ∃ d ∈ q.support, ∀ a, d (Sum.inl a) = d' a := by
  classical
  rw [q.as_sum, map_sum] at hd'
  obtain ⟨d, hd, hd2⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hd')
  refine ⟨d, hd, ?_⟩
  rw [sumAlgEquiv_monomial'] at hd2
  have := MvPolynomial.support_monomial_subset hd2
  rw [Finset.mem_singleton] at this
  intro a
  subst this
  rfl

variable {K : Type u} [CommRing K] {r s t : ℕ}

private theorem exists_mem_support_of_mem_support_iterEquiv_symm
    {p : MvPolynomial (Fin (r + (s + t))) K} {d' : Fin (r + s) →₀ ℕ}
    (hd' : d' ∈ ((iterEquiv K r s t).symm p).support) :
    ∃ d ∈ p.support, ∀ a, d (iterIndex r s t (Sum.inl a)) = d' a := by
  classical
  have h : (iterEquiv K r s t).symm p =
      sumAlgEquiv K (Fin (r + s)) (Fin t) (rename (iterIndex r s t).symm p) := rfl
  rw [h] at hd'
  obtain ⟨d₀, hd₀, hd₀a⟩ := exists_mem_support_of_mem_support_sumAlgEquiv _ hd'
  rw [MvPolynomial.support_rename_of_injective (iterIndex r s t).symm.injective] at hd₀
  obtain ⟨d, hd, rfl⟩ := Finset.mem_image.mp hd₀
  refine ⟨d, hd, fun a => ?_⟩
  rw [← hd₀a a]
  simp

private theorem weight_zxWeight_eq_sum (d : Fin (r + (s + t)) →₀ ℕ) :
    Finsupp.weight (zxWeight r s t) d = ∑ a : Fin (r + s), d (iterIndex r s t (Sum.inl a)) := by
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp),
    ← (iterIndex r s t).sum_comp, Fintype.sum_sum_type]
  have h1 : ∀ a : Fin (r + s), d (iterIndex r s t (Sum.inl a)) •
      zxWeight r s t (iterIndex r s t (Sum.inl a)) = d (iterIndex r s t (Sum.inl a)) := by
    intro a
    simp only [zxWeight, iterIndex_inl_val, smul_eq_mul]
    rw [ite_eq_left a.2, mul_one]
  have h2 : ∀ b : Fin t, d (iterIndex r s t (Sum.inr b)) •
      zxWeight r s t (iterIndex r s t (Sum.inr b)) = 0 := by
    intro b
    simp only [zxWeight, iterIndex_inr_val, smul_eq_mul]
    rw [ite_eq_right (by omega), mul_zero]
  simp only [h1, h2, Finset.sum_const_zero, add_zero]

/-- A weight-`μ` form in `Z, X, Y` (weight `1` on `Z, X` and `0` on `Y`) is a form of degree `μ` in
`Z, X` over `k[Y]`. -/
private theorem isHomogeneous_iterEquiv_symm {p : MvPolynomial (Fin (r + (s + t))) K} {μ : ℕ}
    (hp : IsWeightedHomogeneous (zxWeight r s t) p μ) :
    ((iterEquiv K r s t).symm p).IsHomogeneous μ := by
  intro d' hd'
  obtain ⟨d, hd, hdd⟩ := exists_mem_support_of_mem_support_iterEquiv_symm
    (mem_support_iff.mpr hd')
  have h1 := hp (mem_support_iff.mp hd)
  rw [weight_zxWeight_eq_sum] at h1
  have e : Finsupp.weight (1 : Fin (r + s) → ℕ) d' = d'.degree := by
    rw [Finsupp.degree_eq_weight_one]; rfl
  rw [e, Finsupp.degree_eq_sum, ← h1]
  exact Finset.sum_congr rfl fun a _ => (hdd a).symm

private theorem iterEquiv_symm_X_inl (a : Fin (r + s)) :
    (iterEquiv K r s t).symm (X (iterIndex r s t (Sum.inl a))) = X a := by
  have h : (iterEquiv K r s t).symm (X (iterIndex r s t (Sum.inl a))) =
      sumAlgEquiv K (Fin (r + s)) (Fin t)
        (rename (iterIndex r s t).symm (X (iterIndex r s t (Sum.inl a)))) := rfl
  rw [h, rename_X, Equiv.symm_apply_apply, sumAlgEquiv_X_inl]

private theorem iterEquiv_symm_rename_castAdd (q : MvPolynomial (Fin r) K) :
    (iterEquiv K r s t).symm (rename (Fin.castAdd (s + t)) q) =
      MvPolynomial.map (C : K →+* MvPolynomial (Fin t) K) (rename (Fin.castAdd s) q) := by
  induction q using MvPolynomial.induction_on with
  | C a =>
    have h : (iterEquiv K r s t).symm (C a) = C (C a) := by
      have h' : (iterEquiv K r s t).symm (C a) =
          sumAlgEquiv K (Fin (r + s)) (Fin t) (rename (iterIndex r s t).symm (C a)) := rfl
      rw [h', rename_C, sumAlgEquiv_C_inl]
    simp [h]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, rename_X, hp]
    rw [← iterIndex_inl_castAdd r s t i, iterEquiv_symm_X_inl]
    simp

/-- The ideal generated by the image of a homogeneous ideal under `rename (Fin.castAdd s)` is
homogeneous. -/
private theorem isHomogeneous_map_rename_castAdd {I₀ : Ideal (MvPolynomial (Fin r) K)}
    (hI₀ : I₀.IsHomogeneous (homogeneousSubmodule (Fin r) K)) :
    (I₀.map (rename (R := K) (Fin.castAdd s))).IsHomogeneous
      (homogeneousSubmodule (Fin (r + s)) K) := by
  obtain ⟨S₀, rfl⟩ := (Ideal.IsHomogeneous.iff_exists _ _).mp hI₀
  rw [Ideal.map_span]
  refine Ideal.homogeneous_span _ _ ?_
  rintro _ ⟨_, ⟨x, hxS, rfl⟩, rfl⟩
  obtain ⟨d, hd⟩ := x.2
  refine ⟨d, ?_⟩
  rw [mem_homogeneousSubmodule] at hd ⊢
  exact hd.rename_isHomogeneous

end IterEStep

section IterEStep2

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable {K : Type u} [Field K] {r s t : ℕ}

/-- **Remarks 1 and 2 at the end of the proof of Lemma 18 (p. 250).**  A non-zero form `φ` of
degree `ν` in `Z₁, …, Z_r, X₁, …, X_s` over `k[Y]`, lying in the ideal generated by a homogeneous
ideal `I₀ ⊆ k[Z]`, has `Z`-part of its leading exponent in `E_r(I₀)`.  The paper's steps: "Then
`Λ^{r+s}(λ(Φ₀)) ∈ E^{r+s}`", where `E^{r+s}` is the E-set of the ideal over `k[Y]`; "By Remark 1,
`E^{r+s}` is also the E-set of `(φ₁, …, φ_i)k[Z₁, …, Z_r, X₁, …, X_s]` with respect to
`(k; Z₁, …, Z_r, X₁, …, X_s)`; and, by Remark 2, `E^{r+s}` is bounded by `q(E^r)`.  It follows that
the above `Ā ∈ E^r`."  (The degenerate cases `r = 0` and `s = 0`, in which Remark 2 (stated for
`1 ≤ t < r`) does not apply, are treated separately.) -/
private theorem exists_zPart_mem_eSet_iter (I₀ : Ideal (MvPolynomial (Fin r) K))
    (hI₀ : I₀.IsHomogeneous (homogeneousSubmodule (Fin r) K))
    {φ : MvPolynomial (Fin (r + s)) (MvPolynomial (Fin t) K)} (hφ0 : φ ≠ 0) {ν : ℕ}
    (hφh : φ.IsHomogeneous ν)
    (hφI : φ ∈ (I₀.map (rename (R := K) (Fin.castAdd s))).map
      (MvPolynomial.map (C : K →+* MvPolynomial (Fin t) K))) :
    ∃ B ∈ φ.support, zPart B ∈ ESet I₀ := by
  classical
  -- Remark 1: the `E`-set over `k[Y]` of the extended ideal is the `E`-set over `k`
  have hR1 : ESet ((I₀.map (rename (R := K) (Fin.castAdd s))).map
      (MvPolynomial.map (C : K →+* MvPolynomial (Fin t) K))) =
        ESet (I₀.map (rename (R := K) (Fin.castAdd s))) :=
    (eSet_map_of_injective (C : K →+* MvPolynomial (Fin t) K) (C_injective _ _) _
      (isHomogeneous_map_rename_castAdd hI₀)).2 fun a ha b hab => by
      have h1 : (C a⁻¹ : MvPolynomial (Fin t) K) * (C a * b) = b := by
        rw [← mul_assoc, ← C_mul, inv_mul_cancel₀ ha, C_1, one_mul]
      rw [← h1, hab, mul_zero]
  obtain ⟨Bs, hBs, hEF, -⟩ := eFunction_spec_aux hφ0
  have hΛ : ⇑Bs ∈ ESet ((I₀.map (rename (R := K) (Fin.castAdd s))).map
      (MvPolynomial.map (C : K →+* MvPolynomial (Fin t) K))) :=
    ⟨_, ⟨_, hφI, hφ0, ⟨ν, hφh⟩, hEF.symm⟩, 0, (add_zero _).symm⟩
  rw [hR1] at hΛ
  refine ⟨Bs, hBs, ?_⟩
  rcases Nat.eq_zero_or_pos r with hr | hr
  · -- `r = 0`: `I₀ ≠ 0` contains a non-zero constant, and `E = Z₀⁰`
    subst hr
    have hI₀ne : I₀ ≠ ⊥ := by
      rintro h
      rw [h, Ideal.map_bot, Ideal.map_bot] at hφI
      exact hφ0 ((Submodule.mem_bot _).mp hφI)
    obtain ⟨c, hcI, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI₀ne
    have hcE : EFunction c ∈ ESet I₀ := ⟨_, ⟨c, hcI, hc0, ⟨0, by
      rw [mem_homogeneousSubmodule, MvPolynomial.eq_C_of_isEmpty c]
      exact isHomogeneous_C _ _⟩, rfl⟩, 0, (add_zero _).symm⟩
    have : zPart Bs = EFunction c := funext fun i => i.elim0
    rw [this]
    exact hcE
  rcases Nat.eq_zero_or_pos s with hs | hs
  · -- `s = 0`: `rename (castAdd 0)` is the identity
    subst hs
    have hid : (Fin.castAdd 0 : Fin r → Fin (r + 0)) = id := rfl
    have hI : I₀.map (rename (R := K) (Fin.castAdd 0)) = I₀ := by
      rw [hid, rename_id]
      exact Ideal.map_id I₀
    rw [hI] at hΛ
    exact hΛ
  · have hbound := eSet_isBound_qInj_image (S := K) hr (show r < r + s by omega) I₀ hI₀
    have hcast : (Fin.castLE (show r < r + s by omega).le : Fin r → Fin (r + s)) =
        Fin.castAdd s := funext fun i => Fin.ext rfl
    rw [hcast] at hbound
    obtain ⟨_, ⟨A₀, hA₀, rfl⟩, B', hBB⟩ := hbound.2 _ hΛ
    have : zPart Bs = A₀ + fun i => B' (Fin.castAdd s i) := by
      funext i
      have := congrFun hBB (Fin.castAdd s i)
      simp only [Pi.add_apply, qInj] at this
      rw [dite_eq_left (show ((Fin.castAdd s i : Fin (r + s)) : ℕ) < r from i.2)] at this
      simpa [zPart] using this
    rw [this]
    exact add_mem_eSet hA₀ _

end IterEStep2

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

private theorem adaptedEquiv_rename_castAdd (hA : F.IsAdapted P w)
    (q : MvPolynomial (Fin F.r) (R ⧸ maximalIdeal R)) :
    adaptedEquiv hA (rename (Fin.castAdd (s + t)) q) = frameAlgHom F.z q := by
  have : (adaptedEquiv hA).toAlgHom.comp (rename (Fin.castAdd (s + t))) = frameAlgHom F.z :=
    MvPolynomial.algHom_ext fun l => by
      rw [AlgHom.comp_apply, rename_X, frameAlgHom, aeval_X]
      exact adaptedEquiv_X_castAdd hA l
  exact AlgHom.congr_fun this q

private theorem isWeightedHomogeneous_rename_castLE {d : ℕ}
    {Ab : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)}
    (hAb : Ab.IsHomogeneous d) :
    IsWeightedHomogeneous (zxWeight F.r s t)
      (rename (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega)) Ab) d := by
  classical
  intro e he
  have hinj : Function.Injective (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega)) :=
    Fin.castLE_injective _
  have he' : e ∈ (rename (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega)) Ab).support :=
    mem_support_iff.mpr he
  rw [MvPolynomial.support_rename_of_injective hinj] at he'
  obtain ⟨e', he'', rfl⟩ := Finset.mem_image.mp he'
  rw [weight_zxWeight_mapDomain_castLE]
  have := hAb (mem_support_iff.mp he'')
  rw [Finsupp.degree_eq_weight_one]
  exact this

/-- `P` is generated by the `r + s` elements `(z, x)`. -/
private theorem eq_span_range_append (hA : F.IsAdapted P w) :
    P = Ideal.span (Set.range (Fin.append F.z
      (fun j : Fin s => algebraMap F.S R (w (Fin.castAdd t j))))) := by
  rw [span_range_fin_append, hA.eq_sup, xIdeal, Ideal.map_span, ← Set.range_comp]
  rfl

/-- The family `y = (w_{s+1}, …, w_{s+t})` satisfies `M = P + (y)`, its classes generate `M/P`, and
`t` is the minimal number of generators of `M/P`: "Let us choose a system of elements
`(y_1, …, y_t)` of `R` such that their residue classes modulo `P` form a regular system of
parameters of `R/P`" (Lemma 18, p. 249).  (The `y_l` are chosen in `S`, which the text allows:
`R = S + (z)R` and `(z)R ⊆ P`.) -/
private theorem span_map_eq_and_card_eq_spanFinrank (hA : F.IsAdapted P w) [P.IsPrime]
    [IsRegularLocalRing (R ⧸ P)] :
    Ideal.span (Set.range fun l : Fin t =>
      Ideal.Quotient.mk P (algebraMap F.S R (w (Fin.natAdd s l)))) =
        (maximalIdeal R).map (Ideal.Quotient.mk P) ∧
      t = ((maximalIdeal R).map (Ideal.Quotient.mk P)).spanFinrank := by
  classical
  have hPM : P ≤ maximalIdeal R := le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)
  have hYspan : Ideal.span (Set.range fun l : Fin t => algebraMap F.S R (w (Fin.natAdd s l))) =
      Ideal.span (adaptedFamily F w '' ↑(adaptedZs F s t)ᶜ) := by
    rw [span_image_adaptedZs_compl, yIdeal, Ideal.map_span, ← Set.range_comp]
    rfl
  have hM : maximalIdeal R = P ⊔ Ideal.span
      (Set.range fun l : Fin t => algebraMap F.S R (w (Fin.natAdd s l))) := by
    rw [hYspan]
    exact maximalIdeal_eq_sup_adapted hA
  have hy : Ideal.span (Set.range fun l : Fin t =>
      Ideal.Quotient.mk P (algebraMap F.S R (w (Fin.natAdd s l)))) =
        (maximalIdeal R).map (Ideal.Quotient.mk P) := by
    conv_rhs => rw [hM]
    rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, ← Set.range_comp]
    rfl
  refine ⟨hy, le_antisymm ?_ ?_⟩
  · -- `t ≤ spanFinrank (M/P)`: `M` is generated by `r + s + spanFinrank (M/P)` elements
    obtain ⟨s₀, y₀, hy₀, hs₀⟩ := exists_span_eq_map_and_eq_spanFinrank P (maximalIdeal R)
    have hM₀ : maximalIdeal R = P ⊔ Ideal.span (Set.range y₀) :=
      eq_sup_span_of_span_map_eq P _ hPM y₀ hy₀
    have hspan : maximalIdeal R = Ideal.span (Set.range (Fin.append
        (Fin.append F.z (fun j : Fin s => algebraMap F.S R (w (Fin.castAdd t j)))) y₀)) := by
      rw [span_range_fin_append, ← eq_span_range_append hA]
      exact hM₀
    have h1 : (maximalIdeal R).spanFinrank ≤ F.r + s + s₀ := by
      rw [hspan]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
    have hrank := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hA.dim_eq] at hrank
    have hrank' : (maximalIdeal R).spanFinrank = F.r + (s + t) := by exact_mod_cast hrank
    omega
  · -- `spanFinrank (M/P) ≤ t`: `M/P` is generated by `t` elements
    rw [← hy]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]

/-- **The core of the proof of Lemma 18** (pp. 249--250), in the completion `R̂ = S{z_1, …, z_r}`
(`R` a regular local ring with a regular frame; for `R = S{z}` the expansion coefficients are the
coefficients `c_A` of `f = Σ c_A z^A`).  Let `μ = |A_0| + ν_P(c_{A_0})` be the minimum of the
integers `|A| + ν_P(c_A)`; then `ν_P(g) = μ` (the equivalence asserted without proof on p. 249).
The initial form `Φ` of `g` in `gr_P(R)` is `Σ Γ_A Ẑ^A`, `Γ_A` the initial form of `c_A`, for the
`A` of the finite set `T = {A | |A| + ν_P(c_A) = μ}`; `n` is the largest integer with
`Φ ∈ M̄^n gr_P(R)`, and `Γ_A ∈ M̄^n gr_P(R)`: the `c_A` have lifts `c'_A ∈ (y)^n P^{μ-|A|}`
(`c_A(h₁)` for an `h₁ ∈ (y)^n P^μ` with `g - h₁ ∈ P^{μ+1}`), `c'_A = Q_A(x, y)` with `Q_A`
bihomogeneous of bidegree `(μ - |A|, n)`, i.e. `γ_A = Q_A(X, Y)` is doubly homogeneous of degree
`μ - |A|` in `X` and `n` in `Y`.  By Lemma 10 (paper form, `exists_mul_mem_grIdeal_lambdaPiece`)
the `λ`-image `λ(Φ_0)` of the initial form `Φ_0` of `g` in `gr_{M̄}(gr_P(R))` lies in `gr_M(J, R)`,
and it is `Σ γ_A Z^A = [Σ_A c'_A z^A]` (`ofGrPiece_lambdaPiece_eq_mk`: `λ` sends the class of `ȳ_j`
to that of `y_j`).  `Kb` is `λ(Φ_0)` as a polynomial in `k[Z, X, Y]`, `Kb ≠ 0`, with `Z`-parts of
its monomials in `T`, so that `c_A ≠ 0` for them. -/
private theorem exists_core_form [Hironaka.Cited.ExistsSurjectiveOfIsRegularLocalRingOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (hA : F.IsAdapted P w) [P.IsPrime]
    (hPreg : IsRegularLocalRing (R ⧸ P))
    (J : Ideal R) (hJP : J ≤ P) (hflat : IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)))
    {g : R} (hgJ : g ∈ J) {μ : ℕ} (A₀ : Fin F.r →₀ ℕ)
    (hA₀ : (A₀.degree : ℕ∞) + Ideal.ordElem P (algebraMap F.S R (F.expCoeff g A₀)) = μ)
    (hmin : ∀ A : Fin F.r →₀ ℕ, (μ : ℕ∞) ≤ (A.degree : ℕ∞) +
      Ideal.ordElem P (algebraMap F.S R (F.expCoeff g A))) :
    ∃ (n : ℕ) (Kb : MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R)),
      Ideal.ordElem P g = μ ∧ doubleOrd P (maximalIdeal R) (initialForm P g) = n ∧
      Kb ≠ 0 ∧ adaptedEquiv hA Kb ∈ grIdeal (maximalIdeal R) J ∧
      Kb.IsHomogeneous (μ + n) ∧ IsWeightedHomogeneous (zxWeight F.r s t) Kb μ ∧
      (∀ m ∈ Kb.support, ∀ A : Fin F.r →₀ ℕ, zPart m = ⇑A → F.expCoeff g A ≠ 0) ∧
      ∃ h : R, g - h ∈ P ^ (μ + 1) ∧ ∃ hh : h ∈ maximalIdeal R ^ (μ + n),
        adaptedEquiv hA Kb = AssocGraded.mk (maximalIdeal R) (μ + n) h hh := by
  classical
  have hPtop : P ≠ ⊤ := Ideal.IsPrime.ne_top ‹_›
  have hPM : P ≤ maximalIdeal R := le_maximalIdeal hPtop
  have hJM : J ≤ maximalIdeal R := hJP.trans hPM
  set u := adaptedFamily F w with hu
  set Zs := adaptedZs F s t with hZs
  set Y := Ideal.span (u '' ↑Zsᶜ) with hYdef
  have hYm : Y = Ideal.map (algebraMap F.S R) (yIdeal w) := span_image_adaptedZs_compl
  have hMPY : maximalIdeal R = P ⊔ Y := maximalIdeal_eq_sup_adapted hA
  have hYM : Y ≤ maximalIdeal R := hMPY ▸ le_sup_right
  have hzP : F.idealZ ≤ P := hA.eq_sup ▸ le_sup_left
  have hxP : Ideal.map (algebraMap F.S R) (xIdeal w) ≤ P := hA.eq_sup ▸ le_sup_right
  have hPle : P ≤ F.idealZ ⊔ Ideal.map (algebraMap F.S R) (xIdeal w) := hA.eq_sup.le
  -- "ν_P(c_A) ≥ ν̄ - |A| for all A, or equivalently ν_P(f) ≥ ν̄": `ν_P(g) = μ`
  have hμ' : Ideal.ordElem P g = μ :=
    ordElem_eq_of_isLeast F (xIdeal w) P hA.eq_sup g A₀ hA₀ hmin
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (doubleOrd_ne_top P hPtop hμ')
  have hn' : doubleOrd P (maximalIdeal R) (initialForm P g) = n := hn.symm
  obtain ⟨h₁, hh₁, hgh₁⟩ := exists_mem_pow_mul_pow_of_le_doubleOrd P (maximalIdeal R) Y hMPY hμ'
    (k := n) (by rw [hn'])
  have hh₁m : h₁ ∈ Ideal.map (algebraMap F.S R) (yIdeal w) ^ n * P ^ μ := by
    rw [← hYm]; exact hh₁
  -- Lemma 10, in the paper's form, for `Q = M` and the minimal base `y` of `M/P`
  have hMprime : ((maximalIdeal R).map (Ideal.Quotient.mk J)).IsPrime :=
    (isMaximal_map_quotientMk_of_le hJM).isPrime
  have : IsRegularLocalRing (R ⧸ maximalIdeal R) := by
    let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
    infer_instance
  have := hPreg
  have hflat' := isNormallyFlatAlongIdeal_localization_maximalIdeal J P hPreg hJP hflat
  set y : Fin t → R := fun l => algebraMap F.S R (w (Fin.natAdd s l)) with hy_def
  obtain ⟨hy, hs⟩ := span_map_eq_and_card_eq_spanFinrank hA
  have hYspan : Ideal.span (Set.range y) = Y := by
    rw [hYm, yIdeal, Ideal.map_span, ← Set.range_comp]
    rfl
  have hqr := isQuasiRegular_mk_of_span_eq_map_of_spanFinrank P (maximalIdeal R) hPM y hy hs
  have hgP : g ∈ P ^ μ := Ideal.mem_pow_of_ordElem hμ'
  have hΦ := mk_mem_pow_smul_top_of_doubleOrd P (maximalIdeal R) hμ' hn'
  obtain ⟨t₁, ht₁, ht₁mem⟩ := exists_mul_mem_grIdeal_lambdaPiece R J P (maximalIdeal R) hJP hPM
    hflat' y hy hs hgJ hμ' hn'
  -- the finite set `T = {A | |A| + ν_P(c_A) = μ}`
  obtain ⟨T₀, hT₀⟩ := exists_finset_degree_le' (r := F.r) μ
  set T := T₀.filter fun A =>
    (A.degree : ℕ∞) + Ideal.ordElem P (algebraMap F.S R (F.expCoeff g A)) = μ with hT
  have hTdeg' : ∀ A : Fin F.r →₀ ℕ, (A.degree : ℕ∞) +
      Ideal.ordElem P (algebraMap F.S R (F.expCoeff g A)) = μ → A.degree ≤ μ := fun A hA' => by
    have : (A.degree : ℕ∞) ≤ μ := by rw [← hA']; exact le_self_add
    exact_mod_cast this
  have hTmem : ∀ A, A ∈ T ↔ (A.degree : ℕ∞) +
      Ideal.ordElem P (algebraMap F.S R (F.expCoeff g A)) = μ := fun A =>
    ⟨fun hA' => (Finset.mem_filter.mp hA').2,
      fun hA' => Finset.mem_filter.mpr ⟨hT₀ A (hTdeg' A hA'), hA'⟩⟩
  have hTdeg : ∀ A ∈ T, A.degree ≤ μ := fun A hA' => hTdeg' A ((hTmem A).mp hA')
  -- `c'_A = c_A(h₁) = Q_A(x, y)` with `Q_A` bihomogeneous of bidegree `(μ - |A|, n)`
  have hQ : ∀ A : Fin F.r →₀ ℕ, ∃ Q : MvPolynomial (Fin (s + t)) F.S,
      IsBidegreeForm (μ - A.degree) n Q ∧ eval w Q = F.expCoeff h₁ A := fun A =>
    exists_isBiHomogeneous_of_mem w
      (expCoeff_mem_pow_mul_pow F (xIdeal w) (yIdeal w) P hPle hh₁m A)
  choose Q hQh hQe using hQ
  set K := coreForm F T Q with hK
  have hKh : K.IsHomogeneous (μ + n) := isHomogeneous_coreForm hTdeg (fun A _ => hQh A)
  set φ : F.S →+* R ⧸ maximalIdeal R :=
    (Ideal.Quotient.mk (maximalIdeal R)).comp (algebraMap F.S R) with hφ
  set KR := K.map (algebraMap F.S R) with hKR
  have hKRh : KR.IsHomogeneous (μ + n) := hKh.map _
  -- `h = Σ_{A ∈ T} c'_A z^A`
  set h := eval u KR with hh
  have hhM : h ∈ maximalIdeal R ^ (μ + n) :=
    eval_mem_pow_of_isHomogeneous (maximalIdeal R) u (adaptedFamily_mem hA) hKRh
  have hheq : h = ∑ A ∈ T, algebraMap F.S R (F.expCoeff h₁ A) * F.zMonomial A := by
    rw [hh, hKR, hK, eval_coreForm_map]
    exact Finset.sum_congr rfl fun A _ => by rw [hQe A]
  have hterm : ∀ A ∈ T, algebraMap F.S R (F.expCoeff h₁ A) * F.zMonomial A ∈ Y ^ n * P ^ μ := by
    intro A hAT
    have h1 := expCoeff_mem_pow_mul_pow F (xIdeal w) (yIdeal w) P hPle hh₁m A
    have h2 := Ideal.mem_map_of_mem (algebraMap F.S R) h1
    rw [Ideal.map_mul, Ideal.map_pow, Ideal.map_pow, ← hYm] at h2
    have h3 : algebraMap F.S R (F.expCoeff h₁ A) ∈ P ^ (μ - A.degree) * Y ^ n :=
      Ideal.mul_mono_left (Ideal.pow_right_mono hxP _) h2
    have h4 : F.zMonomial A ∈ P ^ A.degree :=
      Ideal.pow_right_mono hzP _ (prod_z_pow_mem F A)
    have h5 := Ideal.mul_mem_mul h3 h4
    have e : P ^ (μ - A.degree) * Y ^ n * P ^ A.degree = Y ^ n * P ^ μ := by
      calc P ^ (μ - A.degree) * Y ^ n * P ^ A.degree
          = Y ^ n * (P ^ (μ - A.degree) * P ^ A.degree) := by ring
        _ = Y ^ n * P ^ μ := by rw [← pow_add, Nat.sub_add_cancel (hTdeg A hAT)]
    rwa [e] at h5
  have hhY : h ∈ Y ^ n * P ^ μ := by
    rw [hheq]
    exact sum_mem hterm
  -- `g - h ∈ P^(μ+1)`: `Φ = Σ Γ_A Ẑ^A` for the `A ∈ T`
  have hgh : g - h ∈ P ^ (μ + 1) := by
    rw [mem_pow_iff_expCoeff_mem F (xIdeal w) P hA.eq_sup]
    intro B
    set G : MvPolynomial (Fin F.r) F.S := ∑ A ∈ T, monomial A (F.expCoeff h₁ A) with hG
    have hevG : evZ F G = h := by
      rw [hheq, hG, map_sum]
      refine Finset.sum_congr rfl fun A _ => ?_
      rw [evZ, aeval_monomial]
      rfl
    have hcoeffh : F.expCoeff h B = G.coeff B :=
      expCoeff_eq F (n := B.degree + 1) (G := G)
        (by rw [hevG, sub_self]; exact zero_mem _) (Nat.lt_succ_self _)
    rw [expCoeff_sub, hcoeffh, hG, coeff_sum]
    simp only [coeff_monomial]
    rw [Finset.sum_ite_eq']
    by_cases hBT : B ∈ T
    · rw [ite_eq_left hBT]
      have h2 := (mem_pow_iff_expCoeff_mem F (xIdeal w) P hA.eq_sup (μ + 1) _).mp hgh₁ B
      rwa [expCoeff_sub] at h2
    · rw [ite_eq_right hBT, sub_zero]
      have hlt : (μ : ℕ∞) < (B.degree : ℕ∞) +
          Ideal.ordElem P (algebraMap F.S R (F.expCoeff g B)) :=
        lt_of_le_of_ne (hmin B) fun h' => hBT ((hTmem B).mpr h'.symm)
      have : ((μ + 1 : ℕ) : ℕ∞) ≤ (B.degree : ℕ∞) +
          Ideal.ordElem P (algebraMap F.S R (F.expCoeff g B)) := by
        rw [Nat.cast_add_one]
        exact (ENat.add_one_le_iff (ENat.natCast_ne_top μ)).mpr hlt
      exact expCoeff_mem_pow_of_le F (xIdeal w) P hA.eq_sup g B this
  -- `Θ(Kb) = [h]`
  set Kb := K.map φ with hKb
  have hKbeq : Kb = KR.map (Ideal.Quotient.mk (maximalIdeal R)) :=
    (MvPolynomial.map_map _ _ _).symm
  have hΘ : adaptedEquiv hA Kb = AssocGraded.mk (maximalIdeal R) (μ + n) h hhM := by
    rw [hKbeq]
    exact adaptedEquiv_map_mk hA hKRh
  -- `λ(Φ_0) = [h]`, so that `Θ(Kb) ∈ gr_M(J, R)` by Lemma 10
  have hlam := ofGrPiece_lambdaPiece_eq_mk P (maximalIdeal R) hPM y hqr hy μ n
    (grModMap_bijective_of_isRegularLocalRing_quotient P _ μ n) hgP hΦ
    (by rw [hYspan]; exact hhY) hgh hhM
  have hκ : AssocGraded.mk (maximalIdeal R) (μ + n) h hhM ∈ grIdeal (maximalIdeal R) J := by
    rw [hlam] at ht₁mem
    have hunit : IsUnit t₁ := by
      by_contra hcu
      exact ht₁ ((IsLocalRing.mem_maximalIdeal t₁).mpr hcu)
    exact (Ideal.unit_mul_mem_iff_mem _
      (hunit.map (algebraMap R (AssocGraded (maximalIdeal R))))).mp ht₁mem
  have hKb0 : Kb ≠ 0 := by
    intro hKb0
    have hz : AssocGraded.mk (maximalIdeal R) (μ + n) h hhM = 0 := by rw [← hΘ, hKb0, map_zero]
    have hhM' : h ∈ maximalIdeal R ^ (μ + n + 1) := (AssocGraded.mk_eq_zero_iff _ _).mp hz
    have hhP : h ∈ P ^ μ := Ideal.mul_le_right hhY
    have hspanu : Ideal.span (Set.range u) = maximalIdeal R := hA.span_adapted
    have hind := hind_of_isQuasiRegular u (isQuasiRegular_adaptedFamily hA) Zs
    rw [span_image_adaptedZs hA, hspanu] at hind
    have hsum := inf_pow_le_sum P Y (maximalIdeal R) hMPY hind μ (μ + n + 1) (by omega)
      ⟨hhP, hhM'⟩
    have hle : ∑ a ∈ Finset.Icc μ (μ + n + 1), P ^ a * Y ^ (μ + n + 1 - a) ≤
        Y ^ (n + 1) * P ^ μ ⊔ P ^ (μ + 1) := by
      refine ideal_sum_le _ _ _ fun a ha => ?_
      obtain ⟨ha1, ha2⟩ := Finset.mem_Icc.mp ha
      rcases Nat.eq_or_lt_of_le ha1 with rfl | hlt
      · refine le_sup_of_le_left ?_
        rw [show μ + n + 1 - μ = n + 1 by omega, mul_comm]
      · exact le_sup_of_le_right ((Ideal.mul_le_left).trans (Ideal.pow_le_pow_right hlt))
    obtain ⟨h'', hh'', p, hp, hsum'⟩ := Submodule.mem_sup.mp (hle hsum)
    have hgh'' : g - h'' ∈ P ^ (μ + 1) := by
      have e : g - h'' = (g - h) + p := by rw [← hsum']; ring
      rw [e]
      exact add_mem hgh hp
    have := le_doubleOrd_of_mem_pow_mul_pow P (maximalIdeal R) Y hYM hμ' (n := n + 1)
      ⟨h'', hh'', hgh''⟩
    rw [hn'] at this
    exact absurd (Nat.cast_le.mp this) (by omega)
  -- the monomials of `Kb` have `Z`-parts in `T`, so `c_A ≠ 0` for them
  have hsupp : ∀ m ∈ Kb.support, ∀ A : Fin F.r →₀ ℕ, zPart m = ⇑A → F.expCoeff g A ≠ 0 := by
    intro m hm A hAm hg
    obtain ⟨A', hA'T, hzA', -⟩ := exists_mem_of_mem_support_coreForm_map φ hm
    have hAA : A' = A := DFunLike.coe_injective (hzA'.symm.trans hAm)
    subst hAA
    have h1 := (hTmem A').mp hA'T
    rw [hg, map_zero, (Ideal.ordElem_eq_top_iff.mpr fun ν => zero_mem _ :
      Ideal.ordElem P (0 : R) = ⊤), add_top] at h1
    exact ENat.top_ne_natCast μ h1
  refine ⟨n, Kb, hμ', hn', hKb0, ?_, hKh.map _,
    isWeightedHomogeneous_coreForm_map φ hTdeg (fun A _ => hQh A), hsupp, h, hgh, hhM, hΘ⟩
  rw [hΘ]
  exact hκ

end RegularFrame

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- The contradiction at the end of the proof of Lemma 18 (p. 250): "`Λ^{r+s}(λ(Φ₀)) ∈ E^{r+s}`
[…] `= q(Ā) + B` with some `Ā` with `|Ā| + ν_P(c_Ā) = μ` […].  By Remark 1, `E^{r+s}` is also the
E-set of `(φ₁, …, φ_i)k[Z₁, …, Z_r, X₁, …, X_s]` with respect to `(k; Z₁, …, Z_r, X₁, …, X_s)`;
and, by Remark 2, `E^{r+s}` is bounded by `q(E^r)`.  It follows that the above `Ā ∈ E^r`.  However
`|Ā| + ν_P(c_Ā) = μ` implies that `c_Ā ≠ 0`.  This is a contradiction to (iii)."  Here `Kb` is
`λ(Φ₀)` as a non-zero form of degree `μ` in `Z, X` over `k[Y]` (`gr_M(R) = k[Y][Z, X]`) lying in the
ideal generated by the polynomial counterparts of `φ₁, …, φ_i` (which lie in `k[Z]`); its leading
exponent has `Z`-part in `E^r` (`exists_zPart_mem_eSet_iter`); if `g` is normalized by
`(f₁, …, f_i)`, the corresponding coefficient `c_A` of `g` is `0`, contradicting the support
condition on `Kb`. -/
private theorem false_of_mem_lowIdeal (F : RegularFrame R) {P : Ideal R} {s t : ℕ}
    {w : Fin (s + t) → F.S}
    (hA : F.IsAdapted P w) {i : ℕ} (f : Fin i → R)
    (h2 : ∀ j, initialForm (maximalIdeal R) (f j) ∈ F.assocSubalgebra)
    (g : R) (h3 : F.IsNormalizedBy f g)
    {Kb : MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R)} (hKb0 : Kb ≠ 0) {μ : ℕ}
    (hKbw : IsWeightedHomogeneous (zxWeight F.r s t) Kb μ)
    (hsupp : ∀ m ∈ Kb.support, ∀ A : Fin F.r →₀ ℕ, zPart m = ⇑A → F.expCoeff g A ≠ 0)
    (hlow : Kb ∈ Ideal.span
      (Set.range fun j : Fin i => (adaptedEquiv hA).symm (initialForm (maximalIdeal R) (f j)))) :
    False := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  set Θ := adaptedEquiv hA with hΘ
  have hΘh : ∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R)),
      p ∈ homogeneousSubmodule (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) d ↔
        Θ p ∈ AssocGraded.homogeneous (maximalIdeal R) d := mem_homogeneous_adaptedEquiv_iff hA
  set lowI := Ideal.span
    (Set.range fun j : Fin i => Θ.symm (initialForm (maximalIdeal R) (f j))) with hlowI
  set I₀ := frameInitialIdeal F.z f with hI₀def
  have hq : ∀ j, ∃ q, frameAlgHom F.z q = initialForm (maximalIdeal R) (f j) := by
    intro j
    have h := h2 j
    unfold RegularFrame.assocSubalgebra at h
    unfold Hironaka.assocSubalgebra at h
    rw [Algebra.adjoin_range_eq_range_aeval] at h
    exact h
  choose q hq using hq
  have hqI : ∀ j, q j ∈ I₀ := fun j => Ideal.subset_span ⟨j, hq j⟩
  have hlowle : lowI ≤ I₀.map (rename (Fin.castAdd (s + t))) := by
    rw [hlowI, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    show Θ.symm (initialForm (maximalIdeal R) (f j)) ∈ _
    have : Θ.symm (initialForm (maximalIdeal R) (f j)) = rename (Fin.castAdd (s + t)) (q j) := by
      rw [← hq j, hΘ, ← adaptedEquiv_rename_castAdd hA, AlgEquiv.symm_apply_apply]
    rw [this]
    exact Ideal.mem_map_of_mem _ (hqI j)
  have hI₀h : I₀.IsHomogeneous (homogeneousSubmodule (Fin F.r) (R ⧸ maximalIdeal R)) := by
    apply Ideal.homogeneous_span
    rintro q' ⟨j, hj⟩
    obtain ⟨d, hd⟩ := initialForm_mem_homogeneous_aux' (maximalIdeal R) (f j)
    refine ⟨d, ?_⟩
    have h1' : rename (Fin.castAdd (s + t)) q' ∈
        homogeneousSubmodule (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) d :=
      (hΘh d _).mpr (by rw [hΘ, adaptedEquiv_rename_castAdd hA, hj]; exact hd)
    exact (IsHomogeneous.rename_isHomogeneous_iff (Fin.castAdd_injective _ _)).mp h1'
  -- `gr_M(R) = k[Z, X, Y] = k[Y][Z, X]`: `Kb` is a form of degree `μ` in `Z, X` over `k[Y]`
  set Kb' := (iterEquiv (R ⧸ maximalIdeal R) F.r s t).symm Kb with hKb'def
  have hKb'0 : Kb' ≠ 0 := fun h => hKb0
    ((map_eq_zero_iff _ (iterEquiv (R ⧸ maximalIdeal R) F.r s t).symm.injective).mp h)
  have hKb'h : Kb'.IsHomogeneous μ := isHomogeneous_iterEquiv_symm hKbw
  have hKb'I : Kb' ∈ (I₀.map (rename (R := R ⧸ maximalIdeal R) (Fin.castAdd s))).map
      (MvPolynomial.map (C : (R ⧸ maximalIdeal R) →+* MvPolynomial (Fin t) (R ⧸ maximalIdeal R))) := by
    have hle : I₀.map (rename (R := R ⧸ maximalIdeal R) (Fin.castAdd (s + t))) ≤
        Ideal.comap (iterEquiv (R ⧸ maximalIdeal R) F.r s t).symm
          ((I₀.map (rename (R := R ⧸ maximalIdeal R) (Fin.castAdd s))).map
            (MvPolynomial.map (C : (R ⧸ maximalIdeal R) →+*
              MvPolynomial (Fin t) (R ⧸ maximalIdeal R)))) := by
      rw [Ideal.map_le_iff_le_comap]
      intro q hq'
      rw [Ideal.mem_comap, Ideal.mem_comap, iterEquiv_symm_rename_castAdd]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hq')
    exact Ideal.mem_comap.mp (hle (hlowle hlow))
  obtain ⟨B, hB, hBE⟩ := exists_zPart_mem_eSet_iter I₀ hI₀h hKb'0 hKb'h hKb'I
  obtain ⟨d, hd, hdB⟩ := exists_mem_support_of_mem_support_iterEquiv_symm hB
  have h6 := h3 (expansion F) (isExpansion_expansion F) (zPart B) hBE
  refine hsupp d hd (Finsupp.equivFunOnFinite.symm (zPart B)) ?_ ?_
  · funext i
    rw [Finsupp.coe_equivFunOnFinite_symm]
    show d (Fin.castAdd (s + t) i) = B (Fin.castAdd s i)
    rw [← hdB, iterIndex_inl_castAdd]
  · rw [psCoeff, coeff_expansion] at h6
    exact h6

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- Lemma 18, first assertion, in `R̂ = S{z}` (pp. 249–250: "First we want to show that
`ν_P(c_A) ≥ ν̄ − |A|` for all `A`, or equivalently, `ν_P(f) ≥ ν̄`"; "Let `μ` be the minimum of the
integers `|A| + ν_P(c_A)`. We want to show that `μ ≥ ν̄`. Suppose `μ < ν̄`"; "Therefore `λ(Φ₀) ∈
(φ₁, …, φ_i) gr_M(R)` because of the assumption (i)"; …).  All of (i)–(v) of the paper are used;
(vi) is not needed. -/
private theorem nuI_le_ordElem_of_isNormalizedBy [Hironaka.Cited.ExistsSurjectiveOfIsRegularLocalRingOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (F : RegularFrame R) (J : Ideal R) {i : ℕ}
    (f : Fin i → R) (h1 : ExtendsToStandardBase J f)
    (h2 : ∀ j, initialForm (maximalIdeal R) (f j) ∈ F.assocSubalgebra)
    (g : R) (hgJ : g ∈ J) (h3 : F.IsNormalizedBy f g)
    (P : Ideal R) [P.IsPrime] (h4 : F.idealZ ≤ P) (h5 : IsPermissibleCenter R J P) :
    nuI R J i.succPNat ≤ Ideal.ordElem P g := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  have hPtop : P ≠ ⊤ := Ideal.IsPrime.ne_top ‹_›
  obtain ⟨-, hJP, hPreg, hflat⟩ : P ≠ ⊤ ∧ J ≤ P ∧ IsRegularLocalRing (R ⧸ P) ∧
      IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)) := by
    rcases h5 with h | ⟨-, hJP, hPreg, hflat⟩
    · exact absurd h hPtop
    · exact ⟨hPtop, hJP, hPreg, hflat⟩
  by_cases hg0 : g = 0
  · subst hg0
    rw [(Ideal.ordElem_eq_top_iff_eq_zero hPtop).mpr rfl]
    exact le_top
  obtain ⟨s, t, w, hA⟩ := exists_isAdapted F P h4 hPreg
  -- "First we want to show that `ν_P(c_A) ≥ ν̄ - |A|` for all `A`, or equivalently, `ν_P(f) ≥ ν̄`"
  rw [le_ordElem_iff_forall_expCoeff F (xIdeal w) P hA.eq_sup g]
  by_contra hcontra
  simp only [not_forall, not_le] at hcontra
  -- "Let `μ` be the minimum of the integers `|A| + ν_P(c_A)`.  We want to show that `μ ≥ ν̄`.
  -- Suppose `μ < ν̄`."
  obtain ⟨μ, A₀, hlt, hA₀, hmin⟩ := exists_isLeast_of_exists_lt
    (fun A : Fin F.r →₀ ℕ => (A.degree : ℕ∞) +
      Ideal.ordElem P (algebraMap F.S R (F.expCoeff g A))) hcontra
  obtain ⟨-, Kb, -, -, hKb0, hKbJ, -, hKbw, hsupp, -⟩ :=
    exists_core_form hA hPreg J hJP hflat hgJ A₀ hA₀ hmin
  set Θ := adaptedEquiv hA with hΘ
  have hΘh : ∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R)),
      p ∈ homogeneousSubmodule (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) d ↔
        Θ p ∈ AssocGraded.homogeneous (maximalIdeal R) d := mem_homogeneous_adaptedEquiv_iff hA
  -- the initial form system of `J` along `P`
  have hPM : P ≤ maximalIdeal R := le_maximalIdeal hPtop
  have : IsRegularLocalRing (R ⧸ maximalIdeal R) := by
    let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
    infer_instance
  have h21 : HasInitialFormSystem J P (maximalIdeal R) ↔
      IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)) :=
    (isNormallyFlatAlongIdeal_tfae_of_eq_maximalIdeal J P (maximalIdeal R) hJP rfl).out 2 1
  obtain ⟨m', f', hf'J, hf'ord, hf'span⟩ := h21.mpr hflat
  -- `ψ_l = Θ⁻¹ (in f'_l)`
  set ψ : Fin m' → MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) :=
    fun l => Θ.symm (initialForm (maximalIdeal R) (f' l)) with hψdef
  set δ : Fin m' → ℕ := fun l => (Ideal.ordElem (maximalIdeal R) (f' l)).toNat with hδdef
  have hψw : ∀ l, IsWeightedHomogeneous (zxWeight F.r s t) (ψ l) (δ l) := by
    intro l
    by_cases htop : Ideal.ordElem (maximalIdeal R) (f' l) = ⊤
    · have : initialForm (maximalIdeal R) (f' l) = 0 := by rw [initialForm, dite_eq_left htop]
      simp only [hψdef, this, map_zero]
      exact isWeightedHomogeneous_zero _ _ _
    · obtain ⟨d, hd⟩ := ENat.ne_top_iff_exists.mp htop
      have hdδ : δ l = d := by simp only [hδdef, ← hd]; rfl
      have hfM : f' l ∈ maximalIdeal R ^ d := Ideal.mem_pow_of_ordElem hd.symm
      have hfP : f' l ∈ P ^ d := Ideal.mem_pow_of_ordElem ((hf'ord l).symm.trans hd.symm)
      obtain ⟨Ab, hAbh, hAbe⟩ := exists_rename_form_of_mem_pow hA hfP hfM
      have : ψ l = rename (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega)) Ab := by
        simp only [hψdef]
        rw [initialForm_eq_mk _ hd.symm, ← hAbe, AlgEquiv.symm_apply_apply]
      rw [this, hdδ]
      exact isWeightedHomogeneous_rename_castLE hAbh
  -- `Θ⁻¹ gr_M(J, R) = (ψ_l)`
  have hKbspan : Kb ∈ Ideal.span (Set.range ψ) := by
    have key : ∀ v ∈ Ideal.span (Set.range fun l => initialForm (maximalIdeal R) (f' l)),
        Θ.symm v ∈ Ideal.span (Set.range ψ) := by
      intro v hv
      induction hv using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨l, rfl⟩ := hv
        exact Ideal.subset_span ⟨l, rfl⟩
      | zero => rw [map_zero]; exact zero_mem _
      | add v w _ _ hv hw => rw [map_add]; exact add_mem hv hw
      | smul c v _ hv => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hv
    have := key (Θ Kb) (by rw [hf'span]; exact hKbJ)
    rwa [AlgEquiv.symm_apply_apply] at this
  -- the ideal generated by the polynomial counterparts of `φ_1, …, φ_i`
  set lowI := Ideal.span
    (Set.range fun j : Fin i => Θ.symm (initialForm (maximalIdeal R) (f j))) with hlowI
  have hlow : Kb ∈ lowI := by
    have hK := mem_span_low_of_isWeightedHomogeneous (zxWeight F.r s t) ψ δ hψw
      (nuI R J i.succPNat) hKbspan hlt hKbw
    refine (Ideal.span_le.mpr ?_) hK
    rintro _ ⟨l, hl, rfl⟩
    by_cases htop : Ideal.ordElem (maximalIdeal R) (f' l) = ⊤
    · have : initialForm (maximalIdeal R) (f' l) = 0 := by rw [initialForm, dite_eq_left htop]
      simp only [hψdef, this, map_zero]
      exact zero_mem _
    · obtain ⟨d, hd⟩ := ENat.ne_top_iff_exists.mp htop
      have hdδ : δ l = d := by simp only [hδdef, ← hd]; rfl
      have hinh : initialForm (maximalIdeal R) (f' l) ∈
          AssocGraded.homogeneous (maximalIdeal R) (δ l) := by
        rw [hdδ, initialForm_eq_mk _ hd.symm]
        exact AssocGraded.mk_mem_homogeneous _ _
      have hψh : ψ l ∈ homogeneousSubmodule (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) (δ l) :=
        (hΘh _ _).mpr (by simp only [hψdef, AlgEquiv.apply_symm_apply]; exact hinh)
      have hΘψ : Θ (ψ l) ∈ grIdeal (maximalIdeal R) J := by
        simp only [hψdef, AlgEquiv.apply_symm_apply]
        exact Ideal.subset_span ⟨f' l, hf'J l, rfl⟩
      have := homogeneousComponent_mem_span_of_lt Θ hΘh J f h1 (δ l) hl (ψ l) hΘψ
      rwa [homogeneousComponent_of_mem hψh, ite_eq_left rfl] at this
  exact false_of_mem_lowIdeal F hA f h2 g h3 hKb0 hKbw hsupp hlow


private theorem doubleOrd_self_of_ne_zero {Φ : AssocGraded (maximalIdeal R)} (hΦ : Φ ≠ 0) :
    doubleOrd (maximalIdeal R) (maximalIdeal R) Φ = 0 := by
  have hbot : (maximalIdeal R).map (algebraMap R (AssocGraded (maximalIdeal R))) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker]
    intro a ha
    rw [RingHom.mem_ker]
    show AssocGraded.mk (maximalIdeal R) 0 a (by simp) = 0
    rw [AssocGraded.mk_eq_zero_iff]
    simpa using ha
  unfold doubleOrd
  rw [hbot]
  refine nonpos_iff_eq_zero.mp (Nat.cast_zero (R := ℕ∞) ▸ Ideal.ordElem_le_of_notMem ?_)
  simpa using hΦ

private theorem equiv_symm_mem_span_range {A B ι : Type*} [CommRing A] [CommRing B] (Θ : A ≃+* B)
    (y : ι → B) {v : B} (hv : v ∈ Ideal.span (Set.range y)) :
    Θ.symm v ∈ Ideal.span (Set.range fun l => Θ.symm (y l)) := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨l, rfl⟩ := hv
    exact Ideal.subset_span ⟨l, rfl⟩
  | zero => rw [map_zero]; exact zero_mem _
  | add v w _ _ hv hw => rw [map_add]; exact add_mem hv hw
  | smul c v _ hv => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hv

/-- The second half of the proof of Lemma 18 (p. 250–251: "Now the assumptions (i)–(vi) and the
above argument remain valid for `M = P`.  In this case, `Φ = Φ₀ = λ(Φ₀)`, and it is the initial form
of `f` in `gr_M(R)`.  The argument in this case shows that the initial form of `f` in `gr_M(R)`
should not belong to `(φ₁, …, φ_i) gr_M(R)`"): the initial form in `gr_M(R)` of a non-zero element
normalized by `(f_1, …, f_i)` does not belong to `(φ_1, …, φ_i) gr_M(R)`. -/
private theorem initialForm_notMem_span_of_isNormalizedBy [Hironaka.Cited.ExistsSurjectiveOfIsRegularLocalRingOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (F : RegularFrame R) (J : Ideal R) {i : ℕ}
    (f : Fin i → R) (h2 : ∀ j, initialForm (maximalIdeal R) (f j) ∈ F.assocSubalgebra)
    (g : R) (hgJ : g ∈ J) (h3 : F.IsNormalizedBy f g) (hJM : J ≤ maximalIdeal R) (hg0 : g ≠ 0) :
    initialForm (maximalIdeal R) g ∉
      Ideal.span (Set.range fun j : Fin i => initialForm (maximalIdeal R) (f j)) := by
  classical
  intro hmem
  have hMtop : maximalIdeal R ≠ ⊤ := (maximalIdeal.isMaximal R).ne_top
  have : IsRegularLocalRing (R ⧸ maximalIdeal R) := by
    let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
    infer_instance
  have hzM : F.idealZ ≤ maximalIdeal R := by
    rw [F.maximalIdeal_eq_idealZ_sup_map]
    exact le_sup_left
  obtain ⟨s, t, w, hA⟩ := exists_isAdapted F (maximalIdeal R) hzM inferInstance
  have hMbar : ((maximalIdeal R).map (Ideal.Quotient.mk J)).IsMaximal :=
    isMaximal_map_quotientMk_of_le hJM
  have hflat : IsNormallyFlatAlongIdeal ((maximalIdeal R).map (Ideal.Quotient.mk J)) :=
    fun p => by
      let _ : Field ((R ⧸ J) ⧸ (maximalIdeal R).map (Ideal.Quotient.mk J)) :=
        Ideal.Quotient.field _
      exact Module.Free.of_divisionRing _ _
  -- "Let `μ` be the minimum of the integers `|A| + ν_M(c_A)`" (here `P = M`)
  obtain ⟨μ, A₀, -, hA₀, hmin⟩ := exists_isLeast_of_exists_lt
    (fun A : Fin F.r →₀ ℕ => (A.degree : ℕ∞) +
      Ideal.ordElem (maximalIdeal R) (algebraMap F.S R (F.expCoeff g A)))
    (exists_expCoeff_ordElem_lt_top F (xIdeal w) (maximalIdeal R) hA.eq_sup hMtop hg0)
  obtain ⟨n, Kb, hμ, hn, hKb0, -, -, hKbw, hsupp, h, hgh, hMn, hΘKb⟩ :=
    exists_core_form hA inferInstance J hJM hflat hgJ A₀ hA₀ hmin
  have hne : initialForm (maximalIdeal R) g ≠ 0 := by
    rw [initialForm_eq_mk _ hμ]
    intro h0
    have := Ideal.le_ordElem ((AssocGraded.mk_eq_zero_iff _ _).mp h0)
    rw [hμ] at this
    exact absurd (Nat.cast_le.mp this) (by omega)
  have hn0 : n = 0 := by
    have := doubleOrd_self_of_ne_zero hne
    rw [hn] at this
    exact_mod_cast this
  subst hn0
  have hΘ : adaptedEquiv hA Kb = initialForm (maximalIdeal R) g := by
    rw [hΘKb, initialForm_eq_mk _ hμ]
    exact (assocGraded_mk_eq_of_sub_mem _ (Ideal.mem_pow_of_ordElem hμ) hMn (by
      simpa using hgh)).symm
  refine false_of_mem_lowIdeal F hA f h2 g h3 hKb0 hKbw hsupp ?_
  have := equiv_symm_mem_span_range (adaptedEquiv hA).toRingEquiv
    (fun j : Fin i => initialForm (maximalIdeal R) (f j)) hmem
  rw [← hΘ] at this
  simpa using this

end RegularFrame


end Lemma18Proof

section MapsRSOPId

/-- The identity of a regular local ring transforms a regular system of parameters into one. -/
theorem RingHom.mapsRSOP_id (S : Type u) [CommRing S] [IsRegularLocalRing S] :
    RingHom.MapsRSOP (RingHom.id S) := by
  classical
  obtain ⟨-, s, hs⟩ := (isRegularLocalRing_iff_exists_rsop S).mp inferInstance
  refine ⟨s, hs, ?_, Set.injOn_id _⟩
  simpa using hs

end MapsRSOPId

section Lemma18Main

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- Lemma 18, pp. 248–249: "Let `R` be a regular local ring, `(S; z₁, …, z_r)` a regular frame
of `R`, and `J` an ideal in `R`. Let `(f₁, …, f_i)` be a system of elements of `J` such that
(i) `(f₁, …, f_i)` can be extended to a standard base of `J`, and (ii) the initial forms of
`f_j` (`1 ≤ j ≤ i`) belong to the associated subalgebra of `(S; z₁, …, z_r)`. Let `f` be an
element of `J` such that (iii) `f` is normalized by `(f₁, …, f_i)` with respect to
`(S; z₁, …, z_r)`. Let `P` be a prime ideal in `R` such that (iv) `P ⊇ (z₁, …, z_r)R`, (v) `P`
is a permissible center for `J`, and (vi) `ν_P(f_j) = ν^{(j)}(J)` for `1 ≤ j ≤ i`. Then we
have `ν_P(f) ≥ ν^{(i+1)}(J)`. Moreover, `ν_M(f) = ν^{(i+1)}(J)` for the maximal ideal `M` of
`R` if and only if `(f₁, …, f_i, f)` can be extended to a standard base of `J`."

(Formalization note: the paper's element `f` is called `g` here; `(f₁, …, f_i, f)` is
`Fin.snoc f g`.)

Deviation from the paper (statement corrected): the "Moreover … if and only if"
is false as printed when `f = 0` and `ν^{(i+1)}(J) = ∞`, that is, when `(f₁, …, f_i)` already is
a complete standard base of `J`: then `ν_M(0) = ∞ = ν^{(i+1)}(J)`, whereas no standard base has
`0` as a member (its initial form `0` lies in the ideal generated by those of its predecessors, so
condition (iii) of Lemma 1 fails).  Example: `J = (0)`, `i = 0`, `f = 0`, `P = M`.  The paper's last
sentence ("The argument in this case shows that the initial form of `f` in `gr_M(R)` should not
belong to `(φ₁, …, φ_i) gr_M(R)`.  Therefore `ν^{(i+1)}(J) = ν_M(f)` implies that
`(f₁, …, f_i, f)` can be extended to a standard base of `J`.", p. 251) is void for `f = 0`.  Here
the equivalence is asserted for `g ≠ 0`; the direction "extends ⟹ `ν_M(f) = ν^{(i+1)}(J)`" holds for
every `g`.

Printed route.  The paper first passes to the completion `R̂ = S{z₁, …,
z_r}` of `R` for `(z)R` and transfers the hypotheses (i)–(vi) to it ("The local homomorphism `R →
R̂` transforms a regular system of parameters of `R` into such a system of parameters of `R̂`, so
that the assumptions (i)–(vi) remain valid for `R̂`, `(S; z₁, …, z_r)`, `JR̂`, `(f₁, …, f_i, f)` and
`PR̂`, and that the conclusion is replaced by an equivalent one").  This is done here with the base
change of §8 for `a = id : S → S` (`RegularFrame.baseChangeHom`, `R̂ = S⟦z⟧`,
`RegularFrame.baseChange`): (i) is `extendsToStandardBase_baseChangeHom`, (ii) is
`grMapMax_frameAlgHom`, (iii) is `isNormalizedBy_baseChangeHom`, (iv) is `baseChangeHom_z'`, (v) is
`isPermissibleCenter_map_iff`, (vi) and the orders are `ordElem_map_ideal_of_mapsRSOP`,
`nuI_map_eq_of_mapsRSOP`; the first assertion for `R̂` is the first for `R`; for the "if and only
if" the initial form of `f` in `gr_M̂(R̂)` is not in `(φ₁, …, φ_i) gr_M̂(R̂)` (proved in `R̂`),
hence its preimage is not in `(φ₁, …, φ_i) gr_M(R)` (functoriality of `ᾱ : gr_M(R) → gr_M̂(R̂)`).

The core argument is then carried out in `R̂`, as printed (pp. 249–250).  In
`R̂ = S⟦z⟧` the coefficient `c_A` of `f = Σ c_A z^A` (p. 249: "We can write in a unique way
`f = Σ_{A ∈ Z₀ʳ} c_A z^A`, with `c_A ∈ S`") is the expansion coefficient `F.expCoeff f A` of the
frame (`RegularFrame.expCoeff_mvPowerSeries`), and the core is stated for these coefficients.  The
steps, with the declarations carrying them:
* "First we want to show that `ν_P(c_A) ≥ ν̄ − |A|` for all `A ∈ Z₀ʳ`, or equivalently,
  `ν_P(f) ≥ ν̄`": `le_ordElem_iff_forall_expCoeff` (the equivalence, which the paper does not
  argue, comes from `mem_pow_iff_expCoeff_mem`: `p ∈ P^m` iff `c_B(p) ∈ (P ∩ S)^(m - |B|)` for all
  `B`).
* "Let us choose a system of elements `(y₁, …, y_t)` of `R` such that their residue classes modulo
  `P` form a regular system of parameters of `R/P`" and "Let us choose a minimal base
  `(z₁, …, z_r, x₁, …, x_s)` of `P`, which is an extension of the system `(z₁, …, z_r)`.  Then
  `(z₁, …, z_r, x₁, …, x_s, y₁, …, y_t)` is a regular system of parameters of `R`":
  `exists_isAdapted` and `span_map_eq_and_card_eq_spanFinrank` (the `x_j`, `y_j` are taken in `S`,
  which the text allows: `R = S + (z)R` and `(z)R ⊆ P`).
* The isomorphisms `ψ`, `φ` and `λ = ψ ∘ φ⁻¹` are those of Lemma 10 of Ch. II in the paper's form
  (`lambdaPiece`, constructed in each double degree).  "Let `Φ₀` be the initial form of `f` in
  `gr_M̄(gr_P(R))`" (`doubleInitialFormPiece`) and "By virtue of Lemma 10 of § 3, Ch. II, the
  assumption (v) implies that `λ(Φ₀) ∈ gr_M(J, R)`" (`exists_mul_mem_grIdeal_lambdaPiece`, inside
  `exists_core_form`; not the element-wise form of Lemma 10).
* "Let `μ` be the minimum of the integers `|A| + ν_P(c_A)` for `A ∈ Z₀ʳ`.  We want to show that
  `μ ≥ ν̄`." and "Suppose `μ < ν̄`": `exists_isLeast_of_exists_lt`; then `ν_P(f) = μ`
  (`ordElem_eq_of_isLeast`).
* "Then the initial form `Φ` of `f` in `gr_P(R)` can be written in the form `Φ = ΣΓ_A Ẑ^A` for
  `|A| + ν_P(c_A) = μ`", "Let `n` be the maximal integer such that `Φ ∈ M̄ⁿ gr_P(R)`, i.e.,
  `Γ_A ∈ M̄ⁿ gr_P(R)` for all `A` with `|A| + ν_P(c_A) = μ`", "Then we have
  `λ(Φ₀) = Σγ_A Z^A` for `|A| + ν_P(c_A) = μ`" and "Then we see that `γ_A` is doubly homogeneous of
  degree `μ − |A|` in `X₁, …, X_s` and of degree `n` in `Y₁, …, Y_t`": `exists_core_form` (the set
  `T` of the `A` with `|A| + ν_P(c_A) = μ`, the lifts `c'_A = Q_A(x, y)` of the `Γ_A` with `Q_A`
  bihomogeneous of bidegree `(μ − |A|, n)`, `g - h ∈ P^(μ+1)` for `h = Σ_{A ∈ T} c'_A z^A`, and
  `λ(Φ₀) = [h]` by `ofGrPiece_lambdaPiece_eq_mk`).
* "The assumption (v) implies that `gr_M(J, R)` is generated by forms in `Z₁, …, Z_r, X₁, …, X_s`.
  `λ(Φ₀)` is homogeneous of degree `μ` in these variables" and "Since `μ < ν̄ = ν^{(i+1)}(J)`,
  `λ(Φ₀) ∈ (φ₁, …, φ_i) gr_M(R)` because of the assumption (i)": below, in the proof of
  `nuI_le_ordElem_of_isNormalizedBy`.
* "Let `E^r` be the E-set of the ideal `(φ₁, …, φ_i)k[Z₁, …, Z_r]`", "`Λ^{r+s}(λ(Φ₀)) ∈ E^{r+s}`",
  "By Remark 1, `E^{r+s}` is also the E-set of `(φ₁, …, φ_i)k[Z₁, …, Z_r, X₁, …, X_s]` with respect
  to `(k; Z₁, …, Z_r, X₁, …, X_s)`; and, by Remark 2, `E^{r+s}` is bounded by `q(E^r)`", "It
  follows that the above `Ā ∈ E^r`.  However `|Ā| + ν_P(c_Ā) = μ` implies that `c_Ā ≠ 0`.  This is a
  contradiction to (iii).": `false_of_mem_lowIdeal`, with `gr_M(R) = k[Y][Z, X]` (`iterEquiv`) and
  `exists_zPart_mem_eSet_iter` (Remark 1: `eSet_map_of_injective` for `k → k[Y]`; Remark 2:
  `eSet_isBound_qInj_image`).
* "Now the assumptions (i)–(vi) and the above argument remain valid for `M = P`": the same
  declarations with `P = M` (`initialForm_notMem_span_of_isNormalizedBy`).

Deviation from the paper (gap filled): (a) "`ν_P(c_A) ≥ ν̄ − |A|` for all `A`, or equivalently
`ν_P(f) ≥ ν̄`" is asserted without proof, as is the form `Φ = ΣΓ_A Ẑ^A` of the initial form
(here `mem_pow_iff_expCoeff_mem`, `ordElem_eq_of_isLeast`; the tail of the sum lies in `(z)^m`);
(b) "`Γ_A ∈ M̄ⁿ gr_P(R)` for all `A` with `|A| + ν_P(c_A) = μ`" and "we see that `γ_A` is doubly
homogeneous": the lifts `c'_A` and the forms `Q_A` of `exists_core_form` (`λ` acts on classes by
`ofGrPiece_lambdaPiece_eq_mk`); (c) "The assumption (v) implies that `gr_M(J, R)` is generated by
forms in `Z_1, …, Z_r, X_1, …, X_s`" is justified by Corollary 1 of Theorem 2 (Ch. II §2,
`HasInitialFormSystem`); (d) the independence of the bidegree components (Ch. II, Lemma 7,
`mem_pow_succ_of_mem_sup`) is used for the non-vanishing of `λ(Φ₀)`; (e) Remark 2 is stated for
`1 ≤ t < r`: the cases `r = 0` and `s = 0` of its use are treated separately; (f) "Therefore
`ν^{(i+1)}(J) = ν_M(f)` implies that `(f₁, …, f_i, f)` can be extended to a standard base of `J`"
(p. 251) has no argument in the paper: here the greedy selection of
`Hironaka/Compat/StandardBaseExtension.lean`.  The hypothesis (vi) is not used by the proof. -/
@[blueprint "lem:III.18"
  (statement := /-- Let $R$ be a regular local ring, $(S;z_1,\dots,z_r)$ a regular frame of
    $R$ (\cref{def:III.9}), and $J$ an ideal in $R$. Let $(f_1,\dots,f_i)$ be a system of
    elements of $J$ such that
    \begin{enumerate}
      \item[(i)] $(f_1,\dots,f_i)$ can be extended to a standard base of $J$
        (\cref{def:III.7-extends-standard-base}), and
      \item[(ii)] the initial forms of $f_j$ $(1\le j\le i)$ belong to the associated
        subalgebra of $(S;z_1,\dots,z_r)$ (\cref{def:III.9-associated-subalgebra}).
    \end{enumerate}
    Let $f$ be an element of $J$ such that
    \begin{enumerate}
      \item[(iii)] $f$ is normalized by $(f_1,\dots,f_i)$ with respect to $(S;z_1,\dots,z_r)$
        (\cref{def:III.9-normalized-by}).
    \end{enumerate}
    Let $P$ be a prime ideal in $R$ such that
    \begin{enumerate}
      \item[(iv)] $P\supseteq(z_1,\dots,z_r)R$,
      \item[(v)] $P$ is a permissible center for $J$ (\cref{def:III.8}), and
      \item[(vi)] $\nu_P(f_j)=\nu^{(j)}(J)$ for $1\le j\le i$ (\cref{def:III.1}).
    \end{enumerate}
    Then we have $\nu_P(f)\ge\nu^{(i+1)}(J)$. Moreover, $\nu_M(f)=\nu^{(i+1)}(J)$ for the
    maximal ideal $M$ of $R$ if and only if $(f_1,\dots,f_i,f)$ can be extended to a standard
    base of $J$. (Lemma 18, pp.~248--249.)

    \textbf{Statement corrected (false as printed when $f=0$ and $\nu^{(i+1)}(J)=\infty$).} The ``if and only if'' of the last sentence is asserted here
    for $f\ne0$. For $f=0$ and $\nu^{(i+1)}(J)=\infty$ (i.e.\ $(f_1,\dots,f_i)$ is a complete
    standard base of $J$; e.g.\ $J=(0)$, $i=0$, $P=M$) one has $\nu_M(f)=\infty=\nu^{(i+1)}(J)$,
    but no standard base has $0$ as a member. The implication ``extended to a standard base
    $\Rightarrow\nu_M(f)=\nu^{(i+1)}(J)$'' holds for every $f$. -/)
  (proof := /-- Let $\widehat R$ be the completion of $R$ with respect to the topology defined
    by the powers of the ideal $(z_1,\dots,z_r)R$. Then we have
    $\widehat R=S\{z_1,\dots,z_r\}$ (\cref{lem:III.9-frame-completion}). The local
    homomorphism $R\to\widehat R$ transforms a regular system of parameters of $R$ into such a
    system of parameters of $\widehat R$ (\cref{def:III.rsop-map}), so that the assumptions
    (i)--(vi) remain valid for $\widehat R$, $(S;z_1,\dots,z_r)$, $J\widehat R$,
    $(f_1,\dots,f_i,f)$ and $P\widehat R$, and that the conclusion is replaced by an equivalent
    one. Therefore we may assume that $R=S\{z_1,\dots,z_r\}$. We can write in a unique way
    $f=\sum_{A\in\mathbb Z^r_0}c_Az^A$ with $c_A\in S$.

    Let $\bar\nu=\nu^{(i+1)}(J)$. First we want to show that $\nu_P(c_A)\ge\bar\nu-|A|$ for all
    $A\in\mathbb Z^r_0$, or equivalently, $\nu_P(f)\ge\bar\nu$. Let us choose a system of
    elements $(y_1,\dots,y_t)$ of $R$ such that their residue classes modulo $P$ form a regular
    system of parameters of $R/P$. By means of this system we get an isomorphism of simply
    graded $k$-algebras
    $\chi\colon\operatorname{gr}^0_{\bar M}(\operatorname{gr}_P(R))\otimes_k
    \operatorname{gr}_{\bar M}(\bar R)\to\operatorname{gr}_M(R)$, where $M$ is the maximal ideal
    of $R$, $\bar M=M/P$, $\bar R=R/P$ and $k=R/M=\bar R/\bar M$. (See the paragraph preceding
    Lemma 8 of \S2, Ch.~II.) We also have the canonical isomorphism of doubly graded
    $k$-algebras $\psi$ from the same source onto $\operatorname{gr}_{\bar M}(\operatorname{gr}_P(R))$.
    (See the paragraph preceding Lemma 2 of \S1, Ch.~II.) Thus we get an isomorphism of simply
    graded $k$-algebras $\lambda=\chi\circ\psi^{-1}\colon\operatorname{gr}_{\bar M}
    (\operatorname{gr}_P(R))\to\operatorname{gr}_M(R)$.

    Let $\Phi_0$ be the initial form of $f$ in $\operatorname{gr}_{\bar M}(\operatorname{gr}_P(R))$.
    (See the paragraph preceding Lemma 10 of \S3, Ch.~II.) By virtue of Lemma 10 of \S3, Ch.~II
    (\cref{lem:II.3-10}), the assumption (v) implies that
    $\lambda(\Phi_0)\in\operatorname{gr}_M(J,R)$. Let $\mu$ be the minimum of the integers
    $|A|+\nu_P(c_A)$ for $A\in\mathbb Z^r_0$. We want to show that $\mu\ge\bar\nu$. Suppose
    $\mu<\bar\nu$. Then the initial form $\Phi$ of $f$ in $\operatorname{gr}_P(R)$ can be written
    in the form $\Phi=\sum\Gamma_A\hat Z^A$ for $|A|+\nu_P(c_A)=\mu$, where $\Gamma_A$ denotes
    the initial form of $c_A$ in $\operatorname{gr}_P(R)$, and $(\hat Z)=(\hat Z_1,\dots,\hat Z_r)$
    is the system of initial forms of $z_1,\dots,z_r$ in $\operatorname{gr}_P(R)$. Let $n$ be the
    maximal integer such that $\Phi\in\bar M^n\operatorname{gr}_P(R)$, i.e., $\Gamma_A\in\bar M^n
    \operatorname{gr}_P(R)$ for all $A$ with $|A|+\nu_P(c_A)=\mu$. Let $\gamma_A$ be the
    $\lambda$-image of the class of $\Gamma_A$ in $\operatorname{gr}^n_{\bar M}(\operatorname{gr}_P(R))$,
    and $(Z_1,\dots,Z_r)$ the system of initial forms of $z_1,\dots,z_r$ in
    $\operatorname{gr}_M(R)$. Then we have $\lambda(\Phi_0)=\sum\gamma_AZ^A$ for
    $|A|+\nu_P(c_A)=\mu$.

    Let us choose a minimal base $(z_1,\dots,z_r,x_1,\dots,x_s)$ of $P$, which is an extension
    of the system $(z_1,\dots,z_r)$. Then $(z_1,\dots,z_r,x_1,\dots,x_s,y_1,\dots,y_t)$ is a
    regular system of parameters of $R$. Let us identify $\operatorname{gr}_M(R)$ with the
    polynomial ring $k[Z_1,\dots,Z_r,X_1,\dots,X_s,Y_1,\dots,Y_t]$ of $r+s+t(=\dim R)$
    indeterminates, where $Z_j$ (resp.\ $X_j$, resp.\ $Y_j$) is the initial form of $z_j$
    (resp.\ $x_j$, resp.\ $y_j$) in $\operatorname{gr}_M(R)$. Then we see that $\gamma_A$ is doubly
    homogeneous of degree $\mu-|A|$ in $X_1,\dots,X_s$ and of degree $n$ in $Y_1,\dots,Y_t$.
    The assumption (v) implies that $\operatorname{gr}_M(J,R)$ is generated by forms in
    $Z_1,\dots,Z_r,X_1,\dots,X_s$. $\lambda(\Phi_0)$ is homogeneous of degree $\mu$ in these
    variables. Therefore $\lambda(\Phi_0)\in\operatorname{gr}^\mu_M(J,R)\operatorname{gr}^n_M(R)$.
    Since $\mu<\bar\nu=\nu^{(i+1)}(J)$, $\lambda(\Phi_0)\in(\varphi_1,\dots,\varphi_i)
    \operatorname{gr}_M(R)$ because of the assumption (i), where $\varphi_j$ is the initial form
    of $f_j$ in $\operatorname{gr}_M(R)$ for $1\le j\le i$. Let $E^r$ be the $E$-set of the ideal
    $(\varphi_1,\dots,\varphi_i)k[Z_1,\dots,Z_r]$ with respect to $(k;Z_1,\dots,Z_r)$. Let
    $E^{r+s}$ be the $E$-set of $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$ with respect to
    $(k[Y];Z_1,\dots,Z_r,X_1,\dots,X_s)$. Let $\Lambda^{r+s}$ be the $E$-function of
    $\operatorname{gr}_M(R)$ with respect to $(k[Y];Z_1,\dots,Z_r,X_1,\dots,X_s)$. Then
    $\Lambda^{r+s}(\lambda(\Phi_0))\in E^{r+s}$. It is clear from the expression
    $\lambda(\Phi_0)=\sum\gamma_AZ^A$ for $|A|+\nu_P(c_A)=\mu$ that, if $q$ is the canonical
    injection $\mathbb Z^r_0\to\mathbb Z^{r+s}_0=\mathbb Z^r_0\times\mathbb Z^s_0$, then
    $\Lambda^{r+s}(\lambda(\Phi_0))=q(\bar A)+B$ with some $\bar A$ with
    $|\bar A|+\nu_P(c_{\bar A})=\mu$ and $B\in(0)\times\mathbb Z^s_0$. By Remark 1
    (\cref{rem:III.7-1}), $E^{r+s}$ is also the $E$-set of
    $(\varphi_1,\dots,\varphi_i)k[Z_1,\dots,Z_r,X_1,\dots,X_s]$ with respect to
    $(k;Z_1,\dots,Z_r,X_1,\dots,X_s)$; and, by Remark 2 (\cref{rem:III.7-2}), $E^{r+s}$ is
    bounded by $q(E^r)$. It follows that the above $\bar A\in E^r$. However
    $|\bar A|+\nu_P(c_{\bar A})=\mu$ implies that $c_{\bar A}\ne0$. This is a contradiction to
    (iii). Thus $\nu_P(f)\ge\nu^{(i+1)}(J)$.

    Now the assumptions (i)--(vi) and the above argument remain valid for $M=P$. In this case,
    $\Phi=\Phi_0=\lambda(\Phi_0)$, and it is the initial form of $f$ in $\operatorname{gr}_M(R)$.
    The argument in this case shows that the initial form of $f$ in $\operatorname{gr}_M(R)$
    should not belong to $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$. Therefore
    $\nu^{(i+1)}(J)=\nu_M(f)$ implies that $(f_1,\dots,f_i,f)$ can be extended to a standard base
    of $J$. \qed

    \textbf{Deviation from the paper (statement corrected).} The last sentence of the proof
    (``Therefore $\nu^{(i+1)}(J)=\nu_M(f)$ implies \dots'') needs $f\ne0$: the initial form of $f=0$
    lies in $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$, so the argument is void; see the
    statement above.

    \textbf{Formalization: the printed route.} The Lean proof passes to
    $\widehat R=S\{z_1,\dots,z_r\}$ as the paper does: $R\to\widehat R$ is the base change of
    the frame for the identity of $S$, it transforms a regular system of parameters into one, and
    the assumptions (i)--(vi) are transferred (the standard base, the initial forms in $k[Z]$, the
    normalization, $P\supseteq(z)R$, the permissibility of the center, the orders $\nu_P$ and
    $\nu^{(j)}$); the conclusion is replaced by an equivalent one (the first assertion is the same
    for $R$ and $\widehat R$; the initial form of $f$ is not in $(\varphi_1,\dots,\varphi_i)
    \operatorname{gr}_M(R)$ because its image in $\operatorname{gr}_{\widehat M}(\widehat R)$ is not
    in the extended ideal). In $\widehat R$ the argument is the printed one. The coefficients
    $c_A$ are the coefficients of the power series $f$, and $\mu$ is the minimum of the integers
    $|A|+\nu_P(c_A)$ over all $A$ (it equals $\nu_P(f)$); $\Phi$ is $\sum\Gamma_A\hat Z^A$
    over the finite set of the $A$ with $|A|+\nu_P(c_A)=\mu$. The isomorphism $\lambda$ is
    the one of Lemma 10 of Ch.~II in the paper's form (\cref{lem:II.3-10}), constructed in each
    double degree, not the element-wise form: $\lambda(\Phi_0)$ lies in $\operatorname{gr}_M(J,R)$,
    and it is the class $\sum\gamma_AZ^A$ of $h=\sum c'_Az^A$, where $c'_A\in(y)^nP^{\mu-|A|}$ is
    a representative of $\Gamma_A$ (this is how $\lambda$ acts on classes). The system
    $(x_1,\dots,x_s,y_1,\dots,y_t)$ is chosen in $S$, which the text allows (``Let us choose a
    system of elements $(y_1,\dots,y_t)$ of $R$ such that \dots''): a minimal base of $P\cap S$
    extended to a minimal base of the maximal ideal of $S$. The polynomial ring $k[Z,X,Y]$ is
    $\operatorname{gr}_M(R)$ through the regular system of parameters $(z,x,y)$ of $R$. The
    $E$-function $\Lambda^{r+s}$ is taken over $k[Y]$ in the variables $Z,X$
    ($\operatorname{gr}_M(R)=k[Y][Z,X]$), and Remarks~1 and 2 are applied as printed: Remark~1
    with $k\to k[Y]$ gives $E^{r+s}=E_{r+s}((\varphi)k[Z,X])$, and Remark~2 that this is bounded
    by $q(E^r)$.

    \textbf{Deviation from the paper (gap filled).} (a) ``$\nu_P(c_A)\ge\bar\nu-|A|$ for all $A$,
    or equivalently $\nu_P(f)\ge\bar\nu$'': an element $p$ lies in $P^m$ iff its coefficients
    satisfy $c_B(p)\in(P\cap S)^{m-|B|}$ for all $B$ (the tail of the sum, the terms of degree
    $\ge m$, lies in $(z)^m$), which gives the equivalence, $\nu_P(f)=\mu$, and the form
    $\Phi=\sum\Gamma_A\hat Z^A$ of the initial form. (b) ``$\Gamma_A\in\bar M^n\operatorname{gr}_P(R)$
    for all $A$ with $|A|+\nu_P(c_A)=\mu$'': if $h_1\in(y)^nP^\mu$ has $f-h_1\in P^{\mu+1}$, the
    coefficients $c'_A=c_A(h_1)$ lie in $(P\cap S)^{\mu-|A|}(y)^n$ and $c_A-c'_A\in(P\cap S)^{\mu+1-|A|}$.
    (c) ``Then we see that $\gamma_A$ is doubly homogeneous of degree $\mu-|A|$ in $X$ and $n$ in
    $Y$'': $c'_A=Q_A(x,y)$ for a form $Q_A$ of bidegree $(\mu-|A|,n)$. (d) ``The assumption (v)
    implies that $\operatorname{gr}_M(J,R)$ is generated by forms in $Z_1,\dots,Z_r,X_1,\dots,X_s$'':
    by Corollary 1 of Theorem 2, Ch.~II~\S2 (a system $(f'_l)$ of $J$ with
    $\nu_M(f'_l)=\nu_P(f'_l)$ and initial forms generating $\operatorname{gr}_M(J,R)$), the
    initial form of an element of $P^d$ of $M$-order $d$ being a form in $Z,X$ only. (e) The
    independence of the bidegree components (Ch.~II~\S2, Lemma~7) is used for $\lambda(\Phi_0)\ne0$.
    (f) Remark~2 is stated for $1\le t<r$; the cases $r=0$ and $s=0$ are treated separately.
    (g) ``Therefore $\nu^{(i+1)}(J)=\nu_M(f)$ implies that $(f_1,\dots,f_i,f)$ can be extended to a
    standard base of $J$'' is proved by the greedy selection of a standard base from the family
    $(f_1,\dots,f_i,f,g_{i+1},\dots,g_m)$ (a standard base $(g_1,\dots,g_m)$ extending
    $(f_1,\dots,f_i)$ being given), which keeps the first $i+1$ members because their initial forms
    are successively independent. The hypothesis (vi) is not used in the proof. -/)
  (latexEnv := "lemma")]
theorem ordElem_ge_nuI_of_isNormalizedBy [Hironaka.Cited.ExistsSurjectiveOfIsRegularLocalRingOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (F : RegularFrame R) (J : Ideal R) {i : ℕ}
    (f : Fin i → R) (_hfJ : ∀ j, f j ∈ J)
    (h1 : ExtendsToStandardBase J f)
    (h2 : ∀ j, initialForm (maximalIdeal R) (f j) ∈ F.assocSubalgebra)
    (g : R) (hgJ : g ∈ J) (h3 : F.IsNormalizedBy f g)
    (P : Ideal R) [P.IsPrime] (h4 : F.idealZ ≤ P) (h5 : IsPermissibleCenter R J P)
    (_h6 : ∀ j : Fin i, Ideal.ordElem P (f j) = nuI R J (j : ℕ).succPNat) :
    nuI R J i.succPNat ≤ Ideal.ordElem P g ∧
      (g ≠ 0 → (Ideal.ordElem (maximalIdeal R) g = nuI R J i.succPNat ↔
        ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R))) := by
  classical
  have hPtop : P ≠ ⊤ := Ideal.IsPrime.ne_top ‹_›
  have hJP : J ≤ P := by
    rcases h5 with h | ⟨-, hJP, -, -⟩
    · exact absurd h hPtop
    · exact hJP
  have hPreg : IsRegularLocalRing (R ⧸ P) := by
    rcases h5 with h | ⟨-, -, hreg, -⟩
    · exact absurd h hPtop
    · exact hreg
  have hJM : J ≤ maximalIdeal R := hJP.trans (le_maximalIdeal hPtop)
  -- the completion `R̂ = S{z₁, …, z_r}` of `R` for `(z)R`: the base change for `a = id : S → S`
  set a : F.S →+* F.S := RingHom.id F.S with hadef
  have ha : RingHom.MapsRSOP a := RingHom.mapsRSOP_id F.S
  set α := F.baseChangeHom a with hαdef
  have hα : RingHom.MapsRSOP α := F.mapsRSOP_baseChangeHom a ha
  have hαinj : Function.Injective α := F.baseChangeHom_injective a ha
  obtain ⟨hPp, hPq⟩ := RingHom.MapsRSOP.isPrime_map_and_isRegularLocalRing_quotient hα
    (inferInstance : P.IsPrime) hPreg
  have := hPp
  -- the assumptions (i)–(vi) remain valid for `R̂`
  have hf : ∀ j, initialForm (maximalIdeal R) (f j) ∈ Set.range (frameAlgHom F.z) := fun j => by
    have h := h2 j
    unfold RegularFrame.assocSubalgebra Hironaka.assocSubalgebra at h
    rwa [Algebra.adjoin_range_eq_range_aeval] at h
  have h1' : ExtendsToStandardBase (J.map α) (fun j => α (f j)) :=
    F.extendsToStandardBase_baseChangeHom ha J f h1
  have h2' : ∀ j, initialForm (maximalIdeal (MvPowerSeries (Fin F.r) F.S)) (α (f j)) ∈
      (F.baseChange F.S).assocSubalgebra := fun j => by
    obtain ⟨q, hq⟩ := hf j
    rw [initialForm_map_of_mapsRSOP α hα, ← hq,
      grMapMax_frameAlgHom α hα F.z (F.baseChange F.S).z
        (fun l => (F.baseChangeHom_z' a l).symm) q]
    unfold RegularFrame.assocSubalgebra Hironaka.assocSubalgebra
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨_, rfl⟩
  have h3' := F.isNormalizedBy_baseChangeHom ha f hf g h3
  have h4' : (F.baseChange F.S).idealZ ≤ P.map α := by
    rw [RegularFrame.idealZ, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, ← F.baseChangeHom_z' a j]
    exact Ideal.mem_map_of_mem _ (h4 (Ideal.subset_span ⟨j, rfl⟩))
  have h5' : IsPermissibleCenter (MvPowerSeries (Fin F.r) F.S) (J.map α) (P.map α) :=
    (Hironaka.isPermissibleCenter_map_iff α hα J P hJP).2.2.2.mp h5
  have hgJ' : α g ∈ J.map α := Ideal.mem_map_of_mem _ hgJ
  have hνnu : ∀ j : ℕ+, nuI (MvPowerSeries (Fin F.r) F.S) (J.map α) j = nuI R J j :=
    fun j => (nuI_map_eq_of_mapsRSOP α hα J j).symm
  refine ⟨?_, fun hg0 => ⟨fun hord => ?_, fun hext => ?_⟩⟩
  · -- the first assertion, for `R̂`
    have := RegularFrame.nuI_le_ordElem_of_isNormalizedBy (F.baseChange F.S) (J.map α)
      (fun j => α (f j)) h1' h2' (α g) hgJ' h3' (P.map α) h4' h5'
    rwa [hνnu, ordElem_map_ideal_of_mapsRSOP α hα P] at this
  · -- the initial form of `g` is not in `(φ₁, …, φ_i) gr_M(R)`: it is not so in `gr_M̂(R̂)`
    have hJM' : J.map α ≤ maximalIdeal (MvPowerSeries (Fin F.r) F.S) := by
      rw [← hα.map_maximalIdeal]
      exact Ideal.map_mono hJM
    have hnot' := RegularFrame.initialForm_notMem_span_of_isNormalizedBy (F.baseChange F.S)
      (J.map α) (fun j => α (f j)) h2' (α g) hgJ' h3' hJM'
      ((map_ne_zero_iff _ hαinj).mpr hg0)
    have hnot : initialForm (maximalIdeal R) g ∉
        Ideal.span (Set.range fun j : Fin i => initialForm (maximalIdeal R) (f j)) := by
      intro hmem
      apply hnot'
      have hmap := Ideal.mem_map_of_mem (grMapMax α hα) hmem
      rw [Ideal.map_span, ← Set.range_comp] at hmap
      rw [initialForm_map_of_mapsRSOP α hα]
      refine (Ideal.span_mono ?_ : _ ≤ _) hmap
      rintro _ ⟨j, rfl⟩
      exact ⟨j, initialForm_map_of_mapsRSOP α hα (f j)⟩
    obtain ⟨m, gs, him, hgs, hgsf⟩ := h1
    have hnot'' : initialForm (maximalIdeal R) g ∉ Ideal.span
        (Set.range fun j : Fin i => initialForm (maximalIdeal R) (gs (Fin.castLE him j))) := by
      simpa only [hgsf] using hnot
    obtain ⟨m', gs', h, hbase, hpre, hlast⟩ :=
      exists_isStandardBase_snoc J gs hgs him g hgJ hord hnot''
    refine ⟨m', gs', h, hbase, fun j => ?_⟩
    refine Fin.lastCases ?_ (fun j' => ?_) j
    · rw [Fin.snoc_last]
      exact hlast
    · rw [Fin.snoc_castSucc, hpre j', hgsf j']
  · obtain ⟨m, gs, him, hgs, hgsf⟩ := hext
    have h := ordElem_eq_nuI_of_isStandardBase J gs hgs (Fin.castLE him (Fin.last i))
    rw [hgsf (Fin.last i), Fin.snoc_last] at h
    simpa using h

end Lemma18Main

section Theorem6Main

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- Theorem 6, p. 251: "Let `R` be a regular local ring, `(S; z₁, …, z_r)` a regular frame of
`R`, and `J` an ideal in `R`. Let `(f₁, …, f_m)` be a normalized standard base of `J` with
respect to `(S; z₁, …, z_r)`. Let `P` be a prime ideal in `R` such that `R/P` is regular and
`P ⊇ (z₁, …, z_r)R`. Then `P` is a permissible center for `J` if and only if
`ν_P(f_j) = ν^{(j)}(J)` for `1 ≤ j ≤ m`."

Formalization note: the hypothesis `J ≠ R` is added.  The paper tacitly takes `J` proper: for
`J = R` the standard base `(1)` satisfies `ν_P(1) = 0 = ν^{(1)}(R)`, while `P = M` is not a
permissible center for `R` (it does not contain `R`), so the if-part fails.  For proper `J`
every `ν^{(j)}(J) ≥ 1`, whence `f_j ∈ P` and `J ⊆ P`, which the paper's "the if-part is
trivial" uses. -/
@[blueprint "thm:III.6"
  (statement := /-- Let $R$ be a regular local ring, $(S;z_1,\dots,z_r)$ a regular frame of
    $R$ (\cref{def:III.9}), and $J$ an ideal in $R$. Let $(f_1,\dots,f_m)$ be a normalized
    standard base of $J$ with respect to $(S;z_1,\dots,z_r)$
    (\cref{def:III.9-normalized-standard-base}). Let $P$ be a prime ideal in $R$ such that
    $R/P$ is regular and $P\supseteq(z_1,\dots,z_r)R$. Then $P$ is a permissible center for
    $J$ (\cref{def:III.8}) if and only if $\nu_P(f_j)=\nu^{(j)}(J)$ for $1\le j\le m$
    (\cref{def:III.1}). (Theorem 6, p.~251.) (Formalization note: $J\ne R$ is assumed, as the
    paper tacitly does; for $J=R$ the if-part fails with the standard base $(1)$ and $P=M$.) -/)
  (proof := /-- The if-part is trivial, and the only-if-part is an immediate consequence of
    Lemma~18 (\cref{lem:III.18}). -/)
  (latexEnv := "theorem")]
theorem isPermissibleCenter_iff_ordElem_eq_nuI [Hironaka.Cited.ExistsSurjectiveOfIsRegularLocalRingOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (F : RegularFrame R) (J : Ideal R) (hJ : J ≠ ⊤)
    {m : ℕ} (f : Fin m → R) (hf : F.IsNormalizedStandardBase J f)
    (P : Ideal R) [P.IsPrime] (hPreg : IsRegularLocalRing (R ⧸ P)) (hzP : F.idealZ ≤ P) :
    IsPermissibleCenter R J P ↔
      ∀ j : Fin m, Ideal.ordElem P (f j) = nuI R J (j : ℕ).succPNat := by
  have hPM : P ≤ maximalIdeal R := le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)
  -- `ν_P(f_j) ≤ ν_M(f_j) = ν^{(j)}(J)`
  have hle : ∀ j, Ideal.ordElem P (f j) ≤ nuI R J (j : ℕ).succPNat := fun j => by
    rw [← ordElem_eq_nuI_of_isStandardBase J f hf.1 j]
    exact Ideal.ordElem_le fun ν hν => Ideal.le_ordElem (Ideal.pow_right_mono hPM ν hν)
  constructor
  · -- only-if: by induction on `j`, using Lemma 18 for `(f₁, …, f_{j-1})` and `f_j`
    intro hperm
    suffices key : ∀ j (hj : j < m), Ideal.ordElem P (f ⟨j, hj⟩) = nuI R J j.succPNat from
      fun j => key j j.2
    intro j
    induction j using Nat.strong_induction_on with
    | _ j ih =>
      intro hj
      refine le_antisymm (hle ⟨j, hj⟩) ?_
      have h18 := ordElem_ge_nuI_of_isNormalizedBy F J
        (fun k : Fin j => f (Fin.castLE hj.le k)) (fun k => hf.1.1 _)
        ⟨m, f, hj.le, hf.1, fun k => rfl⟩ (fun k => hf.2.1 _) (f ⟨j, hj⟩) (hf.1.1 _)
        (hf.2.2 ⟨j, hj⟩) P hzP hperm (fun k => ih k k.2 _)
      exact h18.1
  · -- if: the standard base is a system of initial forms along `P` (Corollary 1 of Theorem 2,
    -- Ch. II §2), and `J ⊆ P` since every `ν^{(j)}(J) ≥ 1`
    intro hord
    have hJM : J ≤ maximalIdeal R := le_maximalIdeal hJ
    have hfP : ∀ j, f j ∈ P := by
      intro j
      have h1 : (1 : ℕ∞) ≤ Ideal.ordElem P (f j) := by
        rw [hord j, ← ordElem_eq_nuI_of_isStandardBase J f hf.1 j]
        exact_mod_cast Ideal.le_ordElem (by rw [pow_one]; exact hJM (hf.1.1 j))
      by_cases htop : Ideal.ordElem P (f j) = ⊤
      · simpa using Ideal.ordElem_eq_top_iff.mp htop 1
      · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
        rw [← hn, Nat.one_le_cast] at h1
        simpa using Ideal.pow_le_pow_right h1 (Ideal.mem_pow_of_ordElem hn.symm)
    have hJP : J ≤ P := by
      rw [← span_eq_of_isStandardBase R J f hf.1, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hfP j
    have := hPreg
    have : IsRegularLocalRing (R ⧸ maximalIdeal R) := by
      let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
      infer_instance
    refine Or.inr ⟨‹_›, hJP, hPreg, ?_⟩
    have h21 : HasInitialFormSystem J P (maximalIdeal R) ↔
        IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)) :=
      (isNormallyFlatAlongIdeal_tfae_of_eq_maximalIdeal J P (maximalIdeal R) hJP rfl).out 2 1
    refine h21.mp ⟨m, f, hf.1.1, fun j => ?_, hf.1.2.2.2.1.symm⟩
    rw [ordElem_eq_nuI_of_isStandardBase J f hf.1 j, hord j]

end Theorem6Main

end Hironaka

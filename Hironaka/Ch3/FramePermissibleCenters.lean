/-!
# Lemma 18 and Theorem 6 (Ch. III §7, pp. 248--251)

> "LEMMA 18. Let `R` be a regular local ring, `(S; z₁, …, z_r)` a regular frame of `R`, and `J` an
> ideal in `R`. […] Then we have `ν_P(f) ≥ ν^{(i+1)}(J)`. Moreover, `ν_M(f) = ν^{(i+1)}(J)` for the
> maximal ideal `M` of `R` if and only if `(f₁, …, f_i, f)` can be extended to a standard base of
> `J`."  (p. 249)

The proof of Lemma 18 begins "Let `R̂` be the completion of `R` with respect to the topology defined
by the powers of the ideal `(z₁, …, z_r)R`. Then we have `R̂ = S{z₁, …, z_r}`. The local
homomorphism `R → R̂` transforms a regular system of parameters of `R` into such a system of
parameters of `R̂`, so that the assumptions (i)–(vi) remain valid for `R̂` […] and that the
conclusion is replaced by an equivalent one" (p. 249).  This reduction is the base change of §8 for
the identity of `S` (`Compat/CompleteRationalFrameBaseChange.lean`), so Lemma 18 and Theorem 6,
which depends on it, are placed in this file, downstream of the base change.  The core argument
(coordinates and graded-ring machinery developed for Lemmas 19 and 20: the expansion map, the
E-sets) is the first part of this file.
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

section Lemma18Proof

open MvPolynomial


section SLevel

variable {S : Type u} [CommRing S] {s t : ℕ}

/-- The ideal generated by the first `s` members of a family of length `s + t`. -/
private def xIdeal (w : Fin (s + t) → S) : Ideal S :=
  Ideal.span (Set.range fun j : Fin s => w (Fin.castAdd t j))

/-- The ideal generated by the last `t` members of a family of length `s + t`. -/
private def yIdeal (w : Fin (s + t) → S) : Ideal S :=
  Ideal.span (Set.range fun l : Fin t => w (Fin.natAdd s l))

/-- A polynomial in `s + t` variables is *bihomogeneous of bidegree `(m, n)`* if every monomial
has degree `m` in the first `s` variables and degree `n` in the last `t` variables. -/
private def IsBidegreeForm (m n : ℕ) (Q : MvPolynomial (Fin (s + t)) S) : Prop :=
  ∀ d ∈ Q.support, (∑ i : Fin s, d (Fin.castAdd t i)) = m ∧ ∑ l : Fin t, d (Fin.natAdd s l) = n

private theorem IsBidegreeForm.add {m n : ℕ} {Q Q' : MvPolynomial (Fin (s + t)) S}
    (h : IsBidegreeForm m n Q) (h' : IsBidegreeForm m n Q') : IsBidegreeForm m n (Q + Q') := by
  classical
  intro d hd
  rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with h1 | h1
  · exact h d h1
  · exact h' d h1

private theorem IsBidegreeForm.zero (m n : ℕ) :
    IsBidegreeForm m n (0 : MvPolynomial (Fin (s + t)) S) :=
  fun d hd => by simp at hd

private theorem IsBidegreeForm.isHomogeneous {m n : ℕ} {Q : MvPolynomial (Fin (s + t)) S}
    (h : IsBidegreeForm m n Q) : Q.IsHomogeneous (m + n) := by
  intro d hd
  obtain ⟨h1, h2⟩ := h d (MvPolynomial.mem_support_iff.mpr hd)
  show Finsupp.weight 1 d = m + n
  have e : Finsupp.weight (1 : Fin (s + t) → ℕ) d = d.degree := by
    rw [Finsupp.degree_eq_weight_one]; rfl
  rw [e, Finsupp.degree_eq_sum, Fin.sum_univ_add, h1, h2]

private theorem prod_pow_mem_xIdeal_mul_yIdeal (w : Fin (s + t) → S) (d : Fin (s + t) →₀ ℕ) :
    ∏ i, w i ^ d i ∈ xIdeal w ^ (∑ i : Fin s, d (Fin.castAdd t i)) *
      yIdeal w ^ (∑ l : Fin t, d (Fin.natAdd s l)) := by
  rw [Fin.prod_univ_add]
  refine Ideal.mul_mem_mul ?_ ?_
  · rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i _ => Ideal.pow_mem_pow
      (show w (Fin.castAdd t i) ∈ xIdeal w from Ideal.subset_span ⟨i, rfl⟩) _
  · rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i _ => Ideal.pow_mem_pow
      (show w (Fin.natAdd s i) ∈ yIdeal w from Ideal.subset_span ⟨i, rfl⟩) _

private theorem isBiHomogeneous_rename_mul_rename {m n : ℕ} {B : MvPolynomial (Fin s) S}
    {A : MvPolynomial (Fin t) S} (hB : B.IsHomogeneous m) (hA : A.IsHomogeneous n) :
    IsBidegreeForm m n (rename (Fin.castAdd t) B * rename (Fin.natAdd s) A) := by
  classical
  intro d hd
  obtain ⟨d1, hd1, d2, hd2, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul _ _ hd)
  have hcinj : Function.Injective (Fin.castAdd t : Fin s → Fin (s + t)) := fun a b h =>
    Fin.ext (by simpa using congrArg Fin.val h)
  have hninj : Function.Injective (Fin.natAdd s : Fin t → Fin (s + t)) := fun a b h =>
    Fin.ext (by simpa using congrArg Fin.val h)
  rw [MvPolynomial.support_rename_of_injective hcinj] at hd1
  rw [MvPolynomial.support_rename_of_injective hninj] at hd2
  obtain ⟨e1, he1, rfl⟩ := Finset.mem_image.mp hd1
  obtain ⟨e2, he2, rfl⟩ := Finset.mem_image.mp hd2
  have h1 : e1.degree = m := by
    rw [Finsupp.degree_eq_weight_one]; exact hB (MvPolynomial.mem_support_iff.mp he1)
  have h2 : e2.degree = n := by
    rw [Finsupp.degree_eq_weight_one]; exact hA (MvPolynomial.mem_support_iff.mp he2)
  have hcn : ∀ (i : Fin s) , (Finsupp.mapDomain (Fin.natAdd s) e2) (Fin.castAdd t i) = 0 := by
    intro i
    refine Finsupp.mapDomain_of_notMem_range _ _ ?_
    rintro ⟨l, hl⟩
    have := congrArg Fin.val hl
    simp at this
    omega
  have hnc : ∀ (l : Fin t) , (Finsupp.mapDomain (Fin.castAdd t) e1) (Fin.natAdd s l) = 0 := by
    intro l
    refine Finsupp.mapDomain_of_notMem_range _ _ ?_
    rintro ⟨i, hi⟩
    have := congrArg Fin.val hi
    simp at this
    omega
  constructor
  · simp only [Finsupp.add_apply, hcn, add_zero, Finsupp.mapDomain_apply_of_injective hcinj]
    rw [← h1, Finsupp.degree_eq_sum]
  · simp only [Finsupp.add_apply, hnc, zero_add, Finsupp.mapDomain_apply_of_injective hninj]
    rw [← h2, Finsupp.degree_eq_sum]

private theorem exists_isBiHomogeneous_of_mem (w : Fin (s + t) → S) {m n : ℕ} {q : S}
    (hq : q ∈ xIdeal w ^ m * yIdeal w ^ n) :
    ∃ Q : MvPolynomial (Fin (s + t)) S, IsBidegreeForm m n Q ∧ eval w Q = q := by
  refine Submodule.mul_induction_on hq ?_ ?_
  · intro b hb a ha
    obtain ⟨B, hB, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous
      (fun j : Fin s => w (Fin.castAdd t j)) b).mp hb
    obtain ⟨A, hA, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous
      (fun l : Fin t => w (Fin.natAdd s l)) a).mp ha
    refine ⟨rename (Fin.castAdd t) B * rename (Fin.natAdd s) A,
      isBiHomogeneous_rename_mul_rename hB hA, ?_⟩
    rw [map_mul, eval_rename, eval_rename]
    rfl
  · rintro _ _ ⟨Q, hQ, rfl⟩ ⟨Q', hQ', rfl⟩
    exact ⟨Q + Q', hQ.add hQ', by rw [map_add]⟩

end SLevel


section Independence

variable {A : Type u} [CommRing A] {σ : Type*} [Fintype σ] [DecidableEq σ]

/-- The hypothesis `hind` of `mem_pow_succ_of_mem_sup` / `inf_pow_le_sum` for a quasi-regular
family. -/
private theorem hind_of_isQuasiRegular (x : σ → A) (hqr : IsQuasiRegular x) (Zs : Finset σ) :
    ∀ (m : ℕ) (s' : Finset ℕ), (∀ a ∈ s', a ≤ m) → ∀ u : ℕ → A,
      (∀ a ∈ s', u a ∈ Ideal.span (x '' ↑Zs) ^ a * Ideal.span (x '' ↑Zsᶜ) ^ (m - a)) →
      ∑ a ∈ s', u a ∈ Ideal.span (Set.range x) ^ (m + 1) →
      ∀ a ∈ s', u a ∈ Ideal.span (Set.range x) *
        (Ideal.span (x '' ↑Zs) ^ a * Ideal.span (x '' ↑Zsᶜ) ^ (m - a)) :=
  fun m' s' hs u hu hsum => mem_mul_of_sum_mem_pow x hqr Zs m' s' hs u hu hsum

omit [Fintype σ] [DecidableEq σ] in
private theorem ideal_sum_le {ι : Type*} (s : Finset ι) (I : ι → Ideal A) (K : Ideal A)
    (h : ∀ a ∈ s, I a ≤ K) : ∑ a ∈ s, I a ≤ K := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact sup_le (h a (Finset.mem_insert_self a s))
      (ih fun b hb => h b (Finset.mem_insert_of_mem hb))

end Independence


section DoubleOrd

variable {R : Type u} [CommRing R]

private theorem sup_pow_le_sup_pow (P Y : Ideal R) (k : ℕ) : (P ⊔ Y) ^ k ≤ P ⊔ Y ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ']
    refine (Ideal.mul_mono_right ih).trans ?_
    rw [Ideal.mul_le]
    intro a ha b hb
    obtain ⟨p, hp, y, hy, rfl⟩ := Submodule.mem_sup.mp ha
    obtain ⟨p', hp', y', hy', rfl⟩ := Submodule.mem_sup.mp hb
    have h1 : (p + y) * (p' + y') = p * (p' + y') + y * p' + y * y' := by ring
    rw [h1]
    refine add_mem (add_mem ?_ ?_) ?_
    · exact Ideal.mem_sup_left (Ideal.mul_mem_right _ _ hp)
    · exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ hp')
    · refine Ideal.mem_sup_right ?_
      rw [pow_succ']
      exact Ideal.mul_mem_mul hy hy'

/-- `k ≤ ν_I(f)` iff (here: implies) `f ∈ Iᵏ`. -/
private theorem mem_pow_of_le_ordElem' {I : Ideal R} {f : R} {k : ℕ}
    (h : (k : ℕ∞) ≤ Ideal.ordElem I f) : f ∈ I ^ k := by
  by_cases htop : Ideal.ordElem I f = ⊤
  · exact Ideal.ordElem_eq_top_iff.mp htop k
  · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
    have := Ideal.mem_pow_of_ordElem hn.symm
    rw [← hn, Nat.cast_le] at h
    exact Ideal.pow_le_pow_right h this

/-- `[g] ∈ Qᵏ gr_P(R)` for `k ≤ ν_{Q/P}`: `g ∈ Yᵏ Pᵘ + Pᵘ⁺¹` when `Q = P ⊔ Y`. -/
private theorem exists_mem_pow_mul_pow_of_le_doubleOrd (P Q Y : Ideal R) (hQ : Q = P ⊔ Y) {g : R}
    {μ k : ℕ} (hμ : Ideal.ordElem P g = μ)
    (hk : (k : ℕ∞) ≤ doubleOrd P Q (initialForm P g)) :
    ∃ h ∈ Y ^ k * P ^ μ, g - h ∈ P ^ (μ + 1) := by
  have hgP : g ∈ P ^ μ := Ideal.mem_pow_of_ordElem hμ
  have h1 : initialForm P g ∈ (Q.map (algebraMap R (AssocGraded P))) ^ k :=
    mem_pow_of_le_ordElem' hk
  rw [initialForm_eq_mk P hμ] at h1
  have h2 := grProj_mem_pow_smul_top P Q μ k h1
  rw [grProj_mk_same] at h2
  have h3 := mem_mul_sup_of_mem_pow_smul_top P Q μ k hgP h2
  obtain ⟨a, ha, p, hp, rfl⟩ := Submodule.mem_sup.mp h3
  -- `Qᵏ Pᵘ ⊆ Yᵏ Pᵘ + Pᵘ⁺¹`
  have h4 : Q ^ k * P ^ μ ≤ Y ^ k * P ^ μ ⊔ P ^ (μ + 1) := by
    calc Q ^ k * P ^ μ ≤ (P ⊔ Y ^ k) * P ^ μ := Ideal.mul_mono_left (hQ ▸ sup_pow_le_sup_pow P Y k)
      _ = Y ^ k * P ^ μ ⊔ P ^ (μ + 1) := by
        rw [Ideal.sup_mul, pow_succ', sup_comm]
  obtain ⟨b, hb, c, hc, hbc⟩ := Submodule.mem_sup.mp (h4 ha)
  refine ⟨b, hb, ?_⟩
  have : a + p - b = c + p := by rw [← hbc]; ring
  rw [this]
  exact add_mem hc hp

/-- Krull: `ν_{M/P}` of the initial form of a nonzero-order element is finite. -/
private theorem doubleOrd_ne_top [IsLocalRing R] [IsNoetherianRing R] (P : Ideal R) {g : R} {μ : ℕ}
    (hP : P ≠ ⊤) (hμ : Ideal.ordElem P g = μ) :
    doubleOrd P (maximalIdeal R) (initialForm P g) ≠ ⊤ := by
  intro htop
  have hall : ∀ k : ℕ, g ∈ maximalIdeal R ^ k ⊔ P ^ (μ + 1) := by
    intro k
    have hk : (k : ℕ∞) ≤ doubleOrd P (maximalIdeal R) (initialForm P g) := by
      rw [htop]; exact le_top
    obtain ⟨h, hh, hgh⟩ := exists_mem_pow_mul_pow_of_le_doubleOrd P (maximalIdeal R)
      (maximalIdeal R) (sup_eq_right.mpr (le_maximalIdeal hP)).symm hμ hk
    have := add_mem (Ideal.mem_sup_left (Ideal.mul_le_left hh) :
      h ∈ maximalIdeal R ^ k ⊔ P ^ (μ + 1)) (Ideal.mem_sup_right hgh)
    rwa [add_sub_cancel] at this
  have hzero : (Ideal.Quotient.mk (P ^ (μ + 1)) g : R ⧸ P ^ (μ + 1)) = 0 := by
    have hmem : (Ideal.Quotient.mk (P ^ (μ + 1)) g : R ⧸ P ^ (μ + 1)) ∈
        (⨅ i : ℕ, maximalIdeal R ^ i • ⊤ : Submodule R (R ⧸ P ^ (μ + 1))) := by
      rw [Submodule.mem_iInf]
      intro k
      obtain ⟨m, hm, p, hp, rfl⟩ := Submodule.mem_sup.mp (hall k)
      have hp0 : (Ideal.Quotient.mk (P ^ (μ + 1)) p) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hp
      have h1 : (Ideal.Quotient.mk (P ^ (μ + 1)) (m + p) : R ⧸ P ^ (μ + 1)) =
          m • (1 : R ⧸ P ^ (μ + 1)) := by
        rw [map_add, hp0, add_zero, Algebra.smul_def, mul_one]
        rfl
      rw [h1]
      exact Submodule.smul_mem_smul hm Submodule.mem_top
    have := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (R := R) (M := R ⧸ P ^ (μ + 1))
      (I := maximalIdeal R) (Ideal.IsMaximal.ne_top inferInstance)
    rw [this] at hmem
    exact (Submodule.mem_bot R).mp hmem
  have hg : g ∈ P ^ (μ + 1) := Ideal.Quotient.eq_zero_iff_mem.mp hzero
  have := Ideal.le_ordElem hg
  rw [hμ] at this
  exact absurd (Nat.cast_le.mp this) (by omega)

/-- If `g ∈ Yⁿ Pᵘ + Pᵘ⁺¹` (and `ν_P(g) = μ`, `Y ⊆ Q`) then `n ≤ ν_{Q/P}(Φ)`. -/
private theorem le_doubleOrd_of_mem_pow_mul_pow (P Q Y : Ideal R) (hY : Y ≤ Q) {g : R} {μ n : ℕ}
    (hμ : Ideal.ordElem P g = μ) (hg : ∃ h ∈ Y ^ n * P ^ μ, g - h ∈ P ^ (μ + 1)) :
    (n : ℕ∞) ≤ doubleOrd P Q (initialForm P g) := by
  obtain ⟨h, hh, hgh⟩ := hg
  have hgP : g ∈ P ^ μ := Ideal.mem_pow_of_ordElem hμ
  have hhP : h ∈ P ^ μ := Ideal.mul_le_right hh
  have h1 : initialForm P g = AssocGraded.mk P μ h hhP := by
    rw [initialForm_eq_mk P hμ]
    exact assocGraded_mk_eq_of_sub_mem P hgP hhP hgh
  have h2 : ∀ x ∈ Y ^ n * P ^ μ, ∀ hx : x ∈ P ^ μ,
      AssocGraded.mk P μ x hx ∈ (Q.map (algebraMap R (AssocGraded P))) ^ n := by
    intro x hx
    refine Submodule.mul_induction_on' (fun b hb a ha hx => ?_)
      (fun a ha' b hb' iha ihb hx => ?_) hx
    · have hb' : b ∈ P ^ 0 := by simp
      have e1 : AssocGraded.mk P μ (b * a) hx = AssocGraded.mk P μ a ha *
          AssocGraded.mk P 0 b hb' := by
        rw [AssocGraded.mk_mul_mk P ha hb']
        exact assocGraded_mk_congr P rfl (mul_comm b a) _ _
      rw [e1]
      refine Ideal.mul_mem_left _ _ ?_
      have e2 : AssocGraded.mk P 0 b hb' = algebraMap R (AssocGraded P) b := rfl
      rw [e2, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ (Ideal.pow_right_mono hY n hb)
    · have haP : a ∈ P ^ μ := Ideal.mul_le_right ha'
      have hbP : b ∈ P ^ μ := Ideal.mul_le_right hb'
      rw [AssocGraded.mk_add P μ a b haP hbP]
      exact add_mem (iha haP) (ihb hbP)
  rw [h1]
  exact Ideal.le_ordElem (h2 h hh hhP)

end DoubleOrd



namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (F : RegularFrame R)

/-- The ideal of power series `p` with `coeff B p ∈ Xi ^ (m - |B|) * Ys ^ n`. -/
private def coeffPowMulPowIdeal (Xi Ys : Ideal F.S) (m n : ℕ) :
    Ideal (MvPowerSeries (Fin F.r) F.S) where
  carrier := {p | ∀ B : Fin F.r →₀ ℕ,
    MvPowerSeries.coeff B p ∈ Xi ^ (m - B.degree) * Ys ^ n}
  add_mem' := by
    intro p q hp hq B
    rw [map_add]
    exact add_mem (hp B) (hq B)
  zero_mem' := fun B => by rw [map_zero]; exact zero_mem _
  smul_mem' := by
    intro q p hp B
    rw [smul_eq_mul, MvPowerSeries.coeff_mul]
    refine sum_mem fun pr hpr => ?_
    have hdeg : pr.1.degree + pr.2.degree = B.degree := by
      rw [← map_add, Finset.HasAntidiagonal.mem_antidiagonal.mp hpr]
    refine Ideal.mul_mem_left _ _ ((Ideal.mul_mono_left (Ideal.pow_le_pow_right ?_)) (hp pr.2))
    omega

private theorem coeffPowMulPowIdeal_mul_le (Xi Ys : Ideal F.S) (a b a' b' : ℕ) :
    coeffPowMulPowIdeal F Xi Ys a b * coeffPowMulPowIdeal F Xi Ys a' b' ≤
      coeffPowMulPowIdeal F Xi Ys (a + a') (b + b') := by
  rw [Ideal.mul_le]
  intro p hp q hq B
  rw [MvPowerSeries.coeff_mul]
  refine sum_mem fun pr hpr => ?_
  have hdeg : pr.1.degree + pr.2.degree = B.degree := by
    rw [← map_add, Finset.HasAntidiagonal.mem_antidiagonal.mp hpr]
  have h1 := Ideal.mul_mem_mul (hp pr.1) (hq pr.2)
  rw [mul_mul_mul_comm, ← pow_add, ← pow_add] at h1
  refine Ideal.mul_mono_left (Ideal.pow_le_pow_right ?_) h1
  omega

private theorem coeffPowMulPowIdeal_pow_le (Xi Ys : Ideal F.S) (a b k : ℕ) :
    coeffPowMulPowIdeal F Xi Ys a b ^ k ≤ coeffPowMulPowIdeal F Xi Ys (k * a) (k * b) := by
  induction k with
  | zero =>
    rw [pow_zero, Ideal.one_eq_top]
    intro p _ B
    simp
  | succ k ih =>
    rw [pow_succ']
    have := (Ideal.mul_mono_right ih).trans (coeffPowMulPowIdeal_mul_le F Xi Ys a b (k * a) (k * b))
    rwa [show a + k * a = (k + 1) * a by ring, show b + k * b = (k + 1) * b by ring] at this

/-- `g ∈ Y^n Pᵐ` (for `P ⊆ (z)R + Xi·R`, `Y = Ys R`) forces `c_B(g) ∈ Xi^(m - |B|) Ys^n` for the
expansion coefficients of `g`. -/
private theorem expCoeff_mem_pow_mul_pow (Xi Ys : Ideal F.S) (P : Ideal R)
    (hP : P ≤ F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) {m n : ℕ} {a : R}
    (ha : a ∈ Ideal.map (algebraMap F.S R) Ys ^ n * P ^ m) (B : Fin F.r →₀ ℕ) :
    F.expCoeff a B ∈ Xi ^ (m - B.degree) * Ys ^ n := by
  have h1 : Ideal.map (expansion F) P ≤ coeffPowMulPowIdeal F Xi Ys 1 0 := by
    rw [Ideal.map_le_iff_le_comap]
    refine hP.trans (sup_le ?_ ?_)
    · show Ideal.span (Set.range F.z) ≤ _
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, (isExpansion_expansion F).map_z j]
      intro B
      rw [MvPowerSeries.coeff_X]
      split_ifs with hB
      · rw [hB, Finsupp.degree_single, Nat.sub_self]
        simp
      · exact zero_mem _
    · rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, Ideal.mem_comap, (isExpansion_expansion F).map_algebraMap c]
      intro B
      rw [MvPowerSeries.coeff_C]
      split_ifs with hB
      · rw [hB, map_zero, Nat.sub_zero, pow_zero, Ideal.one_eq_top, Ideal.mul_top, pow_one]
        exact hc
      · exact zero_mem _
  have h2 : Ideal.map (expansion F) (Ideal.map (algebraMap F.S R) Ys) ≤
      coeffPowMulPowIdeal F Xi Ys 0 1 := by
    rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, Ideal.mem_comap, (isExpansion_expansion F).map_algebraMap c]
    intro B
    rw [MvPowerSeries.coeff_C]
    split_ifs with hB
    · rw [hB, map_zero, Nat.sub_zero, pow_zero, Ideal.one_eq_top, Ideal.top_mul, pow_one]
      exact hc
    · exact zero_mem _
  have h3 : expansion F a ∈ Ideal.map (expansion F) (Ideal.map (algebraMap F.S R) Ys) ^ n *
      Ideal.map (expansion F) P ^ m := by
    have h3a := Ideal.mem_map_of_mem (expansion F) ha
    rwa [Ideal.map_mul, Ideal.map_pow, Ideal.map_pow] at h3a
  have h4 := Ideal.mul_mono (Ideal.pow_right_mono h2 n) (Ideal.pow_right_mono h1 m) h3
  have h5 := Ideal.mul_mono (coeffPowMulPowIdeal_pow_le F Xi Ys 0 1 n)
    (coeffPowMulPowIdeal_pow_le F Xi Ys 1 0 m)
    h4
  have h6 := coeffPowMulPowIdeal_mul_le F Xi Ys (n * 0) (n * 1) (m * 1) (m * 0) h5
  have := h6 B
  rwa [show n * 0 + m * 1 = m by ring, show n * 1 + m * 0 = n by ring] at this

/-- The coefficient `c_0` of the expansion of an element `c` of `S` is `c`. -/
private theorem expCoeff_algebraMap_zero (c : F.S) : F.expCoeff (algebraMap F.S R c) 0 = c := by
  rw [← coeff_expansion, (isExpansion_expansion F).map_algebraMap, MvPowerSeries.coeff_C,
    ite_eq_left rfl]

/-- `Xi^k ⊆ P^k` for `P ⊇ Xi R`. -/
private theorem algebraMap_mem_pow_of_mem_pow {Xi : Ideal F.S} {P : Ideal R}
    (hxP : Ideal.map (algebraMap F.S R) Xi ≤ P) {c : F.S} {k : ℕ} (hc : c ∈ Xi ^ k) :
    algebraMap F.S R c ∈ P ^ k := by
  have h1 := Ideal.mem_map_of_mem (algebraMap F.S R) hc
  rw [Ideal.map_pow] at h1
  exact Ideal.pow_right_mono hxP k h1

/-- **The coefficients describe the powers of `P`** (the converse of `expCoeff_mem_pow_mul_pow`
for `Y = R`): for `P = (z)R + Xi R`, `p ∈ P^m` iff `c_B(p) ∈ Xi^(m - |B|)` for all `B`.  In the
completion `R̂ = S{z}` this says that the power series `f = Σ c_A z^A` lies in `P^m` as soon as
each term `c_A z^A` does (the tail `Σ_{|A| ≥ m} c_A z^A` lies in `(z)^m`, being a power series
without terms of degree `< m`). -/
private theorem mem_pow_iff_expCoeff_mem (Xi : Ideal F.S) (P : Ideal R)
    (hP : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) (m : ℕ) (p : R) :
    p ∈ P ^ m ↔ ∀ B : Fin F.r →₀ ℕ, F.expCoeff p B ∈ Xi ^ (m - B.degree) := by
  have hzP : F.idealZ ≤ P := hP ▸ le_sup_left
  have hxP : Ideal.map (algebraMap F.S R) Xi ≤ P := hP ▸ le_sup_right
  constructor
  · intro hp B
    have := expCoeff_mem_pow_mul_pow F Xi ⊤ P hP.le (m := m) (n := 0) (a := p)
      (by rw [pow_zero, Ideal.one_eq_top, Ideal.top_mul]; exact hp) B
    simpa using this
  · intro h
    obtain ⟨G, hG⟩ := exists_evZ_sub_mem_pow F m p
    have hev : evZ F G ∈ P ^ m := by
      rw [G.as_sum, map_sum]
      refine sum_mem fun B hB => ?_
      by_cases hBm : B.degree < m
      · have hc : G.coeff B ∈ Xi ^ (m - B.degree) := by
          rw [← expCoeff_eq F hG hBm]
          exact h B
        have h1 := algebraMap_mem_pow_of_mem_pow F hxP hc
        have h2 : (B.prod fun j e => F.z j ^ e) ∈ P ^ B.degree :=
          Ideal.pow_right_mono hzP _ (prod_z_pow_mem F B)
        have h3 := Ideal.mul_mem_mul h1 h2
        rw [← pow_add, Nat.sub_add_cancel hBm.le] at h3
        rw [evZ, MvPolynomial.aeval_monomial]
        exact h3
      · exact Ideal.pow_le_pow_right (not_lt.mp hBm)
          (Ideal.pow_right_mono hzP _ (evZ_monomial_mem F B _))
    have := add_mem (Ideal.pow_right_mono hzP m hG) hev
    rwa [sub_add_cancel] at this

/-- `ν_P` of the coefficients: `c ∈ Xi^k` iff `c ∈ P^k` (in `R`). -/
private theorem algebraMap_mem_pow_iff (Xi : Ideal F.S) (P : Ideal R)
    (hP : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) (c : F.S) (k : ℕ) :
    algebraMap F.S R c ∈ P ^ k ↔ c ∈ Xi ^ k := by
  refine ⟨fun h => ?_, algebraMap_mem_pow_of_mem_pow F (hP ▸ le_sup_right)⟩
  have := (mem_pow_iff_expCoeff_mem F Xi P hP k _).mp h 0
  rw [expCoeff_algebraMap_zero] at this
  simpa using this

private theorem natCast_le_natCast_add_iff (m d : ℕ) (x : ℕ∞) :
    (m : ℕ∞) ≤ (d : ℕ∞) + x ↔ ((m - d : ℕ) : ℕ∞) ≤ x := by
  induction x using ENat.recTopCoe with
  | top => simp
  | coe n => norm_cast; omega

/-- If `|B| + ν_P(c_B) ≥ m` then `c_B ∈ Xi^(m - |B|)`. -/
private theorem expCoeff_mem_pow_of_le (Xi : Ideal F.S) (P : Ideal R)
    (hP : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) (p : R) (B : Fin F.r →₀ ℕ) {m : ℕ}
    (h : (m : ℕ∞) ≤ (B.degree : ℕ∞) + Ideal.ordElem P (algebraMap F.S R (F.expCoeff p B))) :
    F.expCoeff p B ∈ Xi ^ (m - B.degree) :=
  (algebraMap_mem_pow_iff F Xi P hP _ _).mp
    (mem_pow_of_le_ordElem' ((natCast_le_natCast_add_iff m B.degree _).mp h))

/-- **"`ν_P(c_A) ≥ ν̄ − |A|` for all `A`, or equivalently, `ν_P(f) ≥ ν̄`"** (Lemma 18, p. 249: the
equivalence is asserted without proof): for `ν̄ ∈ ℕ∞`, `ν̄ ≤ ν_P(p)` iff
`ν̄ ≤ |A| + ν_P(c_A(p))` for every `A`. -/
private theorem le_ordElem_iff_forall_expCoeff (Xi : Ideal F.S) (P : Ideal R)
    (hP : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) (p : R) (a : ℕ∞) :
    a ≤ Ideal.ordElem P p ↔ ∀ B : Fin F.r →₀ ℕ,
      a ≤ (B.degree : ℕ∞) + Ideal.ordElem P (algebraMap F.S R (F.expCoeff p B)) := by
  constructor
  · intro h B
    rw [← ENat.forall_natCast_le_iff_le]
    intro m hm
    have hp : p ∈ P ^ m := mem_pow_of_le_ordElem' (hm.trans h)
    have hc := (mem_pow_iff_expCoeff_mem F Xi P hP m p).mp hp B
    have h2 : algebraMap F.S R (F.expCoeff p B) ∈ P ^ (m - B.degree) :=
      algebraMap_mem_pow_of_mem_pow F (hP ▸ le_sup_right) hc
    exact (natCast_le_natCast_add_iff m B.degree _).mpr (Ideal.le_ordElem h2)
  · intro h
    rw [← ENat.forall_natCast_le_iff_le]
    intro m hm
    exact Ideal.le_ordElem ((mem_pow_iff_expCoeff_mem F Xi P hP m p).mpr fun B =>
      expCoeff_mem_pow_of_le F Xi P hP p B (hm.trans (h B)))

/-- If `μ = |A₀| + ν_P(c_{A₀}(p))` is the least of the integers `|A| + ν_P(c_A(p))`, then
`ν_P(p) = μ`. -/
private theorem ordElem_eq_of_isLeast (Xi : Ideal F.S) (P : Ideal R)
    (hP : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) (p : R) {μ : ℕ}
    (A₀ : Fin F.r →₀ ℕ)
    (hA₀ : (A₀.degree : ℕ∞) + Ideal.ordElem P (algebraMap F.S R (F.expCoeff p A₀)) = μ)
    (hmin : ∀ A : Fin F.r →₀ ℕ, (μ : ℕ∞) ≤ (A.degree : ℕ∞) +
      Ideal.ordElem P (algebraMap F.S R (F.expCoeff p A))) :
    Ideal.ordElem P p = μ := by
  refine le_antisymm ?_ ((le_ordElem_iff_forall_expCoeff F Xi P hP p μ).mpr hmin)
  by_contra hlt
  rw [not_le] at hlt
  have h1 : ((μ + 1 : ℕ) : ℕ∞) ≤ Ideal.ordElem P p := by
    rw [Nat.cast_add_one]
    exact (ENat.add_one_le_iff (ENat.natCast_ne_top μ)).mpr hlt
  have := (le_ordElem_iff_forall_expCoeff F Xi P hP p _).mp h1 A₀
  rw [hA₀] at this
  exact absurd this (by rw [not_le]; exact_mod_cast Nat.lt_succ_self μ)

/-- A non-zero element has some coefficient with `|A| + ν_P(c_A) < ∞`. -/
private theorem exists_expCoeff_ordElem_lt_top (Xi : Ideal F.S) (P : Ideal R)
    (hP : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) Xi) (hPtop : P ≠ ⊤) {p : R} (hp0 : p ≠ 0) :
    ∃ A : Fin F.r →₀ ℕ, (A.degree : ℕ∞) +
      Ideal.ordElem P (algebraMap F.S R (F.expCoeff p A)) < ⊤ := by
  by_contra h
  simp only [not_exists, not_lt] at h
  have h1 := (le_ordElem_iff_forall_expCoeff F Xi P hP p ⊤).mpr h
  exact hp0 ((Ideal.ordElem_eq_top_iff_eq_zero hPtop).mp (top_le_iff.mp h1))

end RegularFrame

/-- The least of a family of values in `ℕ∞`, if one is `< a`, is a natural number attained by the
family. -/
private theorem exists_isLeast_of_exists_lt {ι : Type*} (v : ι → ℕ∞) {a : ℕ∞} (h : ∃ i, v i < a) :
    ∃ (μ : ℕ) (i₀ : ι), (μ : ℕ∞) < a ∧ v i₀ = μ ∧ ∀ i, (μ : ℕ∞) ≤ v i := by
  obtain ⟨i₁, h₁⟩ := h
  obtain ⟨m, ⟨i₀, rfl⟩, hm⟩ := WellFounded.has_min wellFounded_lt (Set.range v) ⟨v i₁, i₁, rfl⟩
  have hle : v i₀ ≤ v i₁ := not_lt.mp (hm _ ⟨i₁, rfl⟩)
  obtain ⟨μ, hμ⟩ := ENat.ne_top_iff_exists.mp (lt_top_iff_ne_top.mp (lt_of_le_of_lt hle
    (h₁.trans_le le_top)))
  refine ⟨μ, i₀, ?_, hμ.symm, fun i => ?_⟩
  · rw [hμ]; exact lt_of_le_of_lt hle h₁
  · rw [hμ]; exact not_lt.mp (hm _ ⟨i, rfl⟩)

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (F : RegularFrame R)

/-- `S / (P ∩ S) ≅ R / P` is regular when `R / P` is, for a prime `P ⊇ (z)R` of a regular frame. -/
private theorem isRegularLocalRing_quotient_comap (P : Ideal R) [P.IsPrime] (hzP : F.idealZ ≤ P)
    (hPreg : IsRegularLocalRing (R ⧸ P)) :
    IsRegularLocalRing (F.S ⧸ P.comap (algebraMap F.S R)) := by
  have := hPreg
  let φ : F.S →+* R ⧸ P := (Ideal.Quotient.mk P).comp (algebraMap F.S R)
  have hφ : Function.Surjective φ := by
    intro a
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective a
    refine ⟨retr F y, ?_⟩
    show Ideal.Quotient.mk P (algebraMap F.S R (retr F y)) = Ideal.Quotient.mk P y
    rw [Ideal.Quotient.eq, ← neg_sub]
    exact neg_mem (hzP (sub_retr_mem F y))
  have hker : P.comap (algebraMap F.S R) = RingHom.ker φ := by
    ext a
    rw [Ideal.mem_comap, RingHom.mem_ker]
    exact (Ideal.Quotient.eq_zero_iff_mem (I := P) (a := algebraMap F.S R a)).symm
  have e : (F.S ⧸ P.comap (algebraMap F.S R)) ≃+* R ⧸ P :=
    (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hφ)
  exact IsRegularLocalRing.of_ringEquiv e.symm

/-- A system `w` of `s + t` elements of `S` is *adapted* to a prime `P ⊇ (z)R`: `(x, y) = w`
is a minimal system of generators of the maximal ideal of `S` (so it is a quasi-regular family),
`(z, x, y)` is a regular system of parameters of `R`, and `P = (z)R + (x)R`. -/
private structure IsAdapted (P : Ideal R) {s t : ℕ} (w : Fin (s + t) → F.S) : Prop where
  injective : Function.Injective w
  mem_maximalIdeal : ∀ j, w j ∈ maximalIdeal F.S
  span_eq : Ideal.span (Set.range w) = maximalIdeal F.S
  isQuasiRegular : IsQuasiRegular w
  span_adapted : Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
    maximalIdeal R
  dim_eq : ((F.r + (s + t) : ℕ) : WithBot ℕ∞) = ringKrullDim R
  eq_sup : P = F.idealZ ⊔ Ideal.map (algebraMap F.S R) (xIdeal w)

/-- Coordinates adapted to a prime `P ⊇ (z)R` with `R/P` regular. -/
private theorem exists_isAdapted (P : Ideal R) [P.IsPrime] (hzP : F.idealZ ≤ P)
    (hPreg : IsRegularLocalRing (R ⧸ P)) :
    ∃ (s t : ℕ) (w : Fin (s + t) → F.S), F.IsAdapted P w := by
  classical
  have hP0reg := isRegularLocalRing_quotient_comap F P hzP hPreg
  obtain ⟨S₀, T, hS₀, hS₀card, hTS, hT⟩ :=
    exists_finset_span_eq_prime F.S (P.comap (algebraMap F.S R)) hP0reg
  obtain ⟨s₁, w₁, hwN₁, hNle₁, hspan₁, hdim₁⟩ := exists_rsop_append F
  set Y := S₀ \ T with hY
  let x : Fin T.card → F.S := fun i => (T.equivFin.symm i : F.S)
  let y : Fin Y.card → F.S := fun i => (Y.equivFin.symm i : F.S)
  let w : Fin (T.card + Y.card) → F.S := Fin.append x y
  have hxinj : Function.Injective x := Subtype.val_injective.comp T.equivFin.symm.injective
  have hyinj : Function.Injective y := Subtype.val_injective.comp Y.equivFin.symm.injective
  have hxT : ∀ i, x i ∈ T := fun i => (T.equivFin.symm i).2
  have hyY : ∀ i, y i ∈ Y := fun i => (Y.equivFin.symm i).2
  have hxrange : Set.range x = (T : Set F.S) := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      exact hxT i
    · intro hv
      exact ⟨T.equivFin ⟨v, hv⟩, by simp [x]⟩
  have hyrange : Set.range y = (Y : Set F.S) := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      exact hyY i
    · intro hv
      exact ⟨Y.equivFin ⟨v, hv⟩, by simp [y]⟩
  have hYT : ∀ i j, x i ≠ y j := fun i j h =>
    (Finset.mem_sdiff.mp (hyY j)).2 (h ▸ hxT i)
  have hwinj : Function.Injective w := by
    intro a b hab
    induction a using Fin.addCases with
    | left i =>
      induction b using Fin.addCases with
      | left i' =>
        simp only [w, Fin.append_left] at hab
        rw [hxinj hab]
      | right j' =>
        simp only [w, Fin.append_left, Fin.append_right] at hab
        exact absurd hab (hYT _ _)
    | right j =>
      induction b using Fin.addCases with
      | left i' =>
        simp only [w, Fin.append_left, Fin.append_right] at hab
        exact absurd hab.symm (hYT _ _)
      | right j' =>
        simp only [w, Fin.append_right] at hab
        rw [hyinj hab]
  have hwrange : Set.range w = (S₀ : Set F.S) := by
    ext v
    constructor
    · rintro ⟨a, rfl⟩
      induction a using Fin.addCases with
      | left i =>
        simp only [w, Fin.append_left]
        exact hTS (hxT i)
      | right j =>
        simp only [w, Fin.append_right]
        exact (Finset.mem_sdiff.mp (hyY j)).1
    · intro hv
      by_cases hvT : v ∈ T
      · obtain ⟨i, hi⟩ : v ∈ Set.range x := by rw [hxrange]; exact hvT
        exact ⟨Fin.castAdd _ i, by simp [w, hi]⟩
      · obtain ⟨j, hj⟩ : v ∈ Set.range y := by
          rw [hyrange]
          exact Finset.mem_sdiff.mpr ⟨hv, hvT⟩
        exact ⟨Fin.natAdd _ j, by simp [w, hj]⟩
  have hwS₀ : ∀ j, w j ∈ S₀ := fun j => by
    have : w j ∈ (S₀ : Set F.S) := by rw [← hwrange]; exact ⟨j, rfl⟩
    exact this
  have hwN : ∀ j, w j ∈ maximalIdeal F.S := by
    intro j
    rw [← hS₀]
    exact Ideal.subset_span (hwS₀ j)
  have hspanw : Ideal.span (Set.range w) = maximalIdeal F.S := by
    rw [hwrange, hS₀]
  have hcard : T.card + Y.card = S₀.card := by
    rw [add_comm]
    exact Finset.card_sdiff_add_card_eq_card hTS
  have hqr : IsQuasiRegular w := by
    refine isQuasiRegular_of_isWeaklyRegular w
      (isRegular_ofFn_of_minimal hS₀ hS₀card hwinj (fun j => ?_)).toIsWeaklyRegular
    exact hwS₀ j
  -- the span of `(z, w)` is `M`
  have hspanu : Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
      maximalIdeal R := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨v, rfl⟩
      refine Fin.addCases (fun i => ?_) (fun j => ?_) v
      · rw [Fin.append_left]
        exact z_mem_maximalIdeal F i
      · rw [Fin.append_right]
        exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hwN j)
    · intro x hx
      have h1 : x - algebraMap F.S R (retr F x) ∈
          Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
        refine Ideal.span_mono ?_ (sub_retr_mem F x)
        rintro _ ⟨i, rfl⟩
        exact ⟨Fin.castAdd _ i, Fin.append_left _ _ i⟩
      have h2 : algebraMap F.S R (retr F x) ∈
          Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
        have := Ideal.mem_map_of_mem (algebraMap F.S R)
          (hspanw.ge (retr_mem_maximalIdeal F hx))
        rw [Ideal.map_span] at this
        refine Ideal.span_mono ?_ this
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        exact ⟨Fin.natAdd F.r j, Fin.append_right _ _ j⟩
      have := add_mem h1 h2
      rwa [sub_add_cancel] at this
  -- the dimension count
  have hrank := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  rw [← hdim₁] at hrank
  have hrank' : (maximalIdeal R).spanFinrank = F.r + s₁ := by exact_mod_cast hrank
  have hle1 : S₀.card ≤ s₁ := by
    have h3 := Submodule.spanFinrank_span_le_ncard_of_finite (R := F.S)
      (Set.finite_range w₁)
    have h4 : (Set.range w₁).ncard ≤ s₁ := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
    have h5 : Submodule.span F.S (Set.range w₁) = maximalIdeal F.S :=
      le_antisymm (Ideal.span_le.mpr fun v ⟨j, hj⟩ => hj ▸ hwN₁ j) hNle₁
    rw [h5, ← hS₀card] at h3
    omega
  have hle2 : s₁ ≤ S₀.card := by
    have h3 := Submodule.spanFinrank_span_le_ncard_of_finite (R := R)
      (Set.finite_range (Fin.append F.z (algebraMap F.S R ∘ w)))
    have h4 : (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))).ncard ≤
        F.r + (T.card + Y.card) := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
    have h5 : Submodule.span R (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
        maximalIdeal R := hspanu
    rw [h5, hrank'] at h3
    omega
  have hs₁ : T.card + Y.card = s₁ := by omega
  have hP : P = F.idealZ ⊔ Ideal.span
      (Set.range fun j : Fin T.card => algebraMap F.S R (w (Fin.castAdd Y.card j))) := by
    have hxw : (fun j : Fin T.card => algebraMap F.S R (w (Fin.castAdd Y.card j))) =
        fun j => algebraMap F.S R (x j) := funext fun j => by
      simp only [w, Fin.append_left]
    rw [hxw]
    apply le_antisymm
    · intro p hp
      have h0 : p - algebraMap F.S R (retr F p) ∈ F.idealZ := sub_retr_mem F p
      have h1 : algebraMap F.S R (retr F p) ∈ P := by
        have := sub_mem hp (hzP h0)
        rwa [sub_sub_cancel] at this
      have h2 : retr F p ∈ Ideal.span (T : Set F.S) := by
        rw [hT]
        exact h1
      have h3 := Ideal.mem_map_of_mem (algebraMap F.S R) h2
      rw [Ideal.map_span] at h3
      have h4 : algebraMap F.S R (retr F p) ∈
          Ideal.span (Set.range fun j => algebraMap F.S R (x j)) := by
        refine Ideal.span_mono ?_ h3
        rintro _ ⟨a, ha, rfl⟩
        obtain ⟨j, rfl⟩ : a ∈ Set.range x := by rw [hxrange]; exact ha
        exact ⟨j, rfl⟩
      have := add_mem (Ideal.mem_sup_left h0) (Ideal.mem_sup_right h4)
      rwa [sub_add_cancel] at this
    · refine sup_le hzP (Ideal.span_le.mpr ?_)
      rintro _ ⟨j, rfl⟩
      have hx : x j ∈ P.comap (algebraMap F.S R) := by
        rw [← hT]
        exact Ideal.subset_span (hxT j)
      exact hx
  refine ⟨T.card, Y.card, w, hwinj, hwN, hspanw, hqr, hspanu, ?_, ?_⟩
  · rw [hs₁]
    exact hdim₁
  · rw [hP, xIdeal, Ideal.map_span, ← Set.range_comp]
    rfl

end RegularFrame

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

/-- The regular system of parameters `(z, w)` of `R` attached to an adapted system. -/
private noncomputable def adaptedFamily (F : RegularFrame R) (w : Fin (s + t) → F.S) :
    Fin (F.r + (s + t)) → R :=
  Fin.append F.z (algebraMap F.S R ∘ w)

private theorem adaptedFamily_mem (hA : F.IsAdapted P w) (i : Fin (F.r + (s + t))) :
    adaptedFamily F w i ∈ maximalIdeal R ^ 1 := by
  rw [pow_one, ← hA.span_adapted]
  exact Ideal.subset_span ⟨i, rfl⟩

private theorem adaptedFamily_aeval_bijective (hA : F.IsAdapted P w) :
    Function.Bijective (aeval (R := R ⧸ maximalIdeal R)
      fun i => AssocGraded.mk (maximalIdeal R) 1 (adaptedFamily F w i)
        (adaptedFamily_mem hA i)) :=
  assocGraded_maximalIdeal_aeval_bijective hA.span_adapted hA.dim_eq (adaptedFamily_mem hA)

/-- The graded isomorphism `k[Z, X, Y] ≅ gr_M(R)` sending the variables to the initial forms of
the regular system of parameters `(z, x, y)`. -/
private noncomputable def adaptedEquiv (hA : F.IsAdapted P w) :
    MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R) :=
  AlgEquiv.ofBijective _ (adaptedFamily_aeval_bijective hA)

private theorem adaptedEquiv_apply (hA : F.IsAdapted P w)
    (p : MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R)) :
    adaptedEquiv hA p = aeval (fun i => AssocGraded.mk (maximalIdeal R) 1
      (adaptedFamily F w i) (adaptedFamily_mem hA i)) p := rfl

private theorem mem_homogeneous_adaptedEquiv_iff (hA : F.IsAdapted P w) (d : ℕ)
    (p : MvPolynomial (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R)) :
    p ∈ homogeneousSubmodule (Fin (F.r + (s + t))) (R ⧸ maximalIdeal R) d ↔
      adaptedEquiv hA p ∈ AssocGraded.homogeneous (maximalIdeal R) d := by
  refine ⟨fun hp => ?_, fun hp => ?_⟩
  · rw [adaptedEquiv_apply]
    exact aeval_mem_homogeneous (adaptedFamily F w) (adaptedFamily_mem hA) d p hp
  · exact mem_homogeneous_of_aeval_mem (adaptedFamily F w) (adaptedFamily_mem hA)
      (adaptedFamily_aeval_bijective hA).1 d p hp

private theorem ordElem_z (hA : F.IsAdapted P w) (i : Fin F.r) :
    Ideal.ordElem (maximalIdeal R) (F.z i) = (1 : ℕ) := by
  have hz : adaptedFamily F w (Fin.castAdd (s + t) i) = F.z i := Fin.append_left _ _ i
  have hz1 : F.z i ∈ maximalIdeal R ^ 1 := hz ▸ adaptedFamily_mem hA _
  have hne : AssocGraded.mk (maximalIdeal R) 1 (F.z i) hz1 ≠ 0 := by
    have h1 : AssocGraded.mk (maximalIdeal R) 1 (F.z i) hz1 =
        adaptedEquiv hA (X (Fin.castAdd (s + t) i)) := by
      rw [adaptedEquiv_apply, aeval_X]
      exact assocGraded_mk_congr _ rfl hz.symm _ _
    rw [h1]
    exact fun h => X_ne_zero _ ((adaptedEquiv hA).injective (by rw [h, map_zero]))
  refine le_antisymm (Ideal.ordElem_le_of_notMem fun h => hne ?_) (Ideal.le_ordElem hz1)
  rw [AssocGraded.mk_eq_zero_iff]
  exact h

private theorem adaptedEquiv_X_castAdd (hA : F.IsAdapted P w) (i : Fin F.r) :
    adaptedEquiv hA (X (Fin.castAdd (s + t) i)) = frameForm F.z i := by
  have hz : adaptedFamily F w (Fin.castAdd (s + t) i) = F.z i := Fin.append_left _ _ i
  rw [adaptedEquiv_apply, aeval_X, frameForm, initialForm_eq_mk _ (ordElem_z hA i)]
  exact assocGraded_mk_congr _ rfl hz _ _

private theorem adaptedEquiv_map_mk (hA : F.IsAdapted P w) {d : ℕ}
    {K : MvPolynomial (Fin (F.r + (s + t))) R} (hK : K.IsHomogeneous d) :
    adaptedEquiv hA (K.map (Ideal.Quotient.mk (maximalIdeal R))) =
      AssocGraded.mk (maximalIdeal R) d (eval (adaptedFamily F w) K)
        (eval_mem_pow_of_isHomogeneous (maximalIdeal R) (adaptedFamily F w)
          (adaptedFamily_mem hA) hK) := by
  rw [adaptedEquiv_apply]
  exact aeval_mk_map_of_isHomogeneous (maximalIdeal R) (adaptedFamily F w)
    (adaptedFamily_mem hA) hK

end RegularFrame

private theorem exists_finset_degree_le' {r : ℕ} (ℓ : ℕ) :
    ∃ T : Finset (Fin r →₀ ℕ), ∀ B : Fin r →₀ ℕ, B.degree ≤ ℓ → B ∈ T := by
  classical
  refine ⟨(Fintype.piFinset fun _ : Fin r => Finset.range (ℓ + 1)).image
    Finsupp.equivFunOnFinite.symm, fun B hB => Finset.mem_image.mpr ⟨⇑B, ?_, by simp⟩⟩
  rw [Fintype.mem_piFinset]
  intro j
  rw [Finset.mem_range]
  have := Finsupp.le_degree j B
  omega

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

/-- The `z`-monomial `z^A`. -/
private noncomputable def zMonomial (F : RegularFrame R) (A : Fin F.r →₀ ℕ) : R :=
  A.prod fun j e => F.z j ^ e

end RegularFrame

section Weights

variable {k : Type u} [CommRing k] {r s t : ℕ}

/-- The weight on the variables `(Z, X, Y)` which is `1` on `Z, X` and `0` on `Y`. -/
private def zxWeight (r s t : ℕ) : Fin (r + (s + t)) → ℕ := fun i =>
  if (i : ℕ) < r + s then 1 else 0

private theorem zxWeight_castAdd (a : Fin r) : zxWeight r s t (Fin.castAdd (s + t) a) = 1 := by
  have := a.2
  simp only [zxWeight, Fin.val_castAdd]
  exact ite_eq_left (by omega)

private theorem zxWeight_natAdd_castAdd (j : Fin s) :
    zxWeight r s t (Fin.natAdd r (Fin.castAdd t j)) = 1 := by
  have := j.2
  simp only [zxWeight, Fin.val_natAdd, Fin.val_castAdd]
  exact ite_eq_left (by omega)

private theorem zxWeight_natAdd_natAdd (l : Fin t) :
    zxWeight r s t (Fin.natAdd r (Fin.natAdd s l)) = 0 := by
  simp only [zxWeight, Fin.val_natAdd]
  exact ite_eq_right (by omega)

private theorem weight_zxWeight_mapDomain_castAdd (A : Fin r →₀ ℕ) :
    Finsupp.weight (zxWeight r s t) (Finsupp.mapDomain (Fin.castAdd (s + t)) A) = A.degree := by
  rw [Finsupp.weight_apply, Finsupp.sum_mapDomain_index (by simp) (fun _ _ _ => add_smul _ _ _),
    Finsupp.degree_apply]
  refine Finset.sum_congr rfl fun a _ => ?_
  dsimp only
  rw [zxWeight_castAdd, smul_eq_mul, mul_one]

private theorem weight_zxWeight_mapDomain_natAdd (e : Fin (s + t) →₀ ℕ) :
    Finsupp.weight (zxWeight r s t) (Finsupp.mapDomain (Fin.natAdd r) e) =
      ∑ j : Fin s, e (Fin.castAdd t j) := by
  rw [Finsupp.weight_apply, Finsupp.sum_mapDomain_index (by simp) (fun _ _ _ => add_smul _ _ _),
    Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_add]
  simp only [zxWeight_natAdd_castAdd, zxWeight_natAdd_natAdd, smul_eq_mul, mul_one, mul_zero,
    Finset.sum_const_zero, add_zero]

end Weights

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

/-- The form `Σ_A Z^A · Q_A(X, Y)` in the variables `(Z, X, Y)`. -/
private noncomputable def coreForm (F : RegularFrame R) (T : Finset (Fin F.r →₀ ℕ))
    (Q : (Fin F.r →₀ ℕ) → MvPolynomial (Fin (s + t)) F.S) :
    MvPolynomial (Fin (F.r + (s + t))) F.S :=
  ∑ A ∈ T, rename (Fin.castAdd (s + t)) (monomial A 1) * rename (Fin.natAdd F.r) (Q A)

private theorem coreForm_map {L : Type u} [CommRing L] (φ : F.S →+* L) (T : Finset (Fin F.r →₀ ℕ))
    (Q : (Fin F.r →₀ ℕ) → MvPolynomial (Fin (s + t)) F.S) :
    (coreForm F T Q).map φ = ∑ A ∈ T, rename (Fin.castAdd (s + t)) (monomial A (1 : L)) *
      rename (Fin.natAdd F.r) ((Q A).map φ) := by
  rw [coreForm, map_sum]
  refine Finset.sum_congr rfl fun A _ => ?_
  rw [map_mul, map_rename, map_rename, map_monomial, map_one]

private theorem eval_coreForm_map (T : Finset (Fin F.r →₀ ℕ))
    (Q : (Fin F.r →₀ ℕ) → MvPolynomial (Fin (s + t)) F.S) :
    eval (adaptedFamily F w) ((coreForm F T Q).map (algebraMap F.S R)) =
      ∑ A ∈ T, algebraMap F.S R (eval w (Q A)) * F.zMonomial A := by
  have h1 : adaptedFamily F w ∘ Fin.castAdd (s + t) = F.z := funext fun i =>
    Fin.append_left _ _ i
  have h2 : adaptedFamily F w ∘ Fin.natAdd F.r = algebraMap F.S R ∘ w := funext fun j =>
    Fin.append_right _ _ j
  rw [coreForm_map, map_sum]
  refine Finset.sum_congr rfl fun A _ => ?_
  rw [map_mul, eval_rename, eval_rename, h1, h2, eval_monomial, one_mul, eval_map]
  have := MvPolynomial.eval₂_comp_left (algebraMap F.S R) (RingHom.id F.S) w (Q A)
  rw [mul_comm]
  exact congrArg (fun x => x * F.zMonomial A) this.symm

private theorem isHomogeneous_coreForm {μ n : ℕ} {T : Finset (Fin F.r →₀ ℕ)}
    {Q : (Fin F.r →₀ ℕ) → MvPolynomial (Fin (s + t)) F.S} (hT : ∀ A ∈ T, A.degree ≤ μ)
    (hQ : ∀ A ∈ T, IsBidegreeForm (μ - A.degree) n (Q A)) :
    (coreForm F T Q).IsHomogeneous (μ + n) := by
  refine IsHomogeneous.sum _ _ _ fun A hA => ?_
  have := ((isHomogeneous_monomial (d := A) (1 : F.S) rfl).rename_isHomogeneous
    (f := Fin.castAdd (s + t))).mul
    ((hQ A hA).isHomogeneous.rename_isHomogeneous (f := Fin.natAdd F.r))
  have e : A.degree + (μ - A.degree + n) = μ + n := by have := hT A hA; omega
  rwa [e] at this

private theorem isWeightedHomogeneous_rename_natAdd {L : Type u} [CommRing L] {r : ℕ}
    (q : MvPolynomial (Fin (s + t)) L) {m : ℕ}
    (hq : ∀ e ∈ q.support, ∑ j : Fin s, e (Fin.castAdd t j) = m) :
    IsWeightedHomogeneous (zxWeight r s t) (rename (Fin.natAdd r) q) m := by
  classical
  intro d hd
  have hninj : Function.Injective (Fin.natAdd r : Fin (s + t) → Fin (r + (s + t))) :=
    fun a b h => Fin.ext (by simpa using congrArg Fin.val h)
  have hd' : d ∈ (rename (Fin.natAdd r) q).support := mem_support_iff.mpr hd
  rw [MvPolynomial.support_rename_of_injective hninj] at hd'
  obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp hd'
  rw [weight_zxWeight_mapDomain_natAdd]
  exact hq e he

private theorem isWeightedHomogeneous_coreForm_map {L : Type u} [CommRing L] (φ : F.S →+* L)
    {μ n : ℕ}
    {T : Finset (Fin F.r →₀ ℕ)} {Q : (Fin F.r →₀ ℕ) → MvPolynomial (Fin (s + t)) F.S}
    (hT : ∀ A ∈ T, A.degree ≤ μ) (hQ : ∀ A ∈ T, IsBidegreeForm (μ - A.degree) n (Q A)) :
    IsWeightedHomogeneous (zxWeight F.r s t) ((coreForm F T Q).map φ) μ := by
  rw [coreForm_map]
  refine IsWeightedHomogeneous.sum _ _ _ fun A hA => ?_
  have h1 : IsWeightedHomogeneous (zxWeight F.r s t)
      (rename (Fin.castAdd (s + t)) (monomial A (1 : L))) A.degree := by
    rw [rename_monomial]
    exact isWeightedHomogeneous_monomial _ _ _ (weight_zxWeight_mapDomain_castAdd A)
  have h2 : IsWeightedHomogeneous (zxWeight F.r s t)
      (rename (Fin.natAdd F.r) ((Q A).map φ)) (μ - A.degree) := by
    refine isWeightedHomogeneous_rename_natAdd _ fun e he => ?_
    exact (hQ A hA e (MvPolynomial.support_map_subset _ _ he)).1
  have := h1.mul h2
  have e : A.degree + (μ - A.degree) = μ := by have := hT A hA; omega
  rwa [e] at this

private theorem exists_mem_of_mem_support_coreForm_map {L : Type u} [CommRing L] (φ : F.S →+* L)
    {T : Finset (Fin F.r →₀ ℕ)} {Q : (Fin F.r →₀ ℕ) → MvPolynomial (Fin (s + t)) F.S}
    {m : Fin (F.r + (s + t)) →₀ ℕ} (hm : m ∈ ((coreForm F T Q).map φ).support) :
    ∃ A ∈ T, zPart m = ⇑A ∧ (Q A).map φ ≠ 0 := by
  classical
  rw [coreForm_map] at hm
  obtain ⟨A, hAT, hmA⟩ := Finset.mem_biUnion.mp (support_sum hm)
  obtain ⟨hz, hne⟩ := zPart_of_mem_support_mul A _ hmA
  exact ⟨A, hAT, hz, hne⟩

end RegularFrame

section Bridge

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- Normal flatness of `P/J` in `R/J` localizes at the maximal ideal (the form of the hypothesis of
the elementwise Lemma 10 for `Q = M`). -/
private theorem isNormallyFlatAlongIdeal_localization_maximalIdeal [Hironaka.Cited.ExistsSurjectiveOfIsRegularLocalRingOfIsAdicComplete.{u}] [Hironaka.Cited.IsRegularLocalRingLocalizationOfIsRegularLocalRing.{u}] (J P : Ideal R) [P.IsPrime]
    (hPreg : IsRegularLocalRing (R ⧸ P)) (hJP : J ≤ P)
    (hflat : IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)))
    [((maximalIdeal R).map (Ideal.Quotient.mk J)).IsPrime] :
    IsNormallyFlatAlongIdeal ((P.map (Ideal.Quotient.mk J)).map
      (algebraMap (R ⧸ J)
        (Localization.AtPrime ((maximalIdeal R).map (Ideal.Quotient.mk J))))) := by
  have hJM : J ≤ maximalIdeal R := hJP.trans (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›))
  have hJtop : J ≠ ⊤ := fun h => (Ideal.IsPrime.ne_top ‹P.IsPrime›) (top_le_iff.mp (h ▸ hJP))
  have : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJtop
  have : IsLocalRing (R ⧸ J) := IsLocalRing.of_surjective' (Ideal.Quotient.mk J)
    Ideal.Quotient.mk_surjective
  have hMmax : ((maximalIdeal R).map (Ideal.Quotient.mk J)).IsMaximal :=
    isMaximal_map_quotientMk_of_le hJM
  have hPbarPrime : (P.map (Ideal.Quotient.mk J)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hJP)
  have hPM : P.map (Ideal.Quotient.mk J) ≤ (maximalIdeal R).map (Ideal.Quotient.mk J) :=
    Ideal.map_mono (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›))
  have hreg1 : IsRegularLocalRing ((R ⧸ J) ⧸ P.map (Ideal.Quotient.mk J)) := by
    have := hPreg
    exact IsRegularLocalRing.of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm
  have hreg2 : IsRegularLocalRing ((R ⧸ J) ⧸ (maximalIdeal R).map (Ideal.Quotient.mk J)) := by
    have : IsRegularLocalRing (R ⧸ maximalIdeal R) := by
      let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
      infer_instance
    exact IsRegularLocalRing.of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJM).symm
  exact ((isNormallyFlatAlongIdeal_iff_of_le (R ⧸ J) (P.map (Ideal.Quotient.mk J))
    ((maximalIdeal R).map (Ideal.Quotient.mk J)) hPM).mp hflat).2

end Bridge

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

private theorem isQuasiRegular_adaptedFamily (hA : F.IsAdapted P w) :
    IsQuasiRegular (adaptedFamily F w) :=
  (isQuasiRegular_iff_injective (maximalIdeal R) (adaptedFamily F w) (adaptedFamily_mem hA)
    hA.span_adapted).mpr (adaptedFamily_aeval_bijective hA).1

/-- The indices of `(z, w)` belonging to `P = (z, x)`: those `< r + s`. -/
private def adaptedZs (F : RegularFrame R) (s t : ℕ) : Finset (Fin (F.r + (s + t))) :=
  Finset.univ.filter fun i => (i : ℕ) < F.r + s

private theorem image_adaptedZs (w : Fin (s + t) → F.S) :
    adaptedFamily F w '' ↑(adaptedZs F s t) =
      Set.range F.z ∪ (algebraMap F.S R) '' Set.range (fun j : Fin s => w (Fin.castAdd t j)) := by
  ext v
  constructor
  · rintro ⟨i, hi, rfl⟩
    have hi' : (i : ℕ) < F.r + s := by simpa [adaptedZs] using hi
    induction i using Fin.addCases with
    | left a =>
      exact Or.inl ⟨a, (Fin.append_left _ _ a).symm⟩
    | right b =>
      right
      have hb : (b : ℕ) < s := by rw [Fin.val_natAdd] at hi'; omega
      refine ⟨w (Fin.castAdd t ⟨b, hb⟩), ⟨⟨b, hb⟩, rfl⟩, ?_⟩
      show algebraMap F.S R (w (Fin.castAdd t ⟨b, hb⟩)) = Fin.append F.z (algebraMap F.S R ∘ w)
        (Fin.natAdd F.r b)
      rw [Fin.append_right]
      simp only [Function.comp_apply]
      congr 2
  · rintro (⟨a, rfl⟩ | ⟨_, ⟨j, rfl⟩, rfl⟩)
    · refine ⟨Fin.castAdd (s + t) a, ?_, Fin.append_left _ _ a⟩
      have := a.2
      simp [adaptedZs]
      omega
    · refine ⟨Fin.natAdd F.r (Fin.castAdd t j), ?_, ?_⟩
      · have := j.2
        simp [adaptedZs]
      · show Fin.append F.z (algebraMap F.S R ∘ w) (Fin.natAdd F.r (Fin.castAdd t j)) = _
        rw [Fin.append_right]
        rfl

private theorem image_adaptedZs_compl (w : Fin (s + t) → F.S) :
    adaptedFamily F w '' ↑(adaptedZs F s t)ᶜ =
      (algebraMap F.S R) '' Set.range (fun l : Fin t => w (Fin.natAdd s l)) := by
  ext v
  constructor
  · rintro ⟨i, hi, rfl⟩
    have hi' : ¬ (i : ℕ) < F.r + s := by simpa [adaptedZs] using hi
    induction i using Fin.addCases with
    | left a =>
      have := a.2
      simp at hi'
      omega
    | right b =>
      have hb : ¬ (b : ℕ) < s := by rw [Fin.val_natAdd] at hi'; omega
      refine ⟨w (Fin.natAdd s ⟨(b : ℕ) - s, by omega⟩), ⟨⟨(b : ℕ) - s, by omega⟩, rfl⟩, ?_⟩
      show _ = Fin.append F.z (algebraMap F.S R ∘ w) (Fin.natAdd F.r b)
      rw [Fin.append_right]
      simp only [Function.comp_apply]
      congr 2
      exact Fin.ext (by simp; omega)
  · rintro ⟨_, ⟨l, rfl⟩, rfl⟩
    refine ⟨Fin.natAdd F.r (Fin.natAdd s l), ?_, ?_⟩
    · simp [adaptedZs]
    · show Fin.append F.z (algebraMap F.S R ∘ w) (Fin.natAdd F.r (Fin.natAdd s l)) = _
      rw [Fin.append_right]
      rfl

private theorem span_image_adaptedZs (hA : F.IsAdapted P w) :
    Ideal.span (adaptedFamily F w '' ↑(adaptedZs F s t)) = P := by
  rw [image_adaptedZs, Ideal.span_union, hA.eq_sup, xIdeal, Ideal.map_span]
  rfl

private theorem span_image_adaptedZs_compl :
    Ideal.span (adaptedFamily F w '' ↑(adaptedZs F s t)ᶜ) =
      Ideal.map (algebraMap F.S R) (yIdeal w) := by
  rw [image_adaptedZs_compl, yIdeal, Ideal.map_span]

end RegularFrame

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

private theorem maximalIdeal_eq_sup_adapted (hA : F.IsAdapted P w) :
    maximalIdeal R = P ⊔ Ideal.span (adaptedFamily F w '' ↑(adaptedZs F s t)ᶜ) := by
  rw [← span_image_adaptedZs hA, ← Ideal.span_union, ← Set.image_union,
    Finset.coe_compl, Set.union_compl_self, Set.image_univ]
  exact hA.span_adapted.symm

/-- `ν_P(g)` lower bound: the expansion coefficient of `g - h ∈ P^(μ+1)`. -/
private theorem expCoeff_sub (F : RegularFrame R) (a b : R) (B : Fin F.r →₀ ℕ) :
    F.expCoeff (a - b) B = F.expCoeff a B - F.expCoeff b B := by
  rw [← coeff_expansion, ← coeff_expansion, ← coeff_expansion, map_sub, map_sub]


end RegularFrame

section WeightedSplit

variable {k : Type u} [CommRing k] {σ : Type*}

/-- The ideal of polynomials all of whose monomials have `ω`-weight `≥ c`. -/
private def weightGEIdeal (ω : σ → ℕ) (c : ℕ∞) : Ideal (MvPolynomial σ k) where
  carrier := {p | ∀ d ∈ p.support, c ≤ (Finsupp.weight ω d : ℕ∞)}
  add_mem' := by
    classical
    intro p q hp hq d hd
    rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with h | h
    · exact hp d h
    · exact hq d h
  zero_mem' := fun d hd => by simp at hd
  smul_mem' := by
    classical
    intro q p hp d hd
    obtain ⟨d1, -, d2, hd2, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul q p hd)
    refine (hp d2 hd2).trans ?_
    rw [map_add]
    exact_mod_cast Nat.le_add_left _ _

attribute [local instance] MvPolynomial.weightedGradedAlgebra in
private theorem mem_span_low_of_isWeightedHomogeneous (ω : σ → ℕ) {m : ℕ}
    (ψ : Fin m → MvPolynomial σ k)
    (δ : Fin m → ℕ) (hψ : ∀ l, IsWeightedHomogeneous ω (ψ l) (δ l)) (c : ℕ∞)
    {p : MvPolynomial σ k} (hp : p ∈ Ideal.span (Set.range ψ)) {μ : ℕ} (hμ : (μ : ℕ∞) < c)
    (hpw : IsWeightedHomogeneous ω p μ) :
    p ∈ Ideal.span {q | ∃ l, (δ l : ℕ∞) < c ∧ ψ l = q} := by
  classical
  set G1 : Ideal (MvPolynomial σ k) := Ideal.span {q | ∃ l, (δ l : ℕ∞) < c ∧ ψ l = q} with hG1
  set G2 : Ideal (MvPolynomial σ k) := Ideal.span {q | ∃ l, ¬ (δ l : ℕ∞) < c ∧ ψ l = q} with hG2
  have hsplit : Ideal.span (Set.range ψ) = G1 ⊔ G2 := by
    rw [hG1, hG2, ← Ideal.span_union]
    congr 1
    ext q
    constructor
    · rintro ⟨l, rfl⟩
      by_cases h : (δ l : ℕ∞) < c
      · exact Or.inl ⟨l, h, rfl⟩
      · exact Or.inr ⟨l, h, rfl⟩
    · rintro (⟨l, -, rfl⟩ | ⟨l, -, rfl⟩) <;> exact ⟨l, rfl⟩
  rw [hsplit] at hp
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hp
  have hG1hom : G1.IsHomogeneous (weightedHomogeneousSubmodule k ω) := by
    refine Ideal.homogeneous_span _ _ ?_
    rintro _ ⟨l, -, rfl⟩
    exact ⟨δ l, hψ l⟩
  have hG2le : G2 ≤ weightGEIdeal ω c := by
    rw [hG2, Ideal.span_le]
    rintro _ ⟨l, hl, rfl⟩ d hd
    have := hψ l (mem_support_iff.mp hd)
    rw [this]
    exact not_lt.mp hl
  have hb' : weightedHomogeneousComponent ω μ b = 0 := by
    ext d
    rw [coeff_weightedHomogeneousComponent]
    split_ifs with hd
    · by_contra hne
      have := hG2le hb d (mem_support_iff.mpr fun h => hne (by rw [h]; rfl))
      rw [hd] at this
      exact absurd hμ (not_lt.mpr this)
    · rfl
  have hμa : weightedHomogeneousComponent ω μ (a + b) = a + b :=
    hpw.weightedHomogeneousComponent_same
  rw [map_add, hb', add_zero] at hμa
  rw [← hμa]
  exact weightedHomogeneousComponent_mem_of_mem k ω hG1hom ha μ

end WeightedSplit

private theorem span_range_fin_append {A : Type u} [CommRing A] {m n : ℕ} (a : Fin m → A)
    (b : Fin n → A) :
    Ideal.span (Set.range (Fin.append a b)) =
      Ideal.span (Set.range a) ⊔ Ideal.span (Set.range b) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨v, rfl⟩
    refine Fin.addCases (fun i => ?_) (fun j => ?_) v
    · rw [Fin.append_left]
      exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)
    · rw [Fin.append_right]
      exact Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)
  · refine sup_le (Ideal.span_mono ?_) (Ideal.span_mono ?_)
    · rintro _ ⟨i, rfl⟩
      exact ⟨Fin.castAdd _ i, Fin.append_left _ _ i⟩
    · rintro _ ⟨j, rfl⟩
      exact ⟨Fin.natAdd _ j, Fin.append_right _ _ j⟩

private theorem weight_zxWeight_mapDomain_castLE {r s t : ℕ} (e : Fin (r + s) →₀ ℕ) :
    Finsupp.weight (zxWeight r s t)
      (Finsupp.mapDomain (Fin.castLE (show r + s ≤ r + (s + t) by omega)) e) = e.degree := by
  rw [Finsupp.weight_apply, Finsupp.sum_mapDomain_index (by simp) (fun _ _ _ => add_smul _ _ _),
    Finsupp.degree_apply]
  refine Finset.sum_congr rfl fun a _ => ?_
  dsimp only
  have : zxWeight r s t (Fin.castLE (show r + s ≤ r + (s + t) by omega) a) = 1 := by
    simp only [zxWeight, Fin.val_castLE]
    exact ite_eq_left a.2
  rw [this, smul_eq_mul, mul_one]

namespace RegularFrame
variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {F : RegularFrame R} {P : Ideal R}
  {s t : ℕ} {w : Fin (s + t) → F.S}

/-- An element of `P^d` has a Y-free initial form: `Θ⁻¹ (in a)` lies in `k[Z, X]`. -/
private theorem exists_rename_form_of_mem_pow (hA : F.IsAdapted P w) {a : R} {d : ℕ}
    (ha : a ∈ P ^ d)
    (haM : a ∈ maximalIdeal R ^ d) :
    ∃ Ab : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R),
      Ab.IsHomogeneous d ∧
      adaptedEquiv hA (rename (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega)) Ab) =
        AssocGraded.mk (maximalIdeal R) d a haM := by
  classical
  set p' : Fin (F.r + s) → R :=
    Fin.append F.z (fun j : Fin s => algebraMap F.S R (w (Fin.castAdd t j))) with hp'
  have hP : P = Ideal.span (Set.range p') := by
    rw [hp', span_range_fin_append, hA.eq_sup, xIdeal, Ideal.map_span, ← Set.range_comp]
    rfl
  have hup : ∀ i, adaptedFamily F w
      (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega) i) = p' i := by
    intro i
    refine Fin.addCases (fun a => ?_) (fun b => ?_) i
    · have : Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega) (Fin.castAdd s a) =
          Fin.castAdd (s + t) a := Fin.ext rfl
      rw [this]
      simp [adaptedFamily, hp']
    · have : Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega) (Fin.natAdd F.r b) =
          Fin.natAdd F.r (Fin.castAdd t b) := Fin.ext rfl
      rw [this]
      simp [adaptedFamily, hp']
  have hp'M : ∀ i, p' i ∈ maximalIdeal R ^ 1 := fun i => by
    rw [← hup i]; exact adaptedFamily_mem hA _
  obtain ⟨A, hAh, hAe⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous p' a).mp (hP ▸ ha)
  refine ⟨A.map (Ideal.Quotient.mk (maximalIdeal R)), hAh.map _, ?_⟩
  rw [adaptedEquiv_apply, aeval_rename]
  have hfam : (fun i => AssocGraded.mk (maximalIdeal R) 1
        (adaptedFamily F w (Fin.castLE (show F.r + s ≤ F.r + (s + t) by omega) i))
        (adaptedFamily_mem hA _)) =
      fun i => AssocGraded.mk (maximalIdeal R) 1 (p' i) (hp'M i) := by
    funext i
    exact assocGraded_mk_congr _ rfl (hup i) _ _
  simp only [Function.comp_def]
  rw [hfam, aeval_mk_map_of_isHomogeneous (maximalIdeal R) p' hp'M hAh]
  exact assocGraded_mk_congr _ rfl hAe _ _

end RegularFrame

section LowDegree

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] {σ : Type*}

/-- Homogeneous components of degree `< ν^{(i+1)}(J)` of the polynomial counterpart of
`gr_M(J, R)` lie in the ideal generated by the polynomial counterparts of the initial forms
`φ_j` of the first `i` members of a standard base. -/
private theorem homogeneousComponent_mem_span_of_lt
    (Θ : MvPolynomial σ (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R))
    (hΘh : ∀ (d : ℕ) (p : MvPolynomial σ (R ⧸ maximalIdeal R)),
      p ∈ homogeneousSubmodule σ (R ⧸ maximalIdeal R) d ↔
        Θ p ∈ AssocGraded.homogeneous (maximalIdeal R) d)
    (J : Ideal R) {i : ℕ} (f : Fin i → R) (h1 : ExtendsToStandardBase J f)
    (d : ℕ) (hd : (d : ℕ∞) < nuI R J i.succPNat)
    (u : MvPolynomial σ (R ⧸ maximalIdeal R)) (hu : Θ u ∈ grIdeal (maximalIdeal R) J) :
    homogeneousComponent d u ∈
      Ideal.span (Set.range fun j : Fin i => Θ.symm (initialForm (maximalIdeal R) (f j))) := by
  classical
  obtain ⟨m, gs, him, hgs, hgsf⟩ := h1
  obtain ⟨hJ, ⟨dd, hdd, hmono⟩, hspan, hiii⟩ := hgs.2
  have hnu := nuI_eq_of_lemma1_properties R J _ hJ dd hdd hspan hmono hiii
  set Φ : Fin m → MvPolynomial σ (R ⧸ maximalIdeal R) :=
    fun l => Θ.symm (initialForm (maximalIdeal R) (gs l)) with hΦdef
  have hΦh : ∀ l, Φ l ∈ homogeneousSubmodule σ (R ⧸ maximalIdeal R) (dd l) :=
    fun l => (hΘh _ _).mpr (by rw [hΦdef, AlgEquiv.apply_symm_apply]; exact hdd l)
  have hΦI : ∀ l : Fin m, (l : ℕ) < i →
      Φ l ∈ Ideal.span
        (Set.range fun j : Fin i => Θ.symm (initialForm (maximalIdeal R) (f j))) := by
    intro l hl
    have hgl : gs l = f ⟨l, hl⟩ := by
      have h := hgsf ⟨l, hl⟩
      rw [← h]
      congr 1
    rw [hΦdef]
    dsimp only
    rw [hgl]
    exact Ideal.subset_span ⟨⟨l, hl⟩, rfl⟩
  have hΦdeg : ∀ l : Fin m, i ≤ (l : ℕ) → nuI R J i.succPNat ≤ (dd l : ℕ∞) := by
    intro l hl
    have hi : i < m := lt_of_le_of_lt hl l.2
    have h0 : nuI R J i.succPNat = (dd ⟨i, hi⟩ : ℕ∞) := by
      have := hnu.1 ⟨i, hi⟩
      exact this
    rw [h0]
    exact_mod_cast hmono (Fin.le_iff_val_le_val.mpr (by simpa using hl))
  have hclaim : ∀ v ∈ Ideal.span (Set.range Φ), ∀ e : ℕ, (e : ℕ∞) < nuI R J i.succPNat →
      homogeneousComponent e v ∈ Ideal.span
        (Set.range fun j : Fin i => Θ.symm (initialForm (maximalIdeal R) (f j))) := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨l, rfl⟩ := hv
      intro e he
      rw [homogeneousComponent_of_mem (hΦh l)]
      split_ifs with hel
      · by_cases hl : (l : ℕ) < i
        · exact hΦI l hl
        · have := hΦdeg l (by omega)
          rw [← hel] at this
          exact absurd he (not_lt.mpr this)
      · exact zero_mem _
    | zero => intro e _; rw [map_zero]; exact zero_mem _
    | add v v' _ _ hv hv' =>
      intro e he
      rw [map_add]
      exact add_mem (hv e he) (hv' e he)
    | smul c v _ hv =>
      intro e he
      rw [smul_eq_mul]
      refine homogeneousComponent_mul_mem _ _ e fun a b hab => ?_
      refine Ideal.mul_mem_left _ _ (hv b (lt_of_le_of_lt ?_ he))
      exact_mod_cast (by omega : b ≤ e)
  have hu' : u ∈ Ideal.span (Set.range Φ) := by
    have key : ∀ v ∈ Ideal.span (Set.range fun l => initialForm (maximalIdeal R) (gs l)),
        Θ.symm v ∈ Ideal.span (Set.range Φ) := by
      intro v hv
      induction hv using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨l, rfl⟩ := hv
        exact Ideal.subset_span ⟨l, rfl⟩
      | zero => rw [map_zero]; exact zero_mem _
      | add v w _ _ hv hw => rw [map_add]; exact add_mem hv hw
      | smul c v _ hv => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hv
    have h := key (Θ u) (by rw [← hspan]; exact hu)
    rwa [AlgEquiv.symm_apply_apply] at h
  exact hclaim u hu' d hd

end LowDegree


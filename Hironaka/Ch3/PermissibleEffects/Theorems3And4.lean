theorem sum_inv_mul_sum_eq {S : Type*} [CommRing S] {n : ℕ} (A : Matrix (Fin n) (Fin n) S)
    (hA : IsUnit A.det) (z : Fin n → S) (k : Fin n) :
    z k = ∑ i, A⁻¹ k i * ∑ l, A i l * z l := by
  have h := congrFun (Matrix.mulVec_mulVec z A⁻¹ A) k
  rw [Matrix.nonsing_inv_mul A hA, Matrix.one_mulVec] at h
  rw [← h]
  simp [Matrix.mulVec, dotProduct]

/-- `span (range (coordFamily a b c)) ≤ I` iff all the entries lie in `I`. -/
theorem span_range_coordFamily_le_iff {B : Type*} [CommRing B] {r s : ℕ} (a : B) (b : Fin r → B)
    (c : Fin s → B) (I : Ideal B) :
    Ideal.span (Set.range (coordFamily a b c)) ≤ I ↔
      a ∈ I ∧ (∀ i, b i ∈ I) ∧ ∀ j, c j ∈ I := by
  rw [Ideal.span_le]
  constructor
  · intro h
    exact ⟨h ⟨none, rfl⟩, fun i => h ⟨some (Sum.inl i), rfl⟩, fun j => h ⟨some (Sum.inr j), rfl⟩⟩
  · rintro ⟨ha, hb, hc⟩ _ ⟨v, rfl⟩
    rcases v with _ | (i | j)
    · exact ha
    · exact hb i
    · exact hc j

theorem range_coordFamily {B : Type*} {r s : ℕ} (a : B) (b : Fin r → B) (c : Fin s → B) :
    Set.range (coordFamily a b c) = {a} ∪ Set.range b ∪ Set.range c := by
  ext w
  simp only [Set.mem_range, Set.mem_union, Set.mem_singleton_iff]
  constructor
  · rintro ⟨_ | (i | j), rfl⟩
    · exact Or.inl (Or.inl rfl)
    · exact Or.inl (Or.inr ⟨i, rfl⟩)
    · exact Or.inr ⟨j, rfl⟩
  · rintro ((rfl | ⟨i, rfl⟩) | ⟨j, rfl⟩)
    · exact ⟨none, rfl⟩
    · exact ⟨some (Sum.inl i), rfl⟩
    · exact ⟨some (Sum.inr j), rfl⟩

/-- The ideal generated by `x₀`, the new coordinates `A x + b x₀` and further elements `E` is the one
generated by `x₀`, `x` and `E` (`A` invertible). -/
theorem span_change_eq {S : Type*} [CommRing S] {n : ℕ} (A : Matrix (Fin n) (Fin n) S)
    (hA : IsUnit A.det) (b : Fin n → S) (x₀ : S) (x : Fin n → S) (E : Set S) :
    Ideal.span ({x₀} ∪ Set.range (fun i => ∑ k, A i k * x k + b i * x₀) ∪ E) =
      Ideal.span ({x₀} ∪ Set.range x ∪ E) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro w ((rfl | ⟨i, rfl⟩) | hw)
    · exact Ideal.subset_span (Or.inl (Or.inl rfl))
    · refine add_mem (sum_mem fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span
        (Or.inl (Or.inr ⟨k, rfl⟩)))) (Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl (Or.inl rfl))))
    · exact Ideal.subset_span (Or.inr hw)
  · rw [Ideal.span_le]
    rintro w ((rfl | ⟨k, rfl⟩) | hw)
    · exact Ideal.subset_span (Or.inl (Or.inl rfl))
    · rw [sum_inv_mul_sum_eq A hA x k]
      refine sum_mem fun i _ => Ideal.mul_mem_left _ _ ?_
      have : ∑ l, A i l * x l = (∑ l, A i l * x l + b i * x₀) - b i * x₀ := by ring
      rw [this]
      exact sub_mem (Ideal.subset_span (Or.inl (Or.inr ⟨i, rfl⟩)))
        (Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl (Or.inl rfl))))
    · exact Ideal.subset_span (Or.inr hw)

section Change

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P}

/-- **Linear change of coordinates** (p. 237: "applying a suitable linear transformation to
`(x₁, …, x_r)` with coefficients in `R`"), together with a change `x_i ↦ x_i + b_i x₀`, `b_i ∈ M`: if
`A` is an invertible matrix over `R` and `b_i ∈ M`, then `(x₀, A x + b x₀, y)` is again a system of
coordinates adapted to `T` (with `x_i/x₀` replaced by `A (x/x₀) + b`). -/
noncomputable def TransformCoord.change (C : TransformCoord T) (A : Matrix (Fin C.r) (Fin C.r) R)
    (hA : IsUnit A.det) (b : Fin C.r → R) (hb : ∀ i, b i ∈ maximalIdeal R) : TransformCoord T where
  r := C.r
  s := C.s
  x₀ := C.x₀
  x := fun i => ∑ k, A i k * C.x k + b i * C.x₀
  y := C.y
  x' := fun i => ∑ k, T.toRing (A i k) * C.x' k + T.toRing (b i)
  hx' := fun i => by
    rw [map_add, map_sum, mul_add, Finset.mul_sum]
    congr 1
    · refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, mul_left_comm, C.hx' k]
    · rw [map_mul, mul_comm]
  hP := by
    have h := span_change_eq A hA b C.x₀ C.x ∅
    simp only [Set.union_empty] at h
    rw [h]
    exact C.hP
  hM := by
    have h := span_change_eq A hA b C.x₀ C.x (Set.range C.y)
    rw [range_coordFamily, h, ← range_coordFamily]
    exact C.hM
  hdim := C.hdim
  hM₁ := by
    -- `T.toRing` maps `M` into any ideal of `R₁` containing `x₀` and the `y_j`
    have hTM : ∀ L : Ideal T.ring, T.toRing C.x₀ ∈ L → (∀ j, T.toRing (C.y j) ∈ L) →
        ∀ w ∈ maximalIdeal R, T.toRing w ∈ L := by
      intro L h0 hy w hw
      rw [← C.hM] at hw
      have : Ideal.span (Set.range (coordFamily C.x₀ C.x C.y)) ≤ L.comap T.toRing := by
        rw [span_range_coordFamily_le_iff]
        refine ⟨h0, fun k => ?_, fun j => hy j⟩
        show T.toRing (C.x k) ∈ L
        rw [← C.hx' k]
        exact Ideal.mul_mem_right _ _ h0
      exact this hw
    have hdetA : IsUnit (A.map T.toRing).det := by
      have : (A.map T.toRing).det = T.toRing A.det := (RingHom.map_det T.toRing A).symm
      rw [this]; exact hA.map _
    apply le_antisymm
    · rw [← C.hM₁, span_range_coordFamily_le_iff]
      refine ⟨Ideal.subset_span (Set.mem_range_self none), fun i => ?_,
        fun j => Ideal.subset_span (Set.mem_range_self (some (Sum.inr j)))⟩
      show ∑ k, T.toRing (A i k) * C.x' k + T.toRing (b i) ∈ _
      refine add_mem (sum_mem fun k _ => Ideal.mul_mem_left _ _
        (Ideal.subset_span (Set.mem_range_self (some (Sum.inl k))))) ?_
      exact hTM _ (Ideal.subset_span (Set.mem_range_self none))
        (fun j => Ideal.subset_span (Set.mem_range_self (some (Sum.inr j)))) _ (hb i)
    · rw [← C.hM₁, span_range_coordFamily_le_iff]
      have h0 : T.toRing C.x₀ ∈ Ideal.span (Set.range (coordFamily (T.toRing C.x₀)
          (fun i => ∑ k, T.toRing (A i k) * C.x' k + T.toRing (b i)) fun j => T.toRing (C.y j))) :=
        Ideal.subset_span (Set.mem_range_self none)
      have hy : ∀ j, T.toRing (C.y j) ∈ Ideal.span (Set.range (coordFamily (T.toRing C.x₀)
          (fun i => ∑ k, T.toRing (A i k) * C.x' k + T.toRing (b i)) fun j => T.toRing (C.y j))) :=
        fun j => Ideal.subset_span (Set.mem_range_self (some (Sum.inr j)))
      refine ⟨h0, fun k => ?_, hy⟩
      rw [sum_inv_mul_sum_eq (A.map T.toRing) hdetA C.x' k]
      refine sum_mem fun i _ => Ideal.mul_mem_left _ _ ?_
      have : ∑ l, (A.map T.toRing) i l * C.x' l = (∑ l, T.toRing (A i l) * C.x' l + T.toRing (b i)) -
          T.toRing (b i) := by simp
      rw [this]
      exact sub_mem (Ideal.subset_span (Set.mem_range_self (some (Sum.inl i))))
        (hTM _ h0 hy _ (hb i))
  hdim₁ := C.hdim₁

end Change

/-- A square matrix over a local ring whose first `c` rows are prescribed rows with linearly
independent reductions modulo the maximal ideal, and whose determinant is a unit. -/
theorem exists_matrix_isUnit_det_of_rows {R : Type u} [CommRing R] [IsLocalRing R] {n c : ℕ}
    (hc : c ≤ n) (v : Fin c → Fin n → R)
    (hv : LinearIndependent (R ⧸ maximalIdeal R)
      fun i => fun k => Ideal.Quotient.mk (maximalIdeal R) (v i k)) :
    ∃ A : Matrix (Fin n) (Fin n) R, IsUnit A.det ∧ ∀ (i : Fin n) (h : (i : ℕ) < c), A i = v ⟨i, h⟩ := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let b := Module.Basis.sumExtend hv
  have hfin : Finite (Fin c ⊕ Module.Basis.sumExtendIndex hv) := Module.Finite.finite_basis b
  have hfin' : Finite (Module.Basis.sumExtendIndex hv) := Finite.of_injective (Sum.inr : Module.Basis.sumExtendIndex hv → Fin c ⊕ _)
    Sum.inr_injective
  let _ : Fintype (Module.Basis.sumExtendIndex hv) := Fintype.ofFinite _
  have hcard : c + Fintype.card (Module.Basis.sumExtendIndex hv) = n := by
    have := Module.finrank_eq_card_basis b
    simpa [Module.finrank_fin_fun] using this.symm
  let S : Set (Fin n) := Set.range (Fin.castLE hc)
  have hinj : Function.Injective (Fin.castLE hc) := Fin.castLE_injective hc
  have hS : Fintype.card S = c := by
    have h := (Fintype.card_congr (Equiv.ofInjective _ hinj)).symm
    rw [Fintype.card_fin] at h
    convert h
  have hSc : Fintype.card (Module.Basis.sumExtendIndex hv) = Fintype.card (↥Sᶜ) := by
    rw [Fintype.card_compl_set, hS, Fintype.card_fin]
    omega
  let e : Fin c ⊕ Module.Basis.sumExtendIndex hv ≃ Fin n :=
    (Equiv.sumCongr (Equiv.ofInjective _ hinj) (Fintype.equivOfCardEq hSc)).trans
      (Equiv.Set.sumCompl S)
  have he : ∀ i, e (Sum.inl i) = Fin.castLE hc i := fun i => by simp [e]
  let w : Fin n → (Fin n → R ⧸ maximalIdeal R) := fun j => b (e.symm j)
  have hw : LinearIndependent (R ⧸ maximalIdeal R) w :=
    b.linearIndependent.comp _ e.symm.injective
  have hwv : ∀ (i : Fin n) (h : (i : ℕ) < c), w i = fun k => Ideal.Quotient.mk (maximalIdeal R)
      (v ⟨i, h⟩ k) := by
    intro i h
    have : e.symm i = Sum.inl ⟨i, h⟩ := by
      rw [Equiv.symm_apply_eq, he]; rfl
    simp only [w, this, b, sumExtend_inl_apply]
  let A : Matrix (Fin n) (Fin n) R := fun i k =>
    if h : (i : ℕ) < c then v ⟨i, h⟩ k else
      Classical.choose (Ideal.Quotient.mk_surjective (w i k))
  have hmap : (Ideal.Quotient.mk (maximalIdeal R)).mapMatrix A = Matrix.of w := by
    ext i k
    change Ideal.Quotient.mk (maximalIdeal R) (A i k) = w i k
    by_cases h : (i : ℕ) < c
    · simp only [A, h, dite_true]
      rw [hwv i h]
    · simp only [A, h, dite_false]
      exact Classical.choose_spec (Ideal.Quotient.mk_surjective (w i k))
  have hunit : IsUnit (Matrix.of w) := Matrix.linearIndependent_rows_iff_isUnit.1 hw
  refine ⟨A, ?_, fun i h => ?_⟩
  · have h1 : IsUnit (Ideal.Quotient.mk (maximalIdeal R) A.det) := by
      rw [RingHom.map_det, hmap]
      exact (Matrix.isUnit_iff_isUnit_det _).1 hunit
    rw [← IsLocalRing.notMem_maximalIdeal, ← Ideal.Quotient.eq_zero_iff_mem]
    exact h1.ne_zero
  · ext k
    simp [A, h]

section Adapt

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P}

/-- An element of `P = (x₀, x₁, …, x_r)R` is `a₀ x₀ + Σ a_k x_k`. -/
theorem TransformCoord.exists_coeffs_of_mem (C : TransformCoord T) {q : R} (hq : q ∈ P) :
    ∃ (a₀ : R) (a : Fin C.r → R), q = a₀ * C.x₀ + ∑ k, a k * C.x k := by
  rw [C.hP, Ideal.span_union, Submodule.mem_sup] at hq
  obtain ⟨p, hp, q', hq', rfl⟩ := hq
  obtain ⟨a₀, rfl⟩ := Ideal.mem_span_singleton'.mp hp
  obtain ⟨a, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hq'
  exact ⟨a₀, a, rfl⟩

end Adapt

section Adapt2

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P}

/-- **Coordinates (1)–(3) of the proof of Proposition 1, p. 237** ("by the assumptions on `P`, `Q` and
`Q₁` we have a regular system of parameters `(x, x₁, …, x_r, y₁, …, y_s)` of `R` such that (1)
`P = (x, x₁, …, x_r)R`, (2) `Q ⊆ (x₁, …, x_r)R`, and (3) `(x, x₁/x, …, x_r/x, y₁, …, y_s)` is a regular
system of parameters of `R₁`"): starting from any coordinates `C` adapted to `T`, a change
`x_i ↦ Σ A_{ik} x_k + b_i x` (`A` invertible, `b_i ∈ M`) gives coordinates with `Q ⊆ (x₁, …, x_r)R`. -/
theorem TransformCoord.exists_change_of_prime [IsRegularLocalRing T.ring]
    (C : TransformCoord T) (Q : Ideal R) [Q.IsPrime] (hQP : Q ≤ P)
    (hQ : IsRegularLocalRing (R ⧸ Q)) (Q₁ : Ideal T.ring) [Q₁.IsPrime]
    (hQQ₁ : Q.map T.toRing ≤ Q₁) (hPQ₁ : ¬ P.map T.toRing ≤ Q₁) :
    ∃ (A : Matrix (Fin C.r) (Fin C.r) R) (hA : IsUnit A.det) (b : Fin C.r → R)
      (hb : ∀ i, b i ∈ maximalIdeal R), Q ≤ Ideal.span (Set.range (C.change A hA b hb).x) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨S₀, TQ, hS₀M, hS₀card, hTS, hTQ⟩ := exists_finset_span_eq_prime R Q hQ
  have hS₀ : IsRegularSystemOfParameters R S₀ := rsop_of_span_of_card_le hS₀M hS₀card.le
  have hx₁Q₁ : C.x₁ ∉ Q₁ := by
    intro hx
    apply hPQ₁
    rw [← C.span_x₁, Ideal.span_le, Set.singleton_subset_iff]
    exact hx
  set c := TQ.card with hc
  let q : Fin c → R := fun i => (TQ.equivFin.symm i : R)
  have hqTQ : ∀ i, q i ∈ TQ := fun i => (TQ.equivFin.symm i).2
  have hqQ : ∀ i, q i ∈ Q := fun i => hTQ ▸ Ideal.subset_span (hqTQ i)
  choose a₀ a hqa using fun i => C.exists_coeffs_of_mem (hQP (hqQ i))
  -- `a₀ ∈ M`
  have hx'M : ∀ k, C.x' k ∈ maximalIdeal T.ring := fun k => by
    rw [← C.hM₁]; exact Ideal.subset_span ⟨some (Sum.inl k), rfl⟩
  have ha₀ : ∀ i, a₀ i ∈ maximalIdeal R := by
    intro i
    set u : T.ring := T.toRing (a₀ i) + ∑ k, T.toRing (a i k) * C.x' k with hu
    have hxu : C.x₁ * u = T.toRing (q i) := by
      rw [hqa i, map_add, map_sum, hu, mul_add, Finset.mul_sum]
      congr 1
      · rw [map_mul, mul_comm]; rfl
      · refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul, mul_left_comm, show C.x₁ = T.toRing C.x₀ from rfl, C.hx' k]
    have huM : u ∈ maximalIdeal T.ring := by
      by_contra hq
      have hunit : IsUnit u := IsLocalRing.notMem_maximalIdeal.mp hq
      apply hx₁Q₁
      have : C.x₁ = T.toRing (q i) * ↑(hunit.unit⁻¹) := by
        rw [← hxu, mul_assoc, IsUnit.mul_val_inv, mul_one]
      rw [this]
      exact Ideal.mul_mem_right _ _ (hQQ₁ (Ideal.mem_map_of_mem _ (hqQ i)))
    have hTa : T.toRing (a₀ i) ∈ maximalIdeal T.ring := by
      have : T.toRing (a₀ i) = u - ∑ k, T.toRing (a i k) * C.x' k := by rw [hu]; ring
      rw [this]
      exact sub_mem huM (sum_mem fun k _ => Ideal.mul_mem_left _ _ (hx'M k))
    by_contra hni
    exact IsLocalRing.notMem_maximalIdeal.mpr ((IsLocalRing.notMem_maximalIdeal.mp hni).map T.toRing) hTa
  -- the classes of the `q i` in `gr¹_M(R)` and their expansion in the classes of the `x_k`
  have hqM : ∀ i, q i ∈ maximalIdeal R ^ 1 := fun i => by
    rw [pow_one, ← hS₀M]; exact Ideal.subset_span (hTS (hqTQ i))
  have hxM : ∀ k, C.x k ∈ maximalIdeal R ^ 1 := fun k => by
    rw [pow_one]; have := C.z_mem (some (Sum.inl k)); rwa [pow_one] at this
  have hcls : ∀ i, AssocGraded.mk (maximalIdeal R) 1 (q i) (hqM i) =
      ∑ k, Ideal.Quotient.mk (maximalIdeal R) (a i k) •
        AssocGraded.mk (maximalIdeal R) 1 (C.x k) (hxM k) := by
    intro i
    have hsum : ∑ k, a i k * C.x k ∈ maximalIdeal R ^ 1 :=
      sum_mem fun k _ => Ideal.mul_mem_left _ _ (hxM k)
    have hx₀M : C.x₀ ∈ maximalIdeal R := by
      have := C.z_mem none; rwa [pow_one] at this
    have hd : q i - ∑ k, a i k * C.x k ∈ maximalIdeal R ^ (1 + 1) := by
      rw [hqa i, add_sub_cancel_right, pow_two]
      exact Ideal.mul_mem_mul (ha₀ i) hx₀M
    rw [AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ 1 (hqM i) hsum hd,
      AssocGraded.mk_sum _ 1 _ _ (fun k => Ideal.mul_mem_left _ _ (hxM k))]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [AssocGraded.smul_mk]
  have hrows : LinearIndependent (R ⧸ maximalIdeal R)
      fun i : Fin c => fun k : Fin C.r => Ideal.Quotient.mk (maximalIdeal R) (a i k) := by
    have hqli : LinearIndependent (R ⧸ maximalIdeal R) fun i : Fin c =>
        AssocGraded.mk (maximalIdeal R) 1 (q i) (hqM i) := by
      have h1 := (linearIndependent_mk_of_isRegularSystemOfParameters hS₀).comp
        (fun i : Fin c => (⟨q i, hTS (hqTQ i)⟩ : S₀)) (fun i j hij => by
          have := congrArg Subtype.val hij
          exact TQ.equivFin.symm.injective (Subtype.ext this))
      exact h1
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have hk : ∀ k, ∑ i, g i * Ideal.Quotient.mk (maximalIdeal R) (a i k) = 0 := fun k => by
      simpa using congrFun hg k
    have h2 : ∑ i, g i • AssocGraded.mk (maximalIdeal R) 1 (q i) (hqM i) = 0 := by
      simp_rw [hcls, Finset.smul_sum, smul_smul]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero fun k _ => ?_
      rw [← Finset.sum_smul, hk k, zero_smul]
    exact Fintype.linearIndependent_iff.mp hqli g h2 i
  have hcr : c ≤ C.r := by
    have := hrows.fintype_card_le_finrank
    simpa using this
  obtain ⟨A, hA, hAr⟩ := exists_matrix_isUnit_det_of_rows hcr a hrows
  let b : Fin C.r → R := fun i => if h : (i : ℕ) < c then a₀ ⟨i, h⟩ else 0
  have hb : ∀ i, b i ∈ maximalIdeal R := fun i => by
    by_cases h : (i : ℕ) < c
    · simp only [b, h, dite_true]; exact ha₀ _
    · simp only [b, h, dite_false]; exact zero_mem _
  refine ⟨A, hA, b, hb, ?_⟩
  rw [← hTQ, Ideal.span_le]
  intro w hw
  set i : Fin c := TQ.equivFin ⟨w, hw⟩ with hi
  have hqi : q i = w := by simp [q, hi]
  have hic : (i : ℕ) < c := i.2
  have hidx : (i : ℕ) < C.r := lt_of_lt_of_le i.2 hcr
  have hrow : A ⟨i, hidx⟩ = a i := by rw [hAr ⟨i, hidx⟩ hic]
  have hbi : b ⟨i, hidx⟩ = a₀ i := by simp [b, hic]
  refine Ideal.subset_span ⟨⟨i, hidx⟩, ?_⟩
  show ∑ k, A ⟨i, hidx⟩ k * C.x k + b ⟨i, hidx⟩ * C.x₀ = w
  rw [hrow, hbi, ← hqi, hqa i]
  ring

end Adapt2

section Q1Side

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

theorem TransformCoord.linearIndependent_mk_z₁ (C : TransformCoord T) :
    LinearIndependent (T.ring ⧸ maximalIdeal T.ring) fun v : CoordIndex C.r C.s =>
      AssocGraded.mk (maximalIdeal T.ring) 1 (C.z₁ v) (C.z₁_mem v) := by
  have h1 := (MvPolynomial.linearIndependent_X (R := T.ring ⧸ maximalIdeal T.ring)
    (σ := CoordIndex C.r C.s)).map' C.e₁.toLinearMap (LinearMap.ker_eq_bot.mpr C.e₁_bijective.1)
  convert h1 using 1
  funext v
  simp [TransformCoord.e₁]

theorem TransformCoord.z₁_injective (C : TransformCoord T) : Function.Injective C.z₁ := by
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  intro v w h
  refine C.linearIndependent_mk_z₁.injective ?_
  exact AssocGraded.mk_congr _ _ h

open scoped Classical in
theorem TransformCoord.extendsToRSOP₁ (C : TransformCoord T) :
    ExtendsToRSOP T.ring (Finset.univ.image C.z₁) := by
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  have := extendsToRSOP_of_linearIndependent
    (fun v : CoordIndex C.r C.s => (⟨C.z₁ v, by simpa using C.z₁_mem v⟩ : maximalIdeal T.ring))
    (by convert C.linearIndependent_mk_z₁ using 1)
  simpa using this

/-- `(x₁/x, …, x_r/x)R₁` is a prime ideal of `R₁` (part (3) of the coordinates, p. 237), not containing
any power of `x`. -/
theorem TransformCoord.isPrime_span_x' (C : TransformCoord T) :
    (Ideal.span (Set.range C.x')).IsPrime ∧ ∀ n, C.x₁ ^ n ∉ Ideal.span (Set.range C.x') := by
  classical
  have hK : (Finset.univ.image C.x') ⊆ Finset.univ.image C.z₁ := by
    intro y hy
    obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hy
    exact Finset.mem_image.mpr ⟨some (Sum.inl k), Finset.mem_univ _, rfl⟩
  have hprime : (Ideal.span (Set.range C.x')).IsPrime := by
    have := (ExtendsToRSOP.mono C.extendsToRSOP₁ hK).isPrime_span
    rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ] at this
  have hx₁U : C.x₁ ∉ Ideal.span (Set.range C.x') := by
    obtain ⟨Z, hKZ, hZ⟩ := C.extendsToRSOP₁
    have hx₁Z : C.x₁ ∈ Z := hKZ (Finset.mem_image.mpr ⟨none, Finset.mem_univ _, rfl⟩)
    have hnot : C.x₁ ∉ Finset.univ.image C.x' := by
      intro hmem
      obtain ⟨k, -, hk⟩ := Finset.mem_image.mp hmem
      have := C.z₁_injective (a₁ := none) (a₂ := some (Sum.inl k)) hk.symm
      cases this
    have := rsop_notMem_span hZ (hK.trans hKZ) hx₁Z hnot
    rwa [Finset.coe_image, Finset.coe_univ, Set.image_univ] at this
  refine ⟨hprime, fun n => ?_⟩
  induction n with
  | zero => rw [pow_zero]; exact fun h => hprime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  | succ n ih =>
    rw [pow_succ]
    intro hmem
    rcases hprime.mem_or_mem hmem with h1 | h1
    · exact ih h1
    · exact hx₁U h1

/-- Part (3) of the coordinates, p. 237: `Q₁ ⊆ (x₁/x, …, x_r/x)R₁` when `Q ⊆ (x₁, …, x_r)R` and `Q₁` lies in
the strict transform of `Q` (which holds if `Q₁ ∩ R = Q`, Corollary to Lemma 5). -/
theorem TransformCoord.le_span_x'_of_le_strictTransform (C : TransformCoord T) (Q : Ideal R)
    (hQx : Q ≤ Ideal.span (Set.range C.x)) (Q₁ : Ideal T.ring)
    (hQ₁s : Q₁ ≤ strictTransformIdeal T Q) : Q₁ ≤ Ideal.span (Set.range C.x') := by
  obtain ⟨hUprime, hx₁pow⟩ := C.isPrime_span_x'
  set U := Ideal.span (Set.range C.x') with hU
  have hx₁U : C.x₁ ∉ U := by simpa using hx₁pow 1
  have hx₁0 : C.x₁ ≠ 0 := fun h0 => hx₁U (h0 ▸ zero_mem _)
  refine hQ₁s.trans (Ideal.span_le.mpr ?_)
  rintro y ⟨x, hx, f', hf', ν, -, hxy⟩
  rw [← C.span_x₁] at hx
  obtain ⟨v, hv⟩ := Ideal.span_singleton_eq_span_singleton.mp hx
  have hf'U : T.toRing f' ∈ Ideal.span {C.x₁} * U := by
    have h1 := Ideal.mem_map_of_mem T.toRing (hQx hf')
    rw [Ideal.map_span] at h1
    refine (Ideal.span_le.mpr ?_) h1
    rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
    rw [← C.hx' k]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) (Ideal.subset_span ⟨k, rfl⟩)
  obtain ⟨w, hw, hxw⟩ := Ideal.mem_span_singleton_mul.mp hf'U
  have hxx : x = C.x₁ * ↑v⁻¹ := by rw [← hv, mul_assoc, Units.mul_inv, mul_one]
  set y' := (↑v⁻¹ : T.ring) ^ ν * y with hy'
  have hy'eq : C.x₁ ^ ν * y' = C.x₁ * w := by
    rw [hxw, ← hxy, hxx, hy', mul_pow]
    ring
  have hy'U : y' ∈ U := by
    rcases ν with _ | n
    · rw [pow_zero, one_mul] at hy'eq
      rw [hy'eq]
      exact Ideal.mul_mem_left _ _ hw
    · have h1 : C.x₁ * (C.x₁ ^ n * y' - w) = 0 := by
        rw [mul_sub, ← mul_assoc, ← pow_succ', hy'eq, sub_self]
      have h2 : C.x₁ ^ n * y' = w := sub_eq_zero.mp
        ((mul_eq_zero.mp h1).resolve_left hx₁0)
      rcases hUprime.mem_or_mem (h2 ▸ hw) with h3 | h3
      · exact absurd h3 (hx₁pow n)
      · exact h3
  have : y = (↑v : T.ring) ^ ν * y' := by
    rw [hy', ← mul_assoc, ← mul_pow, Units.mul_inv, one_pow, one_mul]
  rw [this]
  exact Ideal.mul_mem_left _ _ hy'U

end Q1Side

/-- The class in `gr_I(A)` of a difference `x - Σ tᵢ` of elements of `Iⁿ` is the difference of the
classes. -/
theorem AssocGraded.mk_sub_sum {A : Type*} [CommRing A] (I : Ideal A) {n : ℕ} {x : A}
    (hx : x ∈ I ^ n) {ι : Type*} (s : Finset ι) (t : ι → A) (ht : ∀ i, t i ∈ I ^ n)
    (h : x - ∑ i ∈ s, t i ∈ I ^ n) :
    AssocGraded.mk I n (x - ∑ i ∈ s, t i) h =
      AssocGraded.mk I n x hx - ∑ i ∈ s, AssocGraded.mk I n (t i) (ht i) := by
  have e : (⟨x - ∑ i ∈ s, t i, h⟩ : ↥(I ^ n)) = ⟨x, hx⟩ - ∑ i ∈ s, ⟨t i, ht i⟩ :=
    Subtype.ext (by simp)
  have := congrArg (AssocGraded.mkLinear I n) e
  simpa [map_sub, map_sum, AssocGraded.mkLinear_apply] using this

/-- The class of `a Xⁿ` only depends on the exponent up to equality. -/
theorem AssocGraded.mk_congr_exponent {A : Type*} [CommRing A] (I : Ideal A) {n n' : ℕ}
    (h : n = n') {a : A} (ha : a ∈ I ^ n) (ha' : a ∈ I ^ n') :
    AssocGraded.mk I n a ha = AssocGraded.mk I n' a ha' := by
  subst h; rfl

/-- `[ab Xⁿ] = [a Xᵖ] [b X^q]` when `p + q = n`. -/
theorem AssocGraded.mk_mul_of_add_eq {A : Type*} [CommRing A] (I : Ideal A) {p q n : ℕ}
    (hpq : p + q = n) {a b : A} (ha : a ∈ I ^ p) (hb : b ∈ I ^ q) (hab : a * b ∈ I ^ n) :
    AssocGraded.mk I n (a * b) hab = AssocGraded.mk I p a ha * AssocGraded.mk I q b hb := by
  subst hpq; exact (AssocGraded.mk_mul_mk I ha hb).symm

/-- The class of `a Xⁿ` lies in the homogeneous part of degree `n'` when `n = n'`. -/
theorem AssocGraded.mk_mem_homogeneous_of_eq {A : Type*} [CommRing A] (I : Ideal A) {n n' : ℕ}
    (h : n = n') {a : A} (ha : a ∈ I ^ n) : AssocGraded.mk I n a ha ∈ AssocGraded.homogeneous I n' := by
  subst h; exact AssocGraded.mk_mem_homogeneous I ha

/-- Replacing one element `f_j` of a standard base by `f_j - Σ a_i f_i`, where the sum runs over
`i < j` with `ν_i < ν_j` and `a_i ∈ M^{ν_j - ν_i}`, gives again a standard base, of the same orders; the
initial form of the new element is `φ_j - Σ [a_i] φ_i`, `[a_i]` the class of `a_i` in `gr^{ν_j - ν_i}`. -/
theorem IsStandardBase.update_sub {S : Type u} [CommRing S] [IsRegularLocalRing S] {J : Ideal S}
    {m : ℕ} {f : Fin m → S} (hf : IsStandardBase S J f) (ν : Fin m → ℕ)
    (hν : ∀ i, Ideal.ordElem (maximalIdeal S) (f i) = ν i) (j : Fin m) (a : Fin m → S)
    (ha0 : ∀ i, ¬ (i < j ∧ ν i < ν j) → a i = 0)
    (ha : ∀ i, a i ∈ maximalIdeal S ^ (ν j - ν i)) :
    IsStandardBase S J (Function.update f j (f j - ∑ i, a i * f i)) ∧
    Ideal.ordElem (maximalIdeal S) (f j - ∑ i, a i * f i) = ν j ∧
    initialForm (maximalIdeal S) (f j - ∑ i, a i * f i) =
      initialForm (maximalIdeal S) (f j) -
        ∑ i, AssocGraded.mk (maximalIdeal S) (ν j - ν i) (a i) (ha i) *
          initialForm (maximalIdeal S) (f i) := by
  have hf0 := hf
  obtain ⟨hfJ, hφJ, ⟨d, hd, hmono⟩, hspan, hirr⟩ := hf
  have hdν : ∀ i, (ν i : ℕ∞) = d i := fun i => (hν i).symm.trans
    (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J f hf0 d hd i)
  have hdν' : ∀ i, ν i = d i := fun i => by exact_mod_cast hdν i
  have hfM : ∀ i, f i ∈ maximalIdeal S ^ ν i := fun i => Ideal.mem_pow_of_ordElem (hν i)
  have hterm : ∀ i, a i * f i ∈ maximalIdeal S ^ ν j := by
    intro i
    by_cases hc : i < j ∧ ν i < ν j
    · have h := Ideal.mul_mem_mul (ha i) (hfM i)
      rw [← pow_add, Nat.sub_add_cancel hc.2.le] at h
      exact h
    · rw [ha0 i hc, zero_mul]; exact zero_mem _
  have hf'M : f j - ∑ i, a i * f i ∈ maximalIdeal S ^ ν j :=
    sub_mem (hfM j) (sum_mem fun i _ => hterm i)
  have hcls : ∀ i, AssocGraded.mk (maximalIdeal S) (ν j) (a i * f i) (hterm i) =
      AssocGraded.mk (maximalIdeal S) (ν j - ν i) (a i) (ha i) *
        initialForm (maximalIdeal S) (f i) := by
    intro i
    by_cases hc : i < j ∧ ν i < ν j
    · rw [initialForm_eq_mk _ (hν i)]
      exact AssocGraded.mk_mul_of_add_eq _ (Nat.sub_add_cancel hc.2.le) _ _ _
    · have h1 : AssocGraded.mk (maximalIdeal S) (ν j) (a i * f i) (hterm i) = 0 := by
        rw [AssocGraded.mk_eq_zero_iff, ha0 i hc, zero_mul]; exact zero_mem _
      have h2 : AssocGraded.mk (maximalIdeal S) (ν j - ν i) (a i) (ha i) = 0 := by
        rw [AssocGraded.mk_eq_zero_iff, ha0 i hc]; exact zero_mem _
      rw [h1, h2, zero_mul]
  set T : AssocGraded (maximalIdeal S) := ∑ i, AssocGraded.mk (maximalIdeal S) (ν j - ν i) (a i) (ha i) *
    initialForm (maximalIdeal S) (f i) with hT
  set χ : AssocGraded (maximalIdeal S) :=
    AssocGraded.mk (maximalIdeal S) (ν j) (f j - ∑ i, a i * f i) hf'M with hχdef
  have hχ : χ = initialForm (maximalIdeal S) (f j) - T := by
    rw [hχdef, AssocGraded.mk_sub_sum _ (hfM j) Finset.univ (fun i => a i * f i) hterm hf'M,
      initialForm_eq_mk _ (hν j)]
    congr 1
    exact Finset.sum_congr rfl fun i _ => hcls i
  -- the span of the previous initial forms
  set P : Fin m → Ideal (AssocGraded (maximalIdeal S)) := fun i =>
    Ideal.span ((fun k => initialForm (maximalIdeal S) (f k)) '' {k | k < i}) with hP
  have hirr' : ∀ i, initialForm (maximalIdeal S) (f i) ∉ P i := by
    intro i h
    refine hirr i (Ideal.span_mono ?_ h)
    rintro _ ⟨k, hk, rfl⟩
    exact ⟨⟨k, hk⟩, congrArg (fun x => initialForm (maximalIdeal S) (f x)) (Fin.ext rfl)⟩
  have hTP : T ∈ P j := by
    refine sum_mem fun i _ => ?_
    by_cases hc : i < j ∧ ν i < ν j
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, hc.1, rfl⟩)
    · have h2 : AssocGraded.mk (maximalIdeal S) (ν j - ν i) (a i) (ha i) = 0 := by
        rw [AssocGraded.mk_eq_zero_iff, ha0 i hc]; exact zero_mem _
      rw [h2, zero_mul]; exact zero_mem _
  have hPmono : ∀ {i i' : Fin m}, i ≤ i' → P i ≤ P i' := by
    intro i i' h
    refine Ideal.span_mono (Set.image_mono fun k hk => ?_)
    exact lt_of_lt_of_le hk h
  have hφj : initialForm (maximalIdeal S) (f j) = χ + T := by rw [hχ]; ring
  have hχP : χ ∉ P j := by
    intro h
    exact hirr' j (by rw [hφj]; exact add_mem h hTP)
  have hnz : χ ≠ 0 := fun h => hχP (by rw [h]; exact zero_mem _)
  have hord : Ideal.ordElem (maximalIdeal S) (f j - ∑ i, a i * f i) = ν j := by
    refine le_antisymm (Ideal.ordElem_le_of_notMem fun h => hnz ?_) (Ideal.le_ordElem hf'M)
    exact (AssocGraded.mk_eq_zero_iff _ hf'M).mpr h
  have hinit : initialForm (maximalIdeal S) (f j - ∑ i, a i * f i) = χ :=
    initialForm_eq_mk _ hord
  refine ⟨?_, hord, hinit.trans hχ⟩
  -- the standard base property
  have hψj : initialForm (maximalIdeal S) (Function.update f j (f j - ∑ i, a i * f i) j) = χ := by
    rw [Function.update_self]; exact hinit
  have hψne : ∀ i, i ≠ j → initialForm (maximalIdeal S)
      (Function.update f j (f j - ∑ i, a i * f i) i) = initialForm (maximalIdeal S) (f i) := by
    intro i hi; rw [Function.update_of_ne hi]
  have hgJ : ∀ i, Function.update f j (f j - ∑ i, a i * f i) i ∈ J := by
    intro i
    by_cases hi : i = j
    · subst hi
      rw [Function.update_self]
      exact sub_mem (hfJ i) (sum_mem fun k _ => Ideal.mul_mem_left _ _ (hfJ k))
    · rw [Function.update_of_ne hi]; exact hfJ i
  have hψG : ∀ i, initialForm (maximalIdeal S) (Function.update f j (f j - ∑ i, a i * f i) i) ∈
      grIdeal (maximalIdeal S) J := fun i => Ideal.subset_span ⟨_, hgJ i, rfl⟩
  have hψP : ∀ (i : Fin m) (k : Fin (i : ℕ)), initialForm (maximalIdeal S)
      (Function.update f j (f j - ∑ i, a i * f i) (Fin.castLE i.2.le k)) ∈ P i := by
    intro i k
    by_cases hk : Fin.castLE i.2.le k = j
    · rw [hk, hψj]
      have hji : j < i := by rw [← hk]; exact k.2
      rw [hχ]
      exact sub_mem (Ideal.subset_span ⟨j, hji, rfl⟩) (hPmono hji.le hTP)
    · rw [hψne _ hk]
      exact Ideal.subset_span ⟨_, k.2, rfl⟩
  refine ⟨hgJ, hψG, ⟨d, fun i => ?_, hmono⟩, ?_, fun i => ?_⟩
  · beta_reduce
    by_cases hi : i = j
    · subst hi
      rw [hψj, hχdef]
      exact AssocGraded.mk_mem_homogeneous_of_eq _ (hdν' i) hf'M
    · rw [hψne i hi]; exact hd i
  · refine le_antisymm ?_ (Ideal.span_le.mpr ?_)
    · rw [hspan]
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      beta_reduce
      by_cases hi : i = j
      · subst hi
        rw [hφj]
        refine add_mem (Ideal.subset_span ⟨i, hψj⟩) ?_
        refine (Ideal.span_le.mpr ?_) hTP
        rintro _ ⟨k, hk, rfl⟩
        exact Ideal.subset_span ⟨k, hψne k hk.ne⟩
      · exact Ideal.subset_span ⟨i, hψne i hi⟩
    · rintro _ ⟨i, rfl⟩
      exact hψG i
  · intro h
    beta_reduce at h
    have h' := (Ideal.span_le.mpr (by
      rintro _ ⟨k, rfl⟩
      exact hψP i k) : Ideal.span (Set.range fun k : Fin i => initialForm (maximalIdeal S)
        (Function.update f j (f j - ∑ i, a i * f i) (Fin.castLE i.2.le k))) ≤ P i) h
    beta_reduce at h'
    by_cases hi : i = j
    · subst hi
      rw [hψj] at h'
      exact hχP h'
    · rw [hψne i hi] at h'
      exact hirr' i h'

section Repl

theorem AssocGraded.mk_eq_mk_of_eq' {A : Type*} [CommRing A] (I : Ideal A) {n n' : ℕ} {a a' : A}
    (hn : n = n') (ha : a = a') (h : a ∈ I ^ n) (h' : a' ∈ I ^ n') :
    AssocGraded.mk I n a h = AssocGraded.mk I n' a' h' := by
  subst hn; subst ha; rfl

theorem AssocGraded.mk_eq_zero_of_eq_zero' {A : Type*} [CommRing A] (I : Ideal A) {n : ℕ} {a : A}
    (ha : a = 0) (h : a ∈ I ^ n) : AssocGraded.mk I n a h = 0 := by
  subst ha
  exact (AssocGraded.mk_eq_zero_iff I h).mpr (zero_mem _)

/-- The order of an element of a standard base is finite (its initial form is non-zero). -/
theorem IsStandardBase.ordElem_ne_top {S : Type u} [CommRing S] [IsRegularLocalRing S] {J : Ideal S}
    {m : ℕ} {f : Fin m → S} (hf : IsStandardBase S J f) (j : Fin m) :
    Ideal.ordElem (maximalIdeal S) (f j) ≠ ⊤ := by
  intro htop
  apply hf.2.2.2.2 j
  dsimp only
  rw [show initialForm (maximalIdeal S) (f j) = 0 by rw [initialForm, dite_eq_left htop]]
  exact zero_mem _

/-- `IsStandardBase.update_sub` for an initial segment of a standard base. -/
theorem ExtendsToStandardBase.update_sub {S : Type u} [CommRing S] [IsRegularLocalRing S]
    {J : Ideal S} {m : ℕ} {h : Fin m → S} (hext : ExtendsToStandardBase J h) (ν : Fin m → ℕ)
    (hν : ∀ i, Ideal.ordElem (maximalIdeal S) (h i) = ν i) (j : Fin m) (b : Fin m → S)
    (hb0 : ∀ i, ¬ (i < j ∧ ν i < ν j) → b i = 0)
    (hb : ∀ i, b i ∈ maximalIdeal S ^ (ν j - ν i)) :
    ExtendsToStandardBase J (Function.update h j (h j - ∑ i, b i * h i)) ∧
    Ideal.ordElem (maximalIdeal S) (h j - ∑ i, b i * h i) = ν j ∧
    initialForm (maximalIdeal S) (h j - ∑ i, b i * h i) =
      initialForm (maximalIdeal S) (h j) -
        ∑ i, AssocGraded.mk (maximalIdeal S) (ν j - ν i) (b i) (hb i) *
          initialForm (maximalIdeal S) (h i) := by
  classical
  obtain ⟨m', G, him', hG, hGh⟩ := hext
  let ν' : Fin m' → ℕ := fun i => (Ideal.ordElem (maximalIdeal S) (G i)).toNat
  have hν' : ∀ i, Ideal.ordElem (maximalIdeal S) (G i) = ν' i := fun i =>
    (ENat.natCast_toNat (hG.ordElem_ne_top i)).symm
  have hνG : ∀ i : Fin m, ν' (Fin.castLE him' i) = ν i := fun i => by
    have h1 := hν' (Fin.castLE him' i)
    rw [hGh i, hν i] at h1
    exact_mod_cast h1.symm
  let b' : Fin m' → S := fun i => if hi : (i : ℕ) < m then b ⟨i, hi⟩ else 0
  let j' : Fin m' := Fin.castLE him' j
  have hb'cast : ∀ i : Fin m, b' (Fin.castLE him' i) = b i := fun i => by
    simp [b', Fin.castLE]
  have hνG' : ∀ (i : Fin m') (him : (i : ℕ) < m), ν' i = ν ⟨i, him⟩ := fun i him => by
    have := hνG ⟨i, him⟩
    rwa [show Fin.castLE him' ⟨i, him⟩ = i from Fin.ext rfl] at this
  have hb'0 : ∀ i : Fin m', ¬ (i < j' ∧ ν' i < ν' j') → b' i = 0 := by
    intro i hi
    by_cases him : (i : ℕ) < m
    · simp only [b', dite_true, him]
      apply hb0
      rintro ⟨h1, h2⟩
      apply hi
      refine ⟨h1, ?_⟩
      rw [hνG' i him]
      exact (hνG j).symm ▸ h2
    · simp only [b', him, dite_false]
  have hb' : ∀ i : Fin m', b' i ∈ maximalIdeal S ^ (ν' j' - ν' i) := by
    intro i
    by_cases him : (i : ℕ) < m
    · simp only [b', dite_true, him]
      rw [hνG' i him, hνG j]
      exact hb _
    · simp only [b', him, dite_false]; exact zero_mem _
  obtain ⟨hstd, hord, hinit⟩ := hG.update_sub ν' hν' j' b' hb'0 hb'
  have hsum : ∑ i, b' i * G i = ∑ i, b i * h i := by
    rw [Fin.sum_eq_sum_castLE_of_forall_eq_zero him']
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [hb'cast, hGh]
    · intro t ht
      simp [b', not_lt.mpr ht]
  have hGj : G j' = h j := hGh j
  refine ⟨⟨m', Function.update G j' (G j' - ∑ i, b' i * G i), him', hstd, fun i => ?_⟩, ?_, ?_⟩
  · by_cases hij : i = j
    · subst hij
      show Function.update G j' _ j' = _
      rw [Function.update_self, hsum, hGj, Function.update_self]
    · rw [Function.update_of_ne hij, Function.update_of_ne]
      · exact hGh i
      · intro h'
        apply hij
        exact Fin.castLE_injective him' h'
  · rw [hGj, hsum] at hord
    rw [hord]
    exact_mod_cast hνG j
  · have hfin := hinit
    rw [hGj, hsum] at hfin
    rw [hfin]
    congr 1
    rw [Fin.sum_eq_sum_castLE_of_forall_eq_zero him']
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [hGh i]
      congr 1
      exact AssocGraded.mk_eq_mk_of_eq' _ (by rw [hνG i, hνG j]) (hb'cast i) _ _
    · intro t ht
      have : b' t = 0 := by simp [b', not_lt.mpr ht]
      rw [AssocGraded.mk_eq_zero_of_eq_zero' _ this, zero_mul]

end Repl

section Prop1

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

/-- The data (4), (5), (6) of the proof of Proposition 1 (p. 237): a standard base `(f_j)` of `J` with
`ν_P(f_j) = ν_j` (and `ν_M(f_j) = ν_j`), and elements `h_j = x^{-ν_j} f_j` of `R₁` (`x = x₁`) of order
`ν_{M₁}(h_j) = ν_j` which form an initial segment of a standard base of the strict transform `J₁`
(for `ν* (J₁) = ν*(J)`, `(h_j)` is itself a standard base). -/
structure Prop1Data (T : MonoidalTransform R P) [IsRegularLocalRing T.ring]
    (J : Ideal R) (x₁ : T.ring) {m : ℕ} (ν : Fin m → ℕ) where
  f : Fin m → R
  h : Fin m → T.ring
  std : IsStandardBase R J f
  ordM : ∀ j, Ideal.ordElem (maximalIdeal R) (f j) = ν j
  ordP : ∀ j, Ideal.ordElem P (f j) = ν j
  eq : ∀ j, x₁ ^ ν j * h j = T.toRing (f j)
  ordM₁ : ∀ j, Ideal.ordElem (maximalIdeal T.ring) (h j) = ν j
  ext : ExtendsToStandardBase (strictTransformIdeal T J) h

variable {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]
  {J : Ideal R} {x₁ : T.ring} {m : ℕ} {ν : Fin m → ℕ}

/-- **The replacement `f_j ↦ f_j - Σ_i a_i f_i`** of the proof of Proposition 1 (p. 238: "We may replace
`f_j` by `f_j - Σ (x^{ν_j-ν_i} h_{ji}) f_i` without affecting the assumptions (4), (5) and (6)"; also used
for `f_j - Σ p_{ji} f_i` with `p_{ji} ∈ (x₁, …, x_r)^{ν_j-ν_i}R` on p. 237): if `a_i ∈ P^{ν_j-ν_i}` and
`b_i ∈ M₁^{ν_j-ν_i}` satisfy `x^{ν_j-ν_i} b_i = a_i` (in `R₁`), then `f_j' = f_j - Σ a_i f_i` and
`h_j' = h_j - Σ b_i h_i` again satisfy (4), (5), (6); the initial forms of the new elements are
`φ_j - Σ [a_i] φ_i` and `ψ_j - Σ [b_i] ψ_i`. -/
theorem Prop1Data.exists_replace (hPM : P ≤ maximalIdeal R) (D : Prop1Data T J x₁ ν) (j : Fin m) (a : Fin m → R)
    (b : Fin m → T.ring) (ha0 : ∀ d, ¬ (d < j ∧ ν d < ν j) → a d = 0)
    (hb0 : ∀ d, ¬ (d < j ∧ ν d < ν j) → b d = 0)
    (haP : ∀ d, a d ∈ P ^ (ν j - ν d)) (haM : ∀ d, a d ∈ maximalIdeal R ^ (ν j - ν d))
    (hbM : ∀ d, b d ∈ maximalIdeal T.ring ^ (ν j - ν d))
    (hab : ∀ d, x₁ ^ (ν j - ν d) * b d = T.toRing (a d)) :
    ∃ D' : Prop1Data T J x₁ ν, (∀ i, i ≠ j → D'.f i = D.f i ∧ D'.h i = D.h i) ∧
      D'.f j = D.f j - ∑ d, a d * D.f d ∧ D'.h j = D.h j - ∑ d, b d * D.h d ∧
      initialForm (maximalIdeal R) (D'.f j) = initialForm (maximalIdeal R) (D.f j) -
        ∑ d, AssocGraded.mk (maximalIdeal R) (ν j - ν d) (a d) (haM d) *
          initialForm (maximalIdeal R) (D.f d) ∧
      initialForm (maximalIdeal T.ring) (D'.h j) = initialForm (maximalIdeal T.ring) (D.h j) -
        ∑ d, AssocGraded.mk (maximalIdeal T.ring) (ν j - ν d) (b d) (hbM d) *
          initialForm (maximalIdeal T.ring) (D.h d) := by
  classical
  obtain ⟨hstd, hordf, hinitf⟩ := D.std.update_sub ν D.ordM j a ha0 haM
  obtain ⟨hext, hordh, hinith⟩ := D.ext.update_sub ν D.ordM₁ j b hb0 hbM
  -- the new `f_j` lies in `P^{ν_j}`
  have hfP : D.f j - ∑ d, a d * D.f d ∈ P ^ (ν j) := by
    refine sub_mem (Ideal.mem_pow_of_ordElem (D.ordP j)) (sum_mem fun d _ => ?_)
    by_cases hc : d < j ∧ ν d < ν j
    · have : ν j = (ν j - ν d) + ν d := by omega
      rw [this, pow_add]
      exact Ideal.mul_mem_mul (haP d) (Ideal.mem_pow_of_ordElem (D.ordP d))
    · rw [ha0 d hc, zero_mul]; exact zero_mem _
  refine ⟨
    { f := Function.update D.f j (D.f j - ∑ d, a d * D.f d)
      h := Function.update D.h j (D.h j - ∑ d, b d * D.h d)
      std := hstd
      ordM := fun i => by
        by_cases hij : i = j
        · subst hij; simpa using hordf
        · rw [Function.update_of_ne hij]; exact D.ordM i
      ordP := fun i => by
        by_cases hij : i = j
        · subst hij
          simp only [Function.update_self]
          refine le_antisymm (Ideal.ordElem_le fun n hn => ?_) (by exact_mod_cast Ideal.le_ordElem hfP)
          have h1 : (D.f i - ∑ d, a d * D.f d) ∈ maximalIdeal R ^ n :=
            Ideal.pow_right_mono hPM n hn
          have h2 := Ideal.le_ordElem h1
          rw [hordf] at h2
          exact h2
        · rw [Function.update_of_ne hij]; exact D.ordP i
      eq := fun i => by
        by_cases hij : i = j
        · subst hij
          simp only [Function.update_self]
          rw [mul_sub, map_sub, map_sum, Finset.mul_sum, D.eq i]
          congr 1
          refine Finset.sum_congr rfl fun d _ => ?_
          by_cases hc : d < i ∧ ν d < ν i
          · have : ν i = (ν i - ν d) + ν d := by omega
            rw [map_mul, ← hab d, ← D.eq d]
            conv_lhs => rw [this, pow_add]
            ring
          · rw [ha0 d hc, hb0 d hc]; simp
        · rw [Function.update_of_ne hij, Function.update_of_ne hij]; exact D.eq i
      ordM₁ := fun i => by
        by_cases hij : i = j
        · subst hij; simpa using hordh
        · rw [Function.update_of_ne hij]; exact D.ordM₁ i
      ext := hext }, ?_, ?_, ?_, ?_, ?_⟩
  · intro i hij
    exact ⟨Function.update_of_ne hij _ _, Function.update_of_ne hij _ _⟩
  · simp
  · simp
  · simpa using hinitf
  · simpa using hinith

end Prop1

section Lift

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

theorem pDeg_ge_xDeg {r s : ℕ} (γ : CoordIndex r s →₀ ℕ) : xDeg γ ≤ pDeg γ := by
  simp only [xDeg, pDeg, Finsupp.weight_apply, Finsupp.sum]
  refine Finset.sum_le_sum fun v _ => ?_
  refine Nat.mul_le_mul_left _ ?_
  rcases v with _ | (i | j) <;> simp [xWeight, pWeight]

theorem xDeg_le_degree {r s : ℕ} (γ : CoordIndex r s →₀ ℕ) : xDeg γ ≤ γ.degree := by
  rw [Finsupp.degree_eq_weight_one]
  simp only [xDeg, Finsupp.weight_apply, Finsupp.sum]
  refine Finset.sum_le_sum fun v _ => ?_
  refine Nat.mul_le_mul_left _ ?_
  rcases v with _ | (i | j) <;> simp [xWeight]

/-- **Lifting a form of `gr_{M₁}(R₁)` to `R₁` through `R`** (p. 238: "we take a form `h_{ji}` of degree
`ν_j - ν_i` in `(x, x₁/x, …, x_r/x, y₁, …, y_s)` with coefficients in `R` such that `δ_{ji}` is the
initial form of `h_{ji}` in `gr_{M₁}(R₁)`.  Then we have `x^{ν_j-ν_i} h_{ji} ∈ P^{ν_j-ν_i}`"): every
form `u` of degree `n` of `gr_{M₁}(R₁)` is the class of `b ∈ M₁ⁿ`, a form of degree `n` in
`(x₀, x₁/x₀, …, x_r/x₀, y)` with coefficients in `R`, and `x₀ⁿ b = a` for some `a ∈ Pⁿ` of `R`. -/
theorem TransformCoord.exists_lift_form (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) {n : ℕ}
    {u : AssocGraded (maximalIdeal T.ring)} (hu : u ∈ AssocGraded.homogeneous (maximalIdeal T.ring) n) :
    ∃ (a : R) (b : T.ring) (hb : b ∈ maximalIdeal T.ring ^ n), a ∈ P ^ n ∧
      C.x₁ ^ n * b = T.toRing a ∧ AssocGraded.mk (maximalIdeal T.ring) n b hb = u := by
  classical
  obtain ⟨q, hq, rfl⟩ := C.exists_e₁_eq hu
  set θ := T.residueEquiv hrat with hθ
  let c : (CoordIndex C.r C.s →₀ ℕ) → R := fun γ => lift (θ.symm (q.coeff γ))
  have hcθ : ∀ γ, Ideal.Quotient.mk (maximalIdeal T.ring) (T.toRing (c γ)) = q.coeff γ := fun γ => by
    calc Ideal.Quotient.mk (maximalIdeal T.ring) (T.toRing (c γ))
        = θ (Ideal.Quotient.mk (maximalIdeal R) (c γ)) :=
          (MonoidalTransform.residueEquiv_mk T hrat _).symm
      _ = θ (θ.symm (q.coeff γ)) := by rw [show c γ = lift (θ.symm (q.coeff γ)) from rfl, mk_lift]
      _ = q.coeff γ := θ.apply_symm_apply _
  let K : MvPolynomial (CoordIndex C.r C.s) T.ring :=
    ∑ γ ∈ q.support, monomial γ (T.toRing (c γ))
  have hK : K.IsHomogeneous n := by
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun γ hγ => ?_
    exact isHomogeneous_monomial _ (by rw [Finsupp.degree_eq_weight_one]; exact hq (mem_support_iff.mp hγ))
  have hKmap : K.map (Ideal.Quotient.mk (maximalIdeal T.ring)) = q := by
    ext γ
    simp only [K, map_sum, MvPolynomial.map_monomial, coeff_sum, coeff_monomial]
    rw [Finset.sum_ite_eq']
    by_cases hγ : γ ∈ q.support
    · simp only [hγ, if_true, hcθ]
    · simp only [hγ, if_false]; exact (notMem_support_iff.mp hγ).symm
  have hz₁ : ∀ v, C.z₁ v ∈ maximalIdeal T.ring ^ 1 := C.z₁_mem
  have hb : eval C.z₁ K ∈ maximalIdeal T.ring ^ n :=
    eval_mem_pow_of_isHomogeneous (maximalIdeal T.ring) C.z₁ hz₁ hK
  have hbval : eval C.z₁ K = ∑ γ ∈ q.support, T.toRing (c γ) * monomialVal C.z₁ γ := by
    simp only [K, map_sum, eval_monomial_eq_mul_monomialVal]
  -- the element `a`
  let γ' : (CoordIndex C.r C.s →₀ ℕ) → (CoordIndex C.r C.s →₀ ℕ) :=
    fun γ => γ + Finsupp.single none (n - xDeg γ)
  let a : R := ∑ γ ∈ q.support, c γ * monomialVal C.z (γ' γ)
  have hdeg : ∀ γ ∈ q.support, γ.degree = n := fun γ hγ => by
    rw [Finsupp.degree_eq_weight_one]; exact hq (mem_support_iff.mp hγ)
  have hxdeg : ∀ γ ∈ q.support, xDeg γ ≤ n := fun γ hγ => (hdeg γ hγ) ▸ xDeg_le_degree γ
  have hsingle : ∀ k, pDeg (Finsupp.single (none : CoordIndex C.r C.s) k) = k := fun k => by
    simp [pDeg, Finsupp.weight_apply, Finsupp.sum_single_index, pWeight]
  have hpd : ∀ γ, pDeg (γ' γ) = pDeg γ + (n - xDeg γ) := fun γ => by
    show pDeg (γ + Finsupp.single none (n - xDeg γ)) = _
    rw [map_add, hsingle]
  have hxd : ∀ γ, xDeg (γ' γ) = xDeg γ := fun γ => by
    show xDeg (γ + Finsupp.single none (n - xDeg γ)) = _
    rw [map_add, xDeg_single]; simp [xWeight]
  refine ⟨a, eval C.z₁ K, hb, ?_, ?_, ?_⟩
  · refine sum_mem fun γ hγ => Ideal.mul_mem_left _ _ ?_
    have hn : n ≤ pDeg (γ' γ) := by
      rw [hpd]
      have := pDeg_ge_xDeg γ
      have := hxdeg γ hγ
      omega
    exact Ideal.pow_le_pow_right hn (C.monomialVal_z_mem_pow_pDeg _)
  · rw [hbval, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun γ hγ => ?_
    rw [map_mul, C.toRing_monomialVal, hxd, monomialVal_add, monomialVal_single, TransformCoord.z₁_none]
    have h1 : C.x₁ ^ n = C.x₁ ^ xDeg γ * C.x₁ ^ (n - xDeg γ) := by
      rw [← pow_add, Nat.add_sub_cancel' (hxdeg γ hγ)]
    rw [h1]
    ring
  · have := aeval_mk_map_of_isHomogeneous (maximalIdeal T.ring) C.z₁ hz₁ hK
    rw [hKmap] at this
    exact this.symm

end Lift

section Delta

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

/-- `p - (X₀ ↦ 0, Y ↦ 0) p ∈ (X₀, Y₁, …, Y_s)`. -/
theorem sub_pureSubst_mem_span {r s : ℕ} {k : Type*} [CommRing k]
    (p : MvPolynomial (CoordIndex r s) k) :
    p - pureSubst k p ∈ Ideal.span ({X none} ∪ Set.range fun j : Fin s => X (some (Sum.inr j)) :
      Set (MvPolynomial (CoordIndex r s) k)) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have : p + q - pureSubst k (p + q) = (p - pureSubst k p) + (q - pureSubst k q) := by
      rw [map_add]; ring
    rw [this]; exact add_mem hp hq
  | mul_X p v hp =>
    have h1 : p * X v - pureSubst k (p * X v) =
        (p - pureSubst k p) * X v + pureSubst k p * (X v - pureSubst k (X v)) := by
      rw [map_mul]; ring
    rw [h1]
    refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
    rcases v with _ | (i | j)
    · have : pureSubst k (X (none : CoordIndex r s)) = 0 := by simp [pureSubst, xWeight]
      rw [this, sub_zero]
      exact Ideal.subset_span (Or.inl rfl)
    · have : pureSubst k (X (some (Sum.inl i) : CoordIndex r s)) = X (some (Sum.inl i)) := by
        simp [pureSubst, xWeight]
      rw [this, sub_self]; exact zero_mem _
    · have : pureSubst k (X (some (Sum.inr j) : CoordIndex r s)) = 0 := by simp [pureSubst, xWeight]
      rw [this, sub_zero]
      exact Ideal.subset_span (Or.inr ⟨j, rfl⟩)

theorem map_pureSubst_map {r s : ℕ} {k k' : Type*} [CommRing k] [CommRing k'] (e : k ≃+* k')
    (p : MvPolynomial (CoordIndex r s) k) :
    MvPolynomial.map e.toRingHom (pureSubst k p) =
      pureSubst k' (MvPolynomial.map e.toRingHom p) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p v hp =>
    simp only [map_mul, hp]
    congr 1
    by_cases hv : xWeight v = 1 <;> simp [pureSubst, hv]

/-- **`ker ρ₀ = (X, Y₁, …, Y_s)`**: every `w ∈ gr_{M₁}(R₁)` is congruent to `ι₁(ρ₀ w)` (the part of `w` that
is a form only in `X̄₁, …, X̄_r`) modulo the ideal generated by the classes of `x₀` and the `y_j`. -/
theorem TransformCoord.sub_ι₁_ρ₀_mem_span (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (w : AssocGraded (maximalIdeal T.ring)) :
    w - C.ι₁ hrat (C.ρ₀ hrat w) ∈ Ideal.span ({C.e₁ (X none)} ∪
      Set.range fun j : Fin C.s => C.e₁ (X (some (Sum.inr j))) : Set (AssocGraded (maximalIdeal T.ring))) := by
  obtain ⟨p, rfl⟩ := C.e₁_bijective.2 w
  have h1 : C.ι₁ hrat (C.ρ₀ hrat (C.e₁ p)) = C.e₁ (pureSubst _ p) := by
    show C.e₁ (MvPolynomial.map (T.residueEquiv hrat).toRingHom (pureInclude C.r C.s _
      (pureProj C.r C.s _ (MvPolynomial.map (T.residueEquiv hrat).symm.toRingHom
        ((RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm (C.e₁ p)))))) = _
    have : (RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm (C.e₁ p) = p :=
      (RingEquiv.symm_apply_eq _).mpr rfl
    rw [this, pureInclude_pureProj]
    rw [map_pureSubst_map (T.residueEquiv hrat), MvPolynomial.map_map]
    have h3 : (T.residueEquiv hrat).toRingHom.comp (T.residueEquiv hrat).symm.toRingHom =
        RingHom.id _ := by ext x; simp
    rw [h3, MvPolynomial.map_id]
  rw [h1, ← map_sub]
  have := mem_span_image_of_mem_span C.e₁ (sub_pureSubst_mem_span (r := C.r) (s := C.s) p)
  refine (Ideal.span_mono ?_) this
  rintro _ ⟨x, (rfl | ⟨j, rfl⟩), rfl⟩
  · exact Or.inl rfl
  · exact Or.inr ⟨j, rfl⟩

end Delta

section Delta2

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

theorem TransformCoord.eq_zero_of_mem_homogeneous_zero_of_ρ₀_eq_zero (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 0) (h : C.ρ₀ hrat x = 0) : x = 0 := by
  obtain ⟨a, rfl⟩ := AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero _ hx
  rw [C.ρ₀_algebraMap hrat] at h
  have h1 : (T.residueEquiv hrat).symm a = 0 := by
    have h2 : (MvPolynomial.C ((T.residueEquiv hrat).symm a) :
        MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) = 0 := by
      rw [← MvPolynomial.algebraMap_eq]; exact h
    exact MvPolynomial.C_injective _ _ (h2.trans (map_zero _).symm)
  have h3 : a = 0 := (map_eq_zero_iff _ (T.residueEquiv hrat).symm.injective).mp h1
  rw [h3, map_zero]

/-- **The forms `δ_{ji}` of p. 237** ("The assumption that `Q₁` is a permissible center for `J₁` implies
that there exist forms `δ_{ji}` of degree `ν_j - ν_i` in `(X, Y₁, …, Y_s) gr_{M₁}(R₁)`, where `δ_{ji} = 0`
for those `i` with `ν_j - ν_i = 0`, such that `ψ_j - Σ_{i<j} δ_{ji} ψ_i` is a form only in
`X̄₁, …, X̄_r`"): if the ideal generated by `ψ₁, …, ψ_m` is generated by forms `G_l` which are forms only
in `X̄₁, …, X̄_r` (the initial forms of a standard base of `J₁` with `Q₁`-orders equal to `M₁`-orders), then
such `δ_{ji}` exist.  (`ρ₀ δ = 0` is "`δ ∈ (X, Y)`".) -/
theorem TransformCoord.exists_delta (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {m m' : ℕ} (ν : Fin m → ℕ) (hν : Monotone ν)
    (ψ : Fin m → AssocGraded (maximalIdeal T.ring))
    (hψ : ∀ i, ψ i ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν i))
    (G : Fin m' → AssocGraded (maximalIdeal T.ring)) (d : Fin m' → ℕ)
    (hG : ∀ l, G l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (d l))
    (hGι : ∀ l, G l ∈ (C.ι₁ hrat).range)
    (hGψ : ∀ l, G l ∈ Ideal.span (Set.range ψ)) (j : Fin m)
    (hψG : ψ j ∈ Ideal.span (Set.range G)) :
    ∃ δ : Fin m → AssocGraded (maximalIdeal T.ring),
      (∀ i, C.ρ₀ hrat (δ i) = 0) ∧
      (∀ i, δ i ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν j - ν i)) ∧
      (∀ i, ¬ (i < j ∧ ν i < ν j) → δ i = 0) ∧
      ψ j - ∑ i, δ i * ψ i ∈ (C.ι₁ hrat).range := by
  classical
  obtain ⟨c, hc, hc0, hcsum⟩ :=
    AssocGraded.exists_homogeneous_coeffs_of_mem_span (maximalIdeal T.ring) G d hG (hψ j) hψG
  have hex := fun l => AssocGraded.exists_homogeneous_coeffs_of_mem_span (maximalIdeal T.ring) ψ ν hψ (hG l) (hGψ l)
  choose e he he0 hesum using hex
  obtain ⟨c1, hc1def⟩ : ∃ c1 : Fin m' → AssocGraded (maximalIdeal T.ring),
      ∀ l, c1 l = c l - C.ι₁ hrat (C.ρ₀ hrat (c l)) := ⟨_, fun _ => rfl⟩
  have hc1ρ : ∀ l, C.ρ₀ hrat (c1 l) = 0 := fun l => by rw [hc1def]; simp [C.ρ₀_ι₁ hrat]
  have hc1h : ∀ l, c1 l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν j - d l) := fun l => by
    rw [hc1def]
    exact sub_mem (hc l) (C.ι₁_mem_homogeneous hrat (C.ρ₀_mem_homogeneous hrat (hc l)))
  have hc10 : ∀ l, ν j < d l → c1 l = 0 := fun l hl => by rw [hc1def, hc0 l hl]; simp
  refine ⟨fun i => ∑ l, c1 l * e l i, fun i => ?_, fun i => ?_, fun i hi => ?_, ?_⟩
  · rw [map_sum]
    refine Finset.sum_eq_zero fun l _ => ?_
    rw [map_mul, hc1ρ, zero_mul]
  · refine sum_mem fun l _ => ?_
    by_cases h1 : ν j < d l
    · rw [hc10 l h1, zero_mul]; exact zero_mem _
    by_cases h2 : d l < ν i
    · rw [he0 l i h2, mul_zero]; exact zero_mem _
    have := AssocGraded.mul_mem_homogeneous (I := maximalIdeal T.ring) (hc1h l) (he l i)
    have e' : (ν j - d l) + (d l - ν i) = ν j - ν i := by omega
    rwa [e'] at this
  · have hji : ν j ≤ ν i := by
      by_contra hlt
      push Not at hlt
      apply hi
      refine ⟨?_, hlt⟩
      by_contra hij
      exact absurd (hν (not_lt.mp hij)) (not_le.mpr hlt)
    refine Finset.sum_eq_zero fun l _ => ?_
    by_cases h1 : ν j < d l
    · rw [hc10 l h1, zero_mul]
    by_cases h2 : d l < ν i
    · rw [he0 l i h2, mul_zero]
    have hd : ν j - d l = 0 := by omega
    have hz := C.eq_zero_of_mem_homogeneous_zero_of_ρ₀_eq_zero hrat (hd ▸ hc1h l) (hc1ρ l)
    rw [hz, zero_mul]
  · have hsum : ∑ i, (∑ l, c1 l * e l i) * ψ i = ∑ l, c1 l * G l := by
      simp_rw [Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [hesum l, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      ring
    rw [hsum, hcsum]
    have : ∑ l, c l * G l - ∑ l, c1 l * G l = ∑ l, C.ι₁ hrat (C.ρ₀ hrat (c l)) * G l := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [hc1def]; ring
    rw [this]
    exact sum_mem fun l _ => mul_mem ((C.ι₁ hrat).mem_range_self _) (hGι l)

end Delta2

/-- `T_b ⊆ (linear part of k[X₁, …, X_r])` and `T_b ⊆ ρ(T̃_b)` for `b ≤ a` ("as was seen near the end of
the proof of Lemma 15", p. 233), from the data `(g, h)` of Lemma 14 indexed up to any `i₀ ≥ i_b`, where
`i_b` is the largest index with `ν^{(i_b)}(J) = μ^{(b)}(J)`. -/
theorem TransformCoord.tauSubmodule_le_of_le_index (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] (P : Ideal R) (J : Ideal R) (T : MonoidalTransform R P) [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (C : TransformCoord T)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) (ν : Fin m → ℕ)
    (hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat))
    (b : ℕ) (hb : 1 ≤ b) (hbt : b ≤ t R J) (ib : ℕ+)
    (hib : IsGreatest {k : ℕ+ | nuI R J k = (mu R J b : ℕ∞)} ib) (i₀ : ℕ) (hi₀ : (ib : ℕ) ≤ i₀)
    (him : i₀ ≤ m)
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ i₀ → nuI R J j = nuI T.ring (strictTransformIdeal T J) j)
    (h : Fin i₀ → T.ring)
    (hgh : ∀ j : Fin i₀, C.x₁ ^ ν (Fin.castLE him j) * h j = T.toRing (g (Fin.castLE him j)))
    (hhν : ∀ j : Fin i₀,
      Ideal.ordElem (maximalIdeal T.ring) (h j) = (ν (Fin.castLE him j) : ℕ∞))
    (hext : ExtendsToStandardBase (strictTransformIdeal T J) h) :
    mu T.ring (strictTransformIdeal T J) b = mu R J b ∧ b ≤ t T.ring (strictTransformIdeal T J) ∧
    tauSubmodule R J b ≤ (homogeneousSubmodule (Fin C.r) (R ⧸ maximalIdeal R) 1).map C.ι.toLinearMap ∧
    tauSubmodule R J b ≤ Submodule.span (R ⧸ maximalIdeal R)
      (C.ρ hrat '' (tauSubmodule T.ring (strictTransformIdeal T J) b :
        Set (AssocGraded (maximalIdeal T.ring)))) := by
  have hle' : (ib : ℕ) ≤ i₀ := hi₀
  have heq_b : ∀ j : ℕ+, (j : ℕ) ≤ (ib : ℕ) → nuI R J j = nuI T.ring (strictTransformIdeal T J) j :=
    fun j hj => heq j (hj.trans hle')
  refine ⟨mu_eq_of_nuI_eq J _ b hb hbt ib hib heq_b, le_t_of_nuI_eq J _ b hb hbt ib hib heq_b, ?_⟩
  exact TransformCoord.tauSubmodule_le_span_ρ_of_isGreatest R P J T hrat C g hg ν hν b hb hbt ib hib
    (hle'.trans him) heq_b (fun s => h (Fin.castLE hle' s))
    (fun j => by simpa using hgh (Fin.castLE hle' j))
    (fun j => by simpa using hhν (Fin.castLE hle' j))
    (by
      obtain ⟨m', G, him', hG, hGh⟩ := hext
      exact ⟨m', G, hle'.trans him', hG, fun s => by simpa using hGh (Fin.castLE hle' s)⟩)

section PureLift

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

/-- **Lifting a form in `X₁, …, X_r` only** (p. 237: "replacing each `f_j` by `f_j - Σ p_{ji} f_i` with
suitable `p_{ji} ∈ (x₁, …, x_r)^{ν_j-ν_i} R`"): a form `δ` of degree `e` in `k[X₁, …, X_r]` is the class
of a form `a ∈ (x₁, …, x_r)^e R` in `x₁, …, x_r` with coefficients in `R`, and of `b = a/x₀^e ∈ M₁^e`, the
same form in `x₁/x₀, …, x_r/x₀`. -/
theorem TransformCoord.exists_lift_pure (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) {e : ℕ}
    {δ : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)} (hδ : δ.IsHomogeneous e) :
    ∃ (a : R) (b : T.ring) (hb : b ∈ maximalIdeal T.ring ^ e) (ha : a ∈ P ^ e)
      (haM : a ∈ maximalIdeal R ^ e), C.x₁ ^ e * b = T.toRing a ∧
      AssocGraded.mk (maximalIdeal T.ring) e b hb = C.ι₁ hrat δ ∧
      AssocGraded.mk (maximalIdeal R) e a haM = C.ι δ := by
  classical
  set θ := T.residueEquiv hrat with hθ
  let KR : MvPolynomial (Fin C.r) R := ∑ β ∈ δ.support, monomial β (lift (δ.coeff β))
  have hK : KR.IsHomogeneous e := by
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun β hβ => ?_
    exact isHomogeneous_monomial _ (by rw [Finsupp.degree_eq_weight_one]; exact hδ (mem_support_iff.mp hβ))
  have hKcoeff : ∀ β, Ideal.Quotient.mk (maximalIdeal R) (KR.coeff β) = δ.coeff β := fun β => by
    simp only [KR, coeff_sum, coeff_monomial]
    rw [Finset.sum_ite_eq']
    by_cases hβ : β ∈ δ.support
    · simp only [hβ, if_true, mk_lift]
    · simp only [hβ, if_false, map_zero]; exact (notMem_support_iff.mp hβ).symm
  have hKmapR : KR.map (Ideal.Quotient.mk (maximalIdeal R)) = δ := by
    ext β; rw [coeff_map, hKcoeff]
  have hKmapT : (KR.map T.toRing).map (Ideal.Quotient.mk (maximalIdeal T.ring)) =
      δ.map θ.toRingHom := by
    ext β
    rw [coeff_map, coeff_map, coeff_map, ← hKcoeff β]
    exact (MonoidalTransform.residueEquiv_mk T hrat _).symm
  let : Algebra R T.ring := T.toRing.toAlgebra
  have hx1 : ∀ i, C.x i ∈ maximalIdeal R ^ 1 := fun i => C.z_mem (some (Sum.inl i))
  have hx1' : ∀ i, C.x' i ∈ maximalIdeal T.ring ^ 1 := fun i => by
    rw [pow_one, ← C.hM₁]; exact Ideal.subset_span ⟨some (Sum.inl i), rfl⟩
  have hxP : ∀ i, C.x i ∈ P ^ 1 := fun i => by rw [pow_one]; exact C.x_mem i
  have hbev : aeval C.x' KR = eval C.x' (KR.map T.toRing) := by
    rw [MvPolynomial.eval_map]; rfl
  have hb : aeval C.x' KR ∈ maximalIdeal T.ring ^ e := by
    rw [hbev]; exact eval_mem_pow_of_isHomogeneous (maximalIdeal T.ring) C.x' hx1' (hK.map _)
  refine ⟨eval C.x KR, aeval C.x' KR, hb, eval_mem_pow_of_isHomogeneous P C.x hxP hK,
    eval_mem_pow_of_isHomogeneous (maximalIdeal R) C.x hx1 hK, ?_, ?_, ?_⟩
  · have h1 : T.toRing (eval C.x KR) = aeval (fun k => T.toRing (C.x k)) KR := by
      rw [← MvPolynomial.coe_aeval_eq_eval]
      exact (MvPolynomial.aeval_algebraMap_apply T.ring C.x KR).symm
    have h2 : (fun k => T.toRing (C.x k)) = fun k => C.x' k * C.x₁ := by
      funext k; rw [← C.hx' k, mul_comm]; rfl
    rw [h1, h2, hK.aeval_mul_const]
  · have h1 := aeval_mk_map_of_isHomogeneous (maximalIdeal T.ring) C.x' hx1' (hK.map T.toRing)
    rw [hKmapT] at h1
    rw [AssocGraded.mk_congr _ hb hbev]
    refine h1.symm.trans ?_
    show _ = C.e₁ (MvPolynomial.map θ.toRingHom (pureInclude C.r C.s _ δ))
    rw [pureInclude, MvPolynomial.map_rename]
    show _ = aeval _ (rename _ (MvPolynomial.map θ.toRingHom δ))
    rw [aeval_rename]
    rfl
  · have h1 := aeval_mk_map_of_isHomogeneous (maximalIdeal R) C.x hx1 hK
    rw [hKmapR] at h1
    refine h1.symm.trans ?_
    show _ = C.e (pureInclude C.r C.s _ δ)
    rw [pureInclude]
    show _ = aeval _ (rename _ δ)
    rw [aeval_rename]
    rfl

end PureLift

section Flag

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P}

theorem TransformCoord.ι_X (C : TransformCoord T) (k : Fin C.r) :
    C.ι (X k) = AssocGraded.mk (maximalIdeal R) 1 (C.x k) (C.z_mem (some (Sum.inl k))) := by
  simp [TransformCoord.ι_apply, pureInclude, TransformCoord.e, TransformCoord.z, coordFamily]

theorem TransformCoord.change_ι_X (C : TransformCoord T) (A : Matrix (Fin C.r) (Fin C.r) R)
    (hA : IsUnit A.det) (hb : ∀ i, (0 : R) ∈ maximalIdeal R) (k : Fin C.r) :
    (C.change A hA (fun _ => 0) hb).ι (X k) =
      ∑ l, Ideal.Quotient.mk (maximalIdeal R) (A k l) • C.ι (X l) := by
  refine (TransformCoord.ι_X (C.change A hA (fun _ => 0) hb) k).trans ?_
  have hxl : ∀ l, C.x l ∈ maximalIdeal R ^ 1 := fun l => C.z_mem (some (Sum.inl l))
  have hnew : (C.change A hA (fun _ => 0) hb).x k = ∑ l, A k l * C.x l := by
    show ∑ l, A k l * C.x l + 0 * C.x₀ = _
    rw [zero_mul, add_zero]
  have hmem : ∑ l, A k l * C.x l ∈ maximalIdeal R ^ 1 :=
    sum_mem fun l _ => Ideal.mul_mem_left _ _ (hxl l)
  have hxmem : (C.change A hA (fun _ => 0) hb).x k ∈ maximalIdeal R ^ 1 :=
    (C.change A hA (fun _ => 0) hb).z_mem (some (Sum.inl k))
  rw [AssocGraded.mk_congr _ hxmem hnew,
    AssocGraded.mk_sum _ 1 _ _ (fun l => Ideal.mul_mem_left _ _ (hxl l))]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [TransformCoord.ι_X]
  exact (AssocGraded.smul_mk (maximalIdeal R) 1 (A k l) (C.x l) (hxl l)).symm

end Flag

section Lift6

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

/-- `AssocGraded.exists_homogeneous_coeffs_of_mem_span` for an arbitrary finite index type. -/
theorem AssocGraded.exists_homogeneous_coeffs_of_mem_span_fintype {A : Type*} [CommRing A] (I : Ideal A)
    {ι : Type*} [Fintype ι] (Φ : ι → AssocGraded I) (d : ι → ℕ)
    (hΦ : ∀ t, Φ t ∈ AssocGraded.homogeneous I (d t)) {μ : ℕ} {χ : AssocGraded I}
    (hχ : χ ∈ AssocGraded.homogeneous I μ) (hspan : χ ∈ Ideal.span (Set.range Φ)) :
    ∃ c : ι → AssocGraded I, (∀ t, c t ∈ AssocGraded.homogeneous I (μ - d t)) ∧
      (∀ t, μ < d t → c t = 0) ∧ χ = ∑ t, c t * Φ t := by
  classical
  let eq := Fintype.equivFin ι
  have hspan' : χ ∈ Ideal.span (Set.range fun i => Φ (eq.symm i)) := by
    rwa [show Set.range (fun i => Φ (eq.symm i)) = Set.range Φ from eq.symm.surjective.range_comp Φ]
  obtain ⟨c, hc, hc0, hsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span I
    (fun i => Φ (eq.symm i)) (fun i => d (eq.symm i)) (fun i => hΦ _) hχ hspan'
  refine ⟨fun t => c (eq t), fun t => ?_, fun t ht => hc0 _ ?_, ?_⟩
  · simpa using hc (eq t)
  · simpa using ht
  · rw [hsum]
    refine Fintype.sum_equiv eq.symm _ _ fun i => ?_
    simp

theorem TransformCoord.e₁_X (C : TransformCoord T) (v : CoordIndex C.r C.s) :
    C.e₁ (X v) = AssocGraded.mk (maximalIdeal T.ring) 1 (C.z₁ v) (C.z₁_mem v) := by
  simp [TransformCoord.e₁]

/-- **Lifting a form of `(X, Y₁, …, Y_s) gr_{M₁}(R₁)`** (p. 238): a form `δ` of degree `e ≥ 1` with
`ρ₀ δ = 0` is the class of `b ∈ M₁^e`, a form of degree `e` in `x₀, x₁/x₀, …, y` with coefficients in `R`
each of whose monomials contains `x₀` or some `y_j`, and `x₀^e b = a` with `a ∈ P^e ∩ M^{e+1}`; so
the class of `a` in `gr^e_M(R)` is `0` ("`x^{ν_j - ν_i} h_{ji} ∈ P^{ν_j - ν_i}`", and the initial form
of `f_j` does not change). -/
theorem TransformCoord.exists_lift_ker (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) {e : ℕ} (he : 1 ≤ e)
    {δ : AssocGraded (maximalIdeal T.ring)} (hδ : δ ∈ AssocGraded.homogeneous (maximalIdeal T.ring) e)
    (hρ : C.ρ₀ hrat δ = 0) :
    ∃ (a : R) (b : T.ring) (hb : b ∈ maximalIdeal T.ring ^ e), a ∈ P ^ e ∧
      a ∈ maximalIdeal R ^ (e + 1) ∧ C.x₁ ^ e * b = T.toRing a ∧
      AssocGraded.mk (maximalIdeal T.ring) e b hb = δ := by
  classical
  have hPM : P ≤ maximalIdeal R := by
    have := C.isPrime
    exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
  let ix : Option (Fin C.s) → CoordIndex C.r C.s := fun o => o.elim none fun j => some (Sum.inr j)
  let Φ : Option (Fin C.s) → AssocGraded (maximalIdeal T.ring) := fun o => C.e₁ (X (ix o))
  have hΦ : ∀ o, Φ o ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := fun o => by
    show C.e₁ (X (ix o)) ∈ _
    rw [TransformCoord.e₁_X]; exact AssocGraded.mk_mem_homogeneous _ _
  have hspan : δ ∈ Ideal.span (Set.range Φ) := by
    have := C.sub_ι₁_ρ₀_mem_span hrat δ
    rw [hρ, map_zero, sub_zero] at this
    refine (Ideal.span_mono ?_) this
    rintro _ (rfl | ⟨j, rfl⟩)
    · exact ⟨none, rfl⟩
    · exact ⟨some j, rfl⟩
  obtain ⟨c, hc, -, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span_fintype
    (maximalIdeal T.ring) Φ (fun _ => 1) hΦ hδ hspan
  have hlift := fun o => C.exists_lift_form hrat (hc o)
  choose a₀ b₀ hb₀ ha₀ hab₀ hmk₀ using hlift
  have he1 : 1 + (e - 1) = e := by omega
  have hzM : ∀ o, C.z₁ (ix o) ∈ maximalIdeal T.ring ^ 1 := fun o => C.z₁_mem _
  have hwM : ∀ o, C.z (ix o) ∈ maximalIdeal R ^ 1 := fun o => C.z_mem _
  have hTw : ∀ o, T.toRing (C.z (ix o)) = C.z₁ (ix o) := fun o => by
    rw [C.toRing_z]; rcases o with _ | j <;> simp [ix, xWeight]
  have hx₀P : C.x₀ ∈ P := C.x₀_mem
  refine ⟨∑ o, C.x₀ * C.z (ix o) * a₀ o, ∑ o, C.z₁ (ix o) * b₀ o, ?_, ?_, ?_, ?_, ?_⟩
  · refine sum_mem fun o _ => ?_
    rw [← he1, pow_add]
    exact Ideal.mul_mem_mul (hzM o) (hb₀ o)
  · refine sum_mem fun o _ => ?_
    rw [mul_right_comm]
    refine Ideal.mul_mem_right _ _ ?_
    have h := Ideal.mul_mem_mul (show C.x₀ ∈ P ^ 1 by rwa [pow_one]) (ha₀ o)
    rwa [← pow_add, he1] at h
  · refine sum_mem fun o _ => ?_
    have hx₀M : C.x₀ ∈ maximalIdeal R ^ 1 := C.z_mem none
    have hmid : a₀ o ∈ maximalIdeal R ^ (e - 1) := Ideal.pow_right_mono hPM _ (ha₀ o)
    have h := Ideal.mul_mem_mul (Ideal.mul_mem_mul hx₀M (hwM o)) hmid
    rwa [← pow_add, ← pow_add, show 1 + 1 + (e - 1) = e + 1 by omega] at h
  · rw [Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun o _ => ?_
    have hx : C.x₁ ^ e = C.x₁ * C.x₁ ^ (e - 1) := by
      rw [← pow_succ']; congr 1; omega
    rw [map_mul, map_mul, hTw, ← hab₀ o, hx]
    show _ = C.x₁ * C.z₁ (ix o) * (C.x₁ ^ (e - 1) * b₀ o)
    ring
  · have hterm : ∀ o, AssocGraded.mk (maximalIdeal T.ring) e (C.z₁ (ix o) * b₀ o)
        (by rw [← he1, pow_add]; exact Ideal.mul_mem_mul (hzM o) (hb₀ o)) = c o * Φ o := by
      intro o
      rw [AssocGraded.mk_mul_of_add_eq (maximalIdeal T.ring) he1 (hzM o) (hb₀ o), hmk₀ o, mul_comm]
      show _ = c o * C.e₁ (X (ix o))
      rw [TransformCoord.e₁_X]
    rw [AssocGraded.mk_sum (maximalIdeal T.ring) e Finset.univ (fun o => C.z₁ (ix o) * b₀ o)
      (fun o => by rw [← he1, pow_add]; exact Ideal.mul_mem_mul (hzM o) (hb₀ o))]
    rw [hcsum]
    exact Finset.sum_congr rfl fun o _ => hterm o

end Lift6

section FlagCoord

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P}

/-- **"Applying a suitable linear transformation to `(x₁, …, x_r)` with coefficients in `R`, we may
assume that `(x₁, …, x_{τ_a})` is a regular system of `a`-th `τ`-parameters of `R` for `J`"** (p. 237),
in the form: if `T_t` (`t = t(J)`) lies in the linear part of `k[X₁, …, X_r]`, then there is an invertible
matrix `A` such that, for the new coordinates `x_i' = Σ A_{ik} x_k`, `T_b` is generated by the classes
`X₁', …, X'_{τ_b}` of `x₁', …, x'_{τ_b}` for every `b ≤ t` (the flag `T₁ ⊆ … ⊆ T_t` is adapted to the
coordinates). -/
theorem TransformCoord.exists_change_tau (C : TransformCoord T) (J : Ideal R)
    (hlin : tauSubmodule R J (t R J) ≤
      (homogeneousSubmodule (Fin C.r) (R ⧸ maximalIdeal R) 1).map C.ι.toLinearMap) :
    ∃ (A : Matrix (Fin C.r) (Fin C.r) R) (hA : IsUnit A.det),
      (∀ b, 1 ≤ b → b ≤ t R J → tau R J b ≤ C.r) ∧
      ∀ b, 1 ≤ b → b ≤ t R J → tauSubmodule R J b = Submodule.span (R ⧸ maximalIdeal R)
        ((fun k : Fin C.r => (C.change A hA (fun _ => 0) (fun _ => zero_mem _)).ι (X k)) ''
          {k | (k : ℕ) < tau R J b}) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  rcases Nat.eq_zero_or_pos (t R J) with ht0 | ht0
  · exact ⟨1, by simp, fun b hb hbt => absurd (hb.trans hbt) (by omega),
      fun b hb hbt => absurd (hb.trans hbt) (by omega)⟩
  -- the flag `T₁ ⊆ … ⊆ T_t` and a family `w` adapted to it
  have hflag : Monotone fun b : ℕ => tauSubmodule R J (min (b + 1) (t R J)) := fun b b' hbb' =>
    tauSubmodule_mono_of_le J (by omega) (by omega) (min_le_right _ _)
  obtain ⟨w, hw⟩ := exists_flag_family_of_monotone (K := R ⧸ maximalIdeal R)
    (fun b : ℕ => tauSubmodule R J (min (b + 1) (t R J))) hflag
    (fun b => finiteDimensional_tauSubmodule J _) (t R J - 1)
  have hwa : ∀ b, 1 ≤ b → b ≤ t R J → Submodule.span (R ⧸ maximalIdeal R)
      (w '' Set.Iio (tau R J b)) = tauSubmodule R J b := by
    intro b hb hbt
    have h := hw (b - 1) (by omega)
    rw [show min (b - 1 + 1) (t R J) = b by omega,
      (tauSubmodule_spec R J b hb hbt).2.1] at h
    exact h
  have hτ : ∀ b, 1 ≤ b → b ≤ t R J → tau R J b ≤ tau R J (t R J) := fun b hb hbt => by
    rw [← (tauSubmodule_spec R J b hb hbt).2.1, ← (tauSubmodule_spec R J _ ht0 le_rfl).2.1]
    have := finiteDimensional_tauSubmodule J (t R J)
    exact Submodule.finrank_mono (tauSubmodule_mono_of_le J hb hbt le_rfl)
  set τ := tau R J (t R J) with hτdef
  have hwT : ∀ l : Fin τ, w l ∈ tauSubmodule R J (t R J) := fun l => by
    rw [← hwa _ ht0 le_rfl]
    exact Submodule.subset_span ⟨l, l.2, rfl⟩
  have hex := fun l : Fin τ => Submodule.mem_map.mp (hlin (hwT l))
  choose p hp1 hp2 using hex
  have hphom : ∀ l, (p l).IsHomogeneous 1 := fun l => (mem_homogeneousSubmodule 1 (p l)).mp (hp1 l)
  let c : Fin τ → Fin C.r → R ⧸ maximalIdeal R := fun l k => (p l).coeff (Finsupp.single k 1)
  have hpc : ∀ l, p l = ∑ k, c l k • (X k : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) :=
    fun l => eq_sum_smul_X_of_isHomogeneous_one (hphom l)
  have hwli : LinearIndependent (R ⧸ maximalIdeal R) fun l : Fin τ => w l := by
    rw [linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin, Set.finrank]
    have : Set.range (fun l : Fin τ => w l) = w '' Set.Iio τ := by
      ext x; constructor
      · rintro ⟨l, rfl⟩; exact ⟨l, l.2, rfl⟩
      · rintro ⟨l, hl, rfl⟩; exact ⟨⟨l, hl⟩, rfl⟩
    rw [this, hwa _ ht0 le_rfl, (tauSubmodule_spec R J _ ht0 le_rfl).2.1]
  let Φ : (Fin C.r → R ⧸ maximalIdeal R) →ₗ[R ⧸ maximalIdeal R] AssocGraded (maximalIdeal R) :=
    C.ι.toLinearMap ∘ₗ Fintype.linearCombination (R ⧸ maximalIdeal R)
      (fun k : Fin C.r => (X k : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)))
  have hcli : LinearIndependent (R ⧸ maximalIdeal R) c := by
    refine LinearIndependent.of_comp Φ ?_
    convert hwli using 1
    funext l
    simp only [Function.comp_apply, Φ, LinearMap.comp_apply, Fintype.linearCombination_apply,
      AlgHom.toLinearMap_apply]
    rw [← hpc l]
    exact hp2 l
  have hτr : τ ≤ C.r := by
    have := hcli.fintype_card_le_finrank
    simpa using this
  let v : Fin τ → Fin C.r → R := fun l k => lift (c l k)
  have hvli : LinearIndependent (R ⧸ maximalIdeal R)
      fun l => fun k => Ideal.Quotient.mk (maximalIdeal R) (v l k) := by
    convert hcli using 2 with l
    funext k
    exact mk_lift _
  obtain ⟨A, hA, hArow⟩ := exists_matrix_isUnit_det_of_rows hτr v hvli
  refine ⟨A, hA, fun b hb hbt => (hτ b hb hbt).trans hτr, fun b hb hbt => ?_⟩
  have hXk : ∀ k : Fin C.r, (k : ℕ) < τ →
      (C.change A hA (fun _ => 0) (fun _ => zero_mem _)).ι (X k) = w k := by
    intro k hk
    refine (C.change_ι_X A hA (fun _ => zero_mem _) k).trans ?_
    have hrow : A k = v ⟨k, hk⟩ := hArow k hk
    have h1 : w k = C.ι (p ⟨k, hk⟩) := (hp2 ⟨k, hk⟩).symm
    rw [h1, hpc ⟨k, hk⟩, map_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [hrow, map_smul]
    congr 1
    exact mk_lift _
  rw [← hwa b hb hbt]
  congr 1
  ext x
  constructor
  · rintro ⟨l, hl, rfl⟩
    have hlr : l < C.r := lt_of_lt_of_le (lt_of_lt_of_le hl (hτ b hb hbt)) hτr
    refine ⟨⟨l, hlr⟩, hl, ?_⟩
    exact hXk ⟨l, hlr⟩ (lt_of_lt_of_le hl (hτ b hb hbt))
  · rintro ⟨k, hk, rfl⟩
    refine ⟨k, hk, ?_⟩
    exact (hXk k (lt_of_lt_of_le hk (hτ b hb hbt))).symm

end FlagCoord

section Norm

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]
  {J : Ideal R} {m : ℕ} {ν : Fin m → ℕ}

theorem TransformCoord.π₀_isHomogeneous (C : TransformCoord T) {x : AssocGraded (maximalIdeal R)} {d : ℕ}
    (hx : x ∈ AssocGraded.homogeneous (maximalIdeal R) d) : (C.π₀ x).IsHomogeneous d := by
  obtain ⟨q, hq, rfl⟩ := C.exists_e_eq hx
  have : C.π₀ (C.e q) = pureProj C.r C.s _ q := by
    show pureProj C.r C.s _ ((AlgEquiv.ofBijective C.e C.e_bijective).symm
      (AlgEquiv.ofBijective C.e C.e_bijective q)) = _
    rw [AlgEquiv.symm_apply_apply]
  rw [this]
  exact isHomogeneous_of_pureInclude (by rw [pureInclude_pureProj]; exact isHomogeneous_pureSubst hq)

theorem TransformCoord.ι_π₀_of_mem_range (C : TransformCoord T) {x : AssocGraded (maximalIdeal R)}
    (hx : x ∈ C.ι.range) : C.ι (C.π₀ x) = x := by
  obtain ⟨p, hp⟩ := hx
  rw [← hp]
  show C.ι (C.π₀ (C.ι p)) = C.ι p
  rw [π₀_ι]

/-- Homogeneous coefficients for an element of the ideal generated by those `ψ_d` with `ν_d < n`. -/
theorem AssocGraded.exists_homogeneous_coeffs_of_mem_span_lt {A : Type*} [CommRing A] (I : Ideal A)
    {m : ℕ} (ν : Fin m → ℕ) (ψ : Fin m → AssocGraded I)
    (hψ : ∀ d, ψ d ∈ AssocGraded.homogeneous I (ν d)) {n : ℕ} {x : AssocGraded I}
    (hx : x ∈ AssocGraded.homogeneous I n)
    (hmem : x ∈ Ideal.span {y | ∃ d, ν d < n ∧ y = ψ d}) :
    ∃ δ : Fin m → AssocGraded I, (∀ d, δ d ∈ AssocGraded.homogeneous I (n - ν d)) ∧
      (∀ d, ¬ ν d < n → δ d = 0) ∧ x = ∑ d, δ d * ψ d := by
  classical
  let Φ : Fin m → AssocGraded I := fun d => if ν d < n then ψ d else 0
  have hΦ : ∀ d, Φ d ∈ AssocGraded.homogeneous I (ν d) := fun d => by
    simp only [Φ]; split_ifs
    · exact hψ d
    · exact zero_mem _
  have hspan : x ∈ Ideal.span (Set.range Φ) := by
    refine Ideal.span_mono ?_ hmem
    rintro _ ⟨d, hd, rfl⟩
    exact ⟨d, by simp [Φ, hd]⟩
  obtain ⟨c, hc, hc0, hsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span I Φ ν hΦ hx hspan
  refine ⟨fun d => if ν d < n then c d else 0, fun d => ?_, fun d hd => by simp [hd], ?_⟩
  · simp only; split_ifs
    · exact hc d
    · exact zero_mem _
  · rw [hsum]
    refine Finset.sum_congr rfl fun d _ => ?_
    by_cases hd : ν d < n <;> simp [Φ, hd]

theorem Prop1Data.rho_initialForm (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (D : Prop1Data T J C.x₁ ν) (j : Fin m) :
    C.ρ hrat (initialForm (maximalIdeal T.ring) (D.h j)) = initialForm (maximalIdeal R) (D.f j) :=
  ((C.ordElem_le_and_rho_initialForm_eq hrat (D.f j) (ν j) (D.ordM j) (D.h j) (D.eq j)).2
    (D.ordM₁ j)).2

theorem Prop1Data.initialForm_f_mem_range (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (D : Prop1Data T J C.x₁ ν) (j : Fin m) :
    initialForm (maximalIdeal R) (D.f j) ∈ C.ι.range :=
  ⟨C.ρ₀ hrat (initialForm (maximalIdeal T.ring) (D.h j)), by
    show C.ι _ = _
    rw [C.ι_ρ₀, D.rho_initialForm C hrat j]⟩

/-- **The normalisation of the `f_j`, p. 237** ("Then, replacing each `f_j` by `f_j - Σ_{i<j} p_{ji} f_i`
with suitable `p_{ji} ∈ (x₁, …, x_r)^{ν_j-ν_i} R`, we may assume that `φ_j` is a form only in
`X₁, …, X_{τ_a}` for every `(j, a)` such that `ν_j ≤ μ^{(a)}(J)`"): if the flag `T₁ ⊆ … ⊆ T_t` is adapted
to the coordinates (`T_b` is generated by the classes `X₁, …, X_{τ_b}`), then (4), (5), (6) can be kept
while the initial form of every `f_j` lies in `k[T_b]`, where `μ^{(b)}(J) = ν_j`. -/
theorem Prop1Data.exists_normalized (hPM : P ≤ maximalIdeal R) (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (hflag : ∀ b, 1 ≤ b → b ≤ t R J → tauSubmodule R J b = Submodule.span (R ⧸ maximalIdeal R)
      ((fun k : Fin C.r => C.ι (X k)) '' {k | (k : ℕ) < tau R J b}))
    (hbex : ∀ j : Fin m, ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = ν j) (hνmono : Monotone ν)
    (htop : ∀ k : ℕ+, m < (k : ℕ) → nuI R J k = ⊤) (D : Prop1Data T J C.x₁ ν) :
    ∃ D' : Prop1Data T J C.x₁ ν, ∀ j, ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = ν j ∧
      initialForm (maximalIdeal R) (D'.f j) ∈
        Algebra.adjoin (R ⧸ maximalIdeal R) (tauSubmodule R J b : Set (AssocGraded (maximalIdeal R))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  -- one step: the replacement at index `j`
  have step : ∀ (D : Prop1Data T J C.x₁ ν) (j : Fin m), ∃ D' : Prop1Data T J C.x₁ ν,
      (∀ i, i ≠ j → D'.f i = D.f i) ∧ ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = ν j ∧
        initialForm (maximalIdeal R) (D'.f j) ∈
          Algebra.adjoin (R ⧸ maximalIdeal R) (tauSubmodule R J b : Set (AssocGraded (maximalIdeal R))) := by
    intro D j
    obtain ⟨bb, hb1, hbt, hbmu⟩ := hbex j
    have hspec := (tauSubmodule_spec R J bb hb1 hbt).1
    set φ : Fin m → AssocGraded (maximalIdeal R) := fun i => initialForm (maximalIdeal R) (D.f i)
      with hφ
    have hφdeg : ∀ i, φ i ∈ AssocGraded.homogeneous (maximalIdeal R) (ν i) := fun i => by
      show initialForm _ (D.f i) ∈ _
      rw [initialForm_eq_mk _ (D.ordM i)]; exact AssocGraded.mk_mem_homogeneous _ _
    have hφJ : ∀ i, φ i ∈ grIdeal (maximalIdeal R) J := fun i => Ideal.subset_span ⟨_, D.std.1 i, rfl⟩
    have hlow : ∀ d < ν j, ∀ w ∈ grIdeal (maximalIdeal R) J,
        w ∈ AssocGraded.homogeneous (maximalIdeal R) d →
        w ∈ Ideal.span {y | ∃ i, ν i < ν j ∧ y = φ i} := by
      intro d hd w hw hwd
      have := mem_span_initialForm_of_extendsToStandardBase_of_le J D.f
        ⟨m, D.f, le_rfl, D.std, fun _ => rfl⟩ hw hwd (by
          have : nuI R J (m : ℕ).succPNat = ⊤ := htop _ (by simp)
          rw [this]; exact ENat.coe_lt_top _)
      refine Ideal.span_mono ?_ this
      rintro x ⟨s, hs, rfl⟩
      refine ⟨s, ?_, rfl⟩
      rw [D.ordM s] at hs
      exact lt_of_le_of_lt (by exact_mod_cast hs) hd
    obtain ⟨φ', h1, h2, h3, h4⟩ := IsTauSubmoduleOfIdeal.exists_sub_mem_of_lt
      (𝔟 := Ideal.span {y | ∃ i, ν i < ν j ∧ y = φ i})
      (fun w hw e => AssocGraded.proj_mem_grIdeal _ _ hw e)
      ((isTauSubmodule_iff_isTauSubmoduleOfIdeal _ _ _).mp hspec) (le_of_eq hbmu.symm)
      (hφdeg j) (hφJ j) hlow
    obtain ⟨δ, hδh, hδ0, hδsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span_lt
      (maximalIdeal R) ν φ hφdeg (sub_mem (hφdeg j) h3) h4
    -- project onto `k[X₁, …, X_r]`
    have hTb : ∀ x ∈ (tauSubmodule R J bb : Set (AssocGraded (maximalIdeal R))), x ∈ C.ι.range := by
      intro x hx
      rw [SetLike.mem_coe, hflag bb hb1 hbt] at hx
      refine (Submodule.span_le (p := C.ι.range.toSubmodule)).mpr ?_ hx
      rintro _ ⟨k, -, rfl⟩
      exact ⟨X k, rfl⟩
    have hφ'ι : φ' ∈ C.ι.range := Algebra.adjoin_le (S := C.ι.range) hTb h2
    have hφι : ∀ i, φ i ∈ C.ι.range := fun i => D.initialForm_f_mem_range C hrat i
    let δ' : Fin m → MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R) := fun d => C.π₀ (δ d)
    have hδ'h : ∀ d, (δ' d).IsHomogeneous (ν j - ν d) := fun d => C.π₀_isHomogeneous (hδh d)
    have hproj : φ j = φ' + ∑ d, C.ι (δ' d) * φ d := by
      have h5 : φ j = φ' + ∑ d, δ d * φ d := by
        rw [← hδsum]; ring
      have h6 := congrArg (fun x => C.ι (C.π₀ x)) h5
      simp only [map_add, map_sum, map_mul] at h6
      rw [C.ι_π₀_of_mem_range (hφι j), C.ι_π₀_of_mem_range hφ'ι] at h6
      rw [h6]
      congr 1
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [C.ι_π₀_of_mem_range (hφι d)]
    -- lifts
    have hlift : ∀ d, ∃ (a : R) (b : T.ring) (hb : b ∈ maximalIdeal T.ring ^ (ν j - ν d))
        (ha : a ∈ P ^ (ν j - ν d)) (haM : a ∈ maximalIdeal R ^ (ν j - ν d)),
        C.x₁ ^ (ν j - ν d) * b = T.toRing a ∧
        AssocGraded.mk (maximalIdeal T.ring) (ν j - ν d) b hb = C.ι₁ hrat (δ' d) ∧
        AssocGraded.mk (maximalIdeal R) (ν j - ν d) a haM = C.ι (δ' d) ∧
        (¬ (d < j ∧ ν d < ν j) → a = 0 ∧ b = 0) := by
      intro d
      by_cases hd : ν d < ν j
      · obtain ⟨a, b, hb, ha, haM, hab, hmb, hma⟩ := C.exists_lift_pure hrat (hδ'h d)
        have hdj : d < j := by
          by_contra hdj
          exact absurd (hνmono (not_lt.mp hdj)) (not_le.mpr hd)
        exact ⟨a, b, hb, ha, haM, hab, hmb, hma, fun hc => absurd ⟨hdj, hd⟩ hc⟩
      · have hz : δ d = 0 := hδ0 d hd
        have hz' : δ' d = 0 := by simp [δ', hz]
        refine ⟨0, 0, zero_mem _, zero_mem _, zero_mem _, by simp, ?_, ?_, fun _ => ⟨rfl, rfl⟩⟩
        · rw [hz', map_zero]
          exact AssocGraded.mk_eq_zero_of_eq_zero' _ rfl _
        · rw [hz', map_zero]
          exact AssocGraded.mk_eq_zero_of_eq_zero' _ rfl _
    choose a b hb ha haM hab hmb hma h0 using hlift
    obtain ⟨D', hne, hfj, hhj, hinitf, hinith⟩ := D.exists_replace hPM j a b
      (fun d hd => (h0 d hd).1) (fun d hd => (h0 d hd).2) ha haM hb hab
    refine ⟨D', fun i hi => (hne i hi).1, bb, hb1, hbt, hbmu, ?_⟩
    rw [hinitf]
    have hsum : ∑ d, AssocGraded.mk (maximalIdeal R) (ν j - ν d) (a d) (haM d) *
        initialForm (maximalIdeal R) (D.f d) = ∑ d, C.ι (δ' d) * φ d :=
      Finset.sum_congr rfl fun d _ => by rw [hma d]
    rw [hsum]
    have : initialForm (maximalIdeal R) (D.f j) - ∑ d, C.ι (δ' d) * φ d = φ' := by
      have h7 : initialForm (maximalIdeal R) (D.f j) = φ j := rfl
      rw [h7, hproj]; ring
    rw [this]
    exact h2
  have key : ∀ n, n ≤ m → ∃ D' : Prop1Data T J C.x₁ ν, ∀ j : Fin m, (j : ℕ) < n →
      ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = ν j ∧ initialForm (maximalIdeal R) (D'.f j) ∈
        Algebra.adjoin (R ⧸ maximalIdeal R) (tauSubmodule R J b : Set (AssocGraded (maximalIdeal R))) := by
    intro n
    induction n with
    | zero => intro _; exact ⟨D, fun j hj => absurd hj (by omega)⟩
    | succ n ih =>
      intro hn
      obtain ⟨D', hD'⟩ := ih (by omega)
      have hnm : n < m := by omega
      obtain ⟨D'', hne, hjprop⟩ := step D' ⟨n, hnm⟩
      refine ⟨D'', fun j hj => ?_⟩
      by_cases hjn : (j : ℕ) = n
      · have : j = ⟨n, hnm⟩ := Fin.ext hjn
        rw [this]; exact hjprop
      · have hjn' : (j : ℕ) < n := by omega
        obtain ⟨b, hb1, hbt, hbmu, hmem⟩ := hD' j hjn'
        exact ⟨b, hb1, hbt, hbmu, by rw [hne j (fun h => hjn (by rw [h]))]; exact hmem⟩
  obtain ⟨D', hD'⟩ := key m le_rfl
  exact ⟨D', fun j => hD' j j.2⟩

end Norm

section Elim

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]
  {J : Ideal R} {m : ℕ} {ν : Fin m → ℕ}

/-- **The elimination of the `λ_j`, pp. 237–238.**  "`ψ_j = φ_j(X̄₁, …, X̄_r) + λ_j`; Proposition 1 follows
if `λ_j = 0` for all `j`.  Suppose we have `j` such that `λ_i = 0` for `1 ≤ i < j` and `λ_j ≠ 0`.  The
assumption that `Q₁` is a permissible center for `J₁` implies that there exist forms `δ_{ji}` of degree
`ν_j - ν_i` in `(X, Y₁, …, Y_s) gr_{M₁}(R₁)` \dots such that `ψ_j - Σ δ_{ji} ψ_i` is a form only in
`X̄₁, …, X̄_r`. \dots We may replace `f_j` by `f_j - Σ (x^{ν_j-ν_i} h_{ji}) f_i` without affecting the
assumptions (4), (5) and (6).  Then, after this replacement, we get that `λ_i = 0` for all `i ≤ j`.  By
repeating this process (at most `m` times), we can get `(f₁, …, f_m)` with `λ_j = 0` for all `j`."
Here "`λ_j = 0`" is "`ψ_j` is a form only in `X̄₁, …, X̄_r`" (`ψ_j ∈ range ι₁`), and the initial forms
`φ_j` of the `f_j` are not changed by the replacements. -/
theorem Prop1Data.exists_lambda_zero (hPM : P ≤ maximalIdeal R) (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (hνmono : Monotone ν)
    (htop₁ : ∀ k : ℕ+, m < (k : ℕ) → nuI T.ring (strictTransformIdeal T J) k = ⊤)
    {m' : ℕ} (G : Fin m' → AssocGraded (maximalIdeal T.ring)) (d : Fin m' → ℕ)
    (hG : ∀ l, G l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (d l))
    (hGι : ∀ l, G l ∈ (C.ι₁ hrat).range)
    (hGJ : ∀ l, G l ∈ grIdeal (maximalIdeal T.ring) (strictTransformIdeal T J))
    (hGgen : grIdeal (maximalIdeal T.ring) (strictTransformIdeal T J) ≤ Ideal.span (Set.range G))
    (D : Prop1Data T J C.x₁ ν) :
    ∃ D' : Prop1Data T J C.x₁ ν,
      (∀ j, initialForm (maximalIdeal R) (D'.f j) = initialForm (maximalIdeal R) (D.f j)) ∧
      ∀ j, initialForm (maximalIdeal T.ring) (D'.h j) ∈ (C.ι₁ hrat).range := by
  classical
  have step : ∀ (E : Prop1Data T J C.x₁ ν) (j : Fin m), ∃ E' : Prop1Data T J C.x₁ ν,
      (∀ i, i ≠ j → E'.f i = E.f i ∧ E'.h i = E.h i) ∧
      initialForm (maximalIdeal R) (E'.f j) = initialForm (maximalIdeal R) (E.f j) ∧
      initialForm (maximalIdeal T.ring) (E'.h j) ∈ (C.ι₁ hrat).range := by
    intro E j
    set ψ : Fin m → AssocGraded (maximalIdeal T.ring) := fun i => initialForm (maximalIdeal T.ring) (E.h i)
      with hψ
    have hψdeg : ∀ i, ψ i ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν i) := fun i => by
      show initialForm _ (E.h i) ∈ _
      rw [initialForm_eq_mk _ (E.ordM₁ i)]; exact AssocGraded.mk_mem_homogeneous _ _
    have hhJ₁ : ∀ i, E.h i ∈ strictTransformIdeal T J := fun i => by
      obtain ⟨m', G', him', hG', hGh⟩ := E.ext
      rw [← hGh i]; exact hG'.1 _
    have hψJ : ∀ i, ψ i ∈ grIdeal (maximalIdeal T.ring) (strictTransformIdeal T J) := fun i =>
      Ideal.subset_span ⟨_, hhJ₁ i, rfl⟩
    have hGψ : ∀ l, G l ∈ Ideal.span (Set.range ψ) := fun l =>
      mem_span_initialForm_of_extendsToStandardBase_of_lt_nuI _ E.h E.ext (hGJ l) (hG l)
        (by rw [htop₁ _ (by simp)]; exact ENat.coe_lt_top _)
    obtain ⟨δ, hδρ, hδh, hδ0, hδr⟩ := C.exists_delta hrat ν hνmono ψ hψdeg G d hG hGι hGψ j
      (hGgen (hψJ j))
    have hlift : ∀ i, ∃ (a : R) (b : T.ring) (hb : b ∈ maximalIdeal T.ring ^ (ν j - ν i))
        (ha : a ∈ P ^ (ν j - ν i)) (haM : a ∈ maximalIdeal R ^ (ν j - ν i + 1)),
        C.x₁ ^ (ν j - ν i) * b = T.toRing a ∧
        AssocGraded.mk (maximalIdeal T.ring) (ν j - ν i) b hb = δ i ∧
        (¬ (i < j ∧ ν i < ν j) → a = 0 ∧ b = 0) := by
      intro i
      by_cases hi : ν i < ν j
      · obtain ⟨a, b, hb, ha, haM, hab, hmb⟩ := C.exists_lift_ker hrat (by omega) (hδh i) (hδρ i)
        refine ⟨a, b, hb, ha, haM, hab, hmb, fun hc => absurd ⟨?_, hi⟩ hc⟩
        by_contra hij
        exact absurd (hνmono (not_lt.mp hij)) (not_le.mpr hi)
      · have hz : δ i = 0 := hδ0 i (fun h => hi h.2)
        refine ⟨0, 0, zero_mem _, zero_mem _, zero_mem _, by simp, ?_, fun _ => ⟨rfl, rfl⟩⟩
        rw [hz]; exact AssocGraded.mk_eq_zero_of_eq_zero' _ rfl _
    choose a b hb ha haM1 hab hmb h0 using hlift
    have haM : ∀ i, a i ∈ maximalIdeal R ^ (ν j - ν i) := fun i =>
      Ideal.pow_le_pow_right (Nat.le_succ _) (haM1 i)
    obtain ⟨E', hne, hfj, hhj, hinitf, hinith⟩ := E.exists_replace hPM j a b
      (fun i hi => (h0 i hi).1) (fun i hi => (h0 i hi).2) ha haM hb hab
    refine ⟨E', hne, ?_, ?_⟩
    · rw [hinitf]
      have : ∀ i, AssocGraded.mk (maximalIdeal R) (ν j - ν i) (a i) (haM i) = 0 := fun i =>
        (AssocGraded.mk_eq_zero_iff _ _).mpr (haM1 i)
      simp [this]
    · rw [hinith]
      have : ∑ i, AssocGraded.mk (maximalIdeal T.ring) (ν j - ν i) (b i) (hb i) *
          initialForm (maximalIdeal T.ring) (E.h i) = ∑ i, δ i * ψ i :=
        Finset.sum_congr rfl fun i _ => by rw [hmb i]
      rw [this]
      exact hδr
  have key : ∀ n, n ≤ m → ∃ D' : Prop1Data T J C.x₁ ν,
      (∀ j, initialForm (maximalIdeal R) (D'.f j) = initialForm (maximalIdeal R) (D.f j)) ∧
      ∀ j : Fin m, (j : ℕ) < n → initialForm (maximalIdeal T.ring) (D'.h j) ∈ (C.ι₁ hrat).range := by
    intro n
    induction n with
    | zero => intro _; exact ⟨D, fun _ => rfl, fun j hj => absurd hj (by omega)⟩
    | succ n ih =>
      intro hn
      obtain ⟨D', hD'f, hD'h⟩ := ih (by omega)
      have hnm : n < m := by omega
      obtain ⟨D'', hne, hf, hh⟩ := step D' ⟨n, hnm⟩
      refine ⟨D'', fun j => ?_, fun j hj => ?_⟩
      · by_cases hjn : j = ⟨n, hnm⟩
        · rw [hjn, hf, hD'f]
        · rw [(hne j hjn).1, hD'f]
      · by_cases hjn : (j : ℕ) = n
        · have : j = ⟨n, hnm⟩ := Fin.ext hjn
          rw [this]; exact hh
        · have hjn' : (j : ℕ) < n := by omega
          have hjne : j ≠ ⟨n, hnm⟩ := fun h => hjn (by rw [h])
          rw [(hne j hjne).2]
          exact hD'h j hjn'
  obtain ⟨D', hD'f, hD'h⟩ := key m le_rfl
  exact ⟨D', hD'f, fun j => hD'h j j.2⟩

end Elim

section Final

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

theorem mu_lt_mu_of_lt {S : Type u} [CommRing S] [IsRegularLocalRing S] (J : Ideal S) {a b : ℕ}
    (ha : 1 ≤ a) (hab : a < b) (hbt : b ≤ t S J) : mu S J a < mu S J b := by
  have hfin := (muSet_finite S J).1
  have hcard : b - 1 < hfin.toFinset.card := by
    rw [← Set.ncard_eq_toFinset_card _ hfin]
    have : t S J = (muSet S J).ncard := rfl
    omega
  exact Nat.nth_strictMonoOn hfin (by simp only [Set.mem_Iio]; exact lt_trans (by omega) hcard)
    (by simp only [Set.mem_Iio]; exact hcard) (by omega)

theorem tau_mono_of_le {S : Type u} [CommRing S] [IsRegularLocalRing S] (J : Ideal S) {a b : ℕ}
    (hb : 1 ≤ b) (hba : b ≤ a) (hat : a ≤ t S J) : tau S J b ≤ tau S J a := by
  rw [← (tauSubmodule_spec S J b hb (hba.trans hat)).2.1,
    ← (tauSubmodule_spec S J a (hb.trans hba) hat).2.1]
  have := finiteDimensional_tauSubmodule J a
  exact Submodule.finrank_mono (tauSubmodule_mono_of_le J hb hba hat)

theorem TransformCoord.ι₁_C (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (c : R ⧸ maximalIdeal R) :
    C.ι₁ hrat (MvPolynomial.C c) = algebraMap _ (AssocGraded (maximalIdeal T.ring))
      (T.residueEquiv hrat c) := by
  show C.e₁ (MvPolynomial.map (T.residueEquiv hrat).toRingHom (pureInclude C.r C.s _ (MvPolynomial.C c))) = _
  rw [show pureInclude C.r C.s _ (MvPolynomial.C c) = MvPolynomial.C c from (pureInclude C.r C.s _).commutes c,
    MvPolynomial.map_C, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
  rfl

theorem TransformCoord.ι₁_X (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (k : Fin C.r) :
    C.ι₁ hrat (X k) = C.e₁ (X (some (Sum.inl k))) := by
  show C.e₁ (MvPolynomial.map (T.residueEquiv hrat).toRingHom (pureInclude C.r C.s _ (X k))) = _
  simp [pureInclude]

/-- `ι` maps `k[span X_k : k ∈ s]` onto `k[span ι(X_k)]`. -/
theorem TransformCoord.exists_mem_adjoin_ι_eq (C : TransformCoord T) (s : Set (Fin C.r))
    {x : AssocGraded (maximalIdeal R)}
    (hx : x ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R) ((fun k : Fin C.r => C.ι (X k)) '' s) :
        Set (AssocGraded (maximalIdeal R)))) :
    ∃ p ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R)
        ((fun k : Fin C.r => (X k : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))) '' s) :
        Set (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))), C.ι p = x := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    have : ∃ p ∈ Submodule.span (R ⧸ maximalIdeal R)
        ((fun k : Fin C.r => (X k : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))) '' s), C.ι p = y := by
      induction hy using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨k, hk, rfl⟩ := hz
        exact ⟨X k, Submodule.subset_span ⟨k, hk, rfl⟩, rfl⟩
      | zero => exact ⟨0, zero_mem _, map_zero _⟩
      | add u v _ _ hu hv =>
        obtain ⟨p, hp, rfl⟩ := hu
        obtain ⟨q, hq, rfl⟩ := hv
        exact ⟨p + q, add_mem hp hq, map_add _ _ _⟩
      | smul c u _ hu =>
        obtain ⟨p, hp, rfl⟩ := hu
        exact ⟨c • p, Submodule.smul_mem _ _ hp, map_smul _ _ _⟩
    obtain ⟨p, hp, hpy⟩ := this
    exact ⟨p, Algebra.subset_adjoin hp, hpy⟩
  | algebraMap c => exact ⟨algebraMap _ _ c, Subalgebra.algebraMap_mem _ _, AlgHom.commutes _ _⟩
  | add u v _ _ hu hv =>
    obtain ⟨p, hp, rfl⟩ := hu
    obtain ⟨q, hq, rfl⟩ := hv
    exact ⟨p + q, add_mem hp hq, map_add _ _ _⟩
  | mul u v _ _ hu hv =>
    obtain ⟨p, hp, rfl⟩ := hu
    obtain ⟨q, hq, rfl⟩ := hv
    exact ⟨p * q, mul_mem hp hq, map_mul _ _ _⟩

/-- `ι₁` maps `k[span X_k : k ∈ s]` into `k₁[span X̄_k : k ∈ s]`. -/
theorem TransformCoord.ι₁_mem_adjoin (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (s : Set (Fin C.r))
    {p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)}
    (hp : p ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R)
        ((fun k : Fin C.r => (X k : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))) '' s) :
        Set (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)))) :
    C.ι₁ hrat p ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
      (Submodule.span (T.ring ⧸ maximalIdeal T.ring)
        ((fun k : Fin C.r => C.e₁ (X (some (Sum.inl k)))) '' s) :
        Set (AssocGraded (maximalIdeal T.ring))) := by
  induction hp using Algebra.adjoin_induction with
  | mem y hy =>
    refine Algebra.subset_adjoin ?_
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨k, hk, rfl⟩ := hz
      rw [C.ι₁_X hrat]
      exact Submodule.subset_span ⟨k, hk, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add u v _ _ hu hv => rw [map_add]; exact add_mem hu hv
    | smul c u _ hu =>
      rw [Algebra.smul_def, map_mul, MvPolynomial.algebraMap_eq, TransformCoord.ι₁_C]
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ _ hu
  | algebraMap c =>
    rw [MvPolynomial.algebraMap_eq, TransformCoord.ι₁_C]
    exact Subalgebra.algebraMap_mem _ _
  | add u v _ _ hu hv => rw [map_add]; exact add_mem hu hv
  | mul u v _ _ hu hv => rw [map_mul]; exact mul_mem hu hv

variable {J : Ideal R} {m : ℕ} {ν : Fin m → ℕ}

/-- **"Proposition 1 follows if `λ_j = 0` for all `j`"** (p. 237; the paper gives no argument): if the
`f_j` are normalised so that `φ_j ∈ k[T_b]` (`μ^{(b)}(J) = ν_j`, `T_b` generated by `X₁, …, X_{τ_b}`) and
`ψ_j = φ_j(X̄₁, …, X̄_r)` is a form only in `X̄₁, …, X̄_r`, then `ψ_j ∈ k[X̄₁, …, X̄_{τ_b}]`, so the
`k`-submodule `T̃'` generated by `X̄₁, …, X̄_{τ_a}` has the property of Definition 6 for `J₁` up to
`μ^{(a)}(J₁) = μ^{(a)}(J)`, hence `τ^{(a)}(J₁) ≤ τ_a = τ^{(a)}(J)`. -/
theorem Prop1Data.tau_le_of_normalized (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (htop₁ : ∀ k : ℕ+, m < (k : ℕ) → nuI T.ring (strictTransformIdeal T J) k = ⊤)
    (D : Prop1Data T J C.x₁ ν)
    (hflag : ∀ b, 1 ≤ b → b ≤ t R J → tauSubmodule R J b = Submodule.span (R ⧸ maximalIdeal R)
      ((fun k : Fin C.r => C.ι (X k)) '' {k | (k : ℕ) < tau R J b}))
    (hτr : ∀ b, 1 ≤ b → b ≤ t R J → tau R J b ≤ C.r)
    (hnorm : ∀ j, ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = ν j ∧
      initialForm (maximalIdeal R) (D.f j) ∈
        Algebra.adjoin (R ⧸ maximalIdeal R) (tauSubmodule R J b : Set (AssocGraded (maximalIdeal R))))
    (hlam : ∀ j, initialForm (maximalIdeal T.ring) (D.h j) ∈ (C.ι₁ hrat).range)
    (hmu : ∀ a, mu T.ring (strictTransformIdeal T J) a = mu R J a) {a : ℕ} (ha : 1 ≤ a)
    (hat : a ≤ t R J) : tau T.ring (strictTransformIdeal T J) a ≤ tau R J a := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  set J₁ := strictTransformIdeal T J with hJ₁
  have hτa : tau R J a ≤ C.r := hτr a ha hat
  let W : Fin (tau R J a) → AssocGraded (maximalIdeal T.ring) := fun l =>
    C.e₁ (X (some (Sum.inl ⟨l, lt_of_lt_of_le l.2 hτa⟩)))
  have hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := fun l =>
    C.e₁_mem_homogeneous (isHomogeneous_X _ _)
  have hhJ₁ : ∀ i, D.h i ∈ J₁ := fun i => by
    obtain ⟨m', G', him', hG', hGh⟩ := D.ext
    rw [← hGh i]; exact hG'.1 _
  have hψJ : ∀ i, initialForm (maximalIdeal T.ring) (D.h i) ∈ grIdeal (maximalIdeal T.ring) J₁ :=
    fun i => Ideal.subset_span ⟨_, hhJ₁ i, rfl⟩
  have hS : IsTauSubmodule T.ring J₁ (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W))
      (mu T.ring J₁ a) := by
    refine ⟨Submodule.span_le.mpr ?_, fun μ hμ ψ hψ => ⟨fun hψJ' => ?_, fun h =>
      (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩
    · rintro _ ⟨l, rfl⟩; exact hW1 l
    · rw [hmu a] at hμ
      have hgen := mem_span_initialForm_of_extendsToStandardBase_of_le J₁ D.h D.ext hψJ' hψ
        (by rw [htop₁ _ (by simp)]; exact ENat.coe_lt_top _)
      refine (Ideal.span_le.mpr ?_) hgen
      rintro _ ⟨s, hs, rfl⟩
      refine Ideal.subset_span ⟨hψJ s, ?_⟩
      rw [D.ordM₁ s] at hs
      have hνs : ν s ≤ mu R J a := le_trans (by exact_mod_cast hs) hμ
      obtain ⟨b, hb1, hbt, hbmu, hmem⟩ := hnorm s
      have hba : b ≤ a := by
        by_contra hab
        have := mu_lt_mu_of_lt J ha (not_le.mp hab) hbt
        omega
      -- `φ_s ∈ k[T_b]`, so `ρ₀ ψ_s ∈ k[X₁, …, X_{τ_b}]`
      obtain ⟨p, hp⟩ := hlam s
      have hρp : C.ρ₀ hrat (initialForm (maximalIdeal T.ring) (D.h s)) = p := by
        rw [← hp, C.ρ₀_ι₁]
      rw [hflag b hb1 hbt] at hmem
      obtain ⟨p', hp', hιp'⟩ := C.exists_mem_adjoin_ι_eq {k | (k : ℕ) < tau R J b} hmem
      have hιp : C.ι p = initialForm (maximalIdeal R) (D.f s) := by
        rw [← hρp, C.ι_ρ₀, D.rho_initialForm C hrat s]
      have hpp : p = p' := C.ι_injective (hιp.trans hιp'.symm)
      have h1 := C.ι₁_mem_adjoin hrat {k | (k : ℕ) < tau R J b} hp'
      have hψeq : initialForm (maximalIdeal T.ring) (D.h s) = C.ι₁ hrat p' := by
        rw [← hp, hpp]
      rw [hψeq]
      have hgens : (fun k : Fin C.r => C.e₁ (X (some (Sum.inl k)))) '' {k | (k : ℕ) < tau R J b} ⊆
          Set.range W := by
        rintro _ ⟨k, hk, rfl⟩
        exact ⟨⟨k, lt_of_lt_of_le hk (tau_mono_of_le J hb1 hba hat)⟩, rfl⟩
      exact Algebra.adjoin_mono (fun x hx => Submodule.span_mono hgens hx) h1
  exact tau_le T.ring J₁ W hW1 hS

end Final

section MainAux

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} [IsRegularLocalRing T.ring]

theorem TransformCoord.x'_mem (C : TransformCoord T) (l : Fin C.r) :
    C.x' l ∈ maximalIdeal T.ring ^ 1 := by
  rw [pow_one, ← C.hM₁]; exact Ideal.subset_span ⟨some (Sum.inl l), rfl⟩

theorem TransformCoord.mem_range_ι₁_of_mem_adjoin_mk_x' (C : TransformCoord T)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
      (Set.range fun l : Fin C.r => AssocGraded.mk (maximalIdeal T.ring) 1 (C.x' l) (C.x'_mem l))) :
    x ∈ (C.ι₁ hrat).range := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨l, rfl⟩ := hy
    exact ⟨MvPolynomial.X l, by rw [C.ι₁_X hrat, TransformCoord.e₁_X]; rfl⟩
  | algebraMap c =>
    exact ⟨MvPolynomial.C ((T.residueEquiv hrat).symm c), by
      rw [C.ι₁_C hrat, RingEquiv.apply_symm_apply]⟩
  | add u v _ _ hu hv =>
    obtain ⟨p, rfl⟩ := hu
    obtain ⟨q, rfl⟩ := hv
    exact ⟨p + q, map_add _ _ _⟩
  | mul u v _ _ hu hv =>
    obtain ⟨p, rfl⟩ := hu
    obtain ⟨q, rfl⟩ := hv
    exact ⟨p * q, map_mul _ _ _⟩

theorem exists_mu_eq_of_mem_muSet_all {S : Type u} [CommRing S] [IsRegularLocalRing S] (J : Ideal S)
    {x : ℕ} (hx : x ∈ muSet S J) : ∃ b, 1 ≤ b ∧ b ≤ t S J ∧ mu S J b = x := by
  classical
  have hfin := (muSet_finite S J).1
  have hcard : Nat.count (· ∈ muSet S J) x < t S J := by
    have : t S J = hfin.toFinset.card := Set.ncard_eq_toFinset_card _ hfin
    rw [this]
    exact Nat.count_lt_card hfin hx
  refine ⟨Nat.count (· ∈ muSet S J) x + 1, by omega, by omega, ?_⟩
  rw [mu, Nat.add_sub_cancel]
  exact Nat.nth_count hx

theorem span_range_linear_eq {S : Type*} [CommRing S] {n : ℕ} (A : Matrix (Fin n) (Fin n) S)
    (hA : IsUnit A.det) (x : Fin n → S) :
    Ideal.span (Set.range fun i => ∑ k, A i k * x k) = Ideal.span (Set.range x) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact sum_mem fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    rw [sum_inv_mul_sum_eq A hA x k]
    exact sum_mem fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

end MainAux

/-! ### Proposition 1 in the residually rational case (pp. 237–238) -/

/-- **Proposition 1 in the residually rational case** (pp. 237–238), along the printed route.  The
hypotheses on `Q₁` are those used in the proof: `Q R₁ ⊆ Q₁`, `P R₁ ⊄ Q₁` (i.e. `x ∉ Q₁`), and `Q₁` is
contained in the strict transform of `Q` (which holds when `Q₁ ∩ R = Q`).

The steps are the printed ones, in the printed order (see the comments in the proof and the docstrings of
the lemmas quoted):
* "we have a regular system of parameters `(x, x₁, …, x_r, y₁, …, y_s)` of `R` such that (1)
  `P = (x, x₁, …, x_r)R`, (2) `Q ⊆ (x₁, …, x_r)R`, and (3) `(x, x₁/x, …, x_r/x, y₁, …, y_s)` is a regular
  system of parameters of `R₁`, so that `Q₁ ⊆ (x₁/x, …, x_r/x)R₁`"
  (`TransformCoord.exists_change_of_prime`, `TransformCoord.le_span_x'_of_le_strictTransform`);
* "By virtue of Lemma 14, the assumption `ν*(J₁) = ν*(J)` implies that there exists a standard base
  `(f₁, …, f_m)` of `J` such that (4), (5), (6)" (`Prop1Data`, `exists_standardBase_extendsToStandardBase`);
* "the `φ_j` are all forms only in `X₁, …, X_r` by (4) and (5)" (Claim A, `Prop1Data.initialForm_f_mem_range`);
* "applying a suitable linear transformation to `(x₁, …, x_r)` with coefficients in `R`, we may assume that
  `(x₁, …, x_{τ_a})` is a regular system of `a`-th `τ`-parameters" (`TransformCoord.exists_change_tau`);
* "replacing each `f_j` by `f_j - Σ p_{ji} f_i` with suitable `p_{ji} ∈ (x₁, …, x_r)^{ν_j-ν_i}R`, we may
  assume that `φ_j` is a form only in `X₁, …, X_{τ_a}`" (`Prop1Data.exists_normalized`);
* the elimination of the `λ_j` with the forms `δ_{ji}` (from the permissibility of `Q₁`) and the replacements
  `f_j - Σ (x^{ν_j-ν_i} h_{ji}) f_i` (`TransformCoord.exists_delta`, `TransformCoord.exists_lift_ker`,
  `Prop1Data.exists_replace`, `Prop1Data.exists_lambda_zero`);
* "Proposition 1 follows if `λ_j = 0` for all `j`" (not argued in the paper): `τ^{(a)}(J₁) ≤ τ^{(a)}(J)`
  (`Prop1Data.tau_le_of_normalized`) and `τ^{(a)}(J) ≤ τ^{(a)}(J₁)` (Lemma 15, `tau_le_tau_strictTransform`).

Gaps of the paper which are filled: the existence of the coordinates (1)–(3); that `Q₁ ⊆ (x₁/x, …, x_r/x)R₁`;
the existence of the forms `δ_{ji}` and of the `h_{ji}` with `x^{ν_j-ν_i} h_{ji} ∈ P^{ν_j-ν_i}`; that the
replacements do not change (4), (5), (6); the final step.  Misprints of the paper (the order in (5), the index
range `1 ≤ i ≤ j`, the last factor `f_j` in the replacement) are read as intended. -/
theorem tauStar_strictTransform_eq_of_isResiduallyRational (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [IsDomain R]
    (P Q J : Ideal R) [P.IsPrime] [Q.IsPrime] (hQP : Q ≤ P) (hJQ : J ≤ Q)
    [IsRegularLocalRing (R ⧸ Q)] (hperm : IsPermissibleCenter R J P)
    (T : MonoidalTransform R P) [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (Q₁ : Ideal T.ring) [Q₁.IsPrime] (hQQ₁ : Q.map T.toRing ≤ Q₁)
    (hPQ₁ : ¬ P.map T.toRing ≤ Q₁) (hQ₁s : Q₁ ≤ strictTransformIdeal T Q)
    (hnu : nuStar T.ring (strictTransformIdeal T J) = nuStar R J)
    (hperm₁ : IsPermissibleCenter T.ring (strictTransformIdeal T J) Q₁) :
    t T.ring (strictTransformIdeal T J) = t R J ∧
      ∀ i, 1 ≤ i → i ≤ t R J → tau T.ring (strictTransformIdeal T J) i = tau R J i := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  have hJP : J ≤ P := hJQ.trans hQP
  have hnuI : ∀ i, nuI T.ring J₁ i = nuI R J i := fun i => congrFun (toLex.injective hnu) i
  have hmuSet : muSet T.ring J₁ = muSet R J := by
    ext μ
    simp only [muSet, Set.mem_ofPred_eq, hnuI]
  have ht : t T.ring J₁ = t R J := by rw [t, t, hmuSet]
  have hmu : ∀ a, mu T.ring J₁ a = mu R J a := fun a => by rw [mu, mu, hmuSet]
  refine ⟨ht, fun a ha hat => ?_⟩
  have hPM : P ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
  obtain ⟨-, -, hS, hNF⟩ := hperm.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  have _ : IsRegularLocalRing (R ⧸ P) := hS
  obtain ⟨C₀⟩ := TransformCoord.nonempty T hrat
  -- (4), (5), (6) of the proof (Lemma 14): a standard base `(f_j)` of `J` with `ν_P(f_j) = ν_j` ...
  obtain ⟨m, f, hf, hfP⟩ := ((isPermissibleCenter_tfae R J P hJP).out 1 3).mp hNF
  obtain ⟨⟨d, -, hνd⟩, htop⟩ := nuI_eq_of_hasLemma1Properties R J _ hf.2
  have hν : ∀ j : Fin m, (d j : ℕ∞) = nuI R J ((j : ℕ).succPNat) := fun j => (hνd j).symm
  have hm : 0 < m := by
    by_contra h0
    have hempty : muSet R J = ∅ := by
      ext μ
      simp only [muSet, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨k, hk⟩
      rw [htop k (by have := k.pos; omega)] at hk
      exact ENat.top_ne_natCast _ hk
    have : t R J = 0 := by rw [t, hempty, Set.ncard_empty]
    omega
  set i : ℕ+ := ⟨m, hm⟩ with hi
  have hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
      toLex fun j : Fin (i : ℕ) => nuI T.ring J₁ ((j : ℕ).succPNat) :=
    le_of_eq (congrArg toLex (funext fun j => (hnuI _).symm))
  obtain ⟨⟨g, hg, hgP, hx⟩, -⟩ := exists_standardBase_extendsToStandardBase R P J hJP T hrat f i
    le_rfl d hν hf (fun j _ => (hfP j).trans (hν j).symm) hlex
  obtain ⟨h, hgh, hhν, hext⟩ := hx C₀.x₁ C₀.span_x₁
  have hνmono : Monotone d := fun x y hxy => by
    have := nuI_mono J (show ((x : ℕ).succPNat) ≤ ((y : ℕ).succPNat) from by
      rw [← PNat.coe_le_coe]; simp; exact hxy)
    rw [← hν x, ← hν y] at this
    exact_mod_cast this
  have htop' : ∀ k : ℕ+, m < (k : ℕ) → nuI R J k = ⊤ := fun k hk => htop k hk
  have htop₁ : ∀ k : ℕ+, m < (k : ℕ) → nuI T.ring J₁ k = ⊤ := fun k hk => by
    rw [hnuI]; exact htop' k hk
  have hbex : ∀ j : Fin m, ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = d j := fun j =>
    exists_mu_eq_of_mem_muSet_all J ⟨((j : ℕ)).succPNat, (hν j).symm⟩
  -- the data of (4), (5), (6)
  let D₀ : Prop1Data T J C₀.x₁ d :=
    { f := g
      h := h
      std := hg
      ordM := fun j => (ordElem_eq_nuI_of_isStandardBase J g hg j).trans (hν j).symm
      ordP := fun j => hgP j j.2
      eq := fun j => hgh j
      ordM₁ := fun j => hhν j
      ext := hext }
  -- coordinates (1), (2), (3): `Q ⊆ (x₁, …, x_r)R`
  obtain ⟨A₁, hA₁, b₁, hb₁, hQx₁⟩ := C₀.exists_change_of_prime Q hQP inferInstance Q₁ hQQ₁ hPQ₁
  let C₁ := C₀.change A₁ hA₁ b₁ hb₁
  -- `T_t` lies in the linear part of `k[X₁, …, X_r]`
  have ht1 : 1 ≤ t R J := ha.trans hat
  obtain ⟨ib, hib⟩ := exists_isGreatest_nuI_eq_mu J (t R J) ht1 le_rfl
  have hibm : (ib : ℕ) ≤ m := by
    by_contra hlt
    have := htop' ib (by omega)
    have h1 := hib.1
    simp only [Set.mem_ofPred_eq] at h1
    rw [this] at h1
    exact ENat.top_ne_natCast _ h1
  have hlin := (C₁.tauSubmodule_le_of_le_index R P J T hrat g hg d hν (t R J) ht1 le_rfl ib hib m hibm
    le_rfl (fun j _ => (hnuI j).symm) h (fun j => hgh j)
    (fun j => hhν j) hext).2.2.1
  -- "applying a suitable linear transformation to `(x₁, …, x_r)`": `(x₁, …, x_{τ_a})` is a regular system
  -- of `a`-th `τ`-parameters
  obtain ⟨A₂, hA₂, hτr, hflag⟩ := C₁.exists_change_tau J hlin
  let C := C₁.change A₂ hA₂ (fun _ => 0) (fun _ => zero_mem _)
  have hQx : Q ≤ Ideal.span (Set.range C.x) := by
    refine hQx₁.trans (le_of_eq ?_)
    rw [← span_range_linear_eq A₂ hA₂ C₁.x]
    congr 1
    ext w
    simp only [Set.mem_range]
    constructor
    · rintro ⟨i, rfl⟩; exact ⟨i, by simp [C, TransformCoord.change]⟩
    · rintro ⟨i, rfl⟩; exact ⟨i, by simp [C, TransformCoord.change]⟩
  have hQ₁U : Q₁ ≤ Ideal.span (Set.range C.x') := C.le_span_x'_of_le_strictTransform Q hQx Q₁ hQ₁s
  -- the data `D₀` for the coordinates `C` (`x₁` is unchanged)
  let D₁ : Prop1Data T J C.x₁ d := D₀
  -- normalisation: `φ_j` is a form only in `X₁, …, X_{τ_b}`
  obtain ⟨D₂, hD₂⟩ := D₁.exists_normalized hPM C hrat hflag hbex hνmono htop'
  -- permissibility of `Q₁`: a standard base `(g'_l)` of `J₁` with initial forms in `k[X̄₁, …, X̄_r]`
  obtain ⟨-, hJ₁Q₁, hSQ₁, hNF₁⟩ := hperm₁.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  have _ : IsRegularLocalRing (T.ring ⧸ Q₁) := hSQ₁
  obtain ⟨m', g', hg', hg'Q⟩ := ((isPermissibleCenter_tfae T.ring J₁ Q₁ hJ₁Q₁).out 1 3).mp hNF₁
  let G : Fin m' → AssocGraded (maximalIdeal T.ring) := fun l => initialForm (maximalIdeal T.ring) (g' l)
  have hGι : ∀ l, G l ∈ (C.ι₁ hrat).range := by
    intro l
    have hfin : Ideal.ordElem (maximalIdeal T.ring) (g' l) ≠ ⊤ := hg'.ordElem_ne_top l
    obtain ⟨D, hD⟩ := ENat.ne_top_iff_exists.mp hfin
    have hQD : Ideal.ordElem Q₁ (g' l) = D := by
      rw [hg'Q l, ← ordElem_eq_nuI_of_isStandardBase J₁ g' hg' l, ← hD]
    have hmem : g' l ∈ Ideal.span (Set.range C.x') ^ D :=
      Ideal.pow_right_mono hQ₁U D (Ideal.mem_pow_of_ordElem hQD)
    exact C.mem_range_ι₁_of_mem_adjoin_mk_x' hrat
      (initialForm_mem_adjoin_mk C.x' C.x'_mem hmem hD.symm)
  have hGJ : ∀ l, G l ∈ grIdeal (maximalIdeal T.ring) J₁ := fun l =>
    Ideal.subset_span ⟨_, hg'.1 l, rfl⟩
  have hGgen : grIdeal (maximalIdeal T.ring) J₁ ≤ Ideal.span (Set.range G) := hg'.2.2.2.1.le
  have hGh : ∀ l, G l ∈ AssocGraded.homogeneous (maximalIdeal T.ring)
      (Ideal.ordElem (maximalIdeal T.ring) (g' l)).toNat := fun l =>
    initialForm_mem_homogeneous_toNat (g' l)
  -- elimination of the `λ_j`
  obtain ⟨D₃, hD₃f, hD₃h⟩ := D₂.exists_lambda_zero hPM C hrat hνmono htop₁ G _ hGh hGι hGJ hGgen
  have hnorm : ∀ j, ∃ b, 1 ≤ b ∧ b ≤ t R J ∧ mu R J b = d j ∧
      initialForm (maximalIdeal R) (D₃.f j) ∈
        Algebra.adjoin (R ⧸ maximalIdeal R) (tauSubmodule R J b : Set (AssocGraded (maximalIdeal R))) := by
    intro j
    obtain ⟨b, hb1, hbt, hbmu, hmem⟩ := hD₂ j
    exact ⟨b, hb1, hbt, hbmu, by rw [hD₃f j]; exact hmem⟩
  -- `τ^{(a)}(J₁) ≤ τ^{(a)}(J)` ("Proposition 1 follows if `λ_j = 0` for all `j`") and Lemma 15
  refine le_antisymm (D₃.tau_le_of_normalized C hrat htop₁ hflag hτr hnorm hD₃h hmu ha hat) ?_
  obtain ⟨ia, hia⟩ := exists_isGreatest_nuI_eq_mu J a ha hat
  have hia_m : (ia : ℕ) ≤ m := by
    by_contra hlt
    have := htop' ia (by omega)
    have h1 := hia.1
    simp only [Set.mem_ofPred_eq] at h1
    rw [this] at h1
    exact ENat.top_ne_natCast _ h1
  exact tau_le_tau_strictTransform R P J hJP T hrat D₃.f a ha hat D₃.std ia hia
    (fun j hj => (D₃.ordP j).trans (hν j))
    (fun j hj => (hnuI j).symm) a ha le_rfl

end Prop1Route

/-! ### The maximal local extension used in the proofs of Theorems 3–5 (p. 234) -/

/-- Proof of Theorem 3, p. 234: "In a fixed algebraic closure of the field of quotients of `R`,
we shall take a maximal local extension `R'` of `R` such that the local homomorphism `R → R'`
transforms a regular system of parameters of `R` into such a system of parameters of `R'` and
induces a separable algebraic extension of the residue fields.  The existence of such `R'` can
be proved by means of Zorn's lemma and, if `R'` is such, then the residue field of `R'` does
not admit any separable algebraic extension."  The same reduction to the residually rational
case is made in the proofs of Theorem 4, Proposition 1 and Theorem 5 (§6).

Deviation from the paper (statement modified): the node records what those proofs use, namely
a local homomorphism `R → R'` of regular local rings transforming a regular system of
parameters into one, with separable algebraic residue field extension and separably closed
residue field of `R'`; the maximality and the embedding into a fixed algebraic closure of the
field of fractions are not used afterwards and are omitted from the statement (they hold for
the `R'` constructed).  It is proved by Zorn's lemma, as the paper indicates, in
`Hironaka/Compat/MaximalLocalExtension.lean` (`exists_regularLocal_sepClosed_extension`,
`compat:maximal-local-extension`); the details (gap filled) use the flatness of RSOP-preserving
homomorphisms, `lem:III.rsop-map-flat`. -/
@[blueprint "lem:III.5-maximal-local-extension"
  (statement := /-- Let $R$ be a regular local ring. There is a local homomorphism
    $R\to R'$ of regular local rings which transforms a regular system of parameters of $R$
    into such a system of parameters of $R'$ (\cref{def:III.rsop-map}) and induces a
    separable algebraic extension of the residue fields (\cref{def:III.2-residually}), such
    that the residue field of $R'$ does not admit any separable algebraic extension.
    (Proof of Theorem 3, p.~234.)

    \textbf{Deviation from the paper (statement modified).} The paper takes $R'$ maximal among
    such local extensions inside a fixed algebraic closure of the field of quotients of $R$;
    maximality and the ambient algebraic closure are omitted from the statement, since only
    the stated properties are used afterwards (they hold for the $R'$ constructed). -/)
  (proof := /-- ``The existence of such $R'$ can be proved by means of Zorn's lemma and, if
    $R'$ is such, then the residue field of $R'$ does not admit any separable algebraic
    extension'' (p.~234). This is carried out in \cref{compat:maximal-local-extension}: $R'$ is
    a maximal element, obtained by Zorn's lemma, of the set of subrings of a fixed algebraic
    closure of the field of quotients of $R$ which contain $R$, are noetherian local rings of
    dimension $\dim R$ with maximal ideal generated by that of $R$, and have residue field
    separable algebraic over that of $R$; by maximality its residue field admits no separable
    algebraic extension.

    \textbf{Gap in the paper filled.} The paper gives only the sentence quoted above. The
    details supplied in \cref{compat:maximal-local-extension} are: purity $IB\cap A=I$ for
    members $A\subseteq B$ of the family (from the flatness of RSOP-preserving homomorphisms,
    \cref{lem:III.rsop-map-flat}, which the paper asserts on p.~207); for the union of a
    chain, locality, closedness of extended ideals (Krull), noetherianity via the associated
    graded ring, $\dim=\dim R$ via a regular sequence; and, for a maximal member with
    non-separably-closed residue field, adjunction of a root of a monic lift of a separable
    irreducible polynomial. -/)
  (latexEnv := "lemma")]
theorem exists_maximal_local_extension (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    ∃ (R' : Type u) (_ : CommRing R') (_ : IsRegularLocalRing R') (α : R →+* R')
      (_ : IsLocalHom α), RingHom.MapsRSOP α ∧
        RingHom.IsResiduallySeparableAlgebraic (R := R) (R' := R') α ∧
        IsSepClosed (ResidueField R') :=
  exists_regularLocal_sepClosed_extension R

/-! ### Theorem 3 (pp. 233–234) -/

section Theorem3

/-- Elements of `R[x⁻¹P]` are fractions `f / xᴺ`, with `N` as large as wanted. -/
private theorem exists_pow_mul_eq_of_mem_blowupAlgebra {R : Type u} [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] {P : Ideal R} {x : R} (hx : x ≠ 0) {y : FractionRing R}
    (hy : y ∈ blowupAlgebra R P x) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∃ f : R,
      algebraMap R (FractionRing R) x ^ n * y = algebraMap R (FractionRing R) f := by
  have hx' : algebraMap R (FractionRing R) x ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R _)).mpr hx
  suffices h : ∃ (N : ℕ) (f : R),
      algebraMap R (FractionRing R) x ^ N * y = algebraMap R (FractionRing R) f by
    obtain ⟨N, f, hf⟩ := h
    refine ⟨N, fun n hn => ⟨x ^ (n - N) * f, ?_⟩⟩
    rw [map_mul, map_pow, ← hf, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hn]
  induction hy using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨p, -, rfl⟩ := hy
    exact ⟨1, p, by rw [pow_one, mul_div_cancel₀ _ hx']⟩
  | algebraMap r => exact ⟨0, r, by rw [pow_zero, one_mul]⟩
  | add y z _ _ hy hz =>
    obtain ⟨N₁, f₁, h₁⟩ := hy
    obtain ⟨N₂, f₂, h₂⟩ := hz
    refine ⟨N₁ + N₂, x ^ N₂ * f₁ + x ^ N₁ * f₂, ?_⟩
    rw [map_add, map_mul, map_mul, map_pow, map_pow, ← h₁, ← h₂]
    ring
  | mul y z _ _ hy hz =>
    obtain ⟨N₁, f₁, h₁⟩ := hy
    obtain ⟨N₂, f₂, h₂⟩ := hz
    refine ⟨N₁ + N₂, f₁ * f₂, ?_⟩
    rw [map_mul, ← h₁, ← h₂]
    ring

/-- **Existence of canonical monoidal transforms** (pp. 211–212, the existence half of
Lemma 4 (1)): given `α : R → R̄` transforming a regular system of parameters into one and a
monoidal transform `R'` of `R` with center `P`, there is a monoidal transform `R̄'` of `R̄` with
center `PR̄` and a canonical local homomorphism `R' → R̄'`.

Lean-only generalization: no hypothesis on `P`.  The printed route (p. 211: an associated prime of
`M'Ã'`) needs `P` prime with `R/P` regular and is `MonoidalTransform.exists_isCanonicalLift_of_isRegular`
(`lem:III.4-existence`), used by Theorems 3 and 5 and Proposition 1; this version is kept for the
callers which have no such `P` (`MonoidalSequence.LiftStage`).  With `B = R[x⁻¹P]`,
`B̄ = R̄[x⁻¹PR̄]`: since `R̄` is faithfully flat over `R`, `(IB̄) ∩ B = I` for every ideal `I` of
`B` (clear denominators and use `J R̄ ∩ R = J`), so the prime `M'` of `B` is the contraction of a
prime of `B̄`. -/
theorem exists_isCanonicalLift {R R' : Type u} [CommRing R] [IsRegularLocalRing R]
    [IsDomain R] [CommRing R'] [IsRegularLocalRing R'] [IsDomain R'] (α : R →+* R')
    [IsLocalHom α] (hα : RingHom.MapsRSOP α) {P : Ideal R} (T : MonoidalTransform R P) :
    ∃ (T' : MonoidalTransform R' (P.map α)) (β : T.ring →+* T'.ring),
      IsCanonicalLift α T T' β := by
  classical
  let _ : Algebra R R' := α.toAlgebra
  have _ : IsLocalHom (algebraMap R R') := ‹IsLocalHom α›
  have _ : Module.Flat R R' := hα.flat
  have _ : Module.FaithfullyFlat R R' := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hinj : Function.Injective α := FaithfulSMul.algebraMap_injective R R'
  have hle : nonZeroDivisors R ≤ (nonZeroDivisors R').comap α := fun y hy =>
    mem_nonZeroDivisors_of_ne_zero ((map_ne_zero_iff α hinj).mpr (nonZeroDivisors.ne_zero hy))
  let φ : FractionRing R →+* FractionRing R' := IsLocalization.map (FractionRing R') α hle
  have hφ : ∀ r, φ (algebraMap R (FractionRing R) r) = algebraMap R' (FractionRing R') (α r) :=
    fun r => IsLocalization.map_eq hle r
  have hx'P : α T.x ∈ P.map α := Ideal.mem_map_of_mem α T.x_mem
  have hx'0 : α T.x ≠ 0 := (map_ne_zero_iff α hinj).mpr T.x_ne_zero
  -- `φ` maps `B = R[x⁻¹P]` into `B̄ = R̄[x⁻¹PR̄]`
  have hBB' : ∀ y ∈ blowupAlgebra R P T.x, φ y ∈ blowupAlgebra R' (P.map α) (α T.x) := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨p, hp, rfl⟩ := hy
      rw [map_div₀, hφ, hφ]
      exact Algebra.subset_adjoin ⟨α p, Ideal.mem_map_of_mem α hp, rfl⟩
    | algebraMap r =>
      rw [hφ]
      exact Subalgebra.algebraMap_mem _ (α r)
    | add y z _ _ hy hz =>
      rw [map_add]
      exact add_mem hy hz
    | mul y z _ _ hy hz =>
      rw [map_mul]
      exact mul_mem hy hz
  let ψ : blowupAlgebra R P T.x →+* blowupAlgebra R' (P.map α) (α T.x) :=
    (φ.comp (blowupAlgebra R P T.x).val.toRingHom).codRestrict _ fun b => hBB' b b.2
  have hψ : ∀ b, ((ψ b : blowupAlgebra R' (P.map α) (α T.x)) : FractionRing R') = φ b :=
    fun b => rfl
  -- `B̄` lies in the `R̄`-span of `φ(B)`
  set S := Submodule.span R' (Set.range fun b : blowupAlgebra R P T.x => φ b) with hSdef
  have hSmul : ∀ y z, y ∈ S → z ∈ S → y * z ∈ S := by
    intro y z hy hz
    have h := Submodule.mul_mem_mul hy hz
    rw [Submodule.span_mul_span] at h
    refine Submodule.span_mono ?_ h
    rintro _ ⟨_, ⟨b₁, rfl⟩, _, ⟨b₂, rfl⟩, rfl⟩
    exact ⟨b₁ * b₂, by simp only [Subalgebra.coe_mul, map_mul]⟩
  have hspan : ∀ y ∈ blowupAlgebra R' (P.map α) (α T.x), y ∈ S := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨p', hp', rfl⟩ := hy
      induction hp' using Submodule.span_induction with
      | mem p' hp' =>
        obtain ⟨p, hp, rfl⟩ := hp'
        refine Submodule.subset_span ⟨⟨_, Algebra.subset_adjoin ⟨p, hp, rfl⟩⟩, ?_⟩
        simp only [map_div₀, hφ]
      | zero => simp
      | add a b _ _ ha hb =>
        dsimp only at ha hb ⊢
        rw [map_add, add_div]
        exact add_mem ha hb
      | smul r' a _ ha =>
        dsimp only at ha ⊢
        rw [smul_eq_mul, map_mul, mul_div_assoc, ← Algebra.smul_def]
        exact Submodule.smul_mem _ _ ha
    | algebraMap r' =>
      rw [Algebra.algebraMap_eq_smul_one]
      refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, ?_⟩)
      simp
    | add y z _ _ hy hz => exact add_mem hy hz
    | mul y z _ _ hy hz => exact hSmul y z hy hz
  have hxK : algebraMap R (FractionRing R) T.x ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R _)).mpr T.x_ne_zero
  -- `(I B̄) ∩ B = I` for every ideal `I` of `B`
  have hcm : ∀ I : Ideal (blowupAlgebra R P T.x), (I.map ψ).comap ψ ≤ I := by
    intro I b hb
    rw [Ideal.mem_comap] at hb
    -- (i) `φ(b)` lies in the `R̄`-span of `φ(I)`
    set SI := Submodule.span R' ((fun a : blowupAlgebra R P T.x => φ a) '' (I : Set _))
      with hSI
    have hSImul : ∀ y z, y ∈ S → z ∈ SI → y * z ∈ SI := by
      intro y z hy hz
      have h := Submodule.mul_mem_mul hy hz
      rw [Submodule.span_mul_span] at h
      refine Submodule.span_mono ?_ h
      rintro _ ⟨_, ⟨b₁, rfl⟩, _, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨b₁ * a, I.mul_mem_left b₁ ha, by simp only [Subalgebra.coe_mul, map_mul]⟩
    have hb' : ψ b ∈ Ideal.span (ψ '' (I : Set _)) := hb
    have key : ∀ z ∈ Ideal.span (ψ '' (I : Set _)),
        ((z : blowupAlgebra R' (P.map α) (α T.x)) : FractionRing R') ∈ SI := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨a, ha, rfl⟩ := hz
        exact Submodule.subset_span ⟨a, ha, rfl⟩
      | zero => simp
      | add y z _ _ hy hz =>
        rw [Subalgebra.coe_add]
        exact add_mem hy hz
      | smul c z _ hz =>
        rw [smul_eq_mul, Subalgebra.coe_mul]
        exact hSImul _ _ (hspan _ c.2) hz
    have h1 : φ b ∈ SI := by
      rw [← hψ]
      exact key _ hb'
    -- (ii) a finite `R̄`-combination
    obtain ⟨n, c, a, hsum⟩ := Submodule.mem_span_set'.mp h1
    choose a' ha' hga using fun i => (a i).2
    -- (iii) common denominators `xᴺ`
    obtain ⟨Nb, hNb⟩ := exists_pow_mul_eq_of_mem_blowupAlgebra T.x_ne_zero b.2
    choose Ni hNi using fun i => exists_pow_mul_eq_of_mem_blowupAlgebra T.x_ne_zero (a' i).2
    set N := max Nb (Finset.univ.sup Ni)
    obtain ⟨f, hf⟩ := hNb N (le_max_left _ _)
    choose g hg using fun i =>
      hNi i N ((Finset.le_sup (f := Ni) (Finset.mem_univ i)).trans (le_max_right _ _))
    -- (iv) `α(f) = Σ cᵢ α(gᵢ)` in `R̄`
    have hfg : α f = ∑ i, c i * α (g i) := by
      apply IsFractionRing.injective R' (FractionRing R')
      calc algebraMap R' (FractionRing R') (α f)
          = φ (algebraMap R (FractionRing R) f) := (hφ f).symm
        _ = φ (algebraMap R (FractionRing R) T.x) ^ N * φ b := by rw [← hf, map_mul, map_pow]
        _ = ∑ i, algebraMap R' (FractionRing R') (c i) *
            φ (algebraMap R (FractionRing R) T.x ^ N * a' i) := by
          rw [← hsum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Algebra.smul_def, ← hga i, map_mul, map_pow]
          ring
        _ = algebraMap R' (FractionRing R') (∑ i, c i * α (g i)) := by
          rw [map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hg i, hφ, map_mul]
    -- (v) `f ∈ (g₁, …, g_n)` by faithful flatness
    have hmem : α f ∈ (Ideal.span (Set.range g)).map α := by
      rw [hfg, Ideal.map_span]
      exact Ideal.sum_mem _ fun i _ =>
        Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨g i, ⟨i, rfl⟩, rfl⟩)
    have hf' : f ∈ Ideal.span (Set.range g) := by
      rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := R') (Ideal.span (Set.range g))]
      exact hmem
    obtain ⟨s, hs⟩ := Ideal.mem_span_range_iff_exists_fun.mp hf'
    -- (vi) `b = Σ sᵢ aᵢ ∈ I`
    have hbK : (b : FractionRing R) =
        ∑ i, algebraMap R (FractionRing R) (s i) * (a' i : FractionRing R) := by
      apply mul_left_cancel₀ (pow_ne_zero N hxK)
      rw [hf, ← hs, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, ← hg i]
      ring
    have hbeq : b = ∑ i, algebraMap R (blowupAlgebra R P T.x) (s i) * a' i := by
      apply Subtype.ext
      rw [hbK]
      simp
    rw [hbeq]
    exact Ideal.sum_mem _ fun i _ => I.mul_mem_left _ (ha' i)
  -- a prime of `B̄` over `M'`
  obtain ⟨q, hq, hqM⟩ := (Ideal.comap_map_eq_self_iff_of_isPrime T.M').mp
    (le_antisymm (hcm _) Ideal.le_comap_map)
  have hcompat : ψ.comp (algebraMap R (blowupAlgebra R P T.x)) =
      (algebraMap R' (blowupAlgebra R' (P.map α) (α T.x))).comp α :=
    RingHom.ext fun r => Subtype.ext (hφ r)
  have hle' : (maximalIdeal R').map (algebraMap R' (blowupAlgebra R' (P.map α) (α T.x))) ≤ q := by
    rw [← map_maximalIdeal_of_mapsRSOP α hα, Ideal.map_map, ← hcompat, ← Ideal.map_map]
    refine (Ideal.map_mono T.le).trans ?_
    rw [Ideal.map_le_iff_le_comap, hqM]
  let T' : MonoidalTransform R' (P.map α) := ⟨α T.x, hx'P, hx'0, q, hq, hle'⟩
  refine ⟨T', Localization.localRingHom T.M' q ψ hqM.symm, ?_, ?_⟩
  · exact Localization.isLocalHom_localRingHom _ _ _ _
  · refine RingHom.ext fun r => ?_
    have h1 := Localization.localRingHom_to_map T.M' q ψ hqM.symm
      (algebraMap R (blowupAlgebra R P T.x) r)
    exact h1.trans (congrArg _ (DFunLike.congr_fun hcompat r))

/-- Theorem 3 in the residually rational case: the lexicographic comparison by Lemma 14 and the
comparison of the `τ` by Lemma 15. -/
private theorem nuStar_strictTransform_le_of_isResiduallyRational (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] (P : Ideal R) [P.IsPrime] (J : Ideal R) (hJP : J ≤ P)
    (T : MonoidalTransform R P) [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (hperm : IsPermissibleCenter R J P) :
    nuStar T.ring (strictTransformIdeal T J) ≤ nuStar R J ∧
      (nuStar T.ring (strictTransformIdeal T J) = nuStar R J →
        t T.ring (strictTransformIdeal T J) = t R J ∧
        ∀ i, 1 ≤ i → i ≤ t R J → tau R J i ≤ tau T.ring (strictTransformIdeal T J) i) := by
  obtain ⟨-, -, hS, hNF⟩ := hperm.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  have _ : IsRegularLocalRing (R ⧸ P) := hS
  -- (ii)**: a standard base with `ν_P(f_j) = ν^{(j)}(J)`
  have h13 : IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)) ↔
      ∃ (m : ℕ) (f : Fin m → R), IsStandardBase R J f ∧
        ∀ j : Fin m, Ideal.ordElem P (f j) = nuI R J ((j : ℕ).succPNat) :=
    (isPermissibleCenter_tfae R J P hJP).out 1 3
  obtain ⟨m, f, hf, hfP⟩ := h13.mp hNF
  obtain ⟨⟨d, -, hνd⟩, htop⟩ := nuI_eq_of_hasLemma1Properties R J _ hf.2
  have hν : ∀ j : Fin m, (d j : ℕ∞) = nuI R J ((j : ℕ).succPNat) := fun j => (hνd j).symm
  refine ⟨?_, fun heq => ?_⟩
  · -- if `ν*(J) < ν*(J₁)`, Lemma 14 at the first index of difference gives a contradiction
    refine le_of_not_gt fun hlt => ?_
    obtain ⟨i, hi, hilt⟩ := hlt
    change nuI R J i < nuI T.ring (strictTransformIdeal T J) i at hilt
    have hi : ∀ j : ℕ+, j < i → nuI R J j = nuI T.ring (strictTransformIdeal T J) j := hi
    have him : (i : ℕ) ≤ m := by
      by_contra h
      have := htop i (by omega)
      rw [this] at hilt
      exact not_top_lt hilt
    have hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
        toLex fun j : Fin (i : ℕ) =>
          nuI T.ring (strictTransformIdeal T J) ((j : ℕ).succPNat) := by
      refine le_of_lt ⟨⟨(i : ℕ) - 1, by have := i.pos; omega⟩, fun j hj => ?_, ?_⟩
      · show nuI R J ((j : ℕ).succPNat) = nuI T.ring (strictTransformIdeal T J) ((j : ℕ).succPNat)
        have hj' : (j : ℕ).succPNat < i := by
          rw [← PNat.coe_lt_coe, Nat.succPNat_coe]
          have : (j : ℕ) < (i : ℕ) - 1 := hj
          omega
        exact hi _ hj'
      · have hi' : ((i : ℕ) - 1).succPNat = i := by
          apply PNat.eq
          rw [Nat.succPNat_coe]
          have := i.pos
          omega
        show nuI R J (((i : ℕ) - 1).succPNat) <
          nuI T.ring (strictTransformIdeal T J) (((i : ℕ) - 1).succPNat)
        rw [hi']
        exact hilt
    have h14 := (exists_standardBase_extendsToStandardBase R P J hJP T hrat f i him d hν hf
      (fun j _ => (hfP j).trans (hν j).symm) hlex).2 i le_rfl
    rw [h14] at hilt
    exact lt_irrefl _ hilt
  · -- `ν*(J₁) = ν*(J)`: `t(J₁) = t(J)`, and Lemma 15 for every `a ≤ t(J)`
    have hnu : ∀ i, nuI T.ring (strictTransformIdeal T J) i = nuI R J i := fun i =>
      congrFun (toLex.injective heq) i
    have hmu : muSet T.ring (strictTransformIdeal T J) = muSet R J := by
      ext μ
      simp only [muSet, Set.mem_ofPred_eq, hnu]
    refine ⟨by rw [t, t, hmu], fun a ha hat => ?_⟩
    -- the largest `i` with `ν^{(i)}(J) = μ^{(a)}(J)`
    have hfin := (muSet_finite R J).1
    have hmem : mu R J a ∈ muSet R J := by
      apply Nat.nth_mem_of_lt_card hfin
      refine lt_of_lt_of_le ?_ (le_of_eq (Set.ncard_eq_toFinset_card _ hfin))
      have : t R J = (muSet R J).ncard := rfl
      omega
    obtain ⟨k₀, hk₀⟩ := hmem
    have hSfin : {k : ℕ+ | nuI R J k = (mu R J a : ℕ∞)}.Finite := by
      refine ((Set.finite_le_nat m).preimage PNat.coe_injective.injOn).subset fun k hk => ?_
      by_contra hkm
      have := htop k (by simp only [Set.mem_preimage, Set.mem_ofPred_eq] at hkm; omega)
      rw [Set.mem_ofPred_eq, this] at hk
      exact ENat.top_ne_natCast _ hk
    obtain ⟨i, hi, himax⟩ := Set.exists_max_image _ (fun k : ℕ+ => (k : ℕ)) hSfin ⟨k₀, hk₀⟩
    exact tau_le_tau_strictTransform R P J hJP T hrat f a ha hat hf i
      ⟨hi, fun k hk => PNat.coe_le_coe _ _ |>.mp (himax k hk)⟩ (fun j _ => hfP j)
      (fun j _ => (hnu j).symm) a ha le_rfl

/-- Theorem 3, pp. 233–234: "Let `R` be a regular local ring, `P` a prime ideal in `R` and `J`
an ideal in `R` which is contained in `P`. Let `R₁` be a monoidal transform of `R` with center
`P` which is residually separable algebraic over `R`, and `J₁` the strict transform of `J` in
`R₁`. Suppose `P` is a permissible center for `J`. Then we have `ν*(J₁) ≤ ν*(J)` and if
`ν*(J₁) = ν*(J)`, we have `τ^{(i)}(J₁) ≥ τ^{(i)}(J)` for `1 ≤ i ≤ t(J) = t(J₁)`."

Footnote 7 (p. 234): "The integer `t(J)` being defined as the number of distinct integers in the
sequence `ν*(J)`, if `ν*(J) = ν*(J₁)`, then `t(J) = t(J₁)`."  Accordingly the conclusion under
`ν*(J₁) = ν*(J)` carries the equality `t(J₁) = t(J)` explicitly.

Gap in the paper filled: the paper takes for granted the existence of the monoidal transform
`R₁'` of `R'` with a canonical local homomorphism `R₁ → R₁'`; it is the one of Lemma 4 (p. 211,
`MonoidalTransform.exists_isCanonicalLift_of_isRegular`): `R₁' = Ã'_{M̃'}` for an associated prime
`M̃'` of `M'Ã'`, which exists since `M'Ã' ≠ Ã'`.  The derivation of `ν*(J₁) ≤ ν*(J)`
from Lemma 14 (by contradiction at the first index where the sequences differ) and the
residual rationality of `R₁'` over `R'` (Lemma 4 (2) and the separable closedness of the
residue field of `R'`) are spelled out. -/
@[blueprint "thm:III.3"
  (statement := /-- Let $R$ be a regular local ring, $P$ a prime ideal in $R$ and $J$ an ideal
    in $R$ which is contained in $P$. Let $R_1$ be a monoidal transform of $R$ with center $P$
    (\cref{def:III.2-monoidal-transform}) which is residually separable algebraic over $R$
    (\cref{def:III.2-residually}), and $J_1$ the strict transform of $J$ in $R_1$
    (\cref{def:III.5-strict}). Suppose $P$ is a permissible center for $J$
    (\cref{def:III.8}). Then $\nu^*(J_1)\le\nu^*(J)$ (\cref{def:III.2}) and, if
    $\nu^*(J_1)=\nu^*(J)$, then $\tau^{(i)}(J_1)\ge\tau^{(i)}(J)$ for $1\le i\le t(J)=t(J_1)$
    (\cref{def:III.6}). (Theorem 3, pp.~233--234.) Footnote 7: ``The integer $t(J)$ being
    defined as the number of distinct integers in the sequence $\nu^*(J)$, if
    $\nu^*(J)=\nu^*(J_1)$, then $t(J)=t(J_1)$.'' -/)
  (proof := /-- In a fixed algebraic closure of the field of quotients of $R$, take a maximal
    local extension $R'$ of $R$ such that the local homomorphism $R\to R'$ transforms a
    regular system of parameters of $R$ into such a system of parameters of $R'$ and induces a
    separable algebraic extension of the residue fields. The existence of such an $R'$ is
    proved by Zorn's lemma and, if $R'$ is such, the residue field of $R'$ does not admit any
    separable algebraic extension. Let $R_1'$ be a monoidal transform of $R'$ with center
    $P'=PR'$ such that there is a commutative diagram of canonical local homomorphisms
    $R_1\to R_1'$ over $R\to R'$. As in \cref{rem:III.5-1} and \cref{rem:III.5-2}, if
    $J'=JR'$ and $J_1'$ is the strict transform of $J'$ in $R_1'$, then $\nu^*(J)=\nu^*(J')$,
    $\nu^*(J_1)=\nu^*(J_1')$, $\tau^{(j)}(J)=\tau^{(j)}(J')$ for $1\le j\le t(J)=t(J')$ and
    $\tau^{(j)}(J_1)=\tau^{(j)}(J_1')$ for $1\le j\le t(J_1)=t(J_1')$. Moreover, by Lemma~4 of
    \S2 (\cref{lem:III.4}), the assumption that $R_1$ is residually separable algebraic over
    $R$ implies that $R_1'$ is residually rational over $R'$. Therefore, replacing $R$, $J$,
    $P$, $R_1$, $J_1$ by $R'$, $J'$, $P'$, $R_1'$, $J_1'$, we may assume that $R_1$ is
    residually rational over $R$. In this case the inequality $\nu^*(J_1)\le\nu^*(J)$ follows
    from \cref{lem:III.14}, and $\tau^{(i)}(J_1)\ge\tau^{(i)}(J)$ for
    $1\le i\le t(J)=t(J_1)$, when $\nu^*(J_1)=\nu^*(J)$, follows from \cref{lem:III.15}.
    (This paragraph is the paper's proof.)

    \textbf{Gap in the paper filled.} (a) The existence of $R_1'$ with a canonical local
    homomorphism $R_1\to R_1'$ is taken for granted by the paper (\S2, p.~211, describes such
    $R_1'$ through the associated primes of $M'\bar A'$). Lean takes $R_1'=\bar A'_{\bar M'}$ for
    an associated prime $\bar M'$ of $M'\bar A'$, as printed (\cref{lem:III.4-existence}); it
    exists because $M'\bar A'\ne\bar A'$. (b) $R_1'$ is residually rational over $R'$ because, by Lemma~4 (2), its
    residue field is generated by those of $R_1$ and $R'$, hence is separable algebraic over
    the separably closed residue field of $R'$. (c) $\nu^*(J_1)\le\nu^*(J)$ from Lemma~14: if it
    failed, there would be a smallest $i$ with $\nu^{(i)}(J_1)>\nu^{(i)}(J)$ and
    $\nu^{(j)}(J_1)=\nu^{(j)}(J)$ for $j<i$; the lexicographic hypothesis of \cref{lem:III.14}
    then holds for this $i$ (its hypotheses (i), (ii) are supplied by the permissibility of
    $P$ through \cref{lem:III.8-equivalents}), whence $\nu^{(i)}(J)=\nu^{(i)}(J_1)$, a
    contradiction. (d) For the $\tau$'s, Lemma~15 is applied for each $a\le t(J)$ with $i$ the
    largest index such that $\nu^{(i)}(J)=\mu^{(a)}(J)$. -/)
  (latexEnv := "theorem")]
theorem nuStar_strictTransform_le [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R]
    (P : Ideal R) [P.IsPrime] (J : Ideal R) (hJP : J ≤ P) (T : MonoidalTransform R P)
    (hsep : RingHom.IsResiduallySeparableAlgebraic (R := R) (R' := T.ring) T.toRing)
    (hperm : IsPermissibleCenter R J P) :
    haveI : IsRegularLocalRing (R ⧸ P) :=
      (hperm.resolve_left (inferInstance : P.IsPrime).ne_top).2.2.1
    nuStar T.ring (strictTransformIdeal T J) ≤ nuStar R J ∧
      (nuStar T.ring (strictTransformIdeal T J) = nuStar R J →
        t T.ring (strictTransformIdeal T J) = t R J ∧
        ∀ i, 1 ≤ i → i ≤ t R J → tau R J i ≤ tau T.ring (strictTransformIdeal T J) i) := by
  have hP : P.IsPrime := inferInstance
  obtain ⟨-, -, hS, -⟩ := hperm.resolve_left hP.ne_top
  have _ : IsRegularLocalRing (R ⧸ P) := hS
  -- a maximal local extension `R → R'` with separably closed residue field
  obtain ⟨R', _, _, α, _, hα, hsepα, hsc⟩ := exists_maximal_local_extension R
  have _ : IsDomain R' := Transforms.isDomain_of_isRegularLocalRing R'
  obtain ⟨⟨hP', hS'⟩, -, h2, -⟩ := RingHom.MapsRSOP.canonicalLift_properties α hα hP hS
  have _ : (P.map α).IsPrime := hP'
  have _ : IsRegularLocalRing (R' ⧸ P.map α) := hS'
  -- a canonical monoidal transform `R₁'` of `R'` over `R₁`
  obtain ⟨T', β, hcan⟩ := T.exists_isCanonicalLift_of_isRegular α hα hP hS
  have _ : IsLocalHom β := hcan.isLocalHom
  have hP'0 : P.map α ≠ ⊥ := fun h => T'.x_ne_zero (Ideal.mem_bot.mp (h.le T'.x_mem))
  have _ : IsRegularLocalRing T'.ring := (MonoidalTransform.isRegularLocalRing_and_isLocalHom_and_span_xR_eq_map T' hP' hP'0 hS').1
  -- `R₁'` is residually rational over `R'` (Lemma 4 (2), the residue field of `R'` being
  -- separably closed)
  have hsepT' : RingHom.IsResiduallySeparableAlgebraic (R := R') (R' := T'.ring) T'.toRing :=
    isResiduallySeparableAlgebraic_of_closure_eq_top T.toRing α β T'.toRing hcan.comm.symm hsep
      (by rw [Set.union_comm]; exact (h2 T T' β hcan).2.2.2.2)
  have hrat' : RingHom.IsResiduallyRational (R := R') (R' := T'.ring) T'.toRing := by
    let _ : Algebra (ResidueField R') (ResidueField T'.ring) :=
      (ResidueField.map T'.toRing).toAlgebra
    have _ : Algebra.IsSeparable (ResidueField R') (ResidueField T'.ring) := hsepT'
    exact IsSepClosed.algebraMap_surjective (ResidueField R') (ResidueField T'.ring)
  -- `P'` is permissible for `J'` (Remark 1), and Remark 2
  have hperm' := (isPermissibleCenter_map_iff α hα J P hJP).2.2.2.mp hperm
  obtain ⟨-, hrem⟩ := strictTransform_map_of_mapsRSOP α hα J P hJP T T' β hcan.comm
  obtain ⟨hν, hν₁, ⟨ht, hτ⟩, ⟨ht₁, hτ₁⟩⟩ := hrem hsepα
  have key := nuStar_strictTransform_le_of_isResiduallyRational R' (P.map α) (J.map α)
    (Ideal.map_mono hJP) T' hrat' hperm'
  have hN₁ : nuStar T.ring (strictTransformIdeal T J) =
      nuStar T'.ring (strictTransformIdeal T' (J.map α)) := by
    simp only [nuStar]
    exact congrArg toLex (funext hν₁)
  rw [hN₁, hν]
  refine ⟨key.1, fun heq => ?_⟩
  obtain ⟨kt, kτ⟩ := key.2 heq
  refine ⟨ht₁.symm.trans (kt.trans ht), fun i hi hit => ?_⟩
  rw [← hτ i hi hit, ← hτ₁ i hi (by rw [ht₁.symm.trans (kt.trans ht)]; exact hit)]
  exact kτ i hi (by rw [ht]; exact hit)

end Theorem3

/-! ### Sequences of monoidal transforms, and Theorem 4 (pp. 234–236) -/

section Theorem4

/-- A sequence `{R_α, J_α}_{α ∈ ℕ}` of regular local rings and ideals in which `R_{α+1}` is a
monoidal transform of `R_α` with a center `P_α` and `J_{α+1}` is the strict transform of `J_α`
(the data (1) of Theorem 4, p. 234, without the permissibility and residual assumptions, which
are the predicates `IsPermissible` and `IsResiduallySeparableAlgebraic` below).

Formalization note (encoding).  The rings are given as a family `ring : ℕ → Type u` carrying per-index
`CommRing`, `IsRegularLocalRing` and `IsDomain` instances; the transform at stage `α` is
`transform α : MonoidalTransform (ring α) (center α)`, and the identification of its underlying
local ring with `ring (α + 1)` is the ring isomorphism `equiv α` (the paper says "`R_{α+1}` *is*
a monoidal transform of `R_α`", which is what this says: `ring (α + 1)` is isomorphic, as a ring
under `ring α`, to the local ring `R_α[x⁻¹P_α]_{M'}`).  `ideal_succ` then reads
"`J_{α+1}` is the strict transform of `J_α` in `R_{α+1}`".

That the canonical homomorphism of a monoidal transform is local is a lemma of §2
(`MonoidalTransform.isLocalHom_toRing`, an instance in `Hironaka/Ch3/Transforms.lean`, which
this file imports), so it is not a field of the structure.

Indexing over `ℕ` makes the structure serve both the infinite sequences of Theorem 4 and the
finite ones of later sections (a finite sequence is one whose centers are eventually `⊤`, the
monoidal transform with center `R` being canonically `R` itself, p. 209). -/
structure MonoidalSequence where
  /-- The regular local rings `R_α`, `α ∈ ℕ`. -/
  ring : ℕ → Type u
  [commRing : ∀ n, CommRing (ring n)]
  [isRegularLocalRing : ∀ n, IsRegularLocalRing (ring n)]
  [isDomain : ∀ n, IsDomain (ring n)]
  /-- The ideals `J_α` in `R_α`. -/
  ideal : ∀ n, Ideal (ring n)
  /-- The centers `P_α` in `R_α`. -/
  center : ∀ n, Ideal (ring n)
  /-- `R_{α+1}` is the monoidal transform of `R_α` with center `P_α` given by `transform α`. -/
  transform : ∀ n, MonoidalTransform (ring n) (center n)
  /-- The identification of the monoidal transform with `R_{α+1}`. -/
  equiv : ∀ n, (transform n).ring ≃+* ring (n + 1)
  /-- `J_{α+1}` is the strict transform of `J_α` in `R_{α+1}`. -/
  ideal_succ : ∀ n, ideal (n + 1) =
    (strictTransformIdeal (transform n) (ideal n)).map (equiv n)

attribute [instance] MonoidalSequence.commRing MonoidalSequence.isRegularLocalRing
  MonoidalSequence.isDomain

namespace MonoidalSequence

variable (S : MonoidalSequence.{u})

/-- Condition (1) of Theorem 4 (p. 234): each `P_α` is a permissible center for `J_α`
(\cref{def:III.8}). -/
def IsPermissible : Prop := ∀ n, IsPermissibleCenter (S.ring n) (S.ideal n) (S.center n)

/-- Condition (2) of Theorem 4 (p. 234): `R_{α+1}` is residually separable algebraic over
`R_α` for all `α`. -/
def IsResiduallySeparableAlgebraic : Prop :=
  ∀ n, RingHom.IsResiduallySeparableAlgebraic (R := S.ring n) (R' := (S.transform n).ring)
    (S.transform n).toRing

end MonoidalSequence

/-! ### Auxiliary material for the proof of Theorem 4 -/

section GradedIso

open Polynomial

variable {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]

/-- The map of Rees algebras induced by `α : A → B` with `α(I) ⊆ I'`. -/
private noncomputable def reesMapLEPriv (α : A →+* B) (I : Ideal A) (I' : Ideal B) (h : I.map α ≤ I') :
    reesAlgebra I →+* reesAlgebra I' where
  toFun p := ⟨(p : A[X]).map α, (mem_reesAlgebra_iff _ _).mpr fun i => by
    rw [coeff_map]
    exact Ideal.pow_right_mono h i (by
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ ((mem_reesAlgebra_iff I _).mp p.2 i))⟩
  map_one' := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)

/-- The map `gr_I(A) → gr_{I'}(B)` induced by `α : A → B` with `α(I) ⊆ I'`. -/
private noncomputable def grMapLE (α : A →+* B) (I : Ideal A) (I' : Ideal B) (h : I.map α ≤ I') :
    AssocGraded I →+* AssocGraded I' :=
  Ideal.quotientMap (I := Ideal.map (algebraMap A (reesAlgebra I)) I) _
    (reesMapLEPriv α I I' h) (by
      intro x hx
      rw [Ideal.mem_comap, mem_map_algebraMap_reesAlgebra_iff]
      rw [mem_map_algebraMap_reesAlgebra_iff] at hx
      intro n
      show ((x : A[X]).map α).coeff n ∈ I' ^ (n + 1)
      rw [coeff_map]
      exact Ideal.pow_right_mono h (n + 1) (by
        rw [← Ideal.map_pow]
        exact Ideal.mem_map_of_mem _ (hx n)))

private theorem grMapLE_mk (α : A →+* B) (I : Ideal A) (I' : Ideal B) (h : I.map α ≤ I')
    (n : ℕ) (a : A) (ha : a ∈ I ^ n) (ha' : α a ∈ I' ^ n) :
    grMapLE α I I' h (AssocGraded.mk I n a ha) = AssocGraded.mk I' n (α a) ha' := by
  show Ideal.Quotient.mk _ (reesMapLEPriv α I I' h ⟨monomial n a, _⟩) = Ideal.Quotient.mk _ _
  congr 1
  exact Subtype.ext (Polynomial.map_monomial α)

private theorem grMapLE_comp (α : A →+* B) (β : B →+* C) (I : Ideal A) (I' : Ideal B)
    (I'' : Ideal C) (h : I.map α ≤ I') (h' : I'.map β ≤ I'') (h'' : I.map (β.comp α) ≤ I'')
    (x : AssocGraded I) :
    grMapLE β I' I'' h' (grMapLE α I I' h x) = grMapLE (β.comp α) I I'' h'' x := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  show Ideal.Quotient.mk _ (reesMapLEPriv β I' I'' h' (reesMapLEPriv α I I' h p)) =
    Ideal.Quotient.mk _ (reesMapLEPriv (β.comp α) I I'' h'' p)
  congr 1
  exact Subtype.ext (Polynomial.map_map α β _)

private theorem grMapLE_id (I : Ideal A) (h : I.map (RingHom.id A) ≤ I) (x : AssocGraded I) :
    grMapLE (RingHom.id A) I I h x = x := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  show Ideal.Quotient.mk _ (reesMapLEPriv (RingHom.id A) I I h p) = Ideal.Quotient.mk _ p
  congr 1
  exact Subtype.ext (Polynomial.map_id)

/-- The isomorphism `gr_I(A) ≃ gr_{I'}(B)` induced by a ring isomorphism `e` with `e(I) = I'`. -/
private noncomputable def grEquiv (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') : AssocGraded I ≃+* AssocGraded I' :=
  have h₁ : (e.symm : B →+* A).comp (e : A →+* B) = RingHom.id A :=
    RingHom.ext fun a => e.symm_apply_apply a
  have h₂ : (e : A →+* B).comp (e.symm : B →+* A) = RingHom.id B :=
    RingHom.ext fun a => e.apply_symm_apply a
  have h' : I'.map (e.symm : B →+* A) ≤ I := by
    rw [← h, Ideal.map_map, h₁, Ideal.map_id]
  RingEquiv.ofRingHom (grMapLE (e : A →+* B) I I' h.le)
    (grMapLE (e.symm : B →+* A) I' I h')
    (RingHom.ext fun x => by
      rw [RingHom.comp_apply, grMapLE_comp _ _ _ _ _ _ _ (by rw [h₂, Ideal.map_id])]
      simp only [h₂]
      exact grMapLE_id I' _ x)
    (RingHom.ext fun x => by
      rw [RingHom.comp_apply, grMapLE_comp _ _ _ _ _ _ _ (by rw [h₁, Ideal.map_id])]
      simp only [h₁]
      exact grMapLE_id I _ x)

private theorem grEquiv_mk (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') (n : ℕ) (a : A) (ha : a ∈ I ^ n) (ha' : e a ∈ I' ^ n) :
    grEquiv e I I' h (AssocGraded.mk I n a ha) = AssocGraded.mk I' n (e a) ha' :=
  grMapLE_mk _ I I' _ n a ha ha'

private theorem grEquiv_symm_mk (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') (n : ℕ) (b : B) (hb : b ∈ I' ^ n) (hb' : e.symm b ∈ I ^ n) :
    (grEquiv e I I' h).symm (AssocGraded.mk I' n b hb) = AssocGraded.mk I n (e.symm b) hb' :=
  grMapLE_mk _ I' I _ n b hb hb'

private theorem mem_pow_map_ringEquiv_iff (e : A ≃+* B) (I : Ideal A) (n : ℕ) (a : A) :
    e a ∈ (I.map (e : A →+* B)) ^ n ↔ a ∈ I ^ n := by
  rw [← Ideal.map_pow, Ideal.map_comap_of_equiv, Ideal.mem_comap]
  simp

private theorem ordElem_map_ringEquiv (e : A ≃+* B) (I : Ideal A) (a : A) :
    Ideal.ordElem (I.map (e : A →+* B)) (e a) = Ideal.ordElem I a := by
  simp only [Ideal.ordElem, mem_pow_map_ringEquiv_iff]

/-- The graded isomorphism `σ` preserves the homogeneous components. -/
private theorem grEquiv_mem_homogeneous (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') {n : ℕ} {x : AssocGraded I}
    (hx : x ∈ AssocGraded.homogeneous I n) :
    grEquiv e I I' h x ∈ AssocGraded.homogeneous I' n := by
  obtain ⟨y, hy, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous I hx
  rw [grEquiv_mk e I I' h n y hy (by rw [← h]; exact (mem_pow_map_ringEquiv_iff e I n y).mpr hy)]
  exact AssocGraded.mk_mem_homogeneous _ _

private theorem grEquiv_symm_mem_homogeneous (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') {n : ℕ} {x : AssocGraded I'}
    (hx : x ∈ AssocGraded.homogeneous I' n) :
    (grEquiv e I I' h).symm x ∈ AssocGraded.homogeneous I n := by
  obtain ⟨y, hy, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous I' hx
  rw [grEquiv_symm_mk e I I' h n y hy (by
    rw [← (mem_pow_map_ringEquiv_iff e I n _), e.apply_symm_apply, h]; exact hy)]
  exact AssocGraded.mk_mem_homogeneous _ _

private theorem grEquiv_initialForm (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') (a : A) :
    grEquiv e I I' h (initialForm I a) = initialForm I' (e a) := by
  subst h
  by_cases htop : Ideal.ordElem I a = ⊤
  · have htop' : Ideal.ordElem (I.map (e : A →+* B)) (e a) = ⊤ := by
      rw [ordElem_map_ringEquiv]; exact htop
    rw [initialForm, dite_eq_left htop, initialForm, dite_eq_left htop', map_zero]
  · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
    have hn' : Ideal.ordElem (I.map (e : A →+* B)) (e a) = n := by
      rw [ordElem_map_ringEquiv]; exact hn.symm
    rw [initialForm_eq_mk I hn.symm, initialForm_eq_mk _ hn', grEquiv_mk]

/-- `σ(gr_I(J, A)) = gr_{I'}(JB, B)`, as a membership equivalence. -/
private theorem grEquiv_mem_grIdeal_iff (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') (J : Ideal A) (x : AssocGraded I) :
    grEquiv e I I' h x ∈ grIdeal I' (J.map (e : A →+* B)) ↔ x ∈ grIdeal I J := by
  have key : (grIdeal I J).map (grEquiv e I I' h) = grIdeal I' (J.map (e : A →+* B)) := by
    rw [grIdeal, grIdeal, Ideal.map_span]
    congr 1
    ext y
    constructor
    · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      refine ⟨e a, ?_, (grEquiv_initialForm e I I' h a).symm⟩
      exact Ideal.mem_map_of_mem _ ha
    · rintro ⟨b, hb, rfl⟩
      rw [Ideal.map_comap_of_equiv, SetLike.mem_coe, Ideal.mem_comap] at hb
      refine ⟨initialForm I (e.symm b), ⟨e.symm b, hb, rfl⟩, ?_⟩
      rw [grEquiv_initialForm, e.apply_symm_apply]
  rw [← key]
  exact Ideal.mem_map_of_equiv _ _ |>.trans (by simp)

/-- The structure map `A → gr_I(A)` is `a ↦ a X⁰`, the class of `a` in `gr⁰_I(A) = A/I`. -/
private theorem algebraMap_eq_mk_zero (I : Ideal A) (c : A) :
    algebraMap A (AssocGraded I) c = AssocGraded.mk I 0 c (by simp) := by
  rw [AssocGraded.algebraMap_apply]
  congr 1

/-- The isomorphism `σ` induced by `e` is a homomorphism of algebras over the structure map: it maps
the image of `c ∈ A` to the image of `e c ∈ B`. -/
private theorem grEquiv_algebraMap (e : A ≃+* B) (I : Ideal A) (I' : Ideal B)
    (h : I.map (e : A →+* B) = I') (c : A) :
    grEquiv e I I' h (algebraMap A (AssocGraded I) c) = algebraMap B (AssocGraded I') (e c) := by
  rw [algebraMap_eq_mk_zero, algebraMap_eq_mk_zero, grEquiv_mk e I I' h 0 c _ (by simp)]

end GradedIso

section SpanAux

open Polynomial

variable {A : Type u} [CommRing A]

/-- `[r a Xⁿ] = r̄ • [a Xⁿ]` in `gr_I(A)`. -/
private theorem AssocGraded.mk_mul_left (I : Ideal A) (n : ℕ) (r a : A) (ha : a ∈ I ^ n)
    (hra : r * a ∈ I ^ n) :
    AssocGraded.mk I n (r * a) hra = (Ideal.Quotient.mk I r) • AssocGraded.mk I n a ha := by
  rw [Algebra.smul_def]
  refine (congrArg (Ideal.Quotient.mk _) (Subtype.ext ?_)).trans
    (map_mul (Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I))
      (algebraMap A (reesAlgebra I) r) ⟨monomial n a, reesAlgebra.monomial_mem.mpr ha⟩)
  show monomial n (r * a) = C r * monomial n a
  rw [C_mul_monomial]

/-- `[a X⁰] = ā • 1`. -/
private theorem AssocGraded.mk_zero_eq_smul_one (I : Ideal A) (a : A) (ha : a ∈ I ^ 0) :
    AssocGraded.mk I 0 a ha = (Ideal.Quotient.mk I a) • (1 : AssocGraded I) := by
  rw [Algebra.smul_def, mul_one]
  show Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ (algebraMap A (reesAlgebra I) a)
  refine congrArg _ (Subtype.ext ?_)
  show monomial 0 a = C a
  rfl

/-- The classes `[x X¹]` (`x ∈ s`) span `gr¹_I(A)` over `A/I` when `s` generates `I`. -/
private theorem AssocGraded.mk_one_mem_span (I : Ideal A) (s : Finset A) (hs : Ideal.span (s : Set A) = I)
    (hs1 : ∀ x : s, (x : A) ∈ I ^ 1) :
    ∀ y (hy : y ∈ I ^ 1), AssocGraded.mk I 1 y hy ∈ Submodule.span (A ⧸ I)
      (Set.range fun x : s => AssocGraded.mk I 1 (x : A) (hs1 x)) := by
  have key : ∀ y ∈ Submodule.span A (s : Set A), ∀ hy : y ∈ I ^ 1,
      AssocGraded.mk I 1 y hy ∈ Submodule.span (A ⧸ I)
        (Set.range fun x : s => AssocGraded.mk I 1 (x : A) (hs1 x)) := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem x hx => exact fun _ => Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
    | zero =>
      intro h0
      rw [(AssocGraded.mk_eq_zero_iff I h0).mpr (zero_mem _)]
      exact zero_mem _
    | add x y hx hy ihx ihy =>
      intro hxy
      have hx1 : x ∈ I ^ 1 := by rw [pow_one, ← hs]; exact hx
      have hy1 : y ∈ I ^ 1 := by rw [pow_one, ← hs]; exact hy
      rw [AssocGraded.mk_add I 1 x y hx1 hy1]
      exact add_mem (ihx hx1) (ihy hy1)
    | smul r x hx ihx =>
      intro hrx
      have hx1 : x ∈ I ^ 1 := by rw [pow_one, ← hs]; exact hx
      show AssocGraded.mk I 1 (r * x) hrx ∈ _
      rw [AssocGraded.mk_mul_left I 1 r x hx1]
      exact Submodule.smul_mem _ _ (ihx hx1)
  intro y hy
  exact key y (by rw [← Ideal.span, hs, ← pow_one I]; exact hy) hy

/-- Every homogeneous element of degree `e` of `gr_I(A)` is an `A/I`-linear combination of
monomials of degree `e` in the classes `[x X¹]`, `x ∈ s`, when `s` generates `I`. -/
private theorem AssocGraded.mk_mem_span_prod (I : Ideal A) (s : Finset A)
    (hs : Ideal.span (s : Set A) = I) (hs1 : ∀ x : s, (x : A) ∈ I ^ 1) :
    ∀ (e : ℕ) (y : A) (hy : y ∈ I ^ e), AssocGraded.mk I e y hy ∈ Submodule.span (A ⧸ I)
      (Set.range fun g : Fin e → s => ∏ t, AssocGraded.mk I 1 (g t : A) (hs1 (g t))) := by
  intro e
  induction e with
  | zero =>
    intro y hy
    rw [AssocGraded.mk_zero_eq_smul_one]
    refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨Fin.elim0, ?_⟩)
    simp
  | succ e ih =>
    have key : ∀ (x : A) (hx : x ∈ I ^ e * I),
        AssocGraded.mk I (e + 1) x (by rwa [pow_succ]) ∈ Submodule.span (A ⧸ I)
          (Set.range fun g : Fin (e + 1) → s =>
            ∏ t, AssocGraded.mk I 1 (g t : A) (hs1 (g t))) := by
      intro x hx
      induction hx using Submodule.mul_induction_on' with
      | mem_mul_mem m hm y hy =>
        have hy1 : y ∈ I ^ 1 := by rwa [pow_one]
        rw [← AssocGraded.mk_mul_mk I hm hy1]
        have h1 := Submodule.mul_mem_mul (ih m hm) (AssocGraded.mk_one_mem_span I s hs hs1 y hy1)
        rw [Submodule.span_mul_span] at h1
        refine Submodule.span_mono ?_ h1
        rintro _ ⟨_, ⟨g, rfl⟩, _, ⟨x, rfl⟩, rfl⟩
        refine ⟨Fin.snoc g x, ?_⟩
        simp only [Fin.prod_univ_castSucc, Fin.snoc_castSucc, Fin.snoc_last]
      | add x hx y hy ihx ihy =>
        rw [AssocGraded.mk_add I (e + 1) x y (by rwa [pow_succ]) (by rwa [pow_succ])]
        exact add_mem ihx ihy
    intro y hy
    exact key y (by rwa [← pow_succ])

end SpanAux

section CountAux

variable (R : Type u) [CommRing R] [IsRegularLocalRing R]

/-- Every homogeneous element of `gr_M(R)` of degree `e` is a linear combination of monomials of
degree `e` in the initial forms of a system `s` of generators of `M`. -/
private theorem homogeneous_le_span_prod (s : Finset R)
    (hs : Ideal.span (s : Set R) = maximalIdeal R)
    (hs1 : ∀ x : s, (x : R) ∈ maximalIdeal R ^ 1) (e : ℕ) :
    AssocGraded.homogeneous (maximalIdeal R) e ≤ Submodule.span (R ⧸ maximalIdeal R)
      (Set.range fun g : Fin e → s => ∏ t, AssocGraded.mk (maximalIdeal R) 1 (g t : R)
        (hs1 (g t))) := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous (maximalIdeal R) hx
  exact AssocGraded.mk_mem_span_prod (maximalIdeal R) s hs hs1 e y hy

/-- `gr_M(R)` is generated as an `R/M`-algebra by the initial forms of a system of generators of
`M`. -/
private theorem adjoin_mk_one_eq_top (s : Finset R)
    (hs : Ideal.span (s : Set R) = maximalIdeal R)
    (hs1 : ∀ x : s, (x : R) ∈ maximalIdeal R ^ 1) :
    Algebra.adjoin (R ⧸ maximalIdeal R)
      (Set.range fun x : s => AssocGraded.mk (maximalIdeal R) 1 (x : R) (hs1 x)) = ⊤ := by
  refine eq_top_iff.mpr fun φ _ => ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective φ
  rw [mk_eq_sum_mk]
  refine Subalgebra.sum_mem _ fun i _ => ?_
  have h := homogeneous_le_span_prod R s hs hs1 i
    (AssocGraded.mk_mem_homogeneous (maximalIdeal R) ((mem_reesAlgebra_iff _ p).mp p.2 i))
  have h' : Submodule.span (R ⧸ maximalIdeal R) (Set.range fun g : Fin i → s =>
      ∏ t, AssocGraded.mk (maximalIdeal R) 1 (g t : R) (hs1 (g t))) ≤
      Subalgebra.toSubmodule (Algebra.adjoin (R ⧸ maximalIdeal R)
        (Set.range fun x : s => AssocGraded.mk (maximalIdeal R) 1 (x : R) (hs1 x))) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨g, rfl⟩
    exact Subalgebra.prod_mem _ fun t _ => Algebra.subset_adjoin ⟨g t, rfl⟩
  exact h' h

/-- `τ^{(a)}(J)` is at most the number of elements of a system of generators of `M`
(p. 235: "the numbers `τ^{(b)}` are all bounded by `dim R_α`"). -/
private theorem tau_le_card (J : Ideal R) (s : Finset R)
    (hs : Ideal.span (s : Set R) = maximalIdeal R) (a : ℕ) : tau R J a ≤ s.card := by
  have hs1 : ∀ x : s, (x : R) ∈ maximalIdeal R ^ 1 := fun x => by
    rw [pow_one, ← hs]; exact Ideal.subset_span x.2
  let W : Fin s.card → AssocGraded (maximalIdeal R) := fun i =>
    AssocGraded.mk (maximalIdeal R) 1 (s.equivFin.symm i : R) (hs1 _)
  have hW : ∀ i, W i ∈ AssocGraded.homogeneous (maximalIdeal R) 1 := fun i =>
    AssocGraded.mk_mem_homogeneous _ _
  have hadj : Algebra.adjoin (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R) (Set.range W) : Set (AssocGraded (maximalIdeal R))) =
        ⊤ := by
    refine eq_top_iff.mpr ?_
    rw [← adjoin_mk_one_eq_top R s hs hs1]
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨x, rfl⟩
    refine Submodule.subset_span ⟨s.equivFin x, ?_⟩
    simp [W]
  refine tau_le R J W hW ⟨Submodule.span_le.mpr ?_, fun μ _ ψ _ => ?_⟩
  · rintro _ ⟨i, rfl⟩
    exact hW i
  · rw [hadj, Algebra.coe_top, Set.inter_univ, Ideal.span_eq]

/-- For a system `φ` with non-decreasing degrees `d` and `φ_i ∉ (φ₁, …, φ_{i-1})`, the classes of
the `φ_j` of degree `μ` are `K`-linearly independent modulo the ideal generated by the `φ_j` of
degree `< μ` (take the largest `j` with a non-zero coefficient in a relation). -/
private theorem linearIndependent_mkQ_of_not_mem_span {m : ℕ} (φ : Fin m → AssocGraded (maximalIdeal R))
    (d : Fin m → ℕ) (h₂ : Monotone d)
    (h₃ : ∀ i : Fin m, φ i ∉ Ideal.span (Set.range fun j : Fin i => φ (Fin.castLE i.2.le j)))
    (μ : ℕ) :
    LinearIndependent (R ⧸ maximalIdeal R) (fun j : {j // d j = μ} =>
      ((Ideal.span (Set.range fun k : {k // d k < μ} => φ k)).restrictScalars
        (R ⧸ maximalIdeal R)).mkQ (φ j)) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  rw [linearIndependent_iff']
  intro s g hg j hj
  by_contra hgj
  have hne : (s.filter fun i => g i ≠ 0).Nonempty := ⟨j, Finset.mem_filter.mpr ⟨hj, hgj⟩⟩
  set j₀ := (s.filter fun i => g i ≠ 0).max' hne with hj₀def
  obtain ⟨hj₀s, hgj₀⟩ := Finset.mem_filter.mp ((s.filter fun i => g i ≠ 0).max'_mem hne)
  have hmax : ∀ i ∈ s, g i ≠ 0 → i ≤ j₀ := fun i hi hgi =>
    (s.filter fun i => g i ≠ 0).le_max' i (Finset.mem_filter.mpr ⟨hi, hgi⟩)
  set P : Ideal (AssocGraded (maximalIdeal R)) :=
    Ideal.span (Set.range fun k : Fin j₀.1 => φ (Fin.castLE j₀.1.2.le k)) with hP
  have hmemP : ∀ k : Fin m, k < j₀.1 → φ k ∈ P := fun k hk =>
    Ideal.subset_span ⟨⟨k, hk⟩, rfl⟩
  have hsum : ∑ i ∈ s, g i • φ i.1 ∈ (Ideal.span (Set.range fun k : {k // d k < μ} =>
      φ k)).restrictScalars (R ⧸ maximalIdeal R) := by
    have h0 : ((Ideal.span (Set.range fun k : {k // d k < μ} => φ k)).restrictScalars
        (R ⧸ maximalIdeal R)).mkQ (∑ i ∈ s, g i • φ i.1) = 0 := by
      rw [map_sum]
      simpa only [map_smul] using hg
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h0
  have hUP : Ideal.span (Set.range fun k : {k // d k < μ} => φ k) ≤ P := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨k, rfl⟩
    refine hmemP k ?_
    by_contra hk
    have := h₂ (not_lt.mp hk)
    have h1 := k.2
    have h2 := j₀.2
    omega
  have hrest : ∑ i ∈ s.erase j₀, g i • φ i.1 ∈ P.restrictScalars (R ⧸ maximalIdeal R) := by
    refine Submodule.sum_mem _ fun i hi => ?_
    obtain ⟨hij, his⟩ := Finset.mem_erase.mp hi
    by_cases hgi : g i = 0
    · rw [hgi, zero_smul]
      exact zero_mem _
    · refine Submodule.smul_mem _ _ (hmemP i.1 ?_)
      exact lt_of_le_of_ne (hmax i his hgi) (fun h => hij (Subtype.ext h))
  have hj₀P : g j₀ • φ j₀.1 ∈ P.restrictScalars (R ⧸ maximalIdeal R) := by
    have := sub_mem (hUP hsum) hrest
    rwa [← Finset.add_sum_erase s _ hj₀s, add_sub_cancel_right] at this
  apply h₃ j₀.1
  have := Submodule.smul_mem (P.restrictScalars (R ⧸ maximalIdeal R)) (g j₀)⁻¹ hj₀P
  rwa [smul_smul, inv_mul_cancel₀ hgj₀, one_smul] at this

/-- **The rank of `gr^μ_M(R)`** (p. 235: "the rank of `gr^μ_{M_α}(R_α)`, which is equal to
`C(n + μ − 1, n − 1)` if `n = dim R_α`"): `gr_M(R)` is a polynomial ring in `n = spanFinrank M`
variables over `K = R/M` (`exists_gradedAlgEquiv`), and the number of monomials of degree `μ` in `n`
variables is `C(n + μ − 1, μ)` (`= C(n + μ − 1, n − 1)` for `n ≥ 1`; for `n = 0` it is `0` for
`μ ≥ 1`, the correct rank for a field).  Also `gr^μ_M(R)` is a finite-dimensional `K`-space. -/
private theorem homogeneous_finite_and_finrank (μ : ℕ) :
    letI : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
    Module.Finite (R ⧸ maximalIdeal R) (AssocGraded.homogeneous (maximalIdeal R) μ) ∧
      Module.finrank (R ⧸ maximalIdeal R) (AssocGraded.homogeneous (maximalIdeal R) μ) =
        ((maximalIdeal R).spanFinrank + μ - 1).choose μ := by
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨r, e, hr, he, -⟩ := exists_gradedAlgEquiv R
  have hmap : (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ).map
      e.toLinearEquiv.toLinearMap = AssocGraded.homogeneous (maximalIdeal R) μ := by
    ext x
    constructor
    · rintro ⟨p, hp, rfl⟩
      exact (he μ p).mp hp
    · intro hx
      exact ⟨e.symm x, (he μ _).mpr (by simpa using hx), by simp⟩
  let ε := e.toLinearEquiv.submoduleMap
    (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ)
  have hfinG : Module.Finite (R ⧸ maximalIdeal R)
      (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ) :=
    Module.Finite.of_fg (MvPolynomial.homogeneousSubmodule_fg (Fin r) (R ⧸ maximalIdeal R) μ)
  have hfin' : Module.Finite (R ⧸ maximalIdeal R)
      ((MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ).map
        e.toLinearEquiv.toLinearMap) := Module.Finite.equiv ε
  rw [hmap] at hfin'
  refine ⟨hfin', ?_⟩
  have h1 : Module.finrank (R ⧸ maximalIdeal R) (AssocGraded.homogeneous (maximalIdeal R) μ) =
      Module.finrank (R ⧸ maximalIdeal R)
        (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ) := by
    have := LinearEquiv.finrank_eq ε
    rw [hmap] at this
    exact this.symm
  have h2 : Module.finrank (R ⧸ maximalIdeal R)
      (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ) =
      Nat.card {d : Fin r →₀ ℕ | d.degree = μ} := by
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported]
    exact Module.finrank_eq_nat_card_basis (MvPolynomial.basisRestrictSupport (R ⧸ maximalIdeal R)
      {d : Fin r →₀ ℕ | d.degree = μ})
  have hset : {d : Fin r →₀ ℕ | d.degree = μ} =
      (↑((Finset.univ : Finset (Fin r)).finsuppAntidiag μ) : Set (Fin r →₀ ℕ)) := by
    ext d
    simp only [Set.mem_ofPred_eq, Finset.mem_coe, Finset.mem_finsuppAntidiag,
      Finset.subset_univ, and_true, Finsupp.degree_eq_sum]
  rw [h1, h2, hset, Nat.card_coe_set_eq, Set.ncard_coe_finset,
    Finset.card_finsuppAntidiag_nat_eq_choose, Finset.card_univ, Fintype.card_fin, hr]

/-- The number of elements of degree `e` of a Lemma 1 system is at most the rank of `gr^e_M(R)`,
which is `C(n + e − 1, e)` (p. 235: "the number of those `ν^{(i)} = μ` is bounded by the rank of
`gr^μ_{M_α}(R_α)`, which is equal to `C(n + μ − 1, n − 1)` if `n = dim R_α`").  The classes of the
elements of degree `e` are linearly independent modulo the elements of lower degree, in particular
in `gr^e_M(R)`. -/
private theorem card_filter_eq_le_choose {m : ℕ}
    (φ : Fin m → AssocGraded (maximalIdeal R)) (d : Fin m → ℕ)
    (hd : ∀ j, φ j ∈ AssocGraded.homogeneous (maximalIdeal R) (d j)) (h₂ : Monotone d)
    (h₃ : ∀ i : Fin m, φ i ∉ Ideal.span (Set.range fun j : Fin i => φ (Fin.castLE i.2.le j)))
    (e : ℕ) : (Finset.univ.filter fun j => d j = e).card ≤
      ((maximalIdeal R).spanFinrank + e - 1).choose e := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨hfin, hrk⟩ := homogeneous_finite_and_finrank R e
  have hli := linearIndependent_mkQ_of_not_mem_span R φ d h₂ h₃ e
  have hli0 : LinearIndependent (R ⧸ maximalIdeal R) (fun j : {j : Fin m // d j = e} => φ j) :=
    LinearIndependent.of_comp ((Ideal.span (Set.range fun k : {k // d k < e} => φ k)).restrictScalars
      (R ⧸ maximalIdeal R)).mkQ hli
  have hmem : ∀ j : {j : Fin m // d j = e}, φ j ∈ AssocGraded.homogeneous (maximalIdeal R) e :=
    fun j => by have h := hd j.1; rw [j.2] at h; exact h
  have hli1 : LinearIndependent (R ⧸ maximalIdeal R) (fun j : {j : Fin m // d j = e} =>
      (⟨φ j, hmem j⟩ : AssocGraded.homogeneous (maximalIdeal R) e)) :=
    LinearIndependent.of_comp (AssocGraded.homogeneous (maximalIdeal R) e).subtype hli0
  have := hli1.fintype_card_le_finrank
  rw [Fintype.card_subtype] at this
  rw [← hrk]
  exact this

/-- The number of `k` with `ν^{(k)}(J) = μ` is finite and at most the rank `C(n + μ − 1, μ)` of
`gr^μ_M(R)` (p. 235). -/
private theorem ncard_nuI_eq_le_choose (J : Ideal R) (μ : ℕ) :
    {k : ℕ+ | nuI R J k = (μ : ℕ∞)}.Finite ∧ {k : ℕ+ | nuI R J k = (μ : ℕ∞)}.ncard ≤
      ((maximalIdeal R).spanFinrank + μ - 1).choose μ := by
  classical
  obtain ⟨m, f, hf⟩ := exists_isStandardBase J
  obtain ⟨-, hJφ, ⟨d, hd, hmono⟩, hspan, hnot⟩ := hf
  have h := nuI_eq_of_lemma1_properties R J _ hJφ d hd hspan hmono hnot
  have hsub : {k : ℕ+ | nuI R J k = (μ : ℕ∞)} ⊆
      (fun j : Fin m => ((j : ℕ).succPNat)) '' ↑(Finset.univ.filter fun j => d j = μ) := by
    intro k hk
    rw [Set.mem_ofPred_eq] at hk
    have hkm : (k : ℕ) ≤ m := by
      by_contra hlt
      rw [h.2 k (by omega)] at hk
      exact absurd hk (by simp)
    have hk0 := k.pos
    let j : Fin m := ⟨(k : ℕ) - 1, by omega⟩
    have hkj : nuI R J k = d j := by
      rw [← h.1 j]
      congr 1
      apply PNat.eq
      simp only [PNat.mk_coe, j]
      omega
    refine ⟨j, ?_, PNat.eq (by simp only [Nat.succPNat_coe, j]; omega)⟩
    rw [hkj] at hk
    simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq]
    exact_mod_cast hk
  have hfin : ((fun j : Fin m => ((j : ℕ).succPNat)) ''
      ↑(Finset.univ.filter fun j => d j = μ)).Finite := Set.Finite.image _ (Finset.finite_toSet _)
  refine ⟨hfin.subset hsub, ?_⟩
  refine (Set.ncard_le_ncard hsub hfin).trans ((Set.ncard_image_le (Finset.finite_toSet _)).trans ?_)
  rw [Set.ncard_coe_finset]
  exact card_filter_eq_le_choose R _ d hd hmono hnot μ

end CountAux

section NuAux

variable (R : Type u) [CommRing R] [IsRegularLocalRing R] (J : Ideal R)

/-- A system of Definition 1 up to `ν` gives `ν ≤ ν^{(i)}(J)`. -/
private theorem le_nuI_of_isNuSystem (i : ℕ+) {ν : ℕ}
    (φ : Fin ((i : ℕ) - 1) → AssocGraded (maximalIdeal R)) (hφ : IsNuSystem R J ν _ φ) :
    (ν : ℕ∞) ≤ nuI R J i :=
  le_iSup₂ (f := fun (ν : ℕ) (_ : ∃ φ : Fin ((i : ℕ) - 1) → AssocGraded (maximalIdeal R),
    IsNuSystem R J ν _ φ) => (ν : ℕ∞)) ν ⟨φ, hφ⟩

/-- The maximum in Definition 1 is attained: if `ν^{(i)}(J) = μ < ∞` there is a system of
`i - 1` homogeneous elements with the property of Definition 1 up to `μ`. -/
private theorem exists_isNuSystem_of_nuI_eq (i : ℕ+) {μ : ℕ} (h : nuI R J i = μ) :
    ∃ φ : Fin ((i : ℕ) - 1) → AssocGraded (maximalIdeal R), IsNuSystem R J μ _ φ := by
  let S : Set ℕ := {ν | ∃ φ : Fin ((i : ℕ) - 1) → AssocGraded (maximalIdeal R),
    IsNuSystem R J ν _ φ}
  have hbdd : BddAbove S := ⟨μ, fun ν ⟨φ, hφ⟩ => by
    have := le_nuI_of_isNuSystem R J i φ hφ
    rw [h] at this
    exact_mod_cast this⟩
  have hne : S.Nonempty := ⟨0, fun _ => 0, fun _ => ⟨zero_mem _, 0, zero_mem _⟩,
    fun μ hμ => absurd hμ (Nat.not_lt_zero _)⟩
  have hsup : nuI R J i = ((sSup S : ℕ) : ℕ∞) := by
    rw [ENat.natCast_sSup hbdd]
    rfl
  rw [h, Nat.cast_inj] at hsup
  rw [hsup]
  exact Nat.sSup_mem hne hbdd

/-- The key step of the noetherian argument of Theorem 4: if `ν^{(j)}(J) = μ' < ∞` then some
homogeneous element of degree `μ'` of `gr_M(J, R)` does not lie in the ideal generated by the
homogeneous elements of `gr_M(J, R)` of degrees `≤ μ₀ < μ'`. -/
private theorem false_of_mem_span_low (j : ℕ+) {μ' : ℕ} (hj : nuI R J j = μ') {μ₀ : ℕ}
    (hμ : μ₀ < μ')
    (h : ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ', ψ ∈ grIdeal (maximalIdeal R) J →
      ψ ∈ Ideal.span {χ | χ ∈ grIdeal (maximalIdeal R) J ∧
        ∃ d ≤ μ₀, χ ∈ AssocGraded.homogeneous (maximalIdeal R) d}) : False := by
  obtain ⟨φ, hφ⟩ := exists_isNuSystem_of_nuI_eq R J j hj
  have hle : Ideal.span {χ | χ ∈ grIdeal (maximalIdeal R) J ∧
      ∃ d ≤ μ₀, χ ∈ AssocGraded.homogeneous (maximalIdeal R) d} ≤ Ideal.span (Set.range φ) := by
    refine Ideal.span_le.mpr ?_
    rintro χ ⟨hχJ, d, hd, hχ⟩
    exact (hφ.2 d (by omega) χ hχ).mpr hχJ
  have hsys : IsNuSystem R J (μ' + 1) _ φ := by
    refine ⟨hφ.1, fun μ hμ ψ hψ => ?_⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hμ with hlt | rfl
    · exact hφ.2 μ hlt ψ hψ
    · refine ⟨fun h1 => ?_, fun h1 => hle (h ψ hψ h1)⟩
      refine (Ideal.span_le.mpr ?_) h1
      rintro _ ⟨k, rfl⟩
      exact (hφ.1 k).1
  have := le_nuI_of_isNuSystem R J j φ hsys
  rw [hj] at this
  norm_cast at this
  omega

open Classical in
/-- The bookkeeping of the proof of Theorem 4: suppose the initial segment
`(ν^{(1)}(J), …, ν^{(i+1)}(J))` agrees with that of a non-decreasing sequence `L` which jumps
at `i` (`L(i) < L(i+1)`), `L(i) = y`.  Then with `a` the number of distinct values of `L` which
are `≤ y`, `μ^{(a)}(J) = y`, `1 ≤ a ≤ t(J)` and `i` is the largest index with
`ν^{(i)}(J) = μ^{(a)}(J)`. -/
private theorem mu_eq_of_count (L : ℕ+ → ℕ∞) (hL : Monotone L) (i : ℕ+) (y : ℕ)
    (hLi : L i = y) (hjump : L i < L (i + 1))
    (hpre : ∀ k : ℕ+, k ≤ i + 1 → nuI R J k = L k) :
    mu R J (Nat.count (fun z => ∃ k, L k = (z : ℕ∞)) y + 1) = y ∧
      Nat.count (fun z => ∃ k, L k = (z : ℕ∞)) y + 1 ≤ t R J ∧
      IsGreatest {k : ℕ+ | nuI R J k =
        (mu R J (Nat.count (fun z => ∃ k, L k = (z : ℕ∞)) y + 1) : ℕ∞)} i := by
  have hmonoν : ∀ k : ℕ+, i + 1 ≤ k → L (i + 1) ≤ nuI R J k := fun k hk => by
    rw [← hpre (i + 1) le_rfl]
    exact nuI_mono J hk
  have hlow : ∀ z ≤ y, ((∃ k, L k = (z : ℕ∞)) ↔ z ∈ muSet R J) := by
    intro z hz
    constructor
    · rintro ⟨k, hk⟩
      refine ⟨k, ?_⟩
      by_cases hki : k ≤ i + 1
      · rw [hpre k hki, hk]
      · have h1 := hL (le_of_lt (not_le.mp hki))
        rw [hk] at h1
        have h2 : L i < L (i + 1) := hjump
        rw [hLi] at h2
        exact absurd (lt_of_lt_of_le h2 h1) (by exact_mod_cast not_lt.mpr hz)
    · rintro ⟨k, hk⟩
      refine ⟨k, ?_⟩
      by_cases hki : k ≤ i + 1
      · rw [← hpre k hki, hk]
      · have h1 := hmonoν k (le_of_lt (not_le.mp hki))
        rw [hk] at h1
        have h2 : L i < L (i + 1) := hjump
        rw [hLi] at h2
        exact absurd (lt_of_lt_of_le h2 h1) (by exact_mod_cast not_lt.mpr hz)
  have hcount : Nat.count (fun z => ∃ k, L k = (z : ℕ∞)) y = Nat.count (· ∈ muSet R J) y :=
    Nat.count_congr y fun z hz => hlow z hz.le
  have hy : y ∈ muSet R J := ⟨i, by rw [hpre i (PNat.lt_add_right i 1).le, hLi]⟩
  have hmu : mu R J (Nat.count (fun z => ∃ k, L k = (z : ℕ∞)) y + 1) = y := by
    rw [mu, Nat.add_sub_cancel, hcount]
    exact Nat.nth_count hy
  refine ⟨hmu, ?_, ?_⟩
  · have hfin := (muSet_finite R J).1
    have h1 : Nat.count (· ∈ muSet R J) y < (muSet R J).ncard := by
      rw [Set.ncard_eq_toFinset_card _ hfin]
      exact Nat.count_lt_card hfin hy
    rw [hcount]
    have ht : t R J = (muSet R J).ncard := rfl
    rw [ht]
    omega
  · rw [hmu]
    refine ⟨by rw [Set.mem_ofPred_eq, hpre i (PNat.lt_add_right i 1).le, hLi], fun k hk => ?_⟩
    rw [Set.mem_ofPred_eq] at hk
    by_contra hki
    have h1 := hmonoν k (by
      have : i < k := not_le.mp hki
      exact PNat.add_one_le_iff.mpr this)
    rw [hk] at h1
    have h2 : L i < L (i + 1) := hjump
    rw [hLi] at h2
    exact absurd (lt_of_lt_of_le h2 h1) (lt_irrefl _)

open Classical in
/-- The bookkeeping of the proof of Theorem 4 in the printed form (p. 235): let `μ_a` be the `a`-th
smallest of the distinct integers which appear in the non-decreasing sequence `L = (ν^{(i)})`
(`μ_1 < μ_2 < …`, infinitely many), and let `i = i(a)` be such that `L j ≤ μ_a` for `j ≤ i` and
`L j > μ_a` for `j > i`.  If the initial segment of `ν^{(j)}(J)` up to `i + 1` agrees with that of
`L`, then `μ^{(a)}(J) = μ_a`, `a ≤ t(J)` and `i` is the largest index with
`ν^{(i)}(J) = μ^{(a)}(J)`. -/
private theorem mu_eq_of_nth (L : ℕ+ → ℕ∞) (hL : Monotone L)
    (hinf : {z : ℕ | ∃ k, L k = (z : ℕ∞)}.Infinite) (a i : ℕ+)
    (hle : ∀ j : ℕ+, j ≤ i →
      L j ≤ (Nat.nth (fun z => ∃ k, L k = (z : ℕ∞)) ((a : ℕ) - 1) : ℕ∞))
    (hgt : ∀ j : ℕ+, i < j →
      (Nat.nth (fun z => ∃ k, L k = (z : ℕ∞)) ((a : ℕ) - 1) : ℕ∞) < L j)
    (hpre : ∀ k : ℕ+, k ≤ i + 1 → nuI R J k = L k) :
    mu R J a = Nat.nth (fun z => ∃ k, L k = (z : ℕ∞)) ((a : ℕ) - 1) ∧ (a : ℕ) ≤ t R J ∧
      IsGreatest {k : ℕ+ | nuI R J k = (mu R J a : ℕ∞)} i := by
  obtain ⟨y, hy⟩ : ∃ y, y = Nat.nth (fun z => ∃ k, L k = (z : ℕ∞)) ((a : ℕ) - 1) := ⟨_, rfl⟩
  rw [← hy] at hle hgt ⊢
  obtain ⟨k, hk⟩ : ∃ k, L k = (y : ℕ∞) := by
    rw [hy]
    exact Nat.nth_mem_of_infinite hinf _
  have hki : k ≤ i := by
    by_contra h
    have := hgt k (not_le.mp h)
    rw [hk] at this
    exact lt_irrefl _ this
  have hLi : L i = y := le_antisymm (hle i le_rfl) ((le_of_eq hk.symm).trans (hL hki))
  have hjump : L i < L (i + 1) := by
    rw [hLi]
    exact hgt _ (PNat.lt_add_right i 1)
  obtain ⟨h1, h2, h3⟩ := mu_eq_of_count R J L hL i y hLi hjump hpre
  have hcount : Nat.count (fun z => ∃ k, L k = (z : ℕ∞)) y + 1 = (a : ℕ) := by
    rw [hy, Nat.count_nth_of_infinite hinf]
    have := a.pos
    omega
  rw [hcount] at h1 h2 h3
  exact ⟨h1, h2, h3⟩

end NuAux

section SeqAux

/-- A non-increasing sequence in a well-founded linear order is eventually constant. -/
private theorem exists_stable_of_antitone {α : Type*} [LinearOrder α] [WellFoundedLT α]
    (f : ℕ → α) (hf : ∀ n, f (n + 1) ≤ f n) : ∃ M, ∀ n, M ≤ n → f n = f M := by
  have hanti : Antitone f := antitone_nat_of_succ_le hf
  obtain ⟨_, ⟨M, rfl⟩, hmin⟩ := (wellFounded_lt (α := α)).has_min (Set.range f) ⟨f 0, 0, rfl⟩
  exact ⟨M, fun n hn => le_antisymm (hanti hn) (not_lt.mp (hmin (f n) ⟨n, rfl⟩))⟩

/-- A non-decreasing bounded sequence of natural numbers is eventually constant. -/
private theorem exists_stable_of_monotone (f : ℕ → ℕ) (D : ℕ) (hf : ∀ n, f n ≤ f (n + 1))
    (hD : ∀ n, f n ≤ D) : ∃ M, ∀ n, M ≤ n → f n = f M := by
  obtain ⟨M, hM⟩ := exists_stable_of_antitone (fun n => D - f n) fun n => by
    have := hf n
    omega
  refine ⟨M, fun n hn => ?_⟩
  have h1 := hM n hn
  have h2 := hD n
  have h3 := hD M
  omega

/-- Finitely many non-decreasing (from `N` on) bounded sequences of natural numbers are
simultaneously eventually constant. -/
private theorem exists_stable_of_monotone_family (f : ℕ → ℕ → ℕ) (A D N : ℕ)
    (hf : ∀ n, N ≤ n → ∀ b ≤ A, f n b ≤ f (n + 1) b) (hD : ∀ n b, f n b ≤ D) :
    ∃ M, N ≤ M ∧ ∀ n, M ≤ n → ∀ b ≤ A, f n b = f M b := by
  let g : ℕ → ℕ := fun n => ∑ b ∈ Finset.range (A + 1), f (N + n) b
  have hg : ∀ n, g n ≤ g (n + 1) := fun n =>
    Finset.sum_le_sum fun b hb => by
      rw [Finset.mem_range] at hb
      exact hf (N + n) (by omega) b (by omega)
  obtain ⟨M, hM⟩ := exists_stable_of_monotone g ((A + 1) * D) hg fun n => by
    refine (Finset.sum_le_sum fun b _ => hD (N + n) b).trans ?_
    rw [Finset.sum_const, Finset.card_range, smul_eq_mul]
  refine ⟨N + M, by omega, ?_⟩
  -- each `f` is constant from `N + M` on
  have hstep : ∀ n, M ≤ n → ∀ b ≤ A, f (N + (n + 1)) b = f (N + n) b := by
    intro n hn b hb
    have hsum : g (n + 1) = g n := (hM (n + 1) (by omega)).trans (hM n hn).symm
    have hle : ∀ c ∈ Finset.range (A + 1), f (N + n) c ≤ f (N + (n + 1)) c := fun c hc => by
      rw [Finset.mem_range] at hc
      exact hf (N + n) (by omega) c (by omega)
    exact ((Finset.sum_eq_sum_iff_of_le hle).mp hsum.symm b (by
      rw [Finset.mem_range]; omega)).symm
  intro n hn b hb
  obtain ⟨k, rfl⟩ : ∃ k, n = N + M + k := ⟨n - (N + M), by omega⟩
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [show N + M + (k + 1) = N + (M + k + 1) by omega, hstep (M + k) (by omega) b hb,
      show N + (M + k) = N + M + k by omega]
    exact ih (by omega)

/-- In the lexicographic order, if `x ≤ y` and `x`, `y` agree up to `i`, then
`x (i + 1) ≤ y (i + 1)`. -/
private theorem apply_succPNat_le_of_toLex_le (x y : ℕ+ → ℕ∞) (h : toLex x ≤ toLex y) (i : ℕ)
    (hpre : ∀ j : ℕ+, (j : ℕ) ≤ i → x j = y j) : x i.succPNat ≤ y i.succPNat := by
  rcases h.lt_or_eq with hlt | heq
  · obtain ⟨k, hk, hklt⟩ := hlt
    by_cases hki : (k : ℕ) ≤ i
    · exact absurd (hpre k hki) (ne_of_lt hklt)
    · by_cases hk' : k = i.succPNat
      · subst hk'
        exact le_of_lt hklt
      · have : i.succPNat < k := by
          rw [← PNat.coe_lt_coe, Nat.succPNat_coe]
          have : (k : ℕ) ≠ i + 1 := fun h => hk' (PNat.eq (by rw [h, Nat.succPNat_coe]))
          omega
        exact le_of_eq (hk _ this)
  · exact le_of_eq (congrFun (toLex.injective heq) _)

/-- Prefix stabilization in the proof of Theorem 4 (p. 235): for a lexicographically
non-increasing sequence `ν_n` of sequences, every initial segment is eventually constant.  The
stabilization indices `N i` may be taken non-decreasing in `i`. -/
private theorem exists_prefix_stable (ν : ℕ → ℕ+ → ℕ∞)
    (hν : ∀ n, toLex (ν (n + 1)) ≤ toLex (ν n)) :
    ∃ N : ℕ → ℕ, Monotone N ∧
      ∀ i n, N i ≤ n → ∀ j : ℕ+, (j : ℕ) ≤ i → ν n j = ν (N i) j := by
  have hstab : ∀ i : ℕ, ∃ N, ∀ n, N ≤ n → ∀ j : ℕ+, (j : ℕ) ≤ i → ν n j = ν N j := by
    intro i
    induction i with
    | zero => exact ⟨0, fun n _ j hj => absurd j.pos (by omega)⟩
    | succ i ih =>
      obtain ⟨N, hN⟩ := ih
      obtain ⟨M, hM⟩ := exists_stable_of_antitone (fun m => ν (N + m) i.succPNat)
        fun m => apply_succPNat_le_of_toLex_le _ _ (hν (N + m)) i fun j hj =>
          (hN (N + m + 1) (by omega) j hj).trans (hN (N + m) (by omega) j hj).symm
      refine ⟨N + M, fun n hn j hj => ?_⟩
      by_cases hji : (j : ℕ) ≤ i
      · exact (hN n (by omega) j hji).trans (hN (N + M) (by omega) j hji).symm
      · have hj' : j = i.succPNat := PNat.eq (by rw [Nat.succPNat_coe]; omega)
        subst hj'
        have := hM (n - N) (by omega)
        rwa [show N + (n - N) = n by omega] at this
  choose N₀ hN₀ using hstab
  let N : ℕ → ℕ := fun i => (Finset.range (i + 1)).sup N₀
  have hNmono : Monotone N := fun i i' h =>
    Finset.sup_mono (Finset.range_subset_range.mpr (by omega))
  have hN₀le : ∀ i, N₀ i ≤ N i := fun i =>
    Finset.le_sup (f := N₀) (Finset.mem_range.mpr (by omega))
  refine ⟨N, hNmono, fun i n hn j hj => ?_⟩
  exact (hN₀ i n ((hN₀le i).trans hn) j hj).trans
    (hN₀ i (N i) (hN₀le i) j hj).symm

/-- "Arranging the integers `α(a)`, `a ∈ ℤ⁺`, in such a way that `α(a) < α(a + 1)` for all `a`":
if for every `a` a property `P a α` holds for all sufficiently large `α`, there is a strictly
increasing `α(a)` such that `P a α` holds for all `α ≥ α(a)`. -/
private theorem exists_strictMono_bound (P : ℕ+ → ℕ → Prop) (hP : ∀ a, ∃ A, ∀ n, A ≤ n → P a n) :
    ∃ α : ℕ+ → ℕ, StrictMono α ∧ ∀ a n, α a ≤ n → P a n := by
  choose A hA using hP
  have hmem : ∀ a k : ℕ+, k ≤ a →
      A k ≤ (Finset.range ((a : ℕ) + 1)).sup (fun j => A j.toPNat') := by
    intro a k hk
    have h1 := (PNat.coe_le_coe k a).mpr hk
    have := Finset.le_sup (f := fun j : ℕ => A j.toPNat')
      (Finset.mem_range.mpr (show (k : ℕ) < (a : ℕ) + 1 by omega))
    simpa [PNat.coe_toPNat'] using this
  refine ⟨fun a => (Finset.range ((a : ℕ) + 1)).sup (fun j => A j.toPNat') + a, fun a a' h => ?_,
    fun a n hn => by
      have hn' : (Finset.range ((a : ℕ) + 1)).sup (fun j => A j.toPNat') + (a : ℕ) ≤ n := hn
      exact hA a n ((hmem a a le_rfl).trans (by omega))⟩
  have h1 : (Finset.range ((a : ℕ) + 1)).sup (fun j => A j.toPNat') ≤
      (Finset.range ((a' : ℕ) + 1)).sup (fun j => A j.toPNat') :=
    Finset.sup_mono (Finset.range_subset_range.mpr (by
      have := (PNat.coe_lt_coe a a').mpr h
      omega))
  have h2 : (a : ℕ) < a' := h
  show _ + (a : ℕ) < _ + (a' : ℕ)
  omega

end SeqAux

section CoreAux

open Classical in
/-- **The residually rational case of Theorem 4** (pp. 235–236), for an abstract sequence of
regular local rings `R n` (`R_α`) with local homomorphisms `ι n : R n → R (n + 1)` and ideals
`J n` (`J_α`), assuming at each step the conclusions of Theorem 3 (`ν*(J_{n+1}) ≤ ν*(J_n)`), of
Lemma 15 (`H2`) and of Lemma 16 (`H3`, whose isomorphism `σ(α)` is one of graded `k`-algebras: it
is compatible with the structure maps `ι`), and that all `R_n` have `n = dim R_n = dim R` (here
`d`) generators of the maximal ideal.  Then `ν*(J_n)` is eventually constant.  The proof follows
the print: the initial segments `(ν_α^{(1)}, …, ν_α^{(i)})` stabilize, with limit `ν^{(i)}`
(`L i`); for every `μ` the number of `ν^{(i)} = μ` is bounded by the rank `C(n + μ − 1, n − 1)` of
`gr^μ_{M_α}(R_α)` (`ncard_nuI_eq_le_choose`); `(μ_1, μ_2, …)` (`μs`) are the distinct integers
which appear in `(ν^{(1)}, ν^{(2)}, …)`, and the proof is completed if this sequence is finite
(then some `ν^{(i)} = ∞`); in the infinite case `i(a)` (`iA a`) is the largest index with
`ν^{(i)} ≤ μ_a`, and `α(a)` (`αs a`, strictly increasing in `a`) is such that for all `α ≥ α(a)`
`ν_α^{(i)} = ν^{(i)}` for `i ≤ i(a) + 1` and `τ_α^{(b)} = τ_{α+1}^{(b)}` for `b ≤ a`
(Lemma 15 and the bound `d`).  For `α(a) ≤ α < α(a + 1)` Lemma 16 gives `σ(α)`; the isomorphisms
`λ(α) : gr_{M_α}(R_α) → k[X₁, …, X_n]` (`lam`) of graded `k`-algebras (`hlamk`) are chosen with
`λ(α + 1) ∘ σ(α) = λ(α)` (`hlam`); the images `H_μ = λ(α)(gr^μ(J_α, R_α))` (`H`) for `μ ≤ μ_a` do
not depend on `α ≥ α(a)` (`hHsame`, `hHconst`), `I(a)` (`Ia a`) is the ideal generated by the
`H_μ`, `μ ≤ μ_a`, `H_μ` is the homogeneous part of degree `μ` of `I(a)` ("Clearly", `hHI`),
`I(a) ⊆ I(a + 1)` and `I(a + 1) ≠ I(a)` (`hIa_le`, `hIa_lt`: the homogeneous part of degree
`μ_{a+1}` of `I(a + 1)` is not contained in `I(a)`), contradicting the noetherian property of
`k[X₁, …, X_n]`. -/
private theorem exists_nuStar_stationary_of_isResiduallyRational (R : ℕ → Type u) [∀ n, CommRing (R n)]
    [∀ n, IsRegularLocalRing (R n)] (J : ∀ n, Ideal (R n)) (ι : ∀ n, R n →+* R (n + 1))
    (H1 : ∀ n, nuStar (R (n + 1)) (J (n + 1)) ≤ nuStar (R n) (J n))
    (H2 : ∀ n a (i : ℕ+), 1 ≤ a → a ≤ t (R n) (J n) →
      IsGreatest {k : ℕ+ | nuI (R n) (J n) k = (mu (R n) (J n) a : ℕ∞)} i →
      (∀ j : ℕ+, (j : ℕ) ≤ i → nuI (R n) (J n) j = nuI (R (n + 1)) (J (n + 1)) j) →
      ∀ b, 1 ≤ b → b ≤ a → tau (R n) (J n) b ≤ tau (R (n + 1)) (J (n + 1)) b)
    (H3 : ∀ n a (i : ℕ+), 1 ≤ a → a ≤ t (R n) (J n) →
      IsGreatest {k : ℕ+ | nuI (R n) (J n) k = (mu (R n) (J n) a : ℕ∞)} i →
      (∀ j : ℕ+, (j : ℕ) ≤ i → nuI (R n) (J n) j = nuI (R (n + 1)) (J (n + 1)) j) →
      (mu (R n) (J n) a : ℕ∞) < nuI (R (n + 1)) (J (n + 1)) (i + 1) →
      (∀ b, 1 ≤ b → b ≤ a → tau (R (n + 1)) (J (n + 1)) b = tau (R n) (J n) b) →
      ∃ σ : AssocGraded (maximalIdeal (R n)) ≃+* AssocGraded (maximalIdeal (R (n + 1))),
        (∀ c : R n, σ (algebraMap (R n) (AssocGraded (maximalIdeal (R n))) c) =
          algebraMap (R (n + 1)) (AssocGraded (maximalIdeal (R (n + 1)))) (ι n c)) ∧
        (∀ μ, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal (R n)) μ,
          σ φ ∈ AssocGraded.homogeneous (maximalIdeal (R (n + 1))) μ) ∧
        (∀ μ, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal (R (n + 1))) μ,
          σ.symm ψ ∈ AssocGraded.homogeneous (maximalIdeal (R n)) μ) ∧
        ∀ μ ≤ mu (R n) (J n) a, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal (R n)) μ,
          (φ ∈ grIdeal (maximalIdeal (R n)) (J n) ↔
            σ φ ∈ grIdeal (maximalIdeal (R (n + 1))) (J (n + 1))))
    (d : ℕ) (hd : ∀ n, (maximalIdeal (R n)).spanFinrank = d) :
    ∃ N, ∀ n, N ≤ n → nuStar (R n) (J n) = nuStar (R N) (J N) := by
  -- "the sequence `(ν_α^{(1)}, …, ν_α^{(i)})` is stationary for all sufficiently large `α`":
  -- `ν^{(i)} = L i` is the limit of `ν_α^{(i)}`
  obtain ⟨N, hNmono, hN⟩ := exists_prefix_stable (fun n i => nuI (R n) (J n) i)
    fun n => H1 n
  let L : ℕ+ → ℕ∞ := fun j => nuI (R (N j)) (J (N j)) j
  have hL : ∀ i : ℕ, ∀ n, N i ≤ n → ∀ j : ℕ+, (j : ℕ) ≤ i → nuI (R n) (J n) j = L j :=
    fun i n hn j hj => (hN i n hn j hj).trans (hN j (N i) (hNmono hj) j le_rfl)
  have hLmono : Monotone L := fun j j' hjj' => by
    have hjj'' : (j : ℕ) ≤ j' := hjj'
    rw [← hL j' (N j') le_rfl j hjj'', ← hL j' (N j') le_rfl j' le_rfl]
    exact nuI_mono (J (N j')) hjj'
  have hfinIic : ∀ i : ℕ+, {k : ℕ+ | k ≤ i}.Finite := fun i =>
    ((Set.finite_Iic (i : ℕ)).preimage PNat.coe_injective.injOn).subset fun k hk =>
      (PNat.coe_le_coe k i).mpr hk
  -- a minimal base `s n` of `M_n`, with `#(s n) = d = n = dim R_n = dim R`: "the numbers
  -- `τ_α^{(b)}` are all bounded by `dim R = dim R_α`"
  have hex : ∀ n, ∃ s : Finset (R n), Ideal.span (s : Set (R n)) = maximalIdeal (R n) ∧
      s.card = d := fun n => by
    obtain ⟨s, hc, hspan⟩ :=
      (IsNoetherian.noetherian (maximalIdeal (R n))).exists_span_finset_card_eq_spanFinrank
    exact ⟨s, hspan, hc.trans (hd n)⟩
  choose s hs hsd using hex
  have hτbd : ∀ n b, tau (R n) (J n) b ≤ d := fun n b =>
    (tau_le_card (R n) (J n) (s n) (hs n) b).trans (le_of_eq (hsd n))
  -- "First of all, we note that for every positive integer `μ` the number of those `ν^{(i)} = μ`
  -- is bounded by the rank of `gr^μ_{M_α}(R_α)`, which is equal to `C(n + μ − 1, n − 1)`"
  have hcnt : ∀ μ : ℕ, {k : ℕ+ | L k = (μ : ℕ∞)}.Finite ∧
      {k : ℕ+ | L k = (μ : ℕ∞)}.ncard ≤ (d + μ - 1).choose μ := by
    intro μ
    have hF : ∀ F : Finset ℕ+, (∀ k ∈ F, L k = (μ : ℕ∞)) → F.card ≤ (d + μ - 1).choose μ := by
      intro F hF
      obtain ⟨i₁, hi₁⟩ := Finset.exists_le F
      have hsub : (F : Set ℕ+) ⊆ {k : ℕ+ | nuI (R (N (i₁ : ℕ))) (J (N (i₁ : ℕ))) k = (μ : ℕ∞)} :=
        fun k hk => by
          rw [Set.mem_ofPred_eq, hL (i₁ : ℕ) (N (i₁ : ℕ)) le_rfl k
            ((PNat.coe_le_coe k i₁).mpr (hi₁ k hk))]
          exact hF k hk
      obtain ⟨hfin, hle⟩ := ncard_nuI_eq_le_choose (R (N (i₁ : ℕ))) (J (N (i₁ : ℕ))) μ
      rw [hd] at hle
      calc F.card = (F : Set ℕ+).ncard := (Set.ncard_coe_finset F).symm
        _ ≤ _ := (Set.ncard_le_ncard hsub hfin).trans hle
    have hfin : {k : ℕ+ | L k = (μ : ℕ∞)}.Finite := by
      by_contra hinf
      obtain ⟨F, hFsub, hFcard⟩ :=
        Set.Infinite.exists_subset_card_eq hinf ((d + μ - 1).choose μ + 1)
      have := hF F fun k hk => hFsub hk
      omega
    refine ⟨hfin, ?_⟩
    rw [Set.ncard_eq_toFinset_card _ hfin]
    exact hF _ fun k hk => by simpa using hk
  -- "Let `(μ₁, μ₂, …)` be the sequence of the distinct integers which appear in the sequence
  -- `(ν^{(1)}, ν^{(2)}, …)`"
  let p : ℕ → Prop := fun z => ∃ k, L k = (z : ℕ∞)
  have hp : ∀ z, p z ↔ ∃ k, L k = (z : ℕ∞) := fun _ => Iff.rfl
  -- "The proof of Theorem 4 will be completed if the sequence `(μ₁, μ₂, …)` is finite": then some
  -- `ν^{(i₀)} = ∞` (each integer occurs only finitely often), `ν^{(i)} = ∞` for `i ≥ i₀`, and
  -- `ν*(J_α) = ν*` from `α = N(i₀)` on
  by_cases hMfin : {z : ℕ | p z}.Finite
  · have htop : ∃ i, L i = ⊤ := by
      by_contra hno
      push Not at hno
      have hcov : (Set.univ : Set ℕ+) ⊆ ⋃ z ∈ {z : ℕ | p z}, {k : ℕ+ | L k = (z : ℕ∞)} :=
        fun k _ => by
          obtain ⟨z, hz⟩ := ENat.ne_top_iff_exists.mp (hno k)
          exact Set.mem_biUnion ((hp z).mpr ⟨k, hz.symm⟩) hz.symm
      exact Set.infinite_univ ((hMfin.biUnion fun z _ => (hcnt z).1).subset hcov)
    obtain ⟨i₀, hi₀⟩ := htop
    refine ⟨N i₀, fun n hn => ?_⟩
    show toLex (fun j => nuI (R n) (J n) j) = toLex (fun j => nuI (R (N i₀)) (J (N i₀)) j)
    congr 1
    funext j
    by_cases hj : (j : ℕ) ≤ i₀
    · rw [hL i₀ n hn j hj, hL i₀ (N i₀) le_rfl j hj]
    · have hij : i₀ ≤ j := le_of_lt (by rw [← PNat.coe_lt_coe]; omega)
      have e1 : nuI (R n) (J n) j = ⊤ := top_unique (by
        rw [← hi₀, ← hL i₀ n hn i₀ le_rfl]; exact nuI_mono _ hij)
      have e2 : nuI (R (N i₀)) (J (N i₀)) j = ⊤ := top_unique (by
        rw [← hi₀, ← hL i₀ (N i₀) le_rfl i₀ le_rfl]; exact nuI_mono _ hij)
      rw [e1, e2]
  -- "Suppose the contrary": the sequence `(μ₁, μ₂, …)` is infinite
  exfalso
  have hMinf : {z : ℕ | p z}.Infinite := hMfin
  have hLfin : ∀ i, L i ≠ ⊤ := by
    intro i₀ hi₀
    refine hMinf (((hfinIic i₀).image fun k => (L k).toNat).subset fun z hz => ?_)
    obtain ⟨k, hk⟩ := (hp z).mp hz
    have hki : k ≤ i₀ := by
      by_contra h
      have := hLmono (le_of_lt (not_le.mp h))
      rw [hi₀, hk] at this
      exact absurd this (by simp)
    exact ⟨k, hki, by show (L k).toNat = z; rw [hk, ENat.toNat_natCast]⟩
  -- the integers `μ_a`, `a ∈ ℤ⁺`
  let μs : ℕ+ → ℕ := fun a => Nat.nth p ((a : ℕ) - 1)
  have hμsp : ∀ a, ∃ k, L k = (μs a : ℕ∞) := fun a =>
    (hp _).mp (Nat.nth_mem_of_infinite hMinf _)
  have hμs_lt : ∀ {a a' : ℕ+}, a < a' → μs a < μs a' := fun {a a'} h =>
    Nat.nth_strictMono hMinf (by
      have := (PNat.coe_lt_coe a a').mpr h
      have := a.pos
      omega)
  have hμs_mono : ∀ {a a' : ℕ+}, a ≤ a' → μs a ≤ μs a' := fun {a a'} h => by
    rcases h.lt_or_eq with h | rfl
    · exact (hμs_lt h).le
    · exact le_rfl
  -- "if `μ_a` exists, then we must have a positive integer `i(a)` such that `ν^{(i)} ≤ μ_a` for
  -- `i ≤ i(a)` and `ν^{(i)} > μ_a` for `i > i(a)`"
  have hia : ∀ a : ℕ+, ∃ i : ℕ+, (∀ j : ℕ+, j ≤ i → L j ≤ (μs a : ℕ∞)) ∧
      ∀ j : ℕ+, i < j → (μs a : ℕ∞) < L j := by
    intro a
    have hSfin : {k : ℕ+ | L k ≤ (μs a : ℕ∞)}.Finite := by
      refine (Set.Finite.biUnion (Finset.finite_toSet (Finset.range (μs a + 1)))
        fun e _ => (hcnt e).1).subset fun k hk => ?_
      obtain ⟨e, he⟩ := ENat.ne_top_iff_exists.mp (ne_top_of_le_ne_top (ENat.natCast_ne_top _) hk)
      have hle : e ≤ μs a := by
        have : (e : ℕ∞) ≤ (μs a : ℕ∞) := by rw [he]; exact hk
        exact_mod_cast this
      exact Set.mem_biUnion (x := e)
        (Finset.mem_coe.mpr (Finset.mem_range.mpr (Nat.lt_succ_of_le hle))) he.symm
    obtain ⟨k₀, hk₀⟩ := hμsp a
    obtain ⟨i, hiS, himax⟩ := Set.exists_max_image _ id hSfin ⟨k₀, le_of_eq hk₀⟩
    refine ⟨i, fun j hj => (hLmono hj).trans hiS, fun j hj => ?_⟩
    by_contra hnot
    exact absurd (himax j (not_lt.mp hnot)) (not_le.mpr hj)
  choose iA hiA using hia
  -- the shape of `μ_a` among the `μ^{(a)}(J_α)`: for a stage `n` in which the initial segment of
  -- `ν_α` up to `i(a) + 1` agrees with that of `ν`, `μ^{(a)}(J_n) = μ_a` and `i(a)` is the largest
  -- index with `ν_n^{(i)} = μ_a`
  have hmuc : ∀ (a : ℕ+) n, (∀ k : ℕ+, k ≤ iA a + 1 → nuI (R n) (J n) k = L k) →
      mu (R n) (J n) a = μs a ∧ (a : ℕ) ≤ t (R n) (J n) ∧
        IsGreatest {k : ℕ+ | nuI (R n) (J n) k = (mu (R n) (J n) a : ℕ∞)} (iA a) :=
    fun a n hn => mu_eq_of_nth (R n) (J n) L hLmono hMinf a (iA a) (hiA a).1 (hiA a).2 hn
  have hpre : ∀ (a : ℕ+) n, N ((iA a : ℕ) + 1) ≤ n → ∀ k : ℕ+, k ≤ iA a + 1 →
      nuI (R n) (J n) k = L k := fun a n hn k hk =>
    hL ((iA a : ℕ) + 1) n hn k (by
      have h := (PNat.coe_le_coe _ _).mpr hk
      rwa [PNat.add_coe, PNat.one_coe] at h)
  have hheq : ∀ (a : ℕ+) n, N ((iA a : ℕ) + 1) ≤ n → ∀ j : ℕ+, (j : ℕ) ≤ iA a →
      nuI (R n) (J n) j = nuI (R (n + 1)) (J (n + 1)) j := fun a n hn j hj =>
    (hL ((iA a : ℕ) + 1) n hn j (by omega)).trans
      (hL ((iA a : ℕ) + 1) (n + 1) (by omega) j (by omega)).symm
  -- "By replacing `α(a)` by a suitably bigger integer, if necessary, we may assume that
  -- `τ_α^{(b)} = τ_{α+1}^{(b)}` for all `b ≤ a`, and for all `α ≥ α(a)`.  (See Lemma 15; note that
  -- the numbers `τ_α^{(b)}` are all bounded by `dim R = dim R_α`.)"
  have hτstab : ∀ a : ℕ+, ∃ A, ∀ n, A ≤ n → ∀ b, 1 ≤ b → b ≤ (a : ℕ) →
      tau (R (n + 1)) (J (n + 1)) b = tau (R n) (J n) b := by
    intro a
    obtain ⟨M, hM1, hM2⟩ := exists_stable_of_monotone_family
      (fun n b => tau (R n) (J n) (b + 1)) ((a : ℕ) - 1) d (N ((iA a : ℕ) + 1))
      (fun n hn b hb => by
        have ha0 := a.pos
        obtain ⟨-, hat, hgreat⟩ := hmuc a n (hpre a n hn)
        exact H2 n a (iA a) a.pos hat hgreat (hheq a n hn) (b + 1) (by omega) (by omega))
      (fun n b => hτbd n (b + 1))
    refine ⟨M, fun n hn b hb1 hba => ?_⟩
    have h1 := hM2 (n + 1) (by omega) (b - 1) (by omega)
    have h2 := hM2 n hn (b - 1) (by omega)
    simp only [Nat.sub_add_cancel hb1] at h1 h2
    exact h1.trans h2.symm
  -- "there exists a positive integer `α(a)` such that `ν^{(i)} = ν_α^{(i)} ≤ μ_a` for all
  -- `i ≤ i(a)`, and for all `α ≥ α(a)`, and `ν_α^{(i)} > μ_a` for `i = i(a) + 1`, and for all
  -- `α ≥ α(a)`", with the `τ`-stability above, "arranged in such a way that `α(a) < α(a + 1)`"
  obtain ⟨αs, hαmono, hαs⟩ := exists_strictMono_bound
    (fun (a : ℕ+) (n : ℕ) => (∀ k : ℕ+, k ≤ iA a + 1 → nuI (R n) (J n) k = L k) ∧
      ∀ b, 1 ≤ b → b ≤ (a : ℕ) → tau (R (n + 1)) (J (n + 1)) b = tau (R n) (J n) b)
    fun a => by
      obtain ⟨A, hA⟩ := hτstab a
      exact ⟨max A (N ((iA a : ℕ) + 1)), fun n hn =>
        ⟨hpre a n (le_of_max_le_right hn), hA n (le_of_max_le_left hn)⟩⟩
  have hαs' : ∀ (a : ℕ+) n, αs a ≤ n →
      (∀ k : ℕ+, k ≤ iA a + 1 → nuI (R n) (J n) k = L k) ∧
      ∀ b, 1 ≤ b → b ≤ (a : ℕ) → tau (R (n + 1)) (J (n + 1)) b = tau (R n) (J n) b := hαs
  have hαge : ∀ a : ℕ+, (a : ℕ) ≤ αs a + 1 := by
    intro a
    induction a using PNat.recOn with
    | one => simp
    | succ a ih =>
      have := hαmono (PNat.lt_add_right a 1)
      rw [PNat.add_coe, PNat.one_coe]
      omega
  set n₀ := αs 1 with hn₀
  have hn₀le : ∀ a : ℕ+, n₀ ≤ αs a := fun a => hαmono.monotone one_le
  -- the stage `α = n₀ + m ≥ α(1)` lies in `α(a) ≤ α < α(a + 1)` for a unique `a = an m`
  have hexa : ∀ m : ℕ, ∃ a : ℕ+, αs a ≤ n₀ + m ∧ n₀ + m < αs (a + 1) := by
    intro m
    have hTfin : {a : ℕ+ | αs a ≤ n₀ + m}.Finite :=
      (hfinIic (n₀ + m).succPNat).subset fun a ha => by
        have h1 : αs a ≤ n₀ + m := ha
        have h2 := hαge a
        exact (PNat.coe_le_coe _ _).mp (by rw [Nat.succPNat_coe]; omega)
    obtain ⟨a, haT, hmax⟩ := Set.exists_max_image {a : ℕ+ | αs a ≤ n₀ + m} id hTfin
      ⟨1, Nat.le_add_right _ _⟩
    refine ⟨a, haT, ?_⟩
    by_contra hnot
    exact absurd (hmax (a + 1) (not_lt.mp hnot)) (not_le.mpr (PNat.lt_add_right a 1))
  choose an han using hexa
  have han_ge : ∀ (a : ℕ+) m, αs a ≤ n₀ + m → a ≤ an m := by
    intro a m ha
    by_contra h
    have h1 : an m + 1 ≤ a := PNat.add_one_le_iff.mpr (not_le.mp h)
    have h2 := hαmono.monotone h1
    have h3 := (han m).2
    omega
  -- "Lemma 16 implies that for each `α` such that `α(a) ≤ α < α(a + 1)`, there exists an
  -- isomorphism of graded `k`-algebras `σ(α) : gr_{M_α}(R_α) → gr_{M_{α+1}}(R_{α+1})` such that
  -- `σ(α)(gr^μ_{M_α}(J_α, R_α)) = gr^μ_{M_{α+1}}(J_{α+1}, R_{α+1})` for all `μ ≤ μ_a`"
  have hσex : ∀ m : ℕ, ∃ σ : AssocGraded (maximalIdeal (R (n₀ + m))) ≃+*
      AssocGraded (maximalIdeal (R (n₀ + m + 1))),
      (∀ c : R (n₀ + m), σ (algebraMap (R (n₀ + m))
          (AssocGraded (maximalIdeal (R (n₀ + m)))) c) =
        algebraMap (R (n₀ + m + 1)) (AssocGraded (maximalIdeal (R (n₀ + m + 1))))
          (ι (n₀ + m) c)) ∧
      (∀ μ, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) μ,
        σ φ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m + 1))) μ) ∧
      (∀ μ, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m + 1))) μ,
        σ.symm ψ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) μ) ∧
      ∀ μ ≤ μs (an m), ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) μ,
        (φ ∈ grIdeal (maximalIdeal (R (n₀ + m))) (J (n₀ + m)) ↔
          σ φ ∈ grIdeal (maximalIdeal (R (n₀ + m + 1))) (J (n₀ + m + 1))) := by
    intro m
    obtain ⟨hpr, hτ⟩ := hαs' (an m) (n₀ + m) (han m).1
    obtain ⟨hpr', -⟩ := hαs' (an m) (n₀ + m + 1) (by have := (han m).1; omega)
    obtain ⟨hmu, hat, hgreat⟩ := hmuc (an m) (n₀ + m) hpr
    rw [← hmu]
    refine H3 (n₀ + m) (an m) (iA (an m)) (an m).pos hat hgreat
      (fun j hj => (hpr j (by
          rw [← PNat.coe_le_coe, PNat.add_coe, PNat.one_coe]; omega)).trans
        (hpr' j (by rw [← PNat.coe_le_coe, PNat.add_coe, PNat.one_coe]; omega)).symm) ?_ hτ
    rw [hmu, hpr' (iA (an m) + 1) le_rfl]
    exact (hiA (an m)).2 _ (PNat.lt_add_right _ 1)
  choose σ hσ using hσex
  -- "We can choose and fix, for each `α ≥ α(1)`, an isomorphism of graded `k`-algebras
  -- `λ(α) : gr_{M_α}(R_α) → k[X₁, …, X_n]`, where `k[X₁, …, X_n]` is a polynomial ring of
  -- `n = dim R` variables, such that `λ(α + 1) ∘ σ(α) = λ(α)` for all `α`": `λ(n₀)` is a graded
  -- isomorphism of `k`-algebras onto `k[X₁, …, X_n]` (`gr_M(R)` is a polynomial ring in `n`
  -- variables over `k = R_{n₀}/M_{n₀}`), and `λ(n₀ + m + 1) = λ(n₀ + m) ∘ σ(n₀ + m)⁻¹`
  let _ : Field (R n₀ ⧸ maximalIdeal (R n₀)) := Ideal.Quotient.field _
  obtain ⟨r, e₀, hr, he₀, -⟩ := exists_gradedAlgEquiv (R n₀)
  obtain rfl : r = d := hr.trans (hd n₀)
  let lam : ∀ m : ℕ, AssocGraded (maximalIdeal (R (n₀ + m))) ≃+*
      MvPolynomial (Fin r) (R n₀ ⧸ maximalIdeal (R n₀)) := fun m =>
    Nat.rec (motive := fun m => AssocGraded (maximalIdeal (R (n₀ + m))) ≃+*
      MvPolynomial (Fin r) (R n₀ ⧸ maximalIdeal (R n₀)))
      e₀.symm.toRingEquiv (fun m lm => (σ m).symm.trans lm) m
  have hlam : ∀ m x, lam (m + 1) (σ m x) = lam m x := fun m x => by
    show ((σ m).symm.trans (lam m)) (σ m x) = lam m x
    simp
  -- `λ(α)` is a homomorphism of `k`-algebras: `k = R_{n₀}/M_{n₀}` acts on `gr_{M_α}(R_α)` through
  -- the canonical homomorphisms `ι : R_{n₀} → R_α`
  let ιc : ∀ m : ℕ, R n₀ →+* R (n₀ + m) := fun m =>
    Nat.rec (motive := fun m => R n₀ →+* R (n₀ + m)) (RingHom.id _)
      (fun m f => (ι (n₀ + m)).comp f) m
  have hlamk : ∀ m (c : R n₀), lam m (algebraMap (R (n₀ + m))
      (AssocGraded (maximalIdeal (R (n₀ + m)))) (ιc m c)) =
      MvPolynomial.C (Ideal.Quotient.mk (maximalIdeal (R n₀)) c) := by
    intro m
    induction m with
    | zero =>
      intro c
      show e₀.symm (algebraMap (R n₀) (AssocGraded (maximalIdeal (R n₀))) c) = _
      rw [IsScalarTower.algebraMap_apply (R n₀) (R n₀ ⧸ maximalIdeal (R n₀)), AlgEquiv.commutes,
        MvPolynomial.algebraMap_eq]
      try rfl
    | succ m ih =>
      intro c
      show lam m ((σ m).symm (algebraMap (R (n₀ + m + 1))
        (AssocGraded (maximalIdeal (R (n₀ + m + 1)))) (ι (n₀ + m) (ιc m c)))) = _
      rw [← (hσ m).1 (ιc m c), RingEquiv.symm_apply_apply]
      exact ih c
  -- `λ(α)` is graded
  have hlamhom : ∀ m μ x, x ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) μ ↔
      lam m x ∈ MvPolynomial.homogeneousSubmodule (Fin r) (R n₀ ⧸ maximalIdeal (R n₀)) μ := by
    intro m
    induction m with
    | zero =>
      intro μ x
      show x ∈ _ ↔ e₀.symm x ∈ _
      rw [he₀ μ (e₀.symm x), AlgEquiv.apply_symm_apply]
      exact Iff.rfl
    | succ m ih =>
      intro μ x
      show x ∈ _ ↔ lam m ((σ m).symm x) ∈ _
      rw [← ih μ]
      exact ⟨fun h => (hσ m).2.2.1 μ x h, fun h => by
        have h' := (hσ m).2.1 μ _ h
        rw [RingEquiv.apply_symm_apply] at h'
        exact h'⟩
  -- `H_μ = λ(α)(gr^μ_{M_α}(J_α, R_α))`, the image in the polynomial ring of the homogeneous part
  -- of degree `μ` of `gr_{M_α}(J_α, R_α)`, at the stage `α = n₀ + m`
  obtain ⟨H, hH⟩ : ∃ H : ℕ → ℕ → Set (MvPolynomial (Fin r) (R n₀ ⧸ maximalIdeal (R n₀))),
      ∀ m μ x, x ∈ H m μ ↔ ∃ χ, (χ ∈ grIdeal (maximalIdeal (R (n₀ + m))) (J (n₀ + m)) ∧
        χ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) μ) ∧ lam m χ = x :=
    ⟨fun m μ => lam m '' {χ | χ ∈ grIdeal (maximalIdeal (R (n₀ + m))) (J (n₀ + m)) ∧
      χ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) μ}, fun _ _ _ => Iff.rfl⟩
  -- "Then the images `λ(α)(gr^μ_{M_α}(J_α, R_α))` in the polynomial ring are the same for all
  -- `α ≥ α(a)` if `μ ≤ μ_a`"
  have hHsame : ∀ (a : ℕ+) m, αs a ≤ n₀ + m → ∀ μ ≤ μs a, H (m + 1) μ = H m μ := by
    intro a m ha μ hμ
    have hμ' : μ ≤ μs (an m) := hμ.trans (hμs_mono (han_ge a m ha))
    obtain ⟨-, h1, h2, h3⟩ := hσ m
    ext x
    rw [hH, hH]
    constructor
    · rintro ⟨ψ, ⟨hψJ, hψ⟩, rfl⟩
      refine ⟨(σ m).symm ψ, ⟨?_, h2 μ ψ hψ⟩, ?_⟩
      · exact (h3 μ hμ' _ (h2 μ ψ hψ)).mpr (by rwa [RingEquiv.apply_symm_apply])
      · rw [← hlam m ((σ m).symm ψ), RingEquiv.apply_symm_apply]
    · rintro ⟨χ, ⟨hχJ, hχ⟩, rfl⟩
      exact ⟨σ m χ, ⟨(h3 μ hμ' χ hχ).mp hχJ, h1 μ χ hχ⟩, hlam m χ⟩
  have hHconst : ∀ (a : ℕ+) m, αs a ≤ n₀ + m → ∀ μ ≤ μs a, H m μ = H (αs a - n₀) μ := by
    intro a m ha μ hμ
    have h0 := hn₀le a
    obtain ⟨k, rfl⟩ : ∃ k, m = (αs a - n₀) + k := ⟨m - (αs a - n₀), by omega⟩
    induction k with
    | zero => rfl
    | succ k ih =>
      rw [← ih (by omega)]
      exact hHsame a (αs a - n₀ + k) (by omega) μ hμ
  -- "Call this image `H_μ`, and let `I(a)` be the ideal in the polynomial ring generated by `H_μ`
  -- for all `μ ≤ μ_a`"
  obtain ⟨Ia, hIadef⟩ : ∃ Ia : ℕ+ → Ideal (MvPolynomial (Fin r) (R n₀ ⧸ maximalIdeal (R n₀))),
      ∀ a, Ia a = Ideal.span {x | ∃ μ ≤ μs a, x ∈ H (αs a - n₀) μ} := ⟨_, fun _ => rfl⟩
  have hIagen : ∀ (a : ℕ+) μ, μ ≤ μs a → ∀ x ∈ H (αs a - n₀) μ, x ∈ Ia a := fun a μ hμ x hx => by
    rw [hIadef]
    exact Ideal.subset_span ⟨μ, hμ, hx⟩
  have hIale : ∀ (a : ℕ+) (T : Ideal (MvPolynomial (Fin r) (R n₀ ⧸ maximalIdeal (R n₀)))),
      (∀ μ ≤ μs a, ∀ x ∈ H (αs a - n₀) μ, x ∈ T) → Ia a ≤ T := fun a T h => by
    rw [hIadef]
    exact Ideal.span_le.mpr fun x ⟨μ, hμ, hx⟩ => h μ hμ x hx
  -- "Clearly, `H_μ` is the homogeneous part of degree `μ` of `I(a)`": `I(a)` lies in the ideal
  -- `λ(α)(gr_{M_α}(J_α, R_α))`, whose homogeneous part of degree `μ` is `H_μ`
  have hHI : ∀ (a : ℕ+) m, αs a ≤ n₀ + m → ∀ μ ≤ μs a,
      H m μ = {x | x ∈ Ia a ∧
        x ∈ MvPolynomial.homogeneousSubmodule (Fin r) (R n₀ ⧸ maximalIdeal (R n₀)) μ} := by
    intro a m ha μ hμ
    have hIa : Ia a ≤ (grIdeal (maximalIdeal (R (n₀ + m))) (J (n₀ + m))).map (lam m) :=
      hIale a _ fun μ' hμ' x hx => by
        rw [← hHconst a m ha μ' hμ', hH] at hx
        obtain ⟨χ, ⟨hχJ, -⟩, rfl⟩ := hx
        exact Ideal.mem_map_of_mem _ hχJ
    ext x
    rw [Set.mem_ofPred_eq, hH]
    constructor
    · rintro ⟨χ, ⟨hχJ, hχ⟩, rfl⟩
      refine ⟨hIagen a μ hμ _ ?_, (hlamhom m μ χ).mp hχ⟩
      rw [← hHconst a m ha μ hμ, hH]
      exact ⟨χ, ⟨hχJ, hχ⟩, rfl⟩
    · rintro ⟨hxI, hxh⟩
      obtain ⟨z, hz, rfl⟩ := (Ideal.mem_map_of_equiv (lam m) x).mp (hIa hxI)
      exact ⟨z, ⟨hz, (hlamhom m μ z).mpr hxh⟩, rfl⟩
  -- "By the definition of `μ_{a+1}`, it follows that `I(a + 1)` contains `I(a)`"
  have hIa_le : ∀ a : ℕ+, Ia a ≤ Ia (a + 1) := by
    intro a
    have h1 := hαmono (PNat.lt_add_right a 1)
    have h2 := hn₀le (a + 1)
    refine hIale a _ fun μ hμ x hx => hIagen (a + 1) μ
      (hμ.trans (hμs_mono (le_of_lt (PNat.lt_add_right a 1)))) x ?_
    rw [hHconst a (αs (a + 1) - n₀) (by omega) μ hμ]
    exact hx
  -- the second characteristic of `μ_{a+1}`: `ν^{(i(a)+1)} = μ_{a+1}`
  have hnext : ∀ a : ℕ+, L (iA a + 1) = (μs (a + 1) : ℕ∞) := by
    intro a
    obtain ⟨z, hz⟩ := ENat.ne_top_iff_exists.mp (hLfin (iA a + 1))
    have hpz : p z := (hp z).mpr ⟨iA a + 1, hz.symm⟩
    have hgt : μs a < z := by
      have := (hiA a).2 _ (PNat.lt_add_right (iA a) 1)
      rw [← hz] at this
      exact_mod_cast this
    have h1 : μs (a + 1) ≤ z := by
      have hz' : Nat.nth p (Nat.count p z) = z := Nat.nth_count hpz
      have h3 : (a : ℕ) - 1 < Nat.count p z := by
        rw [← (Nat.nth_strictMono hMinf).lt_iff_lt, hz']
        exact hgt
      show Nat.nth p (((a + 1 : ℕ+) : ℕ) - 1) ≤ z
      rw [PNat.add_coe, PNat.one_coe, Nat.add_sub_cancel]
      calc Nat.nth p a ≤ Nat.nth p (Nat.count p z) :=
            (Nat.nth_strictMono hMinf).monotone (by omega)
        _ = z := hz'
    have h2 : z ≤ μs (a + 1) := by
      obtain ⟨k, hk⟩ := hμsp (a + 1)
      have hki : iA a < k := by
        by_contra hnk
        have h4 := (hiA a).1 k (not_lt.mp hnk)
        rw [hk] at h4
        have h5 := hμs_lt (PNat.lt_add_right a 1)
        exact absurd h4 (not_le.mpr (by exact_mod_cast h5))
      have h6 := hLmono (PNat.add_one_le_iff.mpr hki)
      rw [← hz, hk] at h6
      exact_mod_cast h6
    rw [← hz]
    exact_mod_cast le_antisymm h2 h1
  -- "`I(a + 1) ≠ I(a)`.  In fact, the homogeneous part of degree `μ_{a+1}` of `I(a + 1)` is not
  -- contained in `I(a)`"
  have hIa_lt : ∀ a : ℕ+, Ia a < Ia (a + 1) := by
    intro a
    refine lt_of_le_of_ne (hIa_le a) fun heq => ?_
    have h1 := hαmono (PNat.lt_add_right a 1)
    have h2 := hn₀le (a + 1)
    obtain ⟨m, hm⟩ : ∃ m, m = αs (a + 1) - n₀ := ⟨_, rfl⟩
    have ham1 : αs (a + 1) ≤ n₀ + m := by omega
    have ham : αs a ≤ n₀ + m := by omega
    have hsub : {x | x ∈ Ia (a + 1) ∧
        x ∈ MvPolynomial.homogeneousSubmodule (Fin r) (R n₀ ⧸ maximalIdeal (R n₀))
          (μs (a + 1))} ⊆ (Ia a : Set _) := fun x hx => by
      rw [heq]; exact hx.1
    rw [← hHI (a + 1) m ham1 (μs (a + 1)) le_rfl] at hsub
    -- `I(a)` is the image under `λ(α)` of the ideal generated by the homogeneous elements of
    -- `gr_{M_α}(J_α, R_α)` of degrees `≤ μ_a`
    have hIK : Ia a = (Ideal.span {χ | χ ∈ grIdeal (maximalIdeal (R (n₀ + m))) (J (n₀ + m)) ∧
        ∃ e ≤ μs a, χ ∈ AssocGraded.homogeneous (maximalIdeal (R (n₀ + m))) e}).map (lam m) := by
      rw [hIadef, Ideal.map_span]
      congr 1
      ext x
      constructor
      · rintro ⟨μ, hμ, hx⟩
        rw [← hHconst a m ham μ hμ, hH] at hx
        obtain ⟨χ, ⟨hχJ, hχ⟩, rfl⟩ := hx
        exact ⟨χ, ⟨hχJ, μ, hμ, hχ⟩, rfl⟩
      · rintro ⟨χ, ⟨hχJ, e, he, hχ⟩, rfl⟩
        refine ⟨e, he, ?_⟩
        rw [← hHconst a m ham e he, hH]
        exact ⟨χ, ⟨hχJ, hχ⟩, rfl⟩
    have hν : nuI (R (n₀ + m)) (J (n₀ + m)) (iA a + 1) = ((μs (a + 1) : ℕ) : ℕ∞) := by
      rw [(hαs' a (n₀ + m) ham).1 _ le_rfl, hnext]
    refine false_of_mem_span_low (R (n₀ + m)) (J (n₀ + m)) (iA a + 1) hν
      (μ₀ := μs a) (hμs_lt (PNat.lt_add_right a 1)) fun ψ hψ hψJ => ?_
    have h3 : lam m ψ ∈ Ia a := hsub ((hH _ _ _).mpr ⟨ψ, ⟨hψJ, hψ⟩, rfl⟩)
    rw [hIK, Ideal.mem_map_of_equiv] at h3
    obtain ⟨z, hz, hzψ⟩ := h3
    rwa [(lam m).injective hzψ] at hz
  -- "Thus we get an infinite sequence of strictly growing ideals `I(a)`, `a ∈ ℤ⁺`.  This
  -- contradicts the noetherian property of a polynomial ring"
  have : IsNoetherianRing (MvPolynomial (Fin r) (R n₀ ⧸ maximalIdeal (R n₀))) := inferInstance
  obtain ⟨_, ⟨a, rfl⟩, hmax⟩ := set_has_maximal_iff_noetherian.mpr this (Set.range Ia)
    ⟨_, ⟨1, rfl⟩⟩
  exact hmax _ ⟨a + 1, rfl⟩ (hIa_lt a)

end CoreAux

section IsoAux

/-- Separable closedness is invariant under field isomorphisms. -/
private theorem isSepClosed_of_ringEquiv {k k' : Type*} [Field k] [Field k']
    [IsSepClosed k] (e : k ≃+* k') : IsSepClosed k' := by
  refine IsSepClosed.of_exists_root k' fun p _ hirr hsep => ?_
  let q := p.map (e.symm : k' →+* k)
  have hq : q.degree ≠ 0 := by
    rw [Polynomial.degree_map]
    exact (Polynomial.degree_pos_of_irreducible hirr).ne'
  obtain ⟨x, hx⟩ := IsSepClosed.exists_root q hq hsep.map
  refine ⟨e x, ?_⟩
  have hp : p = q.map (e : k →+* k') := by
    simp only [q, Polynomial.map_map]
    rw [show (e : k →+* k').comp (e.symm : k' →+* k) = RingHom.id k' from
      RingHom.ext fun y => e.apply_symm_apply y, Polynomial.map_id]
  rw [hp, Polynomial.eval_map]
  show Polynomial.eval₂ (e : k →+* k') ((e : k →+* k') x) q = 0
  rw [Polynomial.eval₂_at_apply, hx.eq_zero, map_zero]

variable {A₀ A B C : Type u} [CommRing A₀] [CommRing A] [CommRing B] [CommRing C]
  [IsLocalRing A₀] [IsLocalRing A] [IsLocalRing B] [IsLocalRing C]

/-- The image of a regular system of parameters by a ring isomorphism is one. -/
private theorem isRSOP_image_ringEquiv [DecidableEq B] (e : A ≃+* B) (s : Finset A)
    (hs : IsRegularSystemOfParameters A s) : IsRegularSystemOfParameters B (s.image e) := by
  refine ⟨?_, ?_⟩
  · rw [Finset.coe_image, ← Ideal.map_span, hs.1]
    exact map_ringEquiv_maximalIdeal e
  · rw [Finset.card_image_of_injective _ e.injective, hs.2]
    exact ringKrullDim_eq_of_ringEquiv e

/-- `α` transforms a regular system of parameters into one, then so does `f ∘ α ∘ g` for ring
isomorphisms `f`, `g`. -/
private theorem mapsRSOP_ringEquiv_comp (α : A →+* B) (hα : RingHom.MapsRSOP α)
    (f : B ≃+* C) (g : A₀ ≃+* A) :
    RingHom.MapsRSOP ((f : B →+* C).comp (α.comp (g : A₀ →+* A))) := by
  classical
  obtain ⟨s, hs, hs', hinj⟩ := hα
  refine ⟨s.image g.symm, isRSOP_image_ringEquiv g.symm s hs, ?_, ?_⟩
  · rw [Finset.image_image]
    have : ((f : B →+* C).comp (α.comp (g : A₀ →+* A))) ∘ g.symm = f ∘ α := by
      funext x
      simp
    rw [this, ← Finset.image_image]
    exact isRSOP_image_ringEquiv f _ hs'
  · intro x hx y hy hxy
    rw [Finset.coe_image] at hx hy
    obtain ⟨x, hx, rfl⟩ := hx
    obtain ⟨y, hy, rfl⟩ := hy
    simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe,
      RingEquiv.apply_symm_apply] at hxy
    rw [hinj hx hy (f.injective hxy)]

/-- `f ∘ α ∘ g` is residually separable algebraic if `α` is, for ring isomorphisms `f`, `g`. -/
private theorem isResiduallySeparableAlgebraic_ringEquiv_comp (α : A →+* B)
    [IsLocalHom α] (hα : RingHom.IsResiduallySeparableAlgebraic α) (f : B ≃+* C)
    (g : A₀ ≃+* A) [IsLocalHom ((f : B →+* C).comp (α.comp (g : A₀ →+* A)))] :
    RingHom.IsResiduallySeparableAlgebraic ((f : B →+* C).comp (α.comp (g : A₀ →+* A))) := by
  let _ : Algebra (ResidueField A) (ResidueField B) := (ResidueField.map α).toAlgebra
  have : Algebra.IsSeparable (ResidueField A) (ResidueField B) := hα
  let _ : Algebra (ResidueField A₀) (ResidueField C) :=
    (ResidueField.map ((f : B →+* C).comp (α.comp (g : A₀ →+* A)))).toAlgebra
  show Algebra.IsSeparable (ResidueField A₀) (ResidueField C)
  refine Algebra.IsSeparable.of_equiv_equiv (ResidueField.mapEquiv g).symm
    (ResidueField.mapEquiv f) (RingHom.ext fun x => ?_)
  obtain ⟨a, rfl⟩ := residue_surjective x
  simp only [RingHom.coe_comp, Function.comp_apply, RingHom.algebraMap_toAlgebra,
    ResidueField.mapEquiv.symm, RingHom.coe_coe, ResidueField.mapEquiv_apply,
    ResidueField.map_residue]
  simp

/-- A ring isomorphism is residually separable algebraic. -/
private theorem isResiduallySeparableAlgebraic_ringEquiv (e : A ≃+* B)
    [IsLocalHom (e : A →+* B)] : RingHom.IsResiduallySeparableAlgebraic (e : A →+* B) := by
  let _ : Algebra (ResidueField A) (ResidueField B) := (ResidueField.map (e : A →+* B)).toAlgebra
  show Algebra.IsSeparable (ResidueField A) (ResidueField B)
  refine Algebra.IsSeparable.of_equiv_equiv (A₁ := ResidueField A) (B₁ := ResidueField A)
    (RingEquiv.refl _) (ResidueField.mapEquiv e) (RingHom.ext fun x => ?_)
  obtain ⟨a, rfl⟩ := residue_surjective x
  simp [RingHom.algebraMap_toAlgebra]

/-- Residually rational implies residually algebraic. -/
private theorem isResiduallyAlgebraic_of_isResiduallyRational (φ : A →+* B)
    [IsLocalHom φ] (h : RingHom.IsResiduallyRational φ) : RingHom.IsResiduallyAlgebraic φ := by
  let _ : Algebra (ResidueField A) (ResidueField B) := (ResidueField.map φ).toAlgebra
  show Algebra.IsAlgebraic (ResidueField A) (ResidueField B)
  refine ⟨fun y => ?_⟩
  obtain ⟨x, rfl⟩ := h y
  exact isAlgebraic_algebraMap x

/-- A ring isomorphism transforms a regular system of parameters into one. -/
private theorem mapsRSOP_ringEquiv {A B : Type u} [CommRing A] [CommRing B]
    [IsRegularLocalRing A] [IsLocalRing B] (e : A ≃+* B) :
    RingHom.MapsRSOP (e : A →+* B) := by
  classical
  obtain ⟨-, s, hs⟩ := (isRegularLocalRing_iff_exists_rsop (R := A)).mp inferInstance
  exact ⟨s, hs, isRSOP_image_ringEquiv e s hs, e.injective.injOn⟩

end IsoAux

section TopAux

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R]

/-- A monoidal transform with center `R` (p. 209: "the case in which `P = R`") is `R` itself:
the canonical homomorphism `R → R'` is bijective. -/
private theorem MonoidalTransform.toRing_bijective_of_eq_top {P : Ideal R} (hP : P = ⊤)
    (T : MonoidalTransform R P) : Function.Bijective T.toRing := by
  subst hP
  set B := blowupAlgebra R ⊤ T.x
  have hx0 : algebraMap R (FractionRing R) T.x ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr T.x_ne_zero
  -- `x` is a unit: otherwise `1 = x · x⁻¹ ∈ M B ⊆ M'`
  have hxu : IsUnit T.x := by
    by_contra hxu
    have hxM : T.x ∈ maximalIdeal R := hxu
    let b : B := ⟨algebraMap R (FractionRing R) 1 / algebraMap R (FractionRing R) T.x,
      Algebra.subset_adjoin ⟨1, Submodule.mem_top, rfl⟩⟩
    have h1 : algebraMap R B T.x * b = 1 := by
      apply Subtype.ext
      show algebraMap R (FractionRing R) T.x *
        (algebraMap R (FractionRing R) 1 / algebraMap R (FractionRing R) T.x) = 1
      rw [map_one, mul_one_div_cancel hx0]
    have h2 : algebraMap R B T.x ∈ T.M' := T.le (Ideal.mem_map_of_mem _ hxM)
    have h3 : (1 : B) ∈ T.M' := h1 ▸ T.M'.mul_mem_right b h2
    exact (inferInstance : T.M'.IsPrime).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  set u := hxu.unit with hudef
  have hu : (u : R) = T.x := hxu.unit_spec
  -- every element of `B = R[x⁻¹R]` comes from `R`
  have hB : ∀ b : B, ∃ r : R, algebraMap R B r = b := by
    have key : ∀ y ∈ B, ∃ r : R, algebraMap R (FractionRing R) r = y := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem y hy =>
        obtain ⟨p, -, rfl⟩ := hy
        refine ⟨p * ↑u⁻¹, (eq_div_iff hx0).mpr ?_⟩
        rw [← map_mul, mul_assoc, ← hu, Units.inv_mul, mul_one]
      | algebraMap r => exact ⟨r, rfl⟩
      | add y z _ _ hy hz =>
        obtain ⟨a, rfl⟩ := hy
        obtain ⟨b, rfl⟩ := hz
        exact ⟨a + b, map_add _ _ _⟩
      | mul y z _ _ hy hz =>
        obtain ⟨a, rfl⟩ := hy
        obtain ⟨b, rfl⟩ := hz
        exact ⟨a * b, map_mul _ _ _⟩
    intro b
    obtain ⟨r, hr⟩ := key b b.2
    exact ⟨r, Subtype.ext hr⟩
  have hinj1 : Function.Injective (algebraMap R B) := by
    intro a b hab
    have := congrArg (fun y : B => (y : FractionRing R)) hab
    simp only [Subalgebra.coe_algebraMap] at this
    exact IsFractionRing.injective R (FractionRing R) this
  have hinj2 : Function.Injective (algebraMap B T.ring) :=
    IsLocalization.injective T.ring (Ideal.primeCompl_le_nonZeroDivisors T.M')
  refine ⟨hinj2.comp hinj1, fun y => ?_⟩
  obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective T.M'.primeCompl y
  obtain ⟨r, rfl⟩ := hB b
  obtain ⟨r', hr'⟩ := hB s
  -- `s ∉ M'`, so `r' ∉ M` and `r'` is a unit of `R`
  have hr'u : IsUnit r' := by
    by_contra h
    have : algebraMap R B r' ∈ T.M' := T.le (Ideal.mem_map_of_mem _ h)
    exact s.2 (hr' ▸ this)
  obtain ⟨v, rfl⟩ := hr'u
  refine ⟨r * ↑v⁻¹, ?_⟩
  rw [IsLocalization.eq_mk'_iff_mul_eq]
  show algebraMap B T.ring (algebraMap R B (r * ↑v⁻¹)) * algebraMap B T.ring s =
    algebraMap B T.ring (algebraMap R B r)
  rw [← hr', ← map_mul, ← map_mul, mul_assoc, Units.inv_mul, mul_one]

/-- For a monoidal transform with center `R`, the strict transform of `J` is `J R'`. -/
private theorem strictTransformIdeal_eq_map_of_eq_top {P : Ideal R} (hP : P = ⊤)
    (T : MonoidalTransform R P) (J : Ideal R) :
    strictTransformIdeal T J = J.map T.toRing := by
  subst hP
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.map_le_iff_le_comap.mpr fun f hf => ?_)
  · rintro y ⟨x, hx, f, hf, ν, -, hy⟩
    rw [Ideal.map_top, Ideal.span_singleton_eq_top] at hx
    obtain ⟨w, hw⟩ := hx.pow ν
    rw [← hw] at hy
    have : y = ↑w⁻¹ * T.toRing f := by rw [← hy, ← mul_assoc, Units.inv_mul, one_mul]
    rw [SetLike.mem_coe, this]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hf)
  · refine Ideal.subset_span ⟨1, by rw [Ideal.map_top, Ideal.span_singleton_one], f, hf, 0,
      by simp, by rw [pow_zero, one_mul]⟩

end TopAux

section PartBAux

/-- The end of the proof of Theorem 4: once `ν*(J_n)` is constant from `N` on, so is `t(J_n)`,
and the `τ^{(i)}(J_n)` (non-decreasing by Lemma 15, bounded by `dim R_n`) are eventually
constant. -/
private theorem exists_stationary_of_nuStar_stationary (R : ℕ → Type u) [∀ n, CommRing (R n)]
    [∀ n, IsRegularLocalRing (R n)] (J : ∀ n, Ideal (R n))
    (H2 : ∀ n a (i : ℕ+), 1 ≤ a → a ≤ t (R n) (J n) →
      IsGreatest {k : ℕ+ | nuI (R n) (J n) k = (mu (R n) (J n) a : ℕ∞)} i →
      (∀ j : ℕ+, (j : ℕ) ≤ i → nuI (R n) (J n) j = nuI (R (n + 1)) (J (n + 1)) j) →
      ∀ b, 1 ≤ b → b ≤ a → tau (R n) (J n) b ≤ tau (R (n + 1)) (J (n + 1)) b)
    (d : ℕ) (hd : ∀ n, (maximalIdeal (R n)).spanFinrank = d)
    (N : ℕ) (hN : ∀ n, N ≤ n → nuStar (R n) (J n) = nuStar (R N) (J N)) :
    ∃ α₀ : ℕ, 0 < α₀ ∧
      (∀ α, α₀ ≤ α → nuStar (R α) (J α) = nuStar (R α₀) (J α₀)) ∧
      (∀ α, α₀ ≤ α → t (R α) (J α) = t (R α₀) (J α₀)) ∧
      ∀ α, α₀ ≤ α → ∀ i, 1 ≤ i → i ≤ t (R α₀) (J α₀) →
        tau (R α) (J α) i = tau (R α₀) (J α₀) i := by
  have hex : ∀ n, ∃ s : Finset (R n), Ideal.span (s : Set (R n)) = maximalIdeal (R n) ∧
      s.card = d := fun n => by
    obtain ⟨s, hc, hspan⟩ :=
      (IsNoetherian.noetherian (maximalIdeal (R n))).exists_span_finset_card_eq_spanFinrank
    exact ⟨s, hspan, hc.trans (hd n)⟩
  choose s hs hsd using hex
  have hν : ∀ n, N ≤ n → ∀ i, nuI (R n) (J n) i = nuI (R N) (J N) i := fun n hn i =>
    congrFun (toLex.injective (hN n hn)) i
  have ht : ∀ n, N ≤ n → t (R n) (J n) = t (R N) (J N) := by
    intro n hn
    have : muSet (R n) (J n) = muSet (R N) (J N) := by
      ext μ
      simp only [muSet, Set.mem_ofPred_eq, hν n hn]
    rw [t, t, this]
  -- `τ^{(a)}(J_n)` is non-decreasing from `N` on (Lemma 15 with `i` the largest index with
  -- `ν^{(i)} = μ^{(a)}`)
  have hmono : ∀ n, N ≤ n → ∀ a, 1 ≤ a → a ≤ t (R N) (J N) →
      tau (R n) (J n) a ≤ tau (R (n + 1)) (J (n + 1)) a := by
    intro n hn a ha hat
    have hat' : a ≤ t (R n) (J n) := by rw [ht n hn]; exact hat
    have hfin := (muSet_finite (R n) (J n)).1
    have hmem : mu (R n) (J n) a ∈ muSet (R n) (J n) := by
      apply Nat.nth_mem_of_lt_card hfin
      refine lt_of_lt_of_le ?_ (le_of_eq (Set.ncard_eq_toFinset_card _ hfin))
      have : t (R n) (J n) = (muSet (R n) (J n)).ncard := rfl
      omega
    obtain ⟨k₀, hk₀⟩ := hmem
    have hSfin : {k : ℕ+ | nuI (R n) (J n) k = (mu (R n) (J n) a : ℕ∞)}.Finite :=
      (ncard_nuI_eq_le_choose (R n) (J n) (mu (R n) (J n) a)).1
    obtain ⟨i, hi, himax⟩ := Set.exists_max_image _ (fun k : ℕ+ => (k : ℕ)) hSfin ⟨k₀, hk₀⟩
    exact H2 n a i ha hat' ⟨hi, fun k hk => PNat.coe_le_coe _ _ |>.mp (himax k hk)⟩
      (fun j _ => (hν n hn j).trans (hν (n + 1) (by omega) j).symm) a ha le_rfl
  by_cases ht0 : t (R N) (J N) = 0
  · refine ⟨N + 1, by omega, fun α hα => ?_, fun α hα => ?_, fun α hα i hi hit => ?_⟩
    · rw [hN α (by omega), hN (N + 1) (by omega)]
    · rw [ht α (by omega), ht (N + 1) (by omega)]
    · rw [ht (N + 1) (by omega), ht0] at hit
      omega
  obtain ⟨M, hNM, hM⟩ := exists_stable_of_monotone_family
    (fun n b => tau (R n) (J n) (b + 1)) (t (R N) (J N) - 1) d N
    (fun n hn b hb => hmono n hn (b + 1) (by omega) (by omega))
    (fun n b => (tau_le_card (R n) (J n) (s n) (hs n) _).trans (le_of_eq (hsd n)))
  refine ⟨M + 1, by omega, fun α hα => ?_, fun α hα => ?_, fun α hα i hi hit => ?_⟩
  · rw [hN α (by omega), hN (M + 1) (by omega)]
  · rw [ht α (by omega), ht (M + 1) (by omega)]
  · rw [ht (M + 1) (by omega)] at hit
    have h1 := hM α (by omega) (i - 1) (by omega)
    have h2 := hM (M + 1) (by omega) (i - 1) (by omega)
    simp only [Nat.sub_add_cancel hi] at h1 h2
    rw [h1, h2]

end PartBAux

section LiftAux

/-- A ring isomorphism is a local homomorphism. -/
private theorem isLocalHom_ringEquiv {A B : Type u} [CommRing A] [CommRing B]
    (e : A ≃+* B) : IsLocalHom (e : A →+* B) :=
  ⟨fun a ha => by simpa using ha.map (e.symm : B →+* A)⟩

/-- The `n`-th ring of the lifted sequence in the proof of Theorem 4 (p. 234): a regular local
ring `R_n'` with separably closed residue field, and a local homomorphism `R_n → R_n'`
transforming a regular system of parameters into one and inducing a separable algebraic
extension of the residue fields. -/
private structure MonoidalSequence.LiftStage (S : MonoidalSequence.{u}) (n : ℕ) : Type (u + 1) where
  R : Type u
  [cr : CommRing R]
  [reg : IsRegularLocalRing R]
  [dom : IsDomain R]
  α : S.ring n →+* R
  [loc : IsLocalHom α]
  maps : RingHom.MapsRSOP α
  sep : RingHom.IsResiduallySeparableAlgebraic α
  sc : IsSepClosed (ResidueField R)

attribute [instance] MonoidalSequence.LiftStage.cr MonoidalSequence.LiftStage.reg
  MonoidalSequence.LiftStage.dom MonoidalSequence.LiftStage.loc

variable (S : MonoidalSequence.{u})

/-- The canonical monoidal transform `R_n'₁` of `R_n'` over `R_{n+1}` (Lemma 4 of §2). -/
private noncomputable def MonoidalSequence.LiftStage.transform {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    MonoidalTransform D.R ((S.center n).map D.α) :=
  (exists_isCanonicalLift D.α D.maps (S.transform n)).choose

/-- The canonical local homomorphism `R_{n+1} → R_n'₁`. -/
private noncomputable def MonoidalSequence.LiftStage.canonicalHom {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    (S.transform n).ring →+* (MonoidalSequence.LiftStage.transform S D).ring :=
  (exists_isCanonicalLift D.α D.maps (S.transform n)).choose_spec.choose

private theorem MonoidalSequence.LiftStage.isCanonicalLift {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    IsCanonicalLift D.α (S.transform n) (MonoidalSequence.LiftStage.transform S D) (MonoidalSequence.LiftStage.canonicalHom S D) :=
  (exists_isCanonicalLift D.α D.maps (S.transform n)).choose_spec.choose_spec

private instance {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    IsLocalHom (MonoidalSequence.LiftStage.canonicalHom S D) := (MonoidalSequence.LiftStage.isCanonicalLift S D).isLocalHom

private instance (n : ℕ) :
    IsRegularLocalRing (S.transform n).ring :=
  IsRegularLocalRing.of_ringEquiv (S.equiv n).symm

private instance (n : ℕ) :
    IsLocalHom ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring) :=
  isLocalHom_ringEquiv _

/-- In the case of a center `R_n` (`P_n = R_n`), the monoidal transforms are isomorphisms. -/
private theorem MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top {n : ℕ} (D : MonoidalSequence.LiftStage S n)
    (hc : S.center n = ⊤) :
    Function.Bijective (S.transform n).toRing ∧ Function.Bijective (MonoidalSequence.LiftStage.transform S D).toRing :=
  ⟨MonoidalTransform.toRing_bijective_of_eq_top hc _,
    MonoidalTransform.toRing_bijective_of_eq_top (by rw [hc, Ideal.map_top]) _⟩

/-- The composite `R_{n+1} → R_n'₁` equals `R_n'₁ ← R_n' ← R_n ← R_{n+1}` in the case of a
center `R_n`. -/
private theorem MonoidalSequence.LiftStage.canonicalHom_comp_eq_of_center_eq_top {n : ℕ} (D : MonoidalSequence.LiftStage S n) (hc : S.center n = ⊤) :
    (MonoidalSequence.LiftStage.canonicalHom S D).comp ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring) =
      ((RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).2 : D.R ≃+* _) :
        D.R →+* _).comp (D.α.comp (((S.equiv n).symm.trans
          (RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).1).symm :
            S.ring (n + 1) ≃+* S.ring n) : S.ring (n + 1) →+* S.ring n)) := by
  refine RingHom.ext fun x => ?_
  set eT := RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).1
  have h := DFunLike.congr_fun (MonoidalSequence.LiftStage.isCanonicalLift S D).comm (eT.symm ((S.equiv n).symm x))
  simp only [RingHom.coe_comp, Function.comp_apply] at h
  have h' : (S.transform n).toRing (eT.symm ((S.equiv n).symm x)) = (S.equiv n).symm x :=
    eT.apply_symm_apply _
  rw [h'] at h
  simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_coe, RingEquiv.coe_trans]
  exact h

/-- The regularity of `R_n'₁`. -/
private theorem MonoidalSequence.LiftStage.isRegularLocalRing_transform (hperm : S.IsPermissible) {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    IsRegularLocalRing (MonoidalSequence.LiftStage.transform S D).ring := by
  rcases hperm n with hc | ⟨hP, -, hS, -⟩
  · exact IsRegularLocalRing.of_ringEquiv
      (RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).2)
  · obtain ⟨⟨hP', hS'⟩, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
    have hP'0 : (S.center n).map D.α ≠ ⊥ := fun h =>
      (MonoidalSequence.LiftStage.transform S D).x_ne_zero (Ideal.mem_bot.mp (h.le (MonoidalSequence.LiftStage.transform S D).x_mem))
    exact (MonoidalTransform.isRegularLocalRing_and_isLocalHom_and_span_xR_eq_map (MonoidalSequence.LiftStage.transform S D) hP' hP'0 hS').1

/-- The residue field extension of `R_n'₁` over `R_n'` in the case of a proper center: it is
separable algebraic (Lemma 4 (2)), hence trivial (`R_n'` has separably closed residue field). -/
private theorem MonoidalSequence.LiftStage.isResiduallyRational_transform (hperm : S.IsPermissible)
    (hsep : S.IsResiduallySeparableAlgebraic) {n : ℕ} (D : MonoidalSequence.LiftStage S n)
    (hc : S.center n ≠ ⊤) :
    RingHom.IsResiduallyRational (R := D.R) (R' := (MonoidalSequence.LiftStage.transform S D).ring) (MonoidalSequence.LiftStage.transform S D).toRing := by
  obtain ⟨hP, -, hS, -⟩ := (hperm n).resolve_left hc
  obtain ⟨-, -, h2, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
  have hsepT' := isResiduallySeparableAlgebraic_of_closure_eq_top (S.transform n).toRing D.α
    (MonoidalSequence.LiftStage.canonicalHom S D) (MonoidalSequence.LiftStage.transform S D).toRing (MonoidalSequence.LiftStage.isCanonicalLift S D).comm.symm (hsep n)
    (by rw [Set.union_comm]; exact (h2 _ _ _ (MonoidalSequence.LiftStage.isCanonicalLift S D)).2.2.2.2)
  let _ : Algebra (ResidueField D.R) (ResidueField (MonoidalSequence.LiftStage.transform S D).ring) :=
    (ResidueField.map (MonoidalSequence.LiftStage.transform S D).toRing).toAlgebra
  have _ : Algebra.IsSeparable (ResidueField D.R) (ResidueField (MonoidalSequence.LiftStage.transform S D).ring) := hsepT'
  have _ := D.sc
  exact IsSepClosed.algebraMap_surjective (ResidueField D.R) (ResidueField (MonoidalSequence.LiftStage.transform S D).ring)

/-- The residue field of `R_n'₁` is separably closed. -/
private theorem MonoidalSequence.LiftStage.isSepClosed_transform (hperm : S.IsPermissible) (hsep : S.IsResiduallySeparableAlgebraic)
    {n : ℕ} (D : MonoidalSequence.LiftStage S n) : IsSepClosed (ResidueField (MonoidalSequence.LiftStage.transform S D).ring) := by
  have _ := D.sc
  by_cases hc : S.center n = ⊤
  · exact isSepClosed_of_ringEquiv
      (ResidueField.mapEquiv (RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).2))
  · have hrat := MonoidalSequence.LiftStage.isResiduallyRational_transform S hperm hsep D hc
    exact isSepClosed_of_ringEquiv (RingEquiv.ofBijective _
      ⟨(ResidueField.map (MonoidalSequence.LiftStage.transform S D).toRing).injective, hrat⟩)

/-- `R_{n+1} → R_n'₁` transforms a regular system of parameters into one. -/
private theorem MonoidalSequence.LiftStage.mapsRSOP_canonicalHom (hperm : S.IsPermissible) {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    RingHom.MapsRSOP ((MonoidalSequence.LiftStage.canonicalHom S D).comp
      ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring)) := by
  classical
  have _ := MonoidalSequence.LiftStage.isRegularLocalRing_transform S hperm D
  by_cases hc : S.center n = ⊤
  · rw [MonoidalSequence.LiftStage.canonicalHom_comp_eq_of_center_eq_top S D hc]
    exact mapsRSOP_ringEquiv_comp _ D.maps _ _
  · obtain ⟨hP, -, hS, -⟩ := (hperm n).resolve_left hc
    obtain ⟨-, -, h2, h3⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
    have hsepα := D.sep
    have hsepβ := (h3 _ _ _ (MonoidalSequence.LiftStage.isCanonicalLift S D)).2 hsepα
    obtain ⟨-, s₁, hs₁⟩ := (isRegularLocalRing_iff_exists_rsop (R := S.ring (n + 1))).mp
      inferInstance
    have hs := isRSOP_image_ringEquiv (S.equiv n).symm s₁ hs₁
    refine ⟨s₁, hs₁, ?_, ?_⟩
    · have := hsepβ _ hs
      rwa [Finset.image_image] at this
    · have hinj := (h2 _ _ _ (MonoidalSequence.LiftStage.isCanonicalLift S D)).2.2.2.1
      exact (hinj.comp (S.equiv n).symm.injective).injOn

/-- `R_{n+1} → R_n'₁` is residually separable algebraic. -/
private theorem MonoidalSequence.LiftStage.isResiduallySeparableAlgebraic_canonicalHom (hperm : S.IsPermissible) {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    RingHom.IsResiduallySeparableAlgebraic ((MonoidalSequence.LiftStage.canonicalHom S D).comp
      ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring)) := by
  by_cases hc : S.center n = ⊤
  · have key : ∀ (φ : S.ring (n + 1) →+* (MonoidalSequence.LiftStage.transform S D).ring) [IsLocalHom φ],
        φ = ((RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).2 : D.R ≃+* _) :
          D.R →+* _).comp (D.α.comp (((S.equiv n).symm.trans
            (RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).1).symm :
              S.ring (n + 1) ≃+* S.ring n) : S.ring (n + 1) →+* S.ring n)) →
        RingHom.IsResiduallySeparableAlgebraic φ := by
      intro φ _ hφ
      subst hφ
      exact isResiduallySeparableAlgebraic_ringEquiv_comp _ D.sep _ _
    exact key _ (MonoidalSequence.LiftStage.canonicalHom_comp_eq_of_center_eq_top S D hc)
  · obtain ⟨hP, -, hS, -⟩ := (hperm n).resolve_left hc
    obtain ⟨-, -, h2, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
    have hβ := isResiduallySeparableAlgebraic_of_closure_eq_top D.α (S.transform n).toRing
      (MonoidalSequence.LiftStage.transform S D).toRing (MonoidalSequence.LiftStage.canonicalHom S D) (MonoidalSequence.LiftStage.isCanonicalLift S D).comm D.sep
      (h2 _ _ _ (MonoidalSequence.LiftStage.isCanonicalLift S D)).2.2.2.2
    have key : ∀ (φ : S.ring (n + 1) →+* (MonoidalSequence.LiftStage.transform S D).ring) [IsLocalHom φ],
        φ = ((RingEquiv.refl _ : (MonoidalSequence.LiftStage.transform S D).ring ≃+* _) : _ →+* _).comp ((MonoidalSequence.LiftStage.canonicalHom S D).comp
          ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring)) →
        RingHom.IsResiduallySeparableAlgebraic φ := by
      intro φ _ hφ
      subst hφ
      exact isResiduallySeparableAlgebraic_ringEquiv_comp _ hβ _ _
    exact key _ (RingHom.ext fun _ => rfl)

/-- The next stage of the lifted sequence. -/
private noncomputable def MonoidalSequence.LiftStage.next (hperm : S.IsPermissible)
    (hsep : S.IsResiduallySeparableAlgebraic) (n : ℕ) (D : MonoidalSequence.LiftStage S n) :
    MonoidalSequence.LiftStage S (n + 1) :=
  have := MonoidalSequence.LiftStage.isRegularLocalRing_transform S hperm D
  { R := (MonoidalSequence.LiftStage.transform S D).ring
    α := (MonoidalSequence.LiftStage.canonicalHom S D).comp ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring)
    maps := MonoidalSequence.LiftStage.mapsRSOP_canonicalHom S hperm D
    sep := MonoidalSequence.LiftStage.isResiduallySeparableAlgebraic_canonicalHom S hperm D
    sc := MonoidalSequence.LiftStage.isSepClosed_transform S hperm hsep D }

/-- The lifted sequence `R_n'` (proof of Theorem 4, p. 234). -/
private noncomputable def MonoidalSequence.liftSeq (hperm : S.IsPermissible)
    (hsep : S.IsResiduallySeparableAlgebraic) (D₀ : MonoidalSequence.LiftStage S 0) :
    (n : ℕ) → MonoidalSequence.LiftStage S n
  | 0 => D₀
  | n + 1 => MonoidalSequence.LiftStage.next S hperm hsep n (MonoidalSequence.liftSeq hperm hsep D₀ n)

end LiftAux

section StepAux

variable (S : MonoidalSequence.{u})

/-- `J_{n+1}' = J_{n+1} R_{n+1}'` is the strict transform of `J_n' = J_n R_n'` in `R_n'₁` (the
Corollary to Lemma 5 of §2, and, for a center `R_n`, the isomorphism `R_n' ≅ R_n'₁`). -/
private theorem MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_ideal_succ [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (hperm : S.IsPermissible) {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    (S.ideal (n + 1)).map ((MonoidalSequence.LiftStage.canonicalHom S D).comp
      ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring)) =
      strictTransformIdeal (MonoidalSequence.LiftStage.transform S D) ((S.ideal n).map D.α) := by
  have hmap : ∀ I : Ideal (S.transform n).ring,
      (I.map (S.equiv n)).map ((MonoidalSequence.LiftStage.canonicalHom S D).comp
        ((S.equiv n).symm : S.ring (n + 1) →+* (S.transform n).ring)) = I.map (MonoidalSequence.LiftStage.canonicalHom S D) := by
    intro I
    rw [show I.map (S.equiv n) = I.map ((S.equiv n : _ ≃+* _) : _ →+* _) from rfl,
      Ideal.map_map]
    congr 1
    exact RingHom.ext fun x => by simp
  rw [S.ideal_succ n, hmap]
  have _ := MonoidalSequence.LiftStage.isRegularLocalRing_transform S hperm D
  by_cases hc : S.center n = ⊤
  · rw [strictTransformIdeal_eq_map_of_eq_top hc,
      strictTransformIdeal_eq_map_of_eq_top (by rw [hc, Ideal.map_top]), Ideal.map_map,
      Ideal.map_map, (MonoidalSequence.LiftStage.isCanonicalLift S D).comm]
  · obtain ⟨hP, hJP, hS, -⟩ := (hperm n).resolve_left hc
    obtain ⟨⟨hP', hS'⟩, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
    have _ := hP
    have _ := hS
    have _ := hP'
    exact (strictTransform_map_of_mapsRSOP D.α D.maps (S.ideal n) (S.center n) hJP
      (S.transform n) (MonoidalSequence.LiftStage.transform S D) (MonoidalSequence.LiftStage.canonicalHom S D) (MonoidalSequence.LiftStage.isCanonicalLift S D).comm).1.symm

/-- The ring isomorphism `R_n' ≅ R_n'₁` for a center `R_n`. -/
private noncomputable def MonoidalSequence.LiftStage.topEquiv {n : ℕ} (D : MonoidalSequence.LiftStage S n) (hc : S.center n = ⊤) :
    D.R ≃+* (MonoidalSequence.LiftStage.transform S D).ring :=
  RingEquiv.ofBijective _ (MonoidalSequence.LiftStage.toRing_bijective_of_center_eq_top S D hc).2

private theorem MonoidalSequence.LiftStage.coe_topEquiv {n : ℕ} (D : MonoidalSequence.LiftStage S n) (hc : S.center n = ⊤) :
    ((MonoidalSequence.LiftStage.topEquiv S D hc : D.R ≃+* _) : D.R →+* _) = (MonoidalSequence.LiftStage.transform S D).toRing :=
  RingHom.ext fun _ => rfl

/-- The strict transform for a center `R_n` is the image under `R_n' ≅ R_n'₁`. -/
private theorem MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_topEquiv {n : ℕ} (D : MonoidalSequence.LiftStage S n) (hc : S.center n = ⊤) :
    strictTransformIdeal (MonoidalSequence.LiftStage.transform S D) ((S.ideal n).map D.α) =
      ((S.ideal n).map D.α).map ((MonoidalSequence.LiftStage.topEquiv S D hc : D.R ≃+* _) : D.R →+* _) := by
  rw [MonoidalSequence.LiftStage.coe_topEquiv, strictTransformIdeal_eq_map_of_eq_top (by rw [hc, Ideal.map_top])]

/-- Theorem 3 along the lifted sequence: `ν*(J_{n+1}') ≤ ν*(J_n')`. -/
private theorem MonoidalSequence.LiftStage.nuStar_next_le [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (hperm : S.IsPermissible) (hsep : S.IsResiduallySeparableAlgebraic)
    {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    nuStar (MonoidalSequence.LiftStage.next S hperm hsep n D).R ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α) ≤
      nuStar D.R ((S.ideal n).map D.α) := by
  have hJ : (S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α =
      strictTransformIdeal (MonoidalSequence.LiftStage.transform S D) ((S.ideal n).map D.α) := MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_ideal_succ S hperm D
  rw [hJ]
  clear hJ
  have _ := MonoidalSequence.LiftStage.isRegularLocalRing_transform S hperm D
  by_cases hc : S.center n = ⊤
  · have _ := isLocalHom_ringEquiv (MonoidalSequence.LiftStage.topEquiv S D hc)
    rw [MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_topEquiv S D hc]
    exact le_of_eq (nuStar_map_eq_of_mapsRSOP _
      (mapsRSOP_ringEquiv (MonoidalSequence.LiftStage.topEquiv S D hc)) _).symm
  · obtain ⟨hP, hJP, hS, -⟩ := (hperm n).resolve_left hc
    obtain ⟨⟨hP', hS'⟩, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
    have _ := hP
    have _ := hP'
    have hperm' := (isPermissibleCenter_map_iff D.α D.maps (S.ideal n) (S.center n) hJP).2.2.2.mp
      (hperm n)
    exact (nuStar_strictTransform_le_of_isResiduallyRational D.R ((S.center n).map D.α)
      ((S.ideal n).map D.α) (Ideal.map_mono hJP) (MonoidalSequence.LiftStage.transform S D)
      (MonoidalSequence.LiftStage.isResiduallyRational_transform S hperm hsep D hc) hperm').1

/-- A standard base `f` of `J_n'` with `ν_{P_n'}(f_j) = ν^{(j)}(J_n')` (permissibility of
`P_n' = P_n R_n'`, Remark 1, and (ii)** of Definition 8). -/
private theorem MonoidalSequence.LiftStage.exists_standardBase_ordElem_eq_nuI (hperm : S.IsPermissible) {n : ℕ} (D : MonoidalSequence.LiftStage S n)
    (hc : S.center n ≠ ⊤) :
    ((S.center n).map D.α).IsPrime ∧ IsRegularLocalRing (D.R ⧸ (S.center n).map D.α) ∧
      (S.ideal n).map D.α ≤ (S.center n).map D.α ∧
      ∃ (m : ℕ) (f : Fin m → D.R), IsStandardBase D.R ((S.ideal n).map D.α) f ∧
        ∀ j : Fin m, Ideal.ordElem ((S.center n).map D.α) (f j) =
          nuI D.R ((S.ideal n).map D.α) ((j : ℕ).succPNat) := by
  obtain ⟨hP, hJP, hS, -⟩ := (hperm n).resolve_left hc
  obtain ⟨⟨hP', hS'⟩, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
  have _ := hP
  have _ := hP'
  have hperm' := (isPermissibleCenter_map_iff D.α D.maps (S.ideal n) (S.center n) hJP).2.2.2.mp
    (hperm n)
  obtain ⟨-, hJP', -, hNF⟩ := hperm'.resolve_left hP'.ne_top
  refine ⟨hP', hS', hJP', ?_⟩
  exact ((isPermissibleCenter_tfae D.R ((S.ideal n).map D.α) ((S.center n).map D.α) hJP').out
    1 3).mp hNF

/-- Lemma 15 along the lifted sequence. -/
private theorem MonoidalSequence.LiftStage.tau_le_tau_next [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (hperm : S.IsPermissible) (hsep : S.IsResiduallySeparableAlgebraic)
    {n : ℕ} (D : MonoidalSequence.LiftStage S n) (a : ℕ) (i : ℕ+) (ha : 1 ≤ a)
    (hat : a ≤ t D.R ((S.ideal n).map D.α))
    (hi : IsGreatest {k : ℕ+ | nuI D.R ((S.ideal n).map D.α) k =
      (mu D.R ((S.ideal n).map D.α) a : ℕ∞)} i)
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ i → nuI D.R ((S.ideal n).map D.α) j =
      nuI (MonoidalSequence.LiftStage.next S hperm hsep n D).R ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α) j) :
    ∀ b, 1 ≤ b → b ≤ a → tau D.R ((S.ideal n).map D.α) b ≤
      tau (MonoidalSequence.LiftStage.next S hperm hsep n D).R ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α) b := by
  have hJ : (S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α =
      strictTransformIdeal (MonoidalSequence.LiftStage.transform S D) ((S.ideal n).map D.α) := MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_ideal_succ S hperm D
  rw [hJ] at heq ⊢
  clear hJ
  have _ := MonoidalSequence.LiftStage.isRegularLocalRing_transform S hperm D
  by_cases hc : S.center n = ⊤
  · intro b hb hba
    have _ := isLocalHom_ringEquiv (MonoidalSequence.LiftStage.topEquiv S D hc)
    rw [MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_topEquiv S D hc]
    refine le_of_eq ((tauStar_map _ (mapsRSOP_ringEquiv (MonoidalSequence.LiftStage.topEquiv S D hc))
      (isResiduallySeparable_of_isResiduallySeparableAlgebraic _
        (isResiduallySeparableAlgebraic_ringEquiv _)) _).2.1 b hb
          (hba.trans hat)).symm
  · obtain ⟨hP', hS', hJP', m, f, hf, hfP⟩ := MonoidalSequence.LiftStage.exists_standardBase_ordElem_eq_nuI S hperm D hc
    have _ := hP'
    have _ := hS'
    exact tau_le_tau_strictTransform D.R ((S.center n).map D.α) ((S.ideal n).map D.α) hJP'
      (MonoidalSequence.LiftStage.transform S D) (MonoidalSequence.LiftStage.isResiduallyRational_transform S hperm hsep D hc) f a ha hat hf i hi
      (fun j _ => hfP j) heq

/-- Lemma 16 along the lifted sequence (for a center `R_n`, the isomorphism of graded rings
induced by `R_n' ≅ R_n'₁`). -/
private theorem MonoidalSequence.LiftStage.exists_gradedRingEquiv_next [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (hperm : S.IsPermissible) (hsep : S.IsResiduallySeparableAlgebraic)
    {n : ℕ} (D : MonoidalSequence.LiftStage S n) (a : ℕ) (i : ℕ+) (ha : 1 ≤ a)
    (hat : a ≤ t D.R ((S.ideal n).map D.α))
    (hi : IsGreatest {k : ℕ+ | nuI D.R ((S.ideal n).map D.α) k =
      (mu D.R ((S.ideal n).map D.α) a : ℕ∞)} i)
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ i → nuI D.R ((S.ideal n).map D.α) j =
      nuI (MonoidalSequence.LiftStage.next S hperm hsep n D).R ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α) j)
    (hgap : (mu D.R ((S.ideal n).map D.α) a : ℕ∞) <
      nuI (MonoidalSequence.LiftStage.next S hperm hsep n D).R ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α) (i + 1))
    (htau : ∀ b, 1 ≤ b → b ≤ a →
      tau (MonoidalSequence.LiftStage.next S hperm hsep n D).R ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α) b =
        tau D.R ((S.ideal n).map D.α) b) :
    ∃ σ : AssocGraded (maximalIdeal D.R) ≃+* AssocGraded (maximalIdeal (MonoidalSequence.LiftStage.next S hperm hsep n D).R),
      (∀ c : D.R, σ (algebraMap D.R (AssocGraded (maximalIdeal D.R)) c) =
        algebraMap (MonoidalSequence.LiftStage.next S hperm hsep n D).R
          (AssocGraded (maximalIdeal (MonoidalSequence.LiftStage.next S hperm hsep n D).R))
          ((MonoidalSequence.LiftStage.transform S D).toRing c)) ∧
      (∀ μ, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal D.R) μ,
        σ φ ∈ AssocGraded.homogeneous (maximalIdeal (MonoidalSequence.LiftStage.next S hperm hsep n D).R) μ) ∧
      (∀ μ, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal (MonoidalSequence.LiftStage.next S hperm hsep n D).R) μ,
        σ.symm ψ ∈ AssocGraded.homogeneous (maximalIdeal D.R) μ) ∧
      ∀ μ ≤ mu D.R ((S.ideal n).map D.α) a, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal D.R) μ,
        (φ ∈ grIdeal (maximalIdeal D.R) ((S.ideal n).map D.α) ↔
          σ φ ∈ grIdeal (maximalIdeal (MonoidalSequence.LiftStage.next S hperm hsep n D).R)
            ((S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α)) := by
  have hJ : (S.ideal (n + 1)).map (MonoidalSequence.LiftStage.next S hperm hsep n D).α =
      strictTransformIdeal (MonoidalSequence.LiftStage.transform S D) ((S.ideal n).map D.α) := MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_ideal_succ S hperm D
  rw [hJ] at heq hgap htau ⊢
  clear hJ
  have _ := MonoidalSequence.LiftStage.isRegularLocalRing_transform S hperm D
  by_cases hc : S.center n = ⊤
  · rw [MonoidalSequence.LiftStage.strictTransformIdeal_eq_map_topEquiv S D hc]
    set e := MonoidalSequence.LiftStage.topEquiv S D hc
    have hM : (maximalIdeal D.R).map (e : D.R →+* _) = maximalIdeal (MonoidalSequence.LiftStage.transform S D).ring :=
      map_ringEquiv_maximalIdeal e
    refine ⟨grEquiv e _ _ hM, fun c => grEquiv_algebraMap e _ _ hM c,
      fun μ φ hφ => grEquiv_mem_homogeneous e _ _ hM hφ,
      fun μ ψ hψ => grEquiv_symm_mem_homogeneous e _ _ hM hψ, fun μ _ φ _ => ?_⟩
    exact (grEquiv_mem_grIdeal_iff e _ _ hM _ φ).symm
  · obtain ⟨hP', hS', hJP', m, f, hf, hfP⟩ := MonoidalSequence.LiftStage.exists_standardBase_ordElem_eq_nuI S hperm D hc
    have _ := hP'
    have _ := hS'
    obtain ⟨σ, h0, h1, h2, h3⟩ := exists_gradedRingEquiv_strictTransform D.R
      ((S.center n).map D.α) ((S.ideal n).map D.α) hJP' (MonoidalSequence.LiftStage.transform S D)
      (MonoidalSequence.LiftStage.isResiduallyRational_transform S hperm hsep D hc) f a ha hat hf i hi (fun j _ => hfP j) heq hgap
      htau
    exact ⟨σ, h0, h1, h2, h3⟩

/-- `dim R_n'₁ = dim R_n'`. -/
private theorem MonoidalSequence.LiftStage.ringKrullDim_transform_eq (hperm : S.IsPermissible) (hsep : S.IsResiduallySeparableAlgebraic)
    {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    ringKrullDim (MonoidalSequence.LiftStage.transform S D).ring = ringKrullDim D.R := by
  by_cases hc : S.center n = ⊤
  · exact (ringKrullDim_eq_of_ringEquiv (MonoidalSequence.LiftStage.topEquiv S D hc)).symm
  · obtain ⟨hP, -, hS, -⟩ := (hperm n).resolve_left hc
    obtain ⟨⟨hP', hS'⟩, -⟩ := RingHom.MapsRSOP.canonicalLift_properties D.α D.maps hP hS
    have hP'0 : (S.center n).map D.α ≠ ⊥ := fun h =>
      (MonoidalSequence.LiftStage.transform S D).x_ne_zero (Ideal.mem_bot.mp (h.le (MonoidalSequence.LiftStage.transform S D).x_mem))
    exact (MonoidalTransform.ringKrullDim_eq_iff (MonoidalSequence.LiftStage.transform S D) hP' hP'0 hS').mpr
      (isResiduallyAlgebraic_of_isResiduallyRational _
        (MonoidalSequence.LiftStage.isResiduallyRational_transform S hperm hsep D hc))

/-- Remarks 1 and 2: `ν*`, `t` and `τ^{(i)}` of `J_n` and of `J_n' = J_n R_n'` agree. -/
private theorem MonoidalSequence.LiftStage.nuStar_eq_and_tau_eq_map [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] {n : ℕ} (D : MonoidalSequence.LiftStage S n) :
    nuStar (S.ring n) (S.ideal n) = nuStar D.R ((S.ideal n).map D.α) ∧
      t D.R ((S.ideal n).map D.α) = t (S.ring n) (S.ideal n) ∧
      ∀ i, 1 ≤ i → i ≤ t (S.ring n) (S.ideal n) →
        tau D.R ((S.ideal n).map D.α) i = tau (S.ring n) (S.ideal n) i := by
  have h := tauStar_map D.α D.maps
    (isResiduallySeparable_of_isResiduallySeparableAlgebraic D.α D.sep) (S.ideal n)
  exact ⟨nuStar_map_eq_of_mapsRSOP D.α D.maps _, h.1, h.2.1⟩

end StepAux

/-- Theorem 4, p. 234: "Let `R` be a regular local ring, and `J` an ideal in `R`. Let
`{R_α, J_α}_{α ∈ ℤ⁺}` be an infinite sequence of regular local rings `R_α` and ideals `J_α` in
`R_α` such that (1) `R₀ = R`, `J₀ = J`, `R_α` is a monoidal transform of `R_{α-1}` with a
permissible center `P_{α-1}` for `J_{α-1}` and `J_α` is the strict transform of `J_{α-1}` in
`R_α` for all `α ∈ ℤ⁺`, and (2) `R_α` is residually separable algebraic over `R_{α-1}` for all
`α ∈ ℤ⁺`. Then there exists a positive integer `ᾱ` such that `ν*(J_α) = ν*(J_ᾱ)` for all
`α ≥ ᾱ` and `τ^{(i)}(J_α) = τ^{(i)}(J_ᾱ)` for all `α ≥ ᾱ` and for `1 ≤ i ≤ t(J_ᾱ) = t(J_α)`."
(Footnote 8: "See the footnote 7", i.e. `t(J_α) = t(J_ᾱ)` because `ν*(J_α) = ν*(J_ᾱ)`.)

`R` and `J` of the statement are `S.ring 0` and `S.ideal 0`; the paper's `ᾱ` is `α₀`.

Proof as printed: in the residually rational case the Lean proof
is the printed one (`exists_nuStar_stationary_of_isResiduallyRational`): the limit `ν^{(i)}` of the
`ν_α^{(i)}`; the bound "the number of those `ν^{(i)} = μ` is bounded by the rank of
`gr^μ_{M_α}(R_α)`, which is equal to `C(n+μ−1, n−1)`" (`homogeneous_finite_and_finrank`,
`ncard_nuI_eq_le_choose`); the integers `μ_a`, `i(a)`, `α(a)` with `α(a) < α(a+1)`; the case
distinction "the sequence `(μ₁, μ₂, …)` is finite / infinite"; the isomorphisms `σ(α)` of Lemma 16
(of graded `k`-algebras, i.e. compatible with the structure maps) and `λ(α)` onto `k[X₁, …, X_n]`
(graded `k`-algebra isomorphisms, `λ(α+1) ∘ σ(α) = λ(α)`); the ideals `H_μ`, `I(a)`; "Clearly `H_μ`
is the homogeneous part of degree `μ` of `I(a)`"; `I(a) ⊆ I(a+1)`, `I(a+1) ≠ I(a)`; and the
contradiction with the noetherian property of `k[X₁, …, X_n]`.

Remaining differences: the residually rational case is proved
for an abstract sequence satisfying the conclusions of Theorem 3 and Lemmas 15, 16, which are
verified along the lifted sequence (centers `P_α = R_α`, allowed by the convention of Definition 8,
are treated separately and the separable closedness of the residue fields of all `R_α'` is carried
along); the case "`(μ₁, μ₂, …)` finite", which the print dismisses ("the proof will be completed if
the sequence is finite"), is proved by the count (some `ν^{(i₀)} = ∞`, then `ν*(J_α)` is constant
from `α = N(i₀)` on); the choice of the `λ(α)` is carried out (`λ(α+1) := λ(α) ∘ σ(α)⁻¹`), and
`k` is the residue field of `R_{α(1)}`, acting on `gr_{M_α}(R_α)` through the canonical
homomorphisms. -/
@[blueprint "thm:III.4"
  (statement := /-- Let $R$ be a regular local ring, and $J$ an ideal in $R$. Let
    $\{R_\alpha,J_\alpha\}_{\alpha\in\mathbb Z^+}$ be an infinite sequence of regular local
    rings $R_\alpha$ and ideals $J_\alpha$ in $R_\alpha$ such that (1) $R_0=R$, $J_0=J$,
    $R_\alpha$ is a monoidal transform of $R_{\alpha-1}$ (\cref{def:III.2-monoidal-transform})
    with a permissible center $P_{\alpha-1}$ for $J_{\alpha-1}$ (\cref{def:III.8}) and
    $J_\alpha$ is the strict transform of $J_{\alpha-1}$ in $R_\alpha$
    (\cref{def:III.5-strict}) for all $\alpha\in\mathbb Z^+$, and (2) $R_\alpha$ is residually
    separable algebraic over $R_{\alpha-1}$ (\cref{def:III.2-residually}) for all
    $\alpha\in\mathbb Z^+$. Then there exists a positive integer $\bar\alpha$ such that
    $\nu^*(J_\alpha)=\nu^*(J_{\bar\alpha})$ for all $\alpha\ge\bar\alpha$ and
    $\tau^{(i)}(J_\alpha)=\tau^{(i)}(J_{\bar\alpha})$ for all $\alpha\ge\bar\alpha$ and for
    $1\le i\le t(J_{\bar\alpha})=t(J_\alpha)$. (Theorem 4, p.~234; footnote 8 refers to
    footnote 7, by which $t(J_\alpha)=t(J_{\bar\alpha})$ follows from
    $\nu^*(J_\alpha)=\nu^*(J_{\bar\alpha})$.) -/)
  (proof := /-- As in the proof of \cref{thm:III.3}, take a local extension $R\to R'$ such
    that a regular system of parameters of $R$ is transformed into such a system of parameters
    of $R'$, the residue field of $R'$ is separable algebraic over that of $R$, and the
    residue field of $R'$ admits no separable algebraic extension. By induction, choose
    regular local rings $R_\alpha'$ and ideals $J_\alpha'$ in $R_\alpha'$ with $R_0'=R'$,
    $J_0'=J'=JR'$, $J_\alpha'=J_\alpha R_\alpha'$, $P_{\alpha-1}'=P_{\alpha-1}R_{\alpha-1}'$,
    and $R_\alpha'$ a monoidal transform of $R_{\alpha-1}'$ with center $P_{\alpha-1}'$
    admitting a commutative diagram of canonical local homomorphisms over
    $R_{\alpha-1}\to R_{\alpha-1}'$. By Lemma~4 of \S2 (\cref{lem:III.4}),
    $R_\alpha\to R_\alpha'$ transforms a regular system of parameters of $R_\alpha$ into such
    a system of $R_\alpha'$ and the residue field of $R_\alpha'$ is separable algebraic over
    that of $R_\alpha$. By the Corollary to Lemma~5 of \S2 (\cref{cor:III.lem5}),
    $J_\alpha'$ is the strict transform of $J_{\alpha-1}'$ in $R_\alpha'$. By
    \cref{rem:III.5-1} and \cref{rem:III.5-2}, $\nu^*(J_\alpha)=\nu^*(J_\alpha')$ and
    $\tau^{(i)}(J_\alpha)=\tau^{(i)}(J_\alpha')$ for all $\alpha$ and
    $1\le i\le t(J_\alpha)=t(J_\alpha')$. Moreover, by Lemma~4 of \S2, the separable
    algebraic closedness of the residue field of $R'$ implies that $R_\alpha'$ is residually
    rational over $R_{\alpha-1}'$ for all $\alpha$. Thus we may assume that $R_\alpha$ is
    already residually rational over $R_{\alpha-1}$ for all $\alpha$.

    Assume this residual rationality for all $\alpha$. Let $\nu_\alpha^*=\nu^*(J_\alpha)$,
    $\nu_\alpha^{(i)}=\nu^{(i)}(J_\alpha)$ and $\tau_\alpha^{(i)}=\tau^{(i)}(J_\alpha)$. By
    \cref{thm:III.3}, the sequence $\{\nu_\alpha^*\}$ is monotone decreasing in the sense of
    Definition~2 of \S1 (\cref{def:III.2}); hence, for every positive integer $i$, the
    sequence of systems $(\nu_\alpha^{(1)},\dots,\nu_\alpha^{(i)})$ is monotone decreasing in
    the lexicographical ordering, and therefore stationary for all sufficiently large
    $\alpha$. Let $\nu^{(i)}$ denote the limit of $\nu_\alpha^{(i)}$, equal to
    $\nu_\alpha^{(i)}$ for all sufficiently large $\alpha$; then $\nu^{(i+1)}\ge\nu^{(i)}$ for
    all $i\ge1$ by the definition of $\nu^*(J)$. For every positive integer $\mu$, the number
    of those $\nu^{(i)}$ equal to $\mu$ is bounded by the rank of
    $\operatorname{gr}^\mu_{M_\alpha}(R_\alpha)$, which is $\binom{n+\mu-1}{n-1}$ with
    $n=\dim R_\alpha=\dim R$. Let $(\mu_1,\mu_2,\dots)$ be the sequence of distinct integers
    appearing in $(\nu^{(1)},\nu^{(2)},\dots)$. For each positive integer $a$, if $\mu_a$
    exists, there is a positive integer $i(a)$ with $\nu^{(i)}\le\mu_a$ for $i\le i(a)$ and
    $\nu^{(i)}>\mu_a$ for $i>i(a)$; hence there is a positive integer $\alpha(a)$ such that
    $\nu_\alpha^{(i)}=\nu^{(i)}\le\mu_a$ for all $i\le i(a)$ and all $\alpha\ge\alpha(a)$, and
    $\nu_\alpha^{(i(a)+1)}>\mu_a$ for all $\alpha\ge\alpha(a)$. Replacing $\alpha(a)$ by a
    suitably bigger integer, we may also assume $\tau_\alpha^{(b)}=\tau_{\alpha+1}^{(b)}$ for all
    $b\le a$ and all $\alpha\ge\alpha(a)$ (\cref{lem:III.15}; the numbers $\tau^{(b)}$ are all bounded
    by $\dim R_\alpha=\dim R$). Arrange the $\alpha(a)$ so that $\alpha(a)<\alpha(a+1)$.

    The proof is completed if the sequence $(\mu_1,\mu_2,\dots)$ is finite. Suppose the
    contrary. \cref{lem:III.16} implies that for each $\alpha$ with
    $\alpha(a)\le\alpha<\alpha(a+1)$ there is an isomorphism of graded $k$-algebras
    $\sigma(\alpha)\colon\operatorname{gr}_{M_\alpha}(R_\alpha)\to
    \operatorname{gr}_{M_{\alpha+1}}(R_{\alpha+1})$ with
    $\sigma(\alpha)(\operatorname{gr}^\mu_{M_\alpha}(J_\alpha,R_\alpha))=
    \operatorname{gr}^\mu_{M_{\alpha+1}}(J_{\alpha+1},R_{\alpha+1})$ for all $\mu\le\mu_a$,
    $k$ being the common residue field of the $R_\alpha$. Choose and fix, for each
    $\alpha\ge\alpha(1)$, an isomorphism of graded $k$-algebras
    $\lambda(\alpha)\colon\operatorname{gr}_{M_\alpha}(R_\alpha)\to k[X_1,\dots,X_n]$ with
    $n=\dim R$, compatible with the $\sigma(\alpha)$. Then the images
    $\lambda(\alpha)(\operatorname{gr}^\mu_{M_\alpha}(J_\alpha,R_\alpha))$ are the same for
    all $\alpha\ge\alpha(a)$ if $\mu\le\mu_a$; call this image $H_\mu$, and let $I(a)$ be the
    ideal in the polynomial ring generated by $H_\mu$ for all $\mu\le\mu_a$. Clearly $H_\mu$
    is the homogeneous part of degree $\mu$ of $I(a)$. By the definition of $\mu_{a+1}$,
    $I(a+1)$ contains $I(a)$ and $I(a+1)\ne I(a)$; in fact the homogeneous part of degree
    $\mu_{a+1}$ of $I(a+1)$ is not contained in $I(a)$. Thus we get an infinite strictly
    increasing sequence of ideals $I(a)$, contradicting the noetherian property of a
    polynomial ring.

    \textbf{Paper misprint.} In the commutative diagram on p.~236 the polynomial ring is
    printed $k[X_1,\dots,X_r]$; the text defines it as $k[X_1,\dots,X_n]$ with $n=\dim R$.

    \textbf{Formal proof.} In the residually rational case the Lean proof follows the print
    step by step. The limit $\nu^{(i)}$ of the $\nu_\alpha^{(i)}$ is the value at the stage
    from which the initial segment is stationary. The number of $\nu^{(i)}$ equal to $\mu$ is
    bounded by the rank of $\operatorname{gr}^\mu_{M_\alpha}(R_\alpha)$, which is proved to be
    $\binom{n+\mu-1}{n-1}$ ($n=\dim R_\alpha=\dim R$; $\operatorname{gr}_{M_\alpha}(R_\alpha)$ is a
    polynomial ring in $n$ variables over $k$, and the classes of the elements of degree $\mu$
    of a standard base are independent in $\operatorname{gr}^\mu_{M_\alpha}(R_\alpha)$). The
    integers $\mu_a$ are the $a$-th smallest of the distinct integers which appear in
    $(\nu^{(1)},\nu^{(2)},\dots)$, the integers $i(a)$ and $\alpha(a)$ are those described
    above ($\alpha(a)<\alpha(a+1)$, obtained from the bounds for all $a$ by taking maxima), and
    $\mu^{(a)}(J_\alpha)=\mu_a$ with $i(a)$ the largest index with $\nu_\alpha^{(i)}=\mu_a$
    for $\alpha\ge\alpha(a)$, so that \cref{lem:III.15} and \cref{lem:III.16} apply. The
    isomorphisms $\sigma(\alpha)$ are isomorphisms of graded $k$-algebras (compatible with the
    structure maps of the canonical local homomorphisms), and
    $\lambda(\alpha)\colon\operatorname{gr}_{M_\alpha}(R_\alpha)\to k[X_1,\dots,X_n]$
    ($\alpha\ge\alpha(1)$) are isomorphisms of graded $k$-algebras
    ($k=R_{\alpha(1)}/M_{\alpha(1)}$), fixed by $\lambda(\alpha(1))$ and
    $\lambda(\alpha+1)=\lambda(\alpha)\circ\sigma(\alpha)^{-1}$, so that
    $\lambda(\alpha+1)\circ\sigma(\alpha)=\lambda(\alpha)$. The set $H_\mu$ is the image
    of the homogeneous part of degree $\mu$ of $\operatorname{gr}_{M_\alpha}(J_\alpha,R_\alpha)$,
    it does not depend on $\alpha\ge\alpha(a)$ for $\mu\le\mu_a$, and $I(a)$ is generated
    by these. ``Clearly $H_\mu$ is the homogeneous part of degree $\mu$ of $I(a)$'' is proved
    as follows: $I(a)$ lies in the ideal
    $\lambda(\alpha)(\operatorname{gr}_{M_\alpha}(J_\alpha,R_\alpha))$, whose homogeneous part
    of degree $\mu$ is $H_\mu$, since $\lambda(\alpha)$ is graded, and $H_\mu\subseteq I(a)$
    for $\mu\le\mu_a$. Then $\nu_\alpha^{(i(a)+1)}=\nu^{(i(a)+1)}=\mu_{a+1}$ and the key step
    of the strictness (``the homogeneous part of degree $\mu_{a+1}$ of $I(a+1)$ is not contained
    in $I(a)$'') is the existence of a homogeneous element of degree $\nu^{(i(a)+1)}_\alpha$ of
    $\operatorname{gr}_{M_\alpha}(J_\alpha,R_\alpha)$ outside the ideal generated by the
    elements of degrees $\le\mu_a$.

    \textbf{Remaining differences.} The residually rational case is proved for an abstract
    sequence satisfying the conclusions of \cref{thm:III.3}, \cref{lem:III.15} and
    \cref{lem:III.16}, which are then verified along the lifted sequence (where centers
    $P_\alpha=R_\alpha$, allowed by the convention of \cref{def:III.8}, are treated separately,
    and the separable closedness of the residue fields of all $R_\alpha'$ is carried along). The
    case ``the sequence $(\mu_1,\mu_2,\dots)$ is finite'' is dismissed in the print (``the proof
    will be completed if the sequence is finite''); it is proved here: by the count above each
    integer occurs finitely often among the $\nu^{(i)}$, so some $\nu^{(i_0)}=\infty$, and then
    $\nu^*_\alpha$ is constant from the stage at which $(\nu_\alpha^{(1)},\dots,\nu_\alpha^{(i_0)})$
    is stationary. The choice of $\lambda(\alpha)$ is the explicit one above. The stabilization of
    the $\tau^{(b)}$ is done after that of $\nu^*$, by \cref{lem:III.15} and the bound $n$. -/)
  (latexEnv := "theorem")]
theorem MonoidalSequence.exists_stationary [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (S : MonoidalSequence.{u})
    (hperm : S.IsPermissible) (hsep : S.IsResiduallySeparableAlgebraic) :
    ∃ α₀ : ℕ, 0 < α₀ ∧
      (∀ α, α₀ ≤ α → nuStar (S.ring α) (S.ideal α) = nuStar (S.ring α₀) (S.ideal α₀)) ∧
      (∀ α, α₀ ≤ α → t (S.ring α) (S.ideal α) = t (S.ring α₀) (S.ideal α₀)) ∧
      ∀ α, α₀ ≤ α → ∀ i, 1 ≤ i → i ≤ t (S.ring α₀) (S.ideal α₀) →
        tau (S.ring α) (S.ideal α) i = tau (S.ring α₀) (S.ideal α₀) i := by
  -- a local extension `R → R'` with separably closed residue field (proof of Theorem 3), and the
  -- lifted sequence `R_α'` of canonical monoidal transforms (Lemma 4, Corollary to Lemma 5)
  obtain ⟨R', _, _, α, _, hα, hsepα, hsc⟩ := exists_maximal_local_extension (S.ring 0)
  have _ : IsDomain R' := Transforms.isDomain_of_isRegularLocalRing R'
  let D₀ : MonoidalSequence.LiftStage S 0 := { R := R', α := α, maps := hα, sep := hsepα, sc := hsc }
  let D := MonoidalSequence.liftSeq S hperm hsep D₀
  -- `dim R_α' = dim R'` for all `α`
  have hdim : ∀ n, ringKrullDim (D n).R = ringKrullDim R' := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih => exact (MonoidalSequence.LiftStage.ringKrullDim_transform_eq S hperm hsep (D n)).trans ih
  -- `n = dim R_α = dim R`, the number of generators of the maximal ideals
  obtain ⟨-, s₀, hs₀⟩ := (isRegularLocalRing_iff_exists_rsop (R := R')).mp inferInstance
  have hd : ∀ n, (maximalIdeal (D n).R).spanFinrank = s₀.card := by
    intro n
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := (D n).R)
    rw [hdim n, ← hs₀.2] at h1
    exact_mod_cast h1
  -- the residually rational case (Theorem 3, Lemmas 15 and 16 along the lifted sequence)
  obtain ⟨N, hN⟩ := exists_nuStar_stationary_of_isResiduallyRational (fun n => (D n).R)
    (fun n => (S.ideal n).map (D n).α) (fun n => (MonoidalSequence.LiftStage.transform S (D n)).toRing)
    (fun n => MonoidalSequence.LiftStage.nuStar_next_le S hperm hsep (D n))
    (fun n => MonoidalSequence.LiftStage.tau_le_tau_next S hperm hsep (D n)) (fun n => MonoidalSequence.LiftStage.exists_gradedRingEquiv_next S hperm hsep (D n))
    s₀.card hd
  obtain ⟨α₀, hα₀, h1, h2, h3⟩ := exists_stationary_of_nuStar_stationary (fun n => (D n).R)
    (fun n => (S.ideal n).map (D n).α) (fun n => MonoidalSequence.LiftStage.tau_le_tau_next S hperm hsep (D n)) s₀.card hd N
    hN
  -- back to `R_α` (Remarks 1 and 2)
  have htr := fun n => MonoidalSequence.LiftStage.nuStar_eq_and_tau_eq_map S (D n)
  refine ⟨α₀, hα₀, fun β hβ => ?_, fun β hβ => ?_, fun β hβ i hi hit => ?_⟩
  · rw [(htr β).1, (htr α₀).1]
    exact h1 β hβ
  · rw [← (htr β).2.1, ← (htr α₀).2.1]
    exact h2 β hβ
  · have hit' : i ≤ t (S.ring β) (S.ideal β) := by
      rw [← (htr β).2.1, h2 β hβ, (htr α₀).2.1]
      exact hit
    rw [← (htr β).2.2 i hi hit', ← (htr α₀).2.2 i hi hit]
    exact h3 β hβ i hi (by rw [(htr α₀).2.1]; exact hit)

end Theorem4

/-! ### Proposition 1 (pp. 236–238) -/

section Proposition1

/-- A prime `Q₁` of `R₁` lying over `Q` is contained in the strict transform of `Q`: every
element of `R₁` is `x^{-N} f` times a unit, and then `f ∈ Q₁ ∩ R = Q`, `ν_P(f) ≥ N`. -/
theorem le_strictTransformIdeal_of_comap_le {R : Type u} [CommRing R] [IsRegularLocalRing R]
    [IsDomain R] {P : Ideal R} [P.IsPrime] [IsRegularLocalRing (R ⧸ P)]
    (T : MonoidalTransform R P) {Q : Ideal R} (Q₁ : Ideal T.ring)
    (hQ₁ : Q₁.comap T.toRing ≤ Q) : Q₁ ≤ strictTransformIdeal T Q := by
  intro g hg
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective T.M'.primeCompl g
  obtain ⟨N, hN⟩ := exists_pow_mul_eq_of_mem_blowupAlgebra T.x_ne_zero a.2
  obtain ⟨f, hf⟩ := hN N le_rfl
  have hB : (algebraMap R (blowupAlgebra R P T.x) T.x) ^ N * a =
      algebraMap R (blowupAlgebra R P T.x) f := by
    apply Subtype.ext
    simpa using hf
  have h1 : T.xR ^ N * algebraMap (blowupAlgebra R P T.x) T.ring a = T.toRing f := by
    have := congrArg (algebraMap (blowupAlgebra R P T.x) T.ring) hB
    rw [map_mul, map_pow] at this
    exact this
  have hga : IsLocalization.mk' T.ring a s * algebraMap (blowupAlgebra R P T.x) T.ring s =
      algebraMap (blowupAlgebra R P T.x) T.ring a := IsLocalization.mk'_spec T.ring a s
  have hs : IsUnit (algebraMap (blowupAlgebra R P T.x) T.ring s) :=
    IsLocalization.map_units T.ring s
  have hfQ : f ∈ Q := by
    refine hQ₁ (show T.toRing f ∈ Q₁ from ?_)
    rw [← h1, ← hga]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ hg)
  have hfP : f ∈ P ^ N := T.mem_pow_of_toRing_mem inferInstance inferInstance (by
    rw [← h1, Ideal.span_singleton_pow]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
  have hy : IsLocalization.mk' T.ring a s * algebraMap (blowupAlgebra R P T.x) T.ring s ∈
      strictTransformIdeal T Q :=
    Ideal.subset_span ⟨T.xR, T.span_xR_eq_map, f, hfQ, N, Ideal.le_ordElem hfP, by rw [hga, h1]⟩
  have : IsLocalization.mk' T.ring a s =
      IsLocalization.mk' T.ring a s * algebraMap (blowupAlgebra R P T.x) T.ring s *
        ↑hs.unit⁻¹ := by
    rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
  show IsLocalization.mk' T.ring a s ∈ _
  rw [this]
  exact Ideal.mul_mem_right _ _ hy

/-- Proposition 1, pp. 236–237: "Let `R` be a regular local ring, `P` and `Q` prime ideals in
`R`, and `J` an ideal in `R`. Suppose: (i) `P ⊇ Q ⊇ J` and `P ≠ Q`, (ii) `R/Q` is regular, and
(iii) `P` is a permissible center for `J`. Let `R₁` be a monoidal transform of `R` with center
`P` which is residually separable algebraic over `R`, and `J₁` the strict transform of `J` in
`R₁`. Let us assume that there exists a prime ideal `Q₁` in `R₁` such that `Q₁ ∩ R = Q`. If
`ν*(J₁) = ν*(J)` and `Q₁` is a permissible center for `J₁`, then `τ*(J₁) = τ*(J)`."

Encoding: "`Q₁ ∩ R = Q`" is `Q₁.comap T.toRing = Q`; the equality `τ*(J₁) = τ*(J)` of systems
is transcribed, as in Lemma 13, as `t(J₁) = t(J)` together with `τ^{(i)}(J₁) = τ^{(i)}(J)` for
`1 ≤ i ≤ t(J)`.

Correction of the paper (proof): the paper reduces to the residually rational case "as in the
proof of Theorem 3" without saying how the hypothesis on `Q₁` (a prime with `Q₁ ∩ R = Q`)
passes to `R₁'`.  Lean replaces `Q₁` by `Q₁ R₁'` (prime and permissible by Remark 1) and uses
only three properties which survive this base change: `Q R₁ ⊆ Q₁`, `P R₁ ⊄ Q₁`, and `Q₁` is
contained in the strict transform of `Q` (`le_strictTransformIdeal_of_comap_le`).

The residually rational case is `tauStar_strictTransform_eq_of_isResiduallyRational`, proved along the
printed route of pp. 237–238 (coordinates (1)–(3), normalisation of the `f_j`, elimination of the `λ_j`, and
the final step). -/
@[blueprint "prop:III.5-1"
  (statement := /-- Let $R$ be a regular local ring, $P$ and $Q$ prime ideals in $R$, and $J$
    an ideal in $R$. Suppose: (i) $P\supseteq Q\supseteq J$ and $P\ne Q$, (ii) $R/Q$ is
    regular, and (iii) $P$ is a permissible center for $J$ (\cref{def:III.8}). Let $R_1$ be a
    monoidal transform of $R$ with center $P$ (\cref{def:III.2-monoidal-transform}) which is
    residually separable algebraic over $R$ (\cref{def:III.2-residually}), and $J_1$ the
    strict transform of $J$ in $R_1$ (\cref{def:III.5-strict}). Let us assume that there
    exists a prime ideal $Q_1$ in $R_1$ such that $Q_1\cap R=Q$. If $\nu^*(J_1)=\nu^*(J)$ and
    $Q_1$ is a permissible center for $J_1$, then $\tau^*(J_1)=\tau^*(J)$
    (\cref{def:III.6-tau-star}). (Proposition 1, pp.~236--237.)

    (Formalization note (encoding): $\tau^*(J_1)=\tau^*(J)$ is transcribed, as in \cref{lem:III.13}, as
    $t(J_1)=t(J)$ together with $\tau^{(i)}(J_1)=\tau^{(i)}(J)$ for $1\le i\le t(J)$.) -/)
  (proof := /-- As in the proof of \cref{thm:III.3}, we may assume that $R_1$ is residually
    rational over $R$. Then, by the assumptions on $P$, $Q$ and $Q_1$, we have a regular
    system of parameters $(x,x_1,\dots,x_r,y_1,\dots,y_s)$ of $R$ such that
    (1) $P=(x,x_1,\dots,x_r)R$, (2) $Q\subseteq(x_1,\dots,x_r)R$, and
    (3) $(x,x_1/x,\dots,x_r/x,y_1,\dots,y_s)$ is a regular system of parameters of $R_1$, so
    that $Q_1\subseteq(x_1/x,\dots,x_r/x)R_1$. Let $\nu_j=\nu^{(j)}(J)=\nu^{(j)}(J_1)$. By
    \cref{lem:III.14}, the assumption $\nu^*(J_1)=\nu^*(J)$ implies that there is a standard
    base $(f_1,\dots,f_m)$ of $J$ such that (4) $\nu_P(f_j)=\nu_j$ for $1\le j\le m$,
    (5) $\nu_{M_1}(g_j)=\nu_j$ for $1\le j\le m$ (printed: $\nu_P(g_j)=\nu_j$, see below),
    where $g_j=f_jx^{-\nu_j}$, and
    (6) $(g_1,\dots,g_m)$ is a standard base of $J_1$. Identify $\operatorname{gr}_M(R)$ with
    $k[X,X_1,\dots,X_r,Y_1,\dots,Y_s]$ and $\operatorname{gr}_{M_1}(R_1)$ with
    $k[X,\bar X_1,\dots,\bar X_r,Y_1,\dots,Y_s]$ as in the proof of \cref{lem:III.14}, and let
    $\varphi_j$ (resp.\ $\psi_j$) be the initial form of $f_j$ (resp.\ $g_j$). Then, as is
    easily seen, the $\varphi_j$ are all forms only in $X_1,\dots,X_r$ by (4) and (5). Therefore, applying first a
    suitable linear transformation to $(x_1,\dots,x_r)$ with coefficients in $R$, we may
    assume that $(x_1,\dots,x_{\tau_a})$ is a regular system of $a$-th $\tau$-parameters of
    $R$ for $J$ (\cref{def:III.7}), where $\tau_a=\tau^{(a)}(J)$ for $1\le a\le t(J)$. Then,
    replacing each $f_j$ by $f_j-\sum_{i=1}^{j-1}p_{ji}f_i$ with suitable
    $p_{ji}\in(x_1,\dots,x_r)^{\nu_j-\nu_i}R$, we may assume that $\varphi_j$ is a form only
    in $X_1,\dots,X_{\tau_a}$ for every $(j,a)$ such that $\nu_j\le\mu^{(a)}(J)$. As in the
    proof of \cref{lem:III.14}, writing $\varphi_j=\varphi_j(X_1,\dots,X_{\tau_a})$ with
    $\nu_j=\mu^{(a)}(J)$, we can express $\psi_j$ in the form
    $\psi_j=\varphi_j(\bar X_1,\dots,\bar X_{\tau_a})+\lambda_j$, where $\lambda_j$ is a form
    of degree $\nu_j$ contained in $(X,Y_1,\dots,Y_s)k[X,\bar X_1,\dots,\bar X_r,Y_1,\dots,
    Y_s]$. Proposition~1
    follows if $\lambda_j=0$ for all $j$ ($1\le j\le m$).

    Suppose we have $j$ with $\lambda_i=0$ for $1\le i<j$ and $\lambda_j\ne0$. The assumption
    that $Q_1$ is a permissible center for $J_1$ implies (by \cref{lem:III.8-equivalents})
    that there exist forms $\delta_{ji}$ of degree $\nu_j-\nu_i$ in
    $(X,Y_1,\dots,Y_s)\operatorname{gr}_{M_1}(R_1)$, with $\delta_{ji}=0$ for those $i$ with
    $\nu_j-\nu_i=0$, such that $\psi_j-\sum_{i=1}^{j-1}\delta_{ji}\psi_i
    =\psi_j-\sum_{i=1}^{j-1}\delta_{ji}\varphi_i(\bar X_1,\dots,\bar X_{\tau_a})$ is a form
    only in $\bar X_1,\dots,\bar X_r$. In view of the expression
    $\psi_j=\varphi_j(\bar X_1,\dots,\bar X_r)+\lambda_j$, we see that
    $\lambda_j=\sum_{i=1}^{j-1}\delta_{ji}\varphi_i(\bar X_1,\dots,\bar X_{\tau_a})$. For each $\delta_{ji}\ne0$
    take a form $h_{ji}$ of degree $\nu_j-\nu_i$ in $x,x_1/x,\dots,x_r/x,y_1,\dots,y_s$ with
    coefficients in $R$ whose initial form in $\operatorname{gr}_{M_1}(R_1)$ is $\delta_{ji}$,
    and set $h_{ji}=0$ if $\delta_{ji}=0$. Then $x^{\nu_j-\nu_i}h_{ji}\in P^{\nu_j-\nu_i}$ for
    all $i<j$ (printed: ``for all $i$ ($1\le i\le j$)''), and we may replace $f_j$ by
    $f_j-\sum_{i<j}(x^{\nu_j-\nu_i}h_{ji})f_i$ (printed with $f_j$ as the last factor) without
    affecting the assumptions (4), (5) and (6). After this replacement $\lambda_i=0$ for all
    $i$ with $1\le i\le j$. Repeating this process at most $m$ times, we obtain
    $(f_1,\dots,f_m)$ with $\lambda_j=0$ for all $j$ ($1\le j\le m$). (This is the paper's
    proof.)

    \textbf{Paper misprint.} In (5) the paper prints ``$\nu_P(g_j)=\nu_j$''; since $g_j\in R_1$,
    what is meant is $\nu_{M_1}(g_j)=\nu_j$, as in (iii) of \cref{lem:III.14}. On p.~238 the
    replacement is printed ``$f_j-\sum_{i=1}^{j-1}(x^{\nu_j-\nu_i}h_{ji})f_j$''; the last factor
    must be $f_i$. Also ``for all $i$ $(1\le i\le j)$'' should read $1\le i<j$.

    \textbf{Correction of the paper (proof).} ``As in the proof of Theorem~3, we may assume that
    $R_1$ is residually rational over $R$'': the paper does not say how the hypothesis on
    $Q_1$ ($Q_1$ prime, $Q_1\cap R=Q$, $Q_1$ permissible for $J_1$) passes to $R_1'$. In Lean,
    $Q_1$ is replaced by $Q_1R_1'$, which is prime and permissible for $J_1'$ by
    \cref{rem:III.5-1}; instead of $Q_1'\cap R'=QR'$, only three properties are transferred
    and used in the residually rational case: $QR_1\subseteq Q_1$, $PR_1\not\subseteq Q_1$ and
    $Q_1\subseteq$ the strict transform of $Q$ (these follow from $Q_1\cap R=Q$ and $P\ne Q$:
    an element of $Q_1$ is a unit times $x^{-N}f$ with $f\in Q_1\cap R=Q$ and
    $\nu_P(f)\ge N$).

    \textbf{Formalization (the route as printed).} In the residually rational case the proof follows
    pp.~237--238 step by step. The coordinates (1)--(3) are obtained from any coordinates adapted to $R_1$ by
    a change $x_i\mapsto\sum a_{ik}x_k+b_ix$ ($a$ invertible, $b_i\in M$), the generators of $Q$ being
    among the new $x_i$; then $Q_1\subseteq(x_1/x,\dots,x_r/x)R_1$ (the paper states this ``so that'' without
    argument). The linear transformation of $(x_1,\dots,x_r)$ gives that $T_b$ is generated by the classes
    $X_1,\dots,X_{\tau_b}$ for all $b\le t(J)$. The $f_j$ are replaced one after the other by
    $f_j-\sum p_{ji}f_i$ so that $\varphi_j\in k[X_1,\dots,X_{\tau_b}]$ ($\mu^{(b)}(J)=\nu_j$): the
    decomposition $\varphi_j=\varphi_j'+\sum\delta_{ji}\varphi_i$ with $\varphi_j'\in k[T_b]$ and the
    lifts $p_{ji}$ of the $\delta_{ji}$ are proved (the paper only says ``we may assume''). The
    elimination of the $\lambda_j$ is as printed: the forms $\delta_{ji}\in(X,Y_1,\dots,Y_s)
    \operatorname{gr}_{M_1}(R_1)$ exist because $\operatorname{gr}_{M_1}(J_1,R_1)$ is generated by forms in
    $\bar X_1,\dots,\bar X_r$ (the initial forms of a standard base of $J_1$ lying in
    $Q_1^{\nu}\subseteq(x_1/x,\dots,x_r/x)^{\nu}$), the $h_{ji}$ are lifts with
    $x^{\nu_j-\nu_i}h_{ji}\in P^{\nu_j-\nu_i}$ (and of order $>\nu_j-\nu_i$ in $M$, so the $\varphi_j$ do
    not change), and the replacements keep (4), (5), (6). Finally, the step ``Proposition~1 follows if
    $\lambda_j=0$ for all $j$'' is proved: then $\psi_j\in k[\bar X_1,\dots,\bar X_{\tau_b}]$, so the
    $k$-module generated by $\bar X_1,\dots,\bar X_{\tau_a}$ has the property of Definition~6 for $J_1$,
    whence $\tau^{(a)}(J_1)\le\tau^{(a)}(J)$; the reverse inequality is \cref{lem:III.15}. -/)
  (latexEnv := "proposition")]
theorem tauStar_strictTransform_eq [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R]
    (P Q J : Ideal R) [P.IsPrime] [Q.IsPrime] (hQP : Q ≤ P) (hJQ : J ≤ Q) (hPQ : P ≠ Q)
    [IsRegularLocalRing (R ⧸ Q)] (hperm : IsPermissibleCenter R J P)
    (T : MonoidalTransform R P) [IsRegularLocalRing T.ring]
    (hsep : RingHom.IsResiduallySeparableAlgebraic (R := R) (R' := T.ring) T.toRing)
    (Q₁ : Ideal T.ring) [Q₁.IsPrime] (hQ₁ : Q₁.comap T.toRing = Q)
    (hnu : nuStar T.ring (strictTransformIdeal T J) = nuStar R J)
    (hperm₁ : IsPermissibleCenter T.ring (strictTransformIdeal T J) Q₁) :
    t T.ring (strictTransformIdeal T J) = t R J ∧
      ∀ i, 1 ≤ i → i ≤ t R J →
        tau T.ring (strictTransformIdeal T J) i = tau R J i := by
  have hP : P.IsPrime := inferInstance
  obtain ⟨-, -, hS, -⟩ := hperm.resolve_left hP.ne_top
  have _ : IsRegularLocalRing (R ⧸ P) := hS
  have hJP : J ≤ P := hJQ.trans hQP
  -- the properties of `Q₁` used in the residually rational case
  have hQQ₁ : Q.map T.toRing ≤ Q₁ := Ideal.map_le_iff_le_comap.mpr hQ₁.ge
  have hPQ₁ : ¬ P.map T.toRing ≤ Q₁ := fun h =>
    hPQ (le_antisymm (hQ₁ ▸ Ideal.map_le_iff_le_comap.mp h) hQP)
  have hQ₁s : Q₁ ≤ strictTransformIdeal T Q := le_strictTransformIdeal_of_comap_le T Q₁ hQ₁.le
  -- the reduction to the residually rational case, as in the proof of Theorem 3
  obtain ⟨R', _, _, α, _, hα, hsepα, hsc⟩ := exists_maximal_local_extension R
  have _ : IsDomain R' := Transforms.isDomain_of_isRegularLocalRing R'
  obtain ⟨⟨hP', hS'⟩, -, h2, h3⟩ := RingHom.MapsRSOP.canonicalLift_properties α hα hP hS
  have _ : (P.map α).IsPrime := hP'
  have _ : IsRegularLocalRing (R' ⧸ P.map α) := hS'
  obtain ⟨⟨hQ', hSQ'⟩, -⟩ := RingHom.MapsRSOP.canonicalLift_properties α hα (inferInstance : Q.IsPrime) inferInstance
  have _ : (Q.map α).IsPrime := hQ'
  have _ : IsRegularLocalRing (R' ⧸ Q.map α) := hSQ'
  obtain ⟨T', β, hcan⟩ := T.exists_isCanonicalLift_of_isRegular α hα hP hS
  have _ : IsLocalHom β := hcan.isLocalHom
  have hP'0 : P.map α ≠ ⊥ := fun h => T'.x_ne_zero (Ideal.mem_bot.mp (h.le T'.x_mem))
  have _ : IsRegularLocalRing T'.ring := (MonoidalTransform.isRegularLocalRing_and_isLocalHom_and_span_xR_eq_map T' hP' hP'0 hS').1
  have hsepT' : RingHom.IsResiduallySeparableAlgebraic (R := R') (R' := T'.ring) T'.toRing :=
    isResiduallySeparableAlgebraic_of_closure_eq_top T.toRing α β T'.toRing hcan.comm.symm hsep
      (by rw [Set.union_comm]; exact (h2 T T' β hcan).2.2.2.2)
  have hrat' : RingHom.IsResiduallyRational (R := R') (R' := T'.ring) T'.toRing := by
    let _ : Algebra (ResidueField R') (ResidueField T'.ring) :=
      (ResidueField.map T'.toRing).toAlgebra
    have _ : Algebra.IsSeparable (ResidueField R') (ResidueField T'.ring) := hsepT'
    exact IsSepClosed.algebraMap_surjective (ResidueField R') (ResidueField T'.ring)
  have hperm' := (isPermissibleCenter_map_iff α hα J P hJP).2.2.2.mp hperm
  obtain ⟨hJ₁', hrem⟩ := strictTransform_map_of_mapsRSOP α hα J P hJP T T' β hcan.comm
  obtain ⟨hν, hν₁, ⟨ht, hτ⟩, ⟨ht₁, hτ₁⟩⟩ := hrem hsepα
  -- `R₁ → R₁'` transforms a regular system of parameters into one (Lemma 4)
  have hβrsop : RingHom.MapsRSOP β := by
    obtain ⟨-, s, hs⟩ := (isRegularLocalRing_iff_exists_rsop T.ring).mp inferInstance
    exact ⟨s, hs, (h3 T T' β hcan).2 hsepα s hs, (h2 T T' β hcan).2.2.2.1.injOn⟩
  -- `Q₁' = Q₁ R₁'` (Remark 1 for `R₁ → R₁'`)
  obtain ⟨-, hJ₁Q₁, -, -⟩ := hperm₁.resolve_left (Ideal.IsPrime.ne_top inferInstance)
  have hRem1 := isPermissibleCenter_map_iff β hβrsop (strictTransformIdeal T J) Q₁ hJ₁Q₁
  have hperm₁' := hRem1.2.2.2.mp hperm₁
  rw [← hJ₁'] at hperm₁'
  have hQ₁'top : Q₁.map β ≠ ⊤ := by
    intro htop
    have h1 : Q₁.map β ≤ maximalIdeal T'.ring :=
      (Ideal.map_mono (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance))).trans
        (map_maximalIdeal_le β)
    exact (maximalIdeal.isMaximal T'.ring).ne_top (top_le_iff.mp (htop ▸ h1))
  have _ : (Q₁.map β).IsPrime := (hperm₁'.resolve_left hQ₁'top).1
  have hQQ₁' : (Q.map α).map T'.toRing ≤ Q₁.map β := by
    rw [Ideal.map_map, ← hcan.comm, ← Ideal.map_map]
    exact Ideal.map_mono hQQ₁
  have hPQ₁' : ¬ (P.map α).map T'.toRing ≤ Q₁.map β := by
    intro h
    apply hPQ₁
    rw [Ideal.map_map, ← hcan.comm, ← Ideal.map_map] at h
    let _ : Algebra T.ring T'.ring := β.toAlgebra
    have _ : Module.FaithfullyFlat T.ring T'.ring := hRem1.1
    calc P.map T.toRing ≤ ((P.map T.toRing).map β).comap β := Ideal.le_comap_map
      _ ≤ (Q₁.map β).comap β := Ideal.comap_mono h
      _ = Q₁ := Ideal.comap_map_eq_self_of_faithfullyFlat (B := T'.ring) Q₁
  have hQ₁s' : Q₁.map β ≤ strictTransformIdeal T' (Q.map α) := by
    rw [(strictTransform_map_of_mapsRSOP α hα Q P hQP T T' β hcan.comm).1]
    exact Ideal.map_mono hQ₁s
  have hnu' : nuStar T'.ring (strictTransformIdeal T' (J.map α)) = nuStar R' (J.map α) := by
    rw [← hν, ← hnu]
    simp only [nuStar]
    exact congrArg toLex (funext fun i => (hν₁ i).symm)
  obtain ⟨kt, kτ⟩ := tauStar_strictTransform_eq_of_isResiduallyRational R' (P.map α) (Q.map α) (J.map α) (Ideal.map_mono hQP)
    (Ideal.map_mono hJQ) hperm' T' hrat' (Q₁.map β) hQQ₁' hPQ₁' hQ₁s' hnu' hperm₁'
  have htt : t T.ring (strictTransformIdeal T J) = t R J := ht₁.symm.trans (kt.trans ht)
  refine ⟨htt, fun i hi hit => ?_⟩
  rw [← hτ i hi hit, ← hτ₁ i hi (by rw [htt]; exact hit)]
  exact kτ i hi (by rw [ht]; exact hit)

end Proposition1

end Hironaka

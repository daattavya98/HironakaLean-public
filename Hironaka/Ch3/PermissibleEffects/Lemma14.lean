/-! ### The equivalent forms (ii)*, (ii)** of Definition 8 (p. 226) -/

section Definition8

/-- A non-zero initial form which is homogeneous of degree `d` has `ν_I(a) = d`. -/
private theorem ordElem_eq_of_initialForm_mem_homogeneous {A : Type*} [CommRing A]
    (I : Ideal A) {a : A} {d : ℕ} (hd : initialForm I a ∈ AssocGraded.homogeneous I d)
    (h0 : initialForm I a ≠ 0) : Ideal.ordElem I a = d := by
  by_cases htop : Ideal.ordElem I a = ⊤
  · exact absurd (by rw [initialForm, dite_eq_left htop]) h0
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
  rw [← hn]
  by_contra hnd
  have hnd' : n ≠ d := fun h => hnd (by rw [h])
  apply h0
  obtain ⟨y, hy⟩ := LinearMap.mem_range.mp hd
  have h1 : grProj I d (initialForm I a) = y := by rw [← hy, grProj_ofGrPiece_same]
  have h2 : grProj I d (initialForm I a) = 0 := by
    rw [initialForm_eq_mk I hn.symm, grProj_mk_ne I hnd']
  rw [← hy, ← h1, h2, map_zero]

/-- The initial form of `a` is homogeneous of degree `ν_I(a)` (read in `ℕ`, `∞ ↦ 0`). -/
private theorem Ideal.initialForm_mem_homogeneous_toNat {A : Type*} [CommRing A] (I : Ideal A)
    (a : A) : initialForm I a ∈ AssocGraded.homogeneous I (Ideal.ordElem I a).toNat := by
  by_cases htop : Ideal.ordElem I a = ⊤
  · rw [initialForm, dite_eq_left htop]
    exact zero_mem _
  · rw [initialForm_eq_mk I (ENat.natCast_toNat htop).symm]
    exact AssocGraded.mk_mem_homogeneous I _

/-- For a standard base `(f₁, …, f_m)` of `J`, `ν_M(f_j) = ν^{(j)}(J)` (Lemma 1). -/
private theorem ordElem_eq_nuI_of_isStandardBase_explicit (R : Type u) [CommRing R]
    [IsRegularLocalRing R] (J : Ideal R) {m : ℕ} (f : Fin m → R) (hf : IsStandardBase R J f)
    (j : Fin m) : Ideal.ordElem (maximalIdeal R) (f j) = nuI R J (j : ℕ).succPNat := by
  obtain ⟨-, hJφ, ⟨d, hd, hmono⟩, hspan, hnot⟩ := hf
  have h := (nuI_eq_of_lemma1_properties R J _ hJφ d hd hspan hmono hnot).1 j
  have h0 : initialForm (maximalIdeal R) (f j) ≠ 0 := fun h0 => hnot j (by
    dsimp only; rw [h0]; exact zero_mem _)
  rw [ordElem_eq_of_initialForm_mem_homogeneous _ (hd j) h0, ← h]
  rfl

/-- A system of elements of `J` whose initial forms generate `gr_M(J, R)` contains a standard
base of `J`: sort the elements by order and discard those whose initial form lies in the ideal
generated by the initial forms of the preceding ones (the proof of Lemma 1's existence
statement). -/
private theorem exists_isStandardBase_comp (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (J : Ideal R) {n : ℕ} (f : Fin n → R) (hfJ : ∀ i, f i ∈ J)
    (hgen : Ideal.span (Set.range fun i => initialForm (maximalIdeal R) (f i)) =
      grIdeal (maximalIdeal R) J) :
    ∃ (m : ℕ) (σ : Fin m → Fin n), IsStandardBase R J (f ∘ σ) := by
  classical
  let e : Fin n → ℕ := fun i => (Ideal.ordElem (maximalIdeal R) (f i)).toNat
  let φ : Fin n → AssocGraded (maximalIdeal R) := fun i => initialForm (maximalIdeal R) (f i)
  let g' := φ ∘ Tuple.sort e
  let e' := e ∘ Tuple.sort e
  have he' : Monotone e' := Tuple.monotone_sort e
  have hspan' : grIdeal (maximalIdeal R) J = Ideal.span (Set.range g') := by
    rw [← hgen, Set.range_comp, (Tuple.sort e).surjective.range_eq, Set.image_univ]
  let S : Finset (Fin n) := Finset.univ.filter fun i =>
    g' i ∉ Ideal.span (Set.range fun j : Fin i => g' (Fin.castLE i.2.le j))
  let emb := S.orderEmbOfFin rfl
  refine ⟨S.card, fun k => Tuple.sort e (emb k), fun k => hfJ _,
    fun k => Ideal.subset_span ⟨_, hfJ _, rfl⟩,
    ⟨fun k => e' (emb k), fun k => Ideal.initialForm_mem_homogeneous_toNat _ _,
      he'.comp emb.monotone⟩, ?_, ?_⟩
  · rw [hspan']
    refine le_antisymm ?_ (Ideal.span_le.mpr ?_)
    · have key : ∀ N : ℕ, ∀ i : Fin n, (i : ℕ) < N →
          g' i ∈ Ideal.span (Set.range fun k => g' (emb k)) := by
        intro N
        induction N with
        | zero => intro i hi; omega
        | succ N ih =>
          intro i hi
          by_cases hiS : i ∈ S
          · have : i ∈ Set.range emb := by rw [Finset.range_orderEmbOfFin]; exact hiS
            obtain ⟨k, rfl⟩ := this
            exact Ideal.subset_span ⟨k, rfl⟩
          · have hmem : g' i ∈
                Ideal.span (Set.range fun j : Fin i => g' (Fin.castLE i.2.le j)) := by
              simpa [S] using hiS
            refine (Ideal.span_le.mpr ?_) hmem
            rintro _ ⟨j, rfl⟩
            exact ih _ (by simp only [Fin.val_castLE]; omega)
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      exact key n i i.2
    · rintro _ ⟨k, rfl⟩
      exact Ideal.subset_span ⟨_, rfl⟩
  · intro k hk
    have hkS : emb k ∈ S := S.orderEmbOfFin_mem rfl k
    rw [Finset.mem_filter] at hkS
    apply hkS.2
    refine (Ideal.span_mono ?_) hk
    rintro _ ⟨j, rfl⟩
    have hlt : emb (Fin.castLE k.2.le j) < emb k :=
      emb.strictMono (show Fin.castLE k.2.le j < k from Fin.lt_def.mpr (by simp))
    exact ⟨⟨(emb (Fin.castLE k.2.le j) : ℕ), hlt⟩, by simp [g', φ]⟩

/-- p. 226, immediately after Definition 8: "The condition (ii) is proved equivalent to
(ii)* there exists a system of elements `(f₁, …, f_m)` of `J` such that `ν_M(f_j) = ν_P(f_j)`
for all `j`, and the initial forms of the `f_j` in `gr_M(R)` generate the ideal `gr_M(J, R)`,
and equivalent to (ii)** there exists a standard base `(f₁, …, f_m)` of `J` such that
`ν_P(f_j) = ν^{(j)}(J)` for all `j`.  (See Cor. 1 of Th. 2, §2, Ch. II.)"

Condition (ii) is `IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J))`, i.e. condition (ii)
of Definition 8 (`def:III.8`); condition (ii)* is `HasInitialFormSystem J P (maximalIdeal R)`
(`def:II.2-initial-form-system`, whose defining conditions are literally
`ν_M(f_j) = ν_P(f_j)` and `gr_M(J, R) = (φ₁, …, φ_m) gr_M(R)`).

Context of the statement (as printed): the paper states the equivalences in the context of
Definition 8, i.e. for a prime ideal `P` satisfying condition (i) (`J ≤ P`, `R/P` regular); these are the
hypotheses `[P.IsPrime]`, `hJP`, `[IsRegularLocalRing (R ⧸ P)]`.  The sentence "For the sake of
convenience, we agree that `P = R` is a permissible center for every ideal `J` in `R`" is a separate
convention on the definition of "permissible center"; it is carried by `IsPermissibleCenter`
(`P = ⊤ ∨ …`, `Hironaka/Ch3/Basic.lean`) and does not concern the equivalences (for `P = R`, which is not
prime, `ν_P` in (ii)*, (ii)** is not defined and (i) fails).  The equivalence (ii)* ⇔ (ii)**, for which
the paper only refers to Cor. 1 of Th. 2 (which concerns (ii) ⇔ (ii)*), is proved here by extracting a
standard base from the system (gap filled). -/
@[blueprint "lem:III.8-equivalents"
  (statement := /-- Let $R$ be a regular local ring with maximal ideal $M$, $J$ an ideal in
    $R$, and $P$ a prime ideal in $R$ such that $P\supseteq J$ and $R/P$ is regular. Then
    condition (ii) of \cref{def:III.8} is equivalent to each of the following:
    (ii)$^*$ there exists a system of elements $(f_1,\dots,f_m)$ of $J$ such that
    $\nu_M(f_j)=\nu_P(f_j)$ for all $j$, and the initial forms of the $f_j$ in
    $\operatorname{gr}_M(R)$ generate the ideal $\operatorname{gr}_M(J,R)$
    (\cref{def:II.2-initial-form-system});
    (ii)$^{**}$ there exists a standard base $(f_1,\dots,f_m)$ of $J$ (\cref{def:III.3}) such
    that $\nu_P(f_j)=\nu^{(j)}(J)$ for all $j$ (\cref{def:III.1}). (p.~226.)

    \textbf{Context of the statement (as printed).} The paper states the equivalences in the
    context of Definition~8, i.e.\ for a prime ideal $P$ satisfying its condition (i); here
    $P\supseteq J$, the regularity of $R/P$ and the primality of $P$ are the hypotheses. The
    sentence ``we agree that $P=R$ is a permissible center for every ideal $J$'' is a separate
    convention on the definition (\cref{def:III.8}) and does not concern the equivalences. -/)
  (proof := /-- The paper says only ``(See Cor.~1 of Th.~2, \S2, Ch.~II.)''. Corollary 1 of
    Theorem 2, \S2, Ch.~II (\cref{cor:II.2-thm2-1}): for
    $Q=M$ the maximal ideal of $R$, normal flatness of $O=R/J$ along $\bar P=P/J$ is
    equivalent to the existence of a system of elements of $J$ whose orders at $P$ and at $M$
    agree and whose initial forms in $\operatorname{gr}_M(R)$ generate
    $\operatorname{gr}_M(J,R)$, which is (ii)$^*$. For (ii)$^{**}$: given such a system, the
    system of its initial forms can be refined to one having the properties (i), (ii), (iii)
    of Lemma~1 (\cref{lem:III.1}), i.e.\ to a standard base of $J$ whose degrees are the
    $\nu^{(j)}(J)$ (\cref{cor:III.lem3}), the orders at $P$ and at $M$ still agreeing;
    conversely a standard base as in (ii)$^{**}$ is a system as in (ii)$^*$ since
    $\nu_P(f_j)\le\nu_M(f_j)=\nu^{(j)}(J)=\nu_P(f_j)$. (The refinement step for
    (ii)$^{**}$ is not in the cited corollary; it is supplied here: sort the system by order and
    discard every element whose initial form lies in the ideal generated by the initial forms
    of the preceding ones, as in the existence part of Lemma~1.) -/)
  (latexEnv := "lemma")]
theorem isPermissibleCenter_tfae (R : Type u) [CommRing R] [IsRegularLocalRing R] (J P : Ideal R)
    [P.IsPrime] (hJP : J ≤ P) [IsRegularLocalRing (R ⧸ P)] :
    [IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)),
      HasInitialFormSystem J P (maximalIdeal R),
      ∃ (m : ℕ) (f : Fin m → R), IsStandardBase R J f ∧
        ∀ j : Fin m, Ideal.ordElem P (f j) = nuI R J ((j : ℕ).succPNat)].TFAE := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  have hcor := isNormallyFlatAlongIdeal_tfae_of_eq_maximalIdeal J P (maximalIdeal R) hJP rfl
  tfae_have 1 ↔ 2 := hcor.out 1 2
  tfae_have 3 → 2 := by
    rintro ⟨m, f, hf, hP⟩
    refine ⟨m, f, hf.1, fun j => ?_, hf.2.2.2.1.symm⟩
    rw [ordElem_eq_nuI_of_isStandardBase_explicit R J f hf j, hP j]
  tfae_have 2 → 3 := by
    rintro ⟨n, f, hfJ, hord, hgen⟩
    obtain ⟨m, σ, hσ⟩ := exists_isStandardBase_comp R J f hfJ hgen
    refine ⟨m, f ∘ σ, hσ, fun j => ?_⟩
    rw [← ordElem_eq_nuI_of_isStandardBase_explicit R J _ hσ j]
    exact (hord (σ j)).symm
  tfae_finish

end Definition8

/-! ### "Can be extended to a standard base" (Lemma 14 (iv), p. 227) -/

/- The predicate "`(g₁, …, g_i)` can be extended to a standard base of `J`" used in
Lemma 14 (iv), Lemma 15 (iv) and Lemma 16 (iv) (pp. 227, 230, 232) is `ExtendsToStandardBase`
of `Hironaka/Ch3/Frames.lean` (label `def:III.7-extends-standard-base`): the system is an
initial segment of a standard base, as the paper's word "extended" requires (the members of a
standard base are listed in non-decreasing order of their orders, Lemma 1 (ii)). -/

/-! ### Remark 1 (p. 226) -/

section Remark1

/-- A local homomorphism transforming a regular system of parameters into one maps the maximal
ideal onto the maximal ideal: `M R' = M'`. -/
theorem map_maximalIdeal_of_mapsRSOP {R R' : Type u} [CommRing R] [CommRing R']
    [IsLocalRing R] [IsLocalRing R'] (α : R →+* R') (hα : RingHom.MapsRSOP α) :
    (maximalIdeal R).map α = maximalIdeal R' := by
  classical
  obtain ⟨s, hs, hs', -⟩ := hα
  rw [← hs.1, Ideal.map_span, ← hs'.1, Finset.coe_image]

open scoped TensorProduct in
/-- For a flat `A`-algebra `B` and an ideal `I` of `A`, `B ⊗_A I ≅ IB`. -/
private theorem nonempty_tensorProduct_equiv_map {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B] (I : Ideal A) :
    Nonempty (B ⊗[A] I ≃ₗ[B] I.map (algebraMap A B)) := by
  -- `b ⊗ a ↦ b · a`
  let μ₀ : B ⊗[A] I →ₗ[B] B :=
    (TensorProduct.AlgebraTensorModule.rid A B B).toLinearMap ∘ₗ
      TensorProduct.AlgebraTensorModule.lTensor B B I.subtype
  have hμ₀ : ∀ z, μ₀ z ∈ I.map (algebraMap A B) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul b a =>
      simp only [μ₀, LinearMap.coe_comp, Function.comp_apply,
        TensorProduct.AlgebraTensorModule.lTensor_tmul, Submodule.subtype_apply,
        LinearEquiv.coe_coe, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ a.2)
    | add x y hx hy => rw [map_add]; exact add_mem hx hy
  let μ : B ⊗[A] I →ₗ[B] I.map (algebraMap A B) := μ₀.codRestrict _ hμ₀
  have hinj : Function.Injective μ := by
    intro z w hzw
    have h := congrArg Subtype.val hzw
    simp only [μ, LinearMap.codRestrict_apply] at h
    exact (Module.Flat.lTensor_preserves_injective_linearMap (M := B) I.subtype
      Subtype.val_injective) ((TensorProduct.AlgebraTensorModule.rid A B B).injective h)
  have hsurj' : ∀ y ∈ Ideal.span (algebraMap A B '' (I : Set A)), ∃ z, μ₀ z = y := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨a, ha, rfl⟩ := hy
      exact ⟨(1 : B) ⊗ₜ[A] (⟨a, ha⟩ : I), by simp [μ₀, Algebra.smul_def]⟩
    | zero => exact ⟨0, map_zero _⟩
    | add y z _ _ ihy ihz =>
      obtain ⟨u, hu⟩ := ihy
      obtain ⟨v, hv⟩ := ihz
      exact ⟨u + v, by rw [map_add, hu, hv]⟩
    | smul b y _ ihy =>
      obtain ⟨u, hu⟩ := ihy
      exact ⟨b • u, by rw [map_smul, hu, smul_eq_mul]⟩
  have hsurj : Function.Surjective μ := by
    rintro ⟨y, hy⟩
    obtain ⟨z, hz⟩ := hsurj' y hy
    exact ⟨z, Subtype.ext hz⟩
  exact ⟨LinearEquiv.ofBijective μ ⟨hinj, hsurj⟩⟩

open scoped TensorProduct in
/-- For a flat local homomorphism `A → B` with `m_A B = m_B`, the maximal ideals need the same
number of generators (`m_B ≅ B ⊗_A m_A`). -/
private theorem spanFinrank_maximalIdeal_eq_of_flat {A B : Type u} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsNoetherianRing A] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B]
    [Module.Flat A B] [IsLocalHom (algebraMap A B)]
    (hmax : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B) :
    (maximalIdeal A).spanFinrank = (maximalIdeal B).spanFinrank := by
  obtain ⟨e⟩ := nonempty_tensorProduct_equiv_map (B := B) (maximalIdeal A)
  let e' : B ⊗[A] (maximalIdeal A) ≃ₗ[B] maximalIdeal B := e.trans (LinearEquiv.ofEq _ _ hmax)
  have hA := TensorProduct.spanFinrank_top_eq_of_residueField (maximalIdeal A)
    (maximalIdeal A).fg_of_isNoetherianRing
  have hB := TensorProduct.spanFinrank_top_eq_of_residueField (maximalIdeal B)
    (maximalIdeal B).fg_of_isNoetherianRing
  have hA' : (maximalIdeal A).spanFinrank =
      Module.finrank (ResidueField A) (ResidueField A ⊗[A] maximalIdeal A) := by
    rw [Module.finrank_eq_spanFinrank_of_free (R := ResidueField A)]
    exact hA.symm
  have hB' : (maximalIdeal B).spanFinrank =
      Module.finrank (ResidueField B) (ResidueField B ⊗[B] maximalIdeal B) := by
    rw [Module.finrank_eq_spanFinrank_of_free (R := ResidueField B)]
    exact hB.symm
  rw [hA', hB']
  let f : ResidueField B ⊗[B] (maximalIdeal B) ≃ₗ[ResidueField B]
      ResidueField B ⊗[ResidueField A] (ResidueField A ⊗[A] maximalIdeal A) :=
    (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl _ _) e'.symm).trans
      ((TensorProduct.AlgebraTensorModule.cancelBaseChange A B (ResidueField B)
        (ResidueField B) (maximalIdeal A)).trans
      (TensorProduct.AlgebraTensorModule.cancelBaseChange A (ResidueField A) (ResidueField B)
        (ResidueField B) (maximalIdeal A)).symm)
  exact (f.finrank_eq.trans Module.finrank_baseChange).symm

/-- Descent of regularity along a flat local homomorphism `A → B` with `m_A B = m_B`: if `B` is
regular, so is `A` (`dim B ≤ dim A`, the closed fibre being a field, and `m_A`, `m_B` need the
same number of generators). -/
private theorem isRegularLocalRing_of_flat {A B : Type u} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsNoetherianRing A] [IsRegularLocalRing B] [Algebra A B] [Module.Flat A B]
    [IsLocalHom (algebraMap A B)]
    (hmax : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B) : IsRegularLocalRing A := by
  have hdim : ringKrullDim B ≤ ringKrullDim A := by
    have h := Ideal.height_le_height_add_of_liesOver (maximalIdeal A) (maximalIdeal B)
    rw [hmax, Ideal.map_quotient_self, Ideal.height_bot, add_zero] at h
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
    exact_mod_cast h
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  calc ((maximalIdeal A).spanFinrank : WithBot ℕ∞) ≤ (maximalIdeal B).spanFinrank := by
        exact_mod_cast (spanFinrank_maximalIdeal_eq_of_flat hmax).le
    _ = ringKrullDim B := IsRegularLocalRing.spanFinrank_maximalIdeal
    _ ≤ ringKrullDim A := hdim

/-- Ascent of regularity along a flat local homomorphism `A → B` with `m_A B = m_B`: if `A` is
regular, so is `B` (`dim A ≤ dim B` by going down, and `m_A`, `m_B` need the same number of
generators). -/
private theorem isRegularLocalRing_of_flat_ascent {A B : Type u} [CommRing A] [CommRing B]
    [IsRegularLocalRing A] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [Module.Flat A B]
    [IsLocalHom (algebraMap A B)]
    (hmax : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B) : IsRegularLocalRing B := by
  have hdim : ringKrullDim A ≤ ringKrullDim B := by
    have h := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal A)
      (maximalIdeal B)
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h]
    exact_mod_cast le_self_add
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  calc ((maximalIdeal B).spanFinrank : WithBot ℕ∞) = (maximalIdeal A).spanFinrank := by
        exact_mod_cast (spanFinrank_maximalIdeal_eq_of_flat hmax).symm
    _ = ringKrullDim A := IsRegularLocalRing.spanFinrank_maximalIdeal
    _ ≤ ringKrullDim B := hdim

/-- The quotient of a flat local homomorphism is faithfully flat. -/
private theorem faithfullyFlat_quotient {A B : Type u} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] [Algebra A B] [Module.Flat A B]
    [IsLocalHom (algebraMap A B)] (I : Ideal A) (hI : I ≠ ⊤) :
    Module.FaithfullyFlat (A ⧸ I) (B ⧸ I.map (algebraMap A B)) := by
  have hIB : I.map (algebraMap A B) ≤ maximalIdeal B :=
    (Ideal.map_mono (le_maximalIdeal hI)).trans (map_maximalIdeal_le (algebraMap A B))
  have _ : IsLocalRing (A ⧸ I) := isLocalRing_quotient_of_le (le_maximalIdeal hI)
  have _ : IsLocalRing (B ⧸ I.map (algebraMap A B)) := isLocalRing_quotient_of_le hIB
  have _ : Module.Flat (A ⧸ I) (B ⧸ I.map (algebraMap A B)) :=
    Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B I).toLinearEquiv
  have _ : IsLocalHom (algebraMap (A ⧸ I) (B ⧸ I.map (algebraMap A B))) := by
    refine ((IsLocalRing.local_hom_TFAE _).out 3 1).mp ?_
    rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
      ← map_maximalIdeal_of_surjective (Ideal.Quotient.mk (I.map (algebraMap A B)))
        Ideal.Quotient.mk_surjective, Ideal.map_map]
    have hcomp : (algebraMap (A ⧸ I) (B ⧸ I.map (algebraMap A B))).comp (Ideal.Quotient.mk I) =
        (Ideal.Quotient.mk (I.map (algebraMap A B))).comp (algebraMap A B) := rfl
    rw [hcomp, ← Ideal.map_map]
    exact Ideal.map_mono (map_maximalIdeal_le (algebraMap A B))
  exact Module.FaithfullyFlat.of_flat_of_isLocalHom

open scoped TensorProduct in
/-- `(P/J)ⁿ/(P/J)ⁿ⁺¹` and `Pⁿ(A/J)/Pⁿ⁺¹(A/J)` are the same module, over `(A/J)/(P/J) ≅ A/P`;
in particular one is free iff the other is. -/
private theorem free_grPiece_iff_free_grModPiece {A : Type u} [CommRing A] {J P : Ideal A}
    (hJP : J ≤ P) (n : ℕ) :
    Module.Free ((A ⧸ J) ⧸ P.map (Ideal.Quotient.mk J))
        (GrPiece (P.map (Ideal.Quotient.mk J)) n) ↔
      Module.Free (A ⧸ P) (GrModPiece P (A ⧸ J) n) := by
  have hmem : ∀ (k : ℕ) (x : A ⧸ J),
      x ∈ P.map (Ideal.Quotient.mk J) ^ k ↔ x ∈ (P ^ k • ⊤ : Submodule A (A ⧸ J)) := by
    intro k x
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_pow]
    rfl
  -- the forward map
  let f₀ : ↥(P.map (Ideal.Quotient.mk J) ^ n) →ₗ[A] GrModPiece P (A ⧸ J) n :=
    { toFun := fun v => Submodule.Quotient.mk ⟨v, (hmem n v).mp v.2⟩
      map_add' := fun v w => rfl
      map_smul' := fun a v => rfl }
  set K₁ := Submodule.comap (P.map (Ideal.Quotient.mk J) ^ n).subtype
    (P.map (Ideal.Quotient.mk J) ^ (n + 1))
  have hf₀ : K₁.restrictScalars A ≤ LinearMap.ker f₀ := by
    intro v hv
    rw [LinearMap.mem_ker]
    show Submodule.Quotient.mk _ = 0
    rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
    exact (hmem (n + 1) v).mp hv
  let f : GrPiece (P.map (Ideal.Quotient.mk J)) n →ₗ[A] GrModPiece P (A ⧸ J) n :=
    (K₁.restrictScalars A).liftQ f₀ hf₀ ∘ₗ
      (Submodule.Quotient.restrictScalarsEquiv A K₁).symm.toLinearMap
  -- the backward map
  let g₀ : ↥(P ^ n • (⊤ : Submodule A (A ⧸ J))) →ₗ[A] GrPiece (P.map (Ideal.Quotient.mk J)) n :=
    { toFun := fun v => Submodule.Quotient.mk ⟨v, (hmem n v).mpr v.2⟩
      map_add' := fun v w => rfl
      map_smul' := fun a v => rfl }
  have hg₀ : Submodule.comap (P ^ n • (⊤ : Submodule A (A ⧸ J))).subtype
      (P ^ (n + 1) • ⊤) ≤ LinearMap.ker g₀ := by
    intro v hv
    rw [LinearMap.mem_ker]
    show Submodule.Quotient.mk _ = 0
    rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
    exact (hmem (n + 1) v).mpr hv
  let g : GrModPiece P (A ⧸ J) n →ₗ[A] GrPiece (P.map (Ideal.Quotient.mk J)) n :=
    Submodule.liftQ _ g₀ hg₀
  let e : GrPiece (P.map (Ideal.Quotient.mk J)) n ≃ₗ[A] GrModPiece P (A ⧸ J) n :=
    LinearEquiv.ofLinearMap f g
      (LinearMap.ext fun x => by
        induction x using Submodule.Quotient.induction_on with
        | H v => rfl)
      (LinearMap.ext fun x => by
        induction x using Submodule.Quotient.induction_on with
        | H v => rfl)
  let σ := DoubleQuot.quotQuotEquivQuotOfLE hJP
  have _ := RingHomInvPair.of_ringEquiv σ
  have _ := RingHomInvPair.of_ringEquiv_symm σ
  let eσ : GrPiece (P.map (Ideal.Quotient.mk J)) n ≃ₛₗ[(σ : (A ⧸ J) ⧸
      P.map (Ideal.Quotient.mk J) →+* A ⧸ P)] GrModPiece P (A ⧸ J) n :=
    { e.toAddEquiv with
      map_smul' := fun c x => by
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
        induction x using Submodule.Quotient.induction_on with
        | H v => rfl }
  exact Module.Free.iff_of_equiv eσ

/-- `GrModPiece` is functorial in linear equivalences. -/
private theorem nonempty_grModPiece_equiv {A : Type u} [CommRing A] (I : Ideal A)
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] (e : M ≃ₗ[A] N)
    (n : ℕ) : Nonempty (GrModPiece I M n ≃ₗ[A ⧸ I] GrModPiece I N n) := by
  have hmap : ∀ k : ℕ, (I ^ k • (⊤ : Submodule A M)).map (e : M →ₗ[A] N) = I ^ k • ⊤ := by
    intro k
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
  have hmem : ∀ (k : ℕ) (x : M),
      e x ∈ (I ^ k • ⊤ : Submodule A N) ↔ x ∈ (I ^ k • ⊤ : Submodule A M) := by
    intro k x
    rw [← hmap k]
    exact ⟨fun h => by
      obtain ⟨y, hy, hyx⟩ := h
      rw [← e.injective hyx]
      exact hy, fun h => ⟨x, h, rfl⟩⟩
  have hmem' : ∀ (k : ℕ) (y : N),
      e.symm y ∈ (I ^ k • ⊤ : Submodule A M) ↔ y ∈ (I ^ k • ⊤ : Submodule A N) := by
    intro k y
    rw [← hmem k, LinearEquiv.apply_symm_apply]
  let f₀ : ↥(I ^ n • (⊤ : Submodule A M)) →ₗ[A] GrModPiece I N n :=
    { toFun := fun v => Submodule.Quotient.mk ⟨e v, (hmem n v).mpr v.2⟩
      map_add' := fun v w => by
        rw [← Submodule.Quotient.mk_add]
        congr 1
        exact Subtype.ext (map_add e _ _)
      map_smul' := fun a v => by
        rw [RingHom.id_apply, ← Submodule.Quotient.mk_smul]
        congr 1
        exact Subtype.ext (map_smul e _ _) }
  let g₀ : ↥(I ^ n • (⊤ : Submodule A N)) →ₗ[A] GrModPiece I M n :=
    { toFun := fun v => Submodule.Quotient.mk ⟨e.symm v, (hmem' n v).mpr v.2⟩
      map_add' := fun v w => by
        rw [← Submodule.Quotient.mk_add]
        congr 1
        exact Subtype.ext (map_add e.symm _ _)
      map_smul' := fun a v => by
        rw [RingHom.id_apply, ← Submodule.Quotient.mk_smul]
        congr 1
        exact Subtype.ext (map_smul e.symm _ _) }
  have hf₀ : Submodule.comap (I ^ n • (⊤ : Submodule A M)).subtype (I ^ (n + 1) • ⊤) ≤
      LinearMap.ker f₀ := by
    intro v hv
    rw [LinearMap.mem_ker]
    show Submodule.Quotient.mk _ = 0
    rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
    exact (hmem (n + 1) v).mpr hv
  have hg₀ : Submodule.comap (I ^ n • (⊤ : Submodule A N)).subtype (I ^ (n + 1) • ⊤) ≤
      LinearMap.ker g₀ := by
    intro v hv
    rw [LinearMap.mem_ker]
    show Submodule.Quotient.mk _ = 0
    rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
    exact (hmem' (n + 1) v).mpr hv
  let E : GrModPiece I M n ≃ₗ[A] GrModPiece I N n :=
    LinearEquiv.ofLinearMap (Submodule.liftQ _ f₀ hf₀) (Submodule.liftQ _ g₀ hg₀)
      (LinearMap.ext fun x => by
        induction x using Submodule.Quotient.induction_on with
        | H v =>
          show Submodule.Quotient.mk _ = Submodule.Quotient.mk _
          congr 1
          exact Subtype.ext (e.apply_symm_apply _))
      (LinearMap.ext fun x => by
        induction x using Submodule.Quotient.induction_on with
        | H v =>
          show Submodule.Quotient.mk _ = Submodule.Quotient.mk _
          congr 1
          exact Subtype.ext (e.symm_apply_apply _))
  exact ⟨E.extendScalarsOfSurjective Ideal.Quotient.mk_surjective⟩

/-- Over a local ring, a graded piece `Pⁿ M/Pⁿ⁺¹ M` of a finite module is free over `A/P` iff it
is flat. -/
private theorem free_iff_flat_grModPiece {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {P : Ideal A} (hP : P ≠ ⊤) (M : Type u) [AddCommGroup M] [Module A M]
    [Module.Finite A M] (n : ℕ) :
    Module.Free (A ⧸ P) (GrModPiece P M n) ↔ Module.Flat (A ⧸ P) (GrModPiece P M n) := by
  have _ : IsLocalRing (A ⧸ P) := isLocalRing_quotient_of_le (le_maximalIdeal hP)
  exact ⟨fun _ => inferInstance, fun _ => Module.free_of_flat_of_isLocalRing⟩

open scoped TensorProduct in
/-- Lemma 9 of Ch. II §3 (`lem:II.3-9`) in the form used in Remark 1 of §5: for a faithfully flat local
homomorphism `R → R'`, `R/J` is normally flat along `P/J` iff `R'/JR'` is normally flat along
`PR'/JR'`. -/
theorem isNormallyFlatAlongIdeal_map_iff {R R' : Type u} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] [CommRing R'] [IsLocalRing R'] [IsNoetherianRing R']
    [Algebra R R'] [Module.FaithfullyFlat R R'] (J P : Ideal R) (hJP : J ≤ P) (hP : P ≠ ⊤) :
    IsNormallyFlatAlongIdeal (P.map (Ideal.Quotient.mk J)) ↔
      IsNormallyFlatAlongIdeal ((P.map (algebraMap R R')).map
        (Ideal.Quotient.mk (J.map (algebraMap R R')))) := by
  have hP' : P.map (algebraMap R R') ≠ ⊤ := fun h => hP (by
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := R') P, h, Ideal.comap_top])
  have h9 := grModPiece_flat_iff_flat_baseChange R R' inferInstance P (R ⧸ J)
  have hfun : ∀ n, Module.Flat (R' ⧸ P.map (algebraMap R R'))
        (GrModPiece (P.map (algebraMap R R')) (R' ⊗[R] (R ⧸ J)) n) ↔
      Module.Flat (R' ⧸ P.map (algebraMap R R'))
        (GrModPiece (P.map (algebraMap R R')) (R' ⧸ J.map (algebraMap R R')) n) := by
    intro n
    obtain ⟨E⟩ := nonempty_grModPiece_equiv (P.map (algebraMap R R'))
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' J).toLinearEquiv n
    exact ⟨fun _ => Module.Flat.of_linearEquiv E, fun _ => Module.Flat.of_linearEquiv E.symm⟩
  simp only [IsNormallyFlatAlongIdeal]
  simp only [free_grPiece_iff_free_grModPiece hJP,
    free_grPiece_iff_free_grModPiece (Ideal.map_mono hJP : J.map (algebraMap R R') ≤ _),
    free_iff_flat_grModPiece hP, free_iff_flat_grModPiece hP', ← hfun]
  exact h9

/-- Remark 1, p. 226: "Let `R` be a regular local ring, `J` an ideal in `R`, and `P` a prime
ideal in `R` which contains `J`. Let `R → R'` be a local homomorphism of regular local rings
which transforms a regular system of parameters of `R` into such a system of parameters of
`R'`. Let `P' = PR'` and `J' = JR'`. Then `R'` is faithfully flat over `R`, and therefore
`R'/J'` (resp. `R'/P'`) is so over `R/J` (resp. `R/P`). It follows that `P` is a permissible
center for `J` if and only if `P'` is such for `J'`. (See Lemma 9, §3, Ch. II.)"

Encoding: `P' = PR'` is `P.map α` and `J' = JR'` is `J.map α`; "`R'` is faithfully flat over
`R`" is `Module.FaithfullyFlat R R'` for the algebra structure `α.toAlgebra`, and the two
derived statements are the same for the induced homomorphisms `R/J → R'/J'` and
`R/P → R'/P'` (`Ideal.quotientMap`).

Gap in the paper filled: the paper gives no argument for condition (i) of Definition 8
(regularity of `R/P` ⇔ regularity of `R'/P'`, and primality of `PR'`) nor for the faithful
flatness of `R'` over `R`.  Regularity descends and ascends along the flat local homomorphism
`R/P → R'/P'` because its closed fibre is a field (`M R' = M'`): the maximal ideals need the
same number of generators and the dimensions agree (`isRegularLocalRing_of_flat`,
`isRegularLocalRing_of_flat_ascent`).  The flatness of `R → R'` is
`RingHom.MapsRSOP.flat` (`lem:III.rsop-map-flat`), a fact the paper asserts on p. 207 without
proof. -/
@[blueprint "rem:III.5-1"
  (statement := /-- Let $R$ be a regular local ring, $J$ an ideal in $R$, and $P$ a prime
    ideal in $R$ which contains $J$. Let $\alpha\colon R\to R'$ be a local homomorphism of
    regular local rings which transforms a regular system of parameters of $R$ into such a
    system of parameters of $R'$ (\cref{def:III.rsop-map}). Let $P'=PR'$ and $J'=JR'$. Then
    $R'$ is faithfully flat over $R$, and therefore $R'/J'$ (resp.\ $R'/P'$) is so over
    $R/J$ (resp.\ $R/P$). It follows that $P$ is a permissible center for $J$
    (\cref{def:III.8}) if and only if $P'$ is such for $J'$. (Remark 1, p.~226.) -/)
  (proof := /-- The paper's argument is the statement itself: ``$R'$ is faithfully flat over
    $R$, and therefore $R'/J'$ (resp.\ $R'/P'$) is so over $R/J$ (resp.\ $R/P$). It follows
    that \dots\ (See Lemma~9, \S3, Ch.~II.)'' In detail: $R'$ is flat over $R$ by
    \cref{lem:III.rsop-map-flat} (asserted by the paper on p.~207), hence faithfully flat, the
    homomorphism being local. Faithful flatness is preserved by the base changes
    $-\otimes_RR/J$ and $-\otimes_RR/P$, whence $R'/J'=R'\otimes_RR/J$ is faithfully flat
    over $R/J$ and $R'/P'=R'\otimes_RR/P$ is faithfully flat over $R/P$. Condition (ii) of
    \cref{def:III.8}, the flatness of $\operatorname{gr}_{P/J}(R/J)$ over $R/P$, descends
    and ascends by Lemma~9 of \S3, Ch.~II (\cref{lem:II.3-9}), since
    $\operatorname{gr}_{P'/J'}(R'/J')=\operatorname{gr}_{P/J}(R/J)\otimes_{R/P}R'/P'$.

    \textbf{Gap in the paper filled.} The paper gives no argument for condition (i) of
    \cref{def:III.8}. Faithful flatness of $R'/P'$ over $R/P$ alone does not make regularity
    ascend; Lean uses in addition that the closed fibre is a field ($MR'=M'$): then the maximal
    ideals of $R/P$ and $R'/P'$ need the same number of generators and $\dim R/P=\dim R'/P'$
    (going down), so $R/P$ is regular if and only if $R'/P'$ is, and $PR'$ is then prime. -/)
  (latexEnv := "remark")]
theorem isPermissibleCenter_map_iff {R R' : Type u} [CommRing R] [IsRegularLocalRing R]
    [CommRing R'] [IsRegularLocalRing R'] (α : R →+* R') [IsLocalHom α]
    (hα : RingHom.MapsRSOP α) (J P : Ideal R) [P.IsPrime] (hJP : J ≤ P) :
    letI : Algebra R R' := α.toAlgebra
    letI : Algebra (R ⧸ J) (R' ⧸ J.map α) :=
      (Ideal.quotientMap (J.map α) α Ideal.le_comap_map).toAlgebra
    letI : Algebra (R ⧸ P) (R' ⧸ P.map α) :=
      (Ideal.quotientMap (P.map α) α Ideal.le_comap_map).toAlgebra
    Module.FaithfullyFlat R R' ∧ Module.FaithfullyFlat (R ⧸ J) (R' ⧸ J.map α) ∧
      Module.FaithfullyFlat (R ⧸ P) (R' ⧸ P.map α) ∧
      (IsPermissibleCenter R J P ↔ IsPermissibleCenter R' (J.map α) (P.map α)) := by
  have _ : IsDomain R := Transforms.isDomain_of_isRegularLocalRing R
  have _ : IsDomain R' := Transforms.isDomain_of_isRegularLocalRing R'
  let _ : Algebra R R' := α.toAlgebra
  have _ : IsLocalHom (algebraMap R R') := ‹IsLocalHom α›
  have _ : Module.Flat R R' := hα.flat
  have hFF : Module.FaithfullyFlat R R' := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hPtop : P ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance
  have hJtop : J ≠ ⊤ := ne_top_of_le_ne_top hPtop hJP
  -- `R'/JR'` (resp. `R'/PR'`) is faithfully flat over `R/J` (resp. `R/P`)
  have hFFJ := faithfullyFlat_quotient (A := R) (B := R') J hJtop
  have hFFP := faithfullyFlat_quotient (A := R) (B := R') P hPtop
  have hinstJ : (Ideal.quotientMap (J.map α) α Ideal.le_comap_map).toAlgebra =
      (Ideal.Quotient.algebraQuotientMapQuotient :
        Algebra (R ⧸ J) (R' ⧸ J.map (algebraMap R R'))) :=
    Algebra.algebra_ext _ _ fun r => rfl
  have hinstP : (Ideal.quotientMap (P.map α) α Ideal.le_comap_map).toAlgebra =
      (Ideal.Quotient.algebraQuotientMapQuotient :
        Algebra (R ⧸ P) (R' ⧸ P.map (algebraMap R R'))) :=
    Algebra.algebra_ext _ _ fun r => rfl
  refine ⟨hFF, by rw [hinstJ]; exact hFFJ, by rw [hinstP]; exact hFFP, ?_⟩
  have hM : (maximalIdeal R).map (algebraMap R R') = maximalIdeal R' :=
    map_maximalIdeal_of_mapsRSOP α hα
  have hP'top : P.map (algebraMap R R') ≠ ⊤ := fun h => hPtop (by
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := R') P, h, Ideal.comap_top])
  have _ : IsLocalRing (R ⧸ P) := isLocalRing_quotient_of_le (le_maximalIdeal hPtop)
  have _ : IsLocalRing (R' ⧸ P.map (algebraMap R R')) :=
    isLocalRing_quotient_of_le (le_maximalIdeal hP'top)
  have _ : Module.FaithfullyFlat (R ⧸ P) (R' ⧸ P.map (algebraMap R R')) := hFFP
  -- `m_{R/P} (R'/PR') = m_{R'/PR'}`
  have hmaxP : (maximalIdeal (R ⧸ P)).map (algebraMap (R ⧸ P) (R' ⧸ P.map (algebraMap R R'))) =
      maximalIdeal (R' ⧸ P.map (algebraMap R R')) := by
    rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk P) Ideal.Quotient.mk_surjective,
      ← map_maximalIdeal_of_surjective (Ideal.Quotient.mk (P.map (algebraMap R R')))
        Ideal.Quotient.mk_surjective, Ideal.map_map, ← hM, Ideal.map_map]
    rfl
  constructor
  · -- ascent: `R'/PR'` is regular (so `PR'` is prime) and normal flatness ascends (Lemma 9)
    intro hperm
    obtain ⟨-, -, hS, hNF⟩ := hperm.resolve_left hPtop
    have _ : IsRegularLocalRing (R ⧸ P) := hS
    have hS' : IsRegularLocalRing (R' ⧸ P.map (algebraMap R R')) :=
      isRegularLocalRing_of_flat_ascent (A := R ⧸ P) hmaxP
    have hP' : (P.map (algebraMap R R')).IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime _).mp (isDomain_of_isRegularLocalRing _)
    exact Or.inr ⟨hP', Ideal.map_mono hJP, hS',
      (isNormallyFlatAlongIdeal_map_iff J P hJP hPtop).mp hNF⟩
  · -- descent: regularity of `R/P` and normal flatness descend along the faithfully flat maps
    intro hperm'
    obtain ⟨-, -, hS', hNF'⟩ := hperm'.resolve_left hP'top
    refine Or.inr ⟨inferInstance, hJP, ?_, (isNormallyFlatAlongIdeal_map_iff J P hJP
      hPtop).mpr hNF'⟩
    have _ : IsRegularLocalRing (R' ⧸ P.map (algebraMap R R')) := hS'
    exact isRegularLocalRing_of_flat (B := R' ⧸ P.map (algebraMap R R')) hmaxP

end Remark1

/-! ### Remark 2 (pp. 226–227) -/

section Remark2

open scoped TensorProduct in
/-- A separable algebraic field extension stays reduced after any base change. -/
private theorem isReduced_tensorProduct_left_of_isSeparable (K K' K'' : Type u) [Field K]
    [Field K'] [Field K''] [Algebra K K'] [Algebra K K''] [Algebra.IsSeparable K K'] :
    IsReduced (K' ⊗[K] K'') := by
  suffices h : IsReduced (K'' ⊗[K] K') from
    isReduced_of_injective (Algebra.TensorProduct.comm K K' K'') (AlgEquiv.injective _)
  refine IsReduced.tensorProduct_of_flat_of_forall_fg fun B hB => ?_
  obtain ⟨s, rfl⟩ := hB
  have halg : ∀ x ∈ (s : Set K'), IsAlgebraic K x := fun x _ =>
    Algebra.IsAlgebraic.isAlgebraic x
  let F := IntermediateField.adjoin K (s : Set K')
  have hFB : F.toSubalgebra = Algebra.adjoin K (s : Set K') :=
    IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg
  have : FiniteDimensional K F :=
    IntermediateField.finiteDimensional_adjoin fun x hx => (halg x hx).isIntegral
  have : Algebra.IsSeparable K F := Algebra.IsSeparable.of_algHom K K' F.val
  have : Algebra.FormallyUnramified K F := Algebra.FormallyUnramified.of_isSeparable K F
  have hred := Algebra.FormallyUnramified.isReduced_of_field K'' (K'' ⊗[K] F)
  let e : (Algebra.adjoin K (s : Set K')) ≃ₐ[K] F :=
    (Subalgebra.equivOfEq _ _ hFB.symm).trans (AlgEquiv.refl)
  exact isReduced_of_injective
    (Algebra.TensorProduct.congr (AlgEquiv.refl (R := K) (A₁ := K'')) e)
    (AlgEquiv.injective _)

/-- A residually separable algebraic local homomorphism is residually separable in the sense of
pp. 211–212 (a separable algebraic extension stays reduced after base change). -/
theorem isResiduallySeparable_of_isResiduallySeparableAlgebraic {A B : Type u}
    [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] (φ : A →+* B) [IsLocalHom φ]
    (h : RingHom.IsResiduallySeparableAlgebraic φ) : RingHom.IsResiduallySeparable φ := by
  let _ : Algebra (ResidueField A) (ResidueField B) := (ResidueField.map φ).toAlgebra
  have : Algebra.IsSeparable (ResidueField A) (ResidueField B) := h
  intro k' _ _ _
  exact isReduced_tensorProduct_left_of_isSeparable _ _ _

/-- In a commutative square of local homomorphisms `β ∘ t = t' ∘ α`, if the residue field of
`B'` is generated by those of `B` and `A'` and the residue field of `A'` is separable algebraic
over that of `A`, then the residue field of `B'` is separable algebraic over that of `B`. -/
theorem isResiduallySeparableAlgebraic_of_closure_eq_top {A A' B B' : Type u}
    [CommRing A] [CommRing A'] [CommRing B] [CommRing B'] [IsLocalRing A] [IsLocalRing A']
    [IsLocalRing B] [IsLocalRing B'] (α : A →+* A') (t : A →+* B) (t' : A' →+* B')
    (β : B →+* B') [IsLocalHom α] [IsLocalHom t] [IsLocalHom t'] [IsLocalHom β]
    (hβ : β.comp t = t'.comp α) (hsep : RingHom.IsResiduallySeparableAlgebraic α)
    (hclos : Subfield.closure
      (Set.range (ResidueField.map β) ∪ Set.range (ResidueField.map t')) = ⊤) :
    RingHom.IsResiduallySeparableAlgebraic β := by
  let _ : Algebra (ResidueField B) (ResidueField B') := (ResidueField.map β).toAlgebra
  show Algebra.IsSeparable (ResidueField B) (ResidueField B')
  have hcomp : (ResidueField.map β).comp (ResidueField.map t) =
      (ResidueField.map t').comp (ResidueField.map α) := by
    refine RingHom.ext fun x => ?_
    obtain ⟨a, rfl⟩ := residue_surjective x
    simp only [RingHom.comp_apply, ResidueField.map_residue]
    exact congrArg (residue B') (DFunLike.congr_fun hβ a)
  have hsepel : ∀ y : ResidueField A',
      IsSeparable (ResidueField B) (ResidueField.map t' y) := by
    intro y
    let _ : Algebra (ResidueField A) (ResidueField A') := (ResidueField.map α).toAlgebra
    have : Algebra.IsSeparable (ResidueField A) (ResidueField A') := hsep
    have hy : (minpoly (ResidueField A) y).Separable := Algebra.IsSeparable.isSeparable _ y
    have hroot : Polynomial.aeval (ResidueField.map t' y)
        ((minpoly (ResidueField A) y).map (ResidueField.map t)) = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, RingHom.algebraMap_toAlgebra, hcomp,
        ← Polynomial.hom_eval₂, ← RingHom.algebraMap_toAlgebra (ResidueField.map α),
        ← Polynomial.aeval_def, minpoly.aeval, map_zero]
    exact (hy.map).of_dvd (minpoly.dvd _ _ hroot)
  have htop : IntermediateField.adjoin (ResidueField B) (Set.range (ResidueField.map t')) = ⊤ := by
    apply IntermediateField.toSubfield_injective
    rw [IntermediateField.adjoin_toSubfield, IntermediateField.top_toSubfield]
    exact hclos
  have hsep' := (IntermediateField.isSeparable_adjoin_iff_isSeparable (ResidueField B)
    (ResidueField B') (S := Set.range (ResidueField.map t'))).mpr
      (by rintro _ ⟨y, rfl⟩; exact hsepel y)
  rw [htop] at hsep'
  exact Algebra.IsSeparable.of_algHom _ _ IntermediateField.topEquiv.symm.toAlgHom

/-- Remark 2, pp. 226–227: "Let `R → R'`, `J`, `J'`, `P` and `P'` be the same as in Remark 1.
Let us assume that `R/P` is regular, hence, so is `R'/P'`. Let `R₁` (resp. `R₁'`) be a monoidal
transform of `R` (resp. `R'`) with center `P` (resp. `P'`) such that we have the commutative
diagram of canonical local homomorphisms `R₁ → R₁'`, `R → R'`. Let `J₁` (resp. `J₁'`) be the
strict transform of `J` (resp. `J'`) in `R₁` (resp. `R₁'`). By Corollary to Lemma 5, §2, we have
`J₁' = J₁R₁'`. If the residue field of `R'` is separable algebraic over that of `R`, then we
have `ν*(J) = ν*(J')` and `ν^{(i)}(J₁) = ν^{(i)}(J₁')` for all positive integers `i`. In fact,
by Lemma 4 of §2, the local homomorphism `R₁ → R₁'` transforms a regular system of parameters of
`R₁` into such a system of parameters of `R₁'`. The assertion then follows by Corollary to
Lemma 2, §1. Moreover, the residue field of `R₁'` is separable over that of `R₁` and we have
`τ*(J) = τ*(J')` and `τ^{(i)}(J₁) = τ^{(i)}(J₁')` for all positive integers `i`.
(See Lemma 13 of §4.)"

Encoding: the commutative diagram is the ring homomorphism `β : R₁ → R₁'` together with the
hypothesis `hβ : β ∘ T.toRing = T'.toRing ∘ α`; `β` is assumed local (`[IsLocalHom β]`), which
is part of "canonical local homomorphisms".  "`J₁' = J₁R₁'`" is
`strictTransformIdeal T' J' = (strictTransformIdeal T J).map β`.  The equalities of the systems
`τ*` are transcribed as in Lemma 13 (`lem:III.13`): `t(J') = t(J)` together with
`τ^{(i)}(J') = τ^{(i)}(J)` for `1 ≤ i ≤ t(J)`.

The hypotheses `[IsLocalHom T.toRing]`, `[IsRegularLocalRing T.ring]`, the same for `T'`, and
`[(P.map α).IsPrime]` which the statement could carry are lemmas of §2
(`MonoidalTransform.isLocalHom_toRing`, `MonoidalTransform.isRegularLocalRing_of_isRegularLocalRing_quotient`,
`RingHom.MapsRSOP.canonicalLift_properties`); they are not hypotheses: `T.ring` is regular
by the instance `MonoidalTransform.instIsRegularLocalRing`, and `PR'` is prime and `R'/PR'` and `R₁'` regular
by `haveI` in the statement from `canonicalLift_properties` ("assume that `R/P` is regular, hence so is
`R'/P'`").  The proof follows the paper. -/
@[blueprint "rem:III.5-2"
  (statement := /-- Let $\alpha\colon R\to R'$, $J$, $J'=JR'$, $P$ and $P'=PR'$ be the same as
    in \cref{rem:III.5-1}, and assume that $R/P$ is regular, hence so is $R'/P'$. Let $R_1$
    (resp.\ $R_1'$) be a monoidal transform of $R$ (resp.\ $R'$) with center $P$ (resp.\ $P'$)
    (\cref{def:III.2-monoidal-transform}) such that we have the commutative diagram of
    canonical local homomorphisms $\beta\colon R_1\to R_1'$ over $\alpha\colon R\to R'$. Let
    $J_1$ (resp.\ $J_1'$) be the strict transform of $J$ (resp.\ $J'$) in $R_1$ (resp.\
    $R_1'$) (\cref{def:III.5-strict}). Then $J_1'=J_1R_1'$. If moreover the residue field of
    $R'$ is separable algebraic over that of $R$ (\cref{def:III.2-residually}), then
    $\nu^*(J)=\nu^*(J')$ and $\nu^{(i)}(J_1)=\nu^{(i)}(J_1')$ for all positive integers $i$,
    and $\tau^*(J)=\tau^*(J')$ and $\tau^{(i)}(J_1)=\tau^{(i)}(J_1')$ for all positive
    integers $i$. (Remark 2, pp.~226--227.)

    (Formalization note (encoding): $\tau^*(J)=\tau^*(J')$ is transcribed, as in \cref{lem:III.13}, as
    $t(J')=t(J)$ together with $\tau^{(i)}(J')=\tau^{(i)}(J)$ for $1\le i\le t(J)$, and
    likewise for $\tau^*(J_1)=\tau^*(J_1')$.)

    \textbf{Statement.} That $R\to R_1$ and $R'\to R_1'$ are local, that $R_1$, $R_1'$ are
    regular and that $P'$ is prime are lemmas of \S2 (\cref{lem:III.4} and the results preceding
    it); they are not hypotheses of the Lean statement (the
    regularity of $R_1'$ and the primality of $P'$ are derived in it, as in the print: ``assume
    that $R/P$ is regular, hence so is $R'/P'$''), as in the other statements of \S5. -/)
  (proof := /-- By the Corollary to Lemma~5 of \S2 (\cref{cor:III.lem5}) we have
    $J_1'=J_1R_1'$. By Lemma~4 of \S2 (\cref{lem:III.4}), the local homomorphism
    $\beta\colon R_1\to R_1'$ transforms a regular system of parameters of $R_1$ into such a
    system of parameters of $R_1'$. The assertions $\nu^*(J)=\nu^*(J')$ and
    $\nu^{(i)}(J_1)=\nu^{(i)}(J_1')$ then follow by the Corollary to Lemma~2 of \S1
    (\cref{cor:III.lem2}), applied to $\alpha$ and to $\beta$. Moreover, by Lemma~4 of \S2
    the residue field of $R_1'$ is separable over that of $R_1$, so the assertions
    $\tau^*(J)=\tau^*(J')$ and $\tau^{(i)}(J_1)=\tau^{(i)}(J_1')$ follow from Lemma~13 of \S4
    (\cref{lem:III.13}), applied to $\alpha$ and to $\beta$. -/)
  (latexEnv := "remark")]
theorem strictTransform_map_of_mapsRSOP [Hironaka.Cited.IsSeparableFieldExtensionIff.{u}] {R R' : Type u} [CommRing R] [IsRegularLocalRing R]
    [IsDomain R] [CommRing R'] [IsRegularLocalRing R'] [IsDomain R'] (α : R →+* R')
    [IsLocalHom α] (hα : RingHom.MapsRSOP α) (J P : Ideal R) [P.IsPrime] (hJP : J ≤ P)
    [IsRegularLocalRing (R ⧸ P)] (T : MonoidalTransform R P)
    (T' : MonoidalTransform R' (P.map α)) (β : T.ring →+* T'.ring)
    [IsLocalHom β] (hβ : β.comp T.toRing = T'.toRing.comp α) :
    haveI : (P.map α).IsPrime :=
      (RingHom.MapsRSOP.canonicalLift_properties α hα inferInstance inferInstance).1.1
    haveI : IsRegularLocalRing (R' ⧸ P.map α) :=
      (RingHom.MapsRSOP.canonicalLift_properties α hα inferInstance inferInstance).1.2
    strictTransformIdeal T' (J.map α) = (strictTransformIdeal T J).map β ∧
      (RingHom.IsResiduallySeparableAlgebraic α →
        nuStar R J = nuStar R' (J.map α) ∧
        (∀ i : ℕ+, nuI T.ring (strictTransformIdeal T J) i =
          nuI T'.ring (strictTransformIdeal T' (J.map α)) i) ∧
        (t R' (J.map α) = t R J ∧
          ∀ i, 1 ≤ i → i ≤ t R J → tau R' (J.map α) i = tau R J i) ∧
        (t T'.ring (strictTransformIdeal T' (J.map α)) = t T.ring (strictTransformIdeal T J) ∧
          ∀ i, 1 ≤ i → i ≤ t T.ring (strictTransformIdeal T J) →
            tau T'.ring (strictTransformIdeal T' (J.map α)) i =
              tau T.ring (strictTransformIdeal T J) i)) := by
  have _ := hJP
  have hP : P.IsPrime := inferInstance
  obtain ⟨⟨hP', hS'⟩, -, h2, h3⟩ := RingHom.MapsRSOP.canonicalLift_properties α hα hP inferInstance
  have _ : (P.map α).IsPrime := hP'
  have _ : IsRegularLocalRing (R' ⧸ P.map α) := hS'
  have hcan : IsCanonicalLift α T T' β := ⟨inferInstance, hβ⟩
  -- the Corollary to Lemma 5: `J₁' = J₁ R₁'`
  have h1 := IsCanonicalLift.strictTransformIdeal_map_eq_map_strictTransformIdeal α hα hP inferInstance J T T' β hcan
  refine ⟨h1, fun hsep => ?_⟩
  -- Lemma 4: `R₁ → R₁'` maps a regular system of parameters onto one, and the residue field of
  -- `R₁'` is separable over that of `R₁`
  have hβrsop : RingHom.MapsRSOP β := by
    obtain ⟨-, s, hs⟩ := (isRegularLocalRing_iff_exists_rsop T.ring).mp inferInstance
    exact ⟨s, hs, (h3 T T' β hcan).2 hsep s hs, (h2 T T' β hcan).2.2.2.1.injOn⟩
  have hsepα := isResiduallySeparable_of_isResiduallySeparableAlgebraic α hsep
  have hsepβ := isResiduallySeparable_of_isResiduallySeparableAlgebraic β
    (isResiduallySeparableAlgebraic_of_closure_eq_top α T.toRing T'.toRing β hβ hsep
      (h2 T T' β hcan).2.2.2.2)
  -- the Corollary to Lemma 2 and Lemma 13, applied to `α` and to `β`
  have h13 := tauStar_map α hα hsepα J
  have h13' := tauStar_map β hβrsop hsepβ (strictTransformIdeal T J)
  rw [← h1] at h13'
  refine ⟨nuStar_map_eq_of_mapsRSOP α hα J, fun i => ?_, ⟨h13.1, h13.2.1⟩, ⟨h13'.1, h13'.2.1⟩⟩
  rw [nuI_map_eq_of_mapsRSOP β hβrsop (strictTransformIdeal T J) i, h1]

end Remark2

/-! ## Coordinates adapted to a residually rational monoidal transform

Shared machinery for Lemmas 14–16, Proposition 1 and Theorem 5 (§6): the coordinates
`(x₀, x₁, …, x_r, y₁, …, y_s)` of the proof of Lemma 14 (p. 228) as `TransformCoord`, the
identifications of `gr_M(R)` and `gr_{M₁}(R₁)` with polynomial rings (`TransformCoord.e`,
`TransformCoord.e₁`), expansions of elements of `R` in these coordinates (`TransformCoord.exists_expansion`),
the weighted computation of orders in `R₁` (`x₀, y_j` of weight `1`, `x_i` of weight `2`:
`TransformCoord.ordElem_toRing_of_expansion`), the homomorphism `ρ` of p. 231 (`TransformCoord.ρ`) and the
relation `ψ_j = φ_j(X̄) + λ_j` of p. 228 (`TransformCoord.ordElem_le_and_rho_initialForm_eq`). -/

section PE5Machinery

open MvPolynomial

section CoordGeneric

/-! ### Generic facts: classes in `gr`, expansions, orders of polynomial expressions -/

variable {A : Type u} [CommRing A]

theorem AssocGraded.mk_sub (I : Ideal A) (n : ℕ) (a b : A) (ha : a ∈ I ^ n) (hb : b ∈ I ^ n) :
    AssocGraded.mk I n (a - b) (sub_mem ha hb) =
      AssocGraded.mk I n a ha - AssocGraded.mk I n b hb := by
  show AssocGraded.mkLinear I n ⟨a - b, sub_mem ha hb⟩ =
    AssocGraded.mkLinear I n ⟨a, ha⟩ - AssocGraded.mkLinear I n ⟨b, hb⟩
  rw [← map_sub]
  rfl

theorem AssocGraded.mk_eq_mk_of_sub_mem_pow_succ (I : Ideal A) (n : ℕ) {a b : A} (ha : a ∈ I ^ n) (hb : b ∈ I ^ n)
    (hab : a - b ∈ I ^ (n + 1)) : AssocGraded.mk I n a ha = AssocGraded.mk I n b hb := by
  rw [← sub_eq_zero, ← AssocGraded.mk_sub, AssocGraded.mk_eq_zero_iff]
  exact hab

theorem AssocGraded.mk_congr (I : Ideal A) {n : ℕ} {a b : A} (ha : a ∈ I ^ n) (h : a = b) :
    AssocGraded.mk I n a ha = AssocGraded.mk I n b (h ▸ ha) := by
  subst h
  rfl

theorem AssocGraded.mk_sum (I : Ideal A) (n : ℕ) {ι : Type*} (s : Finset ι) (a : ι → A)
    (ha : ∀ i, a i ∈ I ^ n) :
    AssocGraded.mk I n (∑ i ∈ s, a i) (sum_mem fun i _ => ha i) =
      ∑ i ∈ s, AssocGraded.mk I n (a i) (ha i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [AssocGraded.mk_eq_zero_iff]
  | insert j s hj ih =>
    rw [AssocGraded.mk_congr I (sum_mem fun i _ => ha i) (Finset.sum_insert hj),
      AssocGraded.mk_add I n _ _ _ (sum_mem fun i _ => ha i), ih, Finset.sum_insert hj]

/-- `ν ≤ ν_I(a)` iff `a ∈ Iᵛ`. -/
theorem Ideal.natCast_le_ordElem_iff (I : Ideal A) (a : A) (ν : ℕ) :
    (ν : ℕ∞) ≤ Ideal.ordElem I a ↔ a ∈ I ^ ν := by
  refine ⟨fun h => ?_, Ideal.le_ordElem⟩
  by_contra hf
  cases ν with
  | zero => exact hf (by simp)
  | succ m =>
    have h' := h.trans (Ideal.ordElem_le_of_notMem hf)
    rw [Nat.cast_le] at h'
    omega

/-- If `a ∈ Iⁿ` has non-zero class in `Iⁿ/Iⁿ⁺¹`, then `ν_I(a) = n` and its initial form is
that class. -/
theorem Ideal.ordElem_eq_of_mk_ne_zero (I : Ideal A) {n : ℕ} {a : A} (ha : a ∈ I ^ n)
    (h : AssocGraded.mk I n a ha ≠ 0) :
    Ideal.ordElem I a = n ∧ initialForm I a = AssocGraded.mk I n a ha := by
  have hn : Ideal.ordElem I a = n := by
    refine le_antisymm (Ideal.ordElem_le_of_notMem fun h' => h ?_) (Ideal.le_ordElem ha)
    exact (AssocGraded.mk_eq_zero_iff I ha).mpr h'
  exact ⟨hn, initialForm_eq_mk I hn⟩

end CoordGeneric

section Expansion

variable {A : Type u} [CommRing A] {σ : Type*} [DecidableEq σ]

/-- Coefficientwise application of a function `c : A → A` with `c 0 = 0` to a polynomial. -/
noncomputable def mapCoeff (c : A → A) (K : MvPolynomial σ A) : MvPolynomial σ A :=
  ∑ m ∈ K.support, monomial m (c (K.coeff m))

theorem coeff_mapCoeff (c : A → A) (hc : c 0 = 0) (K : MvPolynomial σ A) (m : σ →₀ ℕ) :
    (mapCoeff c K).coeff m = c (K.coeff m) := by
  classical
  rw [mapCoeff, coeff_sum]
  simp only [coeff_monomial]
  rw [Finset.sum_ite_eq']
  split_ifs with h
  · rfl
  · rw [notMem_support_iff.mp h, hc]

omit [DecidableEq σ] in
theorem degree_eq_of_isHomogeneous_of_coeff_ne_zero {K : MvPolynomial σ A} {n : ℕ} (hK : K.IsHomogeneous n)
    {m : σ →₀ ℕ} (hm : K.coeff m ≠ 0) : m.degree = n := by
  have := hK hm
  rw [Finsupp.degree_eq_weight_one]
  exact this

theorem isHomogeneous_mapCoeff (c : A → A) (hc : c 0 = 0) {K : MvPolynomial σ A} {n : ℕ}
    (hK : K.IsHomogeneous n) : (mapCoeff c K).IsHomogeneous n := by
  intro m hm
  rw [coeff_mapCoeff c hc] at hm
  exact hK fun h => hm (by rw [h, hc])

/-- **Expansions.** Let `z` generate the ideal `I` and let `lift : A/I → A` be a section of the
quotient map with `lift 0 = 0`. Every `f ∈ Iᵛ` is congruent modulo `Iⁿ` (`n ≥ ν`) to the value
at `z` of a polynomial whose coefficients are values of `lift` and whose monomials have degrees
in `[ν, n)`. -/
theorem exists_eval_sub_mem_pow (I : Ideal A) (z : σ → A) (hz : Ideal.span (Set.range z) = I)
    (lift : A ⧸ I → A) (hlift : ∀ c, Ideal.Quotient.mk I (lift c) = c) (hlift0 : lift 0 = 0)
    (f : A) (ν : ℕ) (hf : f ∈ I ^ ν) (n : ℕ) (hn : ν ≤ n) :
    ∃ F : MvPolynomial σ A, (∀ m, F.coeff m ∈ Set.range lift) ∧
      (∀ m ∈ F.support, ν ≤ m.degree ∧ m.degree < n) ∧ f - eval z F ∈ I ^ n := by
  induction n, hn using Nat.le_induction with
  | base => exact ⟨0, fun m => ⟨0, by simp [hlift0]⟩, by simp, by simpa using hf⟩
  | succ n hn ih =>
    obtain ⟨F, hFc, hFs, hFr⟩ := ih
    obtain ⟨K, hK, hKe⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous z _).mp
      (by rw [hz]; exact hFr)
    have hc0 : lift (Ideal.Quotient.mk I 0) = 0 := by rw [map_zero, hlift0]
    let K' := mapCoeff (fun a => lift (Ideal.Quotient.mk I a)) K
    have hK' : K'.IsHomogeneous n := isHomogeneous_mapCoeff _ hc0 hK
    refine ⟨F + K', fun m => ?_, fun m hm => ?_, ?_⟩
    · by_cases hmF : m ∈ F.support
      · have hK'm : K'.coeff m = 0 := by
          by_contra h0
          have := degree_eq_of_isHomogeneous_of_coeff_ne_zero hK' h0
          have := (hFs m hmF).2
          omega
        rw [MvPolynomial.coeff_add, hK'm, add_zero]
        exact hFc m
      · rw [MvPolynomial.coeff_add, notMem_support_iff.mp hmF, zero_add, coeff_mapCoeff _ hc0]
        exact ⟨_, rfl⟩
    · by_cases hmF : m ∈ F.support
      · have := hFs m hmF
        exact ⟨this.1, by omega⟩
      · have hmK : m ∈ K'.support := by
          rw [mem_support_iff, MvPolynomial.coeff_add, notMem_support_iff.mp hmF, zero_add] at hm
          rw [mem_support_iff]
          exact hm
        have hdeg := degree_eq_of_isHomogeneous_of_coeff_ne_zero hK' (mem_support_iff.mp hmK)
        exact ⟨by omega, by omega⟩
    · have hdiff : eval z (K - K') ∈ I * Ideal.span (Set.range z) ^ n := by
        refine eval_mem_mul_span_pow_of_coeff_mem (hK.sub hK') fun m => ?_
        rw [coeff_sub, coeff_mapCoeff _ hc0, ← Ideal.Quotient.eq, hlift]
      rw [hz, ← pow_succ'] at hdiff
      have : f - eval z (F + K') = (f - eval z F - eval z K) + eval z (K - K') := by
        rw [map_add, map_sub]; ring
      rw [this, hKe, sub_self, zero_add]
      exact hdiff

end Expansion

section OrderOfEval

variable {S : Type u} [CommRing S] {σ : Type*}

/-- The value of a polynomial all of whose monomials have degree `≥ N` lies in `Iᴺ`. -/
theorem eval_mem_pow_of_le_degree (I : Ideal S) (z : σ → S) (hz : Ideal.span (Set.range z) = I)
    (G : MvPolynomial σ S) (N : ℕ) (hG : ∀ m ∈ G.support, N ≤ m.degree) :
    eval z G ∈ I ^ N := by
  rw [G.as_sum, map_sum]
  refine sum_mem fun m hm => ?_
  rw [eval_monomial]
  refine Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right (hG m hm) ?_)
  rw [← hz]
  exact (Ideal.mem_span_pow_iff_exists_isHomogeneous z _).mpr
    ⟨monomial m 1, isHomogeneous_monomial 1 rfl, by rw [eval_monomial, one_mul]⟩

/-- **Order of a polynomial expression.** If every non-zero coefficient of `G` lies outside
the maximal ideal of the regular local ring `S`, `z` is a regular system of parameters (the map
`k[X] → gr(S)` being injective) and `w₀` is the least degree of a monomial of `G`, then the class
of `z(G)` in degree `w₀` is the image of the reduction of the degree-`w₀` part of `G`, and it is
non-zero. -/
theorem mk_eval_eq_aeval [IsLocalRing S] (z : σ → S) (hz : ∀ v, z v ∈ maximalIdeal S ^ 1)
    (hspan : Ideal.span (Set.range z) = maximalIdeal S)
    (G : MvPolynomial σ S) (w₀ : ℕ) (hG : ∀ m ∈ G.support, w₀ ≤ m.degree) :
    AssocGraded.mk (maximalIdeal S) w₀ (eval z G) (eval_mem_pow_of_le_degree _ z hspan G w₀ hG) =
      aeval (R := S ⧸ maximalIdeal S) (fun v => AssocGraded.mk _ 1 (z v) (hz v))
        ((homogeneousComponent w₀ G).map (Ideal.Quotient.mk _)) := by
  rw [aeval_mk_map_of_isHomogeneous _ z hz (homogeneousComponent_isHomogeneous w₀ G)]
  refine AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ _ _ ?_
  have hrest : ∀ m ∈ (G - homogeneousComponent w₀ G).support, w₀ + 1 ≤ m.degree := by
    intro m hm
    rw [mem_support_iff, coeff_sub, coeff_homogeneousComponent] at hm
    have hmG : m ∈ G.support := by
      rw [mem_support_iff]
      intro h0
      rw [h0] at hm
      split_ifs at hm <;> simp at hm
    have := hG m hmG
    by_contra hlt
    have heq : m.degree = w₀ := by omega
    simp only [heq, ↓reduceIte, sub_self] at hm
    exact hm rfl
  have := eval_mem_pow_of_le_degree _ z hspan _ _ hrest
  rwa [map_sub] at this

end OrderOfEval

section AevalBij

/-- `k[X_v : v ∈ V] → gr_M(S)`, `X_v ↦ [z_v]`, is bijective for a regular system of parameters
`z` of the regular local ring `S` indexed by a finite type `V`. -/
theorem aeval_mk_bijective {S : Type u} [CommRing S] [IsRegularLocalRing S] {V : Type*}
    [Fintype V] (z : V → S) (hspan : Ideal.span (Set.range z) = maximalIdeal S)
    (hdim : ((Fintype.card V : ℕ) : WithBot ℕ∞) = ringKrullDim S)
    (hz : ∀ v, z v ∈ maximalIdeal S ^ 1) :
    Function.Bijective (aeval (R := S ⧸ maximalIdeal S)
      fun v => AssocGraded.mk (maximalIdeal S) 1 (z v) (hz v)) := by
  classical
  let e := Fintype.equivFin V
  have hspan' : Ideal.span (Set.range (z ∘ e.symm)) = maximalIdeal S := by
    rw [Set.range_comp, e.symm.range_eq_univ, Set.image_univ, hspan]
  have hb := assocGraded_maximalIdeal_aeval_bijective (n := Fintype.card V) hspan' hdim
    (fun i => hz (e.symm i))
  have hcomp : (aeval (R := S ⧸ maximalIdeal S)
      fun v => AssocGraded.mk (maximalIdeal S) 1 (z v) (hz v)) =
      (aeval (R := S ⧸ maximalIdeal S) fun i => AssocGraded.mk (maximalIdeal S) 1
        ((z ∘ e.symm) i) (hz (e.symm i))).comp (rename e) := by
    refine MvPolynomial.algHom_ext fun v => ?_
    rw [AlgHom.comp_apply, aeval_X, rename_X, aeval_X]
    exact AssocGraded.mk_congr _ _ (by simp)
  rw [hcomp]
  exact hb.comp (renameEquiv (S ⧸ maximalIdeal S) e).bijective

end AevalBij

section Coord

/-- The index type of a regular system of parameters `(x₀, x₁, …, x_r, y₁, …, y_s)`: `none` is
`x₀`, `some (inl i)` is `x_i` and `some (inr j)` is `y_j`. -/
abbrev CoordIndex (r s : ℕ) := Option (Fin r ⊕ Fin s)

/-- The family `(a, b₁, …, b_r, c₁, …, c_s)` indexed by `PE5V r s`. -/
def coordFamily {B : Type*} {r s : ℕ} (a : B) (b : Fin r → B) (c : Fin s → B) : CoordIndex r s → B
  | none => a
  | some (Sum.inl i) => b i
  | some (Sum.inr j) => c j

/-- The weight counting the variables `x₁, …, x_r`. -/
def xWeight {r s : ℕ} : CoordIndex r s → ℕ
  | some (Sum.inl _) => 1
  | _ => 0

/-- The `x`-degree of a monomial (its degree in `x₁, …, x_r`). -/
noncomputable def xDeg {r s : ℕ} : (CoordIndex r s →₀ ℕ) →+ ℕ := Finsupp.weight xWeight

/-- The monomial `x₀^{a₀} x^a y^b` of `R` becomes `x₀^{a₀ + |a|} (x/x₀)^a y^b` in `R₁`. -/
noncomputable def exponentShift {r s : ℕ} (γ : CoordIndex r s →₀ ℕ) : CoordIndex r s →₀ ℕ :=
  γ + Finsupp.single none (xDeg γ)

/-- The value `z^γ = ∏ z_v^{γ_v}` of a monomial. -/
noncomputable def monomialVal {B : Type*} [CommMonoid B] {r s : ℕ} (z : CoordIndex r s → B)
    (γ : CoordIndex r s →₀ ℕ) : B :=
  γ.prod fun v e => z v ^ e

variable {r s : ℕ}

theorem xDeg_single (v : CoordIndex r s) (n : ℕ) :
    xDeg (Finsupp.single v n) = n * xWeight v := by
  simp [xDeg, Finsupp.weight_apply, Finsupp.sum_single_index]

theorem xDeg_exponentShift (γ : CoordIndex r s →₀ ℕ) : xDeg (exponentShift γ) = xDeg γ := by
  rw [exponentShift, map_add, xDeg_single]
  simp [xWeight]

theorem degree_exponentShift (γ : CoordIndex r s →₀ ℕ) : (exponentShift γ).degree = γ.degree + xDeg γ := by
  rw [exponentShift, map_add, Finsupp.degree_single]

theorem exponentShift_injective : Function.Injective (exponentShift (r := r) (s := s)) := by
  intro γ γ' h
  have hx : xDeg γ = xDeg γ' := by rw [← xDeg_exponentShift, h, xDeg_exponentShift]
  unfold exponentShift at h
  rw [hx] at h
  exact add_right_cancel h

theorem monomialVal_add {B : Type*} [CommMonoid B] (z : CoordIndex r s → B) (γ δ : CoordIndex r s →₀ ℕ) :
    monomialVal z (γ + δ) = monomialVal z γ * monomialVal z δ :=
  Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)

theorem monomialVal_single {B : Type*} [CommMonoid B] (z : CoordIndex r s → B) (v : CoordIndex r s) (n : ℕ) :
    monomialVal z (Finsupp.single v n) = z v ^ n :=
  Finsupp.prod_single_index (pow_zero _)

theorem monomialVal_exponentShift {B : Type*} [CommMonoid B] (z : CoordIndex r s → B) (γ : CoordIndex r s →₀ ℕ) :
    monomialVal z (exponentShift γ) = z none ^ xDeg γ * monomialVal z γ := by
  rw [exponentShift, monomialVal_add, monomialVal_single, mul_comm]

/-- The image of a monomial under a ring homomorphism `φ` with `φ(z_v) = t^{wx(v)} z₁_v`. -/
theorem map_monomialVal {B B₁ : Type*} [CommRing B] [CommRing B₁] (φ : B →+* B₁)
    (z : CoordIndex r s → B) (z₁ : CoordIndex r s → B₁) (t : B₁) (hz : ∀ v, φ (z v) = t ^ xWeight v * z₁ v)
    (γ : CoordIndex r s →₀ ℕ) : φ (monomialVal z γ) = t ^ xDeg γ * monomialVal z₁ γ := by
  induction γ using Finsupp.induction with
  | zero => simp [monomialVal]
  | single_add a b f _ _ ih =>
    rw [monomialVal_add, monomialVal_add, map_mul, ih, monomialVal_single, monomialVal_single, map_pow, hz,
      map_add, xDeg_single]
    ring

/-- The image of a monomial under a ring homomorphism `φ` with `φ(z_v) = t^{w(v)} z₁_v`. -/
theorem map_monomialVal_weight {B B₁ : Type*} [CommRing B] [CommRing B₁] (φ : B →+* B₁)
    (w : CoordIndex r s → ℕ) (z : CoordIndex r s → B) (z₁ : CoordIndex r s → B₁) (t : B₁)
    (hz : ∀ v, φ (z v) = t ^ w v * z₁ v) (γ : CoordIndex r s →₀ ℕ) :
    φ (monomialVal z γ) = t ^ Finsupp.weight w γ * monomialVal z₁ γ := by
  induction γ using Finsupp.induction with
  | zero => simp [monomialVal]
  | single_add a b f _ _ ih =>
    have hw : Finsupp.weight w (Finsupp.single a b) = b * w a := by
      simp [Finsupp.weight_apply, Finsupp.sum_single_index]
    rw [monomialVal_add, monomialVal_add, map_mul, ih, monomialVal_single, monomialVal_single, map_pow, hz,
      map_add, hw]
    ring

theorem eval_monomial_eq_mul_monomialVal {B : Type*} [CommRing B] (z : CoordIndex r s → B) (γ : CoordIndex r s →₀ ℕ)
    (c : B) : eval z (monomial γ c) = c * monomialVal z γ := by
  rw [eval_monomial]
  rfl

theorem eval_eq_sum_monomialVal {B : Type*} [CommRing B] (z : CoordIndex r s → B)
    (F : MvPolynomial (CoordIndex r s) B) :
    eval z F = ∑ γ ∈ F.support, F.coeff γ * monomialVal z γ := by
  conv_lhs => rw [F.as_sum]
  rw [map_sum]
  exact Finset.sum_congr rfl fun γ _ => eval_monomial_eq_mul_monomialVal _ _ _

end Coord

section CoordSetting

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

/-- Coordinates adapted to a monoidal transform `R₁` of `R` with center `P` which is residually
rational over `R` (p. 210, and the proof of Lemma 14, p. 228): a regular system of parameters
`(x₀, x₁, …, x_r, y₁, …, y_s)` of `R` with `P = (x₀, x₁, …, x_r)R` such that
`(x₀, x₁/x₀, …, x_r/x₀, y₁, …, y_s)` is a regular system of parameters of `R₁`. -/
structure TransformCoord (T : MonoidalTransform R P) where
  r : ℕ
  s : ℕ
  x₀ : R
  x : Fin r → R
  y : Fin s → R
  x' : Fin r → T.ring
  hx' : ∀ i, T.toRing x₀ * x' i = T.toRing (x i)
  hP : P = Ideal.span ({x₀} ∪ Set.range x)
  hM : Ideal.span (Set.range (coordFamily x₀ x y)) = maximalIdeal R
  hdim : ((Fintype.card (CoordIndex r s) : ℕ) : WithBot ℕ∞) = ringKrullDim R
  hM₁ : Ideal.span (Set.range (coordFamily (T.toRing x₀) x' fun j => T.toRing (y j))) =
    maximalIdeal T.ring
  hdim₁ : ((Fintype.card (CoordIndex r s) : ℕ) : WithBot ℕ∞) = ringKrullDim T.ring

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

/-- The regular system of parameters `z = (x₀, x, y)` of `R`. -/
def z : CoordIndex C.r C.s → R := coordFamily C.x₀ C.x C.y

/-- The regular system of parameters `z₁ = (x₀, x/x₀, y)` of `R₁`. -/
noncomputable def z₁ : CoordIndex C.r C.s → T.ring := coordFamily (T.toRing C.x₀) C.x' fun j => T.toRing (C.y j)

/-- The image of `x₀` in `R₁`, a generator of `PR₁`. -/
noncomputable def x₁ : T.ring := T.toRing C.x₀

theorem toRing_z (v : CoordIndex C.r C.s) : T.toRing (C.z v) = C.x₁ ^ xWeight v * C.z₁ v := by
  rcases v with _ | (i | j)
  · simp [z, z₁, coordFamily, xWeight, x₁]
  · simp [z, z₁, coordFamily, xWeight, x₁, C.hx' i]
  · simp [z, z₁, coordFamily, xWeight]

theorem z₁_none : C.z₁ none = C.x₁ := rfl

theorem toRing_monomialVal (γ : CoordIndex C.r C.s →₀ ℕ) :
    T.toRing (monomialVal C.z γ) = C.x₁ ^ xDeg γ * monomialVal C.z₁ γ :=
  map_monomialVal T.toRing C.z C.z₁ C.x₁ C.toRing_z γ

theorem toRing_monomialVal_exponentShift (γ : CoordIndex C.r C.s →₀ ℕ) :
    T.toRing (monomialVal C.z γ) = monomialVal C.z₁ (exponentShift γ) := by
  rw [toRing_monomialVal, monomialVal_exponentShift, z₁_none]

theorem span_z : Ideal.span (Set.range C.z) = maximalIdeal R := C.hM

theorem span_z₁ : Ideal.span (Set.range C.z₁) = maximalIdeal T.ring := C.hM₁

theorem z_mem (v : CoordIndex C.r C.s) : C.z v ∈ maximalIdeal R ^ 1 := by
  rw [pow_one, ← C.span_z]
  exact Ideal.subset_span ⟨v, rfl⟩

theorem z₁_mem (v : CoordIndex C.r C.s) : C.z₁ v ∈ maximalIdeal T.ring ^ 1 := by
  rw [pow_one, ← C.span_z₁]
  exact Ideal.subset_span ⟨v, rfl⟩

theorem x₀_mem : C.x₀ ∈ P :=
  C.hP.ge (Ideal.subset_span (Set.mem_union_left _ rfl))

theorem x_mem (i : Fin C.r) : C.x i ∈ P :=
  C.hP.ge (Ideal.subset_span (Set.mem_union_right _ ⟨i, rfl⟩))

theorem span_x₁ : Ideal.span {C.x₁} = P.map T.toRing := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ C.x₀_mem
  · rw [Ideal.map_le_iff_le_comap]
    refine C.hP.le.trans (Ideal.span_le.mpr ?_)
    rintro a (ha | ⟨i, rfl⟩)
    · rw [Set.mem_singleton_iff.mp ha]
      exact Ideal.subset_span rfl
    · show T.toRing (C.x i) ∈ Ideal.span {C.x₁}
      rw [← C.hx' i]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)

open scoped Classical in
/-- The center `P = (x₀, x₁, …, x_r)R` of a coordinate system is generated by part of a regular
system of parameters of `R`, namely `(x₀, x₁, …, x_r, y₁, …, y_s)` (p. 228: "a minimal base
`(x, x₁, …, x_r)` of `P`" completed by elements `y_b` whose images form a regular system of
parameters of `R/P`). -/
theorem extendsToRSOP :
    ExtendsToRSOP R ({C.x₀} ∪ Finset.image C.x Finset.univ) := by
  set s : Finset R := {C.x₀} ∪ Finset.image C.x Finset.univ ∪ Finset.image C.y Finset.univ with hs
  have hrange : Set.range (coordFamily C.x₀ C.x C.y) = (s : Set R) := by
    ext w
    simp only [hs, Set.mem_range, Finset.coe_union, Finset.coe_singleton, Finset.coe_image,
      Finset.coe_univ, Set.image_univ, Set.mem_union, Set.mem_singleton_iff]
    constructor
    · rintro ⟨_ | (i | j), rfl⟩
      · exact Or.inl (Or.inl rfl)
      · exact Or.inl (Or.inr ⟨i, rfl⟩)
      · exact Or.inr ⟨j, rfl⟩
    · rintro ((rfl | ⟨i, rfl⟩) | ⟨j, rfl⟩)
      · exact ⟨none, rfl⟩
      · exact ⟨some (Sum.inl i), rfl⟩
      · exact ⟨some (Sum.inr j), rfl⟩
  have hspan : Ideal.span (s : Set R) = maximalIdeal R := by rw [← hrange]; exact C.hM
  have hle : (maximalIdeal R).spanFinrank ≤ s.card := by
    have := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) s.finite_toSet
    rw [Set.ncard_coe_finset] at this
    rw [← hspan]
    exact this
  have hge : s.card ≤ Fintype.card (CoordIndex C.r C.s) := by
    have : s = Finset.image (coordFamily C.x₀ C.x C.y) Finset.univ := by
      ext w
      rw [Finset.mem_image, ← Finset.mem_coe, ← hrange, Set.mem_range]
      simp
    rw [this]
    exact Finset.card_image_le.trans_eq Finset.card_univ
  have hreg : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) = ringKrullDim R :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  have hcard : s.card = Fintype.card (CoordIndex C.r C.s) := by
    have h1 : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) =
        (Fintype.card (CoordIndex C.r C.s) : ℕ) := by
      rw [hreg, C.hdim]
    have h2 : (maximalIdeal R).spanFinrank = Fintype.card (CoordIndex C.r C.s) := by
      exact_mod_cast h1
    omega
  refine ⟨s, ?_, hspan, ?_⟩
  · intro w hw
    simp only [hs, Finset.mem_union, Finset.mem_singleton, Finset.mem_image, Finset.mem_univ,
      true_and]
    simp only [Finset.mem_union, Finset.mem_singleton, Finset.mem_image, Finset.mem_univ,
      true_and] at hw
    exact Or.inl hw
  · rw [hcard, C.hdim]

open scoped Classical in
/-- `P = (x₀, x₁, …, x_r)R` as the ideal generated by the finset of `extendsToRSOP`. -/
theorem eq_span_finset :
    P = Ideal.span (↑({C.x₀} ∪ Finset.image C.x Finset.univ) : Set R) := by
  refine C.hP.trans ?_
  congr 1
  ext w
  simp

include C in
/-- `P` is prime: it is generated by part of a regular system of parameters of `R`
(`ExtendsToRSOP.isPrime_span`). -/
theorem isPrime : P.IsPrime := by
  classical
  rw [C.eq_span_finset]
  exact C.extendsToRSOP.isPrime_span

include C in
/-- `R/P` is regular: `P` is generated by part of a regular system of parameters of `R`
(`ExtendsToRSOP.isRegularLocalRing_quotient`). -/
theorem isRegularLocalRing_quotient : IsRegularLocalRing (R ⧸ P) := by
  classical
  rw [C.eq_span_finset]
  exact C.extendsToRSOP.isRegularLocalRing_quotient

/-- The graded isomorphism `k[X] → gr_M(R)` of the coordinates. -/
noncomputable def e : MvPolynomial (CoordIndex C.r C.s) (R ⧸ maximalIdeal R) →ₐ[R ⧸ maximalIdeal R]
    AssocGraded (maximalIdeal R) :=
  aeval fun v => AssocGraded.mk (maximalIdeal R) 1 (C.z v) (C.z_mem v)

theorem e_bijective : Function.Bijective C.e :=
  aeval_mk_bijective C.z C.span_z C.hdim C.z_mem

variable [IsRegularLocalRing T.ring]

/-- The graded isomorphism `k₁[X] → gr_{M₁}(R₁)` of the coordinates. -/
noncomputable def e₁ : MvPolynomial (CoordIndex C.r C.s) (T.ring ⧸ maximalIdeal T.ring) →ₐ[T.ring ⧸
    maximalIdeal T.ring] AssocGraded (maximalIdeal T.ring) :=
  aeval fun v => AssocGraded.mk (maximalIdeal T.ring) 1 (C.z₁ v) (C.z₁_mem v)

theorem e₁_bijective : Function.Bijective C.e₁ :=
  aeval_mk_bijective C.z₁ C.span_z₁ C.hdim₁ C.z₁_mem

end TransformCoord

/-- Coordinates adapted to a residually rational monoidal transform exist (p. 210). -/
theorem TransformCoord.nonempty [P.IsPrime] [IsRegularLocalRing (R ⧸ P)] (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) :
    Nonempty (TransformCoord T) := by
  classical
  have hP0 : P ≠ ⊥ := fun h => T.x_ne_zero (Ideal.mem_bot.mp (h ▸ T.x_mem))
  obtain ⟨r, s, x₀, x, y, hrsop, hcard, hPx, x', hx', hrsop₁⟩ :=
    T.exists_rsop_of_isResiduallyRational inferInstance hP0 inferInstance hrat
  have hrange : ∀ {B : Type u} (a : B) (b : Fin r → B) (c : Fin s → B) [DecidableEq B],
      Set.range (coordFamily a b c) = ↑({a} ∪ Finset.image b Finset.univ ∪ Finset.image c Finset.univ) := by
    intro B a b c _
    ext w
    simp only [Set.mem_range, Finset.coe_union, Finset.coe_singleton, Finset.coe_image,
      Finset.coe_univ, Set.image_univ, Set.mem_union, Set.mem_singleton_iff]
    constructor
    · rintro ⟨_ | (i | j), rfl⟩
      · exact Or.inl (Or.inl rfl)
      · exact Or.inl (Or.inr ⟨i, rfl⟩)
      · exact Or.inr ⟨j, rfl⟩
    · rintro ((rfl | ⟨i, rfl⟩) | ⟨j, rfl⟩)
      · exact ⟨none, rfl⟩
      · exact ⟨some (Sum.inl i), rfl⟩
      · exact ⟨some (Sum.inr j), rfl⟩
  have hcardV : Fintype.card (CoordIndex r s) = r + 1 + s := by
    simp only [Fintype.card_option, Fintype.card_sum, Fintype.card_fin]
    omega
  have hdim : ((Fintype.card (CoordIndex r s) : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
    rw [hcardV, ← hcard]
    exact hrsop.2
  have halg : RingHom.IsResiduallyAlgebraic (R := R) (R' := T.ring) T.toRing := by
    let _ : Algebra (ResidueField R) (ResidueField T.ring) := (ResidueField.map T.toRing).toAlgebra
    show Algebra.IsAlgebraic (ResidueField R) (ResidueField T.ring)
    refine ⟨fun w => ?_⟩
    obtain ⟨c, rfl⟩ := hrat w
    exact isAlgebraic_algebraMap c
  have hdim₁ : ringKrullDim T.ring = ringKrullDim R :=
    (T.ringKrullDim_eq_iff inferInstance hP0 inferInstance).mpr halg
  have hM : Ideal.span (Set.range (coordFamily x₀ x y)) = maximalIdeal R := by
    rw [hrange]; exact hrsop.1
  have hM₁ : Ideal.span (Set.range (coordFamily (T.toRing x₀) x' fun j => T.toRing (y j))) =
      maximalIdeal T.ring := by
    rw [hrange]; exact hrsop₁.1
  have hdim₁' : ((Fintype.card (CoordIndex r s) : ℕ) : WithBot ℕ∞) = ringKrullDim T.ring := by
    rw [hdim₁]; exact hdim
  exact ⟨⟨r, s, x₀, x, y, x', hx', hPx, hM, hdim, hM₁, hdim₁'⟩⟩

end CoordSetting

section CoordPhi

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

/-- The weight counting `x₀, x₁, …, x_r` (the generators of `P`). -/
def pWeight {r s : ℕ} : CoordIndex r s → ℕ
  | some (Sum.inr _) => 0
  | _ => 1

/-- The `P`-degree of a monomial. -/
noncomputable def pDeg {r s : ℕ} : (CoordIndex r s →₀ ℕ) →+ ℕ := Finsupp.weight pWeight

/-- The family `(1, x/x₀, y)` in `R₁`. -/
def coordFamilyOfOne {B : Type*} [One B] {r s : ℕ} (b : Fin r → B) (c : Fin s → B) : CoordIndex r s → B :=
  coordFamily 1 b c

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

theorem toRing_z_eq_pow_pWeight_mul (v : CoordIndex C.r C.s) :
    T.toRing (C.z v) = C.x₁ ^ pWeight v * coordFamilyOfOne C.x' (fun j => T.toRing (C.y j)) v := by
  rcases v with _ | (i | j)
  · simp [z, coordFamilyOfOne, coordFamily, pWeight, x₁]
  · simp [z, coordFamilyOfOne, coordFamily, pWeight, x₁, C.hx' i]
  · simp [z, coordFamilyOfOne, coordFamily, pWeight]

/-- `x₀^{a₀} x^a y^b` is divisible by `x₀^{a₀ + |a|}` in `R₁`. -/
theorem toRing_monomialVal_eq_pow_pDeg_mul (γ : CoordIndex C.r C.s →₀ ℕ) :
    T.toRing (monomialVal C.z γ) =
      C.x₁ ^ pDeg γ * monomialVal (coordFamilyOfOne C.x' fun j => T.toRing (C.y j)) γ :=
  map_monomialVal_weight T.toRing pWeight C.z _ C.x₁ C.toRing_z_eq_pow_pWeight_mul γ

/-- A section of `R → R/M` sending `0` to `0`. -/
noncomputable def lift (c : R ⧸ maximalIdeal R) : R :=
  open Classical in if c = 0 then 0 else Classical.choose (Ideal.Quotient.mk_surjective c)

omit [IsDomain R] in
theorem mk_lift (c : R ⧸ maximalIdeal R) : Ideal.Quotient.mk _ (lift c) = c := by
  classical
  unfold lift
  split_ifs with h
  · rw [h, map_zero]
  · exact Classical.choose_spec (Ideal.Quotient.mk_surjective c)

omit [IsDomain R] in
theorem lift_zero : lift (0 : R ⧸ maximalIdeal R) = 0 := by
  unfold lift
  simp

/-- The polynomial `Φ(F)` over `R₁` with `Φ(F)(x₀, x/x₀, y) = F(x₀, x, y)`. -/
noncomputable def Φ (F : MvPolynomial (CoordIndex C.r C.s) R) : MvPolynomial (CoordIndex C.r C.s) T.ring :=
  ∑ γ ∈ F.support, monomial (exponentShift γ) (T.toRing (F.coeff γ))

theorem coeff_transformPoly_exponentShift (F : MvPolynomial (CoordIndex C.r C.s) R) (γ : CoordIndex C.r C.s →₀ ℕ) :
    (C.Φ F).coeff (exponentShift γ) = T.toRing (F.coeff γ) := by
  classical
  rw [Φ, coeff_sum]
  simp only [coeff_monomial, exponentShift_injective.eq_iff]
  rw [Finset.sum_ite_eq']
  split_ifs with h
  · rfl
  · rw [notMem_support_iff.mp h, map_zero]

theorem coeff_transformPoly_of_notMem (F : MvPolynomial (CoordIndex C.r C.s) R) (δ : CoordIndex C.r C.s →₀ ℕ)
    (h : ∀ γ, exponentShift γ ≠ δ) : (C.Φ F).coeff δ = 0 := by
  classical
  rw [Φ, coeff_sum]
  refine Finset.sum_eq_zero fun γ _ => ?_
  simp [coeff_monomial, h γ]

theorem mem_support_transformPoly {F : MvPolynomial (CoordIndex C.r C.s) R} {δ : CoordIndex C.r C.s →₀ ℕ} :
    δ ∈ (C.Φ F).support ↔ ∃ γ ∈ F.support, exponentShift γ = δ := by
  constructor
  · intro hδ
    by_contra h
    push Not at h
    refine mem_support_iff.mp hδ (C.coeff_transformPoly_of_notMem F δ fun γ hγ => ?_)
    by_cases hγF : γ ∈ F.support
    · exact h γ hγF hγ
    · apply mem_support_iff.mp hδ
      rw [← hγ, coeff_transformPoly_exponentShift, notMem_support_iff.mp hγF, map_zero]
  · rintro ⟨γ, hγ, rfl⟩
    rw [mem_support_iff, coeff_transformPoly_exponentShift]
    exact fun h0 => mem_support_iff.mp hγ (T.toRing_injective (by rw [h0, map_zero]))

theorem eval_z_eq_sum (F : MvPolynomial (CoordIndex C.r C.s) R) :
    eval C.z F = ∑ γ ∈ F.support, F.coeff γ * monomialVal C.z γ :=
  eval_eq_sum_monomialVal C.z F

theorem eval_z₁_transformPoly (F : MvPolynomial (CoordIndex C.r C.s) R) :
    eval C.z₁ (C.Φ F) = T.toRing (eval C.z F) := by
  rw [Φ, map_sum, eval_z_eq_sum, map_sum]
  refine Finset.sum_congr rfl fun γ _ => ?_
  rw [eval_monomial_eq_mul_monomialVal, map_mul, C.toRing_monomialVal_exponentShift]

theorem le_degree_of_mem_support_transformPoly {F : MvPolynomial (CoordIndex C.r C.s) R} {N : ℕ}
    (hF : ∀ γ ∈ F.support, N ≤ (exponentShift γ).degree) : ∀ δ ∈ (C.Φ F).support, N ≤ δ.degree := by
  intro δ hδ
  obtain ⟨γ, hγ, rfl⟩ := C.mem_support_transformPoly.mp hδ
  exact hF γ hγ

/-- **The key weighted computation.** If `f ≡ F(x₀, x, y) mod M^{D+1}` and every monomial of `F`
has weight `≥ w₀` (the weights of `x₀, xᵢ, y_j` being `1, 2, 1`), then `f ∈ M₁^{w₀}` in `R₁`, and
for `w₀ ≤ D` its class in degree `w₀` is the reduction of the weight-`w₀` part of `Φ(F)`. -/
theorem toRing_mem_pow_of_expansion (f : R) (F : MvPolynomial (CoordIndex C.r C.s) R) (D : ℕ)
    (hfF : f - eval C.z F ∈ maximalIdeal R ^ (D + 1)) (w₀ : ℕ) (hw₀ : w₀ ≤ D + 1)
    (hF : ∀ γ ∈ F.support, w₀ ≤ (exponentShift γ).degree) :
    T.toRing f ∈ maximalIdeal T.ring ^ w₀ := by
  have h1 : T.toRing f = eval C.z₁ (C.Φ F) + T.toRing (f - eval C.z F) := by
    rw [eval_z₁_transformPoly, map_sub]; ring
  have h2 : T.toRing (f - eval C.z F) ∈ maximalIdeal T.ring ^ (D + 1) := by
    have := Ideal.mem_map_of_mem T.toRing hfF
    rw [Ideal.map_pow] at this
    exact Ideal.pow_right_mono (map_maximalIdeal_le T.toRing) _ this
  rw [h1]
  exact add_mem (eval_mem_pow_of_le_degree _ C.z₁ C.span_z₁ _ w₀ (C.le_degree_of_mem_support_transformPoly hF))
    (Ideal.pow_le_pow_right hw₀ h2)

theorem mk_toRing_of_expansion (f : R) (F : MvPolynomial (CoordIndex C.r C.s) R) (D : ℕ)
    (hfF : f - eval C.z F ∈ maximalIdeal R ^ (D + 1)) (w₀ : ℕ) (hw₀ : w₀ ≤ D)
    (hF : ∀ γ ∈ F.support, w₀ ≤ (exponentShift γ).degree) :
    AssocGraded.mk (maximalIdeal T.ring) w₀ (T.toRing f)
        (C.toRing_mem_pow_of_expansion f F D hfF w₀ (by omega) hF) =
      C.e₁ ((homogeneousComponent w₀ (C.Φ F)).map (Ideal.Quotient.mk _)) := by
  have h1 : T.toRing f = eval C.z₁ (C.Φ F) + T.toRing (f - eval C.z F) := by
    rw [eval_z₁_transformPoly, map_sub]; ring
  have h2 : T.toRing (f - eval C.z F) ∈ maximalIdeal T.ring ^ (w₀ + 1) := by
    have := Ideal.mem_map_of_mem T.toRing hfF
    rw [Ideal.map_pow] at this
    exact Ideal.pow_le_pow_right (by omega)
      (Ideal.pow_right_mono (map_maximalIdeal_le T.toRing) _ this)
  have hmem := eval_mem_pow_of_le_degree _ C.z₁ C.span_z₁ _ w₀ (C.le_degree_of_mem_support_transformPoly hF)
  rw [AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ _ hmem (by rw [h1, add_sub_cancel_left]; exact h2)]
  exact mk_eval_eq_aeval C.z₁ C.z₁_mem C.span_z₁ _ w₀ (C.le_degree_of_mem_support_transformPoly hF)

end TransformCoord

end CoordPhi

section CoordOrders

theorem _root_.IsLocalHom.map_mem_maximalIdeal_iff {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A]
    [IsLocalRing B] (f : A →+* B) [IsLocalHom f] (a : A) :
    f a ∈ maximalIdeal B ↔ a ∈ maximalIdeal A := by
  simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

theorem exponentShift_none_eq_pDeg {r s : ℕ} (γ : CoordIndex r s →₀ ℕ) : (exponentShift γ) none = pDeg γ := by
  rw [exponentShift, Finsupp.add_apply, Finsupp.single_eq_same]
  induction γ using Finsupp.induction with
  | zero => simp [pDeg]
  | single_add a b f _ _ ih =>
    rw [Finsupp.add_apply, map_add, map_add, xDeg_single]
    have h2 : pDeg (Finsupp.single a b) = b * pWeight a := by
      simp [pDeg, Finsupp.weight_apply, Finsupp.sum_single_index]
    rw [h2]
    rcases a with _ | (i | j)
    · simp [xWeight, pWeight]; omega
    · simp [xWeight, pWeight]; omega
    · simp [xWeight, pWeight]; omega

theorem degree_eq_pDeg_add_sum {r s : ℕ} (γ : CoordIndex r s →₀ ℕ) :
    γ.degree = pDeg γ + ∑ j : Fin s, γ (some (Sum.inr j)) := by
  induction γ using Finsupp.induction with
  | zero => simp [pDeg]
  | single_add a b f _ _ ih =>
    rw [map_add, map_add, ih, Finsupp.degree_single]
    have h2 : pDeg (Finsupp.single a b) = b * pWeight a := by
      simp [pDeg, Finsupp.weight_apply, Finsupp.sum_single_index]
    rw [h2]
    simp only [Finsupp.add_apply, Finset.sum_add_distrib]
    rcases a with _ | (i | j)
    · simp [pWeight]; omega
    · simp [pWeight]; omega
    · simp only [pWeight, mul_zero, zero_add, Finsupp.single_apply, Option.some.injEq,
        Sum.inr.injEq]
      rw [Finset.sum_ite_eq]
      simp only [Finset.mem_univ, ↓reduceIte]
      omega

theorem xDeg_le_pDeg {r s : ℕ} (γ : CoordIndex r s →₀ ℕ) : xDeg γ ≤ pDeg γ := by
  have := exponentShift_none_eq_pDeg γ
  rw [exponentShift, Finsupp.add_apply, Finsupp.single_eq_same] at this
  omega

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

/-- An expansion of `f ∈ Mᵘ` up to degree `D`. -/
theorem exists_expansion (f : R) (μ : ℕ) (hf : f ∈ maximalIdeal R ^ μ) (D : ℕ)
    (hD : μ ≤ D + 1) :
    ∃ F : MvPolynomial (CoordIndex C.r C.s) R, (∀ γ, F.coeff γ ∈ Set.range lift) ∧
      (∀ γ ∈ F.support, μ ≤ γ.degree ∧ γ.degree ≤ D) ∧
      f - eval C.z F ∈ maximalIdeal R ^ (D + 1) := by
  obtain ⟨F, h1, h2, h3⟩ := exists_eval_sub_mem_pow (maximalIdeal R) C.z C.span_z lift mk_lift
    lift_zero f μ hf (D + 1) hD
  exact ⟨F, h1, fun γ hγ => ⟨(h2 γ hγ).1, by have := (h2 γ hγ).2; omega⟩, h3⟩

theorem mk_coeff_ne_zero {F : MvPolynomial (CoordIndex C.r C.s) R}
    (hF : ∀ γ, F.coeff γ ∈ Set.range lift) {γ : CoordIndex C.r C.s →₀ ℕ} (hγ : γ ∈ F.support) :
    Ideal.Quotient.mk (maximalIdeal R) (F.coeff γ) ≠ 0 := by
  obtain ⟨c, hc⟩ := hF γ
  rw [← hc, mk_lift]
  rintro rfl
  exact mem_support_iff.mp hγ (by rw [← hc, lift_zero])

/-- The class of `f` in degree `μ` is the reduction of the degree-`μ` part of an expansion. -/
theorem mk_eq_e_of_expansion (f : R) (μ : ℕ) (hf : f ∈ maximalIdeal R ^ μ)
    (F : MvPolynomial (CoordIndex C.r C.s) R) (D : ℕ) (hμD : μ ≤ D)
    (hdeg : ∀ γ ∈ F.support, μ ≤ γ.degree)
    (hfF : f - eval C.z F ∈ maximalIdeal R ^ (D + 1)) :
    AssocGraded.mk (maximalIdeal R) μ f hf =
      C.e ((homogeneousComponent μ F).map (Ideal.Quotient.mk _)) := by
  have hmem := eval_mem_pow_of_le_degree _ C.z C.span_z F μ hdeg
  rw [AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ hf hmem (Ideal.pow_le_pow_right (by omega) hfF)]
  exact mk_eval_eq_aeval C.z C.z_mem C.span_z F μ hdeg

theorem initialForm_x₁ [IsRegularLocalRing T.ring] :
    Ideal.ordElem (maximalIdeal T.ring) C.x₁ = 1 ∧
      initialForm (maximalIdeal T.ring) C.x₁ = C.e₁ (X none) := by
  have hmem : C.x₁ ∈ maximalIdeal T.ring ^ 1 := C.z₁_mem none
  have hmk : AssocGraded.mk (maximalIdeal T.ring) 1 C.x₁ hmem = C.e₁ (X none) := by
    rw [e₁, aeval_X]
    rfl
  have hne : AssocGraded.mk (maximalIdeal T.ring) 1 C.x₁ hmem ≠ 0 := by
    rw [hmk, ← map_zero C.e₁]
    exact fun h => X_ne_zero _ (C.e₁_bijective.1 h)
  obtain ⟨h1, h2⟩ := Ideal.ordElem_eq_of_mk_ne_zero _ hmem hne
  exact ⟨h1, h2.trans hmk⟩

theorem initialForm_x₁_pow [IsRegularLocalRing T.ring] (n : ℕ) :
    initialForm (maximalIdeal T.ring) (C.x₁ ^ n) = C.e₁ (X none ^ n) := by
  induction n with
  | zero =>
    rw [pow_zero, pow_zero, map_one]
    have hmem : (1 : T.ring) ∈ maximalIdeal T.ring ^ 0 := by simp
    have hne : AssocGraded.mk (maximalIdeal T.ring) 0 1 hmem ≠ 0 := by
      rw [Ne, AssocGraded.mk_eq_zero_iff, zero_add, pow_one]
      exact fun h => (maximalIdeal.isMaximal T.ring).ne_top ((Ideal.eq_top_iff_one _).mpr h)
    rw [(Ideal.ordElem_eq_of_mk_ne_zero _ hmem hne).2]
    show Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ _
    rfl
  | succ n ih =>
    rw [pow_succ, initialForm_mul_maximalIdeal, ih, C.initialForm_x₁.2, pow_succ, map_mul]

/-- The weight of a monomial (`x₀, y_j` of weight `1`, `x_i` of weight `2`). -/
noncomputable abbrev wt (γ : CoordIndex C.r C.s →₀ ℕ) : ℕ := (exponentShift γ).degree

variable [IsRegularLocalRing T.ring]

/-- **(W1)** The order of `f` in `R₁` is the least weight of a monomial of an expansion. -/
theorem ordElem_toRing_of_expansion (f : R) (F : MvPolynomial (CoordIndex C.r C.s) R)
    (hF : ∀ γ, F.coeff γ ∈ Set.range lift) (D : ℕ)
    (hfF : f - eval C.z F ∈ maximalIdeal R ^ (D + 1)) (γ₀ : CoordIndex C.r C.s →₀ ℕ)
    (hγ₀ : γ₀ ∈ F.support) (hγ₀D : C.wt γ₀ ≤ D) (hmin : ∀ γ ∈ F.support, C.wt γ₀ ≤ C.wt γ) :
    Ideal.ordElem (maximalIdeal T.ring) (T.toRing f) = C.wt γ₀ ∧
      initialForm (maximalIdeal T.ring) (T.toRing f) =
        C.e₁ ((homogeneousComponent (C.wt γ₀) (C.Φ F)).map (Ideal.Quotient.mk _)) := by
  have hmk := C.mk_toRing_of_expansion f F D hfF (C.wt γ₀) hγ₀D hmin
  have hne : (homogeneousComponent (C.wt γ₀) (C.Φ F)).map
      (Ideal.Quotient.mk (maximalIdeal T.ring)) ≠ 0 := by
    intro h0
    have h1 := congrArg (fun p : MvPolynomial (CoordIndex C.r C.s) (T.ring ⧸ maximalIdeal T.ring) => p.coeff (exponentShift γ₀)) h0
    simp only [coeff_map, coeff_homogeneousComponent, wt, ↓reduceIte, coeff_transformPoly_exponentShift] at h1
    have h1' : T.toRing (F.coeff γ₀) ∈ maximalIdeal T.ring := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simpa using h1
    have h2 : F.coeff γ₀ ∉ maximalIdeal R := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact C.mk_coeff_ne_zero hF hγ₀
    exact h2 ((IsLocalHom.map_mem_maximalIdeal_iff T.toRing _).mp h1')
  have hmem : T.toRing f ∈ maximalIdeal T.ring ^ C.wt γ₀ :=
    C.toRing_mem_pow_of_expansion f F D hfF (C.wt γ₀) (by omega) hmin
  have hne' : AssocGraded.mk (maximalIdeal T.ring) (C.wt γ₀) (T.toRing f) hmem ≠ 0 := by
    rw [hmk, ← map_zero C.e₁]
    exact fun h => hne (C.e₁_bijective.1 h)
  obtain ⟨h1, h2⟩ := Ideal.ordElem_eq_of_mk_ne_zero _ _ hne'
  exact ⟨h1, h2.trans hmk⟩

/-- **(W2)** If `f ∈ M₁ᴺ` in `R₁`, every monomial of an expansion of `f` has weight `≥ N`. -/
theorem le_wt_of_toRing_mem (f : R) (F : MvPolynomial (CoordIndex C.r C.s) R)
    (hF : ∀ γ, F.coeff γ ∈ Set.range lift) (D : ℕ)
    (hfF : f - eval C.z F ∈ maximalIdeal R ^ (D + 1)) (N : ℕ) (hND : N ≤ D + 1)
    (hN : T.toRing f ∈ maximalIdeal T.ring ^ N) : ∀ γ ∈ F.support, N ≤ C.wt γ := by
  by_contra hcon
  push Not at hcon
  obtain ⟨γ₁, hγ₁, hγ₁N⟩ := hcon
  obtain ⟨γ₀, hγ₀, hmin⟩ := F.support.exists_min_image C.wt ⟨γ₁, hγ₁⟩
  have hle := hmin γ₁ hγ₁
  have h := (C.ordElem_toRing_of_expansion f F hF D hfF γ₀ hγ₀ (by omega) hmin).1
  have h' := Ideal.le_ordElem hN
  rw [h, Nat.cast_le] at h'
  omega

end TransformCoord

end CoordOrders

section Restrict

variable {A : Type u} [CommRing A] {σ : Type*}

/-- The part of a polynomial supported on the monomials satisfying `p`. -/
noncomputable def restrictSupport (p : (σ →₀ ℕ) → Prop) [DecidablePred p] (F : MvPolynomial σ A) :
    MvPolynomial σ A :=
  ∑ γ ∈ F.support.filter p, monomial γ (F.coeff γ)

theorem coeff_restrictSupport (p : (σ →₀ ℕ) → Prop) [DecidablePred p] (F : MvPolynomial σ A)
    (β : σ →₀ ℕ) : (restrictSupport p F).coeff β = if p β then F.coeff β else 0 := by
  classical
  rw [restrictSupport, coeff_sum]
  simp only [coeff_monomial]
  rw [Finset.sum_ite_eq']
  by_cases hp : p β
  · simp only [hp, ↓reduceIte]
    split_ifs with h
    · rfl
    · rw [Finset.mem_filter] at h
      push Not at h
      by_cases hβ : β ∈ F.support
      · exact absurd hp (h hβ)
      · exact (notMem_support_iff.mp hβ).symm
  · have hnm : β ∉ F.support.filter p := fun h => hp (Finset.mem_filter.mp h).2
    simp only [hp, hnm, ↓reduceIte]

theorem mem_support_restrictSupport {p : (σ →₀ ℕ) → Prop} [DecidablePred p] {F : MvPolynomial σ A}
    {β : σ →₀ ℕ} : β ∈ (restrictSupport p F).support ↔ β ∈ F.support ∧ p β := by
  rw [mem_support_iff, mem_support_iff, coeff_restrictSupport]
  split_ifs with h <;> simp [h]

theorem restrictSupport_add_restrictSupport_not (p : (σ →₀ ℕ) → Prop) [DecidablePred p]
    (F : MvPolynomial σ A) : restrictSupport p F + restrictSupport (fun β => ¬ p β) F = F := by
  ext β
  rw [MvPolynomial.coeff_add, coeff_restrictSupport, coeff_restrictSupport]
  split_ifs <;> simp_all

end Restrict

section ClaimA

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

/-- A monomial in `x₁, …, x_r` only. -/
def IsPure {r s : ℕ} (β : CoordIndex r s →₀ ℕ) : Prop := β none = 0 ∧ ∀ j, β (some (Sum.inr j)) = 0

instance {r s : ℕ} (β : CoordIndex r s →₀ ℕ) : Decidable (IsPure β) := by
  unfold IsPure; infer_instance

theorem isPure_iff_forall_mem_support {r s : ℕ} (β : CoordIndex r s →₀ ℕ) :
    IsPure β ↔ ∀ v ∈ β.support, xWeight v = 1 := by
  constructor
  · rintro ⟨h0, hy⟩ v hv
    rw [Finsupp.mem_support_iff] at hv
    rcases v with _ | (i | j)
    · exact absurd h0 hv
    · rfl
    · exact absurd (hy j) hv
  · intro h
    refine ⟨?_, fun j => ?_⟩
    · by_contra h0
      have := h none (Finsupp.mem_support_iff.mpr h0)
      simp [xWeight] at this
    · by_contra h0
      have := h _ (Finsupp.mem_support_iff.mpr h0)
      simp [xWeight] at this

theorem isPure_of_degree_eq_pDeg {r s : ℕ} {β : CoordIndex r s →₀ ℕ} (h0 : β none = 0)
    (hd : β.degree = pDeg β) : IsPure β := by
  refine ⟨h0, fun j => ?_⟩
  have := degree_eq_pDeg_add_sum β
  rw [hd] at this
  have hsum : ∑ j : Fin s, β (some (Sum.inr j)) = 0 := by omega
  exact (Finset.sum_eq_zero_iff.mp hsum) j (Finset.mem_univ _)

theorem xDeg_eq_degree_of_isPure {r s : ℕ} {β : CoordIndex r s →₀ ℕ} (h : IsPure β) :
    xDeg β = β.degree := by
  have h1 := exponentShift_none_eq_pDeg β
  rw [exponentShift, Finsupp.add_apply, Finsupp.single_eq_same, h.1, zero_add] at h1
  have h2 := degree_eq_pDeg_add_sum β
  simp only [h.2, Finset.sum_const_zero, add_zero] at h2
  omega

variable {r s : ℕ} (k : Type*) [CommRing k]

/-- The substitution `X₀ ↦ 0`, `X_i ↦ X_i`, `Y_j ↦ 0`. -/
noncomputable def pureSubst : MvPolynomial (CoordIndex r s) k →ₐ[k] MvPolynomial (CoordIndex r s) k :=
  aeval fun v => if xWeight v = 1 then X v else 0

variable {k}

theorem pureSubst_monomial (β : CoordIndex r s →₀ ℕ) (c : k) :
    pureSubst k (monomial β c) = if IsPure β then monomial β c else 0 := by
  classical
  rw [pureSubst, aeval_monomial]
  split_ifs with h
  · rw [monomial_eq]
    congr 1
    refine Finsupp.prod_congr fun v hv => ?_
    simp only [(isPure_iff_forall_mem_support β).mp h v hv, ↓reduceIte]
  · rw [isPure_iff_forall_mem_support] at h
    push Not at h
    obtain ⟨v, hv, hv1⟩ := h
    rw [Finsupp.prod, Finset.prod_eq_zero hv, mul_zero]
    simp only [hv1, ↓reduceIte]
    exact zero_pow (Finsupp.mem_support_iff.mp hv)

theorem coeff_pureSubst (G : MvPolynomial (CoordIndex r s) k) (β : CoordIndex r s →₀ ℕ) :
    (pureSubst k G).coeff β = if IsPure β then G.coeff β else 0 := by
  classical
  conv_lhs => rw [G.as_sum]
  rw [map_sum, coeff_sum]
  simp only [pureSubst_monomial]
  have : ∀ γ ∈ G.support, (if IsPure γ then monomial γ (G.coeff γ) else 0).coeff β =
      if γ = β then (if IsPure β then G.coeff β else 0) else 0 := by
    intro γ _
    split_ifs with h1 h2 h3 h3 <;> simp_all [coeff_monomial]
  rw [Finset.sum_congr rfl this, Finset.sum_ite_eq']
  split_ifs with h1 h2 <;> simp_all

end ClaimA

section ClaimA2

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

/-- The residue field isomorphism `k = R/M ≅ R₁/M₁` of a residually rational monoidal
transform. -/
noncomputable def MonoidalTransform.residueEquiv (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) :
    (R ⧸ maximalIdeal R) ≃+* (T.ring ⧸ maximalIdeal T.ring) :=
  RingEquiv.ofBijective (ResidueField.map T.toRing) ⟨(ResidueField.map T.toRing).injective, hrat⟩

theorem MonoidalTransform.residueEquiv_mk (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (a : R) :
    T.residueEquiv hrat (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (T.toRing a) := rfl

theorem MonoidalTransform.residueEquiv_symm_mk (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (a : R) :
    (T.residueEquiv hrat).symm (Ideal.Quotient.mk _ (T.toRing a)) = Ideal.Quotient.mk _ a := by
  rw [RingEquiv.symm_apply_eq, MonoidalTransform.residueEquiv_mk]

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]

/-- The homomorphism `ρ : gr_{M₁}(R₁) → gr_M(R)` of graded `k`-algebras with `ρ(X) = ρ(Y_j) = 0`
and `ρ(X_i) = X_i` (proof of Lemma 15, p. 231). -/
noncomputable def ρ (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) :
    AssocGraded (maximalIdeal T.ring) →+* AssocGraded (maximalIdeal R) :=
  C.e.toRingHom.comp ((pureSubst (R ⧸ maximalIdeal R)).toRingHom.comp
    ((MvPolynomial.map (T.residueEquiv hrat).symm.toRingHom).comp
      (RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm.toRingHom))

theorem ρ_e₁ (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (q : MvPolynomial (CoordIndex C.r C.s) (T.ring ⧸ maximalIdeal T.ring)) :
    C.ρ hrat (C.e₁ q) = C.e (pureSubst _ (q.map (T.residueEquiv hrat).symm.toRingHom)) := by
  show C.e (pureSubst _ (MvPolynomial.map (T.residueEquiv hrat).symm.toRingHom
    ((RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm
      (RingEquiv.ofBijective C.e₁ C.e₁_bijective q)))) = _
  rw [RingEquiv.symm_apply_apply]

/-- **(W3)** If `f` is divisible by `x₀^ν` in `R₁`, every monomial of an expansion of `f` of
weight at most `D` has `P`-degree `≥ ν`. -/
theorem le_pDeg_of_x₁_pow_mul_eq (f : R) (F : MvPolynomial (CoordIndex C.r C.s) R)
    (hF : ∀ γ, F.coeff γ ∈ Set.range lift) (D : ℕ)
    (hfF : f - eval C.z F ∈ maximalIdeal R ^ (D + 1)) (ν : ℕ) (a : T.ring)
    (ha : C.x₁ ^ ν * a = T.toRing f) :
    ∀ γ ∈ F.support, C.wt γ ≤ D → ν ≤ pDeg γ := by
  classical
  by_contra hcon
  push Not at hcon
  obtain ⟨γ₁, hγ₁, hγ₁D, hγ₁ν⟩ := hcon
  set F' := restrictSupport (fun γ => pDeg γ < ν) F with hF'
  set F'' := restrictSupport (fun γ => ¬ pDeg γ < ν) F with hF''
  have hF'c : ∀ γ, F'.coeff γ ∈ Set.range lift := by
    intro γ
    rw [coeff_restrictSupport]
    split_ifs
    · exact hF γ
    · exact ⟨0, lift_zero⟩
  have hγ₁' : γ₁ ∈ F'.support := mem_support_restrictSupport.mpr ⟨hγ₁, hγ₁ν⟩
  obtain ⟨γ₀, hγ₀, hmin⟩ := F'.support.exists_min_image C.wt ⟨γ₁, hγ₁'⟩
  have hγ₀D : C.wt γ₀ ≤ D := (hmin γ₁ hγ₁').trans hγ₁D
  have hW1 := C.ordElem_toRing_of_expansion (eval C.z F') F' hF'c D (by simp) γ₀ hγ₀ hγ₀D hmin
  -- `F''(x₀, x, y)` is divisible by `x₀^ν` in `R₁`
  have hdiv : T.toRing (eval C.z F'') ∈ Ideal.span {C.x₁ ^ ν} := by
    rw [C.eval_z_eq_sum, map_sum]
    refine Ideal.sum_mem _ fun γ hγ => ?_
    rw [map_mul, C.toRing_monomialVal_eq_pow_pDeg_mul]
    have hle : ν ≤ pDeg γ := not_lt.mp (mem_support_restrictSupport.mp hγ).2
    rw [← Nat.add_sub_cancel' hle, pow_add]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
      (Ideal.subset_span rfl)))
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hdiv
  set m := T.toRing (f - eval C.z F) with hm
  have hmD : m ∈ maximalIdeal T.ring ^ (D + 1) := by
    have := Ideal.mem_map_of_mem T.toRing hfF
    rw [Ideal.map_pow] at this
    exact Ideal.pow_right_mono (map_maximalIdeal_le T.toRing) _ this
  have hsplit : C.x₁ ^ ν * (a - b) = T.toRing (eval C.z F') + m := by
    have h1 : eval C.z F = eval C.z F' + eval C.z F'' := by
      rw [← map_add, restrictSupport_add_restrictSupport_not]
    rw [hm, map_sub, h1, map_add, mul_sub, ha, hb]
    ring
  set w₀ := C.wt γ₀
  have hmem1 : T.toRing (eval C.z F') ∈ maximalIdeal T.ring ^ w₀ :=
    Ideal.mem_pow_of_ordElem hW1.1
  have hmem2 : C.x₁ ^ ν * (a - b) ∈ maximalIdeal T.ring ^ w₀ := by
    rw [hsplit]
    exact add_mem hmem1 (Ideal.pow_le_pow_right (by omega) hmD)
  have hin1 := initialForm_eq_mk (maximalIdeal T.ring) hW1.1
  have hmkeq : AssocGraded.mk (maximalIdeal T.ring) w₀ (C.x₁ ^ ν * (a - b)) hmem2 =
      AssocGraded.mk (maximalIdeal T.ring) w₀ (T.toRing (eval C.z F')) hmem1 := by
    refine AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ _ _ ?_
    rw [hsplit, add_sub_cancel_left]
    exact Ideal.pow_le_pow_right (by omega) hmD
  set G := (homogeneousComponent w₀ (C.Φ F')).map (Ideal.Quotient.mk (maximalIdeal T.ring))
  have hc1 : G.coeff (exponentShift γ₀) ≠ 0 := by
    simp only [G, coeff_map, coeff_homogeneousComponent, wt, w₀, ↓reduceIte, coeff_transformPoly_exponentShift]
    rw [Ne, Ideal.Quotient.eq_zero_iff_mem, IsLocalHom.map_mem_maximalIdeal_iff,
      ← Ideal.Quotient.eq_zero_iff_mem]
    exact C.mk_coeff_ne_zero hF'c hγ₀
  have hG0 : G ≠ 0 := fun h0 => hc1 (by rw [h0]; simp)
  have hmkG : AssocGraded.mk (maximalIdeal T.ring) w₀ (T.toRing (eval C.z F')) hmem1 = C.e₁ G :=
    hin1.symm.trans hW1.2
  have hne : AssocGraded.mk (maximalIdeal T.ring) w₀ (C.x₁ ^ ν * (a - b)) hmem2 ≠ 0 := by
    rw [hmkeq, hmkG, ← map_zero C.e₁]
    exact fun h => hG0 (C.e₁_bijective.1 h)
  have hinit := (Ideal.ordElem_eq_of_mk_ne_zero _ hmem2 hne).2
  rw [hmkeq, hmkG, initialForm_mul_maximalIdeal, C.initialForm_x₁_pow] at hinit
  obtain ⟨q, hq⟩ := C.e₁_bijective.2 (initialForm (maximalIdeal T.ring) (a - b))
  rw [← hq, ← map_mul] at hinit
  have hGq := C.e₁_bijective.1 hinit
  -- compare the coefficients at `φ(γ₀)`
  have hc2 : (X none ^ ν * q).coeff (exponentShift γ₀) = 0 := by
    rw [X_pow_eq_monomial, mul_comm, coeff_mul_monomial']
    refine ite_eq_right_iff.mpr fun hle => absurd hle ?_
    intro hle
    have := hle none
    rw [Finsupp.single_eq_same, exponentShift_none_eq_pDeg] at this
    have := (mem_support_restrictSupport.mp hγ₀).2
    omega
  rw [hGq] at hc2
  exact hc1 hc2

end TransformCoord

end ClaimA2

section Lemma8Element

private theorem ord_span_singleton_eq_ordElem {A : Type*} [CommRing A] (I : Ideal A) (x : A) :
    Ideal.ord I (Ideal.span {x}) = Ideal.ordElem I x := by
  simp only [Ideal.ord, Ideal.ordElem, Ideal.span_singleton_le_iff_mem]

/-- **Lemma 8 of §3 for an element** (used on p. 228 and p. 229 in the proof of Lemma 14: "By
Lemma 8 of §3, we must have `ν_{M₁}(x^{-ν₁}f₁) ≤ ν₁`", "we have always `μ ≤ ν_i` by virtue of
Lemma 8 of §3").  Lemma 8 (`nu_weakTransform_le`) is stated for an ideal `J` with
`ν_P(J) = ν(J)`: `ν(J₁') ≤ ν(J)` for its weak transform `J'` (p. 217).  Applied to the principal
ideal `J = (f)`, whose weak transform is the principal ideal `(g)` generated by `g = x^{-ν} f`
(`ν = ν_P(f) = ν_M(f)`), it says `ν_{M₁}(g) ≤ ν`. -/
theorem ordElem_le_of_pow_mul_eq_of_isResiduallyAlgebraic {R : Type u} [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] (P : Ideal R) [P.IsPrime] [IsRegularLocalRing (R ⧸ P)]
    (T : MonoidalTransform R P)
    (halg : RingHom.IsResiduallyAlgebraic (R := R) (R' := T.ring) T.toRing)
    {f : R} (hf0 : f ≠ 0) {ν : ℕ} (hP : Ideal.ordElem P f = ν)
    (hM : Ideal.ordElem (maximalIdeal R) f = ν)
    {x g : T.ring} (hx : Ideal.span {x} = P.map T.toRing) (hx0 : x ≠ 0)
    (hg : x ^ ν * g = T.toRing f) :
    Ideal.ordElem (maximalIdeal T.ring) g ≤ ν := by
  classical
  have hJ0 : Ideal.span {f} ≠ ⊥ := by
    rwa [Ne, Ideal.span_singleton_eq_bot]
  have hord : Ideal.ord P (Ideal.span {f}) = Ideal.nu (Ideal.span {f}) := by
    rw [ord_span_singleton_eq_ordElem, Ideal.nu, ord_span_singleton_eq_ordElem, hP, hM]
  have h8 := nu_weakTransform_le R (Ideal.span {f}) hJ0 P hord T halg
  have hweak : weakTransformIdeal T (Ideal.span {f}) = Ideal.span {g} := by
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro y ⟨x', hx', f', hf', ν', hν', hy⟩
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hf'
      rw [ord_span_singleton_eq_ordElem, hP] at hν'
      have hν'ν : ν' ≤ ν := by exact_mod_cast hν'
      obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp (hx'.trans hx.symm)
      have hx'0 : x' ≠ 0 := fun h0 => hx0 (by rw [← hu, h0, zero_mul])
      refine Ideal.mem_span_singleton'.mpr ⟨T.toRing a * (x' ^ (ν - ν') * u ^ ν), ?_⟩
      refine mul_left_cancel₀ (pow_ne_zero ν' hx'0) ?_
      rw [hy, map_mul, ← hg, ← hu]
      have : x' ^ ν = x' ^ ν' * x' ^ (ν - ν') := by rw [← pow_add]; congr 1; omega
      rw [mul_pow, this]
      ring
    · rw [Set.singleton_subset_iff]
      exact Ideal.subset_span ⟨x, hx, f, Ideal.mem_span_singleton_self f, ν,
        by rw [ord_span_singleton_eq_ordElem, hP], hg⟩
  rw [hweak, Ideal.nu, ord_span_singleton_eq_ordElem] at h8
  rwa [Ideal.nu, ord_span_singleton_eq_ordElem, hM] at h8

end Lemma8Element

section MonomialPowers

theorem monomialVal_mem_pow_weight {B : Type*} [CommRing B] {r s : ℕ} (I : Ideal B)
    (w : CoordIndex r s → ℕ) (z : CoordIndex r s → B) (hz : ∀ v, z v ∈ I ^ w v) (β : CoordIndex r s →₀ ℕ) :
    monomialVal z β ∈ I ^ Finsupp.weight w β := by
  induction β using Finsupp.induction with
  | zero => simp [monomialVal]
  | single_add a b f _ _ ih =>
    have hw : Finsupp.weight w (Finsupp.single a b) = b * w a := by
      simp [Finsupp.weight_apply, Finsupp.sum_single_index]
    rw [monomialVal_add, map_add, hw, pow_add, monomialVal_single]
    refine Ideal.mul_mem_mul ?_ ih
    rw [mul_comm, pow_mul]
    exact Ideal.pow_mem_pow (hz a) b

theorem monomialVal_mem_pow_degree {B : Type*} [CommRing B] {r s : ℕ} (I : Ideal B)
    (z : CoordIndex r s → B) (hz : ∀ v, z v ∈ I) (β : CoordIndex r s →₀ ℕ) :
    monomialVal z β ∈ I ^ β.degree := by
  rw [Finsupp.degree_eq_weight_one]
  exact monomialVal_mem_pow_weight I _ z (fun v => by simpa using hz v) β

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

theorem monomialVal_z_mem_pow_pDeg (β : CoordIndex C.r C.s →₀ ℕ) : monomialVal C.z β ∈ P ^ pDeg β := by
  refine monomialVal_mem_pow_weight P pWeight C.z (fun v => ?_) β
  rcases v with _ | (i | j)
  · simpa [pWeight, z, coordFamily] using C.x₀_mem
  · simpa [pWeight, z, coordFamily] using C.x_mem i
  · simp [pWeight]

end TransformCoord

end MonomialPowers

section ClaimA3

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]

theorem ordElem_x₁_pow (n : ℕ) :
    Ideal.ordElem (maximalIdeal T.ring) (C.x₁ ^ n) = n := by
  induction n with
  | zero =>
    rw [pow_zero]
    refine le_antisymm (Ideal.ordElem_le_of_notMem ?_) (by simp)
    rw [zero_add, pow_one]
    exact fun h => (maximalIdeal.isMaximal T.ring).ne_top ((Ideal.eq_top_iff_one _).mpr h)
  | succ n ih =>
    rw [pow_succ, ordElem_mul_maximalIdeal, ih, C.initialForm_x₁.1]
    push_cast
    rfl

include C in
/-- **Lemma 8 of §3 for an element, in the coordinates of `C`** (p. 228: "By Lemma 8 of §3, we must
have `ν_{M₁}(x^{-ν₁}f₁) ≤ ν₁`"; p. 229: "Note that we have always `μ ≤ ν_i` by virtue of
Lemma 8 of §3"): if `ν_P(f) = ν_M(f) = ν` and `x₀^ν g = f` in `R₁`, then `ν_{M₁}(g) ≤ ν`.
(`P` is prime and `R/P` regular because `P` is generated by part of a regular system of
parameters of `R`, `TransformCoord.isPrime`, `TransformCoord.isRegularLocalRing_quotient`.) -/
theorem ordElem_le_of_pow_mul_eq
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {f : R} {ν : ℕ} (hfP : Ideal.ordElem P f = ν) (hfM : Ideal.ordElem (maximalIdeal R) f = ν)
    {g : T.ring} (hg : C.x₁ ^ ν * g = T.toRing f) :
    Ideal.ordElem (maximalIdeal T.ring) g ≤ ν := by
  have := C.isPrime
  have := C.isRegularLocalRing_quotient
  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [(Ideal.ordElem_eq_top_iff_eq_zero (maximalIdeal.isMaximal R).ne_top).mpr rfl] at hfM
    exact ENat.top_ne_natCast _ hfM
  have hx0 : C.x₁ ≠ 0 := by
    intro h0
    have := C.initialForm_x₁.1
    rw [h0, (Ideal.ordElem_eq_top_iff_eq_zero
      (maximalIdeal.isMaximal T.ring).ne_top).mpr rfl] at this
    exact ENat.top_ne_one this
  have halg : RingHom.IsResiduallyAlgebraic (R := R) (R' := T.ring) T.toRing := by
    let _ : Algebra (ResidueField R) (ResidueField T.ring) := (ResidueField.map T.toRing).toAlgebra
    show Algebra.IsAlgebraic (ResidueField R) (ResidueField T.ring)
    refine ⟨fun w => ?_⟩
    obtain ⟨c, rfl⟩ := hrat w
    exact isAlgebraic_algebraMap c
  exact ordElem_le_of_pow_mul_eq_of_isResiduallyAlgebraic P T halg hf0 hfP hfM C.span_x₁ hx0 hg

omit [IsRegularLocalRing T.ring] in
theorem wt_le_two_mul_of_degree_eq {ν : ℕ} {γ : CoordIndex C.r C.s →₀ ℕ} (hγ : γ.degree = ν) :
    C.wt γ ≤ 2 * ν := by
  have h1 := degree_eq_pDeg_add_sum γ
  have h2 := xDeg_le_pDeg γ
  simp only [wt, degree_exponentShift]
  omega

/-- If `f ∈ R` is divisible by `x₀^ν` in `R₁`, then `f ∈ P^ν`: (W3) shows that every monomial of
an expansion of `f` of weight at most `2k` lies in `P^ν`, so `f ∈ P^ν + M^k` for all `k`, and
Krull's intersection theorem in `R/P^ν` gives `f ∈ P^ν`. -/
theorem mem_pow_of_pow_mul_eq {f : R} {ν : ℕ} {g : T.ring} (hg : C.x₁ ^ ν * g = T.toRing f) :
    f ∈ P ^ ν := by
  classical
  rcases Nat.eq_zero_or_pos ν with rfl | hν
  · simp
  have hPM : P ≤ maximalIdeal R := by
    rw [C.hP, Ideal.span_le]
    rintro _ (h | ⟨i, rfl⟩)
    · rw [Set.mem_singleton_iff.mp h]
      have h1 := C.z_mem none
      rw [pow_one] at h1
      exact h1
    · have h1 := C.z_mem (some (Sum.inl i))
      rw [pow_one] at h1
      exact h1
  have hQM : P ^ ν ≤ maximalIdeal R := (Ideal.pow_le_self hν.ne').trans hPM
  -- `f ∈ P^ν + M^k` for every `k`
  have key : ∀ k : ℕ, f ∈ P ^ ν ⊔ maximalIdeal R ^ k := by
    intro k
    obtain ⟨F, hFc, hFdeg, hfF⟩ := C.exists_expansion f 0 (by simp) (2 * k) (by omega)
    have hW3 := C.le_pDeg_of_x₁_pow_mul_eq f F hFc (2 * k) hfF ν g hg
    have hev : eval C.z F ∈ P ^ ν ⊔ maximalIdeal R ^ k := by
      rw [C.eval_z_eq_sum]
      refine Ideal.sum_mem _ fun γ hγ => ?_
      by_cases hw : C.wt γ ≤ 2 * k
      · refine Ideal.mem_sup_left (Ideal.mul_mem_left _ _ ?_)
        exact Ideal.pow_le_pow_right (hW3 γ hγ hw) (C.monomialVal_z_mem_pow_pDeg γ)
      · have hwt := C.wt_le_two_mul_of_degree_eq (γ := γ) (ν := γ.degree) rfl
        have hmem := monomialVal_mem_pow_degree (maximalIdeal R) C.z
          (fun v => by simpa using C.z_mem v) γ
        exact Ideal.mem_sup_right (Ideal.mul_mem_left _ _
          (Ideal.pow_le_pow_right (by omega) hmem))
    have : f = eval C.z F + (f - eval C.z F) := by ring
    rw [this]
    exact add_mem hev (Ideal.mem_sup_right (Ideal.pow_le_pow_right (by omega) hfF))
  -- Krull's intersection theorem in `R / P^ν`
  have hQ : P ^ ν ≠ ⊤ := fun h => (maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ hQM))
  have : Nontrivial (R ⧸ P ^ ν) := Ideal.Quotient.nontrivial_iff.mpr hQ
  have : IsLocalRing (R ⧸ P ^ ν) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (P ^ ν)) Ideal.Quotient.mk_surjective
  set mk := Ideal.Quotient.mk (P ^ ν)
  have hne : (maximalIdeal R).map mk ≠ ⊤ := by
    intro h
    have h1 := Ideal.comap_map_of_surjective mk Ideal.Quotient.mk_surjective (maximalIdeal R)
    rw [h, Ideal.comap_top, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hQM] at h1
    exact (maximalIdeal.isMaximal R).ne_top h1.symm
  have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing ((maximalIdeal R).map mk) hne
  have hf0 : mk f ∈ (⨅ k : ℕ, ((maximalIdeal R).map mk) ^ k) := by
    rw [Submodule.mem_iInf]
    intro k
    obtain ⟨q, hq, m, hm, hqm⟩ := Submodule.mem_sup.mp (key k)
    have : mk f = mk m := by
      rw [← hqm, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hq, zero_add]
    rw [this, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hm
  rw [hbot, Ideal.mem_bot] at hf0
  exact Ideal.Quotient.eq_zero_iff_mem.mp hf0

/-- **Claim A** (proofs of Lemmas 14–16 and of Theorem 5): let `f ∈ R` with `ν_M(f) = ν` and
`f = x₀^ν g` in `R₁`. Then `ν_{M₁}(g) ≤ ν`, and if `ν_{M₁}(g) = ν`, the initial form `φ` of `f` is
a form in `X₁, …, X_r` only and the initial form `ψ` of `g` satisfies `ρ(ψ) = φ`, i.e.
`ψ = φ(X̄₁, …, X̄_r) + λ` with `λ ∈ (X, Y)` (p. 228).

The inequality is **Lemma 8 of §3 for elements** (`ordElem_le_of_pow_mul_eq`; p. 228: "By
Lemma 8 of §3, we must have `ν_{M₁}(x^{-ν₁}f₁) ≤ ν₁`"), applied with `ν_P(f) = ν`.  The paper has
`ν_P(f_j) = ν_j` as hypothesis (ii) of Lemma 14; here it is derived from `x₀^ν ∣ f` in `R₁` and
`ν_M(f) = ν` (`mem_pow_of_pow_mul_eq`), so that the statement needs no `ν_P`-hypothesis.  The
second part is the paper's computation with the inequality `(*)` of p. 229: if
`ν_{M₁}(g) = ν`, every monomial of `f` in the expansion has weight `2ν`, which forces
`a₀ = 0`, `μ_{(a)} = 0` and `a₁ + ⋯ + a_r = ν`. -/
theorem ordElem_le_and_rho_initialForm_eq (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    (f : R) (ν : ℕ) (hfM : Ideal.ordElem (maximalIdeal R) f = ν) (g : T.ring)
    (hg : C.x₁ ^ ν * g = T.toRing f) :
    Ideal.ordElem (maximalIdeal T.ring) g ≤ ν ∧
      (Ideal.ordElem (maximalIdeal T.ring) g = ν →
        (∃ p, C.e p = initialForm (maximalIdeal R) f ∧ ∀ β ∈ p.support, IsPure β) ∧
        C.ρ hrat (initialForm (maximalIdeal T.ring) g) = initialForm (maximalIdeal R) f) := by
  classical
  -- `ν_{M₁}(g) ≤ ν`: Lemma 8 of §3 for elements, with `ν_P(f) = ν_M(f) = ν`
  have hle : Ideal.ordElem (maximalIdeal T.ring) g ≤ ν := by
    have := C.isPrime
    have hPM : P ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
    have hfP : Ideal.ordElem P f = ν := by
      refine le_antisymm ?_ (Ideal.le_ordElem (C.mem_pow_of_pow_mul_eq hg))
      rw [← hfM]
      exact Ideal.ordElem_le fun n hn => Ideal.le_ordElem (Ideal.pow_right_mono hPM n hn)
    exact C.ordElem_le_of_pow_mul_eq hrat hfP hfM hg
  have hfMν : f ∈ maximalIdeal R ^ ν := Ideal.mem_pow_of_ordElem hfM
  obtain ⟨F, hFc, hFdeg, hfF⟩ := C.exists_expansion f ν hfMν (2 * ν) (by omega)
  have hinM : initialForm (maximalIdeal R) f =
      C.e ((homogeneousComponent ν F).map (Ideal.Quotient.mk _)) :=
    (initialForm_eq_mk _ hfM).trans (C.mk_eq_e_of_expansion f ν _ F (2 * ν) (by omega)
      (fun γ hγ => (hFdeg γ hγ).1) hfF)
  set p := (homogeneousComponent ν F).map (Ideal.Quotient.mk (maximalIdeal R)) with hpdef
  have hp_supp : ∀ β, p.coeff β ≠ 0 → β ∈ F.support ∧ β.degree = ν := by
    intro β hβ
    simp only [p, coeff_map, coeff_homogeneousComponent] at hβ
    split_ifs at hβ with hd
    · refine ⟨mem_support_iff.mpr fun h0 => hβ (by rw [h0, map_zero]), hd⟩
    · exact absurd (map_zero _) hβ
  have hp0 : p ≠ 0 := by
    intro h0
    have hmk : AssocGraded.mk (maximalIdeal R) ν f hfMν ≠ 0 := by
      rw [Ne, AssocGraded.mk_eq_zero_iff]
      intro h
      have := Ideal.le_ordElem h
      rw [hfM, Nat.cast_le] at this
      omega
    apply hmk
    rw [← initialForm_eq_mk _ hfM, hinM, h0, map_zero]
  obtain ⟨γ₀, hγ₀⟩ : ∃ γ, p.coeff γ ≠ 0 := by
    by_contra h
    push Not at h
    exact hp0 (MvPolynomial.ext _ _ fun γ => by rw [h γ]; simp)
  obtain ⟨hγ₀F, hγ₀d⟩ := hp_supp γ₀ hγ₀
  have hW3 := C.le_pDeg_of_x₁_pow_mul_eq f F hFc (2 * ν) hfF ν g hg
  obtain ⟨γm, hγm, hmin⟩ := F.support.exists_min_image C.wt ⟨γ₀, hγ₀F⟩
  have hγmD : C.wt γm ≤ 2 * ν :=
    (hmin γ₀ hγ₀F).trans (C.wt_le_two_mul_of_degree_eq hγ₀d)
  have hW1 := C.ordElem_toRing_of_expansion f F hFc (2 * ν) hfF γm hγm hγmD hmin
  have hord : Ideal.ordElem (maximalIdeal T.ring) (T.toRing f) =
      ν + Ideal.ordElem (maximalIdeal T.ring) g := by
    rw [← hg, ordElem_mul_maximalIdeal, C.ordElem_x₁_pow]
  rw [hW1.1] at hord
  have hgtop : Ideal.ordElem (maximalIdeal T.ring) g ≠ ⊤ := by
    intro h
    rw [h, add_top] at hord
    exact ENat.natCast_ne_top _ hord
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp hgtop
  rw [← hn] at hord ⊢
  have hord' : C.wt γm = ν + n := by exact_mod_cast hord
  refine ⟨by rw [hn]; exact hle, fun hnν => ?_⟩
  have hnν' : n = ν := by exact_mod_cast hnν
  have hwt2 : C.wt γm = 2 * ν := by omega
  have hpure : ∀ β ∈ p.support, IsPure β := by
    intro β hβ
    obtain ⟨hβF, hβd⟩ := hp_supp β (mem_support_iff.mp hβ)
    have h1 := hW3 β hβF (C.wt_le_two_mul_of_degree_eq hβd)
    have h2 : 2 * ν ≤ C.wt β := hwt2 ▸ hmin β hβF
    have h3 := degree_eq_pDeg_add_sum β
    have h4 := exponentShift_none_eq_pDeg β
    rw [exponentShift, Finsupp.add_apply, Finsupp.single_eq_same] at h4
    simp only [wt, degree_exponentShift] at h2
    exact isPure_of_degree_eq_pDeg (by omega) (by omega)
  refine ⟨⟨p, hinM.symm, hpure⟩, ?_⟩
  have hinf1 : initialForm (maximalIdeal T.ring) (T.toRing f) =
      C.e₁ ((homogeneousComponent (2 * ν) (C.Φ F)).map (Ideal.Quotient.mk _)) := by
    rw [hW1.2, hwt2]
  obtain ⟨q, hq⟩ := C.e₁_bijective.2 (initialForm (maximalIdeal T.ring) g)
  have hQ : X none ^ ν * q =
      (homogeneousComponent (2 * ν) (C.Φ F)).map (Ideal.Quotient.mk (maximalIdeal T.ring)) := by
    apply C.e₁_bijective.1
    rw [map_mul, hq, ← C.initialForm_x₁_pow, ← initialForm_mul_maximalIdeal, hg, hinf1]
  rw [← hq, C.ρ_e₁, hinM]
  congr 1
  ext β
  rw [coeff_pureSubst]
  split_ifs with hβ
  · rw [coeff_map]
    have hqβ : q.coeff β = (X none ^ ν * q).coeff (β + Finsupp.single none ν) := by
      rw [X_pow_eq_monomial, mul_comm, coeff_mul_monomial']
      simp only [le_add_iff_nonneg_left, zero_le, ↓reduceIte, add_tsub_cancel_right, mul_one]
    rw [hqβ, hQ, coeff_map, coeff_homogeneousComponent, coeff_map, coeff_homogeneousComponent]
    have hdegβ : (β + Finsupp.single none ν).degree = β.degree + ν := by
      rw [map_add, Finsupp.degree_single]
    by_cases hdeg : β.degree = ν
    · have hφ : β + Finsupp.single none ν = exponentShift β := by
        rw [exponentShift, xDeg_eq_degree_of_isPure hβ, hdeg]
      have h2ν : (β + Finsupp.single none ν).degree = 2 * ν := by rw [hdegβ, hdeg]; ring
      simp only [h2ν, hdeg, ↓reduceIte]
      rw [hφ, coeff_transformPoly_exponentShift]
      exact MonoidalTransform.residueEquiv_symm_mk T hrat _
    · have h2ν : (β + Finsupp.single none ν).degree ≠ 2 * ν := by rw [hdegβ]; omega
      simp only [h2ν, hdeg, ↓reduceIte, map_zero]
  · by_contra h
    exact hβ (hpure β (mem_support_iff.mpr (Ne.symm h)))

end TransformCoord

end ClaimA3

section GradedHelpers

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- The projection of `gr_I(A)` onto its homogeneous part of degree `e`. -/
noncomputable def AssocGraded.proj (e : ℕ) : AssocGraded I →+ AssocGraded I :=
  ((AssocGraded.ofGrPiece I e).comp (grProj I e)).toAddMonoidHom

theorem AssocGraded.proj_of_mem_homogeneous {e : ℕ} {x : AssocGraded I} (hx : x ∈ AssocGraded.homogeneous I e) :
    AssocGraded.proj I e x = x := by
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
  simp [AssocGraded.proj, grProj_ofGrPiece_same]

theorem AssocGraded.proj_of_mem_homogeneous_of_ne {e e' : ℕ} {x : AssocGraded I}
    (hx : x ∈ AssocGraded.homogeneous I e') (h : e' ≠ e) : AssocGraded.proj I e x = 0 := by
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
  simp [AssocGraded.proj, grProj_ofGrPiece_ne I h]

theorem AssocGraded.proj_mem_homogeneous (e : ℕ) (x : AssocGraded I) : AssocGraded.proj I e x ∈ AssocGraded.homogeneous I e :=
  LinearMap.mem_range_self _ _

theorem AssocGraded.exists_mk_eq_of_mem_homogeneous {n : ℕ} {x : AssocGraded I} (hx : x ∈ AssocGraded.homogeneous I n) :
    ∃ (y : A) (hy : y ∈ I ^ n), AssocGraded.mk I n y hy = x := by
  obtain ⟨q, rfl⟩ := LinearMap.mem_range.mp hx
  induction q using Submodule.Quotient.induction_on with
  | H y => exact ⟨y, y.2, rfl⟩

theorem AssocGraded.mul_mem_homogeneous {a b : AssocGraded I} {d e : ℕ}
    (ha : a ∈ AssocGraded.homogeneous I d) (hb : b ∈ AssocGraded.homogeneous I e) :
    a * b ∈ AssocGraded.homogeneous I (d + e) := by
  obtain ⟨y, hy, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous I ha
  obtain ⟨z, hz, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous I hb
  rw [AssocGraded.mk_mul_mk]
  exact AssocGraded.mk_mem_homogeneous _ _

theorem AssocGraded.exists_eq_sum_proj (c : AssocGraded I) :
    ∃ N, ∀ N', N ≤ N' → c = ∑ e ∈ Finset.range N', AssocGraded.proj I e c := by
  classical
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective c
  refine ⟨(p : Polynomial A).natDegree + 1, fun N' hN' => ?_⟩
  rw [mk_eq_sum_mk]
  simp only [map_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i hi => ?_
  have hiN : i ∈ Finset.range N' := by
    rw [Finset.mem_range]
    have := Polynomial.le_natDegree_of_mem_supp i hi
    omega
  rw [Finset.sum_eq_single i, AssocGraded.proj_of_mem_homogeneous I (AssocGraded.mk_mem_homogeneous _ _)]
  · intro e _ he
    exact AssocGraded.proj_of_mem_homogeneous_of_ne I (AssocGraded.mk_mem_homogeneous _ _) (Ne.symm he)
  · intro h; exact absurd hiN h

theorem AssocGraded.proj_mul_of_mem_homogeneous (c Φ : AssocGraded I) {d : ℕ} (hΦ : Φ ∈ AssocGraded.homogeneous I d)
    (μ : ℕ) : AssocGraded.proj I μ (c * Φ) = if d ≤ μ then AssocGraded.proj I (μ - d) c * Φ else 0 := by
  classical
  obtain ⟨N, hN⟩ := AssocGraded.exists_eq_sum_proj I c
  have hc := hN (max N (μ + 1)) (le_max_left _ _)
  conv_lhs => rw [hc]
  rw [Finset.sum_mul, map_sum]
  have hterm : ∀ e ∈ Finset.range (max N (μ + 1)), AssocGraded.proj I μ (AssocGraded.proj I e c * Φ) =
      if e + d = μ then AssocGraded.proj I e c * Φ else 0 := by
    intro e _
    split_ifs with h
    · exact AssocGraded.proj_of_mem_homogeneous I (h ▸ AssocGraded.mul_mem_homogeneous I (AssocGraded.proj_mem_homogeneous I e c) hΦ)
    · exact AssocGraded.proj_of_mem_homogeneous_of_ne I (AssocGraded.mul_mem_homogeneous I (AssocGraded.proj_mem_homogeneous I e c) hΦ) h
  rw [Finset.sum_congr rfl hterm]
  split_ifs with hdμ
  · rw [Finset.sum_eq_single (μ - d)]
    · have : μ - d + d = μ := by omega
      simp only [this, ↓reduceIte]
    · intro e _ he
      have : e + d ≠ μ := by omega
      simp only [this, ↓reduceIte]
    · intro h
      exfalso
      apply h
      rw [Finset.mem_range]
      omega
  · refine Finset.sum_eq_zero fun e _ => ?_
    have : e + d ≠ μ := by omega
    simp only [this, ↓reduceIte]

/-- A homogeneous element of degree `μ` of the ideal generated by homogeneous elements `Φ t` of
degrees `d t` is a combination `∑ c_t Φ_t` with `c_t` homogeneous of degree `μ - d_t`, and
`c_t = 0` when `d_t > μ`. -/
theorem AssocGraded.exists_homogeneous_coeffs_of_mem_span {n : ℕ} (Φ : Fin n → AssocGraded I) (d : Fin n → ℕ)
    (hΦ : ∀ t, Φ t ∈ AssocGraded.homogeneous I (d t)) {μ : ℕ} {χ : AssocGraded I}
    (hχ : χ ∈ AssocGraded.homogeneous I μ) (hspan : χ ∈ Ideal.span (Set.range Φ)) :
    ∃ c : Fin n → AssocGraded I, (∀ t, c t ∈ AssocGraded.homogeneous I (μ - d t)) ∧
      (∀ t, μ < d t → c t = 0) ∧ χ = ∑ t, c t * Φ t := by
  classical
  obtain ⟨c₀, hc₀⟩ := Ideal.mem_span_range_iff_exists_fun.mp hspan
  let c : Fin n → AssocGraded I := fun t => if d t ≤ μ then AssocGraded.proj I (μ - d t) (c₀ t) else 0
  refine ⟨c, fun t => ?_, fun t ht => ?_, ?_⟩
  · simp only [c]
    split_ifs
    · exact AssocGraded.proj_mem_homogeneous I _ _
    · exact zero_mem _
  · have : ¬ d t ≤ μ := not_le.mpr ht
    simp only [c, this, ↓reduceIte]
  · rw [← AssocGraded.proj_of_mem_homogeneous I hχ, ← hc₀, map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [AssocGraded.proj_mul_of_mem_homogeneous I _ _ (hΦ t)]
    simp only [c]
    split_ifs <;> simp

end GradedHelpers

section SBHelpers

theorem _root_.Fin.val_le_orderEmb {n c : ℕ} (f : Fin c ↪o Fin n) (t : Fin c) : (t : ℕ) ≤ f t := by
  obtain ⟨t, ht⟩ := t
  induction t with
  | zero => exact Nat.zero_le _
  | succ t ih =>
    have h1 := ih (by omega)
    have h2 : f ⟨t, by omega⟩ < f ⟨t + 1, ht⟩ := f.strictMono (Fin.mk_lt_mk.mpr (by omega))
    rw [Fin.lt_def] at h2
    simp only at h1 ⊢
    omega

theorem _root_.Finset.val_orderEmbOfFin_eq_of_prefix {n c k : ℕ} (Sset : Finset (Fin n)) (hc : Sset.card = c)
    (hk : ∀ i : Fin n, (i : ℕ) < k → i ∈ Sset) :
    ∀ t : Fin c, (t : ℕ) < k → ((Sset.orderEmbOfFin hc t : Fin n) : ℕ) = t := by
  intro t
  induction' hm : (t : ℕ) using Nat.strong_induction_on with m ih generalizing t
  subst hm
  intro ht
  have hle := Fin.val_le_orderEmb (Sset.orderEmbOfFin hc) t
  by_contra hne
  have hlt : (t : ℕ) < Sset.orderEmbOfFin hc t := lt_of_le_of_ne hle (Ne.symm hne)
  have hi₀ : (⟨t, by have := (Sset.orderEmbOfFin hc t).2; omega⟩ : Fin n) ∈ Sset :=
    hk _ (by simp only; omega)
  have hmem : (⟨t, by have := (Sset.orderEmbOfFin hc t).2; omega⟩ : Fin n) ∈
      Set.range (Sset.orderEmbOfFin hc) := by
    rw [Finset.range_orderEmbOfFin]; exact hi₀
  obtain ⟨u, hu⟩ := hmem
  have hut : u < t := by
    rw [← (Sset.orderEmbOfFin hc).lt_iff_lt, hu, Fin.lt_def]
    exact hlt
  have := ih u (Fin.lt_def.mp hut) u rfl (by have := Fin.lt_def.mp hut; omega)
  rw [hu] at this
  simp only at this
  have := Fin.lt_def.mp hut
  omega

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- A system of elements of `J` with non-decreasing degrees whose initial forms generate
`gr_M(J, S)` and whose first `k` initial forms are irredundant: its first `k` elements can be
extended to a standard base of `J` (discard the redundant elements; the proof of Lemma 1). -/
theorem extendsToStandardBase_of_prefix (J : Ideal S) {n : ℕ} (H : Fin n → S) (hHJ : ∀ i, H i ∈ J)
    (d : Fin n → ℕ)
    (hd : ∀ i, initialForm (maximalIdeal S) (H i) ∈ AssocGraded.homogeneous _ (d i))
    (hmono : Monotone d)
    (hgen : Ideal.span (Set.range fun i => initialForm (maximalIdeal S) (H i)) =
      grIdeal (maximalIdeal S) J)
    (k : ℕ) (hk : k ≤ n)
    (hpre : ∀ i : Fin n, (i : ℕ) < k → initialForm (maximalIdeal S) (H i) ∉
      Ideal.span (Set.range fun j : Fin i => initialForm (maximalIdeal S) (H (Fin.castLE i.2.le j)))) :
    ExtendsToStandardBase J (fun j : Fin k => H (Fin.castLE hk j)) := by
  classical
  let φ : Fin n → AssocGraded (maximalIdeal S) := fun i => initialForm (maximalIdeal S) (H i)
  let Sset : Finset (Fin n) := Finset.univ.filter fun i =>
    φ i ∉ Ideal.span (Set.range fun j : Fin i => φ (Fin.castLE i.2.le j))
  let emb := Sset.orderEmbOfFin rfl
  have hpreS : ∀ i : Fin n, (i : ℕ) < k → i ∈ Sset := fun i hi =>
    Finset.mem_filter.mpr ⟨Finset.mem_univ _, hpre i hi⟩
  have hkm : k ≤ Sset.card := by
    have hsub : (Finset.univ : Finset (Fin k)).map (Fin.castLEEmb hk) ⊆ Sset := by
      intro i hi
      obtain ⟨j, -, rfl⟩ := Finset.mem_map.mp hi
      exact hpreS _ (by simp)
    have := Finset.card_le_card hsub
    simpa using this
  have hSB : IsStandardBase S J (fun t => H (emb t)) := by
    refine ⟨fun t => hHJ _, fun t => Ideal.subset_span ⟨_, hHJ _, rfl⟩,
      ⟨fun t => d (emb t), fun t => hd _, hmono.comp emb.monotone⟩, ?_, ?_⟩
    · rw [← hgen]
      refine le_antisymm ?_ (Ideal.span_le.mpr ?_)
      · have key : ∀ N : ℕ, ∀ i : Fin n, (i : ℕ) < N →
            φ i ∈ Ideal.span (Set.range fun t => φ (emb t)) := by
          intro N
          induction N with
          | zero => intro i hi; omega
          | succ N ih =>
            intro i hi
            by_cases hiS : i ∈ Sset
            · have : i ∈ Set.range emb := by rw [Finset.range_orderEmbOfFin]; exact hiS
              obtain ⟨t, rfl⟩ := this
              exact Ideal.subset_span ⟨t, rfl⟩
            · have hmem : φ i ∈
                  Ideal.span (Set.range fun j : Fin i => φ (Fin.castLE i.2.le j)) := by
                simpa [Sset] using hiS
              refine (Ideal.span_le.mpr ?_) hmem
              rintro _ ⟨j, rfl⟩
              exact ih _ (by simp only [Fin.val_castLE]; omega)
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨i, rfl⟩
        exact key n i i.2
      · rintro _ ⟨t, rfl⟩
        exact Ideal.subset_span ⟨_, rfl⟩
    · intro t ht
      have htS : emb t ∈ Sset := Sset.orderEmbOfFin_mem rfl t
      rw [Finset.mem_filter] at htS
      apply htS.2
      refine (Ideal.span_mono ?_) ht
      rintro _ ⟨j, rfl⟩
      have hlt : emb (Fin.castLE t.2.le j) < emb t :=
        emb.strictMono (show Fin.castLE t.2.le j < t from Fin.lt_def.mpr (by simp))
      exact ⟨⟨(emb (Fin.castLE t.2.le j) : ℕ), hlt⟩, by simp [φ]⟩
  refine ⟨Sset.card, fun t => H (emb t), hkm, hSB, fun j => ?_⟩
  have := Finset.val_orderEmbOfFin_eq_of_prefix Sset rfl hpreS (Fin.castLE hkm j) (by simp)
  show H (emb (Fin.castLE hkm j)) = H (Fin.castLE hk j)
  congr 1
  exact Fin.ext (by simpa using this)

theorem initialForm_mem_homogeneous_toNat (f : S) :
    initialForm (maximalIdeal S) f ∈
      AssocGraded.homogeneous (maximalIdeal S) (Ideal.ordElem (maximalIdeal S) f).toNat := by
  by_cases htop : Ideal.ordElem (maximalIdeal S) f = ⊤
  · rw [initialForm, dite_eq_left htop]
    exact zero_mem _
  · rw [initialForm_eq_mk _ (ENat.natCast_toNat htop).symm]
    exact AssocGraded.mk_mem_homogeneous _ _

/-- Every ideal of a regular local ring has a standard base (Lemma 1, existence). -/
theorem exists_isStandardBase (J : Ideal S) : ∃ (m : ℕ) (g : Fin m → S), IsStandardBase S J g := by
  classical
  have : IsNoetherianRing (AssocGraded (maximalIdeal S)) :=
    inferInstanceAs (IsNoetherianRing (reesAlgebra (maximalIdeal S) ⧸ _))
  obtain ⟨s, hs, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset
    (initialForm (maximalIdeal S) '' (J : Set S))).mp
      (IsNoetherian.noetherian (grIdeal (maximalIdeal S) J))
  have hpre : ∀ w : s, ∃ f ∈ J, initialForm (maximalIdeal S) f = w := fun w => by
    obtain ⟨f, hf, h⟩ := hs w.2
    exact ⟨f, hf, h⟩
  choose f hfJ hf using hpre
  let f' : Fin s.card → S := fun i => f (s.equivFin.symm i)
  let e : Fin s.card → ℕ := fun i => (Ideal.ordElem (maximalIdeal S) (f' i)).toNat
  let H := f' ∘ Tuple.sort e
  have hgen : Ideal.span (Set.range fun i => initialForm (maximalIdeal S) (H i)) =
      grIdeal (maximalIdeal S) J := by
    rw [grIdeal]
    refine Eq.trans ?_ hspan.symm
    show Submodule.span _ _ = Submodule.span _ _
    congr 1
    ext w
    constructor
    · rintro ⟨i, rfl⟩
      simp only [H, f', Function.comp_apply, hf]
      exact (s.equivFin.symm _).2
    · intro hw
      refine ⟨(Tuple.sort e).symm (s.equivFin ⟨w, hw⟩), ?_⟩
      simp [H, f', hf]
  obtain ⟨m, g, -, hg, -⟩ := extendsToStandardBase_of_prefix J H (fun i => hfJ _) (e ∘ Tuple.sort e)
    (fun i => initialForm_mem_homogeneous_toNat _) (Tuple.monotone_sort e) hgen 0 (Nat.zero_le _)
    (fun i hi => absurd hi (Nat.not_lt_zero _))
  exact ⟨m, g, hg⟩

/-- A non-zero element cannot be homogeneous of two different degrees. -/
theorem AssocGraded.degree_eq_of_mem_homogeneous_of_ne_zero {A : Type u} [CommRing A] (I : Ideal A) {x : AssocGraded I}
    {e e' : ℕ} (he : x ∈ AssocGraded.homogeneous I e) (he' : x ∈ AssocGraded.homogeneous I e')
    (hx : x ≠ 0) : e = e' := by
  by_contra h
  apply hx
  rw [← AssocGraded.proj_of_mem_homogeneous I he]
  exact AssocGraded.proj_of_mem_homogeneous_of_ne I he' (Ne.symm h)

end SBHelpers

section SBHelpers2

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- Replacing the `k`-th member `f_k` of a standard base by an element of `J` whose initial form
is `φ_k - ∑_{j<k} β_j φ_j` gives again a standard base. -/
theorem isStandardBase_update (J : Ideal S) {m : ℕ} (g : Fin m → S)
    (hg : IsStandardBase S J g) (k : Fin m) (a : S) (haJ : a ∈ J)
    (β : Fin k → AssocGraded (maximalIdeal S))
    (hβ : initialForm (maximalIdeal S) a = initialForm (maximalIdeal S) (g k) -
      ∑ j : Fin k, β j * initialForm (maximalIdeal S) (g (Fin.castLE k.2.le j)))
    (hdeg : ∀ e, initialForm (maximalIdeal S) (g k) ∈ AssocGraded.homogeneous _ e →
      initialForm (maximalIdeal S) a ∈ AssocGraded.homogeneous _ e) :
    IsStandardBase S J (Function.update g k a) := by
  classical
  obtain ⟨hgJ, hφJ, ⟨d, hd, hmono⟩, hspan, hirr⟩ := hg
  set φ : Fin m → AssocGraded (maximalIdeal S) := fun j => initialForm (maximalIdeal S) (g j)
    with hφ
  set L := ∑ j : Fin k, β j * φ (Fin.castLE k.2.le j) with hL
  have hφ' : ∀ j, initialForm (maximalIdeal S) (Function.update g k a j) =
      if j = k then φ k - L else φ j := by
    intro j
    by_cases hj : j = k
    · subst hj; simp [hβ, φ, L]
    · simp [hj, φ]
  have hcast : ∀ j : Fin k, Fin.castLE k.2.le j ≠ k := fun j h => by
    have := congrArg Fin.val h
    simp at this
    omega
  -- spans over index families containing `k` and all indices below `k` agree
  have hspan_eq : ∀ {ι : Type} (emb : ι → Fin m), (∃ i, emb i = k) →
      (∀ j : Fin k, ∃ i, emb i = Fin.castLE k.2.le j) →
      Ideal.span (Set.range fun i => initialForm (maximalIdeal S) (Function.update g k a (emb i)))
        = Ideal.span (Set.range fun i => φ (emb i)) := by
    intro ι emb ⟨i₀, hi₀⟩ hlow
    have hLmem : ∀ (ψ : Fin m → AssocGraded (maximalIdeal S)),
        (∀ j : Fin k, ψ (Fin.castLE k.2.le j) = φ (Fin.castLE k.2.le j)) →
        L ∈ Ideal.span (Set.range fun i => ψ (emb i)) := by
      intro ψ hψ
      refine Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ ?_
      obtain ⟨i, hi⟩ := hlow j
      rw [← hψ j, ← hi]
      exact Ideal.subset_span ⟨i, rfl⟩
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro _ ⟨i, rfl⟩
      dsimp only
      rw [hφ']
      split_ifs with h
      · refine sub_mem ?_ (hLmem φ fun j => rfl)
        rw [← hi₀]; exact Ideal.subset_span ⟨i₀, rfl⟩
      · exact Ideal.subset_span ⟨i, rfl⟩
    · rintro _ ⟨i, rfl⟩
      dsimp only
      by_cases h : emb i = k
      · have h1 : φ (emb i) = (φ k - L) + L := by rw [h]; ring
        rw [h1]
        refine add_mem ?_ (hLmem (fun j => initialForm (maximalIdeal S)
          (Function.update g k a j)) fun j => by rw [hφ', ite_eq_right (hcast j)])
        have : initialForm (maximalIdeal S) (Function.update g k a (emb i₀)) ∈ Ideal.span
            (Set.range fun i => initialForm (maximalIdeal S) (Function.update g k a (emb i))) :=
          Ideal.subset_span ⟨i₀, rfl⟩
        rwa [hφ', ite_eq_left hi₀] at this
      · have : initialForm (maximalIdeal S) (Function.update g k a (emb i)) ∈ Ideal.span
            (Set.range fun i => initialForm (maximalIdeal S) (Function.update g k a (emb i))) :=
          Ideal.subset_span ⟨i, rfl⟩
        rwa [hφ', ite_eq_right h] at this
  refine ⟨fun j => ?_, fun j => Ideal.subset_span ⟨_, ?_, rfl⟩, ⟨d, fun j => ?_, hmono⟩, ?_,
    fun t => ?_⟩
  · by_cases hj : j = k
    · subst hj; simpa using haJ
    · rw [Function.update_of_ne hj]; exact hgJ j
  · by_cases hj : j = k
    · subst hj; simpa using haJ
    · rw [Function.update_of_ne hj]; exact hgJ j
  · dsimp only
    by_cases hj : j = k
    · subst hj; simpa using hdeg _ (hd j)
    · rw [Function.update_of_ne hj]; exact hd j
  · rw [hspan]
    exact (hspan_eq id ⟨k, rfl⟩ fun j => ⟨_, rfl⟩).symm
  · dsimp only
    by_cases htk : (t : ℕ) < k
    · have heq : (Set.range fun j : Fin t => initialForm (maximalIdeal S)
          (Function.update g k a (Fin.castLE t.2.le j))) =
          Set.range fun j : Fin t => φ (Fin.castLE t.2.le j) := by
        congr 1
        funext j
        rw [hφ', ite_eq_right]
        intro h
        have := congrArg Fin.val h
        simp at this
        omega
      have htne : t ≠ k := fun h => by rw [h] at htk; exact lt_irrefl _ htk
      rw [heq, hφ', ite_eq_right htne]
      exact hirr t
    · by_cases htk' : t = k
      · subst htk'
        have heq : (Set.range fun j : Fin t => initialForm (maximalIdeal S)
            (Function.update g t a (Fin.castLE t.2.le j))) =
            Set.range fun j : Fin t => φ (Fin.castLE t.2.le j) := by
          congr 1
          funext j
          rw [hφ', ite_eq_right (hcast j)]
        rw [heq, hφ', ite_eq_left rfl]
        intro hmem
        apply hirr t
        have : φ t = (φ t - L) + L := by ring
        rw [this]
        refine add_mem hmem (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ ?_)
        exact Ideal.subset_span ⟨j, rfl⟩
      · have hkt : (k : ℕ) < t := by
          rcases lt_or_gt_of_ne (fun h => htk' (Fin.ext h).symm) with h | h
          · exact h
          · omega
        have htne : t ≠ k := htk'
        rw [hφ', ite_eq_right htne, hspan_eq (Fin.castLE t.2.le) ⟨⟨k, hkt⟩, rfl⟩
          fun j => ⟨⟨j, by omega⟩, rfl⟩]
        exact hirr t

theorem AssocGraded.mk_zero_eq_algebraMap {A : Type u} [CommRing A] (I : Ideal A) (a : A)
    (ha : a ∈ I ^ 0) :
    AssocGraded.mk I 0 a ha = algebraMap (A ⧸ I) (AssocGraded I) (Ideal.Quotient.mk I a) := by
  show Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ (algebraMap A (reesAlgebra I) a)
  refine congrArg _ (Subtype.ext ?_)
  show Polynomial.monomial 0 a = Polynomial.C a
  rfl

/-- The initial form of a unit is the (invertible) constant given by its residue. -/
theorem initialForm_eq_algebraMap_of_isUnit {u : S} (hu : IsUnit u) :
    initialForm (maximalIdeal S) u =
      algebraMap (S ⧸ maximalIdeal S) _ (Ideal.Quotient.mk _ u) ∧
    IsUnit (initialForm (maximalIdeal S) u) := by
  have huM : u ∉ maximalIdeal S := fun h => (IsLocalRing.mem_maximalIdeal u).mp h hu
  have hmem : u ∈ maximalIdeal S ^ 0 := by simp
  have hne : AssocGraded.mk (maximalIdeal S) 0 u hmem ≠ 0 := by
    rw [Ne, AssocGraded.mk_eq_zero_iff, zero_add, pow_one]; exact huM
  have h := (Ideal.ordElem_eq_of_mk_ne_zero _ hmem hne).2
  rw [AssocGraded.mk_zero_eq_algebraMap] at h
  refine ⟨h, ?_⟩
  rw [h]
  refine IsUnit.map _ ?_
  let _ : Field (S ⧸ maximalIdeal S) := Ideal.Quotient.field _
  exact isUnit_iff_ne_zero.mpr fun h0 => huM (Ideal.Quotient.eq_zero_iff_mem.mp h0)

/-- Multiplying the members of a system which can be extended to a standard base by units gives
again such a system. -/
theorem extendsToStandardBase_mul_of_isUnit (J : Ideal S) {i : ℕ} (h : Fin i → S) (u : Fin i → S)
    (hu : ∀ j, IsUnit (u j)) (hext : ExtendsToStandardBase J h) :
    ExtendsToStandardBase J (fun j => u j * h j) := by
  classical
  obtain ⟨m, G, him, ⟨hGJ, hφJ, ⟨d, hd, hmono⟩, hspan, hirr⟩, hGh⟩ := hext
  let U : Fin m → S := fun t => if ht : (t : ℕ) < i then u ⟨t, ht⟩ else 1
  have hU : ∀ t, IsUnit (U t) := fun t => by
    simp only [U]; split_ifs
    · exact hu _
    · exact isUnit_one
  let c : Fin m → AssocGraded (maximalIdeal S) := fun t => initialForm (maximalIdeal S) (U t)
  have hc : ∀ t, IsUnit (c t) := fun t => (initialForm_eq_algebraMap_of_isUnit (hU t)).2
  have hc0 : ∀ t, c t ∈ AssocGraded.homogeneous (maximalIdeal S) 0 := fun t => by
    simp only [c, (initialForm_eq_algebraMap_of_isUnit (hU t)).1]
    rw [← AssocGraded.mk_zero_eq_algebraMap _ _ (by simp)]
    exact AssocGraded.mk_mem_homogeneous _ _
  have hφ' : ∀ t, initialForm (maximalIdeal S) (U t * G t) =
      c t * initialForm (maximalIdeal S) (G t) := fun t => initialForm_mul_maximalIdeal _ _
  -- the span of the multiplied elements over any index family is unchanged
  have hspan_eq : ∀ {ι : Type} (emb : ι → Fin m),
      Ideal.span (Set.range fun t => initialForm (maximalIdeal S) (U (emb t) * G (emb t))) =
        Ideal.span (Set.range fun t => initialForm (maximalIdeal S) (G (emb t))) := by
    intro ι emb
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro _ ⟨t, rfl⟩
      dsimp only
      rw [hφ']
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨t, rfl⟩)
    · rintro _ ⟨t, rfl⟩
      dsimp only
      have : initialForm (maximalIdeal S) (G (emb t)) =
          (hc (emb t)).unit⁻¹ * initialForm (maximalIdeal S) (U (emb t) * G (emb t)) := by
        rw [hφ', ← mul_assoc, IsUnit.val_inv_mul, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨t, rfl⟩)
  refine ⟨m, fun t => U t * G t, him, ⟨fun t => J.mul_mem_left _ (hGJ t),
    fun t => Ideal.subset_span ⟨_, J.mul_mem_left _ (hGJ t), rfl⟩,
    ⟨d, fun t => ?_, hmono⟩, ?_, fun t => ?_⟩, fun j => ?_⟩
  · dsimp only
    rw [hφ']
    simpa using AssocGraded.mul_mem_homogeneous _ (hc0 t) (hd t)
  · rw [hspan]
    exact (hspan_eq id).symm
  · dsimp only
    rw [hspan_eq (Fin.castLE t.2.le), hφ']
    intro hmem
    apply hirr t
    dsimp only
    have : initialForm (maximalIdeal S) (G t) =
        (hc t).unit⁻¹ * (c t * initialForm (maximalIdeal S) (G t)) := by
      rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
    rw [this]
    exact Ideal.mul_mem_left _ _ hmem
  · simp only [U, Fin.val_castLE, j.2, ↓reduceDIte, hGh j]

end SBHelpers2

section Lemma14Aux

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

theorem exists_pow_mul_eq_of_mem_pow {f : R} {ν : ℕ} (hf : f ∈ P ^ ν) :
    ∃ a : T.ring, C.x₁ ^ ν * a = T.toRing f := by
  have hmem : T.toRing f ∈ (P ^ ν).map T.toRing := Ideal.mem_map_of_mem _ hf
  rw [Ideal.map_pow, ← C.span_x₁, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  exact ⟨c, hc.symm⟩

theorem mem_strictTransformIdeal_of_pow_mul_eq {J : Ideal R} {f : R} (hfJ : f ∈ J) {ν : ℕ}
    (hν : (ν : ℕ∞) ≤ Ideal.ordElem P f) {a : T.ring} (ha : C.x₁ ^ ν * a = T.toRing f) :
    a ∈ strictTransformIdeal T J :=
  Ideal.subset_span ⟨C.x₁, C.span_x₁, f, hfJ, ν, hν, ha⟩

variable [IsRegularLocalRing T.ring]

omit [IsRegularLocalRing T.ring] in
/-- Lifting a homogeneous element `χ` of degree `e` of `gr_{M₁}(R₁)` to an element `h` of `R₁`
("linear combinations of monomials of degree `e` in `x₀, x/x₀, y` with coefficients in `R`",
p. 229) such that `x₀^E h ∈ P^E` for every `E > e`. -/
theorem exists_pow_mul_eq_and_mk_eq (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {e : ℕ} {χ : AssocGraded (maximalIdeal T.ring)}
    (hχ : χ ∈ AssocGraded.homogeneous (maximalIdeal T.ring) e) (E : ℕ) (hE : e < E) :
    ∃ (ht : T.ring) (H : R) (hmem : ht ∈ maximalIdeal T.ring ^ e), H ∈ P ^ E ∧
      C.x₁ ^ E * ht = T.toRing H ∧ AssocGraded.mk (maximalIdeal T.ring) e ht hmem = χ := by
  classical
  obtain ⟨w, hw, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous _ hχ
  obtain ⟨K, hK, hKw⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous C.z₁ w).mp
    (by rw [C.span_z₁]; exact hw)
  let cR : (CoordIndex C.r C.s →₀ ℕ) → R := fun β =>
    lift ((T.residueEquiv hrat).symm (Ideal.Quotient.mk (maximalIdeal T.ring) (K.coeff β)))
  have hcR : ∀ β, T.toRing (cR β) - K.coeff β ∈ maximalIdeal T.ring := by
    intro β
    rw [← Ideal.Quotient.eq]
    show T.residueEquiv hrat (Ideal.Quotient.mk _ (cR β)) = _
    rw [mk_lift, RingEquiv.apply_symm_apply]
  let ht := ∑ β ∈ K.support, T.toRing (cR β) * monomialVal C.z₁ β
  let H := ∑ β ∈ K.support, cR β * (C.x₀ ^ (E - xDeg β) * monomialVal C.z β)
  have hdegβ : ∀ β ∈ K.support, β.degree = e := fun β hβ =>
    degree_eq_of_isHomogeneous_of_coeff_ne_zero hK (mem_support_iff.mp hβ)
  have hmono₁ : ∀ β ∈ K.support, monomialVal C.z₁ β ∈ maximalIdeal T.ring ^ e := fun β hβ =>
    hdegβ β hβ ▸ monomialVal_mem_pow_degree _ C.z₁ (fun v => by simpa using C.z₁_mem v) β
  have hmem : ht ∈ maximalIdeal T.ring ^ e :=
    Ideal.sum_mem _ fun β hβ => Ideal.mul_mem_left _ _ (hmono₁ β hβ)
  have hxle : ∀ β ∈ K.support, xDeg β ≤ e := fun β hβ => by
    have h1 := xDeg_le_pDeg β
    have h2 := degree_eq_pDeg_add_sum β
    have := hdegβ β hβ
    omega
  refine ⟨ht, H, hmem, ?_, ?_, ?_⟩
  · refine Ideal.sum_mem _ fun β hβ => Ideal.mul_mem_left _ _ ?_
    have h1 : C.x₀ ^ (E - xDeg β) ∈ P ^ (E - xDeg β) := Ideal.pow_mem_pow C.x₀_mem _
    have h2 : monomialVal C.z β ∈ P ^ xDeg β :=
      Ideal.pow_le_pow_right (xDeg_le_pDeg β) (C.monomialVal_z_mem_pow_pDeg β)
    have := Ideal.mul_mem_mul h1 h2
    rwa [← pow_add, Nat.sub_add_cancel ((hxle β hβ).trans hE.le)] at this
  · simp only [ht, H, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun β hβ => ?_
    rw [map_mul, map_mul, map_pow, C.toRing_monomialVal]
    have : C.x₁ ^ E = C.x₁ ^ (E - xDeg β) * C.x₁ ^ xDeg β := by
      rw [← pow_add, Nat.sub_add_cancel ((hxle β hβ).trans hE.le)]
    rw [this]
    simp only [x₁]
    ring
  · refine AssocGraded.mk_eq_mk_of_sub_mem_pow_succ _ _ _ _ ?_
    rw [← hKw, eval_eq_sum_monomialVal, ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ fun β hβ => ?_
    rw [← sub_mul, pow_succ']
    exact Ideal.mul_mem_mul (hcR β) (hmono₁ β hβ)

end TransformCoord

end Lemma14Aux

section SBHelpers3

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- For a standard base `(g₁, …, g_m)`, `ν_M(g_j) = ν^{(j)}(J)` (Lemma 1). -/
theorem ordElem_eq_nuI_of_isStandardBase (J : Ideal S) {m : ℕ} (g : Fin m → S) (hg : IsStandardBase S J g)
    (j : Fin m) : Ideal.ordElem (maximalIdeal S) (g j) = nuI S J (j : ℕ).succPNat := by
  obtain ⟨⟨d, hd, hnu⟩, -⟩ := nuI_eq_of_hasLemma1Properties S J _ hg.2
  rw [show (j : ℕ).succPNat = ⟨(j : ℕ) + 1, Nat.succ_pos _⟩ from rfl, hnu j]
  have hne : initialForm (maximalIdeal S) (g j) ≠ 0 := fun h0 =>
    hg.2.2.2.2 j (by beta_reduce; rw [h0]; exact zero_mem _)
  have htop : Ideal.ordElem (maximalIdeal S) (g j) ≠ ⊤ := fun h => hne (by
    rw [initialForm, dite_eq_left h])
  have := AssocGraded.degree_eq_of_mem_homogeneous_of_ne_zero _ (initialForm_mem_homogeneous_toNat (g j)) (hd j) hne
  rw [← this, ENat.natCast_toNat htop]

/-- The degree function of a standard base is `j ↦ ν_M(g_j)`. -/
theorem ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous (J : Ideal S) {m : ℕ} (g : Fin m → S) (hg : IsStandardBase S J g)
    (d : Fin m → ℕ) (hd : ∀ j, initialForm (maximalIdeal S) (g j) ∈
      AssocGraded.homogeneous (maximalIdeal S) (d j)) (j : Fin m) :
    Ideal.ordElem (maximalIdeal S) (g j) = d j := by
  have hne : initialForm (maximalIdeal S) (g j) ≠ 0 := fun h0 =>
    hg.2.2.2.2 j (by beta_reduce; rw [h0]; exact zero_mem _)
  have htop : Ideal.ordElem (maximalIdeal S) (g j) ≠ ⊤ := fun h => hne (by
    rw [initialForm, dite_eq_left h])
  have := AssocGraded.degree_eq_of_mem_homogeneous_of_ne_zero _ (initialForm_mem_homogeneous_toNat (g j)) (hd j) hne
  rw [← this, ENat.natCast_toNat htop]

/-- Appending to a system `(h₁, …, h_k)` which can be extended to a standard base an element `a`
of `J` of order `μ ≥ ν_M(h_j)`, `μ ≤ ν^{(k+1)}(J)`, whose initial form is not in the ideal
generated by those of the `h_j`: the new system can again be extended to a standard base. -/
theorem extendsToStandardBase_snoc (J : Ideal S) {k : ℕ} (h : Fin k → S) (a : S)
    (hext : ExtendsToStandardBase J h) (haJ : a ∈ J) (μ : ℕ)
    (hordA : Ideal.ordElem (maximalIdeal S) a = μ)
    (hlow : ∀ j : Fin k, Ideal.ordElem (maximalIdeal S) (h j) ≤ μ)
    (hup : (μ : ℕ∞) ≤ nuI S J k.succPNat)
    (hirr : initialForm (maximalIdeal S) a ∉
      Ideal.span (Set.range fun j => initialForm (maximalIdeal S) (h j))) :
    ExtendsToStandardBase J (Fin.snoc h a : Fin (k + 1) → S) := by
  classical
  obtain ⟨m', G, hkm', hG, hGh⟩ := hext
  obtain ⟨hGJ, -, ⟨dG, hdG, hmonoG⟩, hspanG, hirrG⟩ := hG
  have hdGord : ∀ t, Ideal.ordElem (maximalIdeal S) (G t) = dG t :=
    ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J G ⟨hGJ, fun t => Ideal.subset_span ⟨_, hGJ t, rfl⟩,
      ⟨dG, hdG, hmonoG⟩, hspanG, hirrG⟩ dG hdG
  obtain ⟨⟨dG', hdG', hnuG⟩, -⟩ := nuI_eq_of_hasLemma1Properties S J _
    (⟨fun t => Ideal.subset_span ⟨_, hGJ t, rfl⟩, ⟨dG, hdG, hmonoG⟩, hspanG, hirrG⟩ :
      IsMinimalGradedGenerators S J fun t => initialForm (maximalIdeal S) (G t))
  have hdGeq : ∀ t, dG' t = dG t := fun t => by
    have hne : initialForm (maximalIdeal S) (G t) ≠ 0 := fun h0 =>
      hirrG t (by beta_reduce; rw [h0]; exact zero_mem _)
    exact AssocGraded.degree_eq_of_mem_homogeneous_of_ne_zero _ (hdG' t) (hdG t) hne
  -- degrees of the first `k` members are `≤ μ`, those of the others are `≥ μ`
  have hlowG : ∀ t : Fin m', (t : ℕ) < k → dG t ≤ μ := by
    intro t ht
    have h1 := hlow ⟨t, ht⟩
    rw [← hGh ⟨t, ht⟩] at h1
    have h2 : Fin.castLE hkm' ⟨t, ht⟩ = t := Fin.ext rfl
    rw [h2, hdGord] at h1
    exact_mod_cast h1
  have hupG : ∀ t : Fin m', k ≤ (t : ℕ) → μ ≤ dG t := by
    intro t ht
    have hk : k < m' := lt_of_le_of_lt ht t.2
    have h1 := hnuG ⟨k, hk⟩
    rw [hdGeq] at h1
    have h2 : (⟨k + 1, Nat.succ_pos _⟩ : ℕ+) = k.succPNat := rfl
    rw [h2] at h1
    rw [h1] at hup
    have h3 : (μ : ℕ) ≤ dG ⟨k, hk⟩ := by exact_mod_cast hup
    exact h3.trans (hmonoG (Fin.mk_le_mk.mpr ht))
  -- insert `a` at position `k`
  let H : Fin (m' + 1) → S := fun t =>
    if ht : (t : ℕ) < k then G ⟨t, by have := t.2; omega⟩
    else if ht' : (t : ℕ) = k then a else G ⟨(t : ℕ) - 1, by have := t.2; omega⟩
  let dH : Fin (m' + 1) → ℕ := fun t =>
    if ht : (t : ℕ) < k then dG ⟨t, by have := t.2; omega⟩
    else if ht' : (t : ℕ) = k then μ else dG ⟨(t : ℕ) - 1, by have := t.2; omega⟩
  have hHJ : ∀ t, H t ∈ J := by
    intro t; simp only [H]; split_ifs
    · exact hGJ _
    · exact haJ
    · exact hGJ _
  have hHd : ∀ t, initialForm (maximalIdeal S) (H t) ∈ AssocGraded.homogeneous _ (dH t) := by
    intro t; simp only [H, dH]; split_ifs
    · exact hdG _
    · rw [initialForm_eq_mk _ hordA]; exact AssocGraded.mk_mem_homogeneous _ _
    · exact hdG _
  have hmonoH : Monotone dH := by
    intro s t hst
    have hst' : (s : ℕ) ≤ t := hst
    simp only [dH]
    split_ifs with h1 h2 h3 h4 h5 h6 h7 h8 <;>
      first
      | exact hmonoG (Fin.mk_le_mk.mpr (by omega))
      | exact le_rfl
      | exact hlowG _ (by simp only; omega)
      | exact (hlowG _ (by simp only; omega)).trans (hupG _ (by simp only; omega))
      | exact hupG _ (by simp only; omega)
      | omega
  have hspanH : Ideal.span (Set.range fun t => initialForm (maximalIdeal S) (H t)) =
      grIdeal (maximalIdeal S) J := by
    refine le_antisymm (Ideal.span_le.mpr ?_) ?_
    · rintro _ ⟨t, rfl⟩
      exact Ideal.subset_span ⟨_, hHJ t, rfl⟩
    · rw [hspanG]
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨t, rfl⟩
      by_cases ht : (t : ℕ) < k
      · refine Ideal.subset_span ⟨⟨t, by omega⟩, ?_⟩
        simp only [H, ht, ↓reduceDIte]
      · refine Ideal.subset_span ⟨⟨(t : ℕ) + 1, by omega⟩, ?_⟩
        have h1 : ¬ ((t : ℕ) + 1 < k) := by omega
        have h2 : ¬ ((t : ℕ) + 1 = k) := by omega
        simp only [H, h1, h2, ↓reduceDIte, Nat.add_sub_cancel]
  have hpre : ∀ t : Fin (m' + 1), (t : ℕ) < k + 1 → initialForm (maximalIdeal S) (H t) ∉
      Ideal.span (Set.range fun j : Fin t =>
        initialForm (maximalIdeal S) (H (Fin.castLE t.2.le j))) := by
    intro t ht
    have hpref : (Set.range fun j : Fin t =>
        initialForm (maximalIdeal S) (H (Fin.castLE t.2.le j))) =
        Set.range fun j : Fin t => initialForm (maximalIdeal S) (G ⟨j, by omega⟩) := by
      congr 1
      funext j
      have hj : (j : ℕ) < k := by have := j.2; omega
      simp only [H, Fin.val_castLE, hj, ↓reduceDIte]
    rw [hpref]
    by_cases htk : (t : ℕ) < k
    · simp only [H, htk, ↓reduceDIte]
      exact hirrG ⟨t, by omega⟩
    · have htk' : (t : ℕ) = k := by omega
      simp only [H, htk', lt_self_iff_false, ↓reduceDIte]
      intro hmem
      apply hirr
      refine (Ideal.span_mono ?_) hmem
      rintro _ ⟨j, rfl⟩
      refine ⟨⟨j, by omega⟩, ?_⟩
      dsimp only
      rw [← hGh]
      rfl
  have hfin := extendsToStandardBase_of_prefix J H hHJ dH hHd hmonoH hspanH (k + 1) (by omega) hpre
  convert hfin using 1
  funext j
  refine Fin.lastCases ?_ (fun j => ?_) j
  · simp only [Fin.snoc_last, H, Fin.val_castLE, Fin.val_last, lt_irrefl, ↓reduceDIte]
  · have hj : (j : ℕ) < k := j.2
    simp only [Fin.snoc_castSucc, H, Fin.val_castLE, Fin.val_castSucc, hj, ↓reduceDIte]
    rw [← hGh j]
    rfl

end SBHelpers3

section Lemma14Core

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]

theorem _root_.Fin.sum_eq_sum_castLE_of_forall_eq_zero {M : Type*} [AddCommMonoid M] {k m : ℕ} (hkm : k ≤ m) (f : Fin m → M)
    (hf : ∀ t : Fin m, k ≤ (t : ℕ) → f t = 0) :
    ∑ t, f t = ∑ j : Fin k, f (Fin.castLE hkm j) := by
  classical
  have hmap : ∑ j : Fin k, f (Fin.castLE hkm j) =
      ∑ t ∈ Finset.univ.map (Fin.castLEEmb hkm), f t := by
    rw [Finset.sum_map]; rfl
  rw [hmap]
  refine (Finset.sum_subset (Finset.subset_univ _) fun t _ ht => hf t ?_).symm
  by_contra hlt
  exact ht (Finset.mem_map.mpr ⟨⟨t, by omega⟩, Finset.mem_univ _, Fin.ext rfl⟩)

/-- **The inductive step of Lemma 14** (p. 229): given `(g₁, …, g_k)` extendable to a standard
base of `J₁` with `ν_{M₁}(g_j) = ν_j`, and `ν_{k+1} ≤ ν^{(k+1)}(J₁)`, the element `f_{k+1}` can be
modified (by subtracting combinations `∑ (x^{ν_{k+1} - ν_j} h_j) f_j`) until
`ν_{M₁}(x^{-ν_{k+1}} f_{k+1}) = ν_{k+1}`, and then `(g₁, …, g_{k+1})` can be extended to a
standard base of `J₁`.  The bound `μ ≤ ν_{k+1}` on the order `μ` of `g_{k+1}` ("we have always
`μ ≤ ν_i` by virtue of Lemma 8 of §3", p. 229), also for the modified `f_{k+1}`, is
`TransformCoord.ordElem_le_of_pow_mul_eq`. -/
theorem exists_isStandardBase_extendsToStandardBase_snoc [P.IsPrime]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (J : Ideal R) {m : ℕ} (ν : Fin m → ℕ) (hνmono : Monotone ν) (k : ℕ) (hkm : k < m)
    (h : Fin k → T.ring) (hext : ExtendsToStandardBase (strictTransformIdeal T J) h)
    (hhν : ∀ j : Fin k, Ideal.ordElem (maximalIdeal T.ring) (h j) = ν (Fin.castLE hkm.le j))
    (hνJ₁ : (ν ⟨k, hkm⟩ : ℕ∞) ≤ nuI T.ring (strictTransformIdeal T J) k.succPNat) :
    ∀ (n : ℕ) (g : Fin m → R), IsStandardBase R J g →
      (∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j) →
      (∀ j : Fin m, (j : ℕ) ≤ k → Ideal.ordElem P (g j) = ν j) →
      (∀ j : Fin k, C.x₁ ^ ν (Fin.castLE hkm.le j) * h j = T.toRing (g (Fin.castLE hkm.le j))) →
      ∀ a : T.ring, C.x₁ ^ ν ⟨k, hkm⟩ * a = T.toRing (g ⟨k, hkm⟩) →
      Ideal.ordElem (maximalIdeal T.ring) a + n = ν ⟨k, hkm⟩ →
      ∃ g' : Fin m → R, IsStandardBase R J g' ∧ (∀ j, j ≠ ⟨k, hkm⟩ → g' j = g j) ∧
        Ideal.ordElem P (g' ⟨k, hkm⟩) = ν ⟨k, hkm⟩ ∧
        ∃ a' : T.ring, C.x₁ ^ ν ⟨k, hkm⟩ * a' = T.toRing (g' ⟨k, hkm⟩) ∧
          Ideal.ordElem (maximalIdeal T.ring) a' = ν ⟨k, hkm⟩ ∧
          ExtendsToStandardBase (strictTransformIdeal T J) (Fin.snoc h a' : Fin (k + 1) → T.ring) := by
  classical
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro g hg hgM hgP hgh a ha han
  set K : Fin m := ⟨k, hkm⟩ with hK
  set J₁ := strictTransformIdeal T J
  have hJ₁a : a ∈ J₁ := C.mem_strictTransformIdeal_of_pow_mul_eq (hg.1 K) (hgP K le_rfl).ge ha
  have hνle : ∀ j : Fin k, ν (Fin.castLE hkm.le j) ≤ ν K := fun j =>
    hνmono (Fin.le_def.mpr (by simp only [Fin.val_castLE, K]; exact j.2.le))
  have hρj : ∀ j : Fin k, C.ρ hrat (initialForm (maximalIdeal T.ring) (h j)) =
      initialForm (maximalIdeal R) (g (Fin.castLE hkm.le j)) := fun j =>
    ((C.ordElem_le_and_rho_initialForm_eq hrat _ _ (hgM _) (h j) (hgh j)).2 (hhν j)).2
  by_cases hn : n = 0
  · subst hn
    have hordA : Ideal.ordElem (maximalIdeal T.ring) a = ν K := by simpa using han
    refine ⟨g, hg, fun _ _ => rfl, hgP K le_rfl, a, ha, hordA, ?_⟩
    have hρK : C.ρ hrat (initialForm (maximalIdeal T.ring) a) =
        initialForm (maximalIdeal R) (g K) := ((C.ordElem_le_and_rho_initialForm_eq hrat _ _ (hgM K) a ha).2 hordA).2
    refine extendsToStandardBase_snoc J₁ h a hext hJ₁a (ν K) hordA (fun j => ?_) hνJ₁ ?_
    · rw [hhν j]; exact_mod_cast hνle j
    · intro hmem
      apply hg.2.2.2.2 K
      have := Ideal.mem_map_of_mem (C.ρ hrat) hmem
      rw [Ideal.map_span, hρK] at this
      refine (Ideal.span_mono ?_) this
      rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      exact ⟨j, (hρj j).symm⟩
  · -- `ν_{M₁}(g_{k+1}) = μ < ν_{k+1}`: modify `f_{k+1}`
    have hatop : Ideal.ordElem (maximalIdeal T.ring) a ≠ ⊤ := by
      intro htop
      rw [htop, top_add] at han
      exact ENat.top_ne_natCast _ han
    obtain ⟨μ, hμ⟩ := ENat.ne_top_iff_exists.mp hatop
    rw [← hμ] at han
    have hμn : μ + n = ν K := by exact_mod_cast han
    have haμ : a ∈ maximalIdeal T.ring ^ μ := Ideal.mem_pow_of_ordElem hμ.symm
    set ψ := initialForm (maximalIdeal T.ring) a with hψ
    have hψmk : ψ = AssocGraded.mk (maximalIdeal T.ring) μ a haμ := initialForm_eq_mk _ hμ.symm
    obtain ⟨m', G, hkm', hG, hGh⟩ := hext
    obtain ⟨hGJ, hφGJ, ⟨dG, hdG, hmonoG⟩, hspanG, hirrG⟩ := hG
    have hGsb : IsStandardBase T.ring J₁ G :=
      ⟨hGJ, hφGJ, ⟨dG, hdG, hmonoG⟩, hspanG, hirrG⟩
    have hdGord := ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J₁ G hGsb dG hdG
    have hdGν : ∀ j : Fin k, dG (Fin.castLE hkm' j) = ν (Fin.castLE hkm.le j) := by
      intro j
      have := hdGord (Fin.castLE hkm' j)
      rw [hGh j, hhν j] at this
      exact_mod_cast this.symm
    have hdGup : ∀ t : Fin m', k ≤ (t : ℕ) → ν K ≤ dG t := by
      intro t ht
      have hk : k < m' := lt_of_le_of_lt ht t.2
      have h1 := ordElem_eq_nuI_of_isStandardBase J₁ G hGsb ⟨k, hk⟩
      rw [hdGord] at h1
      have h2 : (ν K : ℕ∞) ≤ dG ⟨k, hk⟩ := by rw [h1]; exact hνJ₁
      exact (by exact_mod_cast h2 : ν K ≤ dG ⟨k, hk⟩).trans (hmonoG (Fin.mk_le_mk.mpr ht))
    -- `ψ` is a combination of the initial forms of `g₁, …, g_k`
    have hψJ₁ : ψ ∈ grIdeal (maximalIdeal T.ring) J₁ := Ideal.subset_span ⟨a, hJ₁a, rfl⟩
    rw [hspanG] at hψJ₁
    obtain ⟨c, hc, hc0, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span _ _ dG hdG
      (hψmk ▸ AssocGraded.mk_mem_homogeneous _ _ : ψ ∈ _) hψJ₁
    have hcsum' : ψ = ∑ j : Fin k, c (Fin.castLE hkm' j) *
        initialForm (maximalIdeal T.ring) (h j) := by
      rw [hcsum, Fin.sum_eq_sum_castLE_of_forall_eq_zero hkm']
      · refine Finset.sum_congr rfl fun j _ => ?_
        rw [hGh j]
      · intro t ht
        rw [hc0 t (by have := hdGup t ht; omega), zero_mul]
    -- lifts `hₜ` of the coefficients
    have hlift : ∀ j : Fin k, ∃ (ht : T.ring) (H : R)
        (hm : ht ∈ maximalIdeal T.ring ^ (μ - ν (Fin.castLE hkm.le j))),
        H ∈ P ^ (ν K - ν (Fin.castLE hkm.le j)) ∧
        C.x₁ ^ (ν K - ν (Fin.castLE hkm.le j)) * ht = T.toRing H ∧
        AssocGraded.mk (maximalIdeal T.ring) (μ - ν (Fin.castLE hkm.le j)) ht hm =
          c (Fin.castLE hkm' j) := by
      intro j
      by_cases hjμ : ν (Fin.castLE hkm.le j) ≤ μ
      · have hχ := hc (Fin.castLE hkm' j)
        rw [hdGν j] at hχ
        exact C.exists_pow_mul_eq_and_mk_eq hrat hχ _ (by omega)
      · have h0 : c (Fin.castLE hkm' j) = 0 := hc0 _ (by rw [hdGν j]; omega)
        refine ⟨0, 0, zero_mem _, zero_mem _, by simp, ?_⟩
        rw [h0, AssocGraded.mk_eq_zero_iff]
        exact zero_mem _
    choose ht H hmH hHP hHx hHmk using hlift
    set a' := a - ∑ j, ht j * h j with ha'def
    set gK := g K - ∑ j, H j * g (Fin.castLE hkm.le j) with hgKdef
    have hmemh : ∀ j : Fin k, h j ∈ maximalIdeal T.ring ^ ν (Fin.castLE hkm.le j) := fun j =>
      Ideal.mem_pow_of_ordElem (hhν j)
    have hprod : ∀ j : Fin k, ht j * h j ∈ maximalIdeal T.ring ^ μ := fun j =>
      Ideal.pow_le_pow_right
        (show μ ≤ (μ - ν (Fin.castLE hkm.le j)) + ν (Fin.castLE hkm.le j) by omega)
        (by rw [pow_add]; exact Ideal.mul_mem_mul (hmH j) (hmemh j))
    have hprodmk : ∀ j : Fin k, AssocGraded.mk (maximalIdeal T.ring) μ (ht j * h j) (hprod j) =
        c (Fin.castLE hkm' j) * initialForm (maximalIdeal T.ring) (h j) := by
      intro j
      by_cases hjμ : ν (Fin.castLE hkm.le j) ≤ μ
      · rw [initialForm_eq_mk _ (hhν j), ← hHmk j, AssocGraded.mk_mul_mk]
        congr 1 <;> omega
      · have h0 : c (Fin.castLE hkm' j) = 0 := hc0 _ (by rw [hdGν j]; omega)
        rw [h0, zero_mul, AssocGraded.mk_eq_zero_iff]
        exact Ideal.pow_le_pow_right
          (show μ + 1 ≤ (μ - ν (Fin.castLE hkm.le j)) + ν (Fin.castLE hkm.le j) by omega)
          (by rw [pow_add]; exact Ideal.mul_mem_mul (hmH j) (hmemh j))
    have ha'mem : a' ∈ maximalIdeal T.ring ^ (μ + 1) := by
      have hsum : ∑ j, ht j * h j ∈ maximalIdeal T.ring ^ μ := sum_mem fun j _ => hprod j
      rw [← AssocGraded.mk_eq_zero_iff (maximalIdeal T.ring) (sub_mem haμ hsum),
        AssocGraded.mk_sub _ _ _ _ haμ hsum, AssocGraded.mk_sum _ _ _ _ hprod, ← hψmk, hcsum']
      simp only [hprodmk, sub_self]
    have hxa' : C.x₁ ^ ν K * a' = T.toRing gK := by
      rw [ha'def, hgKdef, map_sub, ← ha, mul_sub, map_sum, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, ← hHx j, ← hgh j]
      have : C.x₁ ^ ν K = C.x₁ ^ (ν K - ν (Fin.castLE hkm.le j)) *
          C.x₁ ^ ν (Fin.castLE hkm.le j) := by
        rw [← pow_add, Nat.sub_add_cancel (hνle j)]
      rw [this]; ring
    -- the new `f_{k+1}`
    have hgj : ∀ j : Fin k, g (Fin.castLE hkm.le j) ∈ P ^ ν (Fin.castLE hkm.le j) := fun j =>
      Ideal.mem_pow_of_ordElem (hgP _ (by simp only [Fin.val_castLE]; exact j.2.le))
    have hgKP : gK ∈ P ^ ν K := by
      refine sub_mem (Ideal.mem_pow_of_ordElem (hgP K le_rfl)) (sum_mem fun j _ => ?_)
      have := Ideal.mul_mem_mul (hHP j) (hgj j)
      rwa [← pow_add, Nat.sub_add_cancel (hνle j)] at this
    have hPM : P ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
    have hHM : ∀ j, H j ∈ maximalIdeal R ^ (ν K - ν (Fin.castLE hkm.le j)) := fun j =>
      Ideal.pow_right_mono hPM _ (hHP j)
    have hgjM : ∀ j : Fin k, g (Fin.castLE hkm.le j) ∈ maximalIdeal R ^ ν (Fin.castLE hkm.le j) :=
      fun j => Ideal.mem_pow_of_ordElem (hgM _)
    have hgKM : g K ∈ maximalIdeal R ^ ν K := Ideal.mem_pow_of_ordElem (hgM K)
    have hprodM : ∀ j : Fin k, H j * g (Fin.castLE hkm.le j) ∈ maximalIdeal R ^ ν K := fun j => by
      have := Ideal.mul_mem_mul (hHM j) (hgjM j)
      rwa [← pow_add, Nat.sub_add_cancel (hνle j)] at this
    set β : Fin k → AssocGraded (maximalIdeal R) := fun j =>
      AssocGraded.mk (maximalIdeal R) _ (H j) (hHM j)
    have hmkgK : AssocGraded.mk (maximalIdeal R) (ν K) gK
        (sub_mem hgKM (sum_mem fun j _ => hprodM j)) =
        initialForm (maximalIdeal R) (g K) -
          ∑ j : Fin k, β j * initialForm (maximalIdeal R) (g (Fin.castLE hkm.le j)) := by
      rw [AssocGraded.mk_sub _ _ _ _ hgKM (sum_mem fun j _ => hprodM j), AssocGraded.mk_sum _ _ _ _ hprodM,
        initialForm_eq_mk _ (hgM K)]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [initialForm_eq_mk _ (hgM _), AssocGraded.mk_mul_mk]
      have := hνle j
      congr 1 <;> omega
    have hmkne : AssocGraded.mk (maximalIdeal R) (ν K) gK
        (sub_mem hgKM (sum_mem fun j _ => hprodM j)) ≠ 0 := by
      rw [hmkgK, sub_ne_zero]
      intro heq
      apply hg.2.2.2.2 K
      dsimp only
      rw [heq]
      exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
    obtain ⟨hgKord, hgKin⟩ := Ideal.ordElem_eq_of_mk_ne_zero _ _ hmkne
    have hgKPord : Ideal.ordElem P gK = ν K := by
      refine le_antisymm ?_ (Ideal.le_ordElem hgKP)
      rw [← hgKord]
      exact Ideal.ordElem_le fun n hn => Ideal.le_ordElem (Ideal.pow_right_mono hPM n hn)
    set g' := Function.update g K gK with hg'def
    have hg'sb : IsStandardBase R J g' := by
      refine isStandardBase_update J g hg K gK
        (sub_mem (hg.1 K) (sum_mem fun j _ => J.mul_mem_left _ (hg.1 _))) β
        (hgKin.trans hmkgK) fun e he => ?_
      have hne : initialForm (maximalIdeal R) (g K) ≠ 0 := fun h0 =>
        hg.2.2.2.2 K (by beta_reduce; rw [h0]; exact zero_mem _)
      have hK' := initialForm_mem_homogeneous_toNat (g K)
      rw [hgM K, ENat.toNat_natCast] at hK'
      have := AssocGraded.degree_eq_of_mem_homogeneous_of_ne_zero _ he hK' hne
      rw [this, hgKin]
      exact AssocGraded.mk_mem_homogeneous _ _
    have hcastne : ∀ j : Fin k, Fin.castLE hkm.le j ≠ K := fun j h' => by
      have := congrArg Fin.val h'
      simp [K] at this
      omega
    have hg'M : ∀ j, Ideal.ordElem (maximalIdeal R) (g' j) = ν j := by
      intro j
      by_cases hj : j = K
      · subst hj; simpa [g'] using hgKord
      · rw [hg'def, Function.update_of_ne hj]; exact hgM j
    have hg'P : ∀ j : Fin m, (j : ℕ) ≤ k → Ideal.ordElem P (g' j) = ν j := by
      intro j hj
      by_cases hjK : j = K
      · subst hjK; simpa [g'] using hgKPord
      · rw [hg'def, Function.update_of_ne hjK]; exact hgP j hj
    have hg'h : ∀ j : Fin k, C.x₁ ^ ν (Fin.castLE hkm.le j) * h j =
        T.toRing (g' (Fin.castLE hkm.le j)) := fun j => by
      rw [hg'def, Function.update_of_ne (hcastne j)]; exact hgh j
    have hxa'' : C.x₁ ^ ν K * a' = T.toRing (g' K) := by simpa [g'] using hxa'
    -- the order of the new element increased
    -- `μ' ≤ ν_{k+1}` "by virtue of Lemma 8 of §3" (p. 229), applied to the new `f_{k+1}`
    have ha'le := C.ordElem_le_of_pow_mul_eq hrat (hg'P K le_rfl) (hg'M K) hxa''
    have ha'top : Ideal.ordElem (maximalIdeal T.ring) a' ≠ ⊤ :=
      ne_top_of_le_ne_top (ENat.natCast_ne_top _) ha'le
    obtain ⟨μ', hμ'⟩ := ENat.ne_top_iff_exists.mp ha'top
    have hμ'ge : μ + 1 ≤ μ' := by
      have := Ideal.le_ordElem ha'mem
      rw [← hμ'] at this
      exact_mod_cast this
    have hμ'le : μ' ≤ ν K := by rw [← hμ'] at ha'le; exact_mod_cast ha'le
    obtain ⟨g'', hg''sb, hg''eq, hg''P, a'', ha''⟩ :=
      ih (ν K - μ') (by omega) g' hg'sb hg'M hg'P hg'h a' hxa''
        (by rw [← hμ', ← Nat.cast_add, Nat.add_sub_cancel' hμ'le])
    refine ⟨g'', hg''sb, fun j hj => ?_, hg''P, a'', ha''⟩
    rw [hg''eq j hj]
    simp only [hg'def, Function.update_of_ne hj]

end TransformCoord

end Lemma14Core

section Lemma14Main

theorem Ideal.ordElem_eq_zero_of_isUnit {S : Type u} [CommRing S] [IsLocalRing S] {u : S} (hu : IsUnit u) :
    Ideal.ordElem (maximalIdeal S) u = 0 := by
  refine le_antisymm (Ideal.ordElem_le_of_notMem ?_) zero_le
  rw [zero_add, pow_one]
  exact fun h => (IsLocalRing.mem_maximalIdeal u).mp h hu

end Lemma14Main

end PE5Machinery

/-! ### Lemma 14 (pp. 227–229) -/

section Lemma14

/-- Lemma 14, p. 227: "Let `R` be a regular local ring, `P` a prime ideal in `R` such that `R/P`
is regular, and `J` an ideal in `R` which is contained in `P`. Let `R₁` be a monoidal transform
of `R` with center `P` which is residually rational over `R`, and `J₁` the strict transform of
`J` in `R₁`. Suppose that there exists a system of elements `(f₁, …, f_m)` of `J` and a positive
integer `i ≤ m` such that (i) `(f₁, …, f_m)` is a standard base of `J`; (ii) if
`ν_j = ν^{(j)}(J)` for `1 ≤ j ≤ m`, then we have `ν_P(f_j) = ν_j` for `1 ≤ j ≤ i`. Suppose,
furthermore, we have `(ν^{(1)}(J), …, ν^{(i)}(J)) ≤ (ν^{(1)}(J₁), …, ν^{(i)}(J₁))` in the sense
of lexicographical ordering. Then we can find a system of elements `(f₁, …, f_m)` of `J` which
has the properties (i), (ii) as above and, in addition to these, (iii) if `x` is an element of
`P` such that `PR₁ = (x)R₁`, and if `M₁` is the maximal ideal of `R₁`, then
`ν_{M₁}(x^{-ν_j} f_j) = ν_j` for all `j ≤ i`; (iv) if `g_j = x^{-ν_j} f_j` for `j ≤ i`, then
`(g₁, …, g_i)` can be extended to a standard base of `J₁`. In particular, we have
`ν^{(j)}(J) = ν^{(j)}(J₁)` for all `j ≤ i`."

Formalization notes.
(1) *Direction of the lexicographic hypothesis* (not a deviation).  The printed inequality
is `(ν^{(1)}(J), …, ν^{(i)}(J)) ≦ (ν^{(1)}(J₁), …, ν^{(i)}(J₁))`,
i.e. the initial segment of `ν*(J)` is at most that of `ν*(J₁)`; this is the direction used in
the proof ("the assumption `ν^{(1)}(J) ≦ ν^{(1)}(J₁)` implies that `ν_{M₁}(x^{-ν₁} f₁) = ν₁`",
p. 228, after Lemma 8 of §3 has given `ν_{M₁}(x^{-ν₁} f₁) ≦ ν₁`) and the direction which makes
Lemma 14 yield the inequality `ν*(J₁) ≤ ν*(J)` of Theorem 3 by contradiction.
(2) Formalization note (encoding): the integers `ν_j = ν^{(j)}(J)` of (ii) are carried by a
function `ν : Fin m → ℕ` with `hν : (ν j : ℕ∞) = ν^{(j+1)}(J)`; this is the paper's "if
`ν_j = ν^{(j)}(J)`", and it records that these characters are finite, as they are for `j ≤ m`
when `J` has a standard base of `m` elements (Lemma 1).
(3) `x^{-ν_j} f_j` is the element `h j` of `R₁` with `x ^ ν j * h j = T.toRing (f j)`, as in
Definition 5.  Deviation from the paper (statement modified): (iii) and (iv) are asserted for
every generator `x ∈ R₁` of `P R₁`, not only for elements `x ∈ P` (a harmless strengthening:
two generators differ by a unit).
(4) The hypotheses `[IsLocalHom T.toRing]` and `[IsRegularLocalRing T.ring]` (lemmas of §2) are not
needed (see the module docstring).
(5) Route of the proof (as printed, pp. 228–229).  The inequality `ν_{M₁}(x^{-ν}f) ≤ ν` is taken from
Lemma 8 of §3, as in the paper, at both places where the paper uses it (p. 228, case `i = 1`; p. 229,
"we have always `μ ≤ ν_i` by virtue of Lemma 8 of §3"): `TransformCoord.ordElem_le_of_pow_mul_eq` is
Lemma 8 (`nu_weakTransform_le`, stated for ideals) applied to the principal ideal `(f_j)`, whose
weak transform is `(x^{-ν_j} f_j)`.  The relation `ψ_j = φ_j(X̄₁, …, X̄_r) + λ_j` is proved by the
weight computation `(*)` of p. 229, in the form `ρ(ψ_j) = φ_j` (`ρ` the homomorphism of p. 231;
`TransformCoord.ordElem_le_and_rho_initialForm_eq`).  Property (iv), for which the paper only says
"we can prove (iv) by means of Lemma 1 and Definition 3", is proved by applying `ρ`.  The induction
starts from the empty system (the case `i = 1` is an instance of the inductive step), and "the above
modification of `f_i` can be repeated" is an induction on `ν_i − ν_{M₁}(x^{-ν_i}f_i)`.  Footnote 6
is not used (an arbitrary generator `x` of `PR₁` is handled by units). -/
@[blueprint "lem:III.14"
  (statement := /-- Let $R$ be a regular local ring, $P$ a prime ideal in $R$ such that $R/P$
    is regular, and $J$ an ideal in $R$ which is contained in $P$. Let $R_1$ be a monoidal
    transform of $R$ with center $P$ (\cref{def:III.2-monoidal-transform}) which is residually
    rational over $R$ (\cref{def:III.2-residually}), and $J_1$ the strict transform of $J$ in
    $R_1$ (\cref{def:III.5-strict}). Suppose that there exists a system of elements
    $(f_1,\dots,f_m)$ of $J$ and a positive integer $i\le m$ such that
    (i) $(f_1,\dots,f_m)$ is a standard base of $J$ (\cref{def:III.3});
    (ii) if $\nu_j=\nu^{(j)}(J)$ for $1\le j\le m$, then $\nu_P(f_j)=\nu_j$ for $1\le j\le i$.
    Suppose, furthermore, that
    $(\nu^{(1)}(J),\dots,\nu^{(i)}(J))\le(\nu^{(1)}(J_1),\dots,\nu^{(i)}(J_1))$ in the sense of
    the lexicographical ordering (\cref{def:III.2}). Then we can find a system of elements
    $(f_1,\dots,f_m)$ of $J$ which has the properties (i), (ii) above and, in addition,
    (iii) if $x$ is an element of $P$ such that $PR_1=(x)R_1$, and if $M_1$ is the maximal
    ideal of $R_1$, then $\nu_{M_1}(x^{-\nu_j}f_j)=\nu_j$ for all $j\le i$;
    (iv) if $g_j=x^{-\nu_j}f_j$ for $j\le i$, then $(g_1,\dots,g_i)$ can be extended to a
    standard base of $J_1$. In particular, $\nu^{(j)}(J)=\nu^{(j)}(J_1)$ for all $j\le i$.
    (Lemma 14, p.~227.)

    (The printed lexicographic hypothesis compares the initial segment of $\nu^*(J)$ with that
    of $\nu^*(J_1)$ in this direction, which is the one used in the proof and the one which
    yields $\nu^*(J_1)\le\nu^*(J)$ in \cref{thm:III.3}. Formalization note (encoding): the
    integers $\nu_j$ are carried by a function $\nu\colon\{1,\dots,m\}\to\mathbb Z_{\ge0}$
    with $\nu_j=\nu^{(j)}(J)$.)

    \textbf{Deviation from the paper (statement modified).} (iii) and (iv) are asserted for
    every generator $x\in R_1$ of $PR_1$, not only for $x\in P$ (a harmless strengthening: two
    generators differ by a unit). That $R\to R_1$ is local and $R_1$ regular are lemmas of \S2,
    no hypotheses of the statement. -/)
  (proof := /-- Let us choose a minimal base $(x,x_1,\dots,x_r)$ of $P$, where
    $r+1=\dim R-\dim R/P$ (footnote 6: since $PR_1=(x)R_1$, $R_1/(x)R_1$ is regular and
    therefore $x\notin M^2$, so that $x$ can be a member of a minimal base of $P$). Then,
    assuming $PR_1=(x)R_1$, $R_1$ is a localization of the ring $A_1=R[x_1/x,\dots,x_r/x]$
    with respect to a maximal ideal $N$ of $A_1$. Since $R_1$ is residually rational over $R$,
    we have the canonical isomorphism $A_1/N\cong R/M$, so we can find $(u_1,\dots,u_r)$ in
    $R$ with $x_j/x\equiv u_j\bmod N$. Replacing $x_j$ by $x_j-u_jx$, we may assume
    $x_j/x\in N$. Then, if $(y_1,\dots,y_s)$ are elements of $R$ whose images in $R/P$ form a
    regular system of parameters of $R/P$, the system $(x,x_1/x,\dots,x_r/x,y_1,\dots,y_s)$ is
    a regular system of parameters of $R_1$ (\S2, before \cref{lem:III.4}). Identify
    $\operatorname{gr}_M(R)$ with $k[X,X_1,\dots,X_r,Y_1,\dots,Y_s]$ and
    $\operatorname{gr}_{M_1}(R_1)$ with $k[X,X_1,\dots,X_r,Y_1,\dots,Y_s]$, $k=R/M=R_1/M_1$,
    $X,X_a,Y_b$ corresponding to the classes of $x,x_a,y_b$ resp.\ of $x,x_a/x,y_b$.

    We argue by induction on $i$. For $i=1$: by Lemma~8 of \S3 (\cref{lem:III.8}) we must have
    $\nu_{M_1}(x^{-\nu_1}f_1)\le\nu_1$; hence the assumption
    $\nu^{(1)}(J)\le\nu^{(1)}(J_1)$ implies $\nu_{M_1}(x^{-\nu_1}f_1)=\nu_1$ and that $g_1$ can
    be extended to a standard base of $J_1$. Let $i>1$ and assume the lemma for smaller $i$;
    thus we may assume (iii)$'$ $\nu_{M_1}(x^{-\nu_j}f_j)=\nu_j$ for $j\le i-1$, and (iv)$'$
    $(g_1,\dots,g_{i-1})$ can be extended to a standard base of $J_1$, $g_j=x^{-\nu_j}f_j$.

    Let $\varphi_j$ (resp.\ $\psi_j$) be the initial form of $f_j$ (resp.\ $g_j$) in
    $\operatorname{gr}_M(R)$ (resp.\ $\operatorname{gr}_{M_1}(R_1)$). By (ii) and (iii)$'$,
    $\varphi_j$ is a form only in $X_1,\dots,X_r$, and $\psi_j$ is of the form
    $\psi_j=\varphi_j(\bar X_1,\dots,\bar X_r)+\lambda_j$ for $j\le i-1$, where $\lambda_j$ is
    $0$ or a form of degree $\nu_j$ in the ideal
    $(X,Y_1,\dots,Y_s)k[X,\bar X_1,\dots,\bar X_r,Y_1,\dots,Y_s]$. In fact, write
    $f_j=\bigl(\sum_{(a)}c_{(a)}x^{a_0}x_1^{a_1}\cdots x_r^{a_r}\bigr)+h$ with
    $a_0+a_1+\dots+a_r\ge\nu_j$, $c_{(a)}\in(y_1,\dots,y_s)^{\mu_{(a)}}R$ with
    $\mu_{(a)}=\nu_M(c_{(a)})$ and $h\in P^{2\nu_j+1}$; the assumption
    $\nu_{M_1}(g_j)=\nu_j$ implies $(*)$ $\mu_{(a)}+a_0+2(a_1+\dots+a_r)-\nu_j\ge\nu_j$
    for all $(a)$ occurring. Hence, if $\bar c_{(a)}$ denotes the initial form of $c_{(a)}$ in
    $\operatorname{gr}_M(R)$ (a form in $k[Y_1,\dots,Y_s]$), $\psi_j$ is the sum of those terms
    $\bar c_{(a)}X^b\bar X_1^{a_1}\cdots\bar X_r^{a_r}$ with $b=a_0+a_1+\dots+a_r-\nu_j$ and
    $\mu_{(a)}+b+a_1+\dots+a_r=\nu_j$, while $\varphi_j$ is the sum of those terms
    $\bar c_{(a)}X^{a_0}X_1^{a_1}\cdots X_r^{a_r}$ with
    $\mu_{(a)}+a_0+a_1+\dots+a_r=\nu_j$; in view of $(*)$, $\mu_{(a)}=a_0=0$ and
    $a_1+\dots+a_r=\nu_j$. This gives the expressions of $\psi_j$ in terms of $\varphi_j$.

    If $f_i$ is also such that $\nu_{M_1}(g_i)=\nu_i$, we get a similar expression for
    $\psi_i$ in terms of $\varphi_i$ and, in view of the inequality between $\nu^{(i)}(J)$ and
    $\nu^{(i)}(J_1)$, we can prove (iv) by means of Lemma~1 and Definition~3 of \S1
    (\cref{lem:III.1}, \cref{def:III.3}). Now suppose $\nu_{M_1}(g_i)=\mu<\nu_i$ (note
    $\mu\le\nu_i$ always, by \cref{lem:III.8}). By (iv)$'$,
    $\operatorname{gr}^\mu_{M_1}(J_1,R_1)=\operatorname{gr}^\mu_{M_1}(R_1)\cap
    (\psi_1,\dots,\psi_{i-1})\operatorname{gr}_{M_1}(R_1)$. Therefore we have linear
    combinations $h_j$ of monomials of degree $\mu-\nu_j\ (\ge0)$ in
    $x,x_1/x,\dots,x_r/x,y_1,\dots,y_s$ with coefficients in $R$ such that, if $\lambda_j'$ is
    the class of $h_j$ in $\operatorname{gr}^{\mu-\nu_j}_{M_1}(R_1)$, then
    $\psi_i=\sum_j\lambda_j'\psi_j$; this means $g_i-\sum_jh_jg_j\in M_1^{\mu+1}$. Let
    $f_i'=x^{\nu_i}(g_i-\sum_jh_jg_j)=f_i-\sum_j(x^{\mu-\nu_j}h_j)x^{\nu_i-\mu}f_j$. By
    the selection of the $h_j$, $x^{\mu-\nu_j}h_j\in P^{\mu-\nu_j}$; hence
    $f_i'\in P^{\nu_i}$ and the class of $f_i'$ in $\operatorname{gr}^{\nu_i}_M(R)$ is of the
    form $\varphi_i-\sum_j\delta_j\varphi_j$ with forms $\delta_j$ of degree
    $\nu_i-\nu_j\ (>0)$. Replacing $f_i$ by $f_i'$ leaves (i) and (ii) valid, while
    $\nu_{M_1}(x^{-\nu_i}f_i')>\nu_{M_1}(x^{-\nu_i}f_i)$. This modification can be repeated
    until $\nu_{M_1}(x^{-\nu_i}f_i)=\nu_i$.

    \textbf{Paper misprint.} On p.~229 the paper prints ``$g_i-\sum_kh_jg_j\in M_1^{\mu+1}$''
    (summation index $k$ for $j$) and ``we have
    $\nu_{M_1}(x^{-\nu_i}f_i)<\nu_{M_1}(x^{-\nu_i}f_i)$'' (the prime on the right-hand $f_i'$ is
    missing); the intended statements are given above.

    \textbf{Formalization (the route of the proof as printed).} The coordinates are those of
    \cref{lem:III.2-residually-rational-rsop} (p.~210) for some generator $x_0$ of $PR_1$; an
    arbitrary generator $x$ is handled at the end by multiplying by units (footnote~6 is not
    used). The inequality $\nu_{M_1}(x^{-\nu}f)\le\nu$ is taken from Lemma~8 of \S3
    (\cref{lem:III.8}) as in the paper, at both places where the paper uses it (the case $i=1$,
    and ``$\mu\le\nu_i$ always''): Lemma~8, which is stated for ideals, is applied to the
    principal ideal $(f)$, whose weak transform is $(x^{-\nu}f)$ when $\nu=\nu_P(f)=\nu_M(f)$.
    The expression $\psi_j=\varphi_j(\bar X)+\lambda_j$ is proved by the weight computation
    $(*)$ of p.~229, in the form $\rho(\psi_j)=\varphi_j$, where $\rho$ is the homomorphism of
    the proof of \cref{lem:III.15}. Property (iv), for which the paper only says ``we can prove
    (iv) by means of Lemma~1 and Definition~3'', is proved by applying $\rho$:
    $\psi_i\notin(\psi_1,\dots,\psi_{i-1})$ because $\varphi_i\notin(\varphi_1,\dots,
    \varphi_{i-1})$. The induction starts from the empty system (the case $i=1$ is an instance
    of the inductive step), and the repetition of the modification is an induction on
    $\nu_i-\nu_{M_1}(x^{-\nu_i}f_i)$. -/)
  (latexEnv := "lemma")]
theorem exists_standardBase_extendsToStandardBase (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] (P : Ideal R) [P.IsPrime] [IsRegularLocalRing (R ⧸ P)]
    (J : Ideal R) (hJP : J ≤ P) (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {m : ℕ} (f : Fin m → R) (i : ℕ+) (him : (i : ℕ) ≤ m) (ν : Fin m → ℕ)
    (hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat))
    (h₁ : IsStandardBase R J f)
    (h₂ : ∀ j : Fin m, (j : ℕ) < (i : ℕ) → Ideal.ordElem P (f j) = (ν j : ℕ∞))
    (hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
      toLex fun j : Fin (i : ℕ) =>
        nuI T.ring (strictTransformIdeal T J) ((j : ℕ).succPNat)) :
    (∃ g : Fin m → R, IsStandardBase R J g ∧
      (∀ j : Fin m, (j : ℕ) < (i : ℕ) → Ideal.ordElem P (g j) = (ν j : ℕ∞)) ∧
      ∀ x : T.ring, Ideal.span {x} = P.map T.toRing →
        ∃ h : Fin (i : ℕ) → T.ring,
          (∀ j : Fin (i : ℕ), x ^ ν (Fin.castLE him j) * h j = T.toRing (g (Fin.castLE him j))) ∧
          (∀ j : Fin (i : ℕ), Ideal.ordElem (maximalIdeal T.ring) (h j) =
            (ν (Fin.castLE him j) : ℕ∞)) ∧
          ExtendsToStandardBase (strictTransformIdeal T J) h) ∧
    ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) → nuI R J j = nuI T.ring (strictTransformIdeal T J) j := by
  classical
  have _ := hJP
  obtain ⟨C⟩ := TransformCoord.nonempty T hrat
  set J₁ := strictTransformIdeal T J with hJ₁
  have hgM : ∀ g : Fin m → R, IsStandardBase R J g →
      ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j := fun g hg j =>
    (ordElem_eq_nuI_of_isStandardBase J g hg j).trans (hν j).symm
  have hνmono : Monotone ν := by
    obtain ⟨d, hd, hmono⟩ := h₁.2.2.1
    intro a b hab
    have ha := ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J f h₁ d hd a
    have hb := ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J f h₁ d hd b
    rw [hgM f h₁] at ha hb
    have ha' : ν a = d a := by exact_mod_cast ha
    have hb' : ν b = d b := by exact_mod_cast hb
    rw [ha', hb']
    exact hmono hab
  -- the inductive construction
  have key : ∀ k : ℕ, ∀ hk : k ≤ (i : ℕ), ∃ g : Fin m → R, IsStandardBase R J g ∧
      (∀ j : Fin m, (j : ℕ) < (i : ℕ) → Ideal.ordElem P (g j) = ν j) ∧
      ∃ h : Fin k → T.ring,
        (∀ j : Fin k, C.x₁ ^ ν (Fin.castLE (hk.trans him) j) * h j =
          T.toRing (g (Fin.castLE (hk.trans him) j))) ∧
        (∀ j : Fin k, Ideal.ordElem (maximalIdeal T.ring) (h j) = ν (Fin.castLE (hk.trans him) j)) ∧
        ExtendsToStandardBase J₁ h := by
    intro k
    induction k with
    | zero =>
      intro _
      obtain ⟨m', G, hG⟩ := exists_isStandardBase J₁
      exact ⟨f, h₁, h₂, Fin.elim0, fun j => j.elim0, fun j => j.elim0,
        ⟨m', G, Nat.zero_le _, hG, fun j => j.elim0⟩⟩
    | succ k ih =>
      intro hk
      have hk' : k ≤ (i : ℕ) := by omega
      have hkm : k < m := by omega
      obtain ⟨g, hg, hgP, h, hgh, hhν, hext⟩ := ih hk'
      set K : Fin m := ⟨k, hkm⟩ with hK
      -- `ν_{k+1} ≤ ν^{(k+1)}(J₁)` (the lexicographic hypothesis)
      have hνJ₁ : (ν K : ℕ∞) ≤ nuI T.ring J₁ k.succPNat := by
        obtain ⟨m', G, hkm', hG, hGh⟩ := hext
        have heq : ∀ j : Fin k, nuI T.ring J₁ (j : ℕ).succPNat = nuI R J (j : ℕ).succPNat := by
          intro j
          have h1 := ordElem_eq_nuI_of_isStandardBase J₁ G hG (Fin.castLE hkm' j)
          rw [hGh j, hhν j, hν] at h1
          exact h1.symm
        by_contra hlt
        push Not at hlt
        rw [hν K] at hlt
        have hki : k < (i : ℕ) := by omega
        have hlex' : toLex (fun j : Fin (i : ℕ) =>
            nuI T.ring J₁ ((j : ℕ).succPNat)) <
            toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) :=
          ⟨⟨k, hki⟩, fun j hj => heq ⟨j, hj⟩, hlt⟩
        exact not_lt.mpr hlex hlex'
      have hgP' : ∀ j : Fin m, (j : ℕ) ≤ k → Ideal.ordElem P (g j) = ν j := fun j hj =>
        hgP j (by omega)
      obtain ⟨a, ha⟩ := C.exists_pow_mul_eq_of_mem_pow (Ideal.mem_pow_of_ordElem (hgP' K le_rfl))
      -- "By Lemma 8 of §3, we must have `ν_{M₁}(x^{-ν_{k+1}} f_{k+1}) ≤ ν_{k+1}`" (p. 228)
      have hale := C.ordElem_le_of_pow_mul_eq hrat (hgP' K le_rfl) (hgM g hg K) ha
      obtain ⟨μ, hμ⟩ := ENat.ne_top_iff_exists.mp (ne_top_of_le_ne_top (ENat.natCast_ne_top _) hale)
      have hμle : μ ≤ ν K := by rw [← hμ] at hale; exact_mod_cast hale
      obtain ⟨g', hg', hg'eq, hg'P, a', ha', ha'ord, hext'⟩ :=
        C.exists_isStandardBase_extendsToStandardBase_snoc hrat J ν hνmono k hkm h hext hhν hνJ₁ (ν K - μ) g hg (hgM g hg) hgP' hgh
          a ha (by rw [← hμ, ← Nat.cast_add, Nat.add_sub_cancel' hμle])
      refine ⟨g', hg', fun j hj => ?_, Fin.snoc h a', fun j => ?_, fun j => ?_, hext'⟩
      · by_cases hjK : j = K
        · rw [hjK]; exact hg'P
        · rw [hg'eq j hjK]; exact hgP j hj
      · refine Fin.lastCases ?_ (fun j => ?_) j
        · simp only [Fin.snoc_last]
          have : Fin.castLE (hk.trans him) (Fin.last k) = K := Fin.ext (by simp [K])
          rw [this]; exact ha'
        · simp only [Fin.snoc_castSucc]
          have h1 : Fin.castLE (hk.trans him) (Fin.castSucc j) = Fin.castLE (hk'.trans him) j :=
            Fin.ext (by simp)
          have h2 : Fin.castLE (hk'.trans him) j ≠ K := fun h' => by
            have := congrArg Fin.val h'
            simp [K] at this
            omega
          rw [h1, hg'eq _ h2]
          exact hgh j
      · refine Fin.lastCases ?_ (fun j => ?_) j
        · simp only [Fin.snoc_last]
          have : Fin.castLE (hk.trans him) (Fin.last k) = K := Fin.ext (by simp [K])
          rw [this]; exact ha'ord
        · simp only [Fin.snoc_castSucc]
          have h1 : Fin.castLE (hk.trans him) (Fin.castSucc j) = Fin.castLE (hk'.trans him) j :=
            Fin.ext (by simp)
          rw [h1]
          exact hhν j
  obtain ⟨g, hg, hgP, h, hgh, hhν, hext⟩ := key i le_rfl
  refine ⟨⟨g, hg, hgP, fun x hx => ?_⟩, fun j hj => ?_⟩
  · -- another generator `x` of `PR₁` differs from `x₀` by a unit
    rw [← C.span_x₁] at hx
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hx.symm
    refine ⟨fun j => ((u⁻¹ : (T.ring)ˣ) : T.ring) ^ ν (Fin.castLE him j) * h j, fun j => ?_,
      fun j => ?_, extendsToStandardBase_mul_of_isUnit J₁ h _ (fun j => (Units.isUnit _).pow _) hext⟩
    · rw [← hgh j, ← hu, mul_pow, ← mul_assoc, mul_assoc (C.x₁ ^ _), ← mul_pow, Units.mul_inv,
        one_pow, mul_one]
    · rw [ordElem_mul_maximalIdeal, Ideal.ordElem_eq_zero_of_isUnit ((Units.isUnit _).pow _), zero_add]
      exact hhν j
  · -- `ν^{(j)}(J) = ν^{(j)}(J₁)` for `j ≤ i`
    obtain ⟨m', G, hkm', hG, hGh⟩ := hext
    have hj1 : (j : ℕ) - 1 < (i : ℕ) := by have := j.pos; omega
    have h1 := ordElem_eq_nuI_of_isStandardBase J₁ G hG (Fin.castLE hkm' ⟨(j : ℕ) - 1, hj1⟩)
    rw [hGh, hhν, hν] at h1
    have h2 : ((Fin.castLE hkm' ⟨(j : ℕ) - 1, hj1⟩ : Fin m') : ℕ).succPNat = j := by
      apply PNat.eq; simp; have := j.pos; omega
    have h3 : ((Fin.castLE him ⟨(j : ℕ) - 1, hj1⟩ : Fin m) : ℕ).succPNat = j := by
      apply PNat.eq; simp; have := j.pos; omega
    rw [h2, h3] at h1
    exact h1

end Lemma14

end Hironaka

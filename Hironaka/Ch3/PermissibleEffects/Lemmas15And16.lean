variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

theorem AssocGraded.smul_mk {A : Type*} [CommRing A] (I : Ideal A) (n : ℕ) (r x : A)
    (hx : x ∈ I ^ n) :
    (Ideal.Quotient.mk I r) • AssocGraded.mk I n x hx =
      AssocGraded.mk I n (r * x) (Ideal.mul_mem_left _ r hx) := by
  rw [← Ideal.Quotient.algebraMap_eq, IsScalarTower.algebraMap_smul]
  exact (map_smul (AssocGraded.mkLinear I n) r ⟨x, hx⟩).symm

/-- The classes in `gr¹_M(R) = M/M²` of a system of generators of `M` span `gr¹_M(R)`. -/
theorem AssocGraded.homogeneous_one_le_span {g : Set R} (hg : Ideal.span g = maximalIdeal R) :
    AssocGraded.homogeneous (maximalIdeal R) 1 ≤ Submodule.span (R ⧸ maximalIdeal R)
      (Set.range fun y : g => AssocGraded.mk (maximalIdeal R) 1 y.1
        (by rw [pow_one, ← hg]; exact Ideal.subset_span y.2)) := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous _ hx
  clear hx
  have hy' : y ∈ Ideal.span g := by rw [hg, ← pow_one (maximalIdeal R)]; exact hy
  induction hy' using Submodule.span_induction with
  | mem y h => exact Submodule.subset_span ⟨⟨y, h⟩, rfl⟩
  | zero =>
    rw [(AssocGraded.mk_eq_zero_iff _ hy).mpr (zero_mem _)]
    exact zero_mem _
  | add x y hx' hy' ihx ihy =>
    have hx1 : x ∈ maximalIdeal R ^ 1 := by rw [pow_one, ← hg]; exact hx'
    have hy1 : y ∈ maximalIdeal R ^ 1 := by rw [pow_one, ← hg]; exact hy'
    rw [AssocGraded.mk_add _ 1 x y hx1 hy1]
    exact add_mem (ihx hx1) (ihy hy1)
  | smul r x hx' ihx =>
    have hx1 : x ∈ maximalIdeal R ^ 1 := by rw [pow_one, ← hg]; exact hx'
    rw [show AssocGraded.mk (maximalIdeal R) 1 (r • x) hy = _ from
      (AssocGraded.smul_mk (maximalIdeal R) 1 r x hx1).symm]
    exact Submodule.smul_mem _ _ (ihx hx1)

open Classical in
/-- Elements of the maximal ideal whose classes in `gr¹_M(R) = M/M²` are linearly independent can
be extended to a regular system of parameters (the argument of p. 223, `lem:III.7-extends`). -/
theorem extendsToRSOP_of_linearIndependent {ι : Type*} [Fintype ι] (z : ι → maximalIdeal R)
    (hli : LinearIndependent (R ⧸ maximalIdeal R) fun i =>
      AssocGraded.mk (maximalIdeal R) 1 (z i) (by rw [pow_one]; exact (z i).2)) :
    ExtendsToRSOP R (Finset.univ.image fun i => (z i : R)) := by
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let w : ι → AssocGraded (maximalIdeal R) := fun i =>
    AssocGraded.mk (maximalIdeal R) 1 (z i) (by rw [pow_one]; exact (z i).2)
  have hw1 : ∀ i, w i ∈ AssocGraded.homogeneous (maximalIdeal R) 1 := fun i =>
    AssocGraded.mk_mem_homogeneous _ _
  -- extend the `w i` to a basis `b` of `gr¹_M(R) = M/M²`
  have hsub : Set.range w ⊆ (AssocGraded.homogeneous (maximalIdeal R) 1 : Set _) := by
    rintro _ ⟨i, rfl⟩
    exact hw1 i
  obtain ⟨b, hb1, hwb, hbspan, hbli⟩ :=
    exists_linearIndepOn_id_extension hli.linearIndepOn_id hsub
  have hfg : (AssocGraded.homogeneous (maximalIdeal R) 1).FG := by
    rw [AssocGraded.homogeneous, LinearMap.range_eq_map]
    exact Module.Finite.fg_top.map _
  obtain ⟨τ', W, hW⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hbfin : b.Finite := by
    have : Finite b := LinearIndependent.finite_of_le_span_finite
      (fun x : b => (x : AssocGraded (maximalIdeal R))) hbli (Set.range W)
      (by rintro _ ⟨x, rfl⟩; rw [hW]; exact hb1 x.2)
    exact Set.toFinite b
  have hbeq :
      Submodule.span (R ⧸ maximalIdeal R) b = AssocGraded.homogeneous (maximalIdeal R) 1 :=
    le_antisymm (Submodule.span_le.mpr hb1) hbspan
  -- lift the elements of `b` to elements `L x` of `M`, lifting `w i` to `z i`
  have hlift : ∀ x ∈ AssocGraded.homogeneous (maximalIdeal R) 1, ∃ y : R,
      ∃ hy : y ∈ maximalIdeal R ^ 1, AssocGraded.mk (maximalIdeal R) 1 y hy = x :=
    fun x hx => AssocGraded.exists_mk_eq_of_mem_homogeneous _ hx
  let L : AssocGraded (maximalIdeal R) → R := fun x =>
    if h : x ∈ Set.range w then (z h.choose : R)
    else if h' : x ∈ AssocGraded.homogeneous (maximalIdeal R) 1 then (hlift x h').choose else 0
  have hL : ∀ x ∈ b, ∃ hy : L x ∈ maximalIdeal R ^ 1,
      AssocGraded.mk (maximalIdeal R) 1 (L x) hy = x := by
    intro x hx
    by_cases h : x ∈ Set.range w
    · simp only [L, dite_eq_left h]
      exact ⟨by rw [pow_one]; exact (z h.choose).2, h.choose_spec⟩
    · have h' : x ∈ AssocGraded.homogeneous (maximalIdeal R) 1 := hb1 hx
      simp only [L, dite_eq_right h, dite_eq_left h']
      exact (hlift x h').choose_spec
  have hLz : ∀ i, L (w i) = z i := by
    intro i
    have h : w i ∈ Set.range w := ⟨i, rfl⟩
    simp only [L, dite_eq_left h]
    rw [hli.injective h.choose_spec]
  have hmk : ∀ (x y : R) (hx : x ∈ maximalIdeal R ^ 1) (hy : y ∈ maximalIdeal R ^ 1), x = y →
      AssocGraded.mk (maximalIdeal R) 1 x hx = AssocGraded.mk (maximalIdeal R) 1 y hy := by
    rintro x y hx hy rfl
    rfl
  have hLinj : Set.InjOn L b := by
    intro x hx x' hx' hxx'
    obtain ⟨hy, hmkx⟩ := hL x hx
    obtain ⟨hy', hmkx'⟩ := hL x' hx'
    rw [← hmkx, ← hmkx']
    exact hmk _ _ hy hy' hxx'
  let s : Finset R := hbfin.toFinset.image L
  have hsM : (s : Set R) ⊆ maximalIdeal R := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
    obtain ⟨hy, -⟩ := hL x (hbfin.mem_toFinset.mp hx)
    rwa [pow_one] at hy
  -- `M = (s)R + M²`: the classes of the elements of `s` span `M/M²`
  have hsup : maximalIdeal R ≤ Ideal.span (s : Set R) ⊔ maximalIdeal R ^ 2 := by
    let π := AssocGraded.mkLinear (maximalIdeal R) 1
    let N₀ : Submodule R ↥(maximalIdeal R ^ 1) := Submodule.comap (maximalIdeal R ^ 1).subtype
      (Ideal.span (s : Set R) ⊔ maximalIdeal R ^ 2)
    have hker : LinearMap.ker π ≤ N₀ := by
      intro y hy
      rw [LinearMap.mem_ker, AssocGraded.mkLinear_apply, AssocGraded.mk_eq_zero_iff] at hy
      exact Submodule.mem_sup_right hy
    have hrange : Submodule.map π ⊤ ≤ Submodule.map π N₀ := by
      rw [Submodule.map_top]
      rintro _ ⟨y, rfl⟩
      have h1 : π y ∈ Submodule.span (R ⧸ maximalIdeal R) b :=
        hbspan (AssocGraded.mk_mem_homogeneous _ y.2)
      have h2 : π y ∈ Submodule.span R b := by
        rw [← Submodule.restrictScalars_span R (R ⧸ maximalIdeal R) Ideal.Quotient.mk_surjective]
        exact h1
      refine Submodule.span_le.mpr ?_ h2
      intro x hx
      obtain ⟨hy, hmkx⟩ := hL x hx
      exact ⟨⟨L x, hy⟩, Submodule.mem_sup_left (Ideal.subset_span
        (Finset.mem_image_of_mem L (hbfin.mem_toFinset.mpr hx))), hmkx⟩
    have hle := (LinearMap.map_le_map_iff π).mp hrange
    rw [sup_eq_left.mpr hker] at hle
    intro m hm
    exact hle (Submodule.mem_top (x := (⟨m, by rwa [pow_one]⟩ : ↥(maximalIdeal R ^ 1))))
  -- Nakayama: `M = (s)R`
  have hspan : Ideal.span (s : Set R) = maximalIdeal R := by
    refine le_antisymm (Ideal.span_le.mpr hsM) ?_
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).symm.le ?_
    rw [Ideal.smul_eq_mul, ← sq]
    exact hsup
  -- counting: `#s = dim_K M/M² = spanFinrank M = dim R`
  have hcard_s : s.card = hbfin.toFinset.card :=
    Finset.card_image_of_injOn (by rw [hbfin.coe_toFinset]; exact hLinj)
  have hcard_b : hbfin.toFinset.card =
      Module.finrank (R ⧸ maximalIdeal R) (AssocGraded.homogeneous (maximalIdeal R) 1) := by
    have : Fintype b := hbfin.fintype
    rw [← hbeq, finrank_span_set_eq_card hbli]
    simp [Set.toFinset_card]
  have hge : (maximalIdeal R).spanFinrank ≤ s.card := by
    have := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) s.finite_toSet
    rw [Set.ncard_coe_finset] at this
    rwa [← hspan]
  have hle : s.card ≤ (maximalIdeal R).spanFinrank := by
    obtain ⟨g, hgcard, hgspan⟩ :=
      (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
    have hsp := AssocGraded.homogeneous_one_le_span (g := (g : Set R)) hgspan
    have : FiniteDimensional (R ⧸ maximalIdeal R) (Submodule.span (R ⧸ maximalIdeal R)
        (Set.range fun y : (g : Set R) => AssocGraded.mk (maximalIdeal R) 1 y.1
          (by rw [pow_one, ← hgspan]; exact Ideal.subset_span y.2))) :=
      FiniteDimensional.span_of_finite _ (Set.finite_range _)
    have h1 := Submodule.finrank_mono hsp
    have h2 := finrank_range_le_card (R := R ⧸ maximalIdeal R)
      (fun y : (g : Set R) => AssocGraded.mk (maximalIdeal R) 1 y.1
        (by rw [pow_one, ← hgspan]; exact Ideal.subset_span y.2))
    rw [hcard_s, hcard_b, ← hgcard]
    simp only [Finset.coe_sort_coe, Fintype.card_coe] at h2
    exact h1.trans h2
  refine ⟨s, ?_, hspan, ?_⟩
  · intro y hy
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hy
    rw [← hLz i]
    exact Finset.mem_image_of_mem L (hbfin.mem_toFinset.mpr (hwb ⟨i, rfl⟩))
  · rw [le_antisymm hle hge]
    exact IsRegularLocalRing.spanFinrank_maximalIdeal

end Beta

section P1

/-- A ring isomorphism of associated graded rings mapping constants to constants maps
`k[span W]` into `k'[span σ(W)]`. -/
theorem ringEquiv_mem_adjoin_span {A B : Type u} [CommRing A] [CommRing B] {I : Ideal A} {I' : Ideal B}
    (σ : AssocGraded I ≃+* AssocGraded I')
    (hσc : ∀ c : A ⧸ I, ∃ c' : B ⧸ I', σ (algebraMap _ _ c) = algebraMap _ _ c')
    {τ : ℕ} (W : Fin τ → AssocGraded I) {x : AssocGraded I}
    (hx : x ∈ Algebra.adjoin (A ⧸ I) (Submodule.span (A ⧸ I) (Set.range W) : Set (AssocGraded I))) :
    σ x ∈ Algebra.adjoin (B ⧸ I')
      (Submodule.span (B ⧸ I') (Set.range fun l => σ (W l)) : Set (AssocGraded I')) := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    refine Algebra.subset_adjoin ?_
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l, rfl⟩ := hy
      exact Submodule.subset_span ⟨l, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul c y _ hy =>
      obtain ⟨c', hc'⟩ := hσc c
      rw [Algebra.smul_def, map_mul, hc', ← Algebra.smul_def]
      exact Submodule.smul_mem _ _ hy
  | algebraMap c =>
    obtain ⟨c', hc'⟩ := hσc c
    rw [hc']
    exact Subalgebra.algebraMap_mem _ _
  | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
  | mul y z _ _ hy hz => rw [map_mul]; exact mul_mem hy hz

/-- Transport of the property of Definition 6 along an isomorphism of graded rings which matches
`gr^μ(J)` with `gr^μ(J')` for `μ ≤ μ₀`. -/
theorem isTauSubmodule_of_ringEquiv {A B : Type u} [CommRing A] [IsRegularLocalRing A]
    [CommRing B] [IsRegularLocalRing B] (J : Ideal A) (J' : Ideal B)
    (σ : AssocGraded (maximalIdeal A) ≃+* AssocGraded (maximalIdeal B))
    (hσh : ∀ μ, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal A) μ,
      σ x ∈ AssocGraded.homogeneous (maximalIdeal B) μ)
    (hσhs : ∀ μ, ∀ y ∈ AssocGraded.homogeneous (maximalIdeal B) μ,
      σ.symm y ∈ AssocGraded.homogeneous (maximalIdeal A) μ)
    (hσc : ∀ c : A ⧸ maximalIdeal A, ∃ c' : B ⧸ maximalIdeal B,
      σ (algebraMap _ _ c) = algebraMap _ _ c')
    (μ₀ : ℕ) (hJ : ∀ μ ≤ μ₀, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal A) μ,
      (x ∈ grIdeal (maximalIdeal A) J ↔ σ x ∈ grIdeal (maximalIdeal B) J'))
    {τ : ℕ} (W : Fin τ → AssocGraded (maximalIdeal A))
    (hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal A) 1)
    (hW : IsTauSubmodule A J (Submodule.span (A ⧸ maximalIdeal A) (Set.range W)) μ₀) :
    IsTauSubmodule B J' (Submodule.span (B ⧸ maximalIdeal B) (Set.range fun l => σ (W l))) μ₀ := by
  classical
  have hspanW1 : ∀ s ∈ (Submodule.span (A ⧸ maximalIdeal A) (Set.range W) :
      Set (AssocGraded (maximalIdeal A))),
      s ∈ AssocGraded.homogeneous (maximalIdeal A) 1 := fun s hs => hW.1 hs
  refine ⟨Submodule.span_le.mpr ?_, fun μ hμ ψ hψ => ⟨fun hψJ => ?_, fun hmem => ?_⟩⟩
  · rintro _ ⟨l, rfl⟩
    exact hσh 1 _ (hW1 l)
  · have hx := hσhs μ ψ hψ
    have hxJ : σ.symm ψ ∈ grIdeal (maximalIdeal A) J := by
      rw [hJ μ hμ _ hx, RingEquiv.apply_symm_apply]; exact hψJ
    have hxW := (hW.2 μ hμ _ hx).mp hxJ
    obtain ⟨B', w', hB, hw', hw'e, hdec⟩ := AssocGraded.exists_proj_eq_add_of_mem_span _
      {w | w ∈ grIdeal (maximalIdeal A) J ∧
        w ∈ Algebra.adjoin (A ⧸ maximalIdeal A)
          (Submodule.span (A ⧸ maximalIdeal A) (Set.range W) :
            Set (AssocGraded (maximalIdeal A)))}
      (fun w hw d => ⟨AssocGraded.proj_mem_grIdeal _ _ hw.1 d, AssocGraded.proj_mem_adjoin _ hspanW1 hw.2 d⟩)
      ⟨zero_mem _, zero_mem _⟩
      (fun w hw w' hw' => ⟨add_mem hw.1 hw'.1, add_mem hw.2 hw'.2⟩)
      (fun c hc w hw => by
        obtain ⟨c₀, rfl⟩ := AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero _ hc
        exact ⟨Ideal.mul_mem_left _ _ hw.1, mul_mem (Subalgebra.algebraMap_mem _ _) hw.2⟩)
      hxW μ
    rw [AssocGraded.proj_of_mem_homogeneous _ hx] at hdec
    set K : Set (AssocGraded (maximalIdeal A)) := {w | (w ∈ grIdeal (maximalIdeal A) J ∧
      w ∈ Algebra.adjoin (A ⧸ maximalIdeal A)
        (Submodule.span (A ⧸ maximalIdeal A) (Set.range W) :
          Set (AssocGraded (maximalIdeal A)))) ∧
      ∃ d ≤ μ, w ∈ AssocGraded.homogeneous (maximalIdeal A) d} with hK
    have hxK : σ.symm ψ ∈ Ideal.span K := by
      rw [hdec]
      refine add_mem ((Ideal.span_mono ?_) hB) (Ideal.subset_span ⟨hw', μ, le_rfl, hw'e⟩)
      rintro w ⟨hw, d, hd, hwd⟩
      exact ⟨hw, d, hd.le, hwd⟩
    have h1 := mem_span_image_of_mem_span σ hxK
    rw [RingEquiv.apply_symm_apply] at h1
    refine (Ideal.span_mono ?_) h1
    rintro _ ⟨w, ⟨⟨hwJ, hwA⟩, d, hd, hwd⟩, rfl⟩
    exact ⟨(hJ d (hd.trans hμ) w hwd).mp hwJ, ringEquiv_mem_adjoin_span σ hσc W hwA⟩
  · refine (Ideal.span_le.mpr ?_) hmem
    rintro _ ⟨hJ', -⟩
    exact hJ'

/-- `τ^{(a)}(J') ≤ τ^{(a)}(J)` along an isomorphism of graded rings matching `gr^μ(J)` with
`gr^μ(J')` for `μ ≤ μ^{(a)}(J) = μ^{(a)}(J')`. -/
theorem tau_le_of_ringEquiv {A B : Type u} [CommRing A] [IsRegularLocalRing A]
    [CommRing B] [IsRegularLocalRing B] (J : Ideal A) (J' : Ideal B)
    (σ : AssocGraded (maximalIdeal A) ≃+* AssocGraded (maximalIdeal B))
    (hσh : ∀ μ, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal A) μ,
      σ x ∈ AssocGraded.homogeneous (maximalIdeal B) μ)
    (hσhs : ∀ μ, ∀ y ∈ AssocGraded.homogeneous (maximalIdeal B) μ,
      σ.symm y ∈ AssocGraded.homogeneous (maximalIdeal A) μ)
    (hσc : ∀ c : A ⧸ maximalIdeal A, ∃ c' : B ⧸ maximalIdeal B,
      σ (algebraMap _ _ c) = algebraMap _ _ c')
    (a : ℕ) (hmu : mu B J' a = mu A J a)
    (hJ : ∀ μ ≤ mu A J a, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal A) μ,
      (x ∈ grIdeal (maximalIdeal A) J ↔ σ x ∈ grIdeal (maximalIdeal B) J')) :
    tau B J' a ≤ tau A J a := by
  obtain ⟨W, hW1, hW⟩ := tau_spec A J a
  have := isTauSubmodule_of_ringEquiv J J' σ hσh hσhs hσc _ hJ W hW1 hW
  rw [← hmu] at this
  exact tau_le B J' _ (fun l => hσh 1 _ (hW1 l)) this

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The classes in `gr¹_M(R)` of the members of a regular system of parameters are linearly
independent over `R/M`. -/
theorem linearIndependent_mk_of_isRegularSystemOfParameters {Z : Finset R} (hZ : IsRegularSystemOfParameters R Z) :
    LinearIndependent (R ⧸ maximalIdeal R) fun z : Z => AssocGraded.mk (maximalIdeal R) 1
      (z : R) (by rw [pow_one, ← hZ.1]; exact Ideal.subset_span z.2) := by
  classical
  have hspan : Ideal.span (Set.range fun z : Z => (z : R)) = maximalIdeal R := by
    rw [Subtype.range_coe_subtype, Finset.setOfPred_mem]; exact hZ.1
  have hdim : ((Fintype.card Z : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
    rw [Fintype.card_coe]; exact hZ.2
  have hb := aeval_mk_bijective (fun z : Z => (z : R)) hspan hdim
    (fun z => by rw [pow_one, ← hZ.1]; exact Ideal.subset_span z.2)
  have h1 := (MvPolynomial.linearIndependent_X (R := R ⧸ maximalIdeal R) (σ := Z)).map'
    (aeval (R := R ⧸ maximalIdeal R) fun z : Z => AssocGraded.mk (maximalIdeal R) 1 (z : R)
      (by rw [pow_one, ← hZ.1]; exact Ideal.subset_span z.2)).toLinearMap
    (LinearMap.ker_eq_bot.mpr hb.1)
  convert h1 using 1
  funext z
  simp

/-- The initial form of an element of `Uᵈ` of order `d`, `U` generated by elements `u_l` of the
maximal ideal, lies in the subalgebra generated by the classes of the `u_l`. -/
theorem initialForm_mem_adjoin_mk {ι : Type*} (u : ι → R) (hu : ∀ l, u l ∈ maximalIdeal R ^ 1)
    {f : R} {d : ℕ} (hf : f ∈ Ideal.span (Set.range u) ^ d)
    (hord : Ideal.ordElem (maximalIdeal R) f = d) :
    initialForm (maximalIdeal R) f ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      (Set.range fun l => AssocGraded.mk (maximalIdeal R) 1 (u l) (hu l)) := by
  obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous u f).mp hf
  rw [initialForm_eq_mk _ hord, ← aeval_mk_map_of_isHomogeneous (maximalIdeal R) u hu hK,
    Algebra.adjoin_range_eq_range_aeval]
  exact ⟨_, rfl⟩

namespace TransformCoord

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}
  {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]
  (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)

/-- `ρ` reflects linear independence (it is semilinear over `k₁ ≅ k`). -/
theorem linearIndependent_of_ρ {ι : Type*} [Fintype ι] (v : ι → AssocGraded (maximalIdeal T.ring))
    (hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (v l)) :
    LinearIndependent (T.ring ⧸ maximalIdeal T.ring) v := by
  rw [Fintype.linearIndependent_iff] at hli ⊢
  intro c hc l
  have h1 := congrArg (C.ρ hrat) hc
  rw [map_sum, map_zero] at h1
  simp only [ρ_smul] at h1
  have h2 := hli _ h1 l
  simpa using h2

/-- `ρ` kills the class of `x₀`. -/
theorem ρ_initialForm_x₁ : C.ρ hrat (initialForm (maximalIdeal T.ring) C.x₁) = 0 := by
  rw [C.initialForm_x₁.2, ρ_e₁, MvPolynomial.map_X, pureSubst, aeval_X]
  simp [xWeight]

end TransformCoord


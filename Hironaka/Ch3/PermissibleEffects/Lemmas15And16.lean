      (tauSubmodule T.ring J₁ a : Set (AssocGraded (maximalIdeal T.ring))), σ₀ x = C.ρ hrat x := by
    rw [← hWspan]
    intro x hx
    exact hσρ x (Algebra.adjoin_mono (Submodule.span_mono
      (show Set.range W ⊆ Set.range Zb from
        Set.range_subset_iff.mpr fun l => ⟨Sum.inl l, hZbW l⟩)) hx)
  -- ## the forms `φ_s`, `ψ_s` and the ideals `I`, `Ĩ`
  have hhJ₁ : ∀ s, h s ∈ J₁ := fun s => by
    obtain ⟨m', G, him', hG, hGh⟩ := hext
    rw [← hGh s]; exact hG.1 _
  set ν' : Fin (i : ℕ) → ℕ := fun s => ν (Fin.castLE him s) with hν'
  set φ : Fin (i : ℕ) → AssocGraded (maximalIdeal R) :=
    fun s => initialForm (maximalIdeal R) (g (Fin.castLE him s)) with hφ
  set ψ : Fin (i : ℕ) → AssocGraded (maximalIdeal T.ring) :=
    fun s => initialForm (maximalIdeal T.ring) (h s) with hψ
  have hψdeg : ∀ s, ψ s ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν' s) := by
    intro s
    show initialForm _ (h s) ∈ _
    rw [initialForm_eq_mk _ (hhν s)]
    exact AssocGraded.mk_mem_homogeneous _ _
  have hρψ : ∀ s, C.ρ hrat (ψ s) = φ s := fun s =>
    ((C.ordElem_le_and_rho_initialForm_eq hrat _ _ (hgM _) (h s) (hgh s)).2 (hhν s)).2
  have hψJ₁ : ∀ s, ψ s ∈ grIdeal (maximalIdeal T.ring) J₁ := fun s =>
    Ideal.subset_span ⟨h s, hhJ₁ s, rfl⟩
  have hφJ : ∀ s, φ s ∈ grIdeal (maximalIdeal R) J := fun s =>
    Ideal.subset_span ⟨_, hg.1 _, rfl⟩
  set Itl : Ideal (AssocGraded (maximalIdeal T.ring)) := Ideal.span (Set.range ψ) with hItl
  set Iid : Ideal (AssocGraded (maximalIdeal R)) := Ideal.span (Set.range φ) with hIid
  have hgr₁ : ∀ μ ≤ μb, ∀ w ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ,
      w ∈ grIdeal (maximalIdeal T.ring) J₁ → w ∈ Itl := fun μ hμ w hw hwJ =>
    mem_span_initialForm_of_extendsToStandardBase_of_lt_nuI J₁ h hext hwJ hw
      (lt_of_le_of_lt (Nat.cast_le.mpr hμ) hgap')
  have hgr : ∀ μ ≤ μb, ∀ w ∈ AssocGraded.homogeneous (maximalIdeal R) μ,

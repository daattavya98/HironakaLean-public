/-! ### Lemma 15 (pp. 229–231) -/

section Lemma15

/-- Lemma 15, pp. 229–230: "Let `R`, `J`, `P`, `R₁`, `J₁` be the same as in Lemma 14. Suppose we
have a system of elements `(f₁, …, f_m)` of `J` and a positive integer `a ≤ t(J)` such that
(i) `(f₁, …, f_m)` is a standard base of `J`, and (ii) if `i` is the largest integer such that
`ν^{(i)}(J) = μ^{(a)}(J)`, then we have `ν_P(f_j) = ν^{(j)}(J)` for all `j ≤ i`. If
`(ν^{(1)}(J), …, ν^{(i)}(J)) = (ν^{(1)}(J₁), …, ν^{(i)}(J₁))` we have `τ^{(b)}(J) ≤ τ^{(b)}(J₁)`
for all positive integer `b ≤ a`."

Encoding: "`i` is the largest integer such that `ν^{(i)}(J) = μ^{(a)}(J)`" is
`IsGreatest {k : ℕ+ | nuI R J k = μ^{(a)}(J)} i`; the equality of the initial segments is the
equality of `ν^{(j)}(J)` and `ν^{(j)}(J₁)` for every positive integer `j ≤ i`.

Route of the proof (as printed, pp. 230–231; `tau_le_tau_strictTransform_of_isGreatest_mu`).
`I = (φ₁, …, φ_i) gr_M(R)` satisfies `gr^μ_M(J, R) = I_μ` for `μ ≤ μ̄`, so `T_a`
(`tauSubmodule`, the smallest `k`-submodule with the property of Definition 6, Corollary to Lemma 10)
is the smallest one with the property for `I` (`IsTauSubmoduleOfIdeal`); the `φ_s` are forms in
`X₁, …, X_r` (`φ_s = ι(Φ_s)`, `Φ_s = ρ(ψ_s)`, `ι : k[X₁, …, X_r] → gr_M(R)`), `T_a` lies in the
linear part of `k[X₁, …, X_r]`, and the property of a submodule of `k[X₁, …, X_r]₁` for the ideal
`I⁰ = (Φ_s)` implies the property for `I` (`TransformCoord.isTauSubmoduleOfIdeal_map_ι`).  For `J₁`:
`Ĩ = (ψ₁, …, ψ_i) gr_{M₁}(R₁)`, `T̃` the smallest submodule for `J₁`, and (v)
`Ĩ_μ = gr^μ(R₁) ∩ (Ĩ ∩ k[T̃]) gr(R₁)` for `μ ≤ μ̄` by the printed chain of inclusions
(`IsTauSubmoduleOfIdeal.of_forall_lt_mem`).  Applying `ρ` (`TransformCoord.ρ₀`, with `ρ = ι ∘ ρ₀`) to
(v) gives the property of `ρ(T̃)` for `I⁰` (`TransformCoord.isTauSubmoduleMv_span_ρ₀`), so
`T_a ⊆ ρ(T̃)` by minimality (`TransformCoord.tauSubmodule_le_span_ρ`) and
`τ^{(a)}(J) = rank T_a ≤ rank ρ(T̃) ≤ rank T̃ = τ^{(a)}(J₁)` (`TransformCoord.finrank_span_ρ_le`).
Gaps of the paper that are filled: the reduction to `b = a` ("it is clear") and the equality
`μ^{(a)}(J) = μ^{(a)}(J₁)` (`mu_eq_of_nuI_eq`, `le_t_of_nuI_eq`); the equivalences "the property of
`T` is equivalent to the same property for `I⁰`" and the passage from `gr_M(J, R)` to `I`, proved in
both directions (`IsTauSubmoduleOfIdeal.of_forall_lt_mem`, `.of_forall_le_mem`,
`TransformCoord.isTauSubmoduleOfIdeal_map_ι`, `TransformCoord.isTauSubmoduleMv_of_isTauSubmoduleOfIdeal_map_ι`);
the claim that `ρ(Ĩ_μ) = I⁰_μ` (`TransformCoord.exists_mem_span_homogeneous_ρ₀_eq`). -/
@[blueprint "lem:III.15"
  (statement := /-- Let $R$, $J$, $P$, $R_1$, $J_1$ be the same as in \cref{lem:III.14}.
    Suppose we have a system of elements $(f_1,\dots,f_m)$ of $J$ and a positive integer
    $a\le t(J)$ (\cref{def:III.6-t}) such that (i) $(f_1,\dots,f_m)$ is a standard base of $J$
    (\cref{def:III.3}), and (ii) if $i$ is the largest integer such that
    $\nu^{(i)}(J)=\mu^{(a)}(J)$ (\cref{def:III.6-mu}), then $\nu_P(f_j)=\nu^{(j)}(J)$ for all
    $j\le i$. If $(\nu^{(1)}(J),\dots,\nu^{(i)}(J))=(\nu^{(1)}(J_1),\dots,\nu^{(i)}(J_1))$,
    then $\tau^{(b)}(J)\le\tau^{(b)}(J_1)$ for all positive integers $b\le a$
    (\cref{def:III.6}). (Lemma 15, pp.~229--230.) -/)
  (proof := /-- By \cref{lem:III.14} we may assume that (iii) if $x\in P$ is such that
    $PR_1=(x)R_1$ and $g_j=x^{-\nu_j}f_j$ with $\nu_j=\nu^{(j)}(J)$, then
    $\nu_{M_1}(g_j)=\nu_j$ for all $j\le i$, and (iv) $(g_1,\dots,g_i)$ can be extended to a
    standard base of $J_1$. Let $k=R/M=R_1/M_1$ and choose, as in the proof of
    \cref{lem:III.14}, a regular system of parameters $(x,x_1,\dots,x_r,y_1,\dots,y_s)$ of $R$
    with $P=(x,x_1,\dots,x_r)R$ and $(x,x_1/x,\dots,x_r/x,y_1,\dots,y_s)$ a regular system of
    parameters of $R_1$; identify $\operatorname{gr}_M(R)$ with
    $k[X,X_1,\dots,X_r,Y_1,\dots,Y_s]$ and $\operatorname{gr}_{M_1}(R_1)$ with
    $k[X,X_1,\dots,X_r,Y_1,\dots,Y_s]$. It suffices to show
    $\tau^{(a)}(J)\le\tau^{(a)}(J_1)$. Let $\varphi_j$ be the initial form of $f_j$ in
    $\operatorname{gr}_M(R)$ and $\psi_j$ that of $g_j$ in $\operatorname{gr}_{M_1}(R_1)$. By
    (ii) and (iii), $\varphi_1,\dots,\varphi_i$ are forms only in $X_1,\dots,X_r$ and, as in
    the proof of \cref{lem:III.14}, $\psi_j=\varphi_j(X_1,\dots,X_r)+\lambda_j$ for $j\le i$
    with $\lambda_j$ zero or a form of degree $\nu_j$ in
    $(X,Y_1,\dots,Y_s)k[X,X_1,\dots,X_r,Y_1,\dots,Y_s]$. The assumption on the initial
    segments implies $\mu^{(a)}(J)=\mu^{(a)}(J_1)$; let $\bar\mu=\mu^{(a)}(J)=\mu^{(a)}(J_1)$.
    By (i), the choice of $i$ gives
    $\operatorname{gr}^\mu_M(J,R)=\operatorname{gr}^\mu_M(R)\cap
    (\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$ for all $\mu\le\bar\mu$. Therefore, if
    $I=(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$, $\tau^{(a)}(J)$ is the rank of the
    smallest $k$-submodule $T$ of $\operatorname{gr}^1_M(R)$ with
    $I_\mu=\operatorname{gr}^\mu_M(R)\cap(I\cap k[T])\operatorname{gr}_M(R)$ for all
    $\mu\le\bar\mu$. Since $\varphi_1,\dots,\varphi_i$ are forms only in $X_1,\dots,X_r$, this
    smallest $T$ is contained in the linear part of $k[X_1,\dots,X_r]$; so, if $I^0$ is the
    homogeneous ideal of $k[X_1,\dots,X_r]$ generated by $\varphi_1,\dots,\varphi_i$, the
    property of $T$ is equivalent to
    $I^0_\mu=k[X_1,\dots,X_r]_\mu\cap(I^0\cap k[T])k[X_1,\dots,X_r]$ for all $\mu\le\bar\mu$.

    On the other hand, (iv) implies that if $\tilde I=(\psi_1,\dots,\psi_i)
    \operatorname{gr}_{M_1}(R_1)$ then $\tilde I_\mu=\operatorname{gr}^\mu_{M_1}(J_1,R_1)$ for
    all $\mu<\bar\mu$, and $\tilde I_{\bar\mu}\subseteq
    \operatorname{gr}^{\bar\mu}_{M_1}(J_1,R_1)$. Let $\tilde T$ be the smallest $k$-submodule
    of $\operatorname{gr}^1_{M_1}(R_1)$ with
    $\operatorname{gr}^\mu_{M_1}(J_1,R_1)=\operatorname{gr}^\mu_{M_1}(R_1)\cap
    (\operatorname{gr}_{M_1}(J_1,R_1)\cap k[\tilde T])\operatorname{gr}_{M_1}(R_1)$ for all
    $\mu\le\bar\mu$, so that $\tau^{(a)}(J_1)$ is its rank. Then (v)
    $\tilde I_\mu=\operatorname{gr}^\mu_{M_1}(R_1)\cap(\tilde I\cap k[\tilde T])
    \operatorname{gr}_{M_1}(R_1)$ for all $\mu\le\bar\mu$; this is clear for $\mu<\bar\mu$,
    and for $\mu=\bar\mu$ it follows from the chain of inclusions
    $\tilde I_{\bar\mu}\subseteq\sum_{\mu<\bar\mu}(\tilde I_\mu\cap k[\tilde T])
    \operatorname{gr}_{M_1}(R_1)+\tilde I_{\bar\mu}\cap k[\tilde T]$, the reverse inclusion
    being obvious. Now consider the homomorphism $\rho$ of graded $k$-algebras
    $\operatorname{gr}_{M_1}(R_1)\to k[X_1,\dots,X_r]$ with $\rho(X)=\rho(Y_1)=\dots=
    \rho(Y_s)=0$ and $\rho(X_j)=X_j$. From $\psi_j=\varphi_j+\lambda_j$ we get
    $\rho(\psi_j)=\varphi_j$ for $j\le i$, hence $\rho(\tilde I)=I^0$. Applying $\rho$ to (v)
    gives $I^0_\mu=k[X_1,\dots,X_r]_\mu\cap(I^0\cap k[\rho(\tilde T)])k[X_1,\dots,X_r]$ for
    all $\mu\le\bar\mu$. Therefore the $k$-module $\rho(\tilde T)$ contains a module with the
    property of $T$, so $\tau^{(a)}(J)=\operatorname{rank}T\le\operatorname{rank}
    \rho(\tilde T)\le\operatorname{rank}\tilde T=\tau^{(a)}(J_1)$.

    \textbf{Formalization (the route of the proof as printed).} $I=(\varphi_1,\dots,\varphi_i)
    \operatorname{gr}_M(R)$ and $T$ is the smallest $k$-submodule of $\operatorname{gr}^1_M(R)$ with
    the property of \cref{def:III.6} (\cref{cor:III.lem10}); it is also the smallest one with the
    property for $I$, since $I_\mu=\operatorname{gr}^\mu_M(J,R)$ for $\mu\le\bar\mu$. The ring
    $k[X_1,\dots,X_r]$ is the polynomial ring in $r$ variables, embedded in
    $\operatorname{gr}_M(R)$ by $\iota$; $\varphi_s=\iota(\Phi_s)$ with $\Phi_s=\rho(\psi_s)$,
    $I^0=(\Phi_1,\dots,\Phi_i)$; $T$ lies in the linear part of $k[X_1,\dots,X_r]$, and a
    $k$-submodule of $k[X_1,\dots,X_r]_1$ with the property for $I^0$ has the property for $I$.
    Equality (v) is proved in general for a homogeneous ideal $\tilde I\subseteq
    \operatorname{gr}_{M_1}(J_1,R_1)$ agreeing with it in all degrees $<\bar\mu$, by the printed chain of
    inclusions in degree $\bar\mu$. The homomorphism $\rho$ with values in $k[X_1,\dots,X_r]$
    is applied to (v): $\rho(\tilde I_\mu)=I^0_\mu$, $\rho(k[\tilde T])\subseteq k[\rho(\tilde T)]$,
    so $\rho(\tilde T)$ has the property for $I^0$, hence for $I$, hence contains $T$; the ranks
    are compared as printed. The reduction to $b=a$ (``it is clear'') and the equality
    $\mu^{(a)}(J)=\mu^{(a)}(J_1)$ (asserted) are proved. -/)
  (latexEnv := "lemma")]
theorem tau_le_tau_strictTransform (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R]
    (P : Ideal R) [P.IsPrime] [IsRegularLocalRing (R ⧸ P)] (J : Ideal R) (hJP : J ≤ P)
    (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {m : ℕ} (f : Fin m → R) (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t R J)
    (h₁ : IsStandardBase R J f)
    (i : ℕ+) (hi : IsGreatest {k : ℕ+ | nuI R J k = (mu R J a : ℕ∞)} i)
    (h₂ : ∀ j : Fin m, (j : ℕ) < (i : ℕ) →
      Ideal.ordElem P (f j) = nuI R J ((j : ℕ).succPNat))
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) →
      nuI R J j = nuI T.ring (strictTransformIdeal T J) j) :
    ∀ b, 1 ≤ b → b ≤ a → tau R J b ≤ tau T.ring (strictTransformIdeal T J) b := by
  intro b hb hba
  obtain ⟨ib, hib⟩ := exists_isGreatest_nuI_eq_mu J b hb (hba.trans hat)
  -- `i_b ≤ i`
  have hle : ib ≤ i := by
    rcases hba.lt_or_eq with hlt | rfl
    · have hfin := (muSet_finite R J).1
      have hcard : a - 1 < hfin.toFinset.card := by
        rw [← Set.ncard_eq_toFinset_card _ hfin]
        have : t R J = (muSet R J).ncard := rfl
        omega
      have hmu : mu R J b < mu R J a :=
        Nat.nth_strictMonoOn hfin
          (by simp only [Set.mem_Iio]; exact lt_of_le_of_lt (Nat.sub_le_sub_right hba 1) hcard)
          (by simp only [Set.mem_Iio]; exact hcard) (by omega)
      by_contra hgt
      have h1 : nuI R J i ≤ nuI R J ib := nuI_mono J (le_of_lt (not_le.mp hgt))
      rw [hi.1, hib.1, Nat.cast_le] at h1
      omega
    · exact hi.2 hib.1
  exact tau_le_tau_strictTransform_of_isGreatest_mu R P J hJP T hrat f b hb (hba.trans hat) h₁ ib hib
    (fun j hj => h₂ j (lt_of_lt_of_le hj (PNat.coe_le_coe _ _ |>.mpr hle)))
    (fun j hj => heq j (hj.trans (PNat.coe_le_coe _ _ |>.mpr hle)))

end Lemma15

section Lemma16Aux

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- For `(h₁, …, h_i)` extendable to a standard base of `J`, every homogeneous element of
`gr_M(J, S)` of degree `d < ν^{(i+1)}(J)` lies in the ideal generated by those initial forms of the
`h_s` whose order is `≤ d`. -/
theorem mem_span_initialForm_of_extendsToStandardBase_of_le (J : Ideal S) {i : ℕ} (h : Fin i → S)
    (hext : ExtendsToStandardBase J h) {w : AssocGraded (maximalIdeal S)} {d : ℕ}
    (hwJ : w ∈ grIdeal (maximalIdeal S) J) (hwd : w ∈ AssocGraded.homogeneous _ d)
    (hd : (d : ℕ∞) < nuI S J i.succPNat) :
    w ∈ Ideal.span {x | ∃ s, Ideal.ordElem (maximalIdeal S) (h s) ≤ d ∧
      x = initialForm (maximalIdeal S) (h s)} := by
  classical
  obtain ⟨m', G, him', hG, hGh⟩ := hext
  obtain ⟨dG, hdG, -⟩ := hG.2.2.1
  have hdGord := ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J G hG dG hdG
  rw [hG.2.2.2.1] at hwJ
  obtain ⟨c, -, hc0, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span _ _ dG hdG hwd hwJ
  rw [hcsum, Fin.sum_eq_sum_castLE_of_forall_eq_zero him']
  · refine sum_mem fun s _ => ?_
    by_cases hs : Ideal.ordElem (maximalIdeal S) (h s) ≤ d
    · refine Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨s, hs, ?_⟩)
      rw [hGh s]
    · have h1 := hdGord (Fin.castLE him' s)
      rw [hGh s] at h1
      have h2 : d < dG (Fin.castLE him' s) := by
        have := not_le.mp hs
        rw [h1] at this
        exact_mod_cast this
      rw [hc0 _ h2, zero_mul]
      exact zero_mem _
  · intro t ht
    have h1 : (dG t : ℕ∞) = nuI S J (t : ℕ).succPNat :=
      (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J G hG dG hdG t).symm.trans (ordElem_eq_nuI_of_isStandardBase J G hG t)
    have h2 : nuI S J i.succPNat ≤ nuI S J (t : ℕ).succPNat :=
      nuI_mono J (by rw [← PNat.coe_le_coe]; simp; omega)
    have h3 : d < dG t := by
      have := hd.trans_le (h2.trans_eq h1.symm)
      exact_mod_cast this
    rw [hc0 t h3, zero_mul]

/-- Every `x ∈ μ*(J)` with `x ≤ μ^{(a)}(J)` is `μ^{(b)}(J)` for some `1 ≤ b ≤ a`. -/
theorem exists_mu_eq_of_mem_muSet (J : Ideal S) {x : ℕ} (hx : x ∈ muSet S J) (a : ℕ) (ha : 1 ≤ a)
    (hat : a ≤ t S J) (hxa : x ≤ mu S J a) : ∃ b, 1 ≤ b ∧ b ≤ a ∧ mu S J b = x := by
  classical
  have hfin := (muSet_finite S J).1
  have hcount : Nat.count (· ∈ muSet S J) (mu S J a) = a - 1 := by
    rw [mu]
    refine Nat.count_nth_of_lt_card_finite hfin ?_
    rw [← Set.ncard_eq_toFinset_card _ hfin]
    have : t S J = (muSet S J).ncard := rfl
    omega
  have hle : Nat.count (· ∈ muSet S J) x ≤ a - 1 :=
    hcount ▸ Nat.count_monotone _ hxa
  refine ⟨Nat.count (· ∈ muSet S J) x + 1, by omega, by omega, ?_⟩
  rw [mu, Nat.add_sub_cancel]
  exact Nat.nth_count hx

/-- `T_a ⊆ T_{a'}` for `1 ≤ a ≤ a' ≤ t(J)` (Corollary to Lemma 10, p. 222, iterated). -/
theorem tauSubmodule_mono_of_le (J : Ideal S) {a a' : ℕ} (ha : 1 ≤ a) (haa' : a ≤ a')
    (ha't : a' ≤ t S J) : tauSubmodule S J a ≤ tauSubmodule S J a' := by
  induction a', haa' using Nat.le_induction with
  | base => exact le_rfl
  | succ a' haa' ih =>
    exact (ih (by omega)).trans (by
      simpa using (tauSubmodule_mono S J (a' + 1) (by omega) ha't).1)

/-- A family of vectors adapted to an increasing sequence of finite-dimensional subspaces (used for the
base "`(Z̄_1, …, Z̄_r, X, Y_1, …, Y_s)` of the `k`-module `gr¹_{M₁}(R₁)` such that `T̃_b` is generated by
`Z̄_1, …, Z̄_{τ_b}` for `1 ≤ b ≤ a`", p. 233; a copy of the private `exists_flag_family` of
`Hironaka/Ch3/TauStar.lean`). -/
theorem exists_flag_family_of_monotone {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (T : ℕ → Submodule K V) (hT : Monotone T) (hfin : ∀ b, FiniteDimensional K (T b)) (n : ℕ) :
    ∃ w : ℕ → V, ∀ b ≤ n,
      Submodule.span K (w '' Set.Iio (Module.finrank K (T b))) = T b := by
  have hrk : Monotone fun b => Module.finrank K (T b) := fun b b' h => by
    have := hfin b'
    exact Submodule.finrank_mono (hT h)
  induction n with
  | zero =>
    let c := Module.finBasis K (T 0)
    refine ⟨fun i => if h : i < Module.finrank K (T 0) then (c ⟨i, h⟩ : V) else 0, ?_⟩
    intro b hb
    obtain rfl : b = 0 := by omega
    have himg : (fun i => if h : i < Module.finrank K (T 0) then (c ⟨i, h⟩ : V) else 0) ''
        Set.Iio (Module.finrank K (T 0)) = Set.range fun i => (c i : V) := by
      ext x
      constructor
      · rintro ⟨i, hi, rfl⟩
        exact ⟨⟨i, hi⟩, by simp [Set.mem_Iio.mp hi]⟩
      · rintro ⟨i, rfl⟩
        exact ⟨i, i.2, by simp⟩
    rw [himg, show (fun i => (c i : V)) = (T 0).subtype ∘ c from rfl, Set.range_comp,
      Submodule.span_image, c.span_eq, Submodule.map_top, Submodule.range_subtype]
  | succ n ih =>
    obtain ⟨w, hw⟩ := ih
    -- a complement `C` of `T n` in `T (n + 1)`
    obtain ⟨D₀, hD₀⟩ := Submodule.exists_isCompl ((T n).comap (T (n + 1)).subtype)
    set C := D₀.map (T (n + 1)).subtype with hC
    have hCle : C ≤ T (n + 1) := Submodule.map_subtype_le _ _
    have hsup : T n ⊔ C = T (n + 1) := by
      refine le_antisymm (sup_le (hT (Nat.le_succ n)) hCle) fun x hx => ?_
      have hmem : (⟨x, hx⟩ : T (n + 1)) ∈ (T n).comap (T (n + 1)).subtype ⊔ D₀ := by
        rw [hD₀.sup_eq_top]; exact Submodule.mem_top
      obtain ⟨a, ha, d, hd, had⟩ := Submodule.mem_sup.mp hmem
      exact Submodule.mem_sup.mpr ⟨a, ha, d, Submodule.mem_map_of_mem hd,
        by simpa using congrArg Subtype.val had⟩
    have hinf : T n ⊓ C = ⊥ := by
      rw [eq_bot_iff]
      rintro x ⟨hxT, hxC⟩
      obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hxC
      have hy' : y ∈ (T n).comap (T (n + 1)).subtype := hxT
      rw [(Submodule.disjoint_def.mp hD₀.disjoint) y hy' hy]
      exact zero_mem _
    have := hfin (n + 1)
    have hCfin : FiniteDimensional K C := Submodule.finiteDimensional_of_le hCle
    have hrkC : Module.finrank K C =
        Module.finrank K (T (n + 1)) - Module.finrank K (T n) := by
      have h := Submodule.finrank_sup_add_finrank_inf_eq (T n) C
      rw [hsup, hinf, finrank_bot] at h
      omega
    let c := Module.finBasisOfFinrankEq K C hrkC
    set d₀ := Module.finrank K (T n) with hd₀
    set d₁ := Module.finrank K (T (n + 1)) with hd₁
    have hd : d₀ ≤ d₁ := hrk (Nat.le_succ n)
    refine ⟨fun i => if i < d₀ then w i else
      if h : i - d₀ < d₁ - d₀ then (c ⟨i - d₀, h⟩ : V) else 0, fun b hb => ?_⟩
    rcases Nat.lt_or_ge b (n + 1) with hbn | hbn
    · -- the old part of the family is unchanged
      have hbd : Module.finrank K (T b) ≤ d₀ := hrk (by omega)
      refine Eq.trans ?_ (hw b (by omega))
      congr 1
      refine Set.image_congr fun i hi => ?_
      simp [lt_of_lt_of_le (Set.mem_Iio.mp hi) hbd]
    · obtain rfl : b = n + 1 := by omega
      have himg : (fun i => if i < d₀ then w i else
          if h : i - d₀ < d₁ - d₀ then (c ⟨i - d₀, h⟩ : V) else 0) '' Set.Iio d₁ =
          w '' Set.Iio d₀ ∪ Set.range fun i => (c i : V) := by
        ext x
        constructor
        · rintro ⟨i, hi, rfl⟩
          by_cases h0 : i < d₀
          · exact Or.inl ⟨i, h0, by simp [h0]⟩
          · have h1 : i - d₀ < d₁ - d₀ := by rw [Set.mem_Iio] at hi; omega
            exact Or.inr ⟨⟨i - d₀, h1⟩, by simp [h0, h1]⟩
        · rintro (⟨i, hi, rfl⟩ | ⟨i, rfl⟩)
          · exact ⟨i, lt_of_lt_of_le hi hd, by simp [Set.mem_Iio.mp hi]⟩
          · have h0 : ¬ (i + d₀ : ℕ) < d₀ := by omega
            have h1 : (i + d₀ : ℕ) - d₀ < d₁ - d₀ := by have := i.2; omega
            refine ⟨i + d₀, by have := i.2; rw [Set.mem_Iio]; omega, ?_⟩
            simp only [h0, h1, ite_false, dite_true]
            congr 2
            ext
            simp
      rw [himg, Submodule.span_union, hw n le_rfl,
        show (fun i => (c i : V)) = C.subtype ∘ c from rfl, Set.range_comp,
        Submodule.span_image, c.span_eq, Submodule.map_top, Submodule.range_subtype, hsup]

end Lemma16Aux

section Lemma16Gen

/-- **Claims (1) and (2) of p. 233** (generic form): if `ψ_j = ψ_j' + Σ_{d : ν_d < ν_j} δ̄_{jd} ψ_d`
for every `j` (the decomposition "`ψ_j = ψ_j' + Σ_{d=1}^{j(b-1)} δ̄_{jd} ψ_d` for `j(b-1) < j ≤ j(b)`",
where `d ≤ j(b-1)` means `ν_d < ν_j = μ_b`), then the ideals generated by the `ψ_j` and by the `ψ_j'` are
equal ("`Ĩ = (ψ_1', …, ψ_i')`"; the same lemma gives `I = (φ_1', …, φ_i')`).  Proof by induction on `ν_j`. -/
theorem span_range_eq_of_decomp {A : Type*} [CommRing A] {ι : Type*} [Fintype ι] (ν : ι → ℕ)
    (ψ ψ' : ι → A) (δ : ι → ι → A)
    (h : ∀ s, ψ s = ψ' s + ∑ d ∈ Finset.univ.filter (fun d => ν d < ν s), δ s d * ψ d) :
    Ideal.span (Set.range ψ) = Ideal.span (Set.range ψ') := by
  classical
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨s, rfl⟩
    have key : ∀ n, ∀ s, ν s = n → ψ s ∈ Ideal.span (Set.range ψ') := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro s hs
        rw [h s]
        refine add_mem (Ideal.subset_span ⟨s, rfl⟩) (sum_mem fun d hd => ?_)
        rw [Finset.mem_filter] at hd
        exact Ideal.mul_mem_left _ _ (ih (ν d) (hs ▸ hd.2) d rfl)
    exact key _ s rfl
  · rw [Ideal.span_le]
    rintro _ ⟨s, rfl⟩
    have : ψ' s = ψ s - ∑ d ∈ Finset.univ.filter (fun d => ν d < ν s), δ s d * ψ d := by
      rw [h s]; ring
    rw [SetLike.mem_coe, this]
    exact sub_mem (Ideal.subset_span ⟨s, rfl⟩)
      (sum_mem fun d _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨d, rfl⟩))

/-- An element of the ideal generated by the `ψ_d` with `ν_d < n` is `Σ_{ν_d < n} δ_d ψ_d`. -/
theorem exists_coeffs_of_mem_span_lt {A : Type*} [CommRing A] {ι : Type*} [Fintype ι] (ν : ι → ℕ)
    (ψ : ι → A) (n : ℕ) {x : A}
    (hx : x ∈ Ideal.span {y | ∃ d, ν d < n ∧ y = ψ d}) :
    ∃ δ : ι → A, x = ∑ d ∈ Finset.univ.filter (fun d => ν d < n), δ d * ψ d := by
  classical
  have : Ideal.span {y | ∃ d, ν d < n ∧ y = ψ d} =
      Ideal.span (Set.range fun d => if ν d < n then ψ d else 0) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨d, hd, rfl⟩
      exact Ideal.subset_span ⟨d, by simp [hd]⟩
    · rw [Ideal.span_le]
      rintro _ ⟨d, rfl⟩
      by_cases hd : ν d < n
      · exact Ideal.subset_span ⟨d, hd, by simp [hd]⟩
      · simp [hd]
  rw [this, Ideal.mem_span_range_iff_exists_fun] at hx
  obtain ⟨c, hc⟩ := hx
  refine ⟨c, ?_⟩
  rw [← hc, Finset.sum_filter]
  refine Finset.sum_congr rfl fun d _ => ?_
  split_ifs <;> simp

/-- **"`δ̄_{jd}` is a form of degree `ν_j - ν_d`"** (p. 233): a form `χ` of degree `μ` of the ideal
generated by the forms `ψ_d` of degrees `ν_d < μ` is `Σ_{ν_d < μ} δ̄_d ψ_d` with `δ̄_d` a form of
degree `μ - ν_d` (the homogeneous components of degree `μ - ν_d` of arbitrary coefficients). -/
theorem exists_homogeneous_coeffs_of_mem_span_lt {A : Type*} [CommRing A] (I : Ideal A) {n : ℕ}
    (ν : Fin n → ℕ) (ψ : Fin n → AssocGraded I) (hψ : ∀ d, ψ d ∈ AssocGraded.homogeneous I (ν d))
    {μ : ℕ} {χ : AssocGraded I} (hχ : χ ∈ AssocGraded.homogeneous I μ)
    (hx : χ ∈ Ideal.span {y | ∃ d, ν d < μ ∧ y = ψ d}) :
    ∃ δ : Fin n → AssocGraded I, (∀ d, δ d ∈ AssocGraded.homogeneous I (μ - ν d)) ∧
      χ = ∑ d ∈ Finset.univ.filter (fun d => ν d < μ), δ d * ψ d := by
  classical
  set Φ : Fin n → AssocGraded I := fun d => if ν d < μ then ψ d else 0 with hΦ
  have hspan : Ideal.span {y | ∃ d, ν d < μ ∧ y = ψ d} = Ideal.span (Set.range Φ) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨d, hd, rfl⟩
      exact Ideal.subset_span ⟨d, by simp [hΦ, hd]⟩
    · rw [Ideal.span_le]
      rintro _ ⟨d, rfl⟩
      by_cases hd : ν d < μ
      · exact Ideal.subset_span ⟨d, hd, by simp [hΦ, hd]⟩
      · simp [hΦ, hd]
  obtain ⟨c, hc, -, hsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span I Φ ν
    (fun d => by
      simp only [hΦ]
      split_ifs
      · exact hψ d
      · exact zero_mem _) hχ (hspan ▸ hx)
  refine ⟨c, hc, ?_⟩
  rw [hsum, Finset.sum_filter]
  refine Finset.sum_congr rfl fun d _ => ?_
  simp only [hΦ]
  split_ifs <;> simp

end Lemma16Gen

/-! ### Lemma 16 (pp. 231–233) -/

section Lemma16

/-- Lemma 16, pp. 231–232: "Let `R`, `J`, `P`, `R₁`, `J₁` be the same as in Lemma 15. Let
`k = R/M = R₁/M₁`, where `M` (resp. `M₁`) denotes the maximal ideal of `R` (resp. `R₁`). Suppose
we have a system of elements `(f₁, …, f_m)` of `J` and a positive integer `a ≤ t(J)` such that
(i) `(f₁, …, f_m)` is a standard base of `J`, (ii) if `i` is the largest integer such that
`ν^{(i)}(J) = μ^{(a)}(J)`, then `ν_P(f_j) = ν^{(j)}(J)` for all `j ≤ i`. Suppose furthermore
`(ν^{(1)}(J), …, ν^{(i)}(J)) = (ν^{(1)}(J₁), …, ν^{(i)}(J₁))`, `μ^{(a)}(J) < ν^{(i+1)}(J₁)`, and
`τ^{(b)}(J₁) = τ^{(b)}(J)` for `1 ≤ b ≤ a`. Then there exists an isomorphism `σ` of graded
`k`-algebras `gr_M(R) → gr_{M₁}(R₁)` such that `σ(gr^μ_M(J, R)) = gr^μ_{M₁}(J₁, R₁)` for all
`μ ≤ μ^{(a)}(J)`."

Formalization note (encoding of "isomorphism of graded `k`-algebras"): `σ` is a ring
isomorphism `AssocGraded (maximalIdeal R) ≃+* AssocGraded (maximalIdeal R₁)` which
(a) carries `gr^μ_M(R)` into `gr^μ_{M₁}(R₁)` and back, for every `μ` (gradedness), and
(b) satisfies `σ (algebraMap R _ c) = algebraMap R₁ _ (T.toRing c)` for all `c ∈ R`
(`k`-linearity: `algebraMap R (gr_M(R)) c` is the class of `c` in degree `0`, i.e. the image of
`c̄ ∈ k`, and `k = R/M = R₁/M₁` through `T.toRing`, which is residually rational).  The
conclusion `σ(gr^μ_M(J, R)) = gr^μ_{M₁}(J₁, R₁)` is stated elementwise on `gr^μ_M(R)`.  This
is an encoding of, not a strengthening of, the paper's statement; no graded-algebra structure
is carried by `AssocGraded` in this development, so the grading is expressed through the
submodules `AssocGraded.homogeneous`.

The printed condition is `1 ≦ b ≦ a` (p. 232); with `1 ≤ b < a` the statement is false: for `a = 1`,
`J = (x₁² + x²y²)`, `P = (x, x₁)` in `ℚ[x, x₁, y]_{(x, x₁, y)}` and `R₁` the chart of `x₁/x`,
no graded isomorphism maps `gr²(J) = k·X₁²` onto `gr²(J₁) = k·(X̄₁² + Ȳ²)`.

Route of the proof (as printed, pp. 232–233; each printed step is a `have` of the proof).  The data of
Lemma 14 (`g_j = x^{-ν_j} f_j`, `h_j`, (iii), (iv)) give `ψ_j = φ_j(X̄) + λ_j`, `gr^μ(J₁) = Ĩ_μ` and
`gr^μ(J) = I_μ` for `μ ≤ μ̄` (`Itl = Ĩ`, `Iid = I`).  For every `1 ≤ b ≤ a`: `T_b ⊆ ρ(T̃_b)`
(`TransformCoord.tauSubmodule_le_span_ρ_of_isGreatest` at `b`, "as was seen near the end of the proof of
Lemma 15"), `τ_b = rank T_b ≤ rank ρ(T̃_b) ≤ rank T̃_b = τ_b` by `τ^{(b)}(J₁) = τ^{(b)}(J)`, hence
`T_b = ρ(T̃_b)` and `rank T̃_b = rank ρ(T̃_b)` (`hb_eq`).  The flag `T̃_1 ⊆ … ⊆ T̃_a`
(`tauSubmodule_mono_of_le`) has an adapted family `Z̄_1, Z̄_2, …` with `T̃_b` generated by
`Z̄_1, …, Z̄_{τ_b}` (`exists_flag_family_of_monotone`).  The injectivity of `ρ` on `T̃_a` is the linear
independence of `ρ(Z̄_1), …, ρ(Z̄_{τ_a})` (`hli`); this is the printed "`X, Y_1, …, Y_s` are linearly
independent modulo `T̃_a`" (`ρ` kills `X` and the `Y_j` and is injective on the span of the `X̄_j`;
`TransformCoord.linearIndependent_sum_of_linearIndependent_ρ`), and it lets the base `(Z̄_1, …, Z̄_{τ_a})` of
`T̃_a` be extended to the printed linearly independent base `(Z̄_1, …, Z̄_r, X, Y_1, …, Y_s)` of the `k`-module
`gr¹_{M₁}(R₁)` (`TransformCoord.exists_base_extending`; the family `Zb` is indexed by `Fin τ_a ⊕ E` with
`τ_a + |E| = r`).  The isomorphism `σ₀` is defined as printed on this base: `σ₀(Z̄_j) = ρ(Z̄_j)` for all `j ≤ r`,
`σ₀(X) = X`, `σ₀(Y_j) = Y_j` (`TransformCoord.exists_ringEquiv_eq_ρ_of_base`; the images `ρ(Z̄_j)` of the whole
base are linearly independent, so that the printed definition gives an isomorphism,
`TransformCoord.linearIndependent_ρ_of_linearIndependent_sum`).
Each `ψ_j` is written `ψ_j = ψ_j' + Σ_{ν_d < ν_j} δ̄_{jd} ψ_d` with `ψ_j' ∈ Ĩ ∩ k[T̃_b]` homogeneous of
degree `ν_j = μ_b` (`IsTauSubmoduleOfIdeal.exists_sub_mem_of_lt`; "`j(b-1) < j ≤ j(b)`" is `ν_j = μ_b`,
and "`d ≤ j(b-1)`" is `ν_d < ν_j`) and `δ̄_{jd}` a form of degree `ν_j - ν_d`
(`exists_homogeneous_coeffs_of_mem_span_lt`); `φ_j' := φ_j - Σ δ_{jd} φ_d` with `δ_{jd} = ρ(δ̄_{jd})`, which is a
form only in `X_1, …, X_r` (`TransformCoord.exists_ρ_eq_e_rename`); (1) and (2) are
`span_range_eq_of_decomp`; (3) `ρ(ψ_j') = φ_j'` holds as `ρ` is a ring homomorphism; then
`σ₀(ψ_j') = ρ(ψ_j') = φ_j'` (`ψ_j' ∈ k[T̃_b] ⊆ k[T̃_a]`), hence `σ₀(Ĩ) = I`, and `σ = σ₀⁻¹`.

Gaps of the paper that are filled: "by the definition of `T̃_b` we can write each `ψ_j` in the following
form" (`IsTauSubmoduleOfIdeal.exists_sub_mem_of_lt` with
`mem_span_initialForm_of_extendsToStandardBase_of_le`: every form of `gr(J₁)` of degree `< μ_b` lies in
`(ψ_d : ν_d < μ_b)`); "Then we see that (1), (2), (3)"; the equalities `μ^{(b)}(J₁) = μ^{(b)}(J)` for
`b ≤ a` (`mu_eq_of_nuI_eq`, as in Lemma 15); that the images `ρ(Z̄_j)` of the whole base (not only of
`Z̄_1, …, Z̄_{τ_a}`) are linearly independent, which the printed definition of `σ₀` presupposes.  Everything printed in the proof is reproduced, including the extension to a base of `gr¹`,
`σ₀(X) = X`, `σ₀(Y_j) = Y_j`, the homogeneity of the `δ̄_{jd}` and the purity of the `δ_{jd}` (the last two are
asserted by the paper and not used afterwards). -/
@[blueprint "lem:III.16"
  (statement := /-- Let $R$, $J$, $P$, $R_1$, $J_1$ be the same as in \cref{lem:III.15}. Let
    $k=R/M=R_1/M_1$, where $M$ (resp.\ $M_1$) denotes the maximal ideal of $R$ (resp.\ $R_1$).
    Suppose we have a system of elements $(f_1,\dots,f_m)$ of $J$ and a positive integer
    $a\le t(J)$ such that (i) $(f_1,\dots,f_m)$ is a standard base of $J$, (ii) if $i$ is the
    largest integer such that $\nu^{(i)}(J)=\mu^{(a)}(J)$, then $\nu_P(f_j)=\nu^{(j)}(J)$ for
    all $j\le i$. Suppose furthermore that
    $(\nu^{(1)}(J),\dots,\nu^{(i)}(J))=(\nu^{(1)}(J_1),\dots,\nu^{(i)}(J_1))$,
    $\mu^{(a)}(J)<\nu^{(i+1)}(J_1)$, and $\tau^{(b)}(J_1)=\tau^{(b)}(J)$ for $1\le b\le a$. Then
    there exists an isomorphism $\sigma$ of graded $k$-algebras
    $\operatorname{gr}_M(R)\to\operatorname{gr}_{M_1}(R_1)$ such that
    $\sigma(\operatorname{gr}^\mu_M(J,R))=\operatorname{gr}^\mu_{M_1}(J_1,R_1)$ for all
    $\mu\le\mu^{(a)}(J)$. (Lemma 16, pp.~231--232.)

    (Formalization note (encoding): ``isomorphism of graded $k$-algebras'' is encoded as a ring
    isomorphism $\operatorname{gr}_M(R)\to\operatorname{gr}_{M_1}(R_1)$ carrying
    $\operatorname{gr}^\mu_M(R)$ onto $\operatorname{gr}^\mu_{M_1}(R_1)$ for every $\mu$ and
    commuting with the structural maps of $R$ and $R_1$, the identification $k=R/M=R_1/M_1$
    being the one induced by $R\to R_1$. Note: the printed condition on p.~232 is
    $1\le b\le a$; with $b<a$ the statement would be false.) -/)
  (proof := /-- Let $(x,x_1,\dots,x_r,y_1,\dots,y_s)$ be a regular system of parameters of $R$
    such that $(x,x_1/x,\dots,x_r/x,y_1,\dots,y_s)$ is a regular system of parameters of
    $R_1$, and make the identifications $\operatorname{gr}_M(R)=k[X,X_1,\dots,X_r,Y_1,\dots,
    Y_s]$ and $\operatorname{gr}_{M_1}(R_1)=k[X,\bar X_1,\dots,\bar X_r,Y_1,\dots,Y_s]$ of the proof of
    \cref{lem:III.14}. Let $g_j=x^{-\nu_j}f_j$ with $\nu_j=\nu^{(j)}(J)$ and assume (iii)
    $\nu_{M_1}(g_j)=\nu_j$ for $j\le i$ and (iv) $(g_1,\dots,g_i)$ can be extended to a
    standard base of $J_1$. Let $\varphi_j$ be the initial form of $f_j$ in
    $\operatorname{gr}_M(R)$ and $\psi_j$ that of $g_j$ in $\operatorname{gr}_{M_1}(R_1)$; let
    $\bar\mu=\mu^{(a)}(J)=\mu^{(a)}(J_1)$. Then $\psi_j=\varphi_j(\bar X_1,\dots,\bar X_r)+\lambda_j$ for
    $j\le i$, where $\lambda_j$ is a form of degree $\nu_j$ contained in
    $(X,Y_1,\dots,Y_s)\operatorname{gr}_{M_1}(R_1)$. In view of the assumption
    $\nu^{(i+1)}(J_1)>\bar\mu$ we have $\operatorname{gr}^\mu_{M_1}(J_1,R_1)=\tilde I_\mu$ for
    all $\mu\le\bar\mu$, where $\tilde I=(\psi_1,\dots,\psi_i)\operatorname{gr}_{M_1}(R_1)$,
    while $\operatorname{gr}^\mu_M(J,R)=I_\mu$ for all $\mu\le\bar\mu$, where
    $I=(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$. Therefore it suffices to produce an
    isomorphism $\sigma$ of graded $k$-algebras
    $\operatorname{gr}_M(R)\to\operatorname{gr}_{M_1}(R_1)$ with $\sigma(I)=\tilde I$.

    Let $\bar\mu_b=\mu^{(b)}(J)=\mu^{(b)}(J_1)$ for $1\le b\le a$, let $j(b)$ be the largest
    integer with $\nu_{j(b)}=\bar\mu_b$, and let $\tau_b=\tau^{(b)}(J)=\tau^{(b)}(J_1)$ for
    $1\le b\le a$. Let $\rho$ be the homomorphism of graded $k$-algebras
    $\operatorname{gr}_{M_1}(R_1)\to\operatorname{gr}_M(R)$ with
    $\rho(X)=\rho(Y_1)=\dots=\rho(Y_s)=0$ and $\rho(\bar X_j)=X_j$. Let $\tilde T_b$ be the
    smallest $k$-submodule of $\operatorname{gr}^1_{M_1}(R_1)$ with
    $\tilde I_\mu=\operatorname{gr}^\mu_{M_1}(R_1)\cap(\tilde I\cap k[\tilde T_b])
    \operatorname{gr}_{M_1}(R_1)$ for all $\mu\le\bar\mu_b$, and $T_b$ the smallest
    $k$-submodule of $\operatorname{gr}^1_M(R)$ with
    $I_\mu=\operatorname{gr}^\mu_M(R)\cap(I\cap k[T_b])\operatorname{gr}_M(R)$ for all
    $\mu\le\bar\mu_b$. As near the end of the proof of \cref{lem:III.15}, $T_b\subseteq
    \rho(\tilde T_b)$ and $\tau_b=\operatorname{rank}T_b\le\operatorname{rank}\rho(\tilde T_b)
    \le\operatorname{rank}\tilde T_b=\tau_b$; hence $T_b=\rho(\tilde T_b)$ and
    $\operatorname{rank}\tilde T_b=\operatorname{rank}\rho(\tilde T_b)$ for $1\le b\le a$.
    First of all, it follows that $X,Y_1,\dots,Y_s$ are linearly independent modulo
    $\tilde T_a$, so we can choose a linearly independent base
    $(\bar Z_1,\dots,\bar Z_r,X,Y_1,\dots,Y_s)$ of the $k$-module
    $\operatorname{gr}^1_{M_1}(R_1)$ such that $\tilde T_b$ is generated by
    $\bar Z_1,\dots,\bar Z_{\tau_b}$ for $1\le b\le a$.

    By the definition of $\tilde T_b$ we can write each $\psi_j$ in the form
    $\psi_j=\psi_j'+\sum_{d=1}^{j(b-1)}\bar\delta_{jd}\psi_d$ for $j(b-1)<j\le j(b)$ and
    $1\le b\le a$, where $\psi_j'$ is a form only in $\bar Z_1,\dots,\bar Z_{\tau_b}$ and
    $\bar\delta_{jd}$ is a form of degree $\nu_j-\nu_d$. Let $\delta_{jd}=\rho(\bar\delta_{jd})$,
    which is a form only in $X_1,\dots,X_r$, and let $\varphi_j'$ be defined by
    $\varphi_j=\varphi_j'+\sum_{d=1}^{j(b-1)}\delta_{jd}\varphi_d$ for $j(b-1)<j\le j(b)$ and
    $1\le b\le a$. Then (1) $\tilde I=(\psi_1',\dots,\psi_i')k[\bar Z_1,\dots,\bar Z_r,X,
    Y_1,\dots,Y_s]$, (2) $I=(\varphi_1',\dots,\varphi_i')k[X_1,\dots,X_r,X,Y_1,\dots,Y_s]$, and
    (3) $\rho(\psi_j')=\varphi_j'$ for all $j\le i$. Define an isomorphism $\sigma_0$ of graded
    $k$-algebras $\operatorname{gr}_{M_1}(R_1)\to\operatorname{gr}_M(R)$ by
    $\sigma_0(\bar Z_j)=\rho(\bar Z_j)$ for $1\le j\le r$, $\sigma_0(X)=X$ and
    $\sigma_0(Y_j)=Y_j$ for $1\le j\le s$. Then $\sigma_0(\psi_j')=\rho(\psi_j')=\varphi_j'$
    for all $j\le i$, hence $\sigma_0(\tilde I)=I$. The inverse $\sigma$ of $\sigma_0$ has the
    property stated in the lemma.

    \textbf{Formalization (the route of the proof as printed).} Every printed step is a step of
    the Lean proof. For $1\le b\le a$, $T_b\subseteq\rho(\tilde T_b)$ is the core of the proof of
    \cref{lem:III.15} applied at $b$, and the ranks are compared as printed with the hypothesis
    $\tau^{(b)}(J_1)=\tau^{(b)}(J)$; the flag $\tilde T_1\subseteq\dots\subseteq\tilde T_a$ has an
    adapted family $\bar Z_1,\bar Z_2,\dots$ and the injectivity of $\rho$ on $\tilde T_a$ (``$X,Y_1,\dots,
    Y_s$ are linearly independent modulo $\tilde T_a$'') is the linear independence of
    $\rho(\bar Z_1),\dots,\rho(\bar Z_{\tau_a})$ (and of the family
    $\bar Z_1,\dots,\bar Z_{\tau_a},X,Y_1,\dots,Y_s$). This family is extended to a linearly independent base
    $(\bar Z_1,\dots,\bar Z_r,X,Y_1,\dots,Y_s)$ of $\operatorname{gr}^1_{M_1}(R_1)$, and $\sigma_0$ is the
    isomorphism with $\sigma_0(\bar Z_j)=\rho(\bar Z_j)$ for $1\le j\le r$, $\sigma_0(X)=X$, $\sigma_0(Y_j)=Y_j$
    (that the $\rho(\bar Z_j)$, $j\le r$, are linearly independent, so that this defines an isomorphism, is
    presupposed by the paper). The decomposition of $\psi_j$ (with $\bar\delta_{jd}$ a form of degree $\nu_j-\nu_d$
    and $\delta_{jd}=\rho(\bar\delta_{jd})$ a form only in $X_1,\dots,X_r$), the claims (1), (2), (3) and the
    equation $\sigma_0(\tilde I)=I$ are proved as printed; the printed text asserts the decomposition
    (``by the definition of $\tilde T_b$'') and the claims (``Then we see that'') without proof, and these
    are the gaps filled. -/)
  (latexEnv := "lemma")]
theorem exists_gradedRingEquiv_strictTransform (R : Type u) [CommRing R] [IsRegularLocalRing R]
    [IsDomain R] (P : Ideal R) [P.IsPrime] [IsRegularLocalRing (R ⧸ P)] (J : Ideal R)
    (hJP : J ≤ P) (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {m : ℕ} (f : Fin m → R) (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t R J)
    (h₁ : IsStandardBase R J f)
    (i : ℕ+) (hi : IsGreatest {k : ℕ+ | nuI R J k = (mu R J a : ℕ∞)} i)
    (h₂ : ∀ j : Fin m, (j : ℕ) < (i : ℕ) →
      Ideal.ordElem P (f j) = nuI R J ((j : ℕ).succPNat))
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) →
      nuI R J j = nuI T.ring (strictTransformIdeal T J) j)
    (hgap : (mu R J a : ℕ∞) < nuI T.ring (strictTransformIdeal T J) (i + 1))
    (htau : ∀ b, 1 ≤ b → b ≤ a → tau T.ring (strictTransformIdeal T J) b = tau R J b) :
    ∃ σ : AssocGraded (maximalIdeal R) ≃+* AssocGraded (A := T.ring) (maximalIdeal T.ring),
      (∀ c : R, σ (algebraMap R (AssocGraded (maximalIdeal R)) c) =
        algebraMap T.ring (AssocGraded (A := T.ring) (maximalIdeal T.ring)) (T.toRing c)) ∧
      (∀ μ : ℕ, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        σ φ ∈ AssocGraded.homogeneous (A := T.ring) (maximalIdeal T.ring) μ) ∧
      (∀ μ : ℕ, ∀ ψ ∈ AssocGraded.homogeneous (A := T.ring) (maximalIdeal T.ring) μ,
        σ.symm ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ) ∧
      ∀ μ ≤ mu R J a, ∀ φ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        (φ ∈ grIdeal (maximalIdeal R) J ↔
          σ φ ∈ grIdeal (A := T.ring) (maximalIdeal T.ring) (strictTransformIdeal T J)) := by
  classical
  obtain ⟨C⟩ := TransformCoord.nonempty T hrat
  set J₁ := strictTransformIdeal T J with hJ₁
  set μb := mu R J a with hμb
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  -- the characters `ν_j = ν^{(j)}(J)` and Lemma 14
  have hftop : ∀ j : Fin m, Ideal.ordElem (maximalIdeal R) (f j) ≠ ⊤ := by
    intro j htop
    apply h₁.2.2.2.2 j
    dsimp only
    rw [show initialForm (maximalIdeal R) (f j) = 0 by rw [initialForm, dite_eq_left htop]]
    exact zero_mem _
  let ν : Fin m → ℕ := fun j => (Ideal.ordElem (maximalIdeal R) (f j)).toNat
  have hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat) := fun j =>
    (ENat.natCast_toNat (hftop j)).trans (ordElem_eq_nuI_of_isStandardBase J f h₁ j)
  have him : (i : ℕ) ≤ m := by
    by_contra hlt
    have := (nuI_eq_of_hasLemma1Properties R J _ h₁.2).2 i (by omega)
    have h1 := hi.1
    simp only [Set.mem_ofPred_eq] at h1
    rw [this] at h1
    exact ENat.top_ne_natCast _ h1
  have hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
      toLex fun j : Fin (i : ℕ) => nuI T.ring J₁ ((j : ℕ).succPNat) :=
    le_of_eq (congrArg toLex (funext fun j => heq _ (by simp only [Nat.succPNat_coe]; omega)))
  obtain ⟨⟨g, hg, -, hx⟩, -⟩ := exists_standardBase_extendsToStandardBase R P J hJP T hrat f i him ν hν h₁
    (fun j hj => (h₂ j hj).trans (hν j).symm) hlex
  obtain ⟨h, hgh, hhν, hext⟩ := hx C.x₁ C.span_x₁
  have hgM : ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j := fun j =>
    (ordElem_eq_nuI_of_isStandardBase J g hg j).trans (hν j).symm
  obtain ⟨dg, hdg, hmonog⟩ := hg.2.2.1
  have hdgν : ∀ j, dg j = ν j := fun j => by
    have := (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J g hg dg hdg j).symm.trans (hgM j)
    exact_mod_cast this
  have hi1 : (i : ℕ) - 1 < (i : ℕ) := by have := i.pos; omega
  have hνi : ν (Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩) = μb := by
    have h1 := hν (Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩)
    have h2 : ((Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩ : Fin m) : ℕ).succPNat = i := by
      apply PNat.eq; simp; have := i.pos; omega
    rw [h2, hi.1] at h1
    exact_mod_cast h1
  have hνle : ∀ s : Fin (i : ℕ), ν (Fin.castLE him s) ≤ μb := fun s => by
    rw [← hνi, ← hdgν, ← hdgν]
    exact hmonog (Fin.le_def.mpr (by simp; omega))
  have hat₁ : a ≤ t T.ring J₁ := le_t_of_nuI_eq J J₁ a ha hat i hi heq
  have hgap' : (μb : ℕ∞) < nuI T.ring J₁ (i : ℕ).succPNat := by
    rw [PNat.succPNat_coe_eq_add_one]; exact hgap
  -- ## "`T_b = ρ(T̃_b)`" for `1 ≤ b ≤ a` (p. 232: "as was seen near the end of the proof of Lemma 15")
  have hb_data : ∀ b, 1 ≤ b → b ≤ a → mu T.ring J₁ b = mu R J b ∧
      tauSubmodule R J b ≤ Submodule.span (R ⧸ maximalIdeal R)
        (C.ρ hrat '' (tauSubmodule T.ring J₁ b : Set (AssocGraded (maximalIdeal T.ring)))) := by
    intro b hb hba
    obtain ⟨ib, hib⟩ := exists_isGreatest_nuI_eq_mu J b hb (hba.trans hat)
    have hle : ib ≤ i := le_of_isGreatest_nuI_eq_mu_of_le J hb hba hat hi hib
    have hle' : (ib : ℕ) ≤ (i : ℕ) := PNat.coe_le_coe _ _ |>.mpr hle
    have heq_b : ∀ j : ℕ+, (j : ℕ) ≤ (ib : ℕ) → nuI R J j = nuI T.ring J₁ j :=
      fun j hj => heq j (hj.trans hle')
    refine ⟨mu_eq_of_nuI_eq J J₁ b hb (hba.trans hat) ib hib heq_b, ?_⟩
    refine (TransformCoord.tauSubmodule_le_span_ρ_of_isGreatest R P J T hrat C g hg ν hν b hb
      (hba.trans hat) ib hib (hle'.trans him) heq_b (fun s => h (Fin.castLE hle' s)) ?_ ?_ ?_).2
    · intro j
      simpa using hgh (Fin.castLE hle' j)
    · intro j
      simpa using hhν (Fin.castLE hle' j)
    · obtain ⟨m', G, him', hG, hGh⟩ := hext
      exact ⟨m', G, hle'.trans him', hG, fun s => by simpa using hGh (Fin.castLE hle' s)⟩
  have hb_eq : ∀ b, 1 ≤ b → b ≤ a →
      Submodule.span (R ⧸ maximalIdeal R)
        (C.ρ hrat '' (tauSubmodule T.ring J₁ b : Set (AssocGraded (maximalIdeal T.ring)))) =
        tauSubmodule R J b ∧
      Module.finrank (R ⧸ maximalIdeal R) (Submodule.span (R ⧸ maximalIdeal R)
        (C.ρ hrat '' (tauSubmodule T.ring J₁ b : Set (AssocGraded (maximalIdeal T.ring))))) =
        tau T.ring J₁ b := by
    intro b hb hba
    have hbt₁ : b ≤ t T.ring J₁ := hba.trans hat₁
    have hbt : b ≤ t R J := hba.trans hat
    have := finiteDimensional_tauSubmodule J₁ b
    obtain ⟨hfinρ, hρle⟩ := C.finrank_span_ρ_le hrat (tauSubmodule T.ring J₁ b)
    obtain ⟨-, hrankJ, -⟩ := tauSubmodule_spec R J b hb hbt
    obtain ⟨-, hrankJ₁, -⟩ := tauSubmodule_spec T.ring J₁ b hb hbt₁
    have hle := (hb_data b hb hba).2
    have hrk : Module.finrank (R ⧸ maximalIdeal R) (Submodule.span (R ⧸ maximalIdeal R)
        (C.ρ hrat '' (tauSubmodule T.ring J₁ b : Set (AssocGraded (maximalIdeal T.ring))))) =
        tau T.ring J₁ b := by
      refine le_antisymm (hrankJ₁ ▸ hρle) ?_
      rw [htau b hb hba, ← hrankJ]
      exact Submodule.finrank_mono hle
    refine ⟨(Submodule.eq_of_le_of_finrank_le hle (by rw [hrk, htau b hb hba, hrankJ])).symm, hrk⟩
  -- ## the flag `T̃_1 ⊆ … ⊆ T̃_a` and a family adapted to it
  have hflag_mono : Monotone fun b : ℕ => tauSubmodule T.ring J₁ (min (b + 1) a) := fun b b' hbb' =>
    tauSubmodule_mono_of_le J₁ (by omega) (by omega) (le_trans (min_le_right _ _) hat₁)
  obtain ⟨Z, hZ⟩ := exists_flag_family_of_monotone (K := T.ring ⧸ maximalIdeal T.ring)
    (fun b : ℕ => tauSubmodule T.ring J₁ (min (b + 1) a)) hflag_mono
    (fun b => finiteDimensional_tauSubmodule J₁ _) (a - 1)
  have hZb : ∀ b, 1 ≤ b → b ≤ a → Submodule.span (T.ring ⧸ maximalIdeal T.ring)
      (Z '' Set.Iio (tau T.ring J₁ b)) = tauSubmodule T.ring J₁ b := by
    intro b hb hba
    have h := hZ (b - 1) (by omega)
    rw [show min (b - 1 + 1) a = b by omega,
      (tauSubmodule_spec T.ring J₁ b hb (hba.trans hat₁)).2.1] at h
    exact h
  -- the base `Z̄_1, …, Z̄_{τ_a}` of `T̃_a`
  let W : Fin (tau T.ring J₁ a) → AssocGraded (maximalIdeal T.ring) := fun l => Z l
  have hWspan : Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) =
      tauSubmodule T.ring J₁ a := by
    rw [← hZb a ha le_rfl]
    congr 1
    ext x
    constructor
    · rintro ⟨l, rfl⟩
      exact ⟨l, l.2, rfl⟩
    · rintro ⟨l, hl, rfl⟩
      exact ⟨⟨l, hl⟩, rfl⟩
  have hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := fun l =>
    (tauSubmodule_spec T.ring J₁ a ha hat₁).1.1 (hWspan ▸ Submodule.subset_span ⟨l, rfl⟩)
  -- "`ρ` is injective on `T̃_a`": the images `ρ(Z̄_l)` are linearly independent
  have hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (W l) := by
    rw [linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin, Set.finrank,
      ← C.span_ρ_image_span hrat W, hWspan, (hb_eq a ha le_rfl).1,
      (tauSubmodule_spec R J a ha hat).2.1, htau a ha le_rfl]
  -- "Hence we can choose a linearly independent base `(Z̄_1, …, Z̄_r, X, Y_1, …, Y_s)` of the `k`-module
  -- `gr¹_{M₁}(R₁)` such that `T̃_b` is generated by `Z̄_1, …, Z̄_{τ_b}`": `X, Y_1, …, Y_s` are linearly
  -- independent modulo `T̃_a` (`ρ` is injective on `T̃_a`, `hli`), so the base `W = (Z̄_1, …, Z̄_{τ_a})` of
  -- `T̃_a` extends to a base `Zb` of `gr¹`
  obtain ⟨E, hE, Zb, hZbW, hZb1, hZbasis, -⟩ := C.exists_base_extending hrat W hW1 hli
  -- "Let us define an isomorphism `σ₀` of graded `k`-algebras `gr_{M₁}(R₁) → gr_M(R)` in such a way that
  -- `σ₀(Z̄_j) = ρ(Z̄_j)`, `σ₀(X) = X`, `σ₀(Y_j) = Y_j`"

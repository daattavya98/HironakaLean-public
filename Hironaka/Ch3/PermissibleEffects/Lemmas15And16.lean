/-! ## Graded decompositions, `ρ` and the proof of Lemma 15

Homogeneous components in `gr` (`AssocGraded.proj_mul`, `AssocGraded.exists_proj_eq_add_of_mem_span`), properties of the
homogeneous `ρ : gr_{M₁}(R₁) → gr_M(R)` (degree-preserving, `k`-semilinear, mapping `k₁[T̃]` into
`k[ρ(T̃)]`), the comparison `μ^{(a)}(J₁) = μ^{(a)}(J)` (`mu_eq_of_nuI_eq`), and the proof of Lemma 15
(`tau_le_tau_strictTransform`). -/

section PE5Machinery2

open MvPolynomial

section GradedHelpers2

variable {A : Type u} [CommRing A] (I : Ideal A)

theorem AssocGraded.proj_smul (e : ℕ) (c : A ⧸ I) (x : AssocGraded I) :
    AssocGraded.proj I e (c • x) = c • AssocGraded.proj I e x := by
  simp only [AssocGraded.proj, LinearMap.toAddMonoidHom_coe, LinearMap.coe_comp, Function.comp_apply,
    map_smul]

/-- The degree-`e` part of a product. -/
theorem AssocGraded.proj_mul (c x : AssocGraded I) (e : ℕ) :
    AssocGraded.proj I e (c * x) = ∑ d ∈ Finset.range (e + 1), AssocGraded.proj I (e - d) c * AssocGraded.proj I d x := by
  classical
  obtain ⟨N, hN⟩ := AssocGraded.exists_eq_sum_proj I x
  have hx := hN (max N (e + 1)) (le_max_left _ _)
  conv_lhs => rw [hx]
  rw [Finset.mul_sum, map_sum]
  rw [← Finset.sum_subset (Finset.range_subset_range.mpr (le_max_right N (e + 1)))]
  · refine Finset.sum_congr rfl fun d hd => ?_
    rw [Finset.mem_range] at hd
    rw [AssocGraded.proj_mul_of_mem_homogeneous I _ _ (AssocGraded.proj_mem_homogeneous I d x), if_pos (by omega)]
  · intro d _ hd
    rw [Finset.mem_range] at hd
    rw [AssocGraded.proj_mul_of_mem_homogeneous I _ _ (AssocGraded.proj_mem_homogeneous I d x), if_neg (by omega)]

theorem AssocGraded.proj_proj (d e : ℕ) (x : AssocGraded I) :
    AssocGraded.proj I e (AssocGraded.proj I d x) = if d = e then AssocGraded.proj I d x else 0 := by
  split_ifs with h
  · subst h; exact AssocGraded.proj_of_mem_homogeneous I (AssocGraded.proj_mem_homogeneous I d x)
  · exact AssocGraded.proj_of_mem_homogeneous_of_ne I (AssocGraded.proj_mem_homogeneous I d x) h

/-- The graded ideal `gr_I(J, A)` is homogeneous. -/
theorem AssocGraded.proj_mem_grIdeal (J : Ideal A) {x : AssocGraded I} (hx : x ∈ grIdeal I J) (e : ℕ) :
    AssocGraded.proj I e x ∈ grIdeal I J := by
  induction hx using Submodule.span_induction generalizing e with
  | mem y hy =>
    obtain ⟨f, hf, rfl⟩ := hy
    by_cases htop : Ideal.ordElem I f = ⊤
    · rw [initialForm, dite_eq_left htop, map_zero]; exact zero_mem _
    · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
      have hmem : initialForm I f ∈ AssocGraded.homogeneous I n := by
        rw [initialForm_eq_mk I hn.symm]; exact AssocGraded.mk_mem_homogeneous _ _
      by_cases hne : n = e
      · rw [← hne, AssocGraded.proj_of_mem_homogeneous I hmem]; exact Ideal.subset_span ⟨f, hf, rfl⟩
      · rw [AssocGraded.proj_of_mem_homogeneous_of_ne I hmem hne]; exact zero_mem _
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem (hx e) (hy e)
  | smul c x _ hx =>
    rw [smul_eq_mul, AssocGraded.proj_mul]
    exact sum_mem fun d _ => Ideal.mul_mem_left _ _ (hx d)

/-- The `A/I`-subalgebra generated by elements of degree `1` is homogeneous. -/
theorem AssocGraded.proj_mem_adjoin {S : Set (AssocGraded I)}
    (hS : ∀ s ∈ S, s ∈ AssocGraded.homogeneous I 1) {x : AssocGraded I}
    (hx : x ∈ Algebra.adjoin (A ⧸ I) S) (e : ℕ) :
    AssocGraded.proj I e x ∈ Algebra.adjoin (A ⧸ I) S := by
  have hcl : ∀ y ∈ Submonoid.closure S, ∃ n, y ∈ AssocGraded.homogeneous I n := by
    intro y hy
    induction hy using Submonoid.closure_induction with
    | mem y hy => exact ⟨1, hS y hy⟩
    | one =>
      refine ⟨0, ?_⟩
      rw [show (1 : AssocGraded I) = AssocGraded.mk I 0 1 (by simp) by
        rw [AssocGraded.mk_zero_eq_algebraMap, map_one, map_one]]
      exact AssocGraded.mk_mem_homogeneous _ _
    | mul y z _ _ hy hz =>
      obtain ⟨n, hn⟩ := hy
      obtain ⟨k, hk⟩ := hz
      exact ⟨n + k, AssocGraded.mul_mem_homogeneous I hn hk⟩
  have hx' : x ∈ Subalgebra.toSubmodule (Algebra.adjoin (A ⧸ I) S) := hx
  rw [Algebra.adjoin_eq_span] at hx'
  clear hx
  have : AssocGraded.proj I e x ∈ Submodule.span (A ⧸ I) (Submonoid.closure S : Set (AssocGraded I)) := by
    induction hx' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨n, hn⟩ := hcl y hy
      by_cases hne : n = e
      · rw [← hne, AssocGraded.proj_of_mem_homogeneous I hn]; exact Submodule.subset_span hy
      · rw [AssocGraded.proj_of_mem_homogeneous_of_ne I hn hne]; exact zero_mem _
    | zero => rw [map_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul c y _ hy => rw [AssocGraded.proj_smul]; exact Submodule.smul_mem _ _ hy
  rw [← Algebra.adjoin_eq_span] at this
  exact this

/-- Elements of degree `0` are constants. -/
theorem AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero {c : AssocGraded I}
    (hc : c ∈ AssocGraded.homogeneous I 0) : ∃ c₀ : A ⧸ I, c = algebraMap (A ⧸ I) _ c₀ := by
  obtain ⟨w, hw, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous I hc
  exact ⟨_, AssocGraded.mk_zero_eq_algebraMap I w hw⟩

/-- **Decomposition** (proof of Lemma 15, p. 231): if `W` is a set of elements of `gr_I(A)`
closed under taking homogeneous components, sums and multiplication by constants, then the
degree-`e` part of any element of the ideal generated by `W` is `A + w'` with `A` in the ideal
generated by the homogeneous elements of `W` of degree `< e` and `w' ∈ W` homogeneous of degree
`e`. -/
theorem AssocGraded.exists_proj_eq_add_of_mem_span (W : Set (AssocGraded I))
    (hWp : ∀ w ∈ W, ∀ d, AssocGraded.proj I d w ∈ W) (hW0 : (0 : AssocGraded I) ∈ W)
    (hWa : ∀ w ∈ W, ∀ w' ∈ W, w + w' ∈ W)
    (hWs : ∀ c ∈ AssocGraded.homogeneous I 0, ∀ w ∈ W, c * w ∈ W)
    {x : AssocGraded I} (hx : x ∈ Ideal.span W) (e : ℕ) :
    ∃ B w', B ∈ Ideal.span {w | w ∈ W ∧ ∃ d < e, w ∈ AssocGraded.homogeneous I d} ∧
      w' ∈ W ∧ w' ∈ AssocGraded.homogeneous I e ∧ AssocGraded.proj I e x = B + w' := by
  classical
  induction hx using Submodule.span_induction generalizing e with
  | mem y hy => exact ⟨0, AssocGraded.proj I e y, zero_mem _, hWp y hy e, AssocGraded.proj_mem_homogeneous I e y, by simp⟩
  | zero => exact ⟨0, 0, zero_mem _, hW0, zero_mem _, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨B₁, w₁, hB₁, hw₁, hw₁e, h₁⟩ := hx e
    obtain ⟨B₂, w₂, hB₂, hw₂, hw₂e, h₂⟩ := hy e
    refine ⟨B₁ + B₂, w₁ + w₂, add_mem hB₁ hB₂, hWa _ hw₁ _ hw₂, add_mem hw₁e hw₂e, ?_⟩
    rw [map_add, h₁, h₂]; ring
  | smul c x _ hx =>
    choose B w' hB hw' hw'e hBw using hx
    rw [smul_eq_mul, AssocGraded.proj_mul, Finset.sum_range_succ, Nat.sub_self, hBw e, mul_add]
    refine ⟨∑ d ∈ Finset.range e, AssocGraded.proj I (e - d) c * AssocGraded.proj I d x +
      AssocGraded.proj I 0 c * B e, AssocGraded.proj I 0 c * w' e, ?_, hWs _ (AssocGraded.proj_mem_homogeneous I 0 c) _ (hw' e),
      by simpa using AssocGraded.mul_mem_homogeneous I (AssocGraded.proj_mem_homogeneous I 0 c) (hw'e e), by ring⟩
    refine add_mem (sum_mem fun d hd => Ideal.mul_mem_left _ _ ?_) (Ideal.mul_mem_left _ _ ?_)
    · rw [Finset.mem_range] at hd
      rw [hBw d]
      refine add_mem ?_ (Ideal.subset_span ⟨hw' d, d, hd, hw'e d⟩)
      refine (Ideal.span_mono ?_) (hB d)
      rintro w ⟨hwW, d', hd', hwd'⟩
      exact ⟨hwW, d', by omega, hwd'⟩
    · exact hB e

end GradedHelpers2

section RhoLemmas

theorem AssocGraded.aeval_monomial_mem_homogeneous {A : Type u} [CommRing A] (I : Ideal A) {σ : Type*}
    (z : σ → A) (hz : ∀ v, z v ∈ I ^ 1) (β : σ →₀ ℕ) (c : A ⧸ I) :
    aeval (R := A ⧸ I) (fun v => AssocGraded.mk I 1 (z v) (hz v)) (monomial β c) ∈
      AssocGraded.homogeneous I β.degree := by
  obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective c
  have h := aeval_mk_map_of_isHomogeneous I z hz (isHomogeneous_monomial (d := β) c' rfl)
  rw [map_monomial] at h
  rw [h]
  exact AssocGraded.mk_mem_homogeneous _ _

theorem AssocGraded.aeval_mem_homogeneous {A : Type u} [CommRing A] (I : Ideal A) {σ : Type*}
    (z : σ → A) (hz : ∀ v, z v ∈ I ^ 1) {p : MvPolynomial σ (A ⧸ I)} {d : ℕ}
    (hp : p.IsHomogeneous d) :
    aeval (R := A ⧸ I) (fun v => AssocGraded.mk I 1 (z v) (hz v)) p ∈
      AssocGraded.homogeneous I d := by
  rw [p.as_sum, map_sum]
  refine sum_mem fun β hβ => ?_
  have := degree_eq_of_isHomogeneous_of_coeff_ne_zero hp (mem_support_iff.mp hβ)
  rw [← this]
  exact AssocGraded.aeval_monomial_mem_homogeneous I z hz β _

theorem isHomogeneous_pureSubst {r s : ℕ} {k : Type*} [CommRing k] {p : MvPolynomial (CoordIndex r s) k}
    {d : ℕ} (hp : p.IsHomogeneous d) : (pureSubst k p).IsHomogeneous d := by
  intro β hβ
  rw [coeff_pureSubst] at hβ
  split_ifs at hβ
  · exact hp hβ
  · exact absurd rfl hβ

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]
  (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)

include hrat in
/-- `ρ` preserves degrees. -/
theorem ρ_mem_homogeneous {d : ℕ} {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ AssocGraded.homogeneous _ d) :
    C.ρ hrat x ∈ AssocGraded.homogeneous (maximalIdeal R) d := by
  obtain ⟨w, hw, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous _ hx
  obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous C.z₁ w).mp
    (by rw [C.span_z₁]; exact hw)
  have h := aeval_mk_map_of_isHomogeneous (maximalIdeal T.ring) C.z₁ C.z₁_mem hK
  rw [← h]
  change C.ρ hrat (C.e₁ _) ∈ _
  rw [ρ_e₁]
  exact AssocGraded.aeval_mem_homogeneous _ C.z C.z_mem
    (isHomogeneous_pureSubst ((hK.map _).map _))

theorem ρ_algebraMap (c : T.ring ⧸ maximalIdeal T.ring) :
    C.ρ hrat (algebraMap _ (AssocGraded (maximalIdeal T.ring)) c) =
      algebraMap _ (AssocGraded (maximalIdeal R)) ((T.residueEquiv hrat).symm c) := by
  rw [← C.e₁.commutes c, algebraMap_eq, ρ_e₁, map_C, ← algebraMap_eq, AlgHom.commutes,
    ← C.e.commutes]
  rfl

theorem ρ_smul (c : T.ring ⧸ maximalIdeal T.ring) (x : AssocGraded (maximalIdeal T.ring)) :
    C.ρ hrat (c • x) = (T.residueEquiv hrat).symm c • C.ρ hrat x := by
  rw [Algebra.smul_def, map_mul, ρ_algebraMap, ← Algebra.smul_def]

/-- `ρ` maps `k₁[T̃]` into `k[ρ(T̃)]`. -/
theorem ρ_mem_adjoin {τ : ℕ} (W : Fin τ → AssocGraded (maximalIdeal T.ring))
    {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
      (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) :
        Set (AssocGraded (maximalIdeal T.ring)))) :
    C.ρ hrat x ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R) (Set.range fun l => C.ρ hrat (W l)) :
        Set (AssocGraded (maximalIdeal R))) := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    refine Algebra.subset_adjoin ?_
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l, rfl⟩ := hy
      exact Submodule.subset_span ⟨l, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul c y _ hy => rw [ρ_smul]; exact Submodule.smul_mem _ _ hy
  | algebraMap c => rw [ρ_algebraMap]; exact Subalgebra.algebraMap_mem _ _
  | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
  | mul y z _ _ hy hz => rw [map_mul]; exact mul_mem hy hz

end TransformCoord

end RhoLemmas

section NuHelpers

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- `ν^{(i)}(J)` is non-decreasing in `i`. -/
theorem nuI_mono (J : Ideal S) {i j : ℕ+} (hij : i ≤ j) : nuI S J i ≤ nuI S J j := by
  obtain ⟨m, g, hg⟩ := exists_isStandardBase J
  obtain ⟨-, htop⟩ := nuI_eq_of_hasLemma1Properties S J _ hg.2
  obtain ⟨d, hd, hmono⟩ := hg.2.2.1
  have hν : ∀ k : Fin m, nuI S J (k : ℕ).succPNat = d k := fun k =>
    (ordElem_eq_nuI_of_isStandardBase J g hg k).symm.trans (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J g hg d hd k)
  by_cases hjm : (j : ℕ) ≤ m
  · have hi1 : (i : ℕ) - 1 < m := by have := i.pos; have : (i : ℕ) ≤ j := hij; omega
    have hj1 : (j : ℕ) - 1 < m := by have := j.pos; omega
    have hi' : ((⟨(i : ℕ) - 1, hi1⟩ : Fin m) : ℕ).succPNat = i := by
      apply PNat.eq; simp; have := i.pos; omega
    have hj' : ((⟨(j : ℕ) - 1, hj1⟩ : Fin m) : ℕ).succPNat = j := by
      apply PNat.eq; simp; have := j.pos; omega
    rw [← hi', ← hj', hν, hν]
    exact_mod_cast hmono (Fin.mk_le_mk.mpr (by have : (i : ℕ) ≤ j := hij; omega))
  · rw [htop j (by omega)]
    exact le_top

theorem _root_.Nat.count_congr {p q : ℕ → Prop} [DecidablePred p] [DecidablePred q] (y : ℕ)
    (h : ∀ z < y, p z ↔ q z) : Nat.count p y = Nat.count q y := by
  induction y with
  | zero => simp
  | succ y ih =>
    rw [Nat.count_succ, Nat.count_succ, ih fun z hz => h z (by omega)]
    simp only [h y (by omega)]

/-- If `ν*(J)` and `ν*(J')` agree up to the largest index `i` with `ν^{(i)}(J) = μ^{(a)}(J)`,
then `μ^{(a)}(J') = μ^{(a)}(J)`. -/
theorem mu_eq_of_nuI_eq {S' : Type u} [CommRing S'] [IsRegularLocalRing S'] (J : Ideal S)
    (J' : Ideal S') (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t S J) (i : ℕ+)
    (hi : IsGreatest {k : ℕ+ | nuI S J k = (mu S J a : ℕ∞)} i)
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) → nuI S J j = nuI S' J' j) :
    mu S' J' a = mu S J a := by
  classical
  set μb := mu S J a with hμb
  have hfin := (muSet_finite S J).1
  have hmem : μb ∈ muSet S J := by
    apply Nat.nth_mem_of_lt_card hfin
    refine lt_of_lt_of_le ?_ (le_of_eq (Set.ncard_eq_toFinset_card _ hfin))
    have : t S J = (muSet S J).ncard := rfl
    omega
  have hcount : Nat.count (· ∈ muSet S J) μb = a - 1 := by
    rw [hμb, mu]
    refine Nat.count_nth_of_lt_card_finite hfin ?_
    rw [← Set.ncard_eq_toFinset_card _ hfin]
    have : t S J = (muSet S J).ncard := rfl
    omega
  have hiμ : nuI S J i = μb := hi.1
  have hagree : ∀ z ≤ μb, z ∈ muSet S J ↔ z ∈ muSet S' J' := by
    intro z hz
    constructor
    · rintro ⟨k, hk⟩
      by_cases hki : k ≤ i
      · exact ⟨k, (heq k hki).symm.trans hk⟩
      · have h1 : nuI S J i ≤ nuI S J k := nuI_mono J (le_of_lt (not_le.mp hki))
        rw [hiμ, hk, Nat.cast_le] at h1
        have hz' : z = μb := le_antisymm hz h1
        have := hi.2 (show k ∈ {k : ℕ+ | nuI S J k = (μb : ℕ∞)} by
          simp only [Set.mem_ofPred_eq]; rw [hk, hz'])
        exact absurd this hki
    · rintro ⟨k, hk⟩
      by_cases hki : k ≤ i
      · exact ⟨k, (heq k hki).trans hk⟩
      · have h1 : nuI S' J' i ≤ nuI S' J' k := nuI_mono J' (le_of_lt (not_le.mp hki))
        rw [← heq i le_rfl, hiμ, hk, Nat.cast_le] at h1
        have hz' : z = μb := le_antisymm hz h1
        exact hz' ▸ hmem
  have hmem' : μb ∈ muSet S' J' := (hagree μb le_rfl).mp hmem
  have hcount' : Nat.count (· ∈ muSet S' J') μb = a - 1 := by
    rw [← hcount]
    exact (Nat.count_congr μb fun z hz => hagree z hz.le).symm
  rw [mu, ← hcount']
  exact Nat.nth_count hmem'

/-- For `(h₁, …, h_i)` extendable to a standard base of `J` and `μb` the order of one of the
`h_s`, every homogeneous element of `gr_M(J, S)` of degree `< μb` lies in the ideal generated by
the initial forms of the `h_s`. -/
theorem mem_span_initialForm_of_extendsToStandardBase_of_lt_ordElem (J : Ideal S) {i : ℕ} (h : Fin i → S)
    (hext : ExtendsToStandardBase J h) (μb : ℕ) (s₀ : Fin i)
    (hs₀ : Ideal.ordElem (maximalIdeal S) (h s₀) = μb) {w : AssocGraded (maximalIdeal S)} {d : ℕ}
    (hwJ : w ∈ grIdeal (maximalIdeal S) J) (hwd : w ∈ AssocGraded.homogeneous _ d)
    (hdμ : d < μb) :
    w ∈ Ideal.span (Set.range fun s => initialForm (maximalIdeal S) (h s)) := by
  classical
  obtain ⟨m', G, him', hG, hGh⟩ := hext
  obtain ⟨dG, hdG, hmonoG⟩ := hG.2.2.1
  have hdGord := ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J G hG dG hdG
  rw [hG.2.2.2.1] at hwJ
  obtain ⟨c, -, hc0, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span _ _ dG hdG hwd hwJ
  rw [hcsum, Fin.sum_eq_sum_castLE_of_forall_eq_zero him']
  · refine sum_mem fun s _ => Ideal.mul_mem_left _ _ ?_
    rw [hGh s]
    exact Ideal.subset_span ⟨s, rfl⟩
  · intro t ht
    have h1 := hdGord (Fin.castLE him' s₀)
    rw [hGh s₀, hs₀] at h1
    have h2 : μb = dG (Fin.castLE him' s₀) := by exact_mod_cast h1
    have h3 : dG (Fin.castLE him' s₀) ≤ dG t :=
      hmonoG (Fin.le_def.mpr (by simp; have := s₀.2; omega))
    rw [hc0 t (by omega), zero_mul]

end NuHelpers

section AutoAux

variable {k : Type*} [CommRing k] {V : Type*}

theorem _root_.Finsupp.exists_eq_single_of_degree_eq_one {d : V →₀ ℕ} (hd : d.degree = 1) : ∃ v, d = Finsupp.single v 1 := by
  classical
  have h1 : Multiset.card (Finsupp.toMultiset d) = 1 := by
    rw [Finsupp.card_toMultiset]
    have hd' : ∑ i ∈ d.support, d i = 1 := hd
    simpa [Finsupp.sum] using hd'
  obtain ⟨v, hv⟩ := Multiset.card_eq_one.mp h1
  refine ⟨v, ?_⟩
  have := congrArg Multiset.toFinsupp hv
  simpa using this

theorem eq_sum_smul_X_of_isHomogeneous_one [Fintype V] {p : MvPolynomial V k} (hp : p.IsHomogeneous 1) :
    p = ∑ v, p.coeff (Finsupp.single v 1) • X v := by
  classical
  ext d
  rw [coeff_sum]
  simp only [coeff_smul, coeff_X, smul_eq_mul, mul_ite, mul_one, mul_zero]
  by_cases hd : ∃ v, d = Finsupp.single v 1
  · obtain ⟨v, rfl⟩ := hd
    rw [Finset.sum_eq_single v]
    · simp
    · intro b _ hb
      rw [ite_eq_right_iff]
      intro h
      exact absurd (Finsupp.single_left_injective one_ne_zero h) hb
    · simp
  · push Not at hd
    rw [Finset.sum_eq_zero]
    · by_contra h
      obtain ⟨v, hv⟩ := Finsupp.exists_eq_single_of_degree_eq_one (by rw [Finsupp.degree_eq_weight_one]; exact hp h)
      exact hd v hv
    · intro v _
      rw [ite_eq_right_iff]
      exact fun h => absurd h.symm (hd v)

/-- The linear-algebra core of Lemma 16 (p. 233): given a projection-like `k`-algebra
endomorphism `S` of `k[V]` (idempotent, degree-preserving) and forms `w_l` of degree `1` whose
images `S(w_l)` are linearly independent, there is a graded `k`-algebra automorphism `A` of
`k[V]` with `A(w_l) = S(w_l)`, of the form `X_v ↦ X_v - F(S(X_v))` with `S ∘ F = 0`; in particular
`A p = p` for every form `p` of degree `1` with `S p = 0` (the printed `σ₀(X) = X`, `σ₀(Y_j) = Y_j`). -/
theorem exists_algEquiv_apply_eq_and_apply_eq_self_of_linearIndependent [Fintype V] (hk : IsField k)
    (S : MvPolynomial V k →ₐ[k] MvPolynomial V k)
    (hSS : ∀ p, S (S p) = S p) (hShom : ∀ p n, p.IsHomogeneous n → (S p).IsHomogeneous n)
    {ι : Type*} [Fintype ι] (w : ι → MvPolynomial V k) (hw : ∀ l, (w l).IsHomogeneous 1)
    (hli : LinearIndependent k fun l => S (w l)) :
    ∃ A : MvPolynomial V k ≃ₐ[k] MvPolynomial V k,
      (∀ p n, p.IsHomogeneous n → (A p).IsHomogeneous n) ∧
      (∀ p n, p.IsHomogeneous n → (A.symm p).IsHomogeneous n) ∧ (∀ l, A (w l) = S (w l)) ∧
      ∀ p, p.IsHomogeneous 1 → S p = 0 → A p = p := by
  classical
  let _ := hk.toField
  -- `F'` with `F'(S w_l) = w_l - S w_l`, values of degree `1` killed by `S`
  obtain ⟨F, hFw⟩ : ∃ F : MvPolynomial V k →ₗ[k] MvPolynomial V k,
      ∀ l, F (S (w l)) = w l - S (w l) := by
    let U := Submodule.span k (Set.range fun l => S (w l))
    obtain ⟨b, hb⟩ : ∃ b : Module.Basis ι k U, ∀ l, (b l : MvPolynomial V k) = S (w l) :=
      ⟨Module.Basis.span hli, fun l => by rw [Module.Basis.span_apply]⟩
    obtain ⟨f₀, hf₀⟩ : ∃ f₀ : U →ₗ[k] MvPolynomial V k, ∀ l, f₀ (b l) = w l - S (w l) :=
      ⟨b.constr k fun l => w l - S (w l), fun l => b.constr_basis k _ l⟩
    obtain ⟨F, hF⟩ := LinearMap.exists_extend f₀
    refine ⟨F, fun l => ?_⟩
    have := LinearMap.congr_fun hF (b l)
    rw [LinearMap.comp_apply, Submodule.subtype_apply, hb] at this
    rw [this, hf₀]
  obtain ⟨F', hF'S, hF'hom, hF'w⟩ : ∃ F' : MvPolynomial V k →ₗ[k] MvPolynomial V k,
      (∀ p, S (F' p) = 0) ∧ (∀ p, (F' p).IsHomogeneous 1) ∧
        ∀ l, F' (S (w l)) = w l - S (w l) := by
    refine ⟨((LinearMap.id - S.toLinearMap) ∘ₗ homogeneousComponent 1) ∘ₗ F, fun p => ?_,
      fun p => ?_, fun l => ?_⟩
    · simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.sub_apply,
        LinearMap.id_apply, AlgHom.toLinearMap_apply, map_sub, hSS, sub_self]
    · simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.sub_apply,
        LinearMap.id_apply, AlgHom.toLinearMap_apply]
      exact (homogeneousComponent_isHomogeneous _ _).sub
        (hShom _ _ (homogeneousComponent_isHomogeneous _ _))
    · have hhom : (w l - S (w l)).IsHomogeneous 1 := (hw l).sub (hShom _ _ (hw l))
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.sub_apply,
        LinearMap.id_apply, AlgHom.toLinearMap_apply, hFw, homogeneousComponent_eq_self hhom,
        map_sub, hSS, sub_self, sub_zero]
  -- the two substitutions
  let A₀ : MvPolynomial V k →ₐ[k] MvPolynomial V k := aeval fun v => X v - F' (S (X v))
  let A₁ : MvPolynomial V k →ₐ[k] MvPolynomial V k := aeval fun v => X v + F' (S (X v))
  have hA₀ : ∀ p, p.IsHomogeneous 1 → A₀ p = p - F' (S p) := by
    intro p hp
    conv_lhs => rw [eq_sum_smul_X_of_isHomogeneous_one hp]
    conv_rhs => rw [eq_sum_smul_X_of_isHomogeneous_one hp]
    simp only [map_sum, map_smul, A₀, aeval_X, smul_sub, Finset.sum_sub_distrib]
  have hA₁ : ∀ p, p.IsHomogeneous 1 → A₁ p = p + F' (S p) := by
    intro p hp
    conv_lhs => rw [eq_sum_smul_X_of_isHomogeneous_one hp]
    conv_rhs => rw [eq_sum_smul_X_of_isHomogeneous_one hp]
    simp only [map_sum, map_smul, A₁, aeval_X, smul_add, Finset.sum_add_distrib]
  have h01 : A₀.comp A₁ = AlgHom.id k _ := by
    apply MvPolynomial.algHom_ext
    intro v
    simp only [AlgHom.comp_apply, AlgHom.id_apply]
    rw [show A₁ (X v) = X v + F' (S (X v)) from aeval_X _ _,
      hA₀ _ ((isHomogeneous_X k v).add (hF'hom _)), map_add, hF'S, add_zero, add_sub_cancel_right]
  have h10 : A₁.comp A₀ = AlgHom.id k _ := by
    apply MvPolynomial.algHom_ext
    intro v
    simp only [AlgHom.comp_apply, AlgHom.id_apply]
    rw [show A₀ (X v) = X v - F' (S (X v)) from aeval_X _ _,
      hA₁ _ ((isHomogeneous_X k v).sub (hF'hom _)), map_sub, hF'S, sub_zero, sub_add_cancel]
  have hgen₀ : ∀ v, (X v - F' (S (X v)) : MvPolynomial V k).IsHomogeneous 1 := fun v =>
    (isHomogeneous_X k v).sub (hF'hom _)
  have hgen₁ : ∀ v, (X v + F' (S (X v)) : MvPolynomial V k).IsHomogeneous 1 := fun v =>
    (isHomogeneous_X k v).add (hF'hom _)
  refine ⟨AlgEquiv.ofAlgHom A₀ A₁ h01 h10, fun p n hp => ?_, fun p n hp => ?_, fun l => ?_,
    fun p hp hSp => ?_⟩
  · show (A₀ p).IsHomogeneous n
    simpa only [one_mul] using hp.aeval _ hgen₀
  · show (A₁ p).IsHomogeneous n
    simpa only [one_mul] using hp.aeval _ hgen₁
  · show A₀ (w l) = S (w l)
    rw [hA₀ _ (hw l), hF'w, sub_sub_cancel]
  · show A₀ p = p
    rw [hA₀ _ hp, hSp, map_zero, sub_zero]

/-- The linear-algebra core of Lemma 16 (p. 233) without the normalization of the fixed forms. -/
theorem exists_algEquiv_apply_eq_of_linearIndependent [Fintype V] (hk : IsField k)
    (S : MvPolynomial V k →ₐ[k] MvPolynomial V k)
    (hSS : ∀ p, S (S p) = S p) (hShom : ∀ p n, p.IsHomogeneous n → (S p).IsHomogeneous n)
    {ι : Type*} [Fintype ι] (w : ι → MvPolynomial V k) (hw : ∀ l, (w l).IsHomogeneous 1)
    (hli : LinearIndependent k fun l => S (w l)) :
    ∃ A : MvPolynomial V k ≃ₐ[k] MvPolynomial V k,
      (∀ p n, p.IsHomogeneous n → (A p).IsHomogeneous n) ∧
      (∀ p n, p.IsHomogeneous n → (A.symm p).IsHomogeneous n) ∧ ∀ l, A (w l) = S (w l) := by
  obtain ⟨A, h1, h2, h3, -⟩ :=
    exists_algEquiv_apply_eq_and_apply_eq_self_of_linearIndependent hk S hSS hShom w hw hli
  exact ⟨A, h1, h2, h3⟩

end AutoAux

/-- The index of `X` (`none`) and of the `Y_j` (`some (inr j)`) among the coordinates
`(x₀, x₁, …, x_r, y₁, …, y_s)`, as a map `Option (Fin s) → CoordIndex r s`. -/
def kerIdx {r s : ℕ} : Option (Fin s) → CoordIndex r s
  | none => none
  | some j => some (Sum.inr j)

theorem kerIdx_injective {r s : ℕ} : Function.Injective (kerIdx (r := r) (s := s)) := by
  rintro (_ | j) (_ | j') h <;> simp_all [kerIdx]

theorem xWeight_kerIdx {r s : ℕ} (u : Option (Fin s)) : xWeight (kerIdx (r := r) u) = 0 := by
  cases u <;> rfl

theorem exists_kerIdx_eq_of_xWeight_ne_one {r s : ℕ} {v : CoordIndex r s} (hv : xWeight v ≠ 1) :
    ∃ u, kerIdx u = v := by
  rcases v with _ | (i | j)
  · exact ⟨none, rfl⟩
  · exact absurd rfl hv
  · exact ⟨some j, rfl⟩

/-- The restriction `k[X, X₁, …, X_r, Y₁, …, Y_s] → k[X₁, …, X_r]`: `X ↦ 0`, `X_i ↦ X_i`,
`Y_j ↦ 0`. -/
noncomputable def restrictPure (r s : ℕ) (k : Type*) [CommRing k] :
    MvPolynomial (CoordIndex r s) k →ₐ[k] MvPolynomial (Fin r) k :=
  aeval fun v => match v with
    | some (Sum.inl i) => X i
    | _ => 0

theorem pureSubst_eq_rename_restrictPure {r s : ℕ} {k : Type*} [CommRing k]
    (p : MvPolynomial (CoordIndex r s) k) :
    pureSubst k p = rename (fun i => (some (Sum.inl i) : CoordIndex r s)) (restrictPure r s k p) := by
  have : (pureSubst (r := r) (s := s) k) =
      (rename (fun i => (some (Sum.inl i) : CoordIndex r s))).comp (restrictPure r s k) := by
    apply MvPolynomial.algHom_ext
    intro v
    rcases v with _ | (i | j) <;> simp [pureSubst, restrictPure, xWeight]
  exact AlgHom.congr_fun this p

theorem isHomogeneous_restrictPure {r s : ℕ} {k : Type*} [CommRing k]
    {p : MvPolynomial (CoordIndex r s) k} {d : ℕ} (hp : p.IsHomogeneous d) :
    (restrictPure r s k p).IsHomogeneous d := by
  have := hp.aeval (n := 1) (fun v : CoordIndex r s => match v with
      | some (Sum.inl i) => (X i : MvPolynomial (Fin r) k)
      | _ => 0) (fun v => by
    rcases v with _ | (i | j)
    · exact isHomogeneous_zero _ _ _
    · exact isHomogeneous_X _ _
    · exact isHomogeneous_zero _ _ _)
  rw [one_mul] at this
  exact this

/-- The basis `Module.Basis.sumExtend hs` restricts to the original family on the left summand. -/
theorem sumExtend_inl_apply {ι K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    {v : ι → V} (hs : LinearIndependent K v) (i : ι) :
    Module.Basis.sumExtend hs (Sum.inl i) = v i := by
  simp only [Module.Basis.sumExtend, Module.Basis.reindex_apply, Module.Basis.coe_extend]
  rfl

section S1

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

/-- Every element of `grᵈ_M(R)` is the image under `e` of a form of degree `d`. -/
theorem exists_e_eq {d : ℕ} {x : AssocGraded (maximalIdeal R)}
    (hx : x ∈ AssocGraded.homogeneous (maximalIdeal R) d) :
    ∃ q : MvPolynomial (CoordIndex C.r C.s) (R ⧸ maximalIdeal R), q.IsHomogeneous d ∧ C.e q = x := by
  obtain ⟨w, hw, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous _ hx
  obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous C.z w).mp
    (by rw [C.span_z]; exact hw)
  exact ⟨_, hK.map _, aeval_mk_map_of_isHomogeneous (maximalIdeal R) C.z C.z_mem hK⟩

theorem e_mem_homogeneous {d : ℕ} {q : MvPolynomial (CoordIndex C.r C.s) (R ⧸ maximalIdeal R)}
    (hq : q.IsHomogeneous d) : C.e q ∈ AssocGraded.homogeneous (maximalIdeal R) d :=
  AssocGraded.aeval_mem_homogeneous _ C.z C.z_mem hq

variable [IsRegularLocalRing T.ring]

/-- Every element of `grᵈ_{M₁}(R₁)` is the image under `e₁` of a form of degree `d`. -/
theorem exists_e₁_eq {d : ℕ} {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) d) :
    ∃ q : MvPolynomial (CoordIndex C.r C.s) (T.ring ⧸ maximalIdeal T.ring), q.IsHomogeneous d ∧
      C.e₁ q = x := by
  obtain ⟨w, hw, rfl⟩ := AssocGraded.exists_mk_eq_of_mem_homogeneous _ hx
  obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous C.z₁ w).mp
    (by rw [C.span_z₁]; exact hw)
  exact ⟨_, hK.map _, aeval_mk_map_of_isHomogeneous (maximalIdeal T.ring) C.z₁ C.z₁_mem hK⟩

theorem e₁_mem_homogeneous {d : ℕ}
    {q : MvPolynomial (CoordIndex C.r C.s) (T.ring ⧸ maximalIdeal T.ring)}
    (hq : q.IsHomogeneous d) : C.e₁ q ∈ AssocGraded.homogeneous (maximalIdeal T.ring) d :=
  AssocGraded.aeval_mem_homogeneous _ C.z₁ C.z₁_mem hq

end TransformCoord

theorem pureSubst_idem {r s : ℕ} {k : Type*} [CommRing k] (p : MvPolynomial (CoordIndex r s) k) :
    pureSubst k (pureSubst k p) = pureSubst k p := by
  have : (pureSubst (r := r) (s := s) k).comp (pureSubst k) = pureSubst k := by
    apply MvPolynomial.algHom_ext
    intro v
    simp only [AlgHom.comp_apply, pureSubst, aeval_X]
    split_ifs <;> simp_all
  exact AlgHom.congr_fun this p

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]
  (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)

/-- **The isomorphism `σ₀` of Lemma 16** (p. 233): if `W` is a system of linear forms of
`gr_{M₁}(R₁)` whose images under `ρ` are linearly independent, there is an isomorphism of graded
algebras `σ₀ : gr_{M₁}(R₁) → gr_M(R)` (semilinear over `k₁ ≅ k`) which agrees with `ρ` on the
subalgebra `k₁[W]` and satisfies `σ₀(X) = X`, `σ₀(Y_j) = Y_j` (the images of `x₀` and of the `y_j`,
i.e. of the coordinates `v` with `xWeight v = 0`): "`σ₀(Z_j) = ρ(Z_j)`, `σ₀(X) = X`,
`σ₀(Y_j) = Y_j`". -/
theorem exists_ringEquiv_eq_ρ_and_apply_e₁_eq_e {ι : Type*} [Fintype ι]
    (W : ι → AssocGraded (maximalIdeal T.ring))
    (hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1)
    (hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (W l)) :
    ∃ σ₀ : AssocGraded (maximalIdeal T.ring) ≃+* AssocGraded (maximalIdeal R),
      (∀ μ, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ,
        σ₀ x ∈ AssocGraded.homogeneous (maximalIdeal R) μ) ∧
      (∀ μ, ∀ y ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        σ₀.symm y ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ) ∧
      (∀ c : T.ring ⧸ maximalIdeal T.ring,
        σ₀ (algebraMap _ _ c) = algebraMap _ _ ((T.residueEquiv hrat).symm c)) ∧
      (∀ x ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
        (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) :
          Set (AssocGraded (maximalIdeal T.ring))), σ₀ x = C.ρ hrat x) ∧
      ∀ v, xWeight v = 0 → σ₀ (C.e₁ (X v)) = C.e (X v) := by
  classical
  set θ' := (T.residueEquiv hrat).symm with hθ'
  let eE := AlgEquiv.ofBijective C.e C.e_bijective
  let eE₁ := AlgEquiv.ofBijective C.e₁ C.e₁_bijective
  let mθ := MvPolynomial.mapEquiv (CoordIndex C.r C.s) θ'
  choose q hq hqW using fun l => C.exists_e₁_eq (hW1 l)
  let w : ι → MvPolynomial (CoordIndex C.r C.s) (R ⧸ maximalIdeal R) := fun l => mθ (q l)
  have hw : ∀ l, (w l).IsHomogeneous 1 := fun l => (hq l).map _
  have hρW : ∀ l, C.ρ hrat (W l) = C.e (pureSubst _ (w l)) := fun l => by
    rw [← hqW l, ρ_e₁]
    rfl
  have hli' : LinearIndependent (R ⧸ maximalIdeal R) fun l => pureSubst _ (w l) := by
    refine LinearIndependent.of_comp (C.e.toLinearMap) ?_
    convert hli using 1
    funext l
    exact (hρW l).symm
  obtain ⟨A, hA, hAs, hAw, hAfix⟩ := exists_algEquiv_apply_eq_and_apply_eq_self_of_linearIndependent
    ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp inferInstance)
    (pureSubst (R ⧸ maximalIdeal R)) pureSubst_idem
    (fun p n hp => isHomogeneous_pureSubst hp) w hw hli'
  let σ₀ : AssocGraded (maximalIdeal T.ring) ≃+* AssocGraded (maximalIdeal R) :=
    eE₁.symm.toRingEquiv.trans (mθ.trans (A.toRingEquiv.trans eE.toRingEquiv))
  have hσ₀ : ∀ p, σ₀ (C.e₁ p) = C.e (A (p.map θ')) := by
    intro p
    show eE (A (mθ (eE₁.symm (eE₁ p)))) = _
    rw [AlgEquiv.symm_apply_apply]
    rfl
  have hσ₀s : ∀ p, σ₀.symm (C.e p) = C.e₁ ((A.symm p).map (θ'.symm)) := by
    intro p
    rw [RingEquiv.symm_apply_eq, hσ₀]
    congr 1
    rw [MvPolynomial.map_map]
    have : (θ' : T.ring ⧸ maximalIdeal T.ring →+* R ⧸ maximalIdeal R).comp
        (θ'.symm : R ⧸ maximalIdeal R →+* T.ring ⧸ maximalIdeal T.ring) = RingHom.id _ := by
      ext c; simp
    rw [this, MvPolynomial.map_id, AlgEquiv.apply_symm_apply]
  have halg : ∀ c : T.ring ⧸ maximalIdeal T.ring,
      σ₀ (algebraMap _ _ c) = algebraMap _ _ (θ' c) := by
    intro c
    rw [← C.e₁.commutes c, hσ₀, algebraMap_eq, MvPolynomial.map_C, ← algebraMap_eq,
      AlgEquiv.commutes, AlgHom.commutes]
    rfl
  have hρalg : ∀ c : T.ring ⧸ maximalIdeal T.ring,
      C.ρ hrat (algebraMap _ _ c) = algebraMap _ _ (θ' c) := C.ρ_algebraMap hrat
  refine ⟨σ₀, fun μ x hx => ?_, fun μ y hy => ?_, halg, fun x hx => ?_, fun v hv => ?_⟩
  · obtain ⟨p, hp, rfl⟩ := C.exists_e₁_eq hx
    rw [hσ₀]
    exact C.e_mem_homogeneous (hA _ _ (hp.map _))
  · obtain ⟨p, hp, rfl⟩ := C.exists_e_eq hy
    rw [hσ₀s]
    exact C.e₁_mem_homogeneous ((hAs _ _ hp).map _)
  · induction hx using Algebra.adjoin_induction with
    | mem y hy =>
      induction hy using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨l, rfl⟩ := hy
        rw [hρW, ← hqW l, hσ₀, ← hAw l]
        rfl
      | zero => simp
      | add y z _ _ hy hz => rw [map_add, map_add, hy, hz]
      | smul c y _ hy =>
        rw [Algebra.smul_def, map_mul, map_mul, hy, halg, hρalg]
    | algebraMap c => rw [halg, hρalg]
    | add y z _ _ hy hz => rw [map_add, map_add, hy, hz]
    | mul y z _ _ hy hz => rw [map_mul, map_mul, hy, hz]
  · rw [hσ₀, MvPolynomial.map_X, hAfix _ (isHomogeneous_X _ _)]
    simp [pureSubst, hv]

/-- The isomorphism `σ₀` of Lemma 16 agreeing with `ρ` on `k₁[W]`
(`exists_ringEquiv_eq_ρ_and_apply_e₁_eq_e` without the normalization of `X` and `Y_j`). -/
theorem exists_ringEquiv_eq_ρ {ι : Type*} [Fintype ι]
    (W : ι → AssocGraded (maximalIdeal T.ring))
    (hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1)
    (hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (W l)) :
    ∃ σ₀ : AssocGraded (maximalIdeal T.ring) ≃+* AssocGraded (maximalIdeal R),
      (∀ μ, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ,
        σ₀ x ∈ AssocGraded.homogeneous (maximalIdeal R) μ) ∧
      (∀ μ, ∀ y ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        σ₀.symm y ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ) ∧
      (∀ c : T.ring ⧸ maximalIdeal T.ring,
        σ₀ (algebraMap _ _ c) = algebraMap _ _ ((T.residueEquiv hrat).symm c)) ∧
      ∀ x ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
        (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) :
          Set (AssocGraded (maximalIdeal T.ring))), σ₀ x = C.ρ hrat x := by
  obtain ⟨σ₀, h1, h2, h3, h4, -⟩ := C.exists_ringEquiv_eq_ρ_and_apply_e₁_eq_e hrat W hW1 hli
  exact ⟨σ₀, h1, h2, h3, h4⟩

theorem ρ_e₁_X_of_xWeight_eq_zero {v : CoordIndex C.r C.s} (hv : xWeight v = 0) :
    C.ρ hrat (C.e₁ (X v)) = 0 := by
  rw [ρ_e₁, MvPolynomial.map_X]
  simp [pureSubst, hv]

/-- `X`, `X̄_1, …, X̄_r`, `Y_1, …, Y_s` are linearly independent over `k₁` in `gr_{M₁}(R₁)`. -/
theorem linearIndependent_e₁_X :
    LinearIndependent (T.ring ⧸ maximalIdeal T.ring) fun v : CoordIndex C.r C.s => C.e₁ (X v) := by
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  exact (MvPolynomial.linearIndependent_X _ _).map' C.e₁.toLinearMap
    (LinearMap.ker_eq_bot.mpr C.e₁_bijective.1)

/-- `gr¹_{M₁}(R₁)` is spanned by `X`, `X̄_1, …, X̄_r`, `Y_1, …, Y_s`. -/
theorem homogeneous_one_le_span_e₁_X :
    AssocGraded.homogeneous (maximalIdeal T.ring) 1 ≤
      Submodule.span (T.ring ⧸ maximalIdeal T.ring)
        (Set.range fun v : CoordIndex C.r C.s => C.e₁ (X v)) := by
  intro x hx
  obtain ⟨q, hq, rfl⟩ := C.exists_e₁_eq hx
  rw [eq_sum_smul_X_of_isHomogeneous_one hq, map_sum]
  refine Submodule.sum_mem _ fun v _ => ?_
  rw [map_smul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨v, rfl⟩)

include C in
/-- `gr¹_{M₁}(R₁)` is finite-dimensional over `k₁`. -/
theorem finite_homogeneous_one :
    Module.Finite (T.ring ⧸ maximalIdeal T.ring)
      (AssocGraded.homogeneous (maximalIdeal T.ring) 1) := by
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  have : FiniteDimensional (T.ring ⧸ maximalIdeal T.ring)
      (Submodule.span (T.ring ⧸ maximalIdeal T.ring)
        (Set.range fun v : CoordIndex C.r C.s => C.e₁ (X v))) :=
    FiniteDimensional.span_of_finite _ (Set.finite_range _)
  exact Submodule.finiteDimensional_of_le C.homogeneous_one_le_span_e₁_X

/-- If the images `ρ(W_l)` are linearly independent, then `W_1, …, W_τ, X, Y_1, …, Y_s` are
linearly independent (p. 233: "`X, Y_1, …, Y_s` are linearly independent modulo `T̃_a`", as `ρ`
is injective on `T̃_a` and `ρ(X) = ρ(Y_j) = 0`). -/
theorem linearIndependent_sum_of_linearIndependent_ρ {ι : Type*} [Fintype ι]
    (W : ι → AssocGraded (maximalIdeal T.ring))
    (hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (W l)) :
    LinearIndependent (T.ring ⧸ maximalIdeal T.ring)
      (Sum.elim W fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u))) := by
  classical
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hker : ∀ u : Option (Fin C.s), C.ρ hrat (C.e₁ (X (kerIdx u))) = 0 := fun u =>
    C.ρ_e₁_X_of_xWeight_eq_zero hrat (xWeight_kerIdx u)
  simp only [Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr] at hg
  have h1 : ∀ l, g (Sum.inl l) = 0 := by
    have hρ : C.ρ hrat (∑ l, g (Sum.inl l) • W l +
        ∑ u, g (Sum.inr u) • C.e₁ (X (kerIdx u))) = 0 := by rw [hg, map_zero]
    rw [map_add, map_sum, map_sum] at hρ
    simp only [C.ρ_smul hrat, hker, smul_zero, Finset.sum_const_zero, add_zero] at hρ
    intro l
    have := Fintype.linearIndependent_iff.mp hli
      (fun l => (T.residueEquiv hrat).symm (g (Sum.inl l))) hρ l
    exact (RingEquiv.map_eq_zero_iff _).mp this
  have h2 : ∀ u, g (Sum.inr u) = 0 := by
    simp only [h1, zero_smul, Finset.sum_const_zero, zero_add] at hg
    exact Fintype.linearIndependent_iff.mp (C.linearIndependent_e₁_X.comp kerIdx kerIdx_injective)
      _ hg
  rintro (l | u)
  · exact h1 l
  · exact h2 u

/-- If `Z_1, …, Z_r, X, Y_1, …, Y_s` are linearly independent forms of degree `1` of `gr_{M₁}(R₁)`
(a base of `gr¹_{M₁}(R₁)`), then the images `ρ(Z_j)` are linearly independent: `ρ` kills exactly
`X` and the `Y_j` among the forms of degree `1`. -/
theorem linearIndependent_ρ_of_linearIndependent_sum {ι : Type*} [Fintype ι]
    (Z : ι → AssocGraded (maximalIdeal T.ring))
    (hZ1 : ∀ l, Z l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1)
    (hbase : LinearIndependent (T.ring ⧸ maximalIdeal T.ring)
      (Sum.elim Z fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u)))) :
    LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (Z l) := by
  classical
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  rw [Fintype.linearIndependent_iff]
  intro g hg
  set θ := T.residueEquiv hrat with hθ
  obtain ⟨y, hy⟩ : ∃ y, y = ∑ l, θ (g l) • Z l := ⟨_, rfl⟩
  have hρy : C.ρ hrat y = 0 := by
    rw [hy, map_sum]
    simp only [C.ρ_smul hrat, hθ, RingEquiv.symm_apply_apply]
    exact hg
  have hy1 : y ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := by
    rw [hy]
    exact Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ (hZ1 l)
  obtain ⟨q, hq, hqy⟩ := C.exists_e₁_eq hy1
  rw [← hqy, ρ_e₁] at hρy
  have h0 : pureSubst _ (q.map θ.symm.toRingHom) = 0 :=
    C.e_bijective.1 (hρy.trans (map_zero C.e).symm)
  have hcoef : ∀ v, xWeight v = 1 → q.coeff (Finsupp.single v 1) = 0 := by
    intro v hv
    have hpure : IsPure (Finsupp.single v 1 : CoordIndex C.r C.s →₀ ℕ) := by
      rw [isPure_iff_forall_mem_support]
      intro w hw
      rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hw)]
      exact hv
    have h1 := congrArg (fun p : MvPolynomial (CoordIndex C.r C.s) (R ⧸ maximalIdeal R) =>
      p.coeff (Finsupp.single v 1)) h0
    simp only [coeff_pureSubst, hpure, ↓reduceIte, MvPolynomial.coeff_map,
      AddMonoidAlgebra.coeff_zero] at h1
    exact (RingEquiv.map_eq_zero_iff _).mp h1
  have hysum : y = ∑ u : Option (Fin C.s),
      q.coeff (Finsupp.single (kerIdx u) 1) • C.e₁ (X (kerIdx u)) := by
    rw [← hqy]
    conv_lhs => rw [eq_sum_smul_X_of_isHomogeneous_one hq]
    rw [map_sum]
    simp only [map_smul]
    rw [← Finset.sum_image (f := fun v => q.coeff (Finsupp.single v 1) • C.e₁ (X v))
      (g := kerIdx) (fun a _ b _ h => kerIdx_injective h)]
    refine (Finset.sum_subset (Finset.subset_univ _) fun v _ hv => ?_).symm
    have : xWeight v = 1 := by
      by_contra hne
      obtain ⟨u, hu⟩ := exists_kerIdx_eq_of_xWeight_ne_one hne
      exact hv (Finset.mem_image.mpr ⟨u, Finset.mem_univ _, hu⟩)
    rw [hcoef v this, zero_smul]
  have := Fintype.linearIndependent_iff.mp hbase
    (Sum.elim (fun l => θ (g l)) fun u => - q.coeff (Finsupp.single (kerIdx u) 1)) (by
      rw [Fintype.sum_sum_type]
      simp only [Sum.elim_inl, Sum.elim_inr, neg_smul, Finset.sum_neg_distrib]
      rw [← hy, ← hysum]
      exact add_neg_cancel _)
  intro l
  exact (RingEquiv.map_eq_zero_iff θ).mp (this (Sum.inl l))

/-- **The base of `gr¹_{M₁}(R₁)` of p. 233** ("Hence we can choose a linearly independent base
`(Z̄_1, …, Z̄_r, X, Y_1, …, Y_s)` of the `k`-module `gr¹_{M₁}(R₁)` such that `T̃_b` is generated by
`Z̄_1, …, Z̄_{τ_b}`"): the linearly independent forms `W_1, …, W_τ` (a family generating `T̃_a`),
whose images under `ρ` are linearly independent, extend to a base `(Z̄, X, Y_1, …, Y_s)` of `gr¹`
with `Z̄_j = W_j` for `j ≤ τ`. -/
theorem exists_base_extending {τ : ℕ} (W : Fin τ → AssocGraded (maximalIdeal T.ring))
    (hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1)
    (hli : LinearIndependent (R ⧸ maximalIdeal R) fun l => C.ρ hrat (W l)) :
    ∃ (E : Type u) (_ : Fintype E) (Z : Fin τ ⊕ E → AssocGraded (maximalIdeal T.ring)),
      (∀ l, Z (Sum.inl l) = W l) ∧ (∀ j, Z j ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1) ∧
      LinearIndependent (T.ring ⧸ maximalIdeal T.ring)
        (Sum.elim Z fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u))) ∧
      Submodule.span (T.ring ⧸ maximalIdeal T.ring)
        (Set.range (Sum.elim Z fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u)))) =
        AssocGraded.homogeneous (maximalIdeal T.ring) 1 := by
  classical
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  set Gr1 := AssocGraded.homogeneous (maximalIdeal T.ring) 1 with hGr1
  let v : Fin τ ⊕ Option (Fin C.s) → Gr1 := Sum.elim (fun l => ⟨W l, hW1 l⟩)
    fun u => ⟨C.e₁ (X (kerIdx u)), C.e₁_mem_homogeneous (isHomogeneous_X _ _)⟩
  have hv : LinearIndependent (T.ring ⧸ maximalIdeal T.ring) v := by
    refine LinearIndependent.of_comp Gr1.subtype ?_
    have : Gr1.subtype ∘ v = Sum.elim W fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u)) := by
      ext (l | u) <;> rfl
    rw [this]
    exact C.linearIndependent_sum_of_linearIndependent_ρ hrat W hli
  let b := Module.Basis.sumExtend hv
  have : Module.Finite (T.ring ⧸ maximalIdeal T.ring) Gr1 := C.finite_homogeneous_one
  have : Finite ((Fin τ ⊕ Option (Fin C.s)) ⊕ Module.Basis.sumExtendIndex hv) :=
    Module.Finite.finite_basis b
  have : Finite (Module.Basis.sumExtendIndex hv) :=
    Finite.of_injective (Sum.inr : Module.Basis.sumExtendIndex hv →
      (Fin τ ⊕ Option (Fin C.s)) ⊕ Module.Basis.sumExtendIndex hv) Sum.inr_injective
  let _ : Fintype (Module.Basis.sumExtendIndex hv) := Fintype.ofFinite _
  let e : ((Fin τ ⊕ Module.Basis.sumExtendIndex hv) ⊕ Option (Fin C.s)) ≃
      ((Fin τ ⊕ Option (Fin C.s)) ⊕ Module.Basis.sumExtendIndex hv) :=
    (Equiv.sumAssoc _ _ _).trans ((Equiv.sumCongr (Equiv.refl _) (Equiv.sumComm _ _)).trans
      (Equiv.sumAssoc _ _ _).symm)
  have hfull : Sum.elim (fun j => (b (e (Sum.inl j)) : AssocGraded (maximalIdeal T.ring)))
      (fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u))) = Gr1.subtype ∘ (b ∘ e) := by
    ext (j | u)
    · rfl
    · show _ = (b (Sum.inl (Sum.inr u)) : AssocGraded (maximalIdeal T.ring))
      rw [sumExtend_inl_apply]
      rfl
  refine ⟨Module.Basis.sumExtendIndex hv, inferInstance,
    fun j => (b (e (Sum.inl j)) : AssocGraded (maximalIdeal T.ring)), fun l => ?_,
    fun j => (b (e (Sum.inl j))).2, ?_, ?_⟩
  · show (b (Sum.inl (Sum.inl l)) : AssocGraded (maximalIdeal T.ring)) = W l
    rw [sumExtend_inl_apply]
    rfl
  · rw [hfull]
    exact (b.linearIndependent.comp e e.injective).map' Gr1.subtype (Submodule.ker_subtype _)
  · rw [hfull, Set.range_comp, Set.range_comp, Equiv.range_eq_univ, Set.image_univ]
    rw [← Submodule.map_span, b.span_eq, Submodule.map_top, Submodule.range_subtype]

/-- **The isomorphism `σ₀` of Lemma 16, as printed** (p. 233): for a base
`(Z̄_1, …, Z̄_r, X, Y_1, …, Y_s)` of `gr¹_{M₁}(R₁)`, "`σ₀(Z̄_j) = ρ(Z̄_j)`, `σ₀(X) = X`,
`σ₀(Y_j) = Y_j`" defines an isomorphism of graded `k`-algebras `gr_{M₁}(R₁) → gr_M(R)`
(semilinear over `k₁ ≅ k`; here `X`, `Y_j` denote `e₁(X_x₀)`, `e₁(X_{y_j})` in `gr_{M₁}(R₁)` and the
corresponding `e(·)` in `gr_M(R)`), which agrees with `ρ` on `k₁[Z̄]`. -/
theorem exists_ringEquiv_eq_ρ_of_base {ι : Type*} [Fintype ι]
    (Z : ι → AssocGraded (maximalIdeal T.ring))
    (hZ1 : ∀ l, Z l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1)
    (hbase : LinearIndependent (T.ring ⧸ maximalIdeal T.ring)
      (Sum.elim Z fun u : Option (Fin C.s) => C.e₁ (X (kerIdx u)))) :
    ∃ σ₀ : AssocGraded (maximalIdeal T.ring) ≃+* AssocGraded (maximalIdeal R),
      (∀ μ, ∀ x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ,
        σ₀ x ∈ AssocGraded.homogeneous (maximalIdeal R) μ) ∧
      (∀ μ, ∀ y ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        σ₀.symm y ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ) ∧
      (∀ c : T.ring ⧸ maximalIdeal T.ring,
        σ₀ (algebraMap _ _ c) = algebraMap _ _ ((T.residueEquiv hrat).symm c)) ∧
      (∀ l, σ₀ (Z l) = C.ρ hrat (Z l)) ∧
      σ₀ (C.e₁ (X none)) = C.e (X none) ∧
      (∀ j : Fin C.s, σ₀ (C.e₁ (X (some (Sum.inr j)))) = C.e (X (some (Sum.inr j)))) ∧
      ∀ x ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
        (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range Z) :
          Set (AssocGraded (maximalIdeal T.ring))), σ₀ x = C.ρ hrat x := by
  obtain ⟨σ₀, h1, h2, h3, h4, h5⟩ := C.exists_ringEquiv_eq_ρ_and_apply_e₁_eq_e hrat Z hZ1
    (C.linearIndependent_ρ_of_linearIndependent_sum hrat Z hZ1 hbase)
  exact ⟨σ₀, h1, h2, h3, fun l => h4 _ (Algebra.subset_adjoin (Submodule.subset_span ⟨l, rfl⟩)),
    h5 none rfl, fun j => h5 _ rfl, h4⟩

/-- "`δ_{jd} = ρ(δ̄_{jd})` is a form only in `X_1, …, X_r`" (p. 233): the image under `ρ` of a form
of degree `μ` is the image under `e` of a form of degree `μ` in the variables `X_1, …, X_r` alone. -/
theorem exists_ρ_eq_e_rename {μ : ℕ} {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) μ) :
    ∃ q : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R), q.IsHomogeneous μ ∧
      C.ρ hrat x = C.e (rename (fun i => (some (Sum.inl i) : CoordIndex C.r C.s)) q) := by
  obtain ⟨p, hp, rfl⟩ := C.exists_e₁_eq hx
  refine ⟨restrictPure C.r C.s _ (p.map (T.residueEquiv hrat).symm.toRingHom),
    isHomogeneous_restrictPure (hp.map _), ?_⟩
  rw [ρ_e₁, pureSubst_eq_rename_restrictPure]

end TransformCoord

end S1

section L16

theorem mem_span_image_of_mem_span {A B : Type*} [CommRing A] [CommRing B] {F : Type*} [FunLike F A B]
    [RingHomClass F A B] (f : F) {K : Set A} {x : A} (hx : x ∈ Ideal.span K) :
    f x ∈ Ideal.span (f '' K) := by
  have := Ideal.mem_map_of_mem f hx
  rwa [Ideal.map_span] at this

variable {S : Type u} [CommRing S] [IsRegularLocalRing S]

/-- For `(h₁, …, h_i)` extendable to a standard base of `J`, every homogeneous element of
`gr_M(J, S)` of degree `d < ν^{(i+1)}(J)` lies in the ideal generated by the initial forms of the
`h_s`. -/
theorem mem_span_initialForm_of_extendsToStandardBase_of_lt_nuI (J : Ideal S) {i : ℕ} (h : Fin i → S)
    (hext : ExtendsToStandardBase J h) {w : AssocGraded (maximalIdeal S)} {d : ℕ}
    (hwJ : w ∈ grIdeal (maximalIdeal S) J) (hwd : w ∈ AssocGraded.homogeneous _ d)
    (hd : (d : ℕ∞) < nuI S J i.succPNat) :
    w ∈ Ideal.span (Set.range fun s => initialForm (maximalIdeal S) (h s)) := by
  classical
  obtain ⟨m', G, him', hG, hGh⟩ := hext
  obtain ⟨dG, hdG, -⟩ := hG.2.2.1
  rw [hG.2.2.2.1] at hwJ
  obtain ⟨c, -, hc0, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span _ _ dG hdG hwd hwJ
  rw [hcsum, Fin.sum_eq_sum_castLE_of_forall_eq_zero him']
  · refine sum_mem fun s _ => Ideal.mul_mem_left _ _ ?_
    rw [hGh s]
    exact Ideal.subset_span ⟨s, rfl⟩
  · intro t ht
    have h1 : (dG t : ℕ∞) = nuI S J (t : ℕ).succPNat :=
      (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J G hG dG hdG t).symm.trans (ordElem_eq_nuI_of_isStandardBase J G hG t)
    have h2 : nuI S J i.succPNat ≤ nuI S J (t : ℕ).succPNat :=
      nuI_mono J (by rw [← PNat.coe_le_coe]; simp; omega)
    have h3 : d < dG t := by
      have := hd.trans_le (h2.trans_eq h1.symm)
      exact_mod_cast this
    rw [hc0 t h3, zero_mul]

/-- If `i` is the largest index with `ν^{(i)}(J) = μ`, then `μ < ν^{(i+1)}(J)`. -/
theorem lt_nuI_succPNat_of_isGreatest (J : Ideal S) {μ : ℕ} {i : ℕ+}
    (hi : IsGreatest {k : ℕ+ | nuI S J k = (μ : ℕ∞)} i) :
    (μ : ℕ∞) < nuI S J (i : ℕ).succPNat := by
  have h1 : nuI S J i ≤ nuI S J (i : ℕ).succPNat :=
    nuI_mono J (by rw [← PNat.coe_le_coe]; simp)
  rw [hi.1] at h1
  refine lt_of_le_of_ne h1 fun h2 => ?_
  have := hi.2 (show (i : ℕ).succPNat ∈ {k : ℕ+ | nuI S J k = (μ : ℕ∞)} from h2.symm)
  rw [← PNat.coe_le_coe] at this
  simp at this

theorem _root_.PNat.succPNat_coe_eq_add_one (i : ℕ+) : (i : ℕ).succPNat = i + 1 := PNat.eq (by simp)

/-- The key step of the proof of Lemma 15 (pp. 230–231): if `W` is a system of linear forms of
`gr_{M₁}(R₁)` with the property of Definition 6 for `J₁` up to `μ̄`, then `ρ(W)` has the property
for `J` up to `μ̄` ("applying `ρ` to the both sides of the equality (v)"). -/
theorem TransformCoord.isTauSubmodule_span_rho (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R]
    (P : Ideal R) (J : Ideal R) (T : MonoidalTransform R P)
    [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (C : TransformCoord T)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) (i : ℕ+) (him : (i : ℕ) ≤ m)
    (ν : Fin m → ℕ) (hgM : ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j)
    (h : Fin (i : ℕ) → T.ring)
    (hgh : ∀ j : Fin (i : ℕ), C.x₁ ^ ν (Fin.castLE him j) * h j = T.toRing (g (Fin.castLE him j)))
    (hhν : ∀ j : Fin (i : ℕ),
      Ideal.ordElem (maximalIdeal T.ring) (h j) = (ν (Fin.castLE him j) : ℕ∞))
    (hext : ExtendsToStandardBase (strictTransformIdeal T J) h) (μb : ℕ)
    (hνle : ∀ s : Fin (i : ℕ), ν (Fin.castLE him s) ≤ μb) (s₀ : Fin (i : ℕ))
    (hs₀ : ν (Fin.castLE him s₀) = μb) (hνgt : ∀ j : Fin m, (i : ℕ) ≤ j → μb < ν j)
    {τ : ℕ} (W : Fin τ → AssocGraded (maximalIdeal T.ring))
    (hW1 : ∀ l, W l ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1)
    (hW : IsTauSubmodule T.ring (strictTransformIdeal T J)
      (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W)) μb) :
    IsTauSubmodule R J
      (Submodule.span (R ⧸ maximalIdeal R) (Set.range fun l => C.ρ hrat (W l))) μb := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  obtain ⟨dg, hdg, -⟩ := hg.2.2.1
  have hdgν : ∀ j, dg j = ν j := fun j => by
    have := (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J g hg dg hdg j).symm.trans (hgM j)
    exact_mod_cast this
  refine ⟨Submodule.span_le.mpr ?_, fun μ hμ ψ hψ => ⟨fun hψJ => ?_, fun hmem => ?_⟩⟩
  · rintro _ ⟨l, rfl⟩
    exact C.ρ_mem_homogeneous hrat (hW1 l)
  · -- the key step: `φ_t ∈ (gr(J) ∩ k[ρ(T̃)]) gr` for `t < i`
    set W₁ : Set (AssocGraded (maximalIdeal T.ring)) := {w | w ∈ grIdeal (maximalIdeal T.ring) J₁ ∧
      w ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
        (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) :
          Set (AssocGraded (maximalIdeal T.ring)))} with hW₁
    set Wset : Set (AssocGraded (maximalIdeal R)) := {w | w ∈ grIdeal (maximalIdeal R) J ∧
      w ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
        (Submodule.span (R ⧸ maximalIdeal R) (Set.range fun l => C.ρ hrat (W l)) :
          Set (AssocGraded (maximalIdeal R)))} with hWset
    have hspanW1 : ∀ s ∈ (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) :
        Set (AssocGraded (maximalIdeal T.ring))),
        s ∈ AssocGraded.homogeneous (maximalIdeal T.ring) 1 := fun s hs => hW.1 hs
    have hIt : ∀ s : Fin (i : ℕ), initialForm (maximalIdeal R) (g (Fin.castLE him s)) ∈
        Ideal.span Wset := by
      intro s
      set Ĩ := Ideal.span (Set.range fun s => initialForm (maximalIdeal T.ring) (h s))
      have hρφ : C.ρ hrat (initialForm (maximalIdeal T.ring) (h s)) =
          initialForm (maximalIdeal R) (g (Fin.castLE him s)) :=
        ((C.ordElem_le_and_rho_initialForm_eq hrat _ _ (hgM _) (h s) (hgh s)).2 (hhν s)).2
      have hhJ₁ : h s ∈ J₁ := by
        obtain ⟨m', G, him', hG, hGh⟩ := hext
        rw [← hGh s]; exact hG.1 _
      have hψs : initialForm (maximalIdeal T.ring) (h s) ∈
          AssocGraded.homogeneous (maximalIdeal T.ring) (ν (Fin.castLE him s)) := by
        rw [initialForm_eq_mk _ (hhν s)]; exact AssocGraded.mk_mem_homogeneous _ _
      have hψW : initialForm (maximalIdeal T.ring) (h s) ∈ Ideal.span W₁ :=
        (hW.2 _ (hνle s) _ hψs).mp (Ideal.subset_span ⟨h s, hhJ₁, rfl⟩)
      obtain ⟨B, w', hB, hw', hw'e, hdec⟩ := AssocGraded.exists_proj_eq_add_of_mem_span _ W₁
        (fun w hw d => ⟨AssocGraded.proj_mem_grIdeal _ _ hw.1 d, AssocGraded.proj_mem_adjoin _ hspanW1 hw.2 d⟩)
        ⟨zero_mem _, zero_mem _⟩
        (fun w hw w' hw' => ⟨add_mem hw.1 hw'.1, add_mem hw.2 hw'.2⟩)
        (fun c hc w hw => by
          obtain ⟨c₀, rfl⟩ := AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero _ hc
          exact ⟨Ideal.mul_mem_left _ _ hw.1, mul_mem (Subalgebra.algebraMap_mem _ _) hw.2⟩)
        hψW (ν (Fin.castLE him s))
      rw [AssocGraded.proj_of_mem_homogeneous _ hψs] at hdec
      have hlow : ∀ w ∈ W₁, ∀ d < ν (Fin.castLE him s),
          w ∈ AssocGraded.homogeneous (maximalIdeal T.ring) d → w ∈ Ĩ := by
        intro w hw d hd hwd
        refine mem_span_initialForm_of_extendsToStandardBase_of_lt_ordElem J₁ h hext μb s₀ ?_ hw.1 hwd
          (lt_of_lt_of_le hd (hνle s))
        rw [hhν, hs₀]
      have hBI : B ∈ Ĩ := by
        refine (Ideal.span_le.mpr ?_) hB
        rintro w ⟨hw, d, hd, hwd⟩
        exact hlow w hw d hd hwd
      have hw'I : w' ∈ Ĩ := by
        have : w' = initialForm (maximalIdeal T.ring) (h s) - B := by rw [hdec]; ring
        rw [this]
        exact sub_mem (Ideal.subset_span ⟨s, rfl⟩) hBI
      have hψI : initialForm (maximalIdeal T.ring) (h s) ∈ Ideal.span {w | w ∈ Ĩ ∧ w ∈ W₁} := by
        rw [hdec]
        refine add_mem ((Ideal.span_mono ?_) hB) (Ideal.subset_span ⟨hw'I, hw'⟩)
        rintro w ⟨hw, d, hd, hwd⟩
        exact ⟨hlow w hw d hd hwd, hw⟩
      have hmapI : Ideal.map (C.ρ hrat) Ĩ ≤ grIdeal (maximalIdeal R) J := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨s', rfl⟩, rfl⟩
        rw [((C.ordElem_le_and_rho_initialForm_eq hrat _ _ (hgM _) (h s') (hgh s')).2 (hhν s')).2]
        exact Ideal.subset_span ⟨_, hg.1 _, rfl⟩
      rw [← hρφ]
      have := Ideal.mem_map_of_mem (C.ρ hrat) hψI
      rw [Ideal.map_span] at this
      refine (Ideal.span_le.mpr ?_) this
      rintro _ ⟨y, ⟨hyI, hyW⟩, rfl⟩
      exact Ideal.subset_span ⟨hmapI (Ideal.mem_map_of_mem _ hyI), C.ρ_mem_adjoin hrat W hyW.2⟩
    rw [hg.2.2.2.1] at hψJ
    obtain ⟨c, -, hc0, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span _ _ dg hdg hψ hψJ
    rw [hcsum]
    refine sum_mem fun t _ => ?_
    by_cases ht : (t : ℕ) < (i : ℕ)
    · have := hIt ⟨t, ht⟩
      rw [show Fin.castLE him ⟨t, ht⟩ = t from Fin.ext rfl] at this
      exact Ideal.mul_mem_left _ _ this
    · rw [hc0 t (by rw [hdgν]; have := hνgt t (by omega); omega), zero_mul]
      exact zero_mem _
  · refine (Ideal.span_le.mpr ?_) hmem
    rintro _ ⟨hJ, -⟩
    exact hJ

end L16

section IdealProperty

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- The property of Definition 6 (p. 221) for an arbitrary ideal `𝔞` of `gr_I(A)`, a
`K`-submodule `T` of `gr_I(A)` and a bound `μ₀`: `T` consists of linear forms and
"`𝔞_μ = gr^μ_I(A) ∩ (𝔞 ∩ K[T]) gr_I(A)` for all `μ ≤ μ₀`" (`K = A/I`, `K[T]` the `K`-subalgebra
generated by `T`); `𝔞_μ = gr^μ ∩ 𝔞` as `𝔞` is homogeneous.  For `𝔞 = gr_M(J, R)` this is
`IsTauSubmodule R J T μ₀` (`isTauSubmodule_iff_isTauSubmoduleOfIdeal`); the proof of Lemma 15 uses it for
`𝔞 = I = (φ₁, …, φ_i) gr_M(R)` and `𝔞 = Ĩ = (ψ₁, …, ψ_i) gr_{M₁}(R₁)` (pp. 230–231). -/
def IsTauSubmoduleOfIdeal (𝔞 : Ideal (AssocGraded I))
    (T : Submodule (A ⧸ I) (AssocGraded I)) (μ₀ : ℕ) : Prop :=
  T ≤ AssocGraded.homogeneous I 1 ∧
  ∀ μ ≤ μ₀, ∀ ψ ∈ AssocGraded.homogeneous I μ,
    (ψ ∈ 𝔞 ↔ ψ ∈ Ideal.span ((𝔞 : Set (AssocGraded I)) ∩
      (Algebra.adjoin (A ⧸ I) (T : Set (AssocGraded I)) : Set (AssocGraded I))))

theorem isTauSubmodule_iff_isTauSubmoduleOfIdeal {R : Type u} [CommRing R] [IsRegularLocalRing R]
    (J : Ideal R) (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))) (μ₀ : ℕ) :
    IsTauSubmodule R J T μ₀ ↔
      IsTauSubmoduleOfIdeal (maximalIdeal R) (grIdeal (maximalIdeal R) J) T μ₀ := Iff.rfl

variable {I}

/-- **Equality (v) of p. 231, in general** ("`Ĩ_μ = gr^μ(R₁) ∩ (Ĩ ∩ k[T̃]) gr(R₁)` for all
`μ ≤ μ̄`. This equality is clear for `μ < μ̄` because we have `Ĩ_μ = gr^μ(J₁, R₁)` for all
`μ < μ̄`. Let us study the equality for `μ = μ̄`."): let `𝔟 ≤ 𝔞` be homogeneous ideals of `gr_I(A)`
(`𝔞 = gr_{M₁}(J₁, R₁)`, `𝔟 = Ĩ`) which agree in all degrees `< μ₀`, and let `T` have the property
for `𝔞` up to `μ₀`.  Then `T` has the property for `𝔟` up to `μ₀`.

The proof is the printed chain of inclusions in the top degree `μ₀`:
`𝔟_{μ₀} ⊆ gr^{μ₀} ∩ (𝔞 ∩ k[T]) gr = Σ_{μ<μ₀} (𝔞_μ ∩ k[T]) gr^{μ₀-μ} + 𝔞_{μ₀} ∩ k[T]
⊆ Σ_{μ<μ₀} (𝔟_μ ∩ k[T]) gr^{μ₀-μ} + k[T]_{μ₀}`, "hence" (intersecting with `𝔟_{μ₀}`, which
contains the sum)
`𝔟_{μ₀} ⊆ Σ_{μ<μ₀} (𝔟_μ ∩ k[T]) gr^{μ₀-μ} + 𝔟_{μ₀} ∩ k[T]`; the reversed inclusion is obvious. -/
theorem IsTauSubmoduleOfIdeal.of_forall_lt_mem {𝔞 𝔟 : Ideal (AssocGraded I)}
    (h𝔞 : ∀ w ∈ 𝔞, ∀ e, AssocGraded.proj I e w ∈ 𝔞) (hle : 𝔟 ≤ 𝔞) {μ₀ : ℕ}
    (hlow : ∀ d < μ₀, ∀ w ∈ 𝔞, w ∈ AssocGraded.homogeneous I d → w ∈ 𝔟)
    {T : Submodule (A ⧸ I) (AssocGraded I)} (hT : IsTauSubmoduleOfIdeal I 𝔞 T μ₀) :
    IsTauSubmoduleOfIdeal I 𝔟 T μ₀ := by
  classical
  refine ⟨hT.1, fun μ hμ ψ hψ => ⟨fun hψ𝔟 => ?_, fun h => (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩
  have hT1 : ∀ s ∈ (T : Set (AssocGraded I)), s ∈ AssocGraded.homogeneous I 1 :=
    fun s hs => hT.1 hs
  set W : Set (AssocGraded I) := {w | w ∈ 𝔞 ∧ w ∈ Algebra.adjoin (A ⧸ I) (T : Set (AssocGraded I))}
    with hW
  have hψW : ψ ∈ Ideal.span W := (hT.2 μ hμ ψ hψ).mp (hle hψ𝔟)
  obtain ⟨B, w', hB, hw', hw'e, hdec⟩ := AssocGraded.exists_proj_eq_add_of_mem_span I W
    (fun w hw d => ⟨h𝔞 w hw.1 d, AssocGraded.proj_mem_adjoin I hT1 hw.2 d⟩)
    ⟨zero_mem _, zero_mem _⟩
    (fun w hw w' hw' => ⟨add_mem hw.1 hw'.1, add_mem hw.2 hw'.2⟩)
    (fun c hc w hw => by
      obtain ⟨c₀, rfl⟩ := AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero I hc
      exact ⟨Ideal.mul_mem_left _ _ hw.1, mul_mem (Subalgebra.algebraMap_mem _ _) hw.2⟩)
    hψW μ
  rw [AssocGraded.proj_of_mem_homogeneous I hψ] at hdec
  -- the lower-degree part lies in `(𝔟 ∩ k[T]) gr`
  have hB𝔟 : B ∈ Ideal.span ((𝔟 : Set (AssocGraded I)) ∩
      (Algebra.adjoin (A ⧸ I) (T : Set (AssocGraded I)) : Set (AssocGraded I))) := by
    refine (Ideal.span_mono ?_) hB
    rintro w ⟨hwW, d, hd, hwd⟩
    exact ⟨hlow d (lt_of_lt_of_le hd hμ) w hwW.1 hwd, hwW.2⟩
  have hB𝔟' : B ∈ 𝔟 := (Ideal.span_le.mpr fun x hx => hx.1) hB𝔟
  -- the top-degree part is `ψ - B ∈ 𝔟 ∩ k[T]`
  have hw'𝔟 : w' ∈ 𝔟 := by
    have : w' = ψ - B := by rw [hdec]; ring
    rw [this]
    exact sub_mem hψ𝔟 hB𝔟'
  rw [hdec]
  exact add_mem hB𝔟 (Ideal.subset_span ⟨hw'𝔟, hw'.2⟩)

/-- The converse used for `I` and `gr_M(J, R)` (p. 230: "`gr^μ_M(J, R) = gr^μ_M(R) ∩ (φ₁, …, φ_i)
gr_M(R)` for all `μ ≤ μ̄`. Therefore we see that, if `I = (φ₁, …, φ_i) gr_M(R)`, then `τ^{(a)}(J)` is
the rank of the smallest `k`-submodule `T` of `gr¹_M(R)` such that `I_μ = gr^μ_M(R) ∩ (I ∩ k[T])
gr_M(R)` for all `μ ≤ μ̄`"): homogeneous ideals `𝔟 ≤ 𝔞` agreeing in all degrees `≤ μ₀` have the
same `T`'s with the property up to `μ₀`. -/
theorem IsTauSubmoduleOfIdeal.of_forall_le_mem {𝔞 𝔟 : Ideal (AssocGraded I)} (hle : 𝔟 ≤ 𝔞)
    {μ₀ : ℕ} (hlow : ∀ d ≤ μ₀, ∀ w ∈ 𝔞, w ∈ AssocGraded.homogeneous I d → w ∈ 𝔟)
    {T : Submodule (A ⧸ I) (AssocGraded I)} (hT : IsTauSubmoduleOfIdeal I 𝔟 T μ₀) :
    IsTauSubmoduleOfIdeal I 𝔞 T μ₀ := by
  refine ⟨hT.1, fun μ hμ ψ hψ => ⟨fun h𝔞ψ => ?_, fun h => (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩
  refine (Ideal.span_mono ?_) ((hT.2 μ hμ ψ hψ).mp (hlow μ hμ ψ h𝔞ψ hψ))
  rintro x ⟨hx1, hx2⟩
  exact ⟨hle hx1, hx2⟩

/-- **The decomposition of a form of degree `μ`** (p. 233: "by the definition of `T̃_b` (`1 ≤ b ≤ a`), we
can write each `ψ_j` in the following form: `ψ_j = ψ_j' + Σ_{d=1}^{j(b-1)} δ̄_{jd} ψ_d`, where `ψ_j'` is a
form only in `Z̄_1, …, Z̄_{τ_b}`"): let `𝔞 ⊆ gr_I(A)` be a homogeneous ideal (`𝔞 = gr(J₁, R₁)`),
`T` have the property of Definition 6 for `𝔞` up to `μ₀`, and `ψ ∈ 𝔞` be homogeneous of degree
`μ ≤ μ₀`.  If every homogeneous element of `𝔞` of degree `< μ` lies in an ideal `𝔟`
(`𝔟 = (ψ_d : ν_d < μ)`), then `ψ = ψ' + (element of 𝔟)` with `ψ' ∈ 𝔞 ∩ k[T]` homogeneous of degree `μ`.
The proof is the top-degree decomposition of `ψ ∈ (𝔞 ∩ k[T]) gr_I(A)` used for (v) of Lemma 15
(`AssocGraded.exists_proj_eq_add_of_mem_span`). -/
theorem IsTauSubmoduleOfIdeal.exists_sub_mem_of_lt {𝔞 𝔟 : Ideal (AssocGraded I)}
    (h𝔞 : ∀ w ∈ 𝔞, ∀ e, AssocGraded.proj I e w ∈ 𝔞) {μ₀ : ℕ}
    {T : Submodule (A ⧸ I) (AssocGraded I)} (hT : IsTauSubmoduleOfIdeal I 𝔞 T μ₀)
    {μ : ℕ} (hμ : μ ≤ μ₀) {ψ : AssocGraded I} (hψ : ψ ∈ AssocGraded.homogeneous I μ) (hψ𝔞 : ψ ∈ 𝔞)
    (hlow : ∀ d < μ, ∀ w ∈ 𝔞, w ∈ AssocGraded.homogeneous I d → w ∈ 𝔟) :
    ∃ ψ' : AssocGraded I, ψ' ∈ 𝔞 ∧
      ψ' ∈ Algebra.adjoin (A ⧸ I) (T : Set (AssocGraded I)) ∧
      ψ' ∈ AssocGraded.homogeneous I μ ∧ ψ - ψ' ∈ 𝔟 := by
  classical
  have hT1 : ∀ s ∈ (T : Set (AssocGraded I)), s ∈ AssocGraded.homogeneous I 1 :=
    fun s hs => hT.1 hs
  set W : Set (AssocGraded I) := {w | w ∈ 𝔞 ∧ w ∈ Algebra.adjoin (A ⧸ I) (T : Set (AssocGraded I))}
    with hW
  have hψW : ψ ∈ Ideal.span W := (hT.2 μ hμ ψ hψ).mp hψ𝔞
  obtain ⟨B, w', hB, hw', hw'e, hdec⟩ := AssocGraded.exists_proj_eq_add_of_mem_span I W
    (fun w hw d => ⟨h𝔞 w hw.1 d, AssocGraded.proj_mem_adjoin I hT1 hw.2 d⟩)
    ⟨zero_mem _, zero_mem _⟩
    (fun w hw w' hw' => ⟨add_mem hw.1 hw'.1, add_mem hw.2 hw'.2⟩)
    (fun c hc w hw => by
      obtain ⟨c₀, rfl⟩ := AssocGraded.exists_eq_algebraMap_of_mem_homogeneous_zero I hc
      exact ⟨Ideal.mul_mem_left _ _ hw.1, mul_mem (Subalgebra.algebraMap_mem _ _) hw.2⟩)
    hψW μ
  rw [AssocGraded.proj_of_mem_homogeneous I hψ] at hdec
  have hB𝔟 : B ∈ 𝔟 := by
    refine (Ideal.span_le.mpr ?_) hB
    rintro w ⟨hwW, d, hd, hwd⟩
    exact hlow d hd w hwW.1 hwd
  refine ⟨w', hw'.1, hw'.2, hw'e, ?_⟩
  have : ψ - w' = B := by rw [hdec]; ring
  rw [this]
  exact hB𝔟

end IdealProperty

section PureRing

variable (r s : ℕ) (k : Type*) [CommRing k]

/-- The substitution `X ↦ 0`, `X_j ↦ X_j`, `Y_b ↦ 0`, from `k[X, X₁, …, X_r, Y₁, …, Y_s]` to
`k[X₁, …, X_r]` (the polynomial ring of the proof of Lemma 15, p. 230). -/
noncomputable def pureProj : MvPolynomial (CoordIndex r s) k →ₐ[k] MvPolynomial (Fin r) k :=
  aeval fun v => match v with
    | some (Sum.inl j) => X j
    | _ => 0

/-- The inclusion `k[X₁, …, X_r] ⊆ k[X, X₁, …, X_r, Y₁, …, Y_s]`. -/
noncomputable def pureInclude : MvPolynomial (Fin r) k →ₐ[k] MvPolynomial (CoordIndex r s) k :=
  rename fun j => (some (Sum.inl j) : CoordIndex r s)

variable {r s k}

theorem pureProj_pureInclude (p : MvPolynomial (Fin r) k) :
    pureProj r s k (pureInclude r s k p) = p := by
  have : (pureProj r s k).comp (pureInclude r s k) = AlgHom.id k _ := by
    apply MvPolynomial.algHom_ext
    intro j
    simp [pureProj, pureInclude]
  exact AlgHom.congr_fun this p

theorem pureInclude_pureProj (p : MvPolynomial (CoordIndex r s) k) :
    pureInclude r s k (pureProj r s k p) = pureSubst k p := by
  have : (pureInclude r s k).comp (pureProj r s k) = pureSubst k := by
    apply MvPolynomial.algHom_ext
    intro v
    rcases v with _ | (j | b) <;> simp [pureProj, pureInclude, pureSubst, xWeight]
  exact AlgHom.congr_fun this p

theorem pureInclude_injective : Function.Injective (pureInclude r s k) :=
  rename_injective _ (fun a b h => by simpa using h)

theorem pureInclude_isHomogeneous {p : MvPolynomial (Fin r) k} {d : ℕ} (hp : p.IsHomogeneous d) :
    (pureInclude r s k p).IsHomogeneous d :=
  IsHomogeneous.rename_isHomogeneous hp

theorem isHomogeneous_of_pureInclude {p : MvPolynomial (Fin r) k} {d : ℕ}
    (hp : (pureInclude r s k p).IsHomogeneous d) : p.IsHomogeneous d := by
  exact (IsHomogeneous.rename_isHomogeneous_iff (fun a b h => by simpa using h)).mp hp

end PureRing

section PureRingCoord

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

/-- The inclusion `ι : k[X₁, …, X_r] → k[X, X₁, …, X_r, Y₁, …, Y_s] = gr_M(R)` (proof of Lemma 15,
p. 230: the polynomial ring `k[X₁, …, X_r]` inside `gr_M(R)`). -/
noncomputable def ι : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R) →ₐ[R ⧸ maximalIdeal R]
    AssocGraded (maximalIdeal R) :=
  C.e.comp (pureInclude C.r C.s (R ⧸ maximalIdeal R))

theorem ι_apply (p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) :
    C.ι p = C.e (pureInclude C.r C.s _ p) := rfl

theorem ι_injective : Function.Injective C.ι :=
  C.e_bijective.1.comp pureInclude_injective

theorem ι_mem_homogeneous {p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)} {d : ℕ}
    (hp : p.IsHomogeneous d) : C.ι p ∈ AssocGraded.homogeneous (maximalIdeal R) d :=
  C.e_mem_homogeneous (pureInclude_isHomogeneous hp)

theorem isHomogeneous_of_ι_mem {p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)} {d : ℕ}
    (hp : C.ι p ∈ AssocGraded.homogeneous (maximalIdeal R) d) : p.IsHomogeneous d := by
  obtain ⟨q, hq, hqp⟩ := C.exists_e_eq hp
  have : q = pureInclude C.r C.s _ p := C.e_bijective.1 (by rw [hqp]; rfl)
  exact isHomogeneous_of_pureInclude (this ▸ hq)

variable [IsRegularLocalRing T.ring]
  (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)

/-- The homomorphism `ρ : gr_{M₁}(R₁) → k[X₁, …, X_r]` of graded `k`-algebras with
`ρ(X) = ρ(Y_b) = 0` and `ρ(X̄_j) = X_j` (proof of Lemma 15, p. 231); `ι ∘ ρ₀ = ρ`
(`ι_ρ₀`), where `ρ` is `TransformCoord.ρ` with values in `gr_M(R)`. -/
noncomputable def ρ₀ : AssocGraded (maximalIdeal T.ring) →+*
    MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R) :=
  (pureProj C.r C.s (R ⧸ maximalIdeal R)).toRingHom.comp
    ((MvPolynomial.map (T.residueEquiv hrat).symm.toRingHom).comp
      (RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm.toRingHom)

theorem ι_ρ₀ (x : AssocGraded (maximalIdeal T.ring)) : C.ι (C.ρ₀ hrat x) = C.ρ hrat x := by
  obtain ⟨q, rfl⟩ := C.e₁_bijective.2 x
  rw [ρ_e₁]
  show C.e (pureInclude C.r C.s _ (pureProj C.r C.s _ (MvPolynomial.map _
    ((RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm
      (RingEquiv.ofBijective C.e₁ C.e₁_bijective q))))) = _
  rw [RingEquiv.symm_apply_apply, pureInclude_pureProj]

include hrat in
theorem ρ₀_mem_homogeneous {d : ℕ} {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ AssocGraded.homogeneous (maximalIdeal T.ring) d) : (C.ρ₀ hrat x).IsHomogeneous d :=
  C.isHomogeneous_of_ι_mem (by rw [ι_ρ₀]; exact C.ρ_mem_homogeneous hrat hx)

theorem ρ₀_algebraMap (c : T.ring ⧸ maximalIdeal T.ring) :
    C.ρ₀ hrat (algebraMap _ (AssocGraded (maximalIdeal T.ring)) c) =
      algebraMap _ _ ((T.residueEquiv hrat).symm c) := by
  apply C.ι_injective
  rw [ι_ρ₀, ρ_algebraMap, AlgHom.commutes]

/-- `ρ₀` maps `k₁[U]` into `k[ρ₀(U)]`. -/
theorem ρ₀_mem_adjoin (U : Submodule (T.ring ⧸ maximalIdeal T.ring) (AssocGraded (maximalIdeal T.ring)))
    {x : AssocGraded (maximalIdeal T.ring)}
    (hx : x ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring) (U : Set (AssocGraded (maximalIdeal T.ring)))) :
    C.ρ₀ hrat x ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R) (C.ρ₀ hrat '' (U : Set (AssocGraded (maximalIdeal T.ring)))) :
        Set (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))) := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy => exact Algebra.subset_adjoin (Submodule.subset_span ⟨y, hy, rfl⟩)
  | algebraMap c => rw [ρ₀_algebraMap]; exact Subalgebra.algebraMap_mem _ _
  | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
  | mul y z _ _ hy hz => rw [map_mul]; exact mul_mem hy hz

/-- The inclusion `k[X̄₁, …, X̄_r] ⊆ gr_{M₁}(R₁)` (`k = R₁/M₁` identified with `R/M`), a section of
`ρ₀`. -/
noncomputable def ι₁ : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R) →+*
    AssocGraded (maximalIdeal T.ring) :=
  C.e₁.toRingHom.comp ((MvPolynomial.map (T.residueEquiv hrat).toRingHom).comp
    (pureInclude C.r C.s (R ⧸ maximalIdeal R)).toRingHom)

theorem ρ₀_ι₁ (p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) : C.ρ₀ hrat (C.ι₁ hrat p) = p := by
  show (pureProj C.r C.s _) (MvPolynomial.map (T.residueEquiv hrat).symm.toRingHom
    ((RingEquiv.ofBijective C.e₁ C.e₁_bijective).symm
      (RingEquiv.ofBijective C.e₁ C.e₁_bijective
        (MvPolynomial.map (T.residueEquiv hrat).toRingHom (pureInclude C.r C.s _ p))))) = p
  rw [RingEquiv.symm_apply_apply, MvPolynomial.map_map]
  have : (T.residueEquiv hrat).symm.toRingHom.comp (T.residueEquiv hrat).toRingHom = RingHom.id _ := by
    ext x; simp
  rw [this, MvPolynomial.map_id, pureProj_pureInclude]

include hrat in
theorem ι₁_mem_homogeneous {p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)} {d : ℕ}
    (hp : p.IsHomogeneous d) : C.ι₁ hrat p ∈ AssocGraded.homogeneous (maximalIdeal T.ring) d :=
  C.e₁_mem_homogeneous ((pureInclude_isHomogeneous hp).map _)

end TransformCoord

end PureRingCoord

section P0Lemmas

attribute [local instance] Ideal.Quotient.field

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] [IsDomain R] {P : Ideal R}

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T)

theorem isTauSubmoduleOfIdeal_map_ι {n : ℕ}
    (Φ : Fin n → MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) {ν : Fin n → ℕ}
    (hΦ : ∀ s, (Φ s).IsHomogeneous (ν s)) {μ₀ : ℕ} (hν : ∀ s, ν s ≤ μ₀)
    {T₀ : Submodule (R ⧸ maximalIdeal R) (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))}
    (hT : IsTauSubmoduleMv (R ⧸ maximalIdeal R) C.r (Ideal.span (Set.range Φ)) T₀ μ₀) :
    IsTauSubmoduleOfIdeal (maximalIdeal R) (Ideal.span (Set.range fun s => C.ι (Φ s)))
      (T₀.map C.ι.toLinearMap) μ₀ := by
  refine ⟨?_, fun μ hμ ψ hψ => ⟨fun h => ?_, fun h => (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩
  · rintro _ ⟨p, hp, rfl⟩
    exact C.ι_mem_homogeneous ((mem_homogeneousSubmodule 1 p).mp (hT.1 hp))
  · have hgen : ∀ s, C.ι (Φ s) ∈ Ideal.span ((Ideal.span (Set.range fun s => C.ι (Φ s)) :
        Set (AssocGraded (maximalIdeal R))) ∩
        (Algebra.adjoin (R ⧸ maximalIdeal R) ((T₀.map C.ι.toLinearMap : Submodule _ _) :
          Set (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R)))) := by
      intro s
      have h1 := (hT.2 (ν s) (hν s) (Φ s) ((mem_homogeneousSubmodule _ _).mpr (hΦ s))).mp
        (Ideal.subset_span ⟨s, rfl⟩)
      have h2 := mem_span_image_of_mem_span C.ι h1
      refine (Ideal.span_mono ?_) h2
      rintro _ ⟨x, ⟨hx1, hx2⟩, rfl⟩
      refine ⟨?_, ?_⟩
      · have := mem_span_image_of_mem_span C.ι hx1
        rwa [← Set.range_comp] at this
      · have : Algebra.adjoin (R ⧸ maximalIdeal R) ((T₀.map C.ι.toLinearMap : Submodule _ _) :
            Set (AssocGraded (maximalIdeal R))) =
            (Algebra.adjoin (R ⧸ maximalIdeal R) (T₀ : Set _)).map C.ι := by
          rw [AlgHom.map_adjoin]; rfl
        rw [SetLike.mem_coe, this]
        exact Subalgebra.mem_map.mpr ⟨x, hx2, rfl⟩
    refine (Ideal.span_le.mpr ?_) h
    rintro _ ⟨s, rfl⟩
    exact hgen s

/-- The homomorphism `gr_M(R) = k[X, X₁, …, X_r, Y₁, …, Y_s] → k[X₁, …, X_r]` with `X, Y_b ↦ 0`
(the retraction of `ι`). -/
noncomputable def π₀ : AssocGraded (maximalIdeal R) →ₐ[R ⧸ maximalIdeal R]
    MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R) :=
  (pureProj C.r C.s (R ⧸ maximalIdeal R)).comp
    (AlgEquiv.ofBijective C.e C.e_bijective).symm.toAlgHom

theorem π₀_ι (p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) : C.π₀ (C.ι p) = p := by
  show pureProj C.r C.s _ ((AlgEquiv.ofBijective C.e C.e_bijective).symm
    (AlgEquiv.ofBijective C.e C.e_bijective (pureInclude C.r C.s _ p))) = p
  rw [AlgEquiv.symm_apply_apply, pureProj_pureInclude]

/-- The converse of `isTauSubmoduleOfIdeal_map_ι` (p. 230: "the above property of `T` is equivalent
to the following"): if `ι(T₀)` has the property for `I = (ι Φ_s) gr_M(R)` then `T₀` has it for
`I⁰ = (Φ_s) k[X₁, …, X_r]`. -/
theorem isTauSubmoduleMv_of_isTauSubmoduleOfIdeal_map_ι {n : ℕ}
    (Φ : Fin n → MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)) {μ₀ : ℕ}
    {T₀ : Submodule (R ⧸ maximalIdeal R) (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))}
    (hT : IsTauSubmoduleOfIdeal (maximalIdeal R) (Ideal.span (Set.range fun s => C.ι (Φ s)))
      (T₀.map C.ι.toLinearMap) μ₀) :
    IsTauSubmoduleMv (R ⧸ maximalIdeal R) C.r (Ideal.span (Set.range Φ)) T₀ μ₀ := by
  refine ⟨?_, fun μ hμ p hp => ⟨fun hpI => ?_, fun h => (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩
  · intro t ht
    exact (mem_homogeneousSubmodule 1 t).mpr
      (C.isHomogeneous_of_ι_mem (hT.1 (Submodule.mem_map_of_mem ht)))
  · have h1 : C.ι p ∈ Ideal.span (Set.range fun s => C.ι (Φ s)) := by
      have := mem_span_image_of_mem_span C.ι hpI
      rwa [← Set.range_comp] at this
    have h2 := mem_span_image_of_mem_span C.π₀
      ((hT.2 μ hμ (C.ι p) (C.ι_mem_homogeneous ((mem_homogeneousSubmodule _ _).mp hp))).mp h1)
    rw [π₀_ι] at h2
    refine (Ideal.span_mono ?_) h2
    rintro _ ⟨x, ⟨hx1, hx2⟩, rfl⟩
    refine ⟨?_, ?_⟩
    · have := mem_span_image_of_mem_span C.π₀ (SetLike.mem_coe.mp hx1)
      refine (Ideal.span_mono ?_) this
      rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
      exact ⟨s, (π₀_ι C _).symm⟩
    · have hmap : (Algebra.adjoin (R ⧸ maximalIdeal R)
          ((T₀.map C.ι.toLinearMap : Submodule _ _) : Set (AssocGraded (maximalIdeal R)))).map C.π₀ =
          Algebra.adjoin (R ⧸ maximalIdeal R) (T₀ : Set (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))) := by
        rw [AlgHom.map_adjoin]
        congr 1
        ext y
        constructor
        · rintro ⟨_, ⟨t, ht, rfl⟩, rfl⟩
          simpa [π₀_ι] using ht
        · intro hy
          exact ⟨C.ι y, ⟨y, hy, rfl⟩, π₀_ι C y⟩
      rw [SetLike.mem_coe, ← hmap]
      exact Subalgebra.mem_map.mpr ⟨x, hx2, rfl⟩

variable [IsRegularLocalRing T.ring]
  (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)

attribute [local instance] MvPolynomial.gradedAlgebra in
/-- The homogeneous component of degree `d` of `a x` with `a` homogeneous of degree `i`. -/
theorem homogeneousComponent_mul_of_mem_homogeneous {k σ : Type*} [CommRing k]
    {a : MvPolynomial σ k} {i : ℕ} (ha : a ∈ homogeneousSubmodule σ k i)
    (x : MvPolynomial σ k) (d : ℕ) :
    homogeneousComponent d (a * x) =
      if i ≤ d then a * homogeneousComponent (d - i) x else 0 := by
  have h := DirectSum.coe_decompose_mul_of_left_mem (𝒜 := homogeneousSubmodule σ k) (b := x) d ha
  rw [← decomposition.decompose'_apply, ← decomposition.decompose'_apply]
  exact h

include hrat in
/-- "`ρ(Ĩ) = I⁰`" in each degree (p. 231): a form `p` of degree `μ` in the ideal `I⁰` generated by
`Φ_s = ρ(ψ_s)` is `ρ(q)` for a form `q ∈ Ĩ` of degree `μ`. -/
theorem exists_mem_span_homogeneous_ρ₀_eq {n : ℕ}
    (Φ : Fin n → MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))
    (ψ : Fin n → AssocGraded (maximalIdeal T.ring)) {ν : Fin n → ℕ}
    (hΦψ : ∀ s, C.ρ₀ hrat (ψ s) = Φ s) (hψ : ∀ s, ψ s ∈ AssocGraded.homogeneous _ (ν s))
    (hΦ : ∀ s, (Φ s).IsHomogeneous (ν s)) {μ : ℕ} {p : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)}
    (hp : p.IsHomogeneous μ) (hpI : p ∈ Ideal.span (Set.range Φ)) :
    ∃ q ∈ Ideal.span (Set.range ψ), q ∈ AssocGraded.homogeneous _ μ ∧ C.ρ₀ hrat q = p := by
  classical
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hpI
  refine ⟨∑ s, if ν s ≤ μ then C.ι₁ hrat (homogeneousComponent (μ - ν s) (c s)) * ψ s else 0,
    sum_mem fun s _ => ?_, sum_mem fun s _ => ?_, ?_⟩
  · split_ifs
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨s, rfl⟩)
    · exact zero_mem _
  · split_ifs with hs
    · have := AssocGraded.mul_mem_homogeneous (maximalIdeal T.ring)
        (C.ι₁_mem_homogeneous hrat (homogeneousComponent_isHomogeneous (μ - ν s) (c s))) (hψ s)
      rwa [Nat.sub_add_cancel hs] at this
    · exact zero_mem _
  · rw [map_sum]
    have h1 : ∀ s, C.ρ₀ hrat (if ν s ≤ μ then C.ι₁ hrat (homogeneousComponent (μ - ν s) (c s)) * ψ s
        else 0) = homogeneousComponent μ (c s * Φ s) := by
      intro s
      rw [mul_comm (c s) (Φ s), homogeneousComponent_mul_of_mem_homogeneous ((mem_homogeneousSubmodule _ _).mpr (hΦ s))]
      split_ifs
      · rw [map_mul, ρ₀_ι₁, hΦψ]; ring
      · exact map_zero _
    simp only [h1]
    rw [← map_sum, hc, homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).mpr hp)]
    simp

include hrat in
/-- **Applying `ρ` to (v)** (p. 231: "Therefore, applying `ρ` to the both sides of the equality (v)
obtained above, we get `I⁰_μ ⊆ k[X₁, …, X_r]_μ ∩ (I⁰ ∩ k[ρ(T̃)]) k[X₁, …, X_r]`, and hence
`I⁰_μ = k[X₁, …, X_r]_μ ∩ (I⁰ ∩ k[ρ(T̃)]) k[X₁, …, X_r]` for all `μ ≤ μ̄`"): if `T̃` has the property
(v) for `Ĩ = (ψ_s)`, and `ρ(ψ_s) = Φ_s`, then the `k`-module `ρ(T̃)` has the property for the
ideal `I⁰ = (Φ_s)` of `k[X₁, …, X_r]`. -/
theorem isTauSubmoduleMv_span_ρ₀ {n : ℕ}
    (Φ : Fin n → MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R))
    (ψ : Fin n → AssocGraded (maximalIdeal T.ring)) {ν : Fin n → ℕ}
    (hΦψ : ∀ s, C.ρ₀ hrat (ψ s) = Φ s) (hψ : ∀ s, ψ s ∈ AssocGraded.homogeneous _ (ν s))
    (hΦ : ∀ s, (Φ s).IsHomogeneous (ν s)) {μ₀ : ℕ}
    {Ut : Submodule (T.ring ⧸ maximalIdeal T.ring) (AssocGraded (maximalIdeal T.ring))}
    (hv : IsTauSubmoduleOfIdeal (maximalIdeal T.ring) (Ideal.span (Set.range ψ)) Ut μ₀) :
    IsTauSubmoduleMv (R ⧸ maximalIdeal R) C.r (Ideal.span (Set.range Φ))
      (Submodule.span (R ⧸ maximalIdeal R) (C.ρ₀ hrat '' (Ut : Set (AssocGraded (maximalIdeal T.ring)))))
      μ₀ := by
  refine ⟨Submodule.span_le.mpr ?_, fun μ hμ p hp => ⟨fun hpI => ?_,
    fun h => (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩
  · rintro _ ⟨y, hy, rfl⟩
    exact (mem_homogeneousSubmodule 1 _).mpr (C.ρ₀_mem_homogeneous hrat (hv.1 hy))
  · obtain ⟨q, hqI, hqμ, hqp⟩ := C.exists_mem_span_homogeneous_ρ₀_eq hrat Φ ψ hΦψ hψ hΦ
      ((mem_homogeneousSubmodule _ _).mp hp) hpI
    have h1 := mem_span_image_of_mem_span (C.ρ₀ hrat) ((hv.2 μ hμ q hqμ).mp hqI)
    rw [hqp] at h1
    refine (Ideal.span_mono ?_) h1
    rintro _ ⟨x, ⟨hx1, hx2⟩, rfl⟩
    refine ⟨?_, C.ρ₀_mem_adjoin hrat Ut hx2⟩
    have := mem_span_image_of_mem_span (C.ρ₀ hrat) hx1
    rwa [← Set.range_comp, show (C.ρ₀ hrat) ∘ ψ = Φ from funext hΦψ] at this

end TransformCoord

/-- Any ideal `I⁰` has the property of Definition 6, up to any degree, for the whole linear
part `k[X₁, …, X_r]₁` (as `k[k[X₁, …, X_r]₁] = k[X₁, …, X_r]`). -/
theorem isTauSubmoduleMv_homogeneousSubmodule_one {k : Type u} [Field k] {n : ℕ}
    (I : Ideal (MvPolynomial (Fin n) k)) (μ₀ : ℕ) :
    IsTauSubmoduleMv k n I (homogeneousSubmodule (Fin n) k 1) μ₀ := by
  have hadj : ∀ p : MvPolynomial (Fin n) k,
      p ∈ Algebra.adjoin k ((homogeneousSubmodule (Fin n) k 1 : Submodule k _) : Set (MvPolynomial (Fin n) k)) := by
    intro p
    have : Algebra.adjoin k (Set.range (X : Fin n → MvPolynomial (Fin n) k)) ≤
        Algebra.adjoin k ((homogeneousSubmodule (Fin n) k 1 : Submodule k _) : Set (MvPolynomial (Fin n) k)) :=
      Algebra.adjoin_mono (by
        rintro _ ⟨j, rfl⟩
        exact (mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X k j))
    rw [MvPolynomial.adjoin_range_X] at this
    exact this (Algebra.mem_top)
  refine ⟨le_rfl, fun μ hμ ψ hψ => ⟨fun h => Ideal.subset_span ⟨h, hadj ψ⟩,
    fun h => (Ideal.span_le.mpr fun x hx => hx.1) h⟩⟩

namespace TransformCoord

variable {T : MonoidalTransform R P} (C : TransformCoord T) [IsRegularLocalRing T.ring]
  (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)

include hrat in
/-- `rank ρ(T̃) ≤ rank T̃` (p. 231: "`rank of ρ(T̃) ≤ rank T̃`"): `ρ` is semilinear over the residue
field isomorphism, so the image of a basis of `T̃` spans `ρ(T̃)`. -/
theorem finrank_span_ρ_le
    (U : Submodule (T.ring ⧸ maximalIdeal T.ring) (AssocGraded (maximalIdeal T.ring)))
    [FiniteDimensional (T.ring ⧸ maximalIdeal T.ring) U] :
    FiniteDimensional (R ⧸ maximalIdeal R)
        (Submodule.span (R ⧸ maximalIdeal R) (C.ρ hrat '' (U : Set (AssocGraded (maximalIdeal T.ring))))) ∧
      Module.finrank (R ⧸ maximalIdeal R)
        (Submodule.span (R ⧸ maximalIdeal R) (C.ρ hrat '' (U : Set (AssocGraded (maximalIdeal T.ring))))) ≤
        Module.finrank (T.ring ⧸ maximalIdeal T.ring) U := by
  classical
  let b := Module.finBasis (T.ring ⧸ maximalIdeal T.ring) U
  have hsub : Submodule.span (R ⧸ maximalIdeal R) (C.ρ hrat '' (U : Set (AssocGraded (maximalIdeal T.ring)))) ≤
      Submodule.span (R ⧸ maximalIdeal R)
        (Set.range fun l => C.ρ hrat (b l : AssocGraded (maximalIdeal T.ring))) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨y, hy, rfl⟩
    have hy' : y = ∑ l, (b.repr ⟨y, hy⟩ l) • (b l : AssocGraded (maximalIdeal T.ring)) := by
      have := congrArg Subtype.val (b.sum_repr ⟨y, hy⟩)
      rw [Submodule.coe_sum] at this
      simp only [Submodule.coe_smul] at this
      exact this.symm
    rw [SetLike.mem_coe, hy', map_sum]
    refine sum_mem fun l _ => ?_
    rw [ρ_smul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
  have hfin : FiniteDimensional (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R)
        (Set.range fun l => C.ρ hrat (b l : AssocGraded (maximalIdeal T.ring)))) :=
    FiniteDimensional.span_of_finite _ (Set.finite_range _)
  refine ⟨Submodule.finiteDimensional_of_le hsub, (Submodule.finrank_mono hsub).trans ?_⟩
  exact (finrank_range_le_card (R := R ⧸ maximalIdeal R)
    (fun l => C.ρ hrat (b l : AssocGraded (maximalIdeal T.ring)))).trans_eq (Fintype.card_fin _)

end TransformCoord

/-- **The proof of Lemma 15 (pp. 230–231): `T_a ⊆ ρ(T̃_a)`.**  In the situation of Lemma 15 (the
data `g`, `h`, `ν`, `μb = μ̄` of Lemma 14, with `ν_j > μ̄` for `j > i`, and `μ^{(a)}(J) =
μ^{(a)}(J₁) = μ̄`), the smallest `k`-submodule `T_a = tauSubmodule R J a` of `gr¹_M(R)` with the
property of Definition 6 (i) lies in the linear part of `k[X₁, …, X_r]` (embedded by `ι`) and
(ii) lies in the `k`-span of `ρ(T̃_a)`, where `T̃_a` is the smallest such submodule for `J₁`.  The
second statement is "the `k`-module `ρ(T̃)` must contain the previous `k`-module `T`" (p. 231); it is
the inclusion `T_b ⊆ ρ(T̃_b)` quoted at the beginning of the proof of Lemma 16.  The steps are the
printed ones, in order (see the comments in the proof): `I`, the smallest `T` for `I`, the linear part,
`I⁰` and the equivalent property in `k[X₁, …, X_r]`, `T̃` and (v), `ρ` applied to (v), minimality. -/
theorem TransformCoord.tauSubmodule_le_span_ρ (R : Type u) [CommRing R] [IsRegularLocalRing R]
    [IsDomain R] (P : Ideal R) (J : Ideal R) (T : MonoidalTransform R P)
    [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (C : TransformCoord T)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) (i : ℕ+) (him : (i : ℕ) ≤ m)
    (ν : Fin m → ℕ) (hgM : ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j)
    (h : Fin (i : ℕ) → T.ring)
    (hgh : ∀ j : Fin (i : ℕ), C.x₁ ^ ν (Fin.castLE him j) * h j = T.toRing (g (Fin.castLE him j)))
    (hhν : ∀ j : Fin (i : ℕ),
      Ideal.ordElem (maximalIdeal T.ring) (h j) = (ν (Fin.castLE him j) : ℕ∞))
    (hext : ExtendsToStandardBase (strictTransformIdeal T J) h) (μb : ℕ)
    (hνle : ∀ s : Fin (i : ℕ), ν (Fin.castLE him s) ≤ μb) (s₀ : Fin (i : ℕ))
    (hs₀ : ν (Fin.castLE him s₀) = μb) (hνgt : ∀ j : Fin m, (i : ℕ) ≤ j → μb < ν j)
    (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t R J) (hat₁ : a ≤ t T.ring (strictTransformIdeal T J))
    (hμ : mu R J a = μb) (hμ₁ : mu T.ring (strictTransformIdeal T J) a = μb) :
    tauSubmodule R J a ≤ (homogeneousSubmodule (Fin C.r) (R ⧸ maximalIdeal R) 1).map C.ι.toLinearMap ∧
    tauSubmodule R J a ≤ Submodule.span (R ⧸ maximalIdeal R)
      (C.ρ hrat '' (tauSubmodule T.ring (strictTransformIdeal T J) a :
        Set (AssocGraded (maximalIdeal T.ring)))) := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  -- the initial forms `φ_s` of `f_s` and `ψ_s` of `g_s`
  set φ : Fin (i : ℕ) → AssocGraded (maximalIdeal R) :=
    fun s => initialForm (maximalIdeal R) (g (Fin.castLE him s)) with hφ
  set ψ : Fin (i : ℕ) → AssocGraded (maximalIdeal T.ring) :=
    fun s => initialForm (maximalIdeal T.ring) (h s) with hψ
  have hψdeg : ∀ s, ψ s ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν (Fin.castLE him s)) := by
    intro s
    show initialForm _ (h s) ∈ _
    rw [initialForm_eq_mk _ (hhν s)]
    exact AssocGraded.mk_mem_homogeneous _ _
  have hρψ : ∀ s, C.ρ hrat (ψ s) = φ s := fun s =>
    ((C.ordElem_le_and_rho_initialForm_eq hrat _ _ (hgM _) (h s) (hgh s)).2 (hhν s)).2
  -- "`φ₁, …, φ_i` are forms only in `X₁, …, X_r`": `φ_s = ι(Φ_s)` with `Φ_s = ρ(ψ_s) ∈ k[X₁, …, X_r]`
  set Φ : Fin (i : ℕ) → MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R) :=
    fun s => C.ρ₀ hrat (ψ s) with hΦ
  have hιΦ : ∀ s, C.ι (Φ s) = φ s := fun s => by
    show C.ι (C.ρ₀ hrat (ψ s)) = _
    rw [ι_ρ₀, hρψ]
  have hΦdeg : ∀ s, (Φ s).IsHomogeneous (ν (Fin.castLE him s)) := fun s =>
    C.ρ₀_mem_homogeneous hrat (hψdeg s)
  have hrangeΦ : (Set.range fun s => C.ι (Φ s)) = Set.range φ := by
    congr 1; funext s; exact hιΦ s
  -- the ideal `I = (φ₁, …, φ_i) gr_M(R)`
  set I : Ideal (AssocGraded (maximalIdeal R)) := Ideal.span (Set.range φ) with hI
  have hIle : I ≤ grIdeal (maximalIdeal R) J := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨s, rfl⟩
    exact Ideal.subset_span ⟨g (Fin.castLE him s), hg.1 _, rfl⟩
  obtain ⟨dg, hdg, -⟩ := hg.2.2.1
  have hdgν : ∀ j, dg j = ν j := fun j => by
    have := (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J g hg dg hdg j).symm.trans
      (hgM j)
    exact_mod_cast this
  -- "By (i), the above selection of the integer `i` implies that
  -- `gr^μ_M(J, R) = gr^μ_M(R) ∩ (φ₁, …, φ_i) gr_M(R)` for all `μ ≤ μ̄`"
  have hJI : ∀ d ≤ μb, ∀ w ∈ grIdeal (maximalIdeal R) J,
      w ∈ AssocGraded.homogeneous (maximalIdeal R) d → w ∈ I := by
    intro d hd w hwJ hwd
    rw [hg.2.2.2.1] at hwJ
    obtain ⟨c, -, hc0, hcsum⟩ := AssocGraded.exists_homogeneous_coeffs_of_mem_span _ _ dg hdg hwd hwJ
    rw [hcsum]
    refine sum_mem fun t _ => ?_
    by_cases ht : (t : ℕ) < (i : ℕ)
    · refine Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨t, ht⟩, ?_⟩)
      simp only [hφ]
      rw [show Fin.castLE him ⟨t, ht⟩ = t from Fin.ext rfl]
    · rw [hc0 t (by rw [hdgν]; have := hνgt t (by omega); omega), zero_mul]
      exact zero_mem _
  -- "`τ^{(a)}(J)` is the rank of the smallest `k`-submodule `T` of `gr¹_M(R)` such that
  -- `I_μ = gr^μ_M(R) ∩ (I ∩ k[T]) gr_M(R)` for all `μ ≤ μ̄`": `T_a` has this property ...
  have hTI : IsTauSubmoduleOfIdeal (maximalIdeal R) I (tauSubmodule R J a) μb := by
    have h1 := (tauSubmodule_spec R J a ha hat).1
    rw [hμ] at h1
    exact IsTauSubmoduleOfIdeal.of_forall_lt_mem
      (fun w hw e => AssocGraded.proj_mem_grIdeal _ _ hw e) hIle (fun d hd => hJI d hd.le) h1
  -- ... and is contained in every `T` with this property (`T_a` is the smallest `T` with the
  -- property of Definition 6 for `gr_M(J, R)`)
  have hsmall : ∀ T' : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)),
      IsTauSubmoduleOfIdeal (maximalIdeal R) I T' μb → tauSubmodule R J a ≤ T' := by
    intro T' hT'
    refine tauSubmodule_le R J a T' ?_
    rw [hμ]
    exact IsTauSubmoduleOfIdeal.of_forall_le_mem hIle hJI hT'
  have hΦν : ∀ s, ν (Fin.castLE him s) ≤ μb := hνle
  -- "Since `φ₁, …, φ_i` are all forms only in `X₁, …, X_r`, the above smallest `k`-submodule `T` with
  -- the property must be contained in the linear homogeneous part of `k[X₁, …, X_r]`."
  have hlin : tauSubmodule R J a ≤
      (homogeneousSubmodule (Fin C.r) (R ⧸ maximalIdeal R) 1).map C.ι.toLinearMap := by
    refine hsmall _ ?_
    have := C.isTauSubmoduleOfIdeal_map_ι Φ hΦdeg hΦν
      (isTauSubmoduleMv_homogeneousSubmodule_one (Ideal.span (Set.range Φ)) μb)
    rwa [hrangeΦ] at this
  refine ⟨hlin, ?_⟩
  -- "Therefore, if `I⁰` denotes the homogeneous ideal in `k[X₁, …, X_r]` generated by `φ₁, …, φ_i`,
  -- then the above property of `T` is equivalent to the following: `I⁰_μ = k[X₁, …, X_r]_μ ∩
  -- (I⁰ ∩ k[T]) k[X₁, …, X_r]` for all `μ ≤ μ̄`.  Thus `τ^{(a)}(J)` is the rank of the smallest
  -- `k`-submodule `T` of `k[X₁, …, X_r]₁` having this property."
  set T₀ := (tauSubmodule R J a).comap C.ι.toLinearMap with hT₀
  have hmapT₀ : T₀.map C.ι.toLinearMap = tauSubmodule R J a :=
    Submodule.map_comap_eq_self (hlin.trans LinearMap.map_le_range)
  have hP0T₀ : IsTauSubmoduleMv (R ⧸ maximalIdeal R) C.r (Ideal.span (Set.range Φ)) T₀ μb := by
    refine C.isTauSubmoduleMv_of_isTauSubmoduleOfIdeal_map_ι Φ ?_
    rw [hrangeΦ, hmapT₀]
    exact hTI
  have hmin₀ : ∀ T₀' : Submodule (R ⧸ maximalIdeal R) (MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R)),
      IsTauSubmoduleMv (R ⧸ maximalIdeal R) C.r (Ideal.span (Set.range Φ)) T₀' μb → T₀ ≤ T₀' := by
    intro T₀' hT₀'
    have hm := C.isTauSubmoduleOfIdeal_map_ι Φ hΦdeg hΦν hT₀'
    rw [hrangeΦ] at hm
    calc T₀ ≤ ((T₀'.map C.ι.toLinearMap)).comap C.ι.toLinearMap := Submodule.comap_mono (hsmall _ hm)
      _ = T₀' := Submodule.comap_map_eq_of_injective C.ι_injective T₀'
  -- the smallest `T̃` for `J₁`
  obtain ⟨hTt, -, -⟩ := tauSubmodule_spec T.ring J₁ a ha hat₁
  rw [hμ₁] at hTt
  set Ut := tauSubmodule T.ring J₁ a with hUt
  -- (v) "`Ĩ_μ = gr^μ_{M₁}(R₁) ∩ (Ĩ ∩ k[T̃]) gr_{M₁}(R₁)` for all `μ ≤ μ̄`"
  have hhJ₁ : ∀ s, h s ∈ J₁ := by
    intro s
    obtain ⟨m', G, him', hG, hGh⟩ := hext
    rw [← hGh s]; exact hG.1 _
  have hv : IsTauSubmoduleOfIdeal (maximalIdeal T.ring) (Ideal.span (Set.range ψ)) Ut μb := by
    refine IsTauSubmoduleOfIdeal.of_forall_lt_mem
      (𝔞 := grIdeal (maximalIdeal T.ring) J₁)
      (fun w hw e => AssocGraded.proj_mem_grIdeal _ _ hw e) ?_ ?_ hTt
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨s, rfl⟩
      exact Ideal.subset_span ⟨h s, hhJ₁ s, rfl⟩
    · intro d hd w hwJ hwd
      exact mem_span_initialForm_of_extendsToStandardBase_of_lt_ordElem J₁ h hext μb s₀
        (by rw [hhν, hs₀]) hwJ hwd hd
  -- "applying `ρ` to the both sides of the equality (v)": `ρ(T̃)` has the property for `I⁰`
  have hP0 := C.isTauSubmoduleMv_span_ρ₀ hrat Φ ψ (fun s => rfl) hψdeg hΦdeg hv
  -- "Therefore the `k`-module `ρ(T̃)` must contain the previous `k`-module `T`."
  calc tauSubmodule R J a = T₀.map C.ι.toLinearMap := hmapT₀.symm
    _ ≤ (Submodule.span (R ⧸ maximalIdeal R) (C.ρ₀ hrat '' (Ut : Set (AssocGraded (maximalIdeal T.ring))))).map
        C.ι.toLinearMap := Submodule.map_mono (hmin₀ _ hP0)
    _ = Submodule.span (R ⧸ maximalIdeal R) (C.ρ hrat '' (Ut : Set (AssocGraded (maximalIdeal T.ring)))) := by
      rw [Submodule.map_span, Set.image_image]
      congr 1
      exact Set.image_congr fun y _ => ι_ρ₀ C hrat y

end P0Lemmas

section LemmaT

/-- If `ν*(J)` and `ν*(J')` agree up to the largest index `i` with `ν^{(i)}(J) = μ^{(a)}(J)`, then
`a ≤ t(J')`, so `μ^{(a)}(J')` is a genuine member of `μ*(J')` (`mu_eq_of_nuI_eq`). -/
theorem le_t_of_nuI_eq {S S' : Type u} [CommRing S] [IsRegularLocalRing S] [CommRing S']
    [IsRegularLocalRing S'] (J : Ideal S) (J' : Ideal S') (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t S J)
    (i : ℕ+) (hi : IsGreatest {k : ℕ+ | nuI S J k = (mu S J a : ℕ∞)} i)
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) → nuI S J j = nuI S' J' j) : a ≤ t S' J' := by
  classical
  by_contra hlt
  push Not at hlt
  have hfin' := (muSet_finite S' J').1
  have hcard' : (muSet S' J').ncard ≤ a - 1 := by
    have : t S' J' = (muSet S' J').ncard := rfl
    omega
  have h0 : mu S' J' a = 0 := by
    rw [mu]
    exact Nat.nth_of_card_le hfin' ((Set.ncard_eq_toFinset_card _ hfin').symm.le.trans hcard')
  have hμ := mu_eq_of_nuI_eq J J' a ha hat i hi heq
  have hμ0 : mu S J a = 0 := hμ ▸ h0
  -- `a = 1`
  have ha1 : a = 1 := by
    by_contra hne
    have hfin := (muSet_finite S J).1
    have hcard : a - 1 < hfin.toFinset.card := by
      rw [← Set.ncard_eq_toFinset_card _ hfin]
      have : t S J = (muSet S J).ncard := rfl
      omega
    have hcard0 : 0 < hfin.toFinset.card := by omega
    have hlt1 : mu S J 1 < mu S J a := Nat.nth_strictMonoOn hfin
      (by simp only [Set.mem_Iio]; exact hcard0)
      (by simp only [Set.mem_Iio]; exact hcard) (show 1 - 1 < a - 1 by omega)
    omega
  -- `μ^{(1)}(J') = 0 = ν^{(i)}(J')` lies in `μ*(J')`, so `t(J') ≥ 1`
  have hmem : mu S J a ∈ muSet S' J' := ⟨i, (heq i le_rfl).symm.trans hi.1⟩
  have hpos : 0 < (muSet S' J').ncard := Set.ncard_pos hfin' |>.mpr ⟨_, hmem⟩
  have : t S' J' = (muSet S' J').ncard := rfl
  omega

end LemmaT

section Lemma15Proof

/-- If `i` and `i_b` are the largest indices with `ν^{(i)}(J) = μ^{(a)}(J)` and
`ν^{(i_b)}(J) = μ^{(b)}(J)`, and `b ≤ a ≤ t(J)`, then `i_b ≤ i`. -/
theorem le_of_isGreatest_nuI_eq_mu_of_le {S : Type u} [CommRing S] [IsRegularLocalRing S]
    (J : Ideal S) {a b : ℕ} (hb : 1 ≤ b) (hba : b ≤ a) (hat : a ≤ t S J) {i ib : ℕ+}
    (hi : IsGreatest {k : ℕ+ | nuI S J k = (mu S J a : ℕ∞)} i)
    (hib : IsGreatest {k : ℕ+ | nuI S J k = (mu S J b : ℕ∞)} ib) : ib ≤ i := by
  classical
  rcases hba.lt_or_eq with hlt | rfl
  · have hfin := (muSet_finite S J).1
    have hcard : a - 1 < hfin.toFinset.card := by
      rw [← Set.ncard_eq_toFinset_card _ hfin]
      have : t S J = (muSet S J).ncard := rfl
      omega
    have hmu : mu S J b < mu S J a :=
      Nat.nth_strictMonoOn hfin
        (by simp only [Set.mem_Iio]; exact lt_of_le_of_lt (Nat.sub_le_sub_right hba 1) hcard)
        (by simp only [Set.mem_Iio]; exact hcard) (by omega)
    by_contra hgt
    have h1 : nuI S J i ≤ nuI S J ib := nuI_mono J (le_of_lt (not_le.mp hgt))
    rw [hi.1, hib.1, Nat.cast_le] at h1
    omega
  · exact hi.2 hib.1

/-- `T_a` is finite-dimensional. -/
theorem finiteDimensional_tauSubmodule {S : Type u} [CommRing S] [IsRegularLocalRing S]
    (J : Ideal S) (a : ℕ) :
    Module.Finite (S ⧸ maximalIdeal S) (tauSubmodule S J a) := by
  let _ : Field (S ⧸ maximalIdeal S) := Ideal.Quotient.field _
  obtain ⟨W, -, hW⟩ := tau_spec S J a
  have : FiniteDimensional (S ⧸ maximalIdeal S) (Submodule.span (S ⧸ maximalIdeal S) (Set.range W)) :=
    FiniteDimensional.span_of_finite _ (Set.finite_range _)
  exact Submodule.finiteDimensional_of_le (tauSubmodule_le S J a _ hW)

/-- `ρ` of the span of a family is spanned by the `ρ` of the family. -/
theorem TransformCoord.span_ρ_image_span {R : Type u} [CommRing R] [IsRegularLocalRing R]
    [IsDomain R] {P : Ideal R} {T : MonoidalTransform R P} (C : TransformCoord T)
    [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) {τ : ℕ}
    (W : Fin τ → AssocGraded (maximalIdeal T.ring)) :
    Submodule.span (R ⧸ maximalIdeal R) (C.ρ hrat ''
      (Submodule.span (T.ring ⧸ maximalIdeal T.ring) (Set.range W) :
        Set (AssocGraded (maximalIdeal T.ring)))) =
    Submodule.span (R ⧸ maximalIdeal R) (Set.range fun l => C.ρ hrat (W l)) := by
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨y, hy, rfl⟩
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l, rfl⟩ := hy
      exact Submodule.subset_span ⟨l, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul c y _ hy => rw [TransformCoord.ρ_smul]; exact Submodule.smul_mem _ _ hy
  · refine Submodule.span_mono ?_
    rintro _ ⟨l, rfl⟩
    exact ⟨W l, Submodule.subset_span ⟨l, rfl⟩, rfl⟩

/-- **`T_b ⊆ ρ(T̃_b)` (pp. 230–231, Lemma 15)**, with the data of the proof given explicitly: `g` is a
standard base of `J` with `ν_j = ν^{(j)}(J)`, `i` the largest index with `ν^{(i)}(J) = μ^{(a)}(J)`,
and `h_j = x^{-ν_j} g_j` (`j ≤ i`) are the elements of `R₁` of Lemma 14 which extend to a standard base of
`J₁` (the hypotheses (iii) and (iv) of the proofs of Lemmas 15 and 16).  Then the smallest
`k`-submodule `T_a` of `gr¹_M(R)` with the property of Definition 6 lies in `ρ(T̃_a)`, `T̃_a` the smallest one
for `J₁` ("the `k`-module `ρ(T̃)` must contain the previous `k`-module `T`", p. 231).  This is the
core of the proof of Lemma 15 (`tau_le_tau_strictTransform_of_isGreatest_mu`); Lemma 16 (p. 232: "Then,
as was seen near the end of the proof of Lemma 15, we have `T_b ⊆ ρ(T̃_b)`") applies it to every `b ≤ a`. -/
theorem TransformCoord.tauSubmodule_le_span_ρ_of_isGreatest (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [IsDomain R] (P : Ideal R) (J : Ideal R) (T : MonoidalTransform R P) [IsRegularLocalRing T.ring]
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing) (C : TransformCoord T)
    {m : ℕ} (g : Fin m → R) (hg : IsStandardBase R J g) (ν : Fin m → ℕ)
    (hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat))
    (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t R J)
    (i : ℕ+) (hi : IsGreatest {k : ℕ+ | nuI R J k = (mu R J a : ℕ∞)} i) (him : (i : ℕ) ≤ m)
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) →
      nuI R J j = nuI T.ring (strictTransformIdeal T J) j)
    (h : Fin (i : ℕ) → T.ring)
    (hgh : ∀ j : Fin (i : ℕ), C.x₁ ^ ν (Fin.castLE him j) * h j = T.toRing (g (Fin.castLE him j)))
    (hhν : ∀ j : Fin (i : ℕ),
      Ideal.ordElem (maximalIdeal T.ring) (h j) = (ν (Fin.castLE him j) : ℕ∞))
    (hext : ExtendsToStandardBase (strictTransformIdeal T J) h) :
    tauSubmodule R J a ≤ (homogeneousSubmodule (Fin C.r) (R ⧸ maximalIdeal R) 1).map C.ι.toLinearMap ∧
    tauSubmodule R J a ≤ Submodule.span (R ⧸ maximalIdeal R)
      (C.ρ hrat '' (tauSubmodule T.ring (strictTransformIdeal T J) a :
        Set (AssocGraded (maximalIdeal T.ring)))) := by
  classical
  set J₁ := strictTransformIdeal T J with hJ₁
  set μb := mu R J a with hμb
  have hgM : ∀ j, Ideal.ordElem (maximalIdeal R) (g j) = ν j := fun j =>
    (ordElem_eq_nuI_of_isStandardBase J g hg j).trans (hν j).symm
  obtain ⟨dg, hdg, hmonog⟩ := hg.2.2.1
  have hdgν : ∀ j, dg j = ν j := fun j => by
    have := (ordElem_eq_of_isStandardBase_of_initialForm_mem_homogeneous J g hg dg hdg j).symm.trans (hgM j)
    exact_mod_cast this
  -- `ν_j > μ̄` for `j ≥ i`
  have hνgt : ∀ j : Fin m, (i : ℕ) ≤ j → μb < ν j := by
    intro j hj
    have h1 : nuI R J i ≤ nuI R J (j : ℕ).succPNat :=
      nuI_mono J (by rw [← PNat.coe_le_coe]; simp; omega)
    have h2 : nuI R J i = μb := hi.1
    rw [h2, ← hν j, Nat.cast_le] at h1
    rcases h1.lt_or_eq with h3 | h3
    · exact h3
    · exfalso
      have := hi.2 (show (j : ℕ).succPNat ∈ {k : ℕ+ | nuI R J k = (μb : ℕ∞)} by
        simp only [Set.mem_ofPred_eq]; rw [← hν j, h3])
      rw [← PNat.coe_le_coe] at this
      simp at this
      omega
  have hi1 : (i : ℕ) - 1 < (i : ℕ) := by have := i.pos; omega
  have hνi : ν (Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩) = μb := by
    have h1 := hν (Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩)
    have h2 : ((Fin.castLE him ⟨(i : ℕ) - 1, hi1⟩ : Fin m) : ℕ).succPNat = i := by
      apply PNat.eq; simp; have := i.pos; omega
    rw [h2, hi.1] at h1
    exact_mod_cast h1
  have hmu : mu T.ring J₁ a = μb := mu_eq_of_nuI_eq J J₁ a ha hat i hi heq
  have hat₁ : a ≤ t T.ring J₁ := le_t_of_nuI_eq J J₁ a ha hat i hi heq
  have hνle : ∀ s : Fin (i : ℕ), ν (Fin.castLE him s) ≤ μb := fun s => by
    rw [← hνi, ← hdgν, ← hdgν]
    exact hmonog (Fin.le_def.mpr (by simp; omega))
  exact (TransformCoord.tauSubmodule_le_span_ρ R P J T hrat C g hg i him ν hgM h hgh hhν
    hext μb hνle ⟨(i : ℕ) - 1, hi1⟩ hνi hνgt a ha hat hat₁ rfl hmu)

/-- The core of Lemma 15 (pp. 230–231): `τ^{(a)}(J) ≤ τ^{(a)}(J₁)`. -/
theorem tau_le_tau_strictTransform_of_isGreatest_mu (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R]
    (P : Ideal R) [P.IsPrime] [IsRegularLocalRing (R ⧸ P)] (J : Ideal R) (hJP : J ≤ P)
    (T : MonoidalTransform R P)
    (hrat : RingHom.IsResiduallyRational (R := R) (R' := T.ring) T.toRing)
    {m : ℕ} (f : Fin m → R) (a : ℕ) (ha : 1 ≤ a) (hat : a ≤ t R J)
    (h₁ : IsStandardBase R J f)
    (i : ℕ+) (hi : IsGreatest {k : ℕ+ | nuI R J k = (mu R J a : ℕ∞)} i)
    (h₂ : ∀ j : Fin m, (j : ℕ) < (i : ℕ) →
      Ideal.ordElem P (f j) = nuI R J ((j : ℕ).succPNat))
    (heq : ∀ j : ℕ+, (j : ℕ) ≤ (i : ℕ) →
      nuI R J j = nuI T.ring (strictTransformIdeal T J) j) :
    tau R J a ≤ tau T.ring (strictTransformIdeal T J) a := by
  classical
  obtain ⟨C⟩ := TransformCoord.nonempty T hrat
  set J₁ := strictTransformIdeal T J with hJ₁
  set μb := mu R J a with hμb
  -- the characters `ν_j = ν^{(j)}(J)`
  have hftop : ∀ j : Fin m, Ideal.ordElem (maximalIdeal R) (f j) ≠ ⊤ := by
    intro j htop
    apply h₁.2.2.2.2 j
    dsimp only
    rw [show initialForm (maximalIdeal R) (f j) = 0 by rw [initialForm, dite_eq_left htop]]
    exact zero_mem _
  let ν : Fin m → ℕ := fun j => (Ideal.ordElem (maximalIdeal R) (f j)).toNat
  have hν : ∀ j : Fin m, (ν j : ℕ∞) = nuI R J ((j : ℕ).succPNat) := fun j =>
    (ENat.natCast_toNat (hftop j)).trans (ordElem_eq_nuI_of_isStandardBase J f h₁ j)
  have him : (i : ℕ) ≤ m := by
    by_contra hlt
    have := (nuI_eq_of_hasLemma1Properties R J _ h₁.2).2 i (by omega)
    have h1 := hi.1
    simp only [Set.mem_ofPred_eq] at h1
    rw [this] at h1
    exact ENat.top_ne_natCast _ h1
  have hlex : toLex (fun j : Fin (i : ℕ) => nuI R J ((j : ℕ).succPNat)) ≤
      toLex fun j : Fin (i : ℕ) => nuI T.ring J₁ ((j : ℕ).succPNat) :=
    le_of_eq (congrArg toLex (funext fun j => heq _ (by simp only [Nat.succPNat_coe]; omega)))
  obtain ⟨⟨g, hg, hgP, hx⟩, -⟩ := exists_standardBase_extendsToStandardBase R P J hJP T hrat f i him ν hν h₁
    (fun j hj => (h₂ j hj).trans (hν j).symm) hlex
  obtain ⟨h, hgh, hhν, hext⟩ := hx C.x₁ C.span_x₁
  -- "The assumption `(ν^{(1)}(J), …, ν^{(i)}(J)) = (ν^{(1)}(J₁), …, ν^{(i)}(J₁))` implies that
  -- `μ^{(a)}(J) = μ^{(a)}(J₁)`."  Then `a ≤ t(J₁)`.
  have hat₁ : a ≤ t T.ring J₁ := le_t_of_nuI_eq J J₁ a ha hat i hi heq
  -- "`T_a ⊆ ρ(T̃_a)`": the smallest `k`-submodule `T` of `gr¹_M(R)` for `J` lies in `ρ(T̃)`, where `T̃`
  -- is the smallest one for `J₁` (the printed argument with `I`, `I⁰`, (v) and `ρ`)
  have hTρ := (TransformCoord.tauSubmodule_le_span_ρ_of_isGreatest R P J T hrat C g hg ν hν a ha hat
    i hi him heq h hgh hhν hext).2
  -- "Thus we get `τ^{(a)}(J) =` rank of `T ≤` rank of `ρ(T̃) ≤` rank `T̃ = τ^{(a)}(J₁)`."
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let _ : Field (T.ring ⧸ maximalIdeal T.ring) := Ideal.Quotient.field _
  obtain ⟨-, hrankJ, -⟩ := tauSubmodule_spec R J a ha hat
  obtain ⟨-, hrankJ₁, hspan⟩ := tauSubmodule_spec T.ring J₁ a ha hat₁
  obtain ⟨W, hW1, hW⟩ := tau_spec T.ring J₁ a
  have hfin : FiniteDimensional (T.ring ⧸ maximalIdeal T.ring) (tauSubmodule T.ring J₁ a) := by
    rw [← hspan W hW1 hW]
    exact FiniteDimensional.span_of_finite _ (Set.finite_range _)
  obtain ⟨hfinρ, hρle⟩ := C.finrank_span_ρ_le hrat (tauSubmodule T.ring J₁ a)
  calc tau R J a = Module.finrank (R ⧸ maximalIdeal R) (tauSubmodule R J a) := hrankJ.symm
    _ ≤ Module.finrank (R ⧸ maximalIdeal R) (Submodule.span (R ⧸ maximalIdeal R)
        (C.ρ hrat '' (tauSubmodule T.ring J₁ a : Set (AssocGraded (maximalIdeal T.ring))))) :=
      Submodule.finrank_mono hTρ
    _ ≤ Module.finrank (T.ring ⧸ maximalIdeal T.ring) (tauSubmodule T.ring J₁ a) := hρle
    _ = tau T.ring J₁ a := hrankJ₁

/-- The largest index `i` with `ν^{(i)}(J) = μ^{(b)}(J)` exists for `1 ≤ b ≤ t(J)`. -/
theorem exists_isGreatest_nuI_eq_mu {S : Type u} [CommRing S] [IsRegularLocalRing S] (J : Ideal S)
    (b : ℕ) (hb : 1 ≤ b) (hbt : b ≤ t S J) :
    ∃ i : ℕ+, IsGreatest {k : ℕ+ | nuI S J k = (mu S J b : ℕ∞)} i := by
  classical
  obtain ⟨m, g, hg⟩ := exists_isStandardBase J
  have htop := (nuI_eq_of_hasLemma1Properties S J _ hg.2).2
  have hfin := (muSet_finite S J).1
  have hmem : mu S J b ∈ muSet S J := by
    apply Nat.nth_mem_of_lt_card hfin
    refine lt_of_lt_of_le ?_ (le_of_eq (Set.ncard_eq_toFinset_card _ hfin))
    have : t S J = (muSet S J).ncard := rfl
    omega
  obtain ⟨k₀, hk₀⟩ := hmem
  have hSfin : {k : ℕ+ | nuI S J k = (mu S J b : ℕ∞)}.Finite := by
    refine ((Set.finite_le_nat m).preimage PNat.coe_injective.injOn).subset fun k hk => ?_
    by_contra hkm
    have := htop k (by simp only [Set.mem_preimage, Set.mem_ofPred_eq] at hkm; omega)
    rw [Set.mem_ofPred_eq, this] at hk
    exact ENat.top_ne_natCast _ hk
  obtain ⟨i, hi, himax⟩ := Set.exists_max_image _ (fun k : ℕ+ => (k : ℕ)) hSfin ⟨k₀, hk₀⟩
  exact ⟨i, hi, fun k hk => PNat.coe_le_coe _ _ |>.mp (himax k hk)⟩

end Lemma15Proof


    exact ⟨ψ', h1, h2, h3, δ, hδhom, hδ⟩
  choose ψ' hψ'J hψ'adj hψ'deg δ hδhom hδ using hdecomp
  have hdec1 : ∀ s, ψ s = ψ' s + ∑ d ∈ Finset.univ.filter (fun d => ν' d < ν' s), δ s d * ψ d :=
    fun s => by rw [← hδ s]; ring
  -- (1) `Ĩ = (ψ_1', …, ψ_i')`
  have hItl' : Itl = Ideal.span (Set.range ψ') := span_range_eq_of_decomp ν' ψ ψ' δ hdec1
  -- `φ_j' := φ_j - Σ δ_{jd} φ_d` with `δ_{jd} = ρ(δ̄_{jd})`
  set φ' : Fin (i : ℕ) → AssocGraded (maximalIdeal R) := fun s =>
    φ s - ∑ d ∈ Finset.univ.filter (fun d => ν' d < ν' s), C.ρ hrat (δ s d) * φ d with hφ'
  -- "`δ_{jd} = ρ(δ̄_{jd})` is a form only in `X_1, …, X_r`" (of degree `ν_j - ν_d`)
  have _hδpure : ∀ s d, ∃ q : MvPolynomial (Fin C.r) (R ⧸ maximalIdeal R),
      q.IsHomogeneous (ν' s - ν' d) ∧ C.ρ hrat (δ s d) = C.e (MvPolynomial.rename
        (fun i => (some (Sum.inl i) : CoordIndex C.r C.s)) q) :=
    fun s d => C.exists_ρ_eq_e_rename hrat (hδhom s d)
  -- (3) `ρ(ψ_j') = φ_j'`
  have hρψ' : ∀ s, C.ρ hrat (ψ' s) = φ' s := fun s => by
    have : ψ' s = ψ s - ∑ d ∈ Finset.univ.filter (fun d => ν' d < ν' s), δ s d * ψ d := by
      rw [hdec1 s]; ring
    rw [this, map_sub, map_sum]
    simp only [map_mul, hρψ, hφ']
  -- (2) `I = (φ_1', …, φ_i')`
  have hIid' : Iid = Ideal.span (Set.range φ') :=
    span_range_eq_of_decomp ν' φ φ' (fun s d => C.ρ hrat (δ s d)) (fun s => by simp [hφ'])
  -- `σ₀(ψ_j') = ρ(ψ_j') = φ_j'`
  have hσψ' : ∀ s, σ₀ (ψ' s) = φ' s := fun s => by
    rw [hσρ' _ (Algebra.adjoin_mono (fun x hx => tauSubmodule_mono_of_le J₁ (hbs1 s) (hbs2 s) hat₁ hx)
      (hψ'adj s)), hρψ']
  -- `σ₀(Ĩ) = I`
  have hItl_mem : ∀ x ∈ Itl, σ₀ x ∈ Iid := by
    intro x hx
    rw [hItl'] at hx
    have := mem_span_image_of_mem_span σ₀ hx
    rw [hIid']
    refine (Ideal.span_le.mpr ?_) this
    rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, hσψ']
    exact Ideal.subset_span ⟨s, rfl⟩
  have hIid_mem : ∀ y ∈ Iid, σ₀.symm y ∈ Itl := by
    intro y hy
    rw [hIid'] at hy
    have := mem_span_image_of_mem_span σ₀.symm hy
    rw [hItl']
    refine (Ideal.span_le.mpr ?_) this
    rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, show σ₀.symm (φ' s) = ψ' s from σ₀.symm_apply_eq.mpr (hσψ' s).symm]
    exact Ideal.subset_span ⟨s, rfl⟩
  refine ⟨σ₀.symm, fun c => ?_, fun μ φ hφ => hσhs μ φ hφ, fun μ ψ hψ => ?_,
    fun μ hμ x hx => ⟨fun hxJ => ?_, fun hσx => ?_⟩⟩
  · rw [RingEquiv.symm_apply_eq, IsScalarTower.algebraMap_apply T.ring
      (T.ring ⧸ maximalIdeal T.ring), hσalg, Ideal.Quotient.algebraMap_eq,
      MonoidalTransform.residueEquiv_symm_mk,
      ← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
  · rw [RingEquiv.symm_symm]
    exact hσh μ ψ hψ
  · exact (Ideal.span_le.mpr (by rintro _ ⟨s, rfl⟩; exact hψJ₁ s))
      (hIid_mem x (hgr μ hμ x hx hxJ))
  · have h1 := hItl_mem _ (hgr₁ μ hμ _ (hσhs μ x hx) hσx)
    rw [RingEquiv.apply_symm_apply] at h1
    exact (Ideal.span_le.mpr (by rintro _ ⟨s, rfl⟩; exact hφJ s)) h1

end Lemma16


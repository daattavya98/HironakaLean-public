    mem_span_initialForm_of_extendsToStandardBase_of_lt_nuI J (fun s : Fin (i : ℕ) => g (Fin.castLE him s))
      ⟨m, g, him, hg, fun _ => rfl⟩ hwJ hw
      (lt_of_le_of_lt (Nat.cast_le.mpr hμ) (lt_nuI_succPNat_of_isGreatest J hi))
  -- ## `ψ_j = ψ_j' + Σ δ̄_{jd} ψ_d`
  have hbex : ∀ s : Fin (i : ℕ), ∃ b, 1 ≤ b ∧ b ≤ a ∧ mu R J b = ν' s := fun s =>
    exists_mu_eq_of_mem_muSet J ⟨((Fin.castLE him s : Fin m) : ℕ).succPNat, (hν _).symm⟩ a ha hat
      (hνle s)
  choose bs hbs1 hbs2 hbs3 using hbex
  have hdecomp : ∀ s, ∃ ψ' : AssocGraded (maximalIdeal T.ring), ψ' ∈ grIdeal (maximalIdeal T.ring) J₁ ∧
      ψ' ∈ Algebra.adjoin (T.ring ⧸ maximalIdeal T.ring)
        (tauSubmodule T.ring J₁ (bs s) : Set (AssocGraded (maximalIdeal T.ring))) ∧
      ψ' ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν' s) ∧
      ∃ δ : Fin (i : ℕ) → AssocGraded (maximalIdeal T.ring),
        (∀ d, δ d ∈ AssocGraded.homogeneous (maximalIdeal T.ring) (ν' s - ν' d)) ∧
        ψ s - ψ' = ∑ d ∈ Finset.univ.filter (fun d => ν' d < ν' s), δ d * ψ d := by
    intro s
    have hT := (tauSubmodule_spec T.ring J₁ (bs s) (hbs1 s) ((hbs2 s).trans hat₁)).1
    rw [(hb_data (bs s) (hbs1 s) (hbs2 s)).1, hbs3 s] at hT
    have hlow : ∀ d < ν' s, ∀ w ∈ grIdeal (maximalIdeal T.ring) J₁,
        w ∈ AssocGraded.homogeneous (maximalIdeal T.ring) d →
        w ∈ Ideal.span {y | ∃ d', ν' d' < ν' s ∧ y = ψ d'} := by
      intro d hd w hw hwd
      have hdμ : d ≤ μb := (hd.trans_le (hνle s)).le
      have := mem_span_initialForm_of_extendsToStandardBase_of_le J₁ h hext hw hwd
        (lt_of_le_of_lt (Nat.cast_le.mpr hdμ) hgap')
      refine Ideal.span_mono ?_ this
      rintro x ⟨t, ht, rfl⟩
      refine ⟨t, ?_, rfl⟩
      have h5 : ((ν' t : ℕ) : ℕ∞) ≤ d := by rw [hν', ← hhν t]; exact ht
      exact lt_of_le_of_lt (by exact_mod_cast h5) hd
    obtain ⟨ψ', h1, h2, h3, h4⟩ := IsTauSubmoduleOfIdeal.exists_sub_mem_of_lt

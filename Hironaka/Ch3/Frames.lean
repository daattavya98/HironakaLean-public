/-! ### Further properties of the canonical map `k[Z₁, …, Z_r] → gr_M(R)` (used by Lemma 20) -/

section FrameAlgHomProperties

open MvPolynomial

namespace RegularFrame

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (F : RegularFrame R)

/-- The canonical `k`-algebra map `frameAlgHom F.z : k[Z₁, …, Z_r] → gr_M(R)` of a regular frame
has a left inverse: `gr_M(R)` is the polynomial ring over `k` in the initial forms of a regular
system of parameters extending `z` (Compat/RegularGraded), and the extra variables go to `0`.
This is the identification of `k[Z]` with a polynomial ring in `Z₁, …, Z_r` made in
Definition 9(1), p. 248 (and used throughout Lemma 19, 20, 21). -/
theorem exists_retraction_frameAlgHom :
    ∃ π : AssocGraded (maximalIdeal R) →ₐ[R ⧸ maximalIdeal R]
        MvPolynomial (Fin F.r) (R ⧸ maximalIdeal R),
      ∀ Q, π (frameAlgHom F.z Q) = Q := by
  classical
  obtain ⟨s, Θ, -, -, hΘZ, -, -⟩ := exists_transport F
  have hΘrename : Θ.toAlgHom.comp (rename (Fin.castAdd s)) = frameAlgHom F.z :=
    MvPolynomial.algHom_ext fun l => by
      rw [AlgHom.comp_apply, rename_X, frameAlgHom, aeval_X]
      exact hΘZ l
  let ev : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R) →ₐ[R ⧸ maximalIdeal R]
      MvPolynomial (Fin F.r) (R ⧸ maximalIdeal R) :=
    aeval (Fin.addCases (fun i => X i) (fun _ => 0))
  have hev : ev.comp (rename (Fin.castAdd s)) = AlgHom.id _ _ :=
    MvPolynomial.algHom_ext fun l => by
      rw [AlgHom.comp_apply, rename_X]
      simp [ev]
  refine ⟨ev.comp Θ.symm.toAlgHom, fun Q => ?_⟩
  have h1 : frameAlgHom F.z Q = Θ (rename (Fin.castAdd s) Q) :=
    (AlgHom.congr_fun hΘrename Q).symm
  rw [AlgHom.comp_apply, h1]
  show ev (Θ.symm (Θ (rename (Fin.castAdd s) Q))) = Q
  rw [AlgEquiv.symm_apply_apply]
  exact AlgHom.congr_fun hev Q

/-- The canonical map `k[Z₁, …, Z_r] → gr_M(R)` of a regular frame is injective: the initial
forms `Z_j` of a system extending to a regular system of parameters are algebraically
independent (Definition 9(1), p. 248, where `k[Z]` is identified with a polynomial ring). -/
theorem frameAlgHom_injective : Function.Injective (frameAlgHom F.z) := by
  obtain ⟨π, hπ⟩ := F.exists_retraction_frameAlgHom
  intro a b hab
  rw [← hπ a, ← hπ b, hab]

/-- If the image of `Q ∈ k[Z₁, …, Z_r]` in `gr_M(R)` is homogeneous of degree `d`, then `Q` is
homogeneous of degree `d` (the map `k[Z] → gr_M(R)` is graded and injective). -/
theorem isHomogeneous_of_frameAlgHom_mem_homogeneous
    {Q : MvPolynomial (Fin F.r) (R ⧸ maximalIdeal R)} {d : ℕ}
    (h : frameAlgHom F.z Q ∈ AssocGraded.homogeneous (maximalIdeal R) d) : Q.IsHomogeneous d := by
  classical
  obtain ⟨s, Θ, hΘh, -, hΘZ, -, -⟩ := exists_transport F
  have hΘrename : Θ.toAlgHom.comp (rename (Fin.castAdd s)) = frameAlgHom F.z :=
    MvPolynomial.algHom_ext fun l => by
      rw [AlgHom.comp_apply, rename_X, frameAlgHom, aeval_X]
      exact hΘZ l
  have h1 : rename (Fin.castAdd s) Q ∈
      homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) d :=
    (hΘh d _).mpr (by rw [← AlgHom.congr_fun hΘrename Q] at h; exact h)
  exact (IsHomogeneous.rename_isHomogeneous_iff (Fin.castAdd_injective _ _)).mp h1

/-- `g` is normalized by `(f₁, …, f_i)` iff the coefficients `c_A(g)` of its power series
expansion vanish for all `A` in the E-set of `(f₁, …, f_i)` (Definition 9(2), p. 248, with the
unique expansion map `RegularFrame.expansion` of \cref{lem:III.9-frame-completion}). -/
theorem isNormalizedBy_iff_expCoeff {i : ℕ} (f : Fin i → R) (g : R) :
    F.IsNormalizedBy f g ↔
      ∀ A ∈ frameESet F.z f, F.expCoeff g (Finsupp.equivFunOnFinite.symm A) = 0 := by
  refine ⟨fun h A hA => h (expansion F) (isExpansion_expansion F) A hA, fun h e he A hA => ?_⟩
  rw [isExpansion_unique_aux F he (isExpansion_expansion F)]
  exact h A hA

end RegularFrame

end FrameAlgHomProperties

end Hironaka

/-!
# Ch. III §7: A regular frame, a regular τ-frame, and a normalized standard base with
respect to a regular frame (pp. 244–253)

> Let Zʳ denote the r times direct product of the additive group of integers Z with itself,
> and Z₀ʳ the subset of Zʳ consisting of those A = (a₁, …, a_r) ∈ Zʳ which have a_i ≥ 0 for
> all i (1 ≤ i ≤ r). A subset E of Z₀ʳ will be called an E-subset of Z₀ʳ if A + B ∈ E for
> every pair of A ∈ E and B ∈ Z₀ʳ. (The empty subset is an E-subset of Z₀ʳ.)  (p. 244)

Contents, in the paper's order: E-subsets and bounds (p. 244); the E-function Λ_r and the
E-set E_r(I) of a homogeneous ideal (pp. 244–245); Remarks 1 and 2 (pp. 245–246); Lemma 17
(pp. 246–248); Definition 9 — regular frames, the associated graded subalgebra, normalized
elements and systems, normalized standard bases (p. 248); Lemma 18 (pp. 248–251); Theorem 6
(p. 251); Definition 10* (τ_{(z)}, p. 251); Lemma 19 (pp. 251–252); Definition 10 (regular
τ-frames, pp. 252–253); Theorem 7 (p. 253).

## Encoding

* `Z₀ʳ` is `Fin r → ℕ` with its additive structure.  The E-subsets of p. 244 are
  defined by the condition "A + B ∈ E for every pair of A ∈ E and B ∈ Z₀ʳ".
* The lexicographic order of p. 244 ("A < A' if there exists an index i such that a_j = a'_j
  for all j < i and a_i < a'_i") is Mathlib's `Finsupp.Lex` order on `Lex (Fin r →₀ ℕ)`
  (`Finsupp.Lex.lt_iff` is literally the displayed condition).  Exponents of monomials of
  `MvPolynomial (Fin r) S` are `Finsupp`s, and the E-function `Λ_r` converts the maximum back
  to `Fin r → ℕ` through `Finsupp.equivFunOnFinite`.
* `G = S[Z₁, …, Z_r]` is `MvPolynomial (Fin r) S`, graded as on p. 245 by total degree in the
  `Z_j` with coefficients in `S`: `MvPolynomial.homogeneousSubmodule (Fin r) S n`.
* `R = S{z₁, …, z_r}` is `MvPowerSeries (Fin r) S` with `z_j = MvPowerSeries.X j`; the power
  series expansion of p. 246 is `MvPowerSeries.coeff` (`psCoeff A g = c_A`), and the local
  ring structure is Mathlib's instance `IsLocalRing (MvPowerSeries σ S)`.
* `gr_M(R)` is `AssocGraded (maximalIdeal R)`, `k = R/M` is `R ⧸ maximalIdeal R`, and the
  graded `k`-subalgebra `k[Z] = k[Z₁, …, Z_r]` generated by the initial forms `Z_j` of the
  `z_j` is `assocSubalgebra z = Algebra.adjoin k (Set.range (frameForm z))`.
* The ideal `I = (φ₁, …, φ_i) k[Z]` of Lemma 17 and Definition 9(2) lives in `k[Z]`, whereas
  `E_r(-)` is defined for ideals of the *polynomial* ring `k[Z₁, …, Z_r]`.  The two are
  identified, as in the paper, through the canonical `k`-algebra map
  `frameAlgHom z : k[Z₁, …, Z_r] → gr_M(R)`, `Z_j ↦ Z_j`, which is injective for a regular
  frame.  `frameInitialIdeal z f` is the ideal of `MvPolynomial (Fin r) k` generated by the
  `frameAlgHom z`-preimages of the initial forms of the `f_j`, and `frameESet z f` is its
  E-set; this is the paper's `E`.
-/

@[expose] public section

open IsLocalRing

namespace Hironaka

universe u

/-! ### E-subsets of `Z₀ʳ` and their bounds (p. 244) -/

section ESubsets

variable {r : ℕ}

/-- p. 244: "A subset `E` of `Z₀ʳ` will be called an *E-subset* of `Z₀ʳ` if `A + B ∈ E` for
every pair of `A ∈ E` and `B ∈ Z₀ʳ`. (The empty subset is an E-subset of `Z₀ʳ`.)" -/
@[blueprint "def:III.7-E-subset"
  (statement := /-- Let $\mathbb Z^r_0$ denote the subset of $\mathbb Z^r$ consisting of those
    $A=(a_1,\dots,a_r)$ with $a_i\ge0$ for all $i$. A subset $E$ of $\mathbb Z^r_0$ is called
    an \emph{$E$-subset} of $\mathbb Z^r_0$ if $A+B\in E$ for every pair of $A\in E$ and
    $B\in\mathbb Z^r_0$. (The empty subset is an $E$-subset of $\mathbb Z^r_0$.) (p.~244.)
    (Formalization note: $\mathbb Z^r_0$ is encoded as the additive monoid of functions
    $\mathrm{Fin}\,r\to\mathbb N$.) -/)
  (latexEnv := "definition")]
def IsESubset (E : Set (Fin r → ℕ)) : Prop :=
  ∀ A ∈ E, ∀ B : Fin r → ℕ, A + B ∈ E

/-- p. 244: "A subset `F` of an E-subset `E` of `Z₀ʳ` will be called a *bound* of `E` if every
element `A` of `E` can be written in the form `A = A₀ + B` with `A₀ ∈ F` and `B ∈ Z₀ʳ`. If
this is the case, we shall also say that `E` is *bounded by* `F`." -/
@[blueprint "def:III.7-bound"
  (statement := /-- A subset $F$ of an $E$-subset $E$ of $\mathbb Z^r_0$
    (\cref{def:III.7-E-subset}) is called a \emph{bound} of $E$ if every element $A$ of $E$ can
    be written in the form $A=A_0+B$ with $A_0\in F$ and $B\in\mathbb Z^r_0$. In this case we
    also say that $E$ is \emph{bounded by} $F$. (p.~244.) -/)
  (latexEnv := "definition")]
def IsBound (F E : Set (Fin r → ℕ)) : Prop :=
  F ⊆ E ∧ ∀ A ∈ E, ∃ A₀ ∈ F, ∃ B : Fin r → ℕ, A = A₀ + B

/-- The E-subset of `Z₀ʳ` generated by a subset `F`, namely `{A₀ + B : A₀ ∈ F, B ∈ Z₀ʳ}`: by
\cref{lem:III.7-E-bound} it is the unique E-subset containing `F` and bounded by `F`. -/
def eSubsetGenerated (F : Set (Fin r → ℕ)) : Set (Fin r → ℕ) :=
  {A | ∃ A₀ ∈ F, ∃ B : Fin r → ℕ, A = A₀ + B}

/-- The elements of `Z₀ʳ⁺¹` as `(A', a)`: `init (A + snoc B' 0) = init A + B'`. -/
private theorem init_add_snoc_zero {r : ℕ} (A : Fin (r + 1) → ℕ) (B' : Fin r → ℕ) :
    Fin.init (A + Fin.snoc B' (0 : ℕ)) = Fin.init A + B' := by
  funext i
  simp [Fin.init]

/-- If `p(A) = p(A₀) + B'` and the last component of `A₀` is at most that of `A`, then
`A = A₀ + (B', a)` with `a` the difference of the last components. -/
private theorem eq_add_snoc_of_init_eq {r : ℕ} {A A₀ : Fin (r + 1) → ℕ} {B' : Fin r → ℕ}
    (hinit : Fin.init A = Fin.init A₀ + B') (hlast : A₀ (Fin.last r) ≤ A (Fin.last r)) :
    A = A₀ + Fin.snoc (α := fun _ => ℕ) B' (A (Fin.last r) - A₀ (Fin.last r)) := by
  funext i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · simp [Nat.add_sub_cancel' hlast]
  · have := congrFun hinit j
    simpa [Fin.init] using this

/-- "Then we can easily show that `p(E)` is an E-subset of `Z₀ʳ⁻¹`." -/
private theorem isESubset_image_init {r : ℕ} {E : Set (Fin (r + 1) → ℕ)} (hE : IsESubset E) :
    IsESubset (Fin.init '' E) := by
  rintro _ ⟨A, hAE, rfl⟩ B'
  exact ⟨A + Fin.snoc B' 0, hE A hAE _, init_add_snoc_zero A B'⟩

/-- "By the same reason", `p(E ∩ (Z₀ʳ⁻¹ × a))` is an E-subset of `Z₀ʳ⁻¹`. -/
private theorem isESubset_image_init_slice {r : ℕ} {E : Set (Fin (r + 1) → ℕ)} (hE : IsESubset E)
    (a : ℕ) : IsESubset (Fin.init '' (E ∩ {A | A (Fin.last r) = a})) := by
  rintro _ ⟨A, ⟨hAE, hAa⟩, rfl⟩ B'
  refine ⟨A + Fin.snoc B' 0, ⟨hE A hAE _, ?_⟩, init_add_snoc_zero A B'⟩
  simpa using hAa

/-- "Then, by the induction assumption, `p(E)` is bounded by a finite subset of `p(E)`. Take
`A₁, …, A_p ∈ E` such that `p(E)` is bounded by `{p(A₁), …, p(A_p)}`." -/
private theorem exists_finset_isBound_image_init {r : ℕ}
    (hIH : ∀ E : Set (Fin r → ℕ), IsESubset E → ∃ F : Finset (Fin r → ℕ), IsBound (F : Set _) E)
    {D : Set (Fin (r + 1) → ℕ)} (hD : IsESubset (Fin.init '' D)) :
    ∃ G : Finset (Fin (r + 1) → ℕ), (G : Set _) ⊆ D ∧
      IsBound ((G.image Fin.init : Finset (Fin r → ℕ)) : Set (Fin r → ℕ)) (Fin.init '' D) := by
  classical
  obtain ⟨F, hF⟩ := hIH _ hD
  obtain ⟨G, hGD, hGF⟩ := Finset.subset_set_image_iff.mp hF.1
  exact ⟨G, hGD, by rw [hGF]; exact hF⟩

/-- The finite bound of an E-subset of `Z₀ʳ`, `r ≥ 1`: the printed induction on `r` (p. 244). -/
private theorem exists_finset_isBound_of_isESubset (r : ℕ) (hr : 1 ≤ r)
    (E : Set (Fin r → ℕ)) (hE : IsESubset E) :
    ∃ F : Finset (Fin r → ℕ), IsBound (F : Set (Fin r → ℕ)) E := by
  classical
  induction r, hr using Nat.le_induction with
  | base =>
    -- "If `r = 1`, then it is clear."
    by_cases hne : E.Nonempty
    · obtain ⟨A₀, hA₀, hmin⟩ :=
        (InvImage.wf (fun A : Fin 1 → ℕ => A 0) wellFounded_lt).has_min E hne
      refine ⟨{A₀}, by simpa using hA₀, fun A hA => ⟨A₀, Finset.mem_coe.mpr (Finset.mem_singleton_self _),
        A - A₀, ?_⟩⟩
      funext i
      rw [Subsingleton.elim i 0]
      have := not_lt.mp (hmin A hA)
      simp [Nat.add_sub_cancel' this]
    · rw [Set.not_nonempty_iff_eq_empty] at hne
      subst hne
      exact ⟨∅, by simp, fun A hA => absurd hA (Set.notMem_empty _)⟩
  | succ r hr ih =>
    -- the induction step
    obtain ⟨G, hGE, hG⟩ := exists_finset_isBound_image_init ih
      (D := E) (isESubset_image_init hE)
    -- the maximum `ā` of the last components of the `A_i`
    set abar : ℕ := G.sup fun A => A (Fin.last r) with habar
    have hslice : ∀ a : ℕ, ∃ Ga : Finset (Fin (r + 1) → ℕ),
        (Ga : Set _) ⊆ E ∩ {A | A (Fin.last r) = a} ∧
        IsBound ((Ga.image Fin.init : Finset (Fin r → ℕ)) : Set (Fin r → ℕ))
          (Fin.init '' (E ∩ {A | A (Fin.last r) = a})) := fun a => by
      obtain ⟨Ga, hGa, hbd⟩ := exists_finset_isBound_image_init ih
        (D := E ∩ {A | A (Fin.last r) = a}) (isESubset_image_init_slice hE a)
      exact ⟨Ga, hGa, hbd⟩
    choose Ga hGaE hGabd using hslice
    refine ⟨G ∪ (Finset.range abar).biUnion Ga, ⟨?_, fun A hA => ?_⟩⟩
    · intro A hA
      rw [Finset.mem_coe, Finset.mem_union, Finset.mem_biUnion] at hA
      rcases hA with hA | ⟨a, -, hA⟩
      · exact hGE hA
      · exact (hGaE a hA).1
    · by_cases hlt : A (Fin.last r) < abar
      · -- `A ∈ E ∩ (Z₀ʳ⁻¹ × a)` with `a < ā`
        obtain ⟨A'₀, hA'₀, B', hB'⟩ := (hGabd (A (Fin.last r))).2 (Fin.init A) ⟨A, ⟨hA, rfl⟩, rfl⟩
        obtain ⟨A₀, hA₀, rfl⟩ := Finset.mem_image.mp hA'₀
        have hlast : A₀ (Fin.last r) = A (Fin.last r) := (hGaE _ hA₀).2
        refine ⟨A₀, Finset.mem_coe.mpr (Finset.mem_union_right _
          (Finset.mem_biUnion.mpr ⟨A (Fin.last r), Finset.mem_range.mpr hlt, hA₀⟩)), _,
          eq_add_snoc_of_init_eq hB' hlast.le⟩
      · -- `a ≥ ā`: use the bound of `p(E)`
        obtain ⟨A'₀, hA'₀, B', hB'⟩ := hG.2 (Fin.init A) ⟨A, hA, rfl⟩
        obtain ⟨A₀, hA₀, rfl⟩ := Finset.mem_image.mp hA'₀
        have hlast : A₀ (Fin.last r) ≤ A (Fin.last r) :=
          (Finset.le_sup (f := fun A : Fin (r + 1) → ℕ => A (Fin.last r)) hA₀).trans
            (not_lt.mp hlt)
        exact ⟨A₀, Finset.mem_coe.mpr (Finset.mem_union_left _ hA₀), _,
          eq_add_snoc_of_init_eq hB' hlast⟩

/-- p. 244: "If `F` is any subset of `Z₀ʳ`, then there exists a unique E-subset `E` of `Z₀ʳ`
such that `E` contains `F`, and `F` is a bound of `E`.  Moreover, if `E` is an E-subset of
`Z₀ʳ`, then there exists a finite subset `F` of `E` which is a bound of `E`."

The second assertion is proved by the printed induction on `r` (`exists_finset_isBound_of_isESubset`):
`r = 1` is clear (a minimal element of `E`); in the step the projection `p` onto the first `r - 1`
factors gives the E-subset `p(E)`, bounded by `p(A₁), …, p(A_p)` with `A_i ∈ E`; with `ā` the maximum
of the last components of the `A_i`, each slice `p(E ∩ (Z₀ʳ⁻¹ × a))`, `a < ā`, is an E-subset bounded by
finitely many `p(A^a_i)` with `A^a_i ∈ E ∩ (Z₀ʳ⁻¹ × a)`, and `{A_i, A^a_i}` is a bound of `E` (an element
of `E` with last component `< ā` is bounded by an `A^a_i`, one with last component `≥ ā` by an `A_i`).
(The case `r = 0` of the Lean statement, which the paper excludes, is trivial: `Z₀⁰` is a point.)
The first assertion, "immediate" in the paper, is proved as the paper says. -/
@[blueprint "lem:III.7-E-bound"
  (statement := /-- If $F$ is any subset of $\mathbb Z^r_0$, then there exists a unique
    $E$-subset $E$ of $\mathbb Z^r_0$ such that $E$ contains $F$ and $F$ is a bound of $E$
    (\cref{def:III.7-E-subset}, \cref{def:III.7-bound}). Moreover, if $E$ is an $E$-subset of
    $\mathbb Z^r_0$, then there exists a finite subset $F$ of $E$ which is a bound of $E$.
    (p.~244.) -/)
  (proof := /-- This fact can be verified by induction on $r$. If $r=1$, then it is clear.
    Suppose it is proved for every $E$-subset of $\mathbb Z^{r-1}_0$, where $r\ge2$. Let $E$ be
    an arbitrary $E$-subset of $\mathbb Z^r_0$. Let $p$ be the projection map of
    $\mathbb Z^r_0$ onto the product $\mathbb Z^{r-1}_0$ of the first $r-1$ factors of
    $\mathbb Z^r_0$. Then we can easily show that $p(E)$ is an $E$-subset of
    $\mathbb Z^{r-1}_0$. Then, by the induction assumption, $p(E)$ is bounded by a finite
    subset of $p(E)$. Take $A_1,\dots,A_p\in E$ such that $p(E)$ is bounded by
    $\{p(A_1),\dots,p(A_p)\}$. Let $\bar a$ be the maximum of the last components of the
    $A_i$ $(1\le i\le p)$. By the same reason, for each integer $a$ with $0\le a<\bar a$ we
    can find a finite number of elements $A^a_i$ $(1\le i\le p_a)$ of $E$ such that
    $A^a_i\in E\cap(\mathbb Z^{r-1}_0\times a)$ and $\{p(A^a_1),\dots,p(A^a_{p_a})\}$ is a
    bound of $p(E\cap(\mathbb Z^{r-1}_0\times a))$. Then, as is easily seen, the finite set of
    elements of $E$ $\{A_1,\dots,A_p,A^a_i$ with $0\le a<\bar a$ and $1\le i\le p_a\}$ is a
    bound of $E$. The first assertion is immediate: the $E$-subset generated by $F$ is
    $\{A_0+B: A_0\in F,\ B\in\mathbb Z^r_0\}$, and any $E$-subset containing $F$ and bounded
    by $F$ equals it. -/)
  (latexEnv := "lemma")]
theorem exists_unique_eSubset_isBound (F : Set (Fin r → ℕ)) :
    (∃! E : Set (Fin r → ℕ), IsESubset E ∧ IsBound F E) ∧
      ∀ E : Set (Fin r → ℕ), IsESubset E →
        ∃ F₀ : Finset (Fin r → ℕ), IsBound (F₀ : Set (Fin r → ℕ)) E := by
  refine ⟨⟨eSubsetGenerated F, ⟨?_, ?_, fun A hA => hA⟩, ?_⟩, fun E hE => ?_⟩
  · -- the upward closure `{A₀ + B}` of `F` is an E-subset
    rintro A ⟨A₀, hA₀, B, rfl⟩ B'
    exact ⟨A₀, hA₀, B + B', add_assoc _ _ _⟩
  · -- it contains `F`
    exact fun A hA => ⟨A, hA, 0, (add_zero A).symm⟩
  · -- uniqueness: an E-subset containing `F` and bounded by `F` is the upward closure of `F`
    rintro E ⟨hE, hFE, hbd⟩
    ext A
    refine ⟨hbd A, ?_⟩
    rintro ⟨A₀, hA₀, B, rfl⟩
    exact hE A₀ (hFE hA₀) B
  · -- the finite bound, by the printed induction on `r` (p. 244); `r = 0` (not in the paper)
    -- is trivial, `Z₀⁰` being a point
    by_cases hr : r = 0
    · subst hr
      refine ⟨(Set.toFinite E).toFinset, by rw [Set.Finite.coe_toFinset], fun A hA => ⟨A, ?_, 0,
        (add_zero A).symm⟩⟩
      rw [Set.Finite.coe_toFinset]
      exact hA
    · exact exists_finset_isBound_of_isESubset r (Nat.one_le_iff_ne_zero.mpr hr) E hE

end ESubsets

/-! ### The E-function `Λ_r` and the E-set `E_r(I)` (pp. 244–245) -/

section EFunction

variable {S : Type u} [CommRing S] {r : ℕ}

open Classical in
/-- p. 245: "Let `φ` be a non-zero form of `Z₁, …, Z_r` in `G = S[Z₁, …, Z_r]`. Then it can be
written in a unique manner as a linear combination of monomials `Z^A` (`A ∈ Z₀ʳ`) with
coefficients in `S`. Let us denote by `Λ_r(φ)` the largest element in `Z₀ʳ` such that the
monomial `Z^{Λ_r(φ)}` appears in the above expression of `φ` with a non-zero coefficient in
`S`. … We shall call `Λ_r` the *E-function* of `G` (or, of the forms in `G`) with respect to
`(S; Z₁, …, Z_r)`."  `Z₀ʳ` carries the lexicographic ordering of p. 244.

(Formalization note: `Λ_r` is the largest element of the support of `φ`, taken in
`Lex (Fin r →₀ ℕ)`; the paper only uses it for non-zero forms, and the junk value `0` is
given here for `φ = 0`.) -/
@[blueprint "def:III.7-E-function"
  (statement := /-- Let $S$ be a noetherian ring and $G=S[Z_1,\dots,Z_r]$ a polynomial ring in
    $r$ independent variables over $S$; for $A=(a_1,\dots,a_r)\in\mathbb Z^r_0$ write $Z^A$ for
    the monomial $Z_1^{a_1}\cdots Z_r^{a_r}$, and view $\mathbb Z^r_0$ as an ordered set by
    means of the lexicographic ordering ($A<A'$ if there is an index $i$ with $a_j=a'_j$ for
    all $j<i$ and $a_i<a'_i$). Let $\varphi$ be a non-zero form of $Z_1,\dots,Z_r$ in $G$,
    written in the unique manner as a linear combination of monomials $Z^A$ with coefficients
    in $S$. Then $\Lambda_r(\varphi)$ denotes the largest element of $\mathbb Z^r_0$ such that
    $Z^{\Lambda_r(\varphi)}$ appears in that expression with a non-zero coefficient in $S$.
    $\Lambda_r$ is called the \emph{$E$-function} of $G$ (or of the forms in $G$) with respect
    to $(S;Z_1,\dots,Z_r)$. (pp.~244--245.) (Formalization note: $\Lambda_r(0)$ is given the
    junk value $0$; the noetherian hypothesis on $S$ is not needed for the definition.) -/)
  (latexEnv := "definition")]
noncomputable def EFunction (φ : MvPolynomial (Fin r) S) : Fin r → ℕ :=
  if h : φ.support.Nonempty then
    ⇑(ofLex ((φ.support.image fun A => toLex A).max' (h.image _)))
  else 0

/-- The set of values `Λ_r(φ)` for the non-zero forms `φ` of a homogeneous ideal `I` of
`G = S[Z₁, …, Z_r]`, i.e. the bound of `E_r(I)` used in \cref{def:III.7-E-set}.  "Here we view
`G` as a graded `S`-algebra in such a way that the homogeneous part of degree `n` of `G`
consists of the forms of degree `n` in `Z₁, …, Z_r` with coefficients in `S`" (p. 245). -/
def eGenerators (I : Ideal (MvPolynomial (Fin r) S)) : Set (Fin r → ℕ) :=
  {A | ∃ φ ∈ I, φ ≠ 0 ∧ (∃ n, φ ∈ MvPolynomial.homogeneousSubmodule (Fin r) S n) ∧
    A = EFunction φ}

/-- p. 245: "If `I` is a homogeneous ideal in `G = S[Z₁, …, Z_r]`, then we denote by `E_r(I)`
the E-subset of `Z₀ʳ` bounded by the set consisting of `Λ_r(φ)` with homogeneous `φ ∈ I`;
`E_r(I)` is empty if `I = (0)`. … We shall call `E_r(I)` the *E-set* of the homogeneous ideal
`I` in `G` with respect to `(S; Z₁, …, Z_r)`." -/
@[blueprint "def:III.7-E-set"
  (statement := /-- If $I$ is a homogeneous ideal in $G=S[Z_1,\dots,Z_r]$ (graded as a graded
    $S$-algebra, the homogeneous part of degree $n$ consisting of the forms of degree $n$ in
    $Z_1,\dots,Z_r$ with coefficients in $S$), then $E_r(I)$ denotes the $E$-subset of
    $\mathbb Z^r_0$ (\cref{def:III.7-E-subset}) bounded by the set consisting of
    $\Lambda_r(\varphi)$ with homogeneous $\varphi\in I$ (\cref{def:III.7-E-function},
    \cref{def:III.7-bound}); $E_r(I)$ is empty if $I=(0)$. $E_r(I)$ is called the \emph{$E$-set}
    of the homogeneous ideal $I$ in $G$ with respect to $(S;Z_1,\dots,Z_r)$. (p.~245.) -/)
  (latexEnv := "definition")]
noncomputable def ESet (I : Ideal (MvPolynomial (Fin r) S)) : Set (Fin r → ℕ) :=
  eSubsetGenerated (eGenerators I)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Multiplication by a monomial `Z^B` with coefficient `1` translates the support by `B` and
preserves the lexicographic order, so `Z^B φ ≠ 0` and `Λ_r(Z^B φ) = B + Λ_r(φ)` for every
non-zero `φ`, over any coefficient ring `S`. -/
private theorem eFunction_monomial_mul (B : Fin r →₀ ℕ) {φ : MvPolynomial (Fin r) S}
    (hφ : φ ≠ 0) :
    MvPolynomial.monomial B 1 * φ ≠ 0 ∧
      EFunction (MvPolynomial.monomial B 1 * φ) = ⇑B + EFunction φ := by
  classical
  set ψ := MvPolynomial.monomial B 1 * φ with hψ
  have hne : φ.support.Nonempty := MvPolynomial.support_nonempty.mpr hφ
  set a := (φ.support.image fun A => toLex A).max' (hne.image _) with ha
  have ha_mem : ofLex a ∈ φ.support := by
    obtain ⟨m, hm, hma⟩ := Finset.mem_image.mp ((φ.support.image fun A => toLex A).max'_mem
      (hne.image _))
    rw [ha, ← hma]
    exact hm
  have hcoeff : ψ.coeff (B + ofLex a) = φ.coeff (ofLex a) := by
    rw [hψ, MvPolynomial.coeff_monomial_mul, one_mul]
  have hψ_mem : B + ofLex a ∈ ψ.support := by
    rw [MvPolynomial.mem_support_iff, hcoeff]
    exact MvPolynomial.mem_support_iff.mp ha_mem
  have hψne : ψ.support.Nonempty := ⟨_, hψ_mem⟩
  refine ⟨MvPolynomial.support_nonempty.mp hψne, ?_⟩
  -- the largest exponent of `ψ` is `B + Λ_r(φ)`: every exponent of `ψ` is `B + m` with `m` an
  -- exponent of `φ`, and `m ↦ B + m` is monotone for the lexicographic order
  have hmax : (ψ.support.image fun A => toLex A).max' (hψne.image _) = toLex B + a := by
    have h1 : toLex (B + ofLex a) ∈ ψ.support.image fun A => toLex A :=
      Finset.mem_image.mpr ⟨_, hψ_mem, rfl⟩
    refine le_antisymm (Finset.max'_le _ _ _ fun y hy => ?_) (Finset.le_max' _ _ h1)
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hy
    rw [MvPolynomial.mem_support_iff, hψ, MvPolynomial.coeff_monomial_mul'] at hm
    split_ifs at hm with hBm
    · rw [one_mul] at hm
      have hle : toLex (m - B) ≤ a :=
        Finset.le_max' _ _ (Finset.mem_image.mpr ⟨_, MvPolynomial.mem_support_iff.mpr hm, rfl⟩)
      calc toLex m = toLex B + toLex (m - B) := by rw [← toLex_add, add_tsub_cancel_of_le hBm]
        _ ≤ toLex B + a := add_le_add_right hle _
    · exact absurd rfl hm
  rw [EFunction, dite_eq_left hψne, EFunction, dite_eq_left hne, hmax, ← ha]
  rfl

/-- p. 245: "We see that `A ∈ E_r(I)` if and only if `A = Λ_r(φ)` with a form `φ` in `I`."
The paper's standing hypothesis that `I` is homogeneous is kept but not needed. -/
@[blueprint "lem:III.7-E-set-char"
  (statement := /-- Let $S$ be a noetherian ring and $I$ a homogeneous ideal in
    $G=S[Z_1,\dots,Z_r]$. Then $A\in E_r(I)$ if and only if $A=\Lambda_r(\varphi)$ with a
    (non-zero) form $\varphi$ in $I$ (\cref{def:III.7-E-set}). (p.~245.) -/)
  (proof := /-- If $\varphi$ is a non-zero form of $I$ then $\Lambda_r(\varphi)\in E_r(I)$ by
    definition. Conversely, let $A\in E_r(I)$, say $A=\Lambda_r(\varphi)+B$ with $\varphi$ a
    non-zero form of $I$ and $B\in\mathbb Z^r_0$. Then $Z^B\varphi$ is again a non-zero form of
    $I$, and since $\Lambda_r(Z^B\varphi)=B+\Lambda_r(\varphi)$ (multiplication by the monomial
    $Z^B$ translates the support by $B$ and preserves the lexicographic order), we get
    $A=\Lambda_r(Z^B\varphi)$. -/)
  (latexEnv := "lemma")]
theorem mem_eSet_iff (I : Ideal (MvPolynomial (Fin r) S))
    (_hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin r) S)) (A : Fin r → ℕ) :
    A ∈ ESet I ↔ ∃ φ ∈ I, φ ≠ 0 ∧ (∃ n, φ ∈ MvPolynomial.homogeneousSubmodule (Fin r) S n) ∧
      A = EFunction φ := by
  -- the homogeneity of `I` is not needed: `eGenerators I` is already upward closed
  refine ⟨?_, fun h => ⟨A, h, 0, (add_zero A).symm⟩⟩
  rintro ⟨A₀, ⟨φ, hφI, hφ0, ⟨n, hφn⟩, rfl⟩, B, rfl⟩
  -- `A = Λ_r(φ) + B = Λ_r(Z^B φ)`, and `Z^B φ` is a non-zero form of `I`
  obtain ⟨hψ0, hψ⟩ := eFunction_monomial_mul (Finsupp.equivFunOnFinite.symm B) hφ0
  refine ⟨_, I.mul_mem_left _ hφI, hψ0, ⟨(Finsupp.equivFunOnFinite.symm B).degree + n, ?_⟩, ?_⟩
  · rw [MvPolynomial.mem_homogeneousSubmodule] at hφn ⊢
    exact (MvPolynomial.isHomogeneous_monomial _ rfl).mul hφn
  · rw [hψ, Finsupp.coe_equivFunOnFinite_symm, add_comm]

end EFunction

/-! ### Remark 1 (p. 245) and Remark 2 (pp. 245–246) -/

section Remarks

attribute [local instance] MvPolynomial.gradedAlgebra

/-- `Λ(φ)` is the lexicographically largest exponent of a non-zero `φ`. -/
theorem eFunction_spec_aux {S : Type u} [CommRing S] {n : ℕ}
    {φ : MvPolynomial (Fin n) S} (hφ : φ ≠ 0) :
    ∃ m ∈ φ.support, EFunction φ = ⇑m ∧ ∀ m' ∈ φ.support, toLex m' ≤ toLex m := by
  have hne : φ.support.Nonempty := MvPolynomial.support_nonempty.mpr hφ
  obtain ⟨m, hm, hma⟩ := Finset.mem_image.mp ((φ.support.image fun A => toLex A).max'_mem
    (hne.image _))
  refine ⟨m, hm, ?_, fun m' hm' => ?_⟩
  · rw [EFunction, dite_eq_left hne, ← hma]
    rfl
  · rw [hma]
    exact Finset.le_max' _ _ (Finset.mem_image.mpr ⟨m', hm', rfl⟩)

/-- `Λ(φ) = m` for an exponent `m` of `φ` which is lexicographically largest. -/
private theorem eFunction_eq_of_max_aux {S : Type u} [CommRing S] {n : ℕ}
    {φ : MvPolynomial (Fin n) S} {m : Fin n →₀ ℕ} (hm : m ∈ φ.support)
    (hmax : ∀ m' ∈ φ.support, toLex m' ≤ toLex m) : EFunction φ = ⇑m := by
  obtain ⟨m₀, hm₀, hEF, hmax₀⟩ :=
    eFunction_spec_aux (MvPolynomial.support_nonempty.mp ⟨m, hm⟩)
  rw [hEF, show m₀ = m from toLex_inj.mp (le_antisymm (hmax m₀ hm₀) (hmax₀ m hm))]

open MvPolynomial in
/-- The homogeneous component of degree `d` of `a x` with `a` homogeneous of degree `i`. -/
private theorem homogeneousComponent_mul_of_mem_aux {R σ : Type*} [CommRing R]
    {a : MvPolynomial σ R} {i : ℕ} (ha : a ∈ homogeneousSubmodule σ R i)
    (x : MvPolynomial σ R) (d : ℕ) :
    homogeneousComponent d (a * x) =
      if i ≤ d then a * homogeneousComponent (d - i) x else 0 := by
  have h := DirectSum.coe_decompose_mul_of_left_mem (𝒜 := homogeneousSubmodule σ R) (b := x) d ha
  rw [← decomposition.decompose'_apply, ← decomposition.decompose'_apply]
  exact h

/-- `Λ` only depends on the support. -/
private theorem eFunction_congr_aux {S S' : Type u} [CommRing S] [CommRing S'] {n : ℕ}
    {φ : MvPolynomial (Fin n) S} {ψ : MvPolynomial (Fin n) S'} (h : φ.support = ψ.support) :
    EFunction φ = EFunction ψ := by
  by_cases hφ : φ = 0
  · have hψ : ψ = 0 := by
      rw [← MvPolynomial.support_eq_empty, ← h, hφ, MvPolynomial.support_zero]
    rw [hφ, hψ, EFunction, EFunction, dite_eq_right (by simp), dite_eq_right (by simp)]
  · obtain ⟨m, hm, hEF, hmax⟩ := eFunction_spec_aux hφ
    rw [hEF, eFunction_eq_of_max_aux (h ▸ hm) (fun m' hm' => hmax m' (h ▸ hm'))]

/-! #### The proof of Remark 1, along the printed text (p. 245)

"In fact, the equality can be easily proved when `S` is a ring of fractions of `S₀` with respect to a
multiplicatively closed subset of `S₀` which does not contain any zero-divisor of `S₀`. So the proof
in the general case is reduced to the case in which `S₀` is a field. In this case, `S` is a free
`S₀`-module. Every homogeneous element `φ'` of `I` is then written in the form `φ' = ∑ aᵢφᵢ`, where
the `aᵢ` are elements of `S` which are linearly independent over `S₀`, and the `φᵢ` are homogeneous
elements of `I₀` which have the same degree as `φ'`. Then one can easily see that
`Λ_r(φ') = max {Λ_r(φᵢ)}`."  The three steps are `eSet_subset_eSet_map` (the inclusion),
`eSet_map_localization_subset` (rings of fractions), `eSet_map_field_subset` (the field case);
`eSet_map_of_injective` assembles them. -/

/-- The first assertion of Remark 1 (p. 245): "the E-set `E_r(I)` of the ideal `I` in `G` contains
the E-set `E_r(I₀)` of `I₀` in `G₀`": a form `φ` of `I₀` and its image have the same support. -/
theorem eSet_subset_eSet_map {S₀ S : Type u} [CommRing S₀] [CommRing S] (α : S₀ →+* S)
    (hα : Function.Injective α) {r : ℕ} (I₀ : Ideal (MvPolynomial (Fin r) S₀)) :
    ESet I₀ ⊆ ESet (I₀.map (MvPolynomial.map α)) := by
  classical
  rintro _ ⟨_, ⟨φ, hφI, hφ0, ⟨n, hφn⟩, rfl⟩, B, rfl⟩
  refine ⟨_, ⟨MvPolynomial.map α φ, Ideal.mem_map_of_mem _ hφI, fun h => hφ0 ?_, ⟨n, ?_⟩,
    eFunction_congr_aux (MvPolynomial.support_map_of_injective φ hα).symm⟩, B, ?_⟩
  · exact MvPolynomial.map_injective _ hα (by rw [h, map_zero])
  · rw [MvPolynomial.mem_homogeneousSubmodule] at hφn ⊢
    exact hφn.map α
  · rw [eFunction_congr_aux (MvPolynomial.support_map_of_injective φ hα).symm]

/-! #### The case of a ring of fractions ("the equality can be easily proved when `S` is a ring of
fractions of `S₀`") -/

section Fractions

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- The denominators of a polynomial over a ring of fractions can be cleared by one element of the
multiplicative set. -/
private theorem exists_clear_denominators (T : Submonoid A) [IsLocalization T B] {r : ℕ}
    (c : MvPolynomial (Fin r) B) :
    ∃ t : T, ∃ c' : MvPolynomial (Fin r) A,
      MvPolynomial.map (algebraMap A B) c' = MvPolynomial.C (algebraMap A B t) * c := by
  induction c using MvPolynomial.induction_on with
  | C b =>
    obtain ⟨⟨a, t⟩, h⟩ := IsLocalization.surj T b
    refine ⟨t, MvPolynomial.C a, ?_⟩
    rw [MvPolynomial.map_C, ← MvPolynomial.C_mul, mul_comm]
    exact congrArg MvPolynomial.C h.symm
  | add p q hp hq =>
    obtain ⟨t₁, p', hp'⟩ := hp
    obtain ⟨t₂, q', hq'⟩ := hq
    refine ⟨t₁ * t₂, MvPolynomial.C (t₂ : A) * p' + MvPolynomial.C (t₁ : A) * q', ?_⟩
    simp only [map_add, map_mul, MvPolynomial.map_C, hp', hq', Submonoid.coe_mul]
    ring
  | mul_X p i hp =>
    obtain ⟨t, p', hp'⟩ := hp
    refine ⟨t, p' * MvPolynomial.X i, ?_⟩
    rw [map_mul, MvPolynomial.map_X, hp']
    ring

/-- The `E`-set does not change under a ring of fractions at non-zero-divisors ("the equality can be
easily proved when `S` is a ring of fractions of `S₀` with respect to a multiplicatively closed
subset of `S₀` which does not contain any zero-divisor of `S₀`", Remark 1, p. 245): an element of
`I B[Z]` has the same support as an element of `I` (multiply by a denominator). -/
theorem eSet_map_localization_subset (T : Submonoid A) (hT : T ≤ nonZeroDivisors A)
    [IsLocalization T B] {r : ℕ} (I : Ideal (MvPolynomial (Fin r) A)) :
    ESet (I.map (MvPolynomial.map (algebraMap A B))) ⊆ ESet I := by
  classical
  have hinj : Function.Injective (algebraMap A B) := IsLocalization.injective B hT
  -- every element of `I B[Z]` becomes an element of `I` after multiplication by a denominator
  have key : ∀ y ∈ I.map (MvPolynomial.map (algebraMap A B)), ∃ t : T, ∃ ψ ∈ I,
      MvPolynomial.map (algebraMap A B) ψ = MvPolynomial.C (algebraMap A B t) * y := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨g, hg, rfl⟩ := hy
      exact ⟨1, g, hg, by simp⟩
    | zero => exact ⟨1, 0, I.zero_mem, by simp⟩
    | add y z _ _ hy hz =>
      obtain ⟨t₁, ψ₁, hψ₁, h₁⟩ := hy
      obtain ⟨t₂, ψ₂, hψ₂, h₂⟩ := hz
      refine ⟨t₁ * t₂, MvPolynomial.C (t₂ : A) * ψ₁ + MvPolynomial.C (t₁ : A) * ψ₂,
        I.add_mem (I.mul_mem_left _ hψ₁) (I.mul_mem_left _ hψ₂), ?_⟩
      simp only [map_add, map_mul, MvPolynomial.map_C, h₁, h₂, Submonoid.coe_mul]
      ring
    | smul c y _ hy =>
      obtain ⟨t₁, ψ₁, hψ₁, h₁⟩ := hy
      obtain ⟨t₂, c', hc'⟩ := exists_clear_denominators (A := A) T c
      refine ⟨t₂ * t₁, c' * ψ₁, I.mul_mem_left _ hψ₁, ?_⟩
      rw [map_mul, hc', h₁, smul_eq_mul, Submonoid.coe_mul, map_mul, MvPolynomial.C_mul]
      ring
  intro A₁ hA₁
  obtain ⟨A₀, ⟨φ', hφ'J, hφ'0, ⟨n, hφ'n⟩, rfl⟩, C, rfl⟩ := hA₁
  obtain ⟨t, ψ, hψI, hψ⟩ := key φ' hφ'J
  have hu : IsUnit (algebraMap A B t) := IsLocalization.map_units B t
  -- `ψ` has the support of `φ'`
  have hsupp : ψ.support = φ'.support := by
    ext m
    rw [MvPolynomial.mem_support_iff, MvPolynomial.mem_support_iff]
    have h1 : (MvPolynomial.map (algebraMap A B) ψ).coeff m = algebraMap A B (ψ.coeff m) :=
      MvPolynomial.coeff_map _ _ _
    have h2 : (MvPolynomial.map (algebraMap A B) ψ).coeff m =
        algebraMap A B t * φ'.coeff m := by
      rw [hψ, MvPolynomial.coeff_C_mul]
    constructor
    · intro h h0
      apply h
      apply hinj
      rw [← h1, h2, h0, mul_zero, map_zero]
    · intro h h0
      apply h
      have : algebraMap A B t * φ'.coeff m = 0 := by rw [← h2, h1, h0, map_zero]
      exact (hu.mul_right_eq_zero).mp this
  have hψ0 : ψ ≠ 0 := fun h0 => hφ'0 (by
    rw [← MvPolynomial.support_eq_empty, ← hsupp, h0, MvPolynomial.support_zero])
  have hψn : ψ ∈ MvPolynomial.homogeneousSubmodule (Fin r) A n := by
    rw [MvPolynomial.mem_homogeneousSubmodule]
    intro d hd
    exact hφ'n (MvPolynomial.mem_support_iff.mp (hsupp ▸ MvPolynomial.mem_support_iff.mpr hd))
  refine ⟨_, ⟨ψ, hψI, hψ0, ⟨n, hψn⟩, rfl⟩, C, ?_⟩
  rw [eFunction_congr_aux hsupp]

end Fractions

/-! #### The case of a field ("In this case, `S` is a free `S₀`-module \dots") -/

section FieldCase

variable {K S' : Type u} [Field K] [CommRing S'] [Algebra K S'] {r : ℕ}

/-- The coordinate polynomial of `p ∈ S'[Z]` in the basis vector `l`: the coefficients of `p`
are replaced by their `l`-th coordinates over `K` (so that `p = ∑_l b_l · coordPoly l p`). -/
private noncomputable def coordPoly {ι : Type*} (b : Module.Basis ι K S') (l : ι)
    (p : MvPolynomial (Fin r) S') : MvPolynomial (Fin r) K :=
  ∑ m ∈ p.support, MvPolynomial.monomial m (b.coord l (p.coeff m))

private theorem coeff_coordPoly {ι : Type*} (b : Module.Basis ι K S') (l : ι)
    (p : MvPolynomial (Fin r) S') (m : Fin r →₀ ℕ) :
    (coordPoly b l p).coeff m = b.coord l (p.coeff m) := by
  classical
  rw [coordPoly, MvPolynomial.coeff_sum]
  simp only [MvPolynomial.coeff_monomial]
  rw [Finset.sum_ite_eq']
  by_cases hm : m ∈ p.support
  · rw [ite_eq_left hm]
  · rw [ite_eq_right hm, MvPolynomial.notMem_support_iff.mp hm, map_zero]

/-- The coordinate polynomials are `K[Z]`-linear: `coordPoly l (q g) = q · coordPoly l g` for
`q ∈ K[Z]` (acting on `S'[Z]` through `K → S'`). -/
private theorem coordPoly_map_mul {ι : Type*} (b : Module.Basis ι K S') (l : ι)
    (q : MvPolynomial (Fin r) K) (g : MvPolynomial (Fin r) S') :
    coordPoly b l (MvPolynomial.map (algebraMap K S') q * g) = q * coordPoly b l g := by
  ext m
  rw [coeff_coordPoly, MvPolynomial.coeff_mul, MvPolynomial.coeff_mul, map_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [MvPolynomial.coeff_map, coeff_coordPoly, ← Algebra.smul_def, map_smul, smul_eq_mul]

private theorem coordPoly_add {ι : Type*} (b : Module.Basis ι K S') (l : ι)
    (p q : MvPolynomial (Fin r) S') : coordPoly b l (p + q) = coordPoly b l p + coordPoly b l q := by
  ext m
  simp [coeff_coordPoly]

private theorem coordPoly_zero {ι : Type*} (b : Module.Basis ι K S') (l : ι) :
    coordPoly b l (0 : MvPolynomial (Fin r) S') = 0 := by
  ext m
  simp [coeff_coordPoly]

/-- **Remark 1 of \S7 for a field** (p. 245: ``In this case, $S$ is a free $S_0$-module. Every
homogeneous element $\varphi'$ of $I$ is then written in the form $\varphi'=\sum a_i\varphi_i$
where the $a_i$ are elements of $S$ which are linearly independent over $S_0$, and the $\varphi_i$
are homogeneous elements of $I_0$ which have the same degree as $\varphi'$. Then one can easily see
that $\Lambda_r(\varphi')=\max_i\{\Lambda_r(\varphi_i)\}$''): the $a_i$ are the vectors $b_l$ of a
basis of $S'$ over the field $K$, the $\varphi_i=\mathrm{coordPoly}\,l\,\varphi'$ are the coordinate
polynomials (they lie in $I_0$ and are forms of the degree of $\varphi'$), and
$\Lambda_r(\varphi')=\Lambda_r(\varphi_l)$ for some $l$. -/
theorem eSet_map_field_subset (I₀ : Ideal (MvPolynomial (Fin r) K)) :
    ESet (I₀.map (MvPolynomial.map (algebraMap K S'))) ⊆ ESet I₀ := by
  classical
  let b := Module.Free.chooseBasis K S'
  -- the coordinate polynomials of an element of `I₀ S'[Z]` lie in `I₀`
  have hmem : ∀ y ∈ I₀.map (MvPolynomial.map (algebraMap K S')), ∀ c : MvPolynomial (Fin r) S',
      ∀ l, coordPoly b l (c * y) ∈ I₀ := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨g, hg, rfl⟩ := hy
      intro c l
      rw [mul_comm, coordPoly_map_mul]
      exact I₀.mul_mem_right _ hg
    | zero => intro c l; rw [mul_zero, coordPoly_zero]; exact I₀.zero_mem
    | add y z _ _ hy hz =>
      intro c l
      rw [mul_add, coordPoly_add]
      exact I₀.add_mem (hy c l) (hz c l)
    | smul d y _ hy =>
      intro c l
      rw [smul_eq_mul, ← mul_assoc]
      exact hy (c * d) l
  intro A₁ hA₁
  obtain ⟨A₀, ⟨φ', hφ'J, hφ'0, ⟨n, hφ'n⟩, rfl⟩, C, rfl⟩ := hA₁
  -- the leading exponent of `φ'` and a coordinate in which its coefficient is non-zero
  obtain ⟨m₀, hm₀, hEF, hmax⟩ := eFunction_spec_aux hφ'0
  have hc0 : φ'.coeff m₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hm₀
  obtain ⟨l, hl⟩ : ∃ l, b.coord l (φ'.coeff m₀) ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hc0
    apply b.repr.injective
    ext l
    simpa using hall l
  -- the coordinate polynomial `ψ` of `φ'` lies in `I₀`, is a form of degree `n`, has the same
  -- leading exponent
  set ψ := coordPoly b l φ' with hψdef
  have hψI : ψ ∈ I₀ := by
    have := hmem φ' hφ'J 1 l
    rwa [one_mul] at this
  have hψsupp : ∀ m, m ∈ ψ.support → m ∈ φ'.support := by
    intro m hm
    rw [MvPolynomial.mem_support_iff, hψdef, coeff_coordPoly] at hm
    rw [MvPolynomial.mem_support_iff]
    intro h0
    exact hm (by rw [h0, map_zero])
  have hm₀ψ : m₀ ∈ ψ.support := by
    rw [MvPolynomial.mem_support_iff, hψdef, coeff_coordPoly]
    exact hl
  have hψ0 : ψ ≠ 0 := fun h0 => by
    rw [h0, MvPolynomial.support_zero] at hm₀ψ
    exact absurd hm₀ψ (Finset.notMem_empty _)
  have hψn : ψ ∈ MvPolynomial.homogeneousSubmodule (Fin r) K n := by
    rw [MvPolynomial.mem_homogeneousSubmodule]
    intro d hd
    exact hφ'n (MvPolynomial.mem_support_iff.mp (hψsupp d (MvPolynomial.mem_support_iff.mpr hd)))
  have hψE : EFunction ψ = ⇑m₀ :=
    eFunction_eq_of_max_aux hm₀ψ (fun m hm => hmax m (hψsupp m hm))
  exact ⟨_, ⟨ψ, hψI, hψ0, ⟨n, hψn⟩, rfl⟩, C, by rw [hψE, hEF]⟩

end FieldCase

/-- Remark 1, p. 245: "Let `S₀ → S` be a monomorphism of noetherian rings. Let
`G₀ = S₀[Z₁, …, Z_r]` and `G = S[Z₁, …, Z_r]` with `r` independent variables `Z₁, …, Z_r`.
View `G₀` and `G` as graded algebras over `S₀` and `S`, respectively, in such a way that the
homogeneous part of degree `n` is the submodule over `S₀` and `S`, respectively, generated by
the monomials of degree `n` in `Z₁, …, Z_r`. The monomorphism `S₀ → S` can be extended in a
canonical way to a monomorphism of graded algebras `G₀ → G`. Let `I₀` be a homogeneous ideal
in `G₀` and `I = I₀G`. Then, as is easily seen, the E-set `E_r(I)` of the ideal `I` in `G`
with respect to `(S; Z₁, …, Z_r)` contains the E-set `E_r(I₀)` of `I₀` in `G₀` with respect to
`(S₀; Z₁, …, Z_r)`. We have `E_r(I) = E_r(I₀)` if `S₀` does not contain any zero-divisor of
`S` (except the zero element)."

(Formalization note: "`S₀` does not contain any zero-divisor of `S` except `0`" is encoded as:
for every `a ≠ 0` in `S₀`, the image of `a` in `S` is a non-zero-divisor.)

The proof is the printed one (the inclusion; the case of a ring of fractions
`eSet_map_localization_subset`; the reduction to the case of a field `S₀ = K` through the field of
fractions of `S₀`; the field case `eSet_map_field_subset`, where `S` is a free `K`-module and
`φ' = ∑ aᵢφᵢ`), see the section "The proof of Remark 1" above. -/
@[blueprint "rem:III.7-1"
  (statement := /-- Let $S_0\to S$ be a monomorphism of noetherian rings, and let
    $G_0=S_0[Z_1,\dots,Z_r]$, $G=S[Z_1,\dots,Z_r]$ with $r$ independent variables, viewed as
    graded algebras over $S_0$ and $S$ respectively, the homogeneous part of degree $n$ being
    generated by the monomials of degree $n$ in $Z_1,\dots,Z_r$. The monomorphism $S_0\to S$
    extends canonically to a monomorphism of graded algebras $G_0\to G$. Let $I_0$ be a
    homogeneous ideal in $G_0$ and $I=I_0G$. Then the $E$-set $E_r(I)$ of $I$ in $G$ with
    respect to $(S;Z_1,\dots,Z_r)$ contains the $E$-set $E_r(I_0)$ of $I_0$ in $G_0$ with
    respect to $(S_0;Z_1,\dots,Z_r)$ (\cref{def:III.7-E-set}), and $E_r(I)=E_r(I_0)$ if $S_0$
    does not contain any zero-divisor of $S$ except the zero element. (Remark 1, p.~245.) -/)
  (proof := /-- The inclusion is clear, since every homogeneous $\varphi\in I_0$ gives a
    homogeneous element of $I$ with the same expression, hence the same $\Lambda_r$. For the
    equality, it can be easily proved when $S$ is a ring of fractions of $S_0$ with respect to
    a multiplicatively closed subset of $S_0$ which does not contain any zero-divisor of $S_0$.
    So the proof in the general case is reduced to the case in which $S_0$ is a field. In this
    case, $S$ is a free $S_0$-module. Every homogeneous element $\varphi'$ of $I$ is then
    written in the form $\varphi'=\sum a_i\varphi_i$, where the $a_i$ are elements of $S$ which
    are linearly independent over $S_0$, and the $\varphi_i$ are homogeneous elements of $I_0$
    which have the same degree as $\varphi'$. Then one can easily see that
    $\Lambda_r(\varphi')=\max_i\{\Lambda_r(\varphi_i)\}$.

    (Formalization of the reduction: $S_0$ is a domain, since it contains no zero-divisor of
    $S$; let $K$ be its field of fractions and $S_K$ the ring of fractions of $S$ with respect to
    the image of $S_0\setminus\{0\}$, a set of non-zero-divisors of $S$. Then
    $E_r(I)\subseteq E_r(IS_K[Z])$ (the inclusion, $S\to S_K$ being injective),
    $IS_K[Z]=(I_0K[Z])S_K[Z]$, so that by the field case $E_r(IS_K[Z])\subseteq E_r(I_0K[Z])$, and
    $E_r(I_0K[Z])\subseteq E_r(I_0)$ by the case of a ring of fractions of $S_0$. The
    $\varphi_i$ of the field case are the coordinate polynomials of $\varphi'$ in a basis of
    $S_K$ over $K$.) -/)
  (latexEnv := "remark")]
theorem eSet_map_of_injective {S₀ S : Type u} [CommRing S₀] [CommRing S] [IsNoetherianRing S₀]
    [IsNoetherianRing S] (α : S₀ →+* S) (hα : Function.Injective α) {r : ℕ}
    (I₀ : Ideal (MvPolynomial (Fin r) S₀))
    (hI₀ : I₀.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin r) S₀)) :
    ESet I₀ ⊆ ESet (I₀.map (MvPolynomial.map α)) ∧
      ((∀ a : S₀, a ≠ 0 → ∀ b : S, α a * b = 0 → b = 0) →
        ESet (I₀.map (MvPolynomial.map α)) = ESet I₀) := by
  classical
  have _ := hI₀
  refine ⟨eSet_subset_eSet_map α hα I₀, fun hnzd => le_antisymm ?_ (eSet_subset_eSet_map α hα I₀)⟩
  by_cases hS₀ : Subsingleton S₀
  · -- the zero ring: there is no non-zero polynomial
    have hS : Subsingleton S := ⟨fun x y => by
      rw [← one_mul x, ← one_mul y, ← map_one α, Subsingleton.elim (1 : S₀) 0, map_zero, zero_mul,
        zero_mul]⟩
    rintro _ ⟨_, ⟨φ, -, hφ0, -, rfl⟩, _, rfl⟩
    exact absurd (Subsingleton.elim φ 0) hφ0
  · have : Nontrivial S₀ := not_subsingleton_iff_nontrivial.mp hS₀
    -- `S₀` is a domain
    have hnz : NoZeroDivisors S₀ := ⟨fun {a b} hab => by
      by_contra h
      push Not at h
      exact h.2 (hα (by rw [map_zero]; exact hnzd a h.1 (α b) (by rw [← map_mul, hab, map_zero])))⟩
    have : IsDomain S₀ := NoZeroDivisors.to_isDomain S₀
    -- `K = Frac S₀` and `S_K = S ⊗_{S₀} K = T₁⁻¹ S`
    let T₁ : Submonoid S := Submonoid.map α (nonZeroDivisors S₀)
    have hT₁ : T₁ ≤ nonZeroDivisors S := by
      rintro _ ⟨a, ha, rfl⟩
      rw [mem_nonZeroDivisors_iff]
      exact ⟨fun y hy => hnzd a (nonZeroDivisors.ne_zero ha) y hy,
        fun y hy => hnzd a (nonZeroDivisors.ne_zero ha) y (by rw [mul_comm]; exact hy)⟩
    let SK := Localization T₁
    have hinj : Function.Injective (algebraMap S SK) := IsLocalization.injective SK hT₁
    have hunit : ∀ y : nonZeroDivisors S₀, IsUnit ((algebraMap S SK).comp α y) := fun y =>
      IsLocalization.map_units SK (⟨α y, y, y.2, rfl⟩ : T₁)
    let αK : FractionRing S₀ →+* SK := IsLocalization.lift hunit
    have hαK : αK.comp (algebraMap S₀ (FractionRing S₀)) = (algebraMap S SK).comp α :=
      IsLocalization.lift_comp hunit
    -- `E_r(I) ⊆ E_r(I S_K[Z]) ⊆ E_r(I₀ K[Z]) = E_r(I₀)`
    have h1 : ESet (I₀.map (MvPolynomial.map α)) ⊆
        ESet ((I₀.map (MvPolynomial.map α)).map (MvPolynomial.map (algebraMap S SK))) :=
      eSet_subset_eSet_map _ hinj _
    have h2 : (I₀.map (MvPolynomial.map α)).map (MvPolynomial.map (algebraMap S SK)) =
        (I₀.map (MvPolynomial.map (algebraMap S₀ (FractionRing S₀)))).map (MvPolynomial.map αK) := by
      have hcomp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
          (g : B →+* C), (MvPolynomial.map g : MvPolynomial (Fin r) B →+* _).comp
            (MvPolynomial.map f) = MvPolynomial.map (g.comp f) :=
        fun f g => RingHom.ext fun p => MvPolynomial.map_map f g p
      rw [Ideal.map_map, Ideal.map_map, hcomp, hcomp, hαK]
    let _ : Algebra (FractionRing S₀) SK := αK.toAlgebra
    have h3 : ESet ((I₀.map (MvPolynomial.map (algebraMap S₀ (FractionRing S₀)))).map
        (MvPolynomial.map αK)) ⊆ ESet (I₀.map (MvPolynomial.map (algebraMap S₀ (FractionRing S₀)))) :=
      eSet_map_field_subset _
    have h4 : ESet (I₀.map (MvPolynomial.map (algebraMap S₀ (FractionRing S₀)))) ⊆ ESet I₀ :=
      eSet_map_localization_subset (nonZeroDivisors S₀) le_rfl I₀
    exact h1.trans (by rw [h2]; exact h3.trans h4)

/-- The canonical injection `q : Z₀ᵗ → Z₀ʳ` of Remark 2 (p. 245): "if
`A = (a₁, …, a_t) ∈ Z₀ᵗ`, then `q(A) = (a₁, …, a_t, 0, …, 0) ∈ Z₀ʳ`." -/
def qInj (t r : ℕ) (A : Fin t → ℕ) : Fin r → ℕ :=
  fun i => if h : (i : ℕ) < t then A ⟨i, h⟩ else 0

/-- The exponents of `S[Z₁, …, Z_t] ⊆ S[Z₁, …, Z_r]` are padded by zeros: `q(A)`. -/
private theorem mapDomain_castLE_apply_aux {t r : ℕ} (h : t ≤ r) (x : Fin t →₀ ℕ) (i : Fin r) :
    Finsupp.mapDomain (Fin.castLE h) x i = qInj t r (⇑x) i := by
  unfold qInj
  split_ifs with hi
  · exact Finsupp.mapDomain_apply_of_injective (Fin.castLE_injective h) x ⟨i, hi⟩
  · refine Finsupp.mapDomain_of_notMem_range _ _ ?_
    rintro ⟨j, rfl⟩
    exact hi j.2

/-- The padding `A ↦ q(A)` is strictly monotone for the lexicographic orders. -/
private theorem toLex_mapDomain_castLE_strictMono_aux {t r : ℕ} (h : t ≤ r) :
    StrictMono fun x : Lex (Fin t →₀ ℕ) => toLex (Finsupp.mapDomain (Fin.castLE h) (ofLex x)) := by
  intro x y hxy
  obtain ⟨i, hi, hlt⟩ := Finsupp.Lex.lt_iff.mp hxy
  refine Finsupp.Lex.lt_iff.mpr ⟨Fin.castLE h i, fun j hj => ?_, ?_⟩
  · have hjt : (j : ℕ) < t := lt_trans (Fin.lt_def.mp hj) i.2
    show Finsupp.mapDomain (Fin.castLE h) (ofLex x) j = Finsupp.mapDomain (Fin.castLE h) (ofLex y) j
    rw [mapDomain_castLE_apply_aux, mapDomain_castLE_apply_aux]
    unfold qInj
    rw [dite_eq_left hjt, dite_eq_left hjt]
    exact hi ⟨j, hjt⟩ (Fin.lt_def.mpr (Fin.lt_def.mp hj))
  · show Finsupp.mapDomain (Fin.castLE h) (ofLex x) (Fin.castLE h i) <
      Finsupp.mapDomain (Fin.castLE h) (ofLex y) (Fin.castLE h i)
    rw [Finsupp.mapDomain_apply_of_injective (Fin.castLE_injective h),
      Finsupp.mapDomain_apply_of_injective (Fin.castLE_injective h)]
    exact hlt

/-- Part of Remark 2: `Λ_r(φ) = q(Λ_t(φ))` for a non-zero `φ ∈ S[Z₁, …, Z_t]`. -/
private theorem eFunction_rename_castLE_aux {S : Type u} [CommRing S] {t r : ℕ} (h : t ≤ r)
    {φ : MvPolynomial (Fin t) S} (hφ : φ ≠ 0) :
    EFunction (MvPolynomial.rename (Fin.castLE h) φ) = qInj t r (EFunction φ) := by
  classical
  obtain ⟨m, hm, hEF, hmax⟩ := eFunction_spec_aux hφ
  have hsupp := MvPolynomial.support_rename_of_injective (p := φ) (Fin.castLE_injective h)
  rw [hEF, eFunction_eq_of_max_aux (m := Finsupp.mapDomain (Fin.castLE h) m)
    (by rw [hsupp]; exact Finset.mem_image_of_mem _ hm) ?_]
  · funext i
    exact mapDomain_castLE_apply_aux h m i
  · intro m' hm'
    rw [hsupp] at hm'
    obtain ⟨m'', hm'', rfl⟩ := Finset.mem_image.mp hm'
    exact (toLex_mapDomain_castLE_strictMono_aux h).monotone (hmax m'' hm'')

section Remark2Proof

variable {S : Type u} [CommRing S] {t r : ℕ}

/-- A monomial `T = Z^b` of `G' = S[Z_{t+1}, …, Z_r]`: an exponent `b` of `Z₀ʳ` vanishing on the
first `t` coordinates. -/
private def IsTailExponent (h : t ≤ r) (b : Fin r →₀ ℕ) : Prop :=
  ∀ k : Fin t, b (Fin.castLE h k) = 0

private theorem IsTailExponent.add {h : t ≤ r} {b b' : Fin r →₀ ℕ} (hb : IsTailExponent h b)
    (hb' : IsTailExponent h b') : IsTailExponent h (b + b') := fun k => by
  simp [hb k, hb' k]

/-- Every exponent of `Z₀ʳ` is `q(a) + b` with `a ∈ Z₀ᵗ` and `b` a tail exponent. -/
private theorem exists_mapDomain_add_tail (h : t ≤ r) (m : Fin r →₀ ℕ) :
    ∃ (a : Fin t →₀ ℕ) (b : Fin r →₀ ℕ), IsTailExponent h b ∧
      m = Finsupp.mapDomain (Fin.castLE h) a + b := by
  have hle : Finsupp.mapDomain (Fin.castLE h)
      (Finsupp.equivFunOnFinite.symm fun i => m (Fin.castLE h i)) ≤ m := by
    intro j
    rw [mapDomain_castLE_apply_aux]
    unfold qInj
    split_ifs with hj
    · simp [show Fin.castLE h ⟨j, hj⟩ = j from Fin.ext rfl]
    · exact Nat.zero_le _
  refine ⟨_, _, fun i => ?_, (add_tsub_cancel_of_le hle).symm⟩
  rw [Finsupp.tsub_apply, Finsupp.mapDomain_apply_of_injective (Fin.castLE_injective _)]
  simp

/-- The exponents of `ψ T`, `T = Z^b` a monomial of `G'` and `ψ ∈ G₀`, are `q(a) + b` with `a` an
exponent of `ψ`. -/
private theorem exists_mem_support_of_mem_support_mul_monomial {h : t ≤ r}
    {ψ : MvPolynomial (Fin t) S} (b : Fin r →₀ ℕ) {m : Fin r →₀ ℕ}
    (hm : m ∈ (MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1).support) :
    ∃ a ∈ ψ.support, m = Finsupp.mapDomain (Fin.castLE h) a + b := by
  classical
  rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul_monomial'] at hm
  split_ifs at hm with hbm
  · have h1 : m - b ∈ (MvPolynomial.rename (Fin.castLE h) ψ).support := by
      rw [MvPolynomial.mem_support_iff]
      intro h0
      apply hm
      rw [h0, zero_mul]
    rw [MvPolynomial.support_rename_of_injective (Fin.castLE_injective h)] at h1
    obtain ⟨a, ha, hma⟩ := Finset.mem_image.mp h1
    exact ⟨a, ha, by rw [hma, tsub_add_cancel_of_le hbm]⟩
  · exact absurd rfl hm

/-- "No two of the `φ_i` have a common monomial": the monomials of `ψ T`, `ψ` a form of degree
`i` of `G₀` and `T = Z^b` a monomial of `G'`, have degree `i` in `Z₁, …, Z_t`. -/
private theorem sum_apply_castLE_eq_of_mem_support {h : t ≤ r} {i : ℕ} {ψ : MvPolynomial (Fin t) S}
    (hψ : ψ ∈ MvPolynomial.homogeneousSubmodule (Fin t) S i) {b : Fin r →₀ ℕ}
    (hb : IsTailExponent h b) {m : Fin r →₀ ℕ}
    (hm : m ∈ (MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1).support) :
    ∑ k : Fin t, m (Fin.castLE h k) = i := by
  obtain ⟨a, ha, rfl⟩ := exists_mem_support_of_mem_support_mul_monomial b hm
  have hdeg : a.degree = i := by
    by_contra hne
    exact (MvPolynomial.mem_support_iff.mp ha)
      (((MvPolynomial.mem_homogeneousSubmodule _ _).mp hψ).coeff_eq_zero hne)
  rw [← hdeg, Finsupp.degree_eq_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [Finsupp.coe_add, Pi.add_apply, hb k, add_zero,
    Finsupp.mapDomain_apply_of_injective (Fin.castLE_injective h)]

/-- The monomials of `ψ T`, `T = Z^b`, agree with `b` in the variables `Z_{t+1}, …, Z_r`. -/
private theorem apply_eq_of_mem_support {h : t ≤ r} {ψ : MvPolynomial (Fin t) S}
    {b : Fin r →₀ ℕ} {m : Fin r →₀ ℕ}
    (hm : m ∈ (MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1).support)
    {k : Fin r} (hk : ¬ (k : ℕ) < t) : m k = b k := by
  obtain ⟨a, -, rfl⟩ := exists_mem_support_of_mem_support_mul_monomial b hm
  rw [Finsupp.coe_add, Pi.add_apply, mapDomain_castLE_apply_aux]
  unfold qInj
  rw [dite_eq_right_iff.mpr (fun hk' => absurd hk' hk), zero_add]

/-- The products `ψ T` for distinct monomials `T` of `G'` have no common monomial. -/
private theorem not_mem_support_of_ne {h : t ≤ r} {ψ ψ' : MvPolynomial (Fin t) S}
    {b b' : Fin r →₀ ℕ} (hb : IsTailExponent h b) (hb' : IsTailExponent h b') (hbb : b ≠ b')
    {m : Fin r →₀ ℕ}
    (hm : m ∈ (MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1).support) :
    m ∉ (MvPolynomial.rename (Fin.castLE h) ψ' * MvPolynomial.monomial b' 1).support := by
  intro hm'
  obtain ⟨k, hk⟩ := Finsupp.ne_iff.mp hbb
  by_cases hkt : (k : ℕ) < t
  · apply hk
    have e1 := hb ⟨k, hkt⟩
    have e2 := hb' ⟨k, hkt⟩
    rw [show Fin.castLE h ⟨k, hkt⟩ = k from Fin.ext rfl] at e1 e2
    rw [e1, e2]
  · exact hk ((apply_eq_of_mem_support hm hkt).symm.trans (apply_eq_of_mem_support hm' hkt))

/-- If a sum `Σ_k φ_k` has the property that no two of the `φ_k` have a common monomial, then
`Λ_r(Σ φ_k) = Λ_r(φ_k)` for some `k` with `φ_k ≠ 0` ("Hence `Λ_r(φ_i) = Λ_r(φ')` for some `i`",
p. 246). -/
private theorem exists_eFunction_eq_of_sum_of_disjoint {ι : Type*} {s : Finset ι}
    {φ : ι → MvPolynomial (Fin r) S}
    (hdisj : ∀ k ∈ s, ∀ k' ∈ s, k ≠ k' → ∀ m ∈ (φ k).support, m ∉ (φ k').support)
    (h0 : ∑ k ∈ s, φ k ≠ 0) :
    ∃ k ∈ s, φ k ≠ 0 ∧ EFunction (∑ k ∈ s, φ k) = EFunction (φ k) := by
  classical
  have hcoeff : ∀ k ∈ s, ∀ m ∈ (φ k).support,
      (∑ k' ∈ s, φ k').coeff m = (φ k).coeff m := by
    intro k hk m hm
    rw [MvPolynomial.coeff_sum]
    refine Finset.sum_eq_single_of_mem k hk fun k' hk' hkk' => ?_
    by_contra hne
    exact hdisj k' hk' k hk hkk' m (MvPolynomial.mem_support_iff.mpr hne) hm
  obtain ⟨m, hm, hEF, hmax⟩ := eFunction_spec_aux h0
  have hex : ∃ k ∈ s, m ∈ (φ k).support := by
    by_contra hcon
    push Not at hcon
    rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sum] at hm
    exact hm (Finset.sum_eq_zero fun k hk => by
      simpa [MvPolynomial.mem_support_iff] using hcon k hk)
  obtain ⟨k, hk, hmk⟩ := hex
  refine ⟨k, hk, MvPolynomial.support_nonempty.mp ⟨m, hmk⟩, ?_⟩
  rw [hEF, eFunction_eq_of_max_aux hmk fun m' hm' => hmax m' ?_]
  rw [MvPolynomial.mem_support_iff, hcoeff k hk m' hm']
  exact MvPolynomial.mem_support_iff.mp hm'

/-- `Λ_r(ψ T_j) = q(Λ_t(ψ)) + Λ_r(T_j)` for `ψ ≠ 0` in `G₀` and `T = Z^b` (p. 246). -/
private theorem eFunction_rename_mul_monomial {h : t ≤ r} {ψ : MvPolynomial (Fin t) S}
    (hψ : ψ ≠ 0) (b : Fin r →₀ ℕ) :
    EFunction (MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1) =
      qInj t r (EFunction ψ) + ⇑b := by
  have hne : MvPolynomial.rename (Fin.castLE h) ψ ≠ 0 := fun h0 =>
    hψ (MvPolynomial.rename_injective _ (Fin.castLE_injective _) (by rw [h0, map_zero]))
  rw [mul_comm, (eFunction_monomial_mul b hne).2, eFunction_rename_castLE_aux h hψ, add_comm]

/-- The `S`-submodule `I₀(i) G'(j)` of `G = S[Z₁, …, Z_r]` (p. 246): it is generated by the
products `ψ T` with `ψ ∈ I₀(i)` and `T` a monomial of degree `j` of `G' = S[Z_{t+1}, …, Z_r]`,
and its elements are the sums `Σ_b ψ_b T_b` of the paper (`T_b = Z^b` distinct monomials of degree
`j` in `Z_{t+1}, …, Z_r`, `ψ_b ∈ I₀(i)`), which is how it is encoded here (a finitely supported
family `b ↦ ψ_b`). -/
private def bihomPiece (I₀ : Ideal (MvPolynomial (Fin t) S)) (h : t ≤ r) (i j : ℕ) :
    Submodule S (MvPolynomial (Fin r) S) where
  carrier := {y | ∃ ψ : (Fin r →₀ ℕ) →₀ MvPolynomial (Fin t) S,
    (∀ b, ψ b ≠ 0 → IsTailExponent h b ∧ b.degree = j) ∧
    (∀ b, ψ b ∈ I₀ ∧ ψ b ∈ MvPolynomial.homogeneousSubmodule (Fin t) S i) ∧
    y = ψ.sum fun b p => MvPolynomial.rename (Fin.castLE h) p * MvPolynomial.monomial b 1}
  zero_mem' := ⟨0, fun b hb => absurd rfl hb, fun b => ⟨zero_mem _, zero_mem _⟩, by simp⟩
  add_mem' := by
    rintro _ _ ⟨ψ, h1, h2, rfl⟩ ⟨ψ', h1', h2', rfl⟩
    refine ⟨ψ + ψ', fun b hb => ?_, fun b => ?_, ?_⟩
    · by_cases hψ : ψ b = 0
      · exact h1' b (by rwa [Finsupp.add_apply, hψ, zero_add] at hb)
      · exact h1 b hψ
    · rw [Finsupp.add_apply]
      exact ⟨add_mem (h2 b).1 (h2' b).1, add_mem (h2 b).2 (h2' b).2⟩
    · rw [Finsupp.sum_add_index']
      · intro b
        simp
      · intro b p q
        simp [add_mul]
  smul_mem' := by
    rintro s _ ⟨ψ, h1, h2, rfl⟩
    refine ⟨s • ψ, fun b hb => h1 b fun h0 => hb (by rw [Finsupp.smul_apply, h0, smul_zero]),
      fun b => ?_, ?_⟩
    · rw [Finsupp.smul_apply, MvPolynomial.smul_eq_C_mul]
      exact ⟨I₀.mul_mem_left _ (h2 b).1, by
        rw [← MvPolynomial.smul_eq_C_mul]
        exact Submodule.smul_mem _ _ (h2 b).2⟩
    · rw [Finsupp.sum_smul_index' (fun b => by simp), Finsupp.smul_sum]
      refine Finset.sum_congr rfl fun b _ => ?_
      simp

/-- The generators `ψ T` (`ψ ∈ I₀` a form, `T` a monomial of `G'`) of the ideal `I = I₀ G`, as an
`S`-module. -/
private def bihomGen (I₀ : Ideal (MvPolynomial (Fin t) S)) (h : t ≤ r) :
    Set (MvPolynomial (Fin r) S) :=
  {y | ∃ ψ ∈ I₀, ∃ i, ψ ∈ MvPolynomial.homogeneousSubmodule (Fin t) S i ∧
    ∃ b, IsTailExponent h b ∧ y = MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1}

private theorem monomial_mul_mem_bihomGen {I₀ : Ideal (MvPolynomial (Fin t) S)} {h : t ≤ r}
    (w : Fin r →₀ ℕ) {y : MvPolynomial (Fin r) S} (hy : y ∈ bihomGen I₀ h) :
    MvPolynomial.monomial w 1 * y ∈ bihomGen I₀ h := by
  obtain ⟨ψ, hψ, i, hψi, b, hb, rfl⟩ := hy
  obtain ⟨a, b', hb', rfl⟩ := exists_mapDomain_add_tail h w
  refine ⟨MvPolynomial.monomial a 1 * ψ, I₀.mul_mem_left _ hψ, a.degree + i, ?_, b' + b,
    hb'.add hb, ?_⟩
  · rw [MvPolynomial.mem_homogeneousSubmodule] at hψi ⊢
    exact (MvPolynomial.isHomogeneous_monomial _ rfl).mul hψi
  · have e1 : MvPolynomial.monomial (Finsupp.mapDomain (Fin.castLE h) a + b') (1 : S) =
        MvPolynomial.monomial (Finsupp.mapDomain (Fin.castLE h) a) 1 *
          MvPolynomial.monomial b' 1 := by
      rw [MvPolynomial.monomial_mul_monomial, mul_one]
    have e2 : MvPolynomial.monomial (b' + b) (1 : S) =
        MvPolynomial.monomial b' 1 * MvPolynomial.monomial b 1 := by
      rw [MvPolynomial.monomial_mul_monomial, mul_one]
    rw [map_mul, MvPolynomial.rename_monomial, e1, e2]
    ring

private theorem monomial_mul_mem_span_bihomGen (I₀ : Ideal (MvPolynomial (Fin t) S)) (h : t ≤ r)
    (w : Fin r →₀ ℕ) {y : MvPolynomial (Fin r) S} (hy : y ∈ Submodule.span S (bihomGen I₀ h)) :
    MvPolynomial.monomial w 1 * y ∈ Submodule.span S (bihomGen I₀ h) := by
  induction hy using Submodule.span_induction with
  | mem y hy => exact Submodule.subset_span (monomial_mul_mem_bihomGen w hy)
  | zero => rw [mul_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | smul d x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hx

private theorem mul_mem_span_bihomGen (I₀ : Ideal (MvPolynomial (Fin t) S)) (h : t ≤ r)
    (c : MvPolynomial (Fin r) S) {y : MvPolynomial (Fin r) S}
    (hy : y ∈ Submodule.span S (bihomGen I₀ h)) :
    c * y ∈ Submodule.span S (bihomGen I₀ h) := by
  induction c using MvPolynomial.induction_on' with
  | monomial w s =>
    have e : MvPolynomial.monomial w s * y = s • (MvPolynomial.monomial w 1 * y) := by
      rw [MvPolynomial.smul_eq_C_mul, ← mul_assoc, MvPolynomial.C_mul_monomial, mul_one]
    rw [e]
    exact Submodule.smul_mem _ _ (monomial_mul_mem_span_bihomGen I₀ h w hy)
  | add p q hp hq => rw [add_mul]; exact add_mem hp hq

/-- The ideal of `G` generated (as an `S`-module) by the products `ψ T`: it contains `I = I₀ G`. -/
private def bihomIdeal (I₀ : Ideal (MvPolynomial (Fin t) S)) (h : t ≤ r) :
    Ideal (MvPolynomial (Fin r) S) where
  carrier := Submodule.span S (bihomGen I₀ h)
  add_mem' := add_mem
  zero_mem' := zero_mem _
  smul_mem' := fun c y hy => by
    rw [smul_eq_mul]
    exact mul_mem_span_bihomGen I₀ h c hy

private theorem rename_mem_bihomIdeal {I₀ : Ideal (MvPolynomial (Fin t) S)}
    (hI₀ : I₀.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin t) S)) (h : t ≤ r)
    {g : MvPolynomial (Fin t) S} (hg : g ∈ I₀) :
    MvPolynomial.rename (Fin.castLE h) g ∈ bihomIdeal I₀ h := by
  show _ ∈ Submodule.span S (bihomGen I₀ h)
  rw [← MvPolynomial.sum_homogeneousComponent g, map_sum]
  refine Submodule.sum_mem _ fun i _ => Submodule.subset_span ⟨MvPolynomial.homogeneousComponent i g,
    MvPolynomial.homogeneousComponent_mem_of_mem hI₀ hg i, i,
    MvPolynomial.homogeneousComponent_mem i g, 0, fun k => rfl, ?_⟩
  rw [← MvPolynomial.C_apply, map_one, mul_one]

/-- "`I(n) = Σ_{i=0}^n I₀(i) G'(n-i)`" (p. 246): the elements `Σ_{i=0}^n φ_i` with
`φ_i ∈ I₀(i) G'(n-i)`. -/
private def decompPiece (I₀ : Ideal (MvPolynomial (Fin t) S)) (h : t ≤ r) (n : ℕ) :
    Submodule S (MvPolynomial (Fin r) S) where
  carrier := {y | ∃ φ : ℕ → MvPolynomial (Fin r) S,
    (∀ i, φ i ∈ bihomPiece I₀ h i (n - i)) ∧ y = ∑ i ∈ Finset.range (n + 1), φ i}
  zero_mem' := ⟨0, fun i => zero_mem _, by simp⟩
  add_mem' := by
    rintro _ _ ⟨φ, hφ, rfl⟩ ⟨φ', hφ', rfl⟩
    exact ⟨φ + φ', fun i => add_mem (hφ i) (hφ' i), by simp [Finset.sum_add_distrib]⟩
  smul_mem' := by
    rintro s _ ⟨φ, hφ, rfl⟩
    exact ⟨s • φ, fun i => Submodule.smul_mem _ _ (hφ i), by simp [Finset.smul_sum]⟩

private theorem homogeneousComponent_mem_decompPiece {I₀ : Ideal (MvPolynomial (Fin t) S)}
    {h : t ≤ r} {y : MvPolynomial (Fin r) S} (hy : y ∈ Submodule.span S (bihomGen I₀ h)) (n : ℕ) :
    MvPolynomial.homogeneousComponent n y ∈ decompPiece I₀ h n := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨ψ, hψ, i, hψi, b, hb, rfl⟩ := hy
    have hhom : MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1 ∈
        MvPolynomial.homogeneousSubmodule (Fin r) S (i + b.degree) := by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hψi ⊢
      exact hψi.rename_isHomogeneous.mul (MvPolynomial.isHomogeneous_monomial _ rfl)
    rw [MvPolynomial.homogeneousComponent_of_mem hhom]
    split_ifs with hni
    · have hpiece : MvPolynomial.rename (Fin.castLE h) ψ * MvPolynomial.monomial b 1 ∈
          bihomPiece I₀ h i (n - i) := by
        have hnb : n - i = b.degree := by omega
        rw [hnb]
        refine ⟨Finsupp.single b ψ, fun b' hb' => ?_, fun b' => ?_, ?_⟩
        · by_cases hbb : b = b'
          · subst hbb
            exact ⟨hb, rfl⟩
          · rw [Finsupp.single_eq_of_ne (Ne.symm hbb)] at hb'
            exact absurd rfl hb'
        · by_cases hbb : b = b'
          · subst hbb
            rw [Finsupp.single_eq_same]
            exact ⟨hψ, hψi⟩
          · rw [Finsupp.single_eq_of_ne (Ne.symm hbb)]
            exact ⟨zero_mem _, zero_mem _⟩
        · rw [Finsupp.sum_single_index (by simp)]
      refine ⟨fun k => if k = i then MvPolynomial.rename (Fin.castLE h) ψ *
          MvPolynomial.monomial b 1 else 0, fun k => ?_, ?_⟩
      · by_cases hk : k = i
        · subst hk
          simpa using hpiece
        · simp [hk]
      · have hi : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
        simp [hi]
    · exact zero_mem _
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul s x _ hx => rw [map_smul]; exact Submodule.smul_mem _ _ hx

/-- "`I(n) = Σ_{i=0}^n I₀(i) G'(n-i)`" (p. 246; the inclusion `⊆` is what the proof uses): a form
`φ'` of degree `n` of `I = I₀ G` can be written `Σ_{i=0}^n φ_i` with `φ_i ∈ I₀(i) G'(n-i)`. -/
private theorem mem_decompPiece_of_mem_map {I₀ : Ideal (MvPolynomial (Fin t) S)}
    (hI₀ : I₀.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin t) S)) (h : t ≤ r)
    {φ' : MvPolynomial (Fin r) S}
    (hφ'I : φ' ∈ I₀.map (MvPolynomial.rename (R := S) (Fin.castLE h))) {n : ℕ}
    (hφ'n : φ' ∈ MvPolynomial.homogeneousSubmodule (Fin r) S n) :
    φ' ∈ decompPiece I₀ h n := by
  have hle : I₀.map (MvPolynomial.rename (R := S) (Fin.castLE h)) ≤ bihomIdeal I₀ h :=
    Ideal.map_le_iff_le_comap.mpr fun g hg => rename_mem_bihomIdeal hI₀ h hg
  have h1 : φ' ∈ Submodule.span S (bihomGen I₀ h) := hle hφ'I
  have := homogeneousComponent_mem_decompPiece h1 n
  rwa [MvPolynomial.homogeneousComponent_of_mem hφ'n, ite_eq_left rfl] at this

/-- "Moreover, if `φ ∈ I₀(i) G'(n-i)` is written `φ = Σ_j ψ_j T_j` … then
`Λ_r(φ) = max {Λ_r(ψ_j T_j)} = max {q(Λ_t(ψ_j)) + Λ_r(T_j)}`" (p. 246): `Λ_r(φ) = q(Λ_t(ψ)) + b`
for a non-zero `ψ ∈ I₀(i)` and a monomial `Z^b` of `G'`. -/
private theorem exists_eFunction_of_mem_bihomPiece {I₀ : Ideal (MvPolynomial (Fin t) S)}
    {h : t ≤ r} {i j : ℕ} {y : MvPolynomial (Fin r) S} (hy : y ∈ bihomPiece I₀ h i j)
    (hy0 : y ≠ 0) :
    ∃ ψ ∈ I₀, ψ ≠ 0 ∧ ψ ∈ MvPolynomial.homogeneousSubmodule (Fin t) S i ∧
      ∃ b : Fin r →₀ ℕ, EFunction y = qInj t r (EFunction ψ) + ⇑b := by
  obtain ⟨ψ, h1, h2, rfl⟩ := hy
  rw [Finsupp.sum] at hy0 ⊢
  obtain ⟨b, hb, hb0, hEF⟩ := exists_eFunction_eq_of_sum_of_disjoint
    (s := ψ.support) (φ := fun b => MvPolynomial.rename (Fin.castLE h) (ψ b) *
      MvPolynomial.monomial b 1)
    (fun k hk k' hk' hkk' m hm => not_mem_support_of_ne
      (h1 k (Finsupp.mem_support_iff.mp hk)).1 (h1 k' (Finsupp.mem_support_iff.mp hk')).1 hkk' hm)
    hy0
  have hψb : ψ b ≠ 0 := fun h0 => hb0 (by rw [h0, map_zero, zero_mul])
  exact ⟨ψ b, (h2 b).1, hψb, (h2 b).2, b, hEF.trans (eFunction_rename_mul_monomial hψb b)⟩

/-- "No two of the `φ_i` have a common monomial": the monomials of an element of `I₀(i) G'(j)` have
degree `i` in `Z₁, …, Z_t`. -/
private theorem sum_apply_castLE_eq_of_mem_bihomPiece {I₀ : Ideal (MvPolynomial (Fin t) S)}
    {h : t ≤ r} {i j : ℕ} {y : MvPolynomial (Fin r) S} (hy : y ∈ bihomPiece I₀ h i j)
    {m : Fin r →₀ ℕ} (hm : m ∈ y.support) : ∑ k : Fin t, m (Fin.castLE h k) = i := by
  classical
  obtain ⟨ψ, h1, h2, rfl⟩ := hy
  rw [Finsupp.sum] at hm
  obtain ⟨b, hb, hmb⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hm)
  exact sum_apply_castLE_eq_of_mem_support (h2 b).2 (h1 b (Finsupp.mem_support_iff.mp hb)).1 hmb

/-- "Let `φ'` be an arbitrary element of `I` which is homogeneous of degree `n`. If we write
`φ' = Σ_{i=0}^n φ_i` with `φ_i ∈ I₀(i) G'(n-i)`, then we see that no two of the `φ_i` have a common
monomial with non-zero coefficients. Hence `Λ_r(φ_i) = Λ_r(φ')` for some `i`" (p. 246), together
with the last assertion of the paragraph. -/
private theorem exists_eFunction_of_mem_decompPiece {I₀ : Ideal (MvPolynomial (Fin t) S)}
    {h : t ≤ r} {n : ℕ} {y : MvPolynomial (Fin r) S} (hy : y ∈ decompPiece I₀ h n)
    (hy0 : y ≠ 0) :
    ∃ ψ ∈ I₀, ψ ≠ 0 ∧ (∃ i, ψ ∈ MvPolynomial.homogeneousSubmodule (Fin t) S i) ∧
      ∃ b : Fin r →₀ ℕ, EFunction y = qInj t r (EFunction ψ) + ⇑b := by
  obtain ⟨φ, hφ, rfl⟩ := hy
  obtain ⟨i, -, hφi0, hEF⟩ := exists_eFunction_eq_of_sum_of_disjoint
    (s := Finset.range (n + 1)) (φ := φ)
    (fun i _ i' _ hii' m hm hm' => hii'
      ((sum_apply_castLE_eq_of_mem_bihomPiece (hφ i) hm).symm.trans
        (sum_apply_castLE_eq_of_mem_bihomPiece (hφ i') hm')))
    hy0
  obtain ⟨ψ, hψ, hψ0, hψi, b, hb⟩ := exists_eFunction_of_mem_bihomPiece (hφ i) hφi0
  exact ⟨ψ, hψ, hψ0, ⟨i, hψi⟩, b, hEF.trans hb⟩

end Remark2Proof


/-- Remark 2, pp. 245–246: "Let `S` be a noetherian ring. Let `(Z₁, …, Z_r)` be a system of
independent variables over `S`. Let `t` be an integer such that `1 ≤ t < r`. Let
`G₀ = S[Z₁, …, Z_t]` and `G = S[Z₁, …, Z_r]`. Let `I₀` be a homogeneous ideal in `G₀` and
`I = I₀G`. Let `E_t(I₀)` be the E-set of `I₀` with respect to `(S; Z₁, …, Z_t)`, and `E_r(I)`
the E-set of `I` with respect to `(S; Z₁, …, Z_r)`. Then `E_t(I₀)` is an E-subset of `Z₀ᵗ` and
`E_r(I)` an E-subset of `Z₀ʳ`. We have a canonical injection `q : Z₀ᵗ → Z₀ʳ` such that, if
`A = (a₁, …, a_t) ∈ Z₀ᵗ`, then `q(A) = (a₁, …, a_t, 0, …, 0) ∈ Z₀ʳ`. We can prove that `E_r(I)`
is bounded by `q(E_t(I₀))`."

The proof is the printed one (p. 246), step by step (`exists_eFunction_of_mem_decompPiece`): a form
`φ'` of degree `n` of `I` is written `Σ_{i=0}^n φ_i` with `φ_i ∈ I₀(i) G'(n-i)`
(`mem_decompPiece_of_mem_map`, "`I(n) = Σ I₀(i) G'(n-i)`"); no two of the `φ_i` have a common
monomial (the monomials of `φ_i` have degree `i` in `Z₁, …, Z_t`), hence `Λ_r(φ_i) = Λ_r(φ')` for
some `i`; and `φ_i = Σ_j ψ_j T_j` with distinct monomials `T_j` of `Z_{t+1}, …, Z_r` and
`ψ_j ∈ I₀(i)` (`exists_eFunction_of_mem_bihomPiece`), where the `ψ_j T_j` again have no common
monomial (they differ in the exponents of `Z_{t+1}, …, Z_r`) and
`Λ_r(ψ_j T_j) = q(Λ_t(ψ_j)) + Λ_r(T_j)`.  The steps the paper does not argue are proved: the
inclusion `⊆` of "`I(n) = Σ I₀(i) G'(n-i)`" (the ideal generated as an `S`-module by the products
`ψ T` is an ideal containing `I₀ G`), "we see that no two of the `φ_i` have a common monomial", the
disjointness of the supports of the `ψ_j T_j` behind "`Λ_r(φ) = max {Λ_r(ψ_j T_j)}`", and
`Λ_r(ψ_j T_j) = q(Λ_t(ψ_j)) + Λ_r(T_j)`.  (The maximum over `j` is taken as "some `j`": the
disjointness of supports gives `Λ_r(φ) = Λ_r(ψ_jT_j)` for the `j` carrying the largest exponent.) -/
@[blueprint "rem:III.7-2"
  (statement := /-- Let $S$ be a noetherian ring, $(Z_1,\dots,Z_r)$ a system of independent
    variables over $S$, and $t$ an integer with $1\le t<r$. Let $G_0=S[Z_1,\dots,Z_t]$ and
    $G=S[Z_1,\dots,Z_r]$. Let $I_0$ be a homogeneous ideal in $G_0$ and $I=I_0G$. Let
    $E_t(I_0)$ be the $E$-set of $I_0$ with respect to $(S;Z_1,\dots,Z_t)$ and $E_r(I)$ the
    $E$-set of $I$ with respect to $(S;Z_1,\dots,Z_r)$ (\cref{def:III.7-E-set}). Then
    $E_t(I_0)$ is an $E$-subset of $\mathbb Z^t_0$ and $E_r(I)$ an $E$-subset of
    $\mathbb Z^r_0$. Let $q\colon\mathbb Z^t_0\to\mathbb Z^r_0$ be the canonical injection,
    $q(a_1,\dots,a_t)=(a_1,\dots,a_t,0,\dots,0)$. Then $E_r(I)$ is bounded by $q(E_t(I_0))$
    (\cref{def:III.7-bound}). (Remark 2, pp.~245--246.) -/)
  (proof := /-- In fact, let $G'$ be the graded $S$-subalgebra of $G$ generated by
    $Z_{t+1},\dots,Z_r$. Let $I(n)$, $I_0(n)$, $G'(n)$ denote the homogeneous part of degree
    $n$ of $I$, $I_0$, $G'$ respectively. Then we have
    $I(n)=\sum_{i=0}^n I_0(i)G'(n-i)$. Let $\varphi'$ be an arbitrary element of $I$ which is
    homogeneous of degree $n$. If we write $\varphi'=\sum_{i=0}^n\varphi'_i$ with
    $\varphi'_i\in I_0(i)G'(n-i)$. Then we see that no two of the $\varphi'_i$ have a common
    monomial with non-zero coefficients. Hence $\Lambda_r(\varphi'_i)=\Lambda_r(\varphi')$ for
    some $i$, where $\Lambda_r$ denotes the $E$-function of $G$ with respect to
    $(S;Z_1,\dots,Z_r)$. Moreover, if $\varphi'\in I_0(i)G'(n-i)$ and if $\varphi'$ is written in
    the form $\varphi'=\sum_j\varphi_j T_j$ where $T_j$ are distinct monomials of degree
    $n-i$ in $Z_{t+1},\dots,Z_r$, and $\varphi_j\in I_0(i)$, then we have
    $\Lambda_r(\varphi')=\max_j\{\Lambda_r(\varphi_jT_j)\}
    =\max_j\{q(\Lambda_t(\varphi_j))+\Lambda_r(T_j)\}$, where $\Lambda_t$ denotes the
    $E$-function of $G_0$ with respect to $(S,Z_1,\dots,Z_t)$. (Steps the paper does not argue
    are proved in the formalization: the inclusion $I(n)\subseteq\sum_iI_0(i)G'(n-i)$; that no
    two of the $\varphi'_i$ have a common monomial, namely the monomials of $\varphi'_i$ have
    degree $i$ in $Z_1,\dots,Z_t$; that no two of the $\varphi_jT_j$ have a common monomial,
    namely they differ in the exponents of $Z_{t+1},\dots,Z_r$, so that
    $\Lambda_r(\varphi')=\max_j\Lambda_r(\varphi_jT_j)$; and
    $\Lambda_r(\varphi_jT_j)=q(\Lambda_t(\varphi_j))+\Lambda_r(T_j)$. The printed text writes the
    $E$-function as $A^r$; the formalization writes $\Lambda_r$.) -/)
  (latexEnv := "remark")]
theorem eSet_isBound_qInj_image {S : Type u} [CommRing S] [IsNoetherianRing S] {t r : ℕ}
    (ht : 1 ≤ t) (htr : t < r) (I₀ : Ideal (MvPolynomial (Fin t) S))
    (hI₀ : I₀.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin t) S)) :
    IsBound (qInj t r '' ESet I₀)
      (ESet (I₀.map (MvPolynomial.rename (R := S) (Fin.castLE htr.le)))) := by
  classical
  have _ := ht
  refine ⟨?_, ?_⟩
  · -- `q(E_t(I₀)) ⊆ E_r(I)`: `q(Λ_t(φ)) = Λ_r(φ)` for the forms `φ` of `I₀`
    rintro _ ⟨A, hA, rfl⟩
    obtain ⟨φ, hφI, hφ0, ⟨n, hφn⟩, rfl⟩ := (mem_eSet_iff I₀ hI₀ A).mp hA
    refine ⟨_, ⟨MvPolynomial.rename (Fin.castLE htr.le) φ, Ideal.mem_map_of_mem _ hφI,
      fun h0 => hφ0 (MvPolynomial.rename_injective _ (Fin.castLE_injective _) (by rw [h0,
        map_zero])), ⟨n, ?_⟩, rfl⟩, 0, ?_⟩
    · rw [MvPolynomial.mem_homogeneousSubmodule] at hφn ⊢
      exact hφn.rename_isHomogeneous
    · rw [add_zero, eFunction_rename_castLE_aux _ hφ0]
  · -- the printed argument (p. 246): decompose a form `φ'` of `I` as `Σ_{i=0}^n φ_i` with
    -- `φ_i ∈ I₀(i) G'(n-i)`, no two `φ_i` having a common monomial, so `Λ_r(φ') = Λ_r(φ_i)`;
    -- write `φ_i = Σ_j ψ_j T_j` and use `Λ_r(ψ_j T_j) = q(Λ_t(ψ_j)) + Λ_r(T_j)`
    rintro _ ⟨_, ⟨φ', hφ'I, hφ'0, ⟨n, hφ'n⟩, rfl⟩, B', rfl⟩
    obtain ⟨ψ, hψI, hψ0, ⟨i, hψi⟩, b, hb⟩ := exists_eFunction_of_mem_decompPiece
      (mem_decompPiece_of_mem_map hI₀ htr.le hφ'I hφ'n) hφ'0
    refine ⟨qInj t r (EFunction ψ), ⟨EFunction ψ,
      (mem_eSet_iff I₀ hI₀ _).mpr ⟨ψ, hψI, hψ0, ⟨i, hψi⟩, rfl⟩, rfl⟩, ⇑b + B', ?_⟩
    rw [hb, add_assoc]

end Remarks

/-! ### The subalgebra `k[Z₁, …, Z_r]` of `gr_M(R)` and the E-set of a system (p. 246) -/

section FrameSubalgebra

variable {R : Type u} [CommRing R] [IsLocalRing R] {r : ℕ}

/-- The initial form `Z_j` of `z_j` in `gr_M(R)` (p. 246, p. 248). -/
noncomputable def frameForm (z : Fin r → R) (j : Fin r) : AssocGraded (maximalIdeal R) :=
  initialForm (maximalIdeal R) (z j)

/-- p. 246: "`k[Z₁, …, Z_r]` the graded `k`-subalgebra of `gr_M(R)` which is generated by the
initial forms `Z_j` of `z_j` in `gr_M(R)` for `1 ≤ j ≤ r`"; this is the *associated (graded)
subalgebra* of the frame (Definition 9(1), p. 248, whose blueprint node is
`def:III.9-associated-subalgebra`). -/
noncomputable def assocSubalgebra (z : Fin r → R) :
    Subalgebra (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
  Algebra.adjoin (R ⧸ maximalIdeal R) (Set.range (frameForm z))

/-- The canonical `k`-algebra homomorphism `k[Z₁, …, Z_r] → gr_M(R)` of the polynomial ring in
`r` variables onto the subalgebra `k[Z]`, sending the variable `Z_j` to the initial form of
`z_j`.  It is injective when `(z₁, …, z_r)` extends to a regular system of parameters, and the
paper's identification of `k[Z]` with a polynomial ring in `Z₁, …, Z_r` is made through it. -/
noncomputable def frameAlgHom (z : Fin r → R) :
    MvPolynomial (Fin r) (R ⧸ maximalIdeal R) →ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R) :=
  MvPolynomial.aeval (frameForm z)

/-- The ideal of the polynomial ring `k[Z₁, …, Z_r]` corresponding to the ideal
`I = (φ₁, …, φ_i) k[Z]` generated in `k[Z]` by the initial forms `φ_j` of `(f₁, …, f_i)`
(Lemma 17, p. 246, and Definition 9(2), p. 248).  It is the ideal generated by the
`frameAlgHom z`-preimages of the `φ_j`; when `frameAlgHom z` is injective (a regular frame)
each `φ_j` lying in `k[Z]` has exactly one preimage, and this is the paper's `I`. -/
noncomputable def frameInitialIdeal (z : Fin r → R) {i : ℕ} (f : Fin i → R) :
    Ideal (MvPolynomial (Fin r) (R ⧸ maximalIdeal R)) :=
  Ideal.span {ψ | ∃ j : Fin i, frameAlgHom z ψ = initialForm (maximalIdeal R) (f j)}

/-- The E-set `E = E_r(I)` of `I = (φ₁, …, φ_i) k[Z]` with respect to `(k; Z₁, …, Z_r)`
(Lemma 17, p. 246, and Definition 9(2), p. 248). -/
noncomputable def frameESet (z : Fin r → R) {i : ℕ} (f : Fin i → R) : Set (Fin r → ℕ) :=
  ESet (frameInitialIdeal z f)

end FrameSubalgebra

/-! ### Power series expansions with respect to `(S; z₁, …, z_r)` (p. 246) -/

section PowerSeries

/-- p. 246: "every element `f` of `R = S{z₁, …, z_r}` can be uniquely expressed in a formal
power series `f = Σ_{A ∈ Z₀ʳ} c_A z^A` with `c_A ∈ S`. … This expression will be called the
*power series expansion* of `f` with respect to `(S; z₁, …, z_r)`."  `psCoeff A f` is `c_A`. -/
noncomputable def psCoeff {S : Type u} [CommRing S] {r : ℕ} (A : Fin r → ℕ)
    (f : MvPowerSeries (Fin r) S) : S :=
  MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm A) f

/-- The system `(z₁, …, z_r)` of variables of `R = S{z₁, …, z_r}`. -/
noncomputable def psVars (S : Type u) [CommRing S] (r : ℕ) : Fin r → MvPowerSeries (Fin r) S :=
  fun j => MvPowerSeries.X j

end PowerSeries

/-! ### Lemma 17 (pp. 246–248) -/

section Lemma17

section Lemma17Aux

variable {S : Type u} [CommRing S] [IsLocalRing S] {r : ℕ}

/-- The level condition `Lev(h, n)`: every coefficient `c_B` of `h` lies in `N^{n - |B|}`; for
`S{Z}` with maximal ideal `M = (N, Z)` this is `h ∈ Mⁿ` (`mem_pow_of_psLev`, `psLev_of_mem_pow`). -/
private def PsLev (n : ℕ) (h : MvPowerSeries (Fin r) S) : Prop :=
  ∀ B : Fin r →₀ ℕ, MvPowerSeries.coeff B h ∈ maximalIdeal S ^ (n - B.degree)

private theorem psLev_add {n : ℕ} {a b : MvPowerSeries (Fin r) S} (ha : PsLev n a)
    (hb : PsLev n b) : PsLev n (a + b) := fun B => by
  rw [map_add]
  exact add_mem (ha B) (hb B)

private theorem psLev_mul {m n : ℕ} {a b : MvPowerSeries (Fin r) S} (ha : PsLev m a)
    (hb : PsLev n b) : PsLev (m + n) (a * b) := by
  classical
  intro B
  rw [MvPowerSeries.coeff_mul]
  refine sum_mem fun p hp => ?_
  have hdeg : p.1.degree + p.2.degree = B.degree := by
    rw [← map_add, Finset.HasAntidiagonal.mem_antidiagonal.mp hp]
  have h := Ideal.mul_mem_mul (ha p.1) (hb p.2)
  rw [← pow_add] at h
  exact Ideal.pow_le_pow_right (by omega) h

private theorem psLev_monomial (B : Fin r →₀ ℕ) (c : S) :
    PsLev B.degree (MvPowerSeries.monomial B c : MvPowerSeries (Fin r) S) := by
  classical
  intro D
  rw [MvPowerSeries.coeff_monomial]
  split_ifs with hD
  · subst hD
    simp
  · exact zero_mem _

/-- The maximal ideal of `S{Z}`: `h` is a non-unit iff its constant coefficient is. -/
private theorem mem_maximalIdeal_ps_iff {h : MvPowerSeries (Fin r) S} :
    h ∈ maximalIdeal (MvPowerSeries (Fin r) S) ↔
      MvPowerSeries.constantCoeff h ∈ maximalIdeal S := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff]

/-- `Mⁿ ⊆ Lev(n)`. -/
private theorem psLev_of_mem_pow {n : ℕ} {h : MvPowerSeries (Fin r) S}
    (hh : h ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ n) : PsLev n h := by
  induction n generalizing h with
  | zero => exact fun B => by simp
  | succ n ih =>
    rw [pow_succ] at hh
    refine Submodule.mul_induction_on
      (C := fun h : MvPowerSeries (Fin r) S => PsLev (n + 1) h) hh ?_ ?_
    · intro a ha b hb
      refine psLev_mul (ih ha) fun B => ?_
      by_cases hB : B = 0
      · subst hB
        rw [MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        simpa using mem_maximalIdeal_ps_iff.mp hb
      · have : 1 - B.degree = 0 := by
          have := (Finsupp.degree_eq_zero_iff B).not.mpr hB
          omega
        rw [this, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
    · exact fun a b ha hb => psLev_add ha hb

/-- `C` maps `Nⁿ` into `Mⁿ`. -/
private theorem C_mem_pow {n : ℕ} {c : S} (hc : c ∈ maximalIdeal S ^ n) :
    (MvPowerSeries.C c : MvPowerSeries (Fin r) S) ∈
      maximalIdeal (MvPowerSeries (Fin r) S) ^ n := by
  have hle : (maximalIdeal S).map (MvPowerSeries.C : S →+* MvPowerSeries (Fin r) S) ≤
      maximalIdeal (MvPowerSeries (Fin r) S) := by
    rw [Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, mem_maximalIdeal_ps_iff, MvPowerSeries.constantCoeff_C]
    exact hc
  have h1 : MvPowerSeries.C c ∈ (maximalIdeal S ^ n).map
      (MvPowerSeries.C : S →+* MvPowerSeries (Fin r) S) := Ideal.mem_map_of_mem _ hc
  rw [Ideal.map_pow] at h1
  exact Ideal.pow_right_mono hle n h1

private theorem X_mem_maximalIdeal_ps (j : Fin r) :
    (MvPowerSeries.X j : MvPowerSeries (Fin r) S) ∈ maximalIdeal (MvPowerSeries (Fin r) S) := by
  rw [mem_maximalIdeal_ps_iff, MvPowerSeries.constantCoeff_X]
  exact zero_mem _

/-- `Lev(n) ⊆ Mⁿ`: `h = c₀ + Σ_j Z_j h_j`, sorting each monomial `Z^B ≠ 1` by the smallest
index `j` with `b_j > 0`. -/
private theorem mem_pow_of_psLev {n : ℕ} {h : MvPowerSeries (Fin r) S} (hh : PsLev n h) :
    h ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ n := by
  classical
  induction n generalizing h with
  | zero => simp
  | succ n ih =>
    let hj : Fin r → MvPowerSeries (Fin r) S := fun j D =>
      if ∀ i < j, D i = 0 then MvPowerSeries.coeff (D + Finsupp.single j 1) h else 0
    have hcoeff : ∀ j D, MvPowerSeries.coeff D (hj j) =
        if ∀ i < j, D i = 0 then MvPowerSeries.coeff (D + Finsupp.single j 1) h else 0 :=
      fun _ _ => rfl
    have hdecomp : h = MvPowerSeries.C (MvPowerSeries.constantCoeff h) +
        ∑ j, MvPowerSeries.X j * hj j := by
      ext B
      rw [map_add, MvPowerSeries.coeff_C, map_sum]
      simp_rw [MvPowerSeries.X, MvPowerSeries.coeff_monomial_mul, one_mul, hcoeff]
      by_cases hB : B = 0
      · subst hB
        rw [ite_eq_left rfl, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        simp
      · rw [ite_eq_right hB, zero_add]
        have hsupp : B.support.Nonempty := Finsupp.support_nonempty_iff.mpr hB
        set j₀ := B.support.min' hsupp
        have hj₀ : B j₀ ≠ 0 := Finsupp.mem_support_iff.mp (B.support.min'_mem hsupp)
        have hlt : ∀ i < j₀, B i = 0 := fun i hi => by
          by_contra h0
          exact absurd (B.support.min'_le i (Finsupp.mem_support_iff.mpr h0)) (not_le.mpr hi)
        rw [Finset.sum_eq_single j₀]
        · rw [ite_eq_left (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hj₀)), ite_eq_left,
            tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hj₀))]
          intro i hi
          rw [Finsupp.tsub_apply, Finsupp.single_apply, ite_eq_right (ne_of_lt hi).symm,
            Nat.sub_zero]
          exact hlt i hi
        · intro j _ hj
          split_ifs with h1 h2
          · exfalso
            have hBj : B j ≠ 0 := by
              have := Finsupp.single_le_iff.mp h1
              omega
            rcases lt_or_gt_of_ne hj with hlt' | hgt
            · exact hBj (hlt j hlt')
            · have := h2 j₀ hgt
              rw [Finsupp.tsub_apply, Finsupp.single_apply, ite_eq_right hj, Nat.sub_zero]
                at this
              exact hj₀ this
          · rfl
          · rfl
        · intro h
          exact absurd (Finset.mem_univ j₀) h
    rw [hdecomp]
    refine add_mem (C_mem_pow ?_) (sum_mem fun j _ => ?_)
    · have := hh 0
      rw [MvPowerSeries.coeff_zero_eq_constantCoeff_apply] at this
      simpa using this
    · rw [pow_succ']
      refine Ideal.mul_mem_mul (X_mem_maximalIdeal_ps j) (ih fun D => ?_)
      rw [hcoeff]
      split_ifs
      · have := hh (D + Finsupp.single j 1)
        rw [map_add, Finsupp.degree_single] at this
        exact Ideal.pow_le_pow_right (by omega) this
      · exact zero_mem _

/-- `[a Xⁿ]` does not depend on the proof of `a ∈ Iⁿ`, and the degree may be rewritten. -/
theorem assocGraded_mk_congr {A : Type u} [CommRing A] (I : Ideal A) {m n : ℕ}
    (hmn : m = n) {a b : A} (hab : a = b) (ha : a ∈ I ^ m) (hb : b ∈ I ^ n) :
    AssocGraded.mk I m a ha = AssocGraded.mk I n b hb := by
  subst hmn hab
  rfl

/-- The image of `x̄ ∈ A/I` in `gr_I(A)` is the class of `x` in degree `0`. -/
private theorem algebraMap_quot_eq_mk_zero {A : Type u} [CommRing A] (I : Ideal A) (x : A) :
    algebraMap (A ⧸ I) (AssocGraded I) (Ideal.Quotient.mk I x) =
      AssocGraded.mk I 0 x (by simp) := by
  show AssocGraded.algebraMapQuot _ _ = _
  rw [AssocGraded.algebraMapQuot, Ideal.Quotient.lift_mk, AssocGraded.algebraMap_apply,
    AssocGraded.mk]
  congr 1

/-- `∏ᵢ [aᵢ X^{dᵢ}] = [∏ aᵢ X^{Σ dᵢ}]` in `gr_I(A)`. -/
private theorem assocGraded_prod_mk {A : Type u} [CommRing A] (I : Ideal A) {ι : Type*}
    (s : Finset ι) (d : ι → ℕ) (a : ι → A) (ha : ∀ i, a i ∈ I ^ d i)
    (h : ∏ i ∈ s, a i ∈ I ^ ∑ i ∈ s, d i) :
    ∏ i ∈ s, AssocGraded.mk I (d i) (a i) (ha i) = AssocGraded.mk I (∑ i ∈ s, d i) _ h := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.prod_empty, ← map_one (algebraMap (A ⧸ I) (AssocGraded I)),
      ← map_one (Ideal.Quotient.mk I), algebraMap_quot_eq_mk_zero]
    exact assocGraded_mk_congr I (by simp) (by simp) _ _
  | insert j s hj ih =>
    have hs : ∏ i ∈ s, a i ∈ I ^ ∑ i ∈ s, d i := by
      rw [← Finset.prod_pow_eq_pow_sum]
      exact Ideal.prod_mem_prod fun i _ => ha i
    rw [Finset.prod_insert hj, ih hs, AssocGraded.mk_mul_mk]
    exact assocGraded_mk_congr I (by rw [Finset.sum_insert hj]) (by rw [Finset.prod_insert hj])
      _ _

/-- `[a X]ⁿ = [aⁿ Xⁿ]` in `gr_I(A)`. -/
private theorem assocGraded_mk_pow {A : Type u} [CommRing A] (I : Ideal A) {a : A}
    (ha : a ∈ I ^ 1) (n : ℕ) (h : a ^ n ∈ I ^ n) :
    AssocGraded.mk I 1 a ha ^ n = AssocGraded.mk I n (a ^ n) h := by
  induction n with
  | zero =>
    rw [pow_zero, ← map_one (algebraMap (A ⧸ I) (AssocGraded I)),
      ← map_one (Ideal.Quotient.mk I), algebraMap_quot_eq_mk_zero]
    exact assocGraded_mk_congr I rfl (by simp) _ _
  | succ n ih =>
    have hn : a ^ n ∈ I ^ n := by
      have := Ideal.pow_mem_pow ha n
      rwa [← pow_mul, one_mul] at this
    rw [pow_succ, ih hn, AssocGraded.mk_mul_mk]
    exact assocGraded_mk_congr I rfl (by rw [pow_succ]) _ _

omit [IsLocalRing S] in
/-- `∏ⱼ Zⱼ^{Dⱼ} = Z^D` in `S{Z}`. -/
private theorem prod_X_pow_eq_monomial (D : Fin r →₀ ℕ) :
    ∏ j, (MvPowerSeries.X j : MvPowerSeries (Fin r) S) ^ D j = MvPowerSeries.monomial D 1 := by
  classical
  have key : ∀ s : Finset (Fin r), ∏ j ∈ s, (MvPowerSeries.X j : MvPowerSeries (Fin r) S) ^ D j =
      MvPowerSeries.monomial (∑ j ∈ s, Finsupp.single j (D j)) 1 := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp [MvPowerSeries.monomial_zero_eq_C_apply]
    | insert j s hj ih =>
      rw [Finset.prod_insert hj, ih, Finset.sum_insert hj, MvPowerSeries.X_pow_eq,
        MvPowerSeries.monomial_mul_monomial, one_mul]
  rw [key, Finsupp.univ_sum_single]

/-- `ν_M(Z_j) = 1` in `S{Z}`. -/
private theorem ordElem_X_ps (j : Fin r) :
    Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (MvPowerSeries.X j) = (1 : ℕ) := by
  classical
  refine le_antisymm (Ideal.ordElem_le_of_notMem fun h => ?_) (Ideal.le_ordElem ?_)
  · have := psLev_of_mem_pow h (Finsupp.single j 1)
    rw [MvPowerSeries.coeff_X, ite_eq_left rfl, Finsupp.degree_single] at this
    simp at this
  · rw [pow_one]
    exact X_mem_maximalIdeal_ps j

/-- A lift `S → k` of the residue field `k = S{Z}/M`: the constant coefficient of a
representative. -/
private noncomputable def psLift (c : MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S)) : S :=
  MvPowerSeries.constantCoeff (Classical.choose (Ideal.Quotient.mk_surjective c))

private theorem mk_C_psLift (c : MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S)) :
    Ideal.Quotient.mk _ (MvPowerSeries.C (psLift c)) = c := by
  conv_rhs => rw [← Classical.choose_spec (Ideal.Quotient.mk_surjective c)]
  rw [Ideal.Quotient.eq, mem_maximalIdeal_ps_iff, map_sub, MvPowerSeries.constantCoeff_C, psLift,
    sub_self]
  exact zero_mem _

/-- `c = 0` in `k` iff its lift lies in `N`. -/
private theorem psLift_mem_iff (c : MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S)) :
    psLift c ∈ maximalIdeal S ↔ c = 0 := by
  rw [← mk_C_psLift c, Ideal.Quotient.eq_zero_iff_mem, mem_maximalIdeal_ps_iff,
    MvPowerSeries.constantCoeff_C, mk_C_psLift]

/-- The initial form of `Z_j` in `gr_M(S{Z})` is the class of `Z_j` in degree `1`. -/
private theorem frameForm_psVars (j : Fin r) :
    frameForm (psVars S r) j = AssocGraded.mk _ 1 (MvPowerSeries.X j)
      (by rw [pow_one]; exact X_mem_maximalIdeal_ps j) :=
  initialForm_eq_mk _ (ordElem_X_ps j)

/-- The canonical map `k[Z] → gr_M(S{Z})` sends `χ` to `Σ_D [χ̃_D Z^D]_{|D|}`. -/
private theorem frameAlgHom_psVars_eq (χ : MvPolynomial (Fin r) (MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S))) :
    frameAlgHom (psVars S r) χ = ∑ D ∈ χ.support, AssocGraded.mk _ D.degree
      (MvPowerSeries.monomial D (psLift (χ.coeff D)))
      (mem_pow_of_psLev (psLev_monomial D _)) := by
  rw [frameAlgHom, MvPolynomial.aeval_def, MvPolynomial.eval₂_eq']
  refine Finset.sum_congr rfl fun D _ => ?_
  simp_rw [frameForm_psVars]
  rw [← mk_C_psLift (χ.coeff D), algebraMap_quot_eq_mk_zero, mk_C_psLift]
  have hpow : ∀ j, (MvPowerSeries.X j : MvPowerSeries (Fin r) S) ^ D j ∈
      maximalIdeal (MvPowerSeries (Fin r) S) ^ D j := fun j => by
    have := Ideal.pow_mem_pow (X_mem_maximalIdeal_ps (S := S) j) (D j)
    exact this
  have hprod : ∏ j, (MvPowerSeries.X j : MvPowerSeries (Fin r) S) ^ D j ∈
      maximalIdeal (MvPowerSeries (Fin r) S) ^ ∑ j, D j := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun j _ => hpow j
  rw [Finset.prod_congr rfl fun j _ => assocGraded_mk_pow _ _ (D j) (hpow j),
    assocGraded_prod_mk _ _ _ _ hpow hprod, AssocGraded.mk_mul_mk]
  refine assocGraded_mk_congr _ ?_ ?_ _ _
  · rw [zero_add, Finsupp.degree_eq_sum]
  · rw [prod_X_pow_eq_monomial, ← MvPowerSeries.monomial_zero_eq_C_apply,
      MvPowerSeries.monomial_mul_monomial, zero_add, mul_one]

/-- If the degree-`d` component of `χ ∈ k[Z]` maps to `0` in `gr^d_M(S{Z})`, then that component
vanishes. -/
private theorem coeff_eq_zero_of_grProj_frameAlgHom (χ : MvPolynomial (Fin r)
    (MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S))) (d : ℕ)
    (h0 : grProj _ d (frameAlgHom (psVars S r) χ) = 0) (D : Fin r →₀ ℕ) (hD : D.degree = d) :
    χ.coeff D = 0 := by
  classical
  let y : (Fin r →₀ ℕ) → ↥(maximalIdeal (MvPowerSeries (Fin r) S) ^ d) := fun D =>
    if h : D.degree = d then ⟨MvPowerSeries.monomial D (psLift (χ.coeff D)),
      h ▸ mem_pow_of_psLev (psLev_monomial D _)⟩ else 0
  have hterm : ∀ D, grProj (maximalIdeal (MvPowerSeries (Fin r) S)) d (AssocGraded.mk _ D.degree
      (MvPowerSeries.monomial D (psLift (χ.coeff D))) (mem_pow_of_psLev (psLev_monomial D _))) =
      Submodule.Quotient.mk (y D) := by
    intro D
    by_cases h : D.degree = d
    · simp only [y, dite_eq_left h]
      rw [← grProj_mk_same]
      exact congrArg _ (assocGraded_mk_congr _ h rfl _ _)
    · simp only [y, dite_eq_right h, Submodule.Quotient.mk_zero]
      exact grProj_mk_ne _ h _ _
  have hproj : grProj (maximalIdeal (MvPowerSeries (Fin r) S)) d
      (frameAlgHom (psVars S r) χ) = Submodule.Quotient.mk (∑ D ∈ χ.support, y D) := by
    rw [frameAlgHom_psVars_eq, map_sum, Finset.sum_congr rfl fun D _ => hterm D]
    exact (map_sum (Submodule.mkQ _) _ _).symm
  rw [hproj, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply] at h0
  have hlev := psLev_of_mem_pow h0 D
  rw [AddSubmonoidClass.coe_finsetSum, map_sum] at hlev
  by_cases hDs : D ∈ χ.support
  · rw [Finset.sum_eq_single D (fun D' _ hne => ?_) (fun h => absurd hDs h)] at hlev
    · simp only [y, dite_eq_left hD, MvPowerSeries.coeff_monomial_same] at hlev
      rw [hD, show d + 1 - d = 1 by omega, pow_one] at hlev
      exact (psLift_mem_iff _).mp hlev
    · simp only [y]
      split_ifs
      · exact MvPowerSeries.coeff_monomial_ne hne.symm _
      · simp
  · exact MvPolynomial.notMem_support_iff.mp hDs

/-- `k[Z] → gr_M(S{Z})` is injective. -/
private theorem frameAlgHom_psVars_injective :
    Function.Injective (frameAlgHom (psVars S r)) := by
  rw [injective_iff_map_eq_zero]
  intro χ hχ
  ext D
  rw [coeff_eq_zero_of_grProj_frameAlgHom χ D.degree (by rw [hχ, map_zero]) D rfl]
  simp

/-- A preimage in `k[Z]` of the class of an element of `Mⁿ` in degree `n` is a form of degree
`n`. -/
private theorem isHomogeneous_of_frameAlgHom_eq_mk {n : ℕ} {a : MvPowerSeries (Fin r) S}
    (ha : a ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ n) (ψ : MvPolynomial (Fin r)
      (MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S)))
    (hψ : frameAlgHom (psVars S r) ψ = AssocGraded.mk _ n a ha) :
    ψ ∈ MvPolynomial.homogeneousSubmodule (Fin r) _ n := by
  intro D hD
  by_contra hne
  apply hD
  refine coeff_eq_zero_of_grProj_frameAlgHom ψ D.degree ?_ D rfl
  rw [hψ]
  refine grProj_mk_ne _ (fun h => hne ?_) _ _
  rw [Finsupp.degree_eq_weight_one] at h
  exact h.symm

/-- The lift `Σ_D χ̃_D Z^D ∈ S{Z}` of a polynomial `χ ∈ k[Z]`. -/
private noncomputable def psLiftPoly (χ : MvPolynomial (Fin r) (MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S))) : MvPowerSeries (Fin r) S :=
  ∑ D ∈ χ.support, MvPowerSeries.monomial D (psLift (χ.coeff D))

private theorem coeff_psLiftPoly (χ : MvPolynomial (Fin r) (MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S))) (B : Fin r →₀ ℕ) :
    MvPowerSeries.coeff B (psLiftPoly χ) = if B ∈ χ.support then psLift (χ.coeff B) else 0 := by
  classical
  rw [psLiftPoly, map_sum]
  split_ifs with hB
  · rw [Finset.sum_eq_single B (fun D _ hne => MvPowerSeries.coeff_monomial_ne hne.symm _)
      (fun h => absurd hB h), MvPowerSeries.coeff_monomial_same]
  · exact Finset.sum_eq_zero fun D hD =>
      MvPowerSeries.coeff_monomial_ne (by rintro rfl; exact hB hD) _

private theorem psLiftPoly_zero :
    psLiftPoly (0 : MvPolynomial (Fin r) (MvPowerSeries (Fin r) S ⧸
      maximalIdeal (MvPowerSeries (Fin r) S))) = 0 := by
  simp [psLiftPoly]

/-- For a form `χ` of degree `d`, `psLiftPoly χ ∈ M^d` and its class in `gr^d` is the image of
`χ`. -/
private theorem psLiftPoly_spec {χ : MvPolynomial (Fin r) (MvPowerSeries (Fin r) S ⧸
    maximalIdeal (MvPowerSeries (Fin r) S))} {d : ℕ}
    (hχ : χ ∈ MvPolynomial.homogeneousSubmodule (Fin r) _ d) :
    ∃ h : psLiftPoly χ ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ d,
      frameAlgHom (psVars S r) χ = AssocGraded.mk _ d _ h := by
  have hdeg : ∀ D ∈ χ.support, D.degree = d := fun D hD => by
    have := hχ (MvPolynomial.mem_support_iff.mp hD)
    rw [Finsupp.degree_eq_weight_one]
    exact this
  have hmem : ∀ D ∈ χ.support, MvPowerSeries.monomial D (psLift (χ.coeff D)) ∈
      maximalIdeal (MvPowerSeries (Fin r) S) ^ d := fun D hD => by
    rw [← hdeg D hD]
    exact mem_pow_of_psLev (psLev_monomial D _)
  have h : psLiftPoly χ ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ d := sum_mem hmem
  refine ⟨h, ?_⟩
  classical
  let y : (Fin r →₀ ℕ) → ↥(maximalIdeal (MvPowerSeries (Fin r) S) ^ d) := fun D =>
    if hD : D ∈ χ.support then ⟨_, hmem D hD⟩ else 0
  have hy : ((∑ D ∈ χ.support, y D : ↥(maximalIdeal (MvPowerSeries (Fin r) S) ^ d)) :
      MvPowerSeries (Fin r) S) = psLiftPoly χ := by
    rw [AddSubmonoidClass.coe_finsetSum, psLiftPoly]
    exact Finset.sum_congr rfl fun D hD => by simp only [y, dite_eq_left hD]
  rw [frameAlgHom_psVars_eq, show AssocGraded.mk _ d (psLiftPoly χ) h =
    AssocGraded.mkLinear _ d (∑ D ∈ χ.support, y D) from by
      rw [AssocGraded.mkLinear_apply]
      exact assocGraded_mk_congr _ rfl hy.symm _ _, map_sum]
  refine Finset.sum_congr rfl fun D hD => ?_
  simp only [y, dite_eq_left hD]
  rw [AssocGraded.mkLinear_apply]
  exact assocGraded_mk_congr _ (hdeg D hD) rfl _ _

/-- `g ∈ I ^ ν_I(g)` (with `ν_I(g) = ∞` read as `0`). -/
private theorem mem_pow_toNat_ordElem_l17 {A : Type*} [CommRing A] (I : Ideal A) (g : A) :
    g ∈ I ^ (Ideal.ordElem I g).toNat := by
  by_cases h : Ideal.ordElem I g = ⊤
  · rw [h, ENat.toNat_top, pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  · exact Ideal.mem_pow_of_ordElem (ENat.natCast_toNat h).symm

/-- The lift of `1 ∈ k` is `≡ 1` modulo `N`. -/
private theorem psLift_one_sub_mem :
    psLift (1 : MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S)) - 1 ∈
      maximalIdeal S := by
  have h := mk_C_psLift (S := S) (r := r) 1
  rw [← map_one (Ideal.Quotient.mk (maximalIdeal (MvPowerSeries (Fin r) S))),
    ← map_one (MvPowerSeries.C (σ := Fin r) (R := S)), Ideal.Quotient.eq,
    mem_maximalIdeal_ps_iff, map_sub, MvPowerSeries.constantCoeff_C,
    MvPowerSeries.constantCoeff_C] at h
  exact h

/-- One reduction step in the proof of Lemma 17 (p. 247), with `ℓ = e`: for `A ∈ E` with `|A| ≤ ℓ`,
and `g` with `c_B ∈ N^{ℓ - |B|}` for `B ∈ E` (that is, `ℓ ≤ e(g)`, `le_lemma17E_iff`), subtracting
`c_A · Σ h_i f_i` (the `h_i = c_Ā h_i⁰` of the paper: `c_A` times a lift `L_i` of the forms `λ_i` with
`φ = Σ λ_i φ_i`, `φ ∈ I` with `Λ(φ) = A` and coefficient `1`) keeps these conditions, and makes
`c_B ∈ N^{ℓ+1-|B|}` for `B = A` and for all `B > A` for which it held before.  (The `B` with
`c_B ∉ N^{ℓ+1-|B|}`, `|B| ≤ ℓ`, are those with `|B| + ν_N(c_B) = ℓ`; the conclusion for `B ≥ A` is
the paper's claim "`Ā > A` for every `A ∈ E(e)` such that `|A| + ν_N(c'_A) = e`".) -/
private theorem lemma17_reduce_aux {m : ℕ} (f : Fin m → MvPowerSeries (Fin r) S)
    (ψ : Fin m → MvPolynomial (Fin r)
      (MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S)))
    (hψ : ∀ i, frameAlgHom (psVars S r) (ψ i) = initialForm _ (f i))
    (ℓ : ℕ) (g : MvPowerSeries (Fin r) S)
    (hg : ∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
      MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ - B.degree))
    (A : Fin r →₀ ℕ) (hA : ⇑A ∈ frameESet (psVars S r) f) (hAℓ : A.degree ≤ ℓ) :
    ∃ δ : Fin m → MvPowerSeries (Fin r) S,
      (∀ i, δ i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^
        (ℓ - (Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i)).toNat)) ∧
      (∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
        MvPowerSeries.coeff B (g - ∑ i, δ i * f i) ∈ maximalIdeal S ^ (ℓ - B.degree)) ∧
      ∀ B : Fin r →₀ ℕ, toLex A ≤ toLex B →
        (B ≠ A → MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ + 1 - B.degree)) →
        MvPowerSeries.coeff B (g - ∑ i, δ i * f i) ∈ maximalIdeal S ^ (ℓ + 1 - B.degree) := by
  classical
  let _ : Field (MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S)) :=
    Ideal.Quotient.field _
  have hAE := hA
  -- (1) a form `φ ∈ I` of degree `n = |A|` with `Λ(φ) = A` and coefficient `1` at `A`
  obtain ⟨A₀, ⟨φ₀, hφ₀I, hφ₀0, ⟨n₀, hφ₀n⟩, rfl⟩, B₀, hAB⟩ := hA
  obtain ⟨hφ₁0, hφ₁Λ⟩ := eFunction_monomial_mul (Finsupp.equivFunOnFinite.symm B₀) hφ₀0
  set φ₁ := MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm B₀) 1 * φ₀ with hφ₁
  obtain ⟨A', hA'supp, hA'Λ, hA'max⟩ := eFunction_spec_aux hφ₁0
  have hA'A : A' = A := by
    apply DFunLike.coe_injective
    rw [← hA'Λ, hφ₁Λ, hAB, Finsupp.coe_equivFunOnFinite_symm, add_comm]
  subst hA'A
  have hφ₁hom : φ₁ ∈ MvPolynomial.homogeneousSubmodule (Fin r) _
      ((Finsupp.equivFunOnFinite.symm B₀).degree + n₀) := by
    rw [MvPolynomial.mem_homogeneousSubmodule] at hφ₀n ⊢
    exact (MvPolynomial.isHomogeneous_monomial _ rfl).mul hφ₀n
  set n := A'.degree with hn
  have hn' : (Finsupp.equivFunOnFinite.symm B₀).degree + n₀ = n := by
    have := hφ₁hom (MvPolynomial.mem_support_iff.mp hA'supp)
    rw [hn]
    conv_rhs => rw [Finsupp.degree_eq_weight_one]
    exact this.symm
  rw [hn'] at hφ₁hom
  set u := φ₁.coeff A' with hu
  have hu0 : u ≠ 0 := MvPolynomial.mem_support_iff.mp hA'supp
  set φ := MvPolynomial.C u⁻¹ * φ₁ with hφ
  have hφcoeff : ∀ B, φ.coeff B = u⁻¹ * φ₁.coeff B := fun B => MvPolynomial.coeff_C_mul _ _ _
  have hφA : φ.coeff A' = 1 := by rw [hφcoeff, ← hu, inv_mul_cancel₀ hu0]
  have hφsupp : ∀ B ∈ φ.support, toLex B ≤ toLex A' := fun B hB => by
    refine hA'max B (MvPolynomial.mem_support_iff.mpr fun h0 => ?_)
    rw [MvPolynomial.mem_support_iff, hφcoeff, h0, mul_zero] at hB
    exact hB rfl
  have hφhom : φ ∈ MvPolynomial.homogeneousSubmodule (Fin r) _ n := by
    rw [MvPolynomial.mem_homogeneousSubmodule] at hφ₁hom ⊢
    simpa using (MvPolynomial.isHomogeneous_C (Fin r) u⁻¹).mul hφ₁hom
  -- (2) `φ = Σ qᵢ ψᵢ`
  have hIle : frameInitialIdeal (psVars S r) f ≤ Ideal.span (Set.range ψ) := by
    rw [frameInitialIdeal, Ideal.span_le]
    rintro χ ⟨j, hj⟩
    rw [← hψ j] at hj
    exact Ideal.subset_span ⟨j, (frameAlgHom_psVars_injective hj).symm⟩
  have hφI : φ ∈ Ideal.span (Set.range ψ) :=
    hIle (Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hφ₀I))
  obtain ⟨q, hq⟩ := Ideal.mem_span_range_iff_exists_fun.mp hφI
  -- (3) the `ψᵢ` are forms of degree `νᵢ`
  set ν : Fin m → ℕ := fun i =>
    (Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i)).toNat with hν
  have hfν : ∀ i, f i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ ν i := fun i =>
    mem_pow_toNat_ordElem_l17 _ _
  have hψin : ∀ i, ψ i ≠ 0 → frameAlgHom (psVars S r) (ψ i) =
      AssocGraded.mk _ (ν i) (f i) (hfν i) := by
    intro i hi
    rw [hψ i]
    by_cases htop : Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i) = ⊤
    · exfalso
      apply hi
      apply frameAlgHom_psVars_injective
      rw [hψ i, map_zero, initialForm, dite_eq_left htop]
    · exact initialForm_eq_mk _ (ENat.natCast_toNat htop).symm
  have hψhom : ∀ i, ψ i ∈ MvPolynomial.homogeneousSubmodule (Fin r) _ (ν i) := fun i => by
    by_cases hi : ψ i = 0
    · rw [hi]
      exact zero_mem _
    · exact isHomogeneous_of_frameAlgHom_eq_mk _ _ (hψin i hi)
  -- (4) `φ = Σ χᵢ ψᵢ` with `χᵢ` a form of degree `n - νᵢ`
  set χ : Fin m → MvPolynomial (Fin r) _ := fun i =>
    if ν i ≤ n ∧ ψ i ≠ 0 then MvPolynomial.homogeneousComponent (n - ν i) (q i) else 0 with hχ
  have hχhom : ∀ i, χ i ∈ MvPolynomial.homogeneousSubmodule (Fin r) _ (n - ν i) := fun i => by
    simp only [hχ]
    split_ifs
    · exact MvPolynomial.homogeneousComponent_isHomogeneous _ _
    · exact zero_mem _
  have hφχ : φ = ∑ i, χ i * ψ i := by
    have h1 : φ = MvPolynomial.homogeneousComponent n φ := by
      rw [MvPolynomial.homogeneousComponent_of_mem hφhom, ite_eq_left rfl]
    rw [h1, ← hq, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [mul_comm, homogeneousComponent_mul_of_mem_aux (hψhom i)]
    simp only [hχ]
    by_cases hi : ψ i = 0
    · simp [hi]
    · by_cases hνn : ν i ≤ n
      · rw [ite_eq_left hνn, ite_eq_left ⟨hνn, hi⟩, mul_comm]
      · rw [ite_eq_right hνn, ite_eq_right (fun h => hνn h.1), zero_mul]
  -- (5) the lifts `Lᵢ` of the `χᵢ`
  set L : Fin m → MvPowerSeries (Fin r) S := fun i => psLiftPoly (χ i) with hL
  have hLspec := fun i => psLiftPoly_spec (hχhom i)
  have hχ0 : ∀ i, ¬(ν i ≤ n ∧ ψ i ≠ 0) → L i = 0 := fun i hi => by
    simp only [hL, hχ, ite_eq_right hi, psLiftPoly_zero]
  -- (6) `Φ = Σ Lᵢ fᵢ ∈ Mⁿ` has the same class in `grⁿ` as the lift `P` of `φ`
  set Φ : MvPowerSeries (Fin r) S := ∑ i, L i * f i with hΦ
  have hterm : ∀ i, L i * f i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ n := fun i => by
    by_cases hi : ν i ≤ n ∧ ψ i ≠ 0
    · have h := Ideal.mul_mem_mul (hLspec i).1 (hfν i)
      rwa [← pow_add, Nat.sub_add_cancel hi.1] at h
    · rw [hχ0 i hi, zero_mul]
      exact zero_mem _
  have hΦn : Φ ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ n := sum_mem fun i _ => hterm i
  obtain ⟨hP, hφP⟩ := psLiftPoly_spec hφhom
  have hclass : AssocGraded.mk _ n Φ hΦn = AssocGraded.mk _ n (psLiftPoly φ) hP := by
    rw [← hφP, hφχ, map_sum]
    have h1 : AssocGraded.mk _ n Φ hΦn =
        AssocGraded.mkLinear _ n (∑ i, (⟨L i * f i, hterm i⟩ :
          ↥(maximalIdeal (MvPowerSeries (Fin r) S) ^ n))) := by
      rw [AssocGraded.mkLinear_apply]
      exact assocGraded_mk_congr _ rfl (by rw [AddSubmonoidClass.coe_finsetSum]) _ _
    rw [h1, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [AssocGraded.mkLinear_apply, map_mul]
    by_cases hi : ν i ≤ n ∧ ψ i ≠ 0
    · rw [(hLspec i).2, hψin i hi.2, AssocGraded.mk_mul_mk]
      exact assocGraded_mk_congr _ (Nat.sub_add_cancel hi.1).symm rfl _ _
    · have hχi : χ i = 0 := by simp only [hχ, ite_eq_right hi]
      rw [hχi, map_zero, zero_mul, AssocGraded.mk_eq_zero_iff]
      show L i * f i ∈ _
      rw [hχ0 i hi, zero_mul]
      exact zero_mem _
  have hΦP : Φ - psLiftPoly φ ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ (n + 1) := by
    rw [← AssocGraded.mk_eq_zero_iff _ (sub_mem hΦn hP)]
    have h2 : AssocGraded.mk _ n (Φ - psLiftPoly φ) (sub_mem hΦn hP) =
        AssocGraded.mkLinear _ n (⟨Φ, hΦn⟩ - ⟨psLiftPoly φ, hP⟩) := rfl
    rw [h2, map_sub, AssocGraded.mkLinear_apply, AssocGraded.mkLinear_apply, hclass, sub_self]
  -- (7) `δᵢ = c_A Lᵢ`
  set c := MvPowerSeries.coeff A' g with hcdef
  have hc : c ∈ maximalIdeal S ^ (ℓ - n) := hg A' hAE
  refine ⟨fun i => MvPowerSeries.C c * L i, fun i => ?_, ?_⟩
  · show MvPowerSeries.C c * L i ∈ _ ^ (ℓ - ν i)
    by_cases hi : ν i ≤ n ∧ ψ i ≠ 0
    · have h := Ideal.mul_mem_mul (C_mem_pow (r := r) hc) (hLspec i).1
      rw [← pow_add] at h
      exact Ideal.pow_le_pow_right (by omega) h
    · simp only [hχ0 i hi, mul_zero]
      exact zero_mem _
  have hg' : g - ∑ i, MvPowerSeries.C c * L i * f i = g - MvPowerSeries.C c * Φ := by
    rw [hΦ, Finset.mul_sum]
    simp_rw [mul_assoc]
  rw [hg']
  have hcoeff : ∀ B, MvPowerSeries.coeff B (g - MvPowerSeries.C c * Φ) =
      MvPowerSeries.coeff B g - c * MvPowerSeries.coeff B Φ := fun B => by
    rw [map_sub, MvPowerSeries.coeff_C_mul]
  have hΦlev := psLev_of_mem_pow hΦn
  have hΦPlev := psLev_of_mem_pow hΦP
  refine ⟨fun B hB => ?_, fun B hAB' hBg => ?_⟩
  · -- (8) the conditions at level `ℓ` persist
    rw [hcoeff]
    refine sub_mem (hg B hB) ?_
    have h := Ideal.mul_mem_mul hc (hΦlev B)
    rw [← pow_add] at h
    exact Ideal.pow_le_pow_right (by omega) h
  · -- (9) the improvement at `A` and above
    have hPB := hΦPlev B
    rw [map_sub, coeff_psLiftPoly] at hPB
    rw [hcoeff]
    by_cases hBA : B = A'
    · subst hBA
      have hBφ : B ∈ φ.support := by
        rw [MvPolynomial.mem_support_iff, hφA]
        exact one_ne_zero
      rw [ite_eq_left hBφ, hφA, ← hn, show n + 1 - n = 1 by omega, pow_one] at hPB
      have h1 : MvPowerSeries.coeff B Φ - 1 ∈ maximalIdeal S := by
        have := add_mem hPB (psLift_one_sub_mem (S := S) (r := r))
        rwa [sub_add_sub_cancel] at this
      have h := Ideal.mul_mem_mul hc h1
      rw [← pow_succ] at h
      rw [show MvPowerSeries.coeff B g - c * MvPowerSeries.coeff B Φ =
        -(c * (MvPowerSeries.coeff B Φ - 1)) by rw [hcdef]; ring, ← hn]
      exact neg_mem (Ideal.pow_le_pow_right (by omega) h)
    · have hBφ : B ∉ φ.support := fun hB =>
        (not_le.mpr (lt_of_le_of_ne hAB' fun h => hBA (toLex_inj.mp h).symm)) (hφsupp B hB)
      rw [ite_eq_right hBφ, sub_zero] at hPB
      refine sub_mem (hBg hBA) ?_
      have h := Ideal.mul_mem_mul hc hPB
      rw [← pow_add] at h
      exact Ideal.pow_le_pow_right (by omega) h

/-- The finite set of exponents `B` with `|B| ≤ ℓ`. -/
private theorem exists_finset_degree_le (ℓ : ℕ) :
    ∃ T : Finset (Fin r →₀ ℕ), ∀ B : Fin r →₀ ℕ, B.degree ≤ ℓ → B ∈ T := by
  classical
  refine ⟨(Fintype.piFinset fun _ : Fin r => Finset.range (ℓ + 1)).image
    Finsupp.equivFunOnFinite.symm, fun B hB => Finset.mem_image.mpr ⟨⇑B, ?_, by simp⟩⟩
  rw [Fintype.mem_piFinset]
  intro j
  rw [Finset.mem_range]
  have := Finsupp.le_degree j B
  omega

/-- The step `ℓ → ℓ + 1` of the proof of Lemma 17 (p. 247), `ℓ = e(g)`: "if `e(f') = e(f)` then we
replace `f` by `f'` and repeat the same process as above.  Since `E(e)` is a finite set, the above
fact shows that we come to the situation in which `e(f') > e(f)` after a finite number of times":
finitely many reductions (`lemma17_reduce_aux`), in decreasing lexicographic order of the largest
offending exponent `Ā`. -/
private theorem lemma17_step_aux {m : ℕ} (f : Fin m → MvPowerSeries (Fin r) S)
    (ψ : Fin m → MvPolynomial (Fin r)
      (MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S)))
    (hψ : ∀ i, frameAlgHom (psVars S r) (ψ i) = initialForm _ (f i))
    (ℓ : ℕ) (g : MvPowerSeries (Fin r) S)
    (hg : ∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
      MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ - B.degree)) :
    ∃ δ : Fin m → MvPowerSeries (Fin r) S,
      (∀ i, δ i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^
        (ℓ - (Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i)).toNat)) ∧
      ∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
        MvPowerSeries.coeff B (g - ∑ i, δ i * f i) ∈ maximalIdeal S ^ (ℓ + 1 - B.degree) := by
  classical
  obtain ⟨T, hT⟩ := exists_finset_degree_le (r := r) ℓ
  -- the "bad" exponents of `g`
  let Bad : MvPowerSeries (Fin r) S → (Fin r →₀ ℕ) → Prop := fun g B =>
    ⇑B ∈ frameESet (psVars S r) f ∧ B.degree ≤ ℓ ∧
      MvPowerSeries.coeff B g ∉ maximalIdeal S ^ (ℓ + 1 - B.degree)
  -- if there is no bad exponent, we are done
  have hdone : ∀ g : MvPowerSeries (Fin r) S, (∀ B, ¬Bad g B) →
      (∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
        MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ + 1 - B.degree)) := by
    intro g hno B hB
    by_contra h
    by_cases hdeg : B.degree ≤ ℓ
    · exact hno B ⟨hB, hdeg, h⟩
    · apply h
      rw [show ℓ + 1 - B.degree = 0 by omega, pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
  suffices key : ∀ a : Lex (Fin r →₀ ℕ), ∀ g : MvPowerSeries (Fin r) S,
      (∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
        MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ - B.degree)) →
      (∀ B, Bad g B → toLex B ≤ a) →
      ∃ δ : Fin m → MvPowerSeries (Fin r) S,
        (∀ i, δ i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^
          (ℓ - (Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i)).toNat)) ∧
        ∀ B : Fin r →₀ ℕ, ⇑B ∈ frameESet (psVars S r) f →
          MvPowerSeries.coeff B (g - ∑ i, δ i * f i) ∈
            maximalIdeal S ^ (ℓ + 1 - B.degree) by
    have hTne : (T.image toLex).Nonempty := (Finset.image_nonempty).mpr ⟨0, hT 0 (by simp)⟩
    exact key ((T.image toLex).max' hTne) g hg fun B hB =>
      Finset.le_max' _ _ (Finset.mem_image_of_mem _ (hT B hB.2.1))
  intro a
  induction a using WellFoundedLT.induction with
  | _ a ih =>
    intro g hg hbad
    by_cases hex : ∃ B, Bad g B
    · -- the lexicographically largest bad exponent `A`
      have hne : ((T.filter (Bad g)).image toLex).Nonempty := by
        obtain ⟨B, hB⟩ := hex
        exact ⟨toLex B, Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hT B hB.2.1, hB⟩)⟩
      set A := ofLex (((T.filter (Bad g)).image toLex).max' hne) with hAdef
      have hAmem : Bad g A := by
        obtain ⟨B, hB, hBA⟩ := Finset.mem_image.mp
          (((T.filter (Bad g)).image toLex).max'_mem hne)
        rw [hAdef, ← hBA]
        exact (Finset.mem_filter.mp hB).2
      have hAmax : ∀ B, Bad g B → toLex B ≤ toLex A := fun B hB =>
        Finset.le_max' _ _ (Finset.mem_image_of_mem _
          (Finset.mem_filter.mpr ⟨hT B hB.2.1, hB⟩))
      obtain ⟨δ, hδ, hgood, himp⟩ :=
        lemma17_reduce_aux f ψ hψ ℓ g hg A hAmem.1 hAmem.2.1
      -- the bad exponents of `g' = g - Σ δ f` are `< A`
      have hlt : ∀ B, Bad (g - ∑ i, δ i * f i) B → toLex B < toLex A := by
        intro B hB
        by_contra hge
        rw [not_lt] at hge
        apply hB.2.2
        refine himp B hge fun hBA => ?_
        by_contra hBg
        have := hAmax B ⟨hB.1, hB.2.1, hBg⟩
        exact hBA (toLex_inj.mp (le_antisymm this hge))
      by_cases hex' : ∃ B, Bad (g - ∑ i, δ i * f i) B
      · have hne' : ((T.filter (Bad (g - ∑ i, δ i * f i))).image toLex).Nonempty := by
          obtain ⟨B, hB⟩ := hex'
          exact ⟨toLex B, Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hT B hB.2.1, hB⟩)⟩
        set a' := ((T.filter (Bad (g - ∑ i, δ i * f i))).image toLex).max' hne'
        have ha'lt : a' < toLex A := by
          obtain ⟨B, hB, hBa⟩ := Finset.mem_image.mp
            (((T.filter (Bad (g - ∑ i, δ i * f i))).image toLex).max'_mem hne')
          rw [show a' = toLex B from hBa.symm]
          exact hlt B (Finset.mem_filter.mp hB).2
        have hAa : toLex A ≤ a := hbad A hAmem
        obtain ⟨δ', hδ', hres⟩ := ih a' (lt_of_lt_of_le ha'lt hAa) _ hgood fun B hB =>
          Finset.le_max' _ _ (Finset.mem_image_of_mem _
            (Finset.mem_filter.mpr ⟨hT B hB.2.1, hB⟩))
        refine ⟨δ + δ', fun i => add_mem (hδ i) (hδ' i), fun B hB => ?_⟩
        have h := hres B hB
        rwa [show g - ∑ i, δ i * f i - ∑ i, δ' i * f i = g - ∑ i, (δ + δ') i * f i by
          simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]; ring] at h
      · simp only [not_exists] at hex'
        exact ⟨δ, hδ, hdone _ hex'⟩
    · simp only [not_exists] at hex
      refine ⟨0, fun i => zero_mem _, ?_⟩
      simpa using hdone g hex

/-- `c ∈ Iⁿ` if and only if `n ≤ ν_I(c)`. -/
private theorem mem_pow_iff_le_ordElem_l17 {A : Type*} [CommRing A] (I : Ideal A) (c : A)
    (n : ℕ) : c ∈ I ^ n ↔ (n : ℕ∞) ≤ Ideal.ordElem I c := by
  constructor
  · exact Ideal.le_ordElem
  · intro h
    by_cases htop : Ideal.ordElem I c = ⊤
    · exact Ideal.ordElem_eq_top_iff.mp htop n
    · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
      have hc := Ideal.mem_pow_of_ordElem hν.symm
      rw [← hν, Nat.cast_le] at h
      exact Ideal.pow_le_pow_right h hc

/-- The symbol `e(g)` of the proof of Lemma 17 (p. 247): "For each element `g` of `R`, we define the
symbol `e(g)` as follows: Let `g = Σ_{A ∈ Z₀ʳ} d_A z^A` be the power series expansion of `g`. Then
`e(g)` is the minimum of the integers `|A| + ν_N(d_A)`, such that `d_A ≠ 0` and `A ∈ E`, if it
exists, and `e(g) = ∞` if `d_A = 0` for all `A ∈ E`."  (The infimum over the empty set is `∞`.) -/
private noncomputable def lemma17E (E : Set (Fin r → ℕ)) (g : MvPowerSeries (Fin r) S) : ℕ∞ :=
  ⨅ (B : Fin r →₀ ℕ) (_ : ⇑B ∈ E ∧ MvPowerSeries.coeff B g ≠ 0),
    ((B.degree : ℕ∞) + Ideal.ordElem (maximalIdeal S) (MvPowerSeries.coeff B g))

/-- `ℓ ≤ e(g)` if and only if `c_B ∈ N^{ℓ - |B|}` for all `B ∈ E`: the level condition `Lev_ℓ(g)`. -/
private theorem le_lemma17E_iff (E : Set (Fin r → ℕ)) (g : MvPowerSeries (Fin r) S) (ℓ : ℕ) :
    (ℓ : ℕ∞) ≤ lemma17E E g ↔ ∀ B : Fin r →₀ ℕ, ⇑B ∈ E →
      MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ - B.degree) := by
  unfold lemma17E
  rw [le_iInf_iff]
  refine forall_congr' fun B => ?_
  rw [le_iInf_iff]
  constructor
  · intro h hB
    by_cases hc : MvPowerSeries.coeff B g = 0
    · rw [hc]
      exact zero_mem _
    · have := h ⟨hB, hc⟩
      rw [mem_pow_iff_le_ordElem_l17, ENat.natCast_sub, tsub_le_iff_left]
      exact this
  · rintro h ⟨hB, -⟩
    have := (mem_pow_iff_le_ordElem_l17 _ _ _).mp (h hB)
    rw [ENat.natCast_sub, tsub_le_iff_left] at this
    exact this

/-- **The step (1)′, (2)′ of the proof of Lemma 17** (p. 247): if `e(g) < ∞`, there is a system
`(h_1, …, h_m)` with (1)′ `ν_M(h_i) ≥ e(g) - ν_M(f_i)` and (2)′ `e(g - Σ h_i f_i) > e(g)`.  Here (1)′
is written `h_i ∈ M^{e(g) - ν_i}` with `ν_i = ν_M(f_i)` read as `0` for `f_i = 0` (the paper tacitly
takes the `f_i` non-zero). -/
private theorem lemma17_e_step {m : ℕ} (f : Fin m → MvPowerSeries (Fin r) S)
    (ψ : Fin m → MvPolynomial (Fin r)
      (MvPowerSeries (Fin r) S ⧸ maximalIdeal (MvPowerSeries (Fin r) S)))
    (hψ : ∀ i, frameAlgHom (psVars S r) (ψ i) = initialForm _ (f i))
    (g : MvPowerSeries (Fin r) S) (hg : lemma17E (frameESet (psVars S r) f) g ≠ ⊤) :
    ∃ δ : Fin m → MvPowerSeries (Fin r) S,
      (∀ i, δ i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^
        ((lemma17E (frameESet (psVars S r) f) g).toNat -
          (Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i)).toNat)) ∧
      lemma17E (frameESet (psVars S r) f) g <
        lemma17E (frameESet (psVars S r) f) (g - ∑ i, δ i * f i) := by
  obtain ⟨ℓ, hℓ⟩ := ENat.ne_top_iff_exists.mp hg
  have hlev := (le_lemma17E_iff _ g ℓ).mp hℓ.le
  obtain ⟨δ, hδ, hδ'⟩ := lemma17_step_aux f ψ hψ ℓ g hlev
  have hℓt : (lemma17E (frameESet (psVars S r) f) g).toNat = ℓ := by
    rw [← hℓ, ENat.toNat_natCast]
  refine ⟨δ, fun i => ?_, ?_⟩
  · rw [hℓt]
    exact hδ i
  · rw [← hℓ]
    exact lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self ℓ)
      ((le_lemma17E_iff _ _ (ℓ + 1)).mpr hδ')

omit [IsLocalRing S] in
private theorem mem_pow_smul_top_iff_l17 {I : Ideal S} {n : ℕ} {x : S} :
    x ∈ (I ^ n • ⊤ : Submodule S S) ↔ x ∈ I ^ n := by
  rw [smul_eq_mul, Ideal.mul_top]

end Lemma17Aux

/-- Lemma 17, pp. 246–247: "Let `S` be a complete local ring, and `R` a formal power series
ring `S{z₁, …, z_r}` of `r` variables `z_j` (`1 ≤ j ≤ r`) over `S`. Let `N` be the maximal
ideal of `S` and `M` the maximal ideal of `R`, i.e. `M = (N, z₁, …, z_r)R`. Let
`k = R/M = S/N` and `k[Z₁, …, Z_r]` the graded `k`-subalgebra of `gr_M(R)` which is generated
by the initial forms `Z_j` of `z_j` in `gr_M(R)` for `1 ≤ j ≤ r`. Let `(f₁, …, f_m)` be a
system of elements of `R` such that the initial form `φ_j` of `f_j` in `gr_M(R)` belongs to
`k[Z₁, …, Z_r]` for `1 ≤ j ≤ m`. Let `I = (φ₁, …, φ_m)k[Z₁, …, Z_r]`, and `E` = the E-set
`E_r(I)` of `I` with respect to `(k; Z₁, …, Z_r)`. Then, for each element `f` of `R`, we can
find a system of elements `(h₁, …, h_m)` of `R` such that (1) `ν_M(h_i) ≥ ν_M(f) − ν_M(f_i)`
for `1 ≤ i ≤ m`, and (2) in the power series expansion (with respect to `(S; z₁, …, z_r)`)
`f − Σ_{i=1}^m h_i f_i = Σ_{A ∈ Z₀ʳ} c_A z^A`, with `c_A ∈ S`, we have `c_A = 0` for all
`A ∈ E`."

(Formalization notes: `R = S{z₁, …, z_r}` is `MvPowerSeries (Fin r) S` with
`z_j = MvPowerSeries.X j`, and `M = (N, z₁, …, z_r)R` is its maximal ideal as a local ring;
the paper's element `f` is called `g` here, the system being `(f₁, …, f_m)`; the difference
`ν_M(f) − ν_M(f_i)` is truncated subtraction in `ℕ∞`.)

(The proof follows the printed one (pp. 247–248): `lemma17E` is the symbol `e(g)`; for `e(g) = ∞`
take `h = 0`; for `e(g) < ∞`, "clearly `e(g) ≥ ν_M(g)`"; the step (1)′, (2)′ is `lemma17_e_step`
(`ν_M(h_i) ≥ e(g) − ν_M(f_i)` and `e(g − Σ h_i f_i) > e(g)`), proved by the printed construction of
`Ā`, `φ`, `λ_i`, `h_i⁰`, `h_i = c_Ā h_i⁰` and the repetition (`lemma17_reduce_aux`,
`lemma17_step_aux`); "in view of the completeness" the steps are iterated, `f^{(k+1)} = f^{(k)} −
Σ h_i^{(k)} f_i`, `e(f^{(k)}) ≥ e(f) + k`, and the sums `h_i = Σ_k h_i^{(k)}` converge
coefficientwise since `S` is complete.  In (1)′ the paper tacitly takes `f_i ≠ 0`; for `f_i = 0`
the exponent `ν_M(f_i) = ∞` is read as `0`.) -/
@[blueprint "lem:III.17"
  (statement := /-- Let $S$ be a complete local ring, and $R$ a formal power series ring
    $S\{z_1,\dots,z_r\}$ of $r$ variables $z_j$ $(1\le j\le r)$ over $S$. Let $N$ be the
    maximal ideal of $S$ and $M$ the maximal ideal of $R$, i.e. $M=(N,z_1,\dots,z_r)R$. Let
    $k=R/M=S/N$ and $k[Z_1,\dots,Z_r]$ the graded $k$-subalgebra of $\operatorname{gr}_M(R)$
    generated by the initial forms $Z_j$ of $z_j$ in $\operatorname{gr}_M(R)$ for
    $1\le j\le r$. Let $(f_1,\dots,f_m)$ be a system of elements of $R$ such that the initial
    form $\varphi_j$ of $f_j$ in $\operatorname{gr}_M(R)$ belongs to $k[Z_1,\dots,Z_r]$ for
    $1\le j\le m$. Let $I=(\varphi_1,\dots,\varphi_m)k[Z_1,\dots,Z_r]$ and $E=E_r(I)$ the
    $E$-set of $I$ with respect to $(k;Z_1,\dots,Z_r)$ (\cref{def:III.7-E-set}). Then, for
    each element $f$ of $R$, we can find a system of elements $(h_1,\dots,h_m)$ of $R$ such
    that
    \begin{enumerate}
      \item[(1)] $\nu_M(h_i)\ge\nu_M(f)-\nu_M(f_i)$ for $1\le i\le m$, and
      \item[(2)] in the power series expansion with respect to $(S;z_1,\dots,z_r)$,
        $f-\sum_{i=1}^m h_if_i=\sum_{A\in\mathbb Z^r_0}c_Az^A$ with $c_A\in S$, we have
        $c_A=0$ for all $A\in E$.
    \end{enumerate}
    (Lemma 17, pp.~246--247.) -/)
  (proof := /-- For each element $g$ of $R$, we define the symbol $e(g)$ as follows: let
    $g=\sum_{A\in\mathbb Z^r_0}d_Az^A$ be the power series expansion of $g$. Then $e(g)$ is the
    minimum of the integers $|A|+\nu_N(d_A)$ such that $d_A\ne0$ and $A\in E$, if it exists,
    and $e(g)=\infty$ if $d_A=0$ for all $A\in E$.

    Now, let $f$ be an arbitrary element of $R$; we shall prove the existence of
    $(h_1,\dots,h_m)$ having the properties (1) and (2). If $e(f)=\infty$, then we set $h_i=0$
    for $1\le i\le m$ and the assertion is trivially valid. Let us assume that
    $e(f)<\infty$. Clearly $e(f)\ge\nu_M(f)$. In view of the completeness of the local ring
    $R$, it suffices to show that there exists a system of elements $(h_1,\dots,h_m)$ of $R$
    such that
    \begin{enumerate}
      \item[(1)'] $\nu_M(h_i)\ge e(f)-\nu_M(f_i)$ for $1\le i\le m$, and
      \item[(2)'] $e(f-\sum h_if_i)>e(f)$.
    \end{enumerate}
    Let $\sum_{A\in\mathbb Z^r_0}c_Az^A$ be the power series expansion of $f$. Let $e=e(f)$ and
    $E(e)$ be the subset of $E$ consisting of those $A\in E$ which have $|A|\le e$. Then $E(e)$
    is a finite ordered set. Let $\bar A$ be the largest element of $E(e)$ such that
    $|\bar A|+\nu_N(c_{\bar A})=e$. We have a form $\varphi\in I$ such that
    $\bar A=\Lambda_r(\varphi)$. By replacing $\varphi$ by its multiple by a non-zero element
    of $k$, if necessary, we may assume that the coefficient of $Z^{\bar A}$ in $\varphi$ is
    equal to one. We can write $\varphi=\sum_i\lambda_i\varphi_i$ where $\lambda_i$ is a form in
    $k[Z_1,\dots,Z_r]$ of degree $|\bar A|-\deg\varphi_i=|\bar A|-\nu_M(f_i)\ (\ge0)$. For each
    $\lambda_i$, we choose $h^0_i\in(z_1,\dots,z_r)^{|\bar A|-\nu_M(f_i)}R$ which has $\lambda_i$
    as its initial form in $\operatorname{gr}_M(R)$. Let $h_i=c_{\bar A}h^0_i$ for
    $1\le i\le m$. These $h_i$ have the property (1)'. If they have the property (2)', then the
    proof is done. In any case, we have $\nu_M(\sum_{i=1}^m h_if_i)\ge e(f)$ and therefore
    $e(f-\sum_{i=1}^m h_if_i)\ge e(f)$.

    Let $f'=f-\sum_{i=1}^m h_if_i$, and assume that $e(f')=e(f)$. We then claim that if
    $\sum_{A\in\mathbb Z^r_0}c'_Az^A$ is the power series expansion of $f'$, we have
    $\bar A>A$ for every $A\in E(e)$ such that $|A|+\nu_N(c'_A)=e$. This property of $f'$ can
    be easily verified by showing that both $f-c_{\bar A}z^{\bar A}$ and
    $c_{\bar A}z^{\bar A}-\sum h_if_i$ have the property. Now, if $e(f')=e(f)$ then we replace
    $f$ by $f'$ and repeat the same process as above. Since $E(e)$ is a finite set, the above
    fact shows that we come to the situation in which $e(f')>e(f)$ after a finite number of
    times. \qed

    (Formalization notes. The symbol $e(g)$ is \texttt{lemma17E}; the condition $\ell\le e(g)$
    is the level condition ``$c_B\in N^{\ell-|B|}$ for all $B\in E$''. The step (1)', (2)' is
    \texttt{lemma17\_e\_step}; its proof is the printed one with $e=\ell$ (\texttt{lemma17\_reduce\_aux}:
    one choice of $\bar A$, $\varphi$, $\lambda_i$, $h^0_i$ and $h_i=c_{\bar A}h^0_i$, and the claim
    on the exponents $A$ with $|A|+\nu_N(c'_A)=e$; \texttt{lemma17\_step\_aux}: the repetition,
    by induction on the largest exponent $\bar A$ with $|\bar A|+\nu_N(c_{\bar A})=e$ for the
    lexicographic order on the finite set $E(e)$). The passage ``in view of the completeness it
    suffices'' is the iteration $f^{(k+1)}=f^{(k)}-\sum_ih_i^{(k)}f_i$ with the steps
    (1)', (2)' at $e(f^{(k)})\ge e(f)+k$, the sums $h_i=\sum_kh^{(k)}_i$ converging coefficientwise
    because $S$ is complete, and $e(f-\sum h_if_i)=\infty$ because $c_A(f-\sum h_if_i)\in
    N^{n}$ for every $n$. In (1)' the paper tacitly takes $f_i\ne0$; for $f_i=0$ the exponent
    $\nu_M(f_i)=\infty$ is read as $0$.) -/)
  (latexEnv := "lemma")]
theorem exists_normalized_of_isAdicComplete {S : Type u} [CommRing S] [IsLocalRing S]
    [IsNoetherianRing S] [IsAdicComplete (maximalIdeal S) S] {r m : ℕ}
    (f : Fin m → MvPowerSeries (Fin r) S)
    (hf : ∀ j, initialForm (maximalIdeal (MvPowerSeries (Fin r) S)) (f j) ∈
      assocSubalgebra (psVars S r))
    (g : MvPowerSeries (Fin r) S) :
    ∃ h : Fin m → MvPowerSeries (Fin r) S,
      (∀ i, Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) g -
          Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i) ≤
          Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (h i)) ∧
        ∀ A ∈ frameESet (psVars S r) f, psCoeff A (g - ∑ i, h i * f i) = 0 := by
  classical
  -- the preimages `ψᵢ ∈ k[Z]` of the initial forms `φᵢ`
  have hψ : ∀ i, ∃ ψ, frameAlgHom (psVars S r) ψ =
      initialForm (maximalIdeal (MvPowerSeries (Fin r) S)) (f i) := fun i => by
    have := hf i
    rw [assocSubalgebra, Algebra.adjoin_range_eq_range_aeval] at this
    obtain ⟨ψ, hψ⟩ := this
    exact ⟨ψ, hψ⟩
  choose ψ hψ using hψ
  -- `S` is Hausdorff: a coefficient in all `Nⁿ` is zero
  have hhaus : ∀ x : S, (∀ n : ℕ, x ∈ maximalIdeal S ^ n) → x = 0 := fun x hx =>
    IsHausdorff.haus (IsAdicComplete.toIsHausdorff (I := maximalIdeal S) (M := S)) x fun n => by
      rw [SModEq.sub_mem, sub_zero, mem_pow_smul_top_iff_l17]
      exact hx n
  set ν : Fin m → ℕ := fun i =>
    (Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i)).toNat with hν
  have hfν : ∀ i, f i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ ν i := fun i =>
    mem_pow_toNat_ordElem_l17 _ _
  set E := frameESet (psVars S r) f with hEdef
  by_cases hetop : lemma17E E g = ⊤
  · -- `e(g) = ∞`: "we set `h_i = 0` for `1 ≤ i ≤ m` and the assertion is trivially valid"
    refine ⟨0, fun i => ?_, fun A hA => ?_⟩
    · rw [Pi.zero_apply, Ideal.ordElem_eq_top_iff.mpr fun n => zero_mem _]
      exact le_top
    · have hA' : ⇑(Finsupp.equivFunOnFinite.symm A) ∈ E := by simpa using hA
      simp only [Pi.zero_apply, zero_mul, Finset.sum_const_zero, sub_zero, psCoeff]
      refine hhaus _ fun n => ?_
      have := (le_lemma17E_iff E g (n + (Finsupp.equivFunOnFinite.symm A).degree)).mp
        (by rw [hetop]; exact le_top) _ hA'
      rwa [Nat.add_sub_cancel] at this
  -- "Let us assume that `e(f) < ∞`."
  obtain ⟨ℓ₀, hℓ₀⟩ := ENat.ne_top_iff_exists.mp hetop
  have hg₀ : ∀ B : Fin r →₀ ℕ, ⇑B ∈ E →
      MvPowerSeries.coeff B g ∈ maximalIdeal S ^ (ℓ₀ - B.degree) := fun B hB =>
    (le_lemma17E_iff E g ℓ₀).mp hℓ₀.le B hB
  -- "Clearly `e(f) ≥ ν_M(f)`."
  have hνg : Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) g ≤ (ℓ₀ : ℕ∞) :=
    Ideal.ordElem_le fun n hn => by
      rw [hℓ₀]
      exact (le_lemma17E_iff E g n).mpr fun B _ => psLev_of_mem_pow hn B
  -- the step (1)′, (2)′ ("it suffices to show"), made total
  have hstep : ∀ g' : MvPowerSeries (Fin r) S, ∃ δ : Fin m → MvPowerSeries (Fin r) S,
      (lemma17E E g' = ⊤ → δ = 0) ∧ (lemma17E E g' ≠ ⊤ →
        (∀ i, δ i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ ((lemma17E E g').toNat - ν i)) ∧
        lemma17E E g' < lemma17E E (g' - ∑ i, δ i * f i)) := by
    intro g'
    by_cases h : lemma17E E g' = ⊤
    · exact ⟨0, fun _ => rfl, fun h' => absurd h h'⟩
    · obtain ⟨δ, hδ⟩ := lemma17_e_step f ψ hψ g' h
      exact ⟨δ, fun h' => absurd h' h, fun _ => hδ⟩
  choose δ hδtop hδ using hstep
  -- the successive elements `f, f′, f″, …` of the proof: `f^{(k+1)} = f^{(k)} - Σ h_i^{(k)} f_i`,
  -- with the partial sums `H k = Σ_{j < k} h^{(j)}`
  let H : ℕ → Fin m → MvPowerSeries (Fin r) S := fun k =>
    Nat.rec 0 (fun k Hk => Hk + δ (g - ∑ i, Hk i * f i)) k
  have hH0 : H 0 = 0 := rfl
  have hHsucc : ∀ k, H (k + 1) = H k + δ (g - ∑ i, H k i * f i) := fun k => rfl
  have hsucc : ∀ k, g - ∑ i, H (k + 1) i * f i =
      (g - ∑ i, H k i * f i) - ∑ i, δ (g - ∑ i, H k i * f i) i * f i := by
    intro k
    rw [hHsucc]
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
    ring
  -- `e(f^{(k)}) ≥ e(f) + k`: by (2)′ the symbol `e` increases at each step
  have hgood' : ∀ k, ((ℓ₀ + k : ℕ) : ℕ∞) ≤ lemma17E E (g - ∑ i, H k i * f i) := by
    intro k
    induction k with
    | zero => simpa [hH0] using hℓ₀.le
    | succ k ih =>
      by_cases hk : lemma17E E (g - ∑ i, H k i * f i) = ⊤
      · rw [hsucc k, hδtop _ hk]
        simp only [Pi.zero_apply, zero_mul, Finset.sum_const_zero, sub_zero]
        rw [hk]
        exact le_top
      · have h2 := (hδ _ hk).2
        rw [hsucc k]
        have hcast : ((ℓ₀ + (k + 1) : ℕ) : ℕ∞) = ((ℓ₀ + k : ℕ) : ℕ∞) + 1 := by push_cast; ring
        rw [hcast]
        exact le_trans (add_le_add_left ih 1) ((ENat.add_one_le_iff hk).mpr h2)
  have hgood : ∀ k, ∀ B : Fin r →₀ ℕ, ⇑B ∈ E →
      MvPowerSeries.coeff B (g - ∑ i, H k i * f i) ∈ maximalIdeal S ^ (ℓ₀ + k - B.degree) :=
    fun k => (le_lemma17E_iff E _ (ℓ₀ + k)).mp (hgood' k)
  have hinc : ∀ k i, H (k + 1) i - H k i ∈
      maximalIdeal (MvPowerSeries (Fin r) S) ^ (ℓ₀ + k - ν i) := fun k i => by
    rw [hHsucc, Pi.add_apply, add_sub_cancel_left]
    by_cases hk : lemma17E E (g - ∑ i, H k i * f i) = ⊤
    · rw [hδtop _ hk, Pi.zero_apply]
      exact zero_mem _
    · refine Ideal.pow_le_pow_right ?_ ((hδ _ hk).1 i)
      have h1 : ℓ₀ + k ≤ (lemma17E E (g - ∑ i, H k i * f i)).toNat := by
        obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp hk
        have := hgood' k
        rw [← hn] at this
        rw [← hn, ENat.toNat_natCast]
        exact_mod_cast this
      omega
  -- `H k' - H k ∈ M^{ℓ₀ + k - νᵢ}` for `k ≤ k'`
  have hdiff : ∀ k k' i, k ≤ k' → H k' i - H k i ∈
      maximalIdeal (MvPowerSeries (Fin r) S) ^ (ℓ₀ + k - ν i) := by
    intro k k' i hkk'
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkk'
    induction d with
    | zero => simp
    | succ d ihd =>
      rw [show H (k + (d + 1)) i - H k i = (H (k + d + 1) i - H (k + d) i) +
        (H (k + d) i - H k i) by rw [← add_assoc]; ring]
      exact add_mem (Ideal.pow_le_pow_right (by omega) (hinc (k + d) i)) (ihd (by omega))
  have hHmem : ∀ k i, H k i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ (ℓ₀ - ν i) := by
    intro k i
    have := hdiff 0 k i (Nat.zero_le k)
    rwa [hH0, Pi.zero_apply, sub_zero, add_zero] at this
  -- the limits `hᵢ`, coefficientwise (`S` is complete)
  have hlim : ∀ (i : Fin m) (B : Fin r →₀ ℕ), ∃ L : S, ∀ n : ℕ,
      MvPowerSeries.coeff B (H (n + ν i + B.degree) i) - L ∈ maximalIdeal S ^ n := by
    intro i B
    obtain ⟨L, hL⟩ := IsPrecomplete.prec
      (IsAdicComplete.toIsPrecomplete (I := maximalIdeal S) (M := S))
      (f := fun n => MvPowerSeries.coeff B (H (n + ν i + B.degree) i)) fun {a b} hab => by
        rw [SModEq.sub_mem, mem_pow_smul_top_iff_l17, ← map_sub, ← neg_sub]
        refine neg_mem ?_
        have h := psLev_of_mem_pow (hdiff (a + ν i + B.degree) (b + ν i + B.degree) i
          (by omega)) B
        exact Ideal.pow_le_pow_right (by omega) h
    exact ⟨L, fun n => by
      have := hL n
      rwa [SModEq.sub_mem, mem_pow_smul_top_iff_l17] at this⟩
  choose L hL using hlim
  let h : Fin m → MvPowerSeries (Fin r) S := fun i => fun B => L i B
  have hcoeffh : ∀ i B, MvPowerSeries.coeff B (h i) = L i B := fun _ _ => rfl
  -- `hᵢ - H_K i ∈ M^{K - νᵢ}`
  have hhK : ∀ K i, h i - H K i ∈ maximalIdeal (MvPowerSeries (Fin r) S) ^ (K - ν i) := by
    intro K i
    refine mem_pow_of_psLev fun B => ?_
    by_cases hK : K - ν i - B.degree = 0
    · rw [hK, pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    · have hKeq : K = (K - ν i - B.degree) + ν i + B.degree := by omega
      rw [map_sub, hcoeffh, ← neg_sub, show K - ν i - B.degree = K - ν i - B.degree from rfl]
      refine neg_mem ?_
      have := hL i B (K - ν i - B.degree)
      rwa [← hKeq] at this
  refine ⟨h, fun i => ?_, fun A hA => ?_⟩
  · -- (1)
    by_cases hftop : Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i) = ⊤
    · rw [hftop]
      simp
    · have hνi : (ν i : ℕ∞) = Ideal.ordElem (maximalIdeal (MvPowerSeries (Fin r) S)) (f i) :=
        ENat.natCast_toNat hftop
      refine le_trans (tsub_le_tsub hνg hνi.le) ?_
      rw [← ENat.natCast_sub]
      apply Ideal.le_ordElem
      have h1 := hhK ℓ₀ i
      have h2 := hHmem ℓ₀ i
      have := add_mem (Ideal.pow_le_pow_right (by omega) h1) h2
      rwa [sub_add_cancel] at this
  · -- (2)
    refine hhaus _ fun n => ?_
    have hA' : ⇑(Finsupp.equivFunOnFinite.symm A) ∈ frameESet (psVars S r) f := by
      simpa using hA
    set B := Finsupp.equivFunOnFinite.symm A with hB
    have hdecomp : g - ∑ i, h i * f i = (g - ∑ i, H (n + B.degree) i * f i) -
        ∑ i, (h i - H (n + B.degree) i) * f i := by
      simp only [sub_mul, Finset.sum_sub_distrib]
      ring
    rw [psCoeff, ← hB, hdecomp, map_sub]
    refine sub_mem (Ideal.pow_le_pow_right (by omega) (hgood _ _ hA')) ?_
    rw [map_sum]
    refine sum_mem fun i _ => ?_
    have h1 := Ideal.mul_mem_mul (hhK (n + B.degree) i) (hfν i)
    rw [← pow_add] at h1
    have := psLev_of_mem_pow (Ideal.pow_le_pow_right (show n + B.degree ≤ _ by omega) h1) B
    rwa [Nat.add_sub_cancel] at this

end Lemma17

/-! ### Definition 9 (p. 248): regular frames and normalized standard bases -/

section Definition9

open Classical in
/-- Definition 9(1), p. 248: "Let `R` be a regular local ring. Let `S → R` be a local
homomorphism of regular local rings, and `(z₁, …, z_r)` a system of elements of `R` which can
be extended to a regular system of parameters of `R`. (This system may be empty, i.e.
`r = 0`.) If `R/(z₁, …, z_r)R` is canonically isomorphic to `S`, then the system
`(S; z₁, …, z_r)` will be called a *regular frame* of `R`."

(Formalization notes: the local homomorphism `S → R` is carried by the `Algebra S R` field and
`isLocalHom`; the members of the system `(z₁, …, z_r)` are distinct (`z_injective`), since
`extends_rsop` only sees the set of the `z_j` and a regular system of parameters has no repeated
members; "`R/(z₁, …, z_r)R` is canonically isomorphic to `S`" is recorded as: the composite
`S → R → R/(z₁, …, z_r)R` is bijective (`quot_bijective`).  The mere existence of some ring
isomorphism `R ⧸ (z₁, …, z_r)R ≃+* S` is not enough: with `S = ℚ[t]_{(t)}` mapped to
`R = ℚ[x, y]_{(x, y)}` by `t ↦ x` and `z = (x)` there is such an isomorphism, but Lemma 18 and
Theorem 6 fail for this "frame".) -/
@[blueprint "def:III.9"
  (statement := /-- Let $R$ be a regular local ring. Let $S\to R$ be a local homomorphism of
    regular local rings, and $(z_1,\dots,z_r)$ a system of elements of $R$ which can be
    extended to a regular system of parameters of $R$ (\cref{def:rsop}); this system may be
    empty, i.e.\ $r=0$. If $R/(z_1,\dots,z_r)R$ is canonically isomorphic to $S$, then the
    system $(S;z_1,\dots,z_r)$ is called a \emph{regular frame} of $R$. (Definition 9(1),
    p.~248.) (Formalization note: the $z_j$ are required to be distinct, and
    ``canonically isomorphic'' is recorded as the bijectivity of
    the composite $S\to R\to R/(z_1,\dots,z_r)R$; the mere existence of some isomorphism
    $R/(z_1,\dots,z_r)R\simeq S$ does not suffice for Lemma~18 and Theorem~6.) -/)
  (latexEnv := "definition")]
structure RegularFrame (R : Type u) [CommRing R] [IsRegularLocalRing R] where
  /-- The coefficient ring `S` of the frame. -/
  S : Type u
  [commRing : CommRing S]
  [isRegular : IsRegularLocalRing S]
  [algebra : Algebra S R]
  [isLocalHom : IsLocalHom (algebraMap S R)]
  /-- The number `r` of elements of the system `(z₁, …, z_r)`; it may be `0`. -/
  r : ℕ
  /-- The system `(z₁, …, z_r)` of elements of `R`. -/
  z : Fin r → R
  /-- The `z_j` are distinct: a "system which can be extended to a regular system of
  parameters" has no repeated members. -/
  z_injective : Function.Injective z
  /-- `(z₁, …, z_r)` "can be extended to a regular system of parameters of `R`". -/
  extends_rsop : ExtendsToRSOP R (Finset.image z Finset.univ)
  /-- "`R/(z₁, …, z_r)R` is canonically isomorphic to `S`": the composite
  `S → R → R/(z₁, …, z_r)R` is bijective. -/
  quot_bijective :
    Function.Bijective ((Ideal.Quotient.mk (Ideal.span (Set.range z))).comp (algebraMap S R))

attribute [instance] RegularFrame.commRing RegularFrame.isRegular RegularFrame.algebra
  RegularFrame.isLocalHom

namespace RegularFrame

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (F : RegularFrame R)

/-- p. 248: "`P = (z₁, …, z_r)R`". -/
def idealZ : Ideal R := Ideal.span (Set.range F.z)

/-- Definition 9(1), p. 248: "Let `N` (resp. `M`) be the maximal ideal of `S` (resp. `R`),
`k = S/N = R/M`, and `k[Z] = k[Z₁, …, Z_r]` the graded `k`-subalgebra of `gr_M(R)` generated
by the initial forms `Z_i` of `z_i` in `gr_M(R)` for `1 ≤ i ≤ r`. This `k`-subalgebra `k[Z]`
of `gr_M(R)` will be called the *associated (graded) subalgebra* of the regular frame
`(S; z₁, …, z_r)`." -/
@[blueprint "def:III.9-associated-subalgebra"
  (statement := /-- Let $(S;z_1,\dots,z_r)$ be a regular frame of $R$ (\cref{def:III.9}). Let
    $N$ (resp.\ $M$) be the maximal ideal of $S$ (resp.\ $R$), $k=S/N=R/M$, and
    $k[Z]=k[Z_1,\dots,Z_r]$ the graded $k$-subalgebra of $\operatorname{gr}_M(R)$ generated by
    the initial forms $Z_i$ of $z_i$ in $\operatorname{gr}_M(R)$ for $1\le i\le r$
    (\cref{def:II.2-initial-form}). This $k$-subalgebra $k[Z]$ of $\operatorname{gr}_M(R)$ is
    called the \emph{associated (graded) subalgebra} of the regular frame $(S;z_1,\dots,z_r)$.
    (Definition 9(1), p.~248.) -/)
  (latexEnv := "definition")]
noncomputable def assocSubalgebra :
    Subalgebra (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
  Hironaka.assocSubalgebra F.z

/-- A *power series expansion map* of the frame: a ring homomorphism `e : R → S{z₁, …, z_r}`
which sends `s ∈ S` to the constant power series, `z_j` to the variable `Z_j`, and `Pⁿ` into
`(Z₁, …, Z_r)ⁿ` for `P = (z₁, …, z_r)R`.  By \cref{lem:III.9-frame-completion} there is
exactly one such map, namely the composition of `R → R̂_P` with the canonical isomorphism
`R̂_P ≅ S{z₁, …, z_r}` of p. 248; the *power series expansion of `g ∈ R` with respect to the
frame* is the expansion of `e g`. -/
structure IsExpansion (e : R →+* MvPowerSeries (Fin F.r) F.S) : Prop where
  /-- `e` is the identity on the coefficient ring `S`. -/
  map_algebraMap : ∀ s : F.S, e (algebraMap F.S R s) = MvPowerSeries.C s
  /-- `e` sends `z_j` to the `j`-th variable. -/
  map_z : ∀ j, e (F.z j) = MvPowerSeries.X j
  /-- `e` is continuous for the `P`-adic and `(Z₁, …, Z_r)`-adic filtrations. -/
  map_pow : ∀ n : ℕ, ∀ x ∈ F.idealZ ^ n,
    e x ∈ (Ideal.span (Set.range (MvPowerSeries.X : Fin F.r → MvPowerSeries (Fin F.r) F.S))) ^ n

/-- An element of `(Z₁, …, Z_r)ⁿ` in `S{Z₁, …, Z_r}` has order at least `n`. -/
private theorem le_order_of_mem_pow_span_X_aux {S : Type u} [CommRing S] {r : ℕ} (n : ℕ)
    {f : MvPowerSeries (Fin r) S}
    (hf : f ∈ (Ideal.span (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) S))) ^ n) :
    (n : ℕ∞) ≤ f.order := by
  induction n generalizing f with
  | zero => simp
  | succ n ih =>
    rw [pow_succ] at hf
    refine Submodule.mul_induction_on (C := fun f => ((n + 1 : ℕ) : ℕ∞) ≤ f.order) hf ?_ ?_
    · intro a ha b hb
      have h2 : (1 : ℕ∞) ≤ b.order := by
        refine Submodule.span_induction (p := fun b _ => (1 : ℕ∞) ≤ b.order) ?_ ?_ ?_ ?_ hb
        · rintro _ ⟨j, rfl⟩
          rw [MvPowerSeries.one_le_order_iff_constCoeff_eq_zero]
          exact MvPowerSeries.constantCoeff_X j
        · simp
        · intro x y _ _ hx hy
          exact (le_min hx hy).trans MvPowerSeries.min_order_le_add
        · intro c x _ hx
          rw [smul_eq_mul]
          exact (hx.trans le_add_self).trans MvPowerSeries.le_order_mul
      calc ((n + 1 : ℕ) : ℕ∞) = (n : ℕ∞) + 1 := by push_cast; rfl
        _ ≤ a.order + b.order := add_le_add (ih ha) h2
        _ ≤ (a * b).order := MvPowerSeries.le_order_mul
    · intro x y hx hy
      exact (le_min hx hy).trans MvPowerSeries.min_order_le_add

/-- There is at most one power series expansion map of a regular frame: `R = S + Pⁿ` for all
`n` (`R/P` being canonically `S`), and `⋂ₙ (Z)ⁿ = 0` in `S{Z}`. -/
theorem isExpansion_unique_aux {R : Type u} [CommRing R] [IsRegularLocalRing R]
    (F : RegularFrame R) {e e' : R →+* MvPowerSeries (Fin F.r) F.S} (he : F.IsExpansion e)
    (he' : F.IsExpansion e') : e = e' := by
  have hR : ∀ r : R, ∃ s : F.S, r - algebraMap F.S R s ∈ F.idealZ := fun r => by
    obtain ⟨s, hs⟩ := F.quot_bijective.2 (Ideal.Quotient.mk _ r)
    refine ⟨s, ?_⟩
    rw [RingHom.comp_apply, Ideal.Quotient.eq] at hs
    rw [← neg_sub]
    exact neg_mem hs
  have heq : ∀ s, e (algebraMap F.S R s) = e' (algebraMap F.S R s) := fun s => by
    rw [he.map_algebraMap, he'.map_algebraMap]
  -- `Pⁿ ⊆ (D ∩ Pⁿ) + Pⁿ⁺¹` for `D = {r | e r = e' r}`
  have step : ∀ n, ∀ q ∈ F.idealZ ^ n,
      ∃ d, e d = e' d ∧ d ∈ F.idealZ ^ n ∧ q - d ∈ F.idealZ ^ (n + 1) := by
    intro n
    induction n with
    | zero =>
      intro q _
      obtain ⟨s, hs⟩ := hR q
      exact ⟨_, heq s, by simp, by rwa [zero_add, pow_one]⟩
    | succ n ih =>
      intro q hq
      rw [pow_succ] at hq
      refine Submodule.mul_induction_on (C := fun q => ∃ d, e d = e' d ∧
        d ∈ F.idealZ ^ (n + 1) ∧ q - d ∈ F.idealZ ^ (n + 1 + 1)) hq ?_ ?_
      · intro a ha b hb
        obtain ⟨d, hd, hdP, had⟩ := ih a ha
        have hb' : ∃ d', e d' = e' d' ∧ d' ∈ F.idealZ ∧ b - d' ∈ F.idealZ ^ 2 := by
          refine Submodule.span_induction (p := fun b _ => ∃ d', e d' = e' d' ∧
            d' ∈ F.idealZ ∧ b - d' ∈ F.idealZ ^ 2) ?_ ?_ ?_ ?_ hb
          · rintro _ ⟨j, rfl⟩
            exact ⟨F.z j, by rw [he.map_z, he'.map_z], Ideal.subset_span ⟨j, rfl⟩,
              by rw [sub_self]; exact zero_mem _⟩
          · exact ⟨0, by rw [map_zero, map_zero], zero_mem _, by rw [sub_zero]; exact zero_mem _⟩
          · rintro x y _ _ ⟨dx, hdx, hdxP, hxd⟩ ⟨dy, hdy, hdyP, hyd⟩
            refine ⟨dx + dy, by rw [map_add, map_add, hdx, hdy], add_mem hdxP hdyP, ?_⟩
            rw [show x + y - (dx + dy) = (x - dx) + (y - dy) by ring]
            exact add_mem hxd hyd
          · intro c x hx ⟨dx, hdx, hdxP, hxd⟩
            obtain ⟨s, hs⟩ := hR c
            refine ⟨algebraMap F.S R s * dx, by rw [map_mul, map_mul, heq, hdx],
              Ideal.mul_mem_left _ _ hdxP, ?_⟩
            rw [smul_eq_mul, show c * x - algebraMap F.S R s * dx =
              (c - algebraMap F.S R s) * x + algebraMap F.S R s * (x - dx) by ring]
            refine add_mem ?_ (Ideal.mul_mem_left _ _ hxd)
            rw [sq]
            exact Ideal.mul_mem_mul hs hx
        obtain ⟨d', hd', hd'P, hbd⟩ := hb'
        refine ⟨d * d', by rw [map_mul, map_mul, hd, hd'], ?_, ?_⟩
        · rw [pow_succ]
          exact Ideal.mul_mem_mul hdP hd'P
        · rw [show a * b - d * d' = (a - d) * b + d * (b - d') by ring]
          refine add_mem ?_ ?_
          · rw [pow_succ]
            exact Ideal.mul_mem_mul had hb
          · rw [show n + 1 + 1 = n + 2 by ring, pow_add]
            exact Ideal.mul_mem_mul hdP hbd
      · rintro x y ⟨dx, hdx, hdxP, hxd⟩ ⟨dy, hdy, hdyP, hyd⟩
        refine ⟨dx + dy, by rw [map_add, map_add, hdx, hdy], add_mem hdxP hdyP, ?_⟩
        rw [show x + y - (dx + dy) = (x - dx) + (y - dy) by ring]
        exact add_mem hxd hyd
  -- `R = D + Pⁿ`
  have approx : ∀ n (r : R), ∃ d, e d = e' d ∧ r - d ∈ F.idealZ ^ n := by
    intro n
    induction n with
    | zero => exact fun r => ⟨0, by rw [map_zero, map_zero], by simp⟩
    | succ n ih =>
      intro r
      obtain ⟨d, hd, hrd⟩ := ih r
      obtain ⟨d'', hd'', -, hrd''⟩ := step n _ hrd
      refine ⟨d + d'', by rw [map_add, map_add, hd, hd''], ?_⟩
      rwa [show r - (d + d'') = r - d - d'' by ring]
  ext1 r
  have hle : ∀ n : ℕ, (n : ℕ∞) ≤ (e r - e' r).order := by
    intro n
    obtain ⟨d, hd, hrd⟩ := approx n r
    have h1 := he.map_pow n _ hrd
    have h2 := he'.map_pow n _ hrd
    rw [show e r - e' r = e (r - d) - e' (r - d) by rw [map_sub, map_sub, hd]; ring]
    exact le_order_of_mem_pow_span_X_aux n (sub_mem h1 h2)
  rw [← sub_eq_zero, ← MvPowerSeries.order_eq_top_iff]
  exact ENat.eq_top_iff_forall_ge.mpr hle

/-- The evaluation `S[Z] → R`, `Z_j ↦ z_j`, of a regular frame. -/
noncomputable def evZ (F : RegularFrame R) : MvPolynomial (Fin F.r) F.S →ₐ[F.S] R :=
  MvPolynomial.aeval F.z

/-- `S ∩ P = 0`: `S → R/P` is injective. -/
theorem eq_zero_of_algebraMap_mem_idealZ (F : RegularFrame R) {c : F.S}
    (hc : algebraMap F.S R c ∈ F.idealZ) : c = 0 := by
  apply F.quot_bijective.1
  rw [RingHom.comp_apply, RingHom.comp_apply, map_zero, map_zero,
    Ideal.Quotient.eq_zero_iff_mem]
  exact hc

/-- `z` is quasi-regular: `z` is part of a regular system of parameters. -/
theorem isQuasiRegular_z (F : RegularFrame R) : IsQuasiRegular F.z := by
  classical
  obtain ⟨s, hsub, hs⟩ := F.extends_rsop
  have hScard : s.card = (maximalIdeal R).spanFinrank := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hs.2] at h
    exact_mod_cast h.symm
  exact isQuasiRegular_of_isWeaklyRegular F.z
    (isRegular_ofFn_of_minimal hs.1 hScard F.z_injective
      (fun i => hsub (Finset.mem_image_of_mem _ (Finset.mem_univ i)))).toIsWeaklyRegular

/-- `z^A ∈ P^{|A|}`. -/
theorem prod_z_pow_mem (F : RegularFrame R) (A : Fin F.r →₀ ℕ) :
    (A.prod fun j e => F.z j ^ e) ∈ F.idealZ ^ A.degree := by
  rw [Finsupp.prod, Finsupp.degree_apply, ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun j _ =>
    Ideal.pow_mem_pow (show F.z j ∈ F.idealZ from Ideal.subset_span ⟨j, rfl⟩) _

/-- `ev(Z^A) ∈ P^{|A|}`. -/
theorem evZ_monomial_mem (F : RegularFrame R) (A : Fin F.r →₀ ℕ) (c : F.S) :
    evZ F (MvPolynomial.monomial A c) ∈ F.idealZ ^ A.degree := by
  rw [evZ, MvPolynomial.aeval_monomial]
  exact Ideal.mul_mem_left _ _ (prod_z_pow_mem F A)

/-- If all monomials of `G` have degree `≥ n`, then `ev(G) ∈ Pⁿ`. -/
theorem evZ_mem_pow_of_coeff (F : RegularFrame R) {n : ℕ}
    {G : MvPolynomial (Fin F.r) F.S} (hG : ∀ A, A.degree < n → G.coeff A = 0) :
    evZ F G ∈ F.idealZ ^ n := by
  rw [G.as_sum, map_sum]
  refine sum_mem fun A hA => ?_
  have hdeg : n ≤ A.degree := by
    by_contra h
    exact MvPolynomial.mem_support_iff.mp hA (hG A (by omega))
  exact Ideal.pow_le_pow_right hdeg (evZ_monomial_mem F A _)

/-- Injectivity of `S[Z]/(Z)ⁿ → R/Pⁿ`: if `ev(G) ∈ Pⁿ` then `G` has no monomials of degree
`< n` (by quasi-regularity of `z` and `S ∩ P = 0`). -/
theorem coeff_eq_zero_of_evZ_mem_pow (F : RegularFrame R) {n : ℕ}
    {G : MvPolynomial (Fin F.r) F.S} (hG : evZ F G ∈ F.idealZ ^ n) :
    ∀ A, A.degree < n → G.coeff A = 0 := by
  classical
  -- strong induction on the degree
  suffices h : ∀ d, d < n → ∀ A, A.degree = d → G.coeff A = 0 from
    fun A hA => h _ hA A rfl
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
    intro hdn A hA
    -- `G = G_d + (higher)`, the lower part vanishing
    have hlow : ∀ B, B.degree < d → G.coeff B = 0 := fun B hB => ih _ hB (by omega) B rfl
    set Gd := MvPolynomial.homogeneousComponent d G
    have hhigh : evZ F (G - Gd) ∈ F.idealZ ^ (d + 1) := by
      refine evZ_mem_pow_of_coeff F fun B hB => ?_
      rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent]
      by_cases hBd : B.degree = d
      · rw [ite_eq_left hBd, sub_self]
      · rw [ite_eq_right hBd, sub_zero]
        exact hlow B (by omega)
    have hGd : evZ F Gd ∈ F.idealZ ^ (d + 1) := by
      have h1 : evZ F Gd = evZ F G - evZ F (G - Gd) := by rw [map_sub]; ring
      rw [h1]
      exact sub_mem (Ideal.pow_le_pow_right (by omega) hG) hhigh
    -- quasi-regularity applied to `Gd` with coefficients mapped to `R`
    have hK : (MvPolynomial.map (algebraMap F.S R) Gd).IsHomogeneous d :=
      (MvPolynomial.homogeneousComponent_isHomogeneous d G).map _
    have heval : MvPolynomial.eval F.z (MvPolynomial.map (algebraMap F.S R) Gd) = evZ F Gd := by
      rw [evZ, MvPolynomial.eval_map, MvPolynomial.aeval_def]
    have hq := isQuasiRegular_z F d _ hK (by rw [heval]; exact hGd) A
    rw [MvPolynomial.coeff_map] at hq
    have h0 := eq_zero_of_algebraMap_mem_idealZ F hq
    rwa [MvPolynomial.coeff_homogeneousComponent, ite_eq_left hA] at h0

/-- `R = S[z] + Pⁿ`: every `r ∈ R` is `ev(G)` modulo `Pⁿ`. -/
theorem exists_evZ_sub_mem_pow (F : RegularFrame R) (n : ℕ) (x : R) :
    ∃ G : MvPolynomial (Fin F.r) F.S, x - evZ F G ∈ F.idealZ ^ n := by
  classical
  -- `R = S + P`
  have hR : ∀ y : R, ∃ s : F.S, y - algebraMap F.S R s ∈ F.idealZ := fun y => by
    obtain ⟨s, hs⟩ := F.quot_bijective.2 (Ideal.Quotient.mk _ y)
    refine ⟨s, ?_⟩
    rw [RingHom.comp_apply, Ideal.Quotient.eq] at hs
    rw [← neg_sub]
    exact neg_mem hs
  -- `Pⁿ ⊆ ev(S[Z]) + Pⁿ⁺¹`
  have hstep : ∀ k, ∀ y ∈ F.idealZ ^ k, ∃ G : MvPolynomial (Fin F.r) F.S,
      y - evZ F G ∈ F.idealZ ^ (k + 1) := by
    intro k y hy
    obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous F.z y).mp hy
    choose s hs using fun A => hR (K.coeff A)
    refine ⟨∑ A ∈ K.support, MvPolynomial.monomial A (s A), ?_⟩
    have hsplit : MvPolynomial.eval F.z K -
        evZ F (∑ A ∈ K.support, MvPolynomial.monomial A (s A)) =
        ∑ A ∈ K.support, (K.coeff A - algebraMap F.S R (s A)) *
          (A.prod fun j e => F.z j ^ e) := by
      have h1 : MvPolynomial.eval F.z K =
          ∑ A ∈ K.support, K.coeff A * (A.prod fun j e => F.z j ^ e) :=
        MvPolynomial.eval_eq _ _
      have h2 : evZ F (∑ A ∈ K.support, MvPolynomial.monomial A (s A)) =
          ∑ A ∈ K.support, algebraMap F.S R (s A) * (A.prod fun j e => F.z j ^ e) := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun A _ => ?_
        rw [evZ, MvPolynomial.aeval_monomial]
      rw [h1, h2, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun A _ => ?_
      ring
    rw [hsplit]
    refine sum_mem fun A hA => ?_
    have hdeg : A.degree = k := by
      have := hK (MvPolynomial.mem_support_iff.mp hA)
      rw [Finsupp.degree_eq_weight_one]
      exact this
    rw [pow_succ']
    refine Ideal.mul_mem_mul (hs A) ?_
    rw [← hdeg]
    exact prod_z_pow_mem F A
  induction n with
  | zero => exact ⟨0, by simp⟩
  | succ n ih =>
    obtain ⟨G, hG⟩ := ih
    obtain ⟨G', hG'⟩ := hstep n _ hG
    refine ⟨G + G', ?_⟩
    rw [map_add, ← sub_sub]
    exact hG'

/-- A power series all of whose coefficients of degree `< n` vanish lies in `(Z₁, …, Z_r)ⁿ`:
`f = Σ_j Z_j f_j`, each monomial `Z^B ≠ 1` being sorted by the smallest `j` with `b_j > 0`. -/
private theorem mem_span_X_pow_of_coeff {S : Type u} [CommRing S] {r : ℕ} (n : ℕ)
    {f : MvPowerSeries (Fin r) S}
    (hf : ∀ B : Fin r →₀ ℕ, B.degree < n → MvPowerSeries.coeff B f = 0) :
    f ∈ Ideal.span (Set.range (MvPowerSeries.X : Fin r → MvPowerSeries (Fin r) S)) ^ n := by
  classical
  induction n generalizing f with
  | zero => simp
  | succ n ih =>
    let fj : Fin r → MvPowerSeries (Fin r) S := fun j D =>
      if ∀ i < j, D i = 0 then MvPowerSeries.coeff (D + Finsupp.single j 1) f else 0
    have hcoeff : ∀ j D, MvPowerSeries.coeff D (fj j) =
        if ∀ i < j, D i = 0 then MvPowerSeries.coeff (D + Finsupp.single j 1) f else 0 :=
      fun _ _ => rfl
    have hdecomp : f = ∑ j, MvPowerSeries.X j * fj j := by
      ext B
      rw [map_sum]
      simp_rw [MvPowerSeries.X, MvPowerSeries.coeff_monomial_mul, one_mul, hcoeff]
      by_cases hB : B = 0
      · subst hB
        rw [hf 0 (by simp)]
        simp
      · have hsupp : B.support.Nonempty := Finsupp.support_nonempty_iff.mpr hB
        set j₀ := B.support.min' hsupp
        have hj₀ : B j₀ ≠ 0 := Finsupp.mem_support_iff.mp (B.support.min'_mem hsupp)
        have hlt : ∀ i < j₀, B i = 0 := fun i hi => by
          by_contra h0
          exact absurd (B.support.min'_le i (Finsupp.mem_support_iff.mpr h0)) (not_le.mpr hi)
        rw [Finset.sum_eq_single j₀]
        · rw [ite_eq_left (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hj₀)),
            ite_eq_left, tsub_add_cancel_of_le
              (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hj₀))]
          intro i hi
          rw [Finsupp.tsub_apply, Finsupp.single_apply, ite_eq_right (ne_of_lt hi).symm,
            Nat.sub_zero]
          exact hlt i hi
        · intro j _ hj
          split_ifs with h1 h2
          · exfalso
            have hBj : B j ≠ 0 := by
              have := Finsupp.single_le_iff.mp h1
              omega
            rcases lt_or_gt_of_ne hj with hlt' | hgt
            · exact hBj (hlt j hlt')
            · have := h2 j₀ hgt
              rw [Finsupp.tsub_apply, Finsupp.single_apply, ite_eq_right hj, Nat.sub_zero]
                at this
              exact hj₀ this
          · rfl
          · rfl
        · intro h
          exact absurd (Finset.mem_univ j₀) h
    rw [hdecomp]
    refine sum_mem fun j _ => ?_
    rw [pow_succ']
    refine Ideal.mul_mem_mul (Ideal.subset_span ⟨j, rfl⟩) (ih fun D hD => ?_)
    rw [hcoeff]
    split_ifs
    · refine hf _ ?_
      rw [map_add, Finsupp.degree_single]
      omega
    · rfl

/-- The coefficient `c_B(x) ∈ S` of the power series expansion of `x ∈ R`: the coefficient of
`Z^B` in any `G ∈ S[Z]` with `x ≡ G(z)` modulo `P^{|B|+1}`. -/
noncomputable def expCoeff (F : RegularFrame R) (x : R) (B : Fin F.r →₀ ℕ) : F.S :=
  (Classical.choose (exists_evZ_sub_mem_pow F (B.degree + 1) x)).coeff B

theorem expCoeff_eq (F : RegularFrame R) {x : R} {n : ℕ}
    {G : MvPolynomial (Fin F.r) F.S} (hG : x - evZ F G ∈ F.idealZ ^ n)
    {B : Fin F.r →₀ ℕ} (hB : B.degree < n) : expCoeff F x B = G.coeff B := by
  have h0 := Classical.choose_spec (exists_evZ_sub_mem_pow F (B.degree + 1) x)
  set G₀ := Classical.choose (exists_evZ_sub_mem_pow F (B.degree + 1) x)
  have h1 : evZ F (G₀ - G) ∈ F.idealZ ^ (B.degree + 1) := by
    rw [map_sub, show evZ F G₀ - evZ F G = (x - evZ F G) - (x - evZ F G₀) by ring]
    exact sub_mem (Ideal.pow_le_pow_right (by omega) hG) h0
  have h2 := coeff_eq_zero_of_evZ_mem_pow F h1 B (by omega)
  rw [MvPolynomial.coeff_sub, sub_eq_zero] at h2
  exact h2

/-- The power series `Σ_B c_B(x) Z^B`. -/
noncomputable def expansionFun (F : RegularFrame R) (x : R) :
    MvPowerSeries (Fin F.r) F.S :=
  fun B => expCoeff F x B

theorem coeff_expansionFun (F : RegularFrame R) (x : R) (B : Fin F.r →₀ ℕ) :
    MvPowerSeries.coeff B (expansionFun F x) = expCoeff F x B := rfl

/-- The power series expansion map `R → S{z₁, …, z_r}` of a regular frame. -/
noncomputable def expansion (F : RegularFrame R) : R →+* MvPowerSeries (Fin F.r) F.S where
  toFun := expansionFun F
  map_one' := by
    ext B
    rw [coeff_expansionFun, expCoeff_eq F (G := 1) (n := B.degree + 1) (by simp) (by omega),
      MvPolynomial.coeff_one, MvPowerSeries.coeff_one]
    rcases eq_or_ne B 0 with rfl | h
    · simp
    · simp [h, Ne.symm h]
  map_mul' x y := by
    classical
    ext B
    obtain ⟨Gx, hGx⟩ := exists_evZ_sub_mem_pow F (B.degree + 1) x
    obtain ⟨Gy, hGy⟩ := exists_evZ_sub_mem_pow F (B.degree + 1) y
    have hxy : x * y - evZ F (Gx * Gy) ∈ F.idealZ ^ (B.degree + 1) := by
      rw [map_mul, show x * y - evZ F Gx * evZ F Gy =
        (x - evZ F Gx) * y + evZ F Gx * (y - evZ F Gy) by ring]
      exact add_mem (Ideal.mul_mem_right _ _ hGx) (Ideal.mul_mem_left _ _ hGy)
    rw [coeff_expansionFun, expCoeff_eq F hxy (by omega), MvPolynomial.coeff_mul,
      MvPowerSeries.coeff_mul]
    refine Finset.sum_congr rfl fun p hp => ?_
    have hdeg : p.1.degree + p.2.degree = B.degree := by
      rw [← map_add, Finset.HasAntidiagonal.mem_antidiagonal.mp hp]
    rw [coeff_expansionFun, coeff_expansionFun, expCoeff_eq F hGx (by omega),
      expCoeff_eq F hGy (by omega)]
  map_zero' := by
    ext B
    rw [coeff_expansionFun, expCoeff_eq F (G := 0) (n := B.degree + 1) (by simp) (by omega)]
    simp
  map_add' x y := by
    ext B
    obtain ⟨Gx, hGx⟩ := exists_evZ_sub_mem_pow F (B.degree + 1) x
    obtain ⟨Gy, hGy⟩ := exists_evZ_sub_mem_pow F (B.degree + 1) y
    have hxy : x + y - evZ F (Gx + Gy) ∈ F.idealZ ^ (B.degree + 1) := by
      rw [map_add, show x + y - (evZ F Gx + evZ F Gy) = (x - evZ F Gx) + (y - evZ F Gy) by ring]
      exact add_mem hGx hGy
    rw [map_add, coeff_expansionFun, coeff_expansionFun, coeff_expansionFun,
      expCoeff_eq F hxy (by omega), expCoeff_eq F hGx (by omega), expCoeff_eq F hGy (by omega)]
    simp

theorem coeff_expansion (F : RegularFrame R) (x : R) (B : Fin F.r →₀ ℕ) :
    MvPowerSeries.coeff B (expansion F x) = expCoeff F x B := rfl

/-- The expansion map is an expansion map in the sense of `IsExpansion`. -/
theorem isExpansion_expansion (F : RegularFrame R) : F.IsExpansion (expansion F) where
  map_algebraMap s := by
    ext B
    rw [coeff_expansion, expCoeff_eq F (G := MvPolynomial.C s) (n := B.degree + 1)
      (by rw [evZ, MvPolynomial.aeval_C, sub_self]; exact zero_mem _) (by omega),
      MvPolynomial.coeff_C, MvPowerSeries.coeff_C]
    rcases eq_or_ne B 0 with rfl | h
    · simp
    · simp [h, Ne.symm h]
  map_z j := by
    classical
    ext B
    rw [coeff_expansion, expCoeff_eq F (G := MvPolynomial.X j) (n := B.degree + 1)
      (by rw [evZ, MvPolynomial.aeval_X, sub_self]; exact zero_mem _) (by omega),
      MvPolynomial.coeff_X, MvPowerSeries.coeff_X]
    split_ifs <;> first | rfl | (exfalso; tauto)
  map_pow n x hx := by
    refine mem_span_X_pow_of_coeff n fun B hB => ?_
    rw [coeff_expansion, expCoeff_eq F (G := 0) (n := n) (by simpa using hx) hB]
    simp

/-- `c_B(x)` only depends on `x` modulo `P^{|B|+1}`. -/
theorem expCoeff_congr (F : RegularFrame R) {x y : R} {n : ℕ}
    (hxy : x - y ∈ F.idealZ ^ n) {B : Fin F.r →₀ ℕ} (hB : B.degree < n) :
    expCoeff F x B = expCoeff F y B := by
  obtain ⟨G, hG⟩ := exists_evZ_sub_mem_pow F n y
  have hxG : x - evZ F G ∈ F.idealZ ^ n := by
    rw [show x - evZ F G = (x - y) + (y - evZ F G) by ring]
    exact add_mem hxy hG
  rw [expCoeff_eq F hxG hB, expCoeff_eq F hG hB]

/-- A representative in `R` of the `n`-th component of an element of the `P`-adic completion. -/
private noncomputable def complRep (F : RegularFrame R) (x : AdicCompletion F.idealZ R)
    (n : ℕ) : R :=
  Classical.choose (Submodule.Quotient.mk_surjective _ (x.val n))

private theorem complRep_spec (F : RegularFrame R) (x : AdicCompletion F.idealZ R) (n : ℕ) :
    Submodule.Quotient.mk (complRep F x n) = x.val n :=
  Classical.choose_spec (Submodule.Quotient.mk_surjective _ (x.val n))

private theorem complRep_sub_mem (F : RegularFrame R) (x : AdicCompletion F.idealZ R)
    {m n : ℕ} (hmn : m ≤ n) : complRep F x n - complRep F x m ∈ F.idealZ ^ m := by
  have h := x.2 hmn
  rw [← complRep_spec F x n, ← complRep_spec F x m] at h
  rw [← mem_pow_smul_top_iff_l17]
  exact (Submodule.Quotient.eq _).mp h

/-- The canonical map `R̂_P → S{z₁, …, z_r}`. -/
private noncomputable def complFun (F : RegularFrame R) (x : AdicCompletion F.idealZ R) :
    MvPowerSeries (Fin F.r) F.S :=
  fun B => expCoeff F (complRep F x (B.degree + 1)) B

private theorem coeff_complFun (F : RegularFrame R) (x : AdicCompletion F.idealZ R)
    {n : ℕ} (B : Fin F.r →₀ ℕ) (hB : B.degree < n) :
    MvPowerSeries.coeff B (complFun F x) = expCoeff F (complRep F x n) B :=
  expCoeff_congr F (x := complRep F x (B.degree + 1)) (y := complRep F x n)
    (by rw [← neg_sub]; exact neg_mem (complRep_sub_mem F x (by omega))) (by omega)

/-- `coeff_B` of `complFun x` is that of the expansion of any representative of `x` modulo
`Pⁿ`, `n > |B|`. -/
private theorem coeff_complFun' (F : RegularFrame R) (x : AdicCompletion F.idealZ R)
    {n : ℕ} (B : Fin F.r →₀ ℕ) (hB : B.degree < n) :
    MvPowerSeries.coeff B (complFun F x) = MvPowerSeries.coeff B (expansion F (complRep F x n)) :=
  coeff_complFun F x B hB

/-- `(x y)ₙ ≡ xₙ yₙ`. -/
private theorem complRep_mul_sub_mem (F : RegularFrame R) (x y : AdicCompletion F.idealZ R)
    (n : ℕ) : complRep F (x * y) n - complRep F x n * complRep F y n ∈ F.idealZ ^ n := by
  rw [← mem_pow_smul_top_iff_l17]
  refine (Submodule.Quotient.eq _).mp ?_
  rw [complRep_spec, AdicCompletion.val_mul, ← complRep_spec F x n, ← complRep_spec F y n]
  rfl

private theorem complRep_add_sub_mem (F : RegularFrame R) (x y : AdicCompletion F.idealZ R)
    (n : ℕ) : complRep F (x + y) n - (complRep F x n + complRep F y n) ∈ F.idealZ ^ n := by
  rw [← mem_pow_smul_top_iff_l17]
  refine (Submodule.Quotient.eq _).mp ?_
  rw [complRep_spec, AdicCompletion.val_add_apply, ← complRep_spec F x n,
    ← complRep_spec F y n]
  rfl

private theorem complRep_one_sub_mem (F : RegularFrame R) (n : ℕ) :
    complRep F 1 n - 1 ∈ F.idealZ ^ n := by
  rw [← mem_pow_smul_top_iff_l17]
  refine (Submodule.Quotient.eq _).mp ?_
  rw [complRep_spec, AdicCompletion.val_one]
  rfl

private theorem complRep_zero_mem (F : RegularFrame R) (n : ℕ) :
    complRep F 0 n ∈ F.idealZ ^ n := by
  rw [← mem_pow_smul_top_iff_l17, ← Submodule.Quotient.mk_eq_zero, complRep_spec]
  rfl

/-- The canonical ring homomorphism `R̂_P → S{z₁, …, z_r}`. -/
private noncomputable def complHom (F : RegularFrame R) :
    AdicCompletion F.idealZ R →+* MvPowerSeries (Fin F.r) F.S where
  toFun := complFun F
  map_one' := by
    ext B
    rw [coeff_complFun' F 1 B (Nat.lt_succ_self _), ← map_one (expansion F),
      coeff_expansion, coeff_expansion,
      expCoeff_congr F (complRep_one_sub_mem F _) (Nat.lt_succ_self _)]
  map_mul' x y := by
    classical
    ext B
    rw [coeff_complFun' F _ B (Nat.lt_succ_self _), coeff_expansion,
      expCoeff_congr F (complRep_mul_sub_mem F x y _) (Nat.lt_succ_self _), ← coeff_expansion,
      map_mul, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
    refine Finset.sum_congr rfl fun p hp => ?_
    have hdeg : p.1.degree + p.2.degree = B.degree := by
      rw [← map_add, Finset.HasAntidiagonal.mem_antidiagonal.mp hp]
    rw [coeff_complFun' F x p.1 (show p.1.degree < B.degree + 1 by omega),
      coeff_complFun' F y p.2 (show p.2.degree < B.degree + 1 by omega)]
  map_zero' := by
    ext B
    rw [coeff_complFun' F 0 B (Nat.lt_succ_self _), coeff_expansion,
      expCoeff_congr F (by rw [sub_zero]; exact complRep_zero_mem F _) (Nat.lt_succ_self _),
      ← coeff_expansion, map_zero]
  map_add' x y := by
    ext B
    rw [map_add, coeff_complFun' F _ B (Nat.lt_succ_self _),
      coeff_complFun' F x B (Nat.lt_succ_self _), coeff_complFun' F y B (Nat.lt_succ_self _),
      coeff_expansion, expCoeff_congr F (complRep_add_sub_mem F x y _) (Nat.lt_succ_self _),
      ← coeff_expansion, map_add, map_add]

private theorem complHom_injective (F : RegularFrame R) : Function.Injective (complHom F) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  apply AdicCompletion.ext
  intro n
  rw [AdicCompletion.val_zero_apply, ← complRep_spec F x n, Submodule.Quotient.mk_eq_zero,
    mem_pow_smul_top_iff_l17]
  obtain ⟨G, hG⟩ := exists_evZ_sub_mem_pow F n (complRep F x n)
  have hGlow : ∀ B, B.degree < n → G.coeff B = 0 := fun B hB => by
    rw [← expCoeff_eq F hG hB, ← coeff_expansion, ← coeff_complFun' F x B hB]
    show MvPowerSeries.coeff B (complHom F x) = 0
    rw [hx, map_zero]
  have := add_mem hG (evZ_mem_pow_of_coeff F hGlow)
  rwa [sub_add_cancel] at this


private theorem complHom_surjective (F : RegularFrame R) : Function.Surjective (complHom F) := by
  classical
  intro p
  choose T hT using fun n : ℕ => exists_finset_degree_le (r := F.r) n
  -- the truncations of `p` below degree `n`
  let tr : ℕ → MvPolynomial (Fin F.r) F.S := fun n =>
    ∑ B ∈ (T n).filter (fun B => B.degree < n), MvPolynomial.monomial B (MvPowerSeries.coeff B p)
  have hcoeff : ∀ n A, (tr n).coeff A = if A.degree < n then MvPowerSeries.coeff A p else 0 := by
    intro n A
    simp only [tr, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
    rw [Finset.sum_ite_eq']
    by_cases hA : A.degree < n
    · rw [ite_eq_left (Finset.mem_filter.mpr ⟨hT n A hA.le, hA⟩), ite_eq_left hA]
    · have h1 : A ∉ (T n).filter (fun B => B.degree < n) := fun h =>
        hA (Finset.mem_filter.mp h).2
      simp [h1, hA]
  let a : ℕ → R := fun n => evZ F (tr n)
  have hcauchy : AdicCompletion.IsAdicCauchy F.idealZ R a := by
    intro m n hmn
    rw [SModEq.sub_mem, mem_pow_smul_top_iff_l17, ← map_sub]
    refine evZ_mem_pow_of_coeff F fun A hA => ?_
    rw [MvPolynomial.coeff_sub, hcoeff, hcoeff, ite_eq_left hA, ite_eq_left (by omega),
      sub_self]
  refine ⟨AdicCompletion.mk F.idealZ R ⟨a, hcauchy⟩, ?_⟩
  ext B
  show MvPowerSeries.coeff B (complFun F _) = _
  rw [coeff_complFun F _ B (Nat.lt_succ_self _)]
  have hrep : complRep F (AdicCompletion.mk F.idealZ R ⟨a, hcauchy⟩) (B.degree + 1) -
      a (B.degree + 1) ∈ F.idealZ ^ (B.degree + 1) := by
    rw [← mem_pow_smul_top_iff_l17]
    refine (Submodule.Quotient.eq _).mp ?_
    rw [complRep_spec]
    rfl
  rw [expCoeff_congr F hrep (Nat.lt_succ_self _),
    expCoeff_eq F (G := tr (B.degree + 1)) (by rw [sub_self]; exact zero_mem _)
      (Nat.lt_succ_self _), hcoeff, ite_eq_left (Nat.lt_succ_self _)]

/-- Definition 9(1), p. 248: "If `(S; z₁, …, z_r)` is a regular frame of `R`, then
`P = (z₁, …, z_r)R` is a prime ideal of `R` and the completion of `R` with respect to the
powers of `P` is canonically isomorphic to the formal power series ring `S{z₁, …, z_r}` of the
`r` independent variables over the ring `S`."  The uniqueness of the expansion map
(\cref{def:III.9}, `IsExpansion`) is what makes the power series expansion of an element of
`R` with respect to the frame well defined. -/
@[blueprint "lem:III.9-frame-completion"
  (statement := /-- If $(S;z_1,\dots,z_r)$ is a regular frame of $R$ (\cref{def:III.9}), then
    $P=(z_1,\dots,z_r)R$ is a prime ideal of $R$ and the completion of $R$ with respect to the
    powers of $P$ is canonically isomorphic to the formal power series ring $S\{z_1,\dots,z_r\}$
    of the $r$ independent variables over the ring $S$. (Definition 9(1), p.~248.)
    (Formalization note: the last assertion is stated both as the existence of a ring
    isomorphism $\widehat R_P\simeq S\{z_1,\dots,z_r\}$ and as the existence of a unique
    ring homomorphism $R\to S\{z_1,\dots,z_r\}$ which is the identity on $S$, sends $z_j$ to
    the $j$-th variable, and maps $P^n$ into $(Z_1,\dots,Z_r)^n$; the latter is the map giving
    the power series expansion of an element of $R$ used in Definition~9(2).) -/)
  (proof := /-- (The paper asserts this inside Definition~9(1) without proof; the following
    argument is the project's own.) $R/P$ is canonically isomorphic to the regular local ring
    $S$, hence is a domain, so $P$ is prime. Every $x\in R$ is congruent modulo $P^{n}$ to
    $G(z_1,\dots,z_r)$ for a polynomial $G$ over $S$ (since $R/P\simeq S$ and $P=(z_1,\dots,z_r)$),
    and since $(z_1,\dots,z_r)$ extends to a regular system of parameters of $R$ the associated
    graded ring $\operatorname{gr}_P(R)$ is the polynomial ring $(R/P)[Z_1,\dots,Z_r]$, so that
    the coefficients of $G$ of degree $<n$ are determined by $x$ modulo $P^{n}$: they are the
    coefficients $c_B(x)$ of the power series expansion of $x$. The map $x\mapsto\sum_Bc_B(x)z^B$ is
    a ring homomorphism $R\to S\{z_1,\dots,z_r\}$, the identity on $S$, with $z_j\mapsto Z_j$ and
    $P^n\mapsto(Z)^n$. The induced map on the $P$-adic completion is injective, and surjective
    since the truncations of a power series form a Cauchy sequence in $R$; this is the canonical
    isomorphism. Two ring homomorphisms $R\to S\{z_1,\dots,z_r\}$ with these properties agree
    on $S$ and on $P^n$ modulo $P^{n+1}$, hence are equal. -/)
  (latexEnv := "lemma")]
theorem idealZ_isPrime_and_completion :
    F.idealZ.IsPrime ∧
      Nonempty (AdicCompletion F.idealZ R ≃+* MvPowerSeries (Fin F.r) F.S) ∧
      ∃! e : R →+* MvPowerSeries (Fin F.r) F.S, F.IsExpansion e := by
  -- "`R/P` is canonically isomorphic to the regular local ring `S`, hence is a domain, so `P` is
  -- prime"
  have hprime : F.idealZ.IsPrime := by
    have := isDomain_of_isRegularLocalRing F.S
    let e₀ := RingEquiv.ofBijective _ F.quot_bijective
    rw [RegularFrame.idealZ, ← Ideal.Quotient.isDomain_iff_prime]
    exact Function.Injective.isDomain (e₀.symm : R ⧸ Ideal.span (Set.range F.z) →+* F.S)
      e₀.symm.injective
  -- the completion `R̂_P ≅ S{z₁, …, z_r}` and the existence of the expansion map
  obtain ⟨hcompl, e, he⟩ : Nonempty (AdicCompletion F.idealZ R ≃+* MvPowerSeries (Fin F.r) F.S) ∧
      ∃ e : R →+* MvPowerSeries (Fin F.r) F.S, F.IsExpansion e :=
    ⟨⟨RingEquiv.ofBijective (complHom F) ⟨complHom_injective F, complHom_surjective F⟩⟩,
      expansion F, isExpansion_expansion F⟩
  exact ⟨hprime, hcompl, e, he, fun e' he' => isExpansion_unique_aux F he' he⟩

/-- Definition 9(2), p. 248: "Let `(f₁, …, f_i)` be a system of elements of `R` whose initial
forms in `gr_M(R)` belong to the associated subalgebra `k[Z]` of `(S; z₁, …, z_r)`. (The
system `(f₁, …, f_i)` may be empty, i.e. `i = 0`.) Let `I` denote the ideal in `k[Z]`
generated by the initial forms of `f_j` (`1 ≤ j ≤ i`). Let `E` denote the E-set of `I` in
`k[Z]` with respect to `(k; Z₁, …, Z_r)`. We say that an element `g` of `R` is *normalized by
the system `(f₁, …, f_i)` with respect to the regular frame* `(S; z₁, …, z_r)` of `R`, if in
the power series expansion `Σ_{A ∈ Z₀ʳ} c_A z^A`, `c_A ∈ S`, of the element `g` in
`S{z₁, …, z_r}` we have `c_A = 0` for all `A ∈ E`."

(Formalization note: the power series expansion is taken through any expansion map of the
frame; by \cref{lem:III.9-frame-completion} there is exactly one, so the universal
quantification is the paper's statement.) -/
@[blueprint "def:III.9-normalized-by"
  (statement := /-- Let $(S;z_1,\dots,z_r)$ be a regular frame of $R$ (\cref{def:III.9}) and
    let $(f_1,\dots,f_i)$ be a system of elements of $R$ whose initial forms in
    $\operatorname{gr}_M(R)$ belong to the associated subalgebra $k[Z]$ of $(S;z_1,\dots,z_r)$
    (\cref{def:III.9-associated-subalgebra}); the system may be empty, i.e.\ $i=0$. Let $I$
    denote the ideal in $k[Z]$ generated by the initial forms of $f_j$ $(1\le j\le i)$, and
    $E$ the $E$-set of $I$ in $k[Z]$ with respect to $(k;Z_1,\dots,Z_r)$
    (\cref{def:III.7-E-set}). An element $g$ of $R$ is said to be \emph{normalized by the
    system $(f_1,\dots,f_i)$ with respect to the regular frame} $(S;z_1,\dots,z_r)$ of $R$ if
    in the power series expansion $\sum_{A\in\mathbb Z^r_0}c_Az^A$, $c_A\in S$, of the element
    $g$ in $S\{z_1,\dots,z_r\}$ we have $c_A=0$ for all $A\in E$. (Definition 9(2), p.~248.)
    (Formalization note: the expansion is taken through the unique expansion map of
    \cref{lem:III.9-frame-completion}; $I$ is encoded as an ideal of the polynomial ring
    $k[Z_1,\dots,Z_r]$ through the canonical $k$-algebra map $k[Z_1,\dots,Z_r]\to k[Z]$.) -/)
  (latexEnv := "definition")]
def IsNormalizedBy {i : ℕ} (f : Fin i → R) (g : R) : Prop :=
  ∀ e : R →+* MvPowerSeries (Fin F.r) F.S, F.IsExpansion e →
    ∀ A ∈ frameESet F.z f, psCoeff A (e g) = 0

/-- Definition 9(3), p. 248: "A system of elements `(f₁, …, f_m)` of `R` will be said to be
*normalized with respect to* `(S; z₁, …, z_r)` if the following conditions are satisfied:
(i) the initial form of `f_i` in `gr_M(R)` belongs to the associated subalgebra of
`(S; z₁, …, z_r)` for `1 ≤ i ≤ m`, and (ii) `f_i` is normalized by `(f₁, …, f_{i−1})` with
respect to `(S; z₁, …, z_r)` for `1 ≤ i ≤ m`." -/
@[blueprint "def:III.9-normalized-system"
  (statement := /-- A system of elements $(f_1,\dots,f_m)$ of $R$ is said to be
    \emph{normalized with respect to} the regular frame $(S;z_1,\dots,z_r)$ of $R$
    (\cref{def:III.9}) if: (i) the initial form of $f_i$ in $\operatorname{gr}_M(R)$ belongs
    to the associated subalgebra of $(S;z_1,\dots,z_r)$
    (\cref{def:III.9-associated-subalgebra}) for $1\le i\le m$, and (ii) $f_i$ is normalized
    by $(f_1,\dots,f_{i-1})$ with respect to $(S;z_1,\dots,z_r)$
    (\cref{def:III.9-normalized-by}) for $1\le i\le m$. (Definition 9(3), p.~248.) -/)
  (latexEnv := "definition")]
def IsNormalizedSystem {m : ℕ} (f : Fin m → R) : Prop :=
  (∀ i, initialForm (maximalIdeal R) (f i) ∈ F.assocSubalgebra) ∧
    ∀ i : Fin m, F.IsNormalizedBy (fun j : Fin (i : ℕ) => f (Fin.castLE i.2.le j)) (f i)

/-- Definition 9(4), p. 248: "A standard base of an ideal `J` in `R` will be called a
*normalized standard base of `J` with respect to* `(S; z₁, …, z_r)` if it is normalized with
respect to `(S; z₁, …, z_r)`." -/
@[blueprint "def:III.9-normalized-standard-base"
  (statement := /-- A standard base of an ideal $J$ in $R$ (\cref{def:III.3}) is called a
    \emph{normalized standard base of $J$ with respect to} the regular frame
    $(S;z_1,\dots,z_r)$ if it is normalized with respect to $(S;z_1,\dots,z_r)$
    (\cref{def:III.9-normalized-system}). (Definition 9(4), p.~248.) -/)
  (latexEnv := "definition")]
def IsNormalizedStandardBase (J : Ideal R) {m : ℕ} (f : Fin m → R) : Prop :=
  IsStandardBase R J f ∧ F.IsNormalizedSystem f

end RegularFrame

end Definition9

/-! ### Lemma 18 (pp. 248–251) -/

section Lemma18

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The paper's phrase "`(f₁, …, f_i)` can be extended to a standard base of `J`"
(hypothesis (i) of Lemma 18, p. 248): the system is an initial segment of a standard base of
`J` (\cref{def:III.3}). -/
@[blueprint "def:III.7-extends-standard-base"
  (statement := /-- A system $(f_1,\dots,f_i)$ of elements of $R$ \emph{can be extended to a
    standard base of $J$} if there is a standard base $(g_1,\dots,g_m)$ of $J$
    (\cref{def:III.3}) with $i\le m$ and $g_j=f_j$ for $1\le j\le i$. (p.~248.) -/)
  (latexEnv := "definition")]
def ExtendsToStandardBase (J : Ideal R) {i : ℕ} (f : Fin i → R) : Prop :=
  ∃ (m : ℕ) (g : Fin m → R) (h : i ≤ m),
    IsStandardBase R J g ∧ ∀ j : Fin i, g (Fin.castLE h j) = f j

end Lemma18

/-! ### Theorem 6 (p. 251) -/

section Theorem6

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- For a standard base `(f₁, …, f_m)` of `J`, `ν_M(f_j) = ν^{(j)}(J)` (Lemma 1: the degree of
the non-zero initial form of `f_j` is `ν^{(j)}(J)`). -/
private theorem ordElem_eq_nuI_of_isStandardBase_aux (J : Ideal R) {m : ℕ} (f : Fin m → R)
    (hf : IsStandardBase R J f) (j : Fin m) :
    Ideal.ordElem (maximalIdeal R) (f j) = nuI R J (j : ℕ).succPNat := by
  obtain ⟨⟨d, hd, hnu⟩, -⟩ := nuI_eq_of_hasLemma1Properties R J _ hf.2
  rw [show (j : ℕ).succPNat = ⟨(j : ℕ) + 1, Nat.succ_pos _⟩ from rfl, hnu j]
  -- the initial form of `f_j` is non-zero by (iii)
  have hne : initialForm (maximalIdeal R) (f j) ≠ 0 := fun h0 =>
    hf.2.2.2.2 j (by beta_reduce; rw [h0]; exact zero_mem _)
  have htop : Ideal.ordElem (maximalIdeal R) (f j) ≠ ⊤ := fun h => hne (by
    rw [initialForm, dite_eq_left h])
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
  rw [← hn, Nat.cast_inj]
  -- a non-zero element of `grⁿ ∩ gr^{d_j}` forces `n = d_j`
  by_contra hnd
  apply hne
  have h1 := hd j
  rw [initialForm_eq_mk _ hn.symm] at hne h1 ⊢
  obtain ⟨y, hy⟩ := LinearMap.mem_range.mp h1
  have hy0 : y = 0 := by
    rw [← grProj_ofGrPiece_same _ (d j) y, hy]
    exact grProj_mk_ne _ hnd _ _
  rw [← hy, hy0, map_zero]

end Theorem6

/-! ### Definition 10* (p. 251): the integers `τ_{(z)}(f₁, …, f_i)` -/

section Definition10Star

variable (R : Type u) [CommRing R] [IsRegularLocalRing R]

/-- The linear forms in `gr¹_M(R)` given by the classes of a system of elements of `M`. -/
noncomputable def linearForms {n : ℕ} (x : Fin n → maximalIdeal R) :
    Fin n → AssocGraded (maximalIdeal R) :=
  fun j => AssocGraded.mk (maximalIdeal R) 1 (x j) (by rw [pow_one]; exact (x j).2)

/-- The property of the `k`-submodule `T` of `gr¹_M(R)` in Definition 10*, p. 251:
"`((φ₁, …, φ_i) gr_M(R) ∩ k[T]) gr_M(R) = (φ₁, …, φ_i) gr_M(R)`", where `(φ₁, …, φ_i)` is the
system of initial forms of `(f₁, …, f_i)` in `gr_M(R)` and `k[T]` is the `k`-subalgebra of
`gr_M(R)` generated by `T` (the encoding is that of `IsTauSubmodule`, \cref{def:III.6-property},
with `gr_M(J, R)` replaced by `(φ₁, …, φ_i) gr_M(R)`). -/
def IsTauZSubmodule {i : ℕ} (f : Fin i → R)
    (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))) : Prop :=
  T ≤ AssocGraded.homogeneous (maximalIdeal R) 1 ∧
    Ideal.span
        (((Ideal.span (Set.range fun j => initialForm (maximalIdeal R) (f j)) :
            Ideal (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R))) ∩
          (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
            Set (AssocGraded (maximalIdeal R)))) =
      Ideal.span (Set.range fun j => initialForm (maximalIdeal R) (f j))

/-- The `k`-submodule `T` of Definition 10*, p. 251: "the smallest `k`-submodule of
`gr¹_M(R)` such that `((φ₁, …, φ_i) gr_M(R) ∩ k[T]) gr_M(R) = (φ₁, …, φ_i) gr_M(R)`", encoded
without choice as the intersection of all `k`-submodules with the property, exactly as
`tauSubmodule` encodes the `T_a` of the Corollary to Lemma 10 (\cref{cor:III.lem10}). -/
noncomputable def tauZSubmodule {i : ℕ} (f : Fin i → R) :
    Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
  sInf {T | IsTauZSubmodule R f T}

variable {r : ℕ}

/-- The `k`-submodule `T*` of Definition 10*, p. 251: "the `k`-submodule of `gr¹_M(R)`
generated by `T` and `Z₁, …, Z_r`". -/
noncomputable def tauZSubmoduleStar (z : Fin r → R) {i : ℕ} (f : Fin i → R) :
    Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
  tauZSubmodule R f ⊔
    Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm z))

/-- Definition 10*, p. 251: "Let `R` be a regular local ring, `M` the maximal ideal of `R`, and
`(z₁, …, z_r)` a system of elements of `R` which can be extended to a regular system of
parameters of `R`. (This system may be empty.) Let `Z_j` be the initial form of `z_j` in
`gr_M(R)` for `1 ≤ j ≤ r`. Then `(Z) = (Z₁, …, Z_r)` is a system of linearly independent
linear forms in `gr¹_M(R)`. Let `k = R/M`. Let `(f₁, …, f_i)` be a system of elements of `R`
and `(φ₁, …, φ_i)` the system of the initial forms of `f_j` (`1 ≤ j ≤ i`) in `gr_M(R)`. Let
`T` denote the smallest `k`-submodule of `gr¹_M(R)` such that
`((φ₁, …, φ_i) gr_M(R) ∩ k[T]) gr_M(R) = (φ₁, …, φ_i) gr_M(R)`. Let `T*` be the `k`-submodule
of `gr¹_M(R)` generated by `T` and `Z₁, …, Z_r`. We define the integer `τ_{(z)}(f₁, …, f_i)`
to be the rank of `T*` minus `r`."

(Formalization note: the subtraction is truncated subtraction in `ℕ`; the paper's
`rank T* ≥ r` holds because `Z₁, …, Z_r` are linearly independent.  "If `(z)` is an empty
system, then we write `τ(f₁, …, f_i)` for `τ_{(z)}(f₁, …, f_i)`" is the case `r = 0`.) -/
@[blueprint "def:III.10-star"
  (statement := /-- Let $R$ be a regular local ring, $M$ its maximal ideal, and
    $(z_1,\dots,z_r)$ a system of elements of $R$ which can be extended to a regular system of
    parameters of $R$ (\cref{def:rsop}); this system may be empty. Let $Z_j$ be the initial
    form of $z_j$ in $\operatorname{gr}_M(R)$ for $1\le j\le r$, so that $(Z)=(Z_1,\dots,Z_r)$
    is a system of linearly independent linear forms in $\operatorname{gr}^1_M(R)$. Let
    $k=R/M$. Let $(f_1,\dots,f_i)$ be a system of elements of $R$ and
    $(\varphi_1,\dots,\varphi_i)$ the system of the initial forms of $f_j$ $(1\le j\le i)$ in
    $\operatorname{gr}_M(R)$. Let $T$ denote the smallest $k$-submodule of
    $\operatorname{gr}^1_M(R)$ such that
    $((\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)\cap
    k[T])\operatorname{gr}_M(R)=(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$. Let $T^*$
    be the $k$-submodule of $\operatorname{gr}^1_M(R)$ generated by $T$ and $Z_1,\dots,Z_r$.
    The integer $\tau_{(z)}(f_1,\dots,f_i)$ is defined to be the rank of $T^*$ minus $r$.
    A system of elements $(x_1,\dots,x_\tau)$ of $M$ with $\tau=\tau_{(z)}(f_1,\dots,f_i)$ is
    called a \emph{regular system of $\tau_{(z)}$-parameters of $R$ for $(f_1,\dots,f_i)$} if
    the classes of $x_1,\dots,x_\tau$ in $\operatorname{gr}^1_M(R)$ and $Z_1,\dots,Z_r$
    generate the $k$-submodule $T^*$ of $\operatorname{gr}^1_M(R)$. If $(z)$ is an empty
    system, we write $\tau(f_1,\dots,f_i)$ for $\tau_{(z)}(f_1,\dots,f_i)$ and call the above
    $(x_1,\dots,x_\tau)$ a \emph{regular system of $\tau$-parameters of $R$ for
    $(f_1,\dots,f_i)$}. (Definition 10*, p.~251.) -/)
  (latexEnv := "definition")]
noncomputable def tauZ (z : Fin r → R) {i : ℕ} (f : Fin i → R) : ℕ :=
  Module.finrank (R ⧸ maximalIdeal R) (tauZSubmoduleStar R z f) - r

/-- Definition 10*, p. 251: "A system of elements `(x₁, …, x_τ)` of `M` with
`τ = τ_{(z)}(f₁, …, f_i)` will be called a *regular system of `τ_{(z)}`-parameters of `R` for
`(f₁, …, f_i)`* if the classes of `x₁, …, x_τ` in `gr¹_M(R)` and `Z₁, …, Z_r` generate the
`k`-submodule `T*` of `gr¹_M(R)`." -/
def IsRegularSystemOfTauZParameters (z : Fin r → R) {i : ℕ} (f : Fin i → R)
    (x : Fin (tauZ R z f) → maximalIdeal R) : Prop :=
  Submodule.span (R ⧸ maximalIdeal R)
      (Set.range (linearForms R x) ∪ Set.range (frameForm z)) = tauZSubmoduleStar R z f

/-- For `x ∈ grᵉ_I(A)`, `x` is recovered from its degree-`e` component. -/
private theorem ofGrPiece_grProj_of_mem_aux {A : Type*} [CommRing A] (I : Ideal A) {e : ℕ}
    {x : AssocGraded I} (hx : x ∈ AssocGraded.homogeneous I e) :
    AssocGraded.ofGrPiece I e (grProj I e x) = x := by
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
  rw [grProj_ofGrPiece_same]

/-- For `x ∈ gr^{e'}_I(A)` and `e ≠ e'`, the degree-`e` component of `x` vanishes. -/
private theorem grProj_of_mem_ne_aux {A : Type*} [CommRing A] (I : Ideal A) {e e' : ℕ}
    (h : e' ≠ e) {x : AssocGraded I} (hx : x ∈ AssocGraded.homogeneous I e') :
    grProj I e x = 0 := by
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
  exact grProj_ofGrPiece_ne I h y

/-- `gr_M(R) ≅ K[Z₁, …, Z_r]` as graded `K`-algebras (`K = R/M`): an isomorphism `e` of
`K`-algebras which maps the homogeneous part `G_d` onto `gr^d_M(R)` and commutes with taking
homogeneous components. -/
private theorem exists_gradedAlgEquiv_aux :
    ∃ (r : ℕ) (e : MvPolynomial (Fin r) (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R)),
      (∀ (d : ℕ) (p : MvPolynomial (Fin r) (R ⧸ maximalIdeal R)),
        p ∈ MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) d ↔
          e p ∈ AssocGraded.homogeneous (maximalIdeal R) d) ∧
      ∀ (d : ℕ) (p : MvPolynomial (Fin r) (R ⧸ maximalIdeal R)),
        AssocGraded.ofGrPiece (maximalIdeal R) d (grProj (maximalIdeal R) d (e p)) =
          e (MvPolynomial.homogeneousComponent d p) := by
  obtain ⟨S, hScard, hSspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
  have hS : Ideal.span (S : Set R) = maximalIdeal R := hSspan
  let z : Fin S.card → R := fun i => (S.equivFin.symm i : R)
  have hinj : Function.Injective z := Subtype.val_injective.comp S.equivFin.symm.injective
  have hrange : Set.range z = (S : Set R) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (S.equivFin.symm i).2
    · intro hy
      exact ⟨S.equivFin ⟨y, hy⟩, by simp [z]⟩
  have hP : Ideal.span (Set.range z) = maximalIdeal R := by rw [hrange, hS]
  have hz : ∀ i, z i ∈ maximalIdeal R ^ 1 := fun i => by
    rw [pow_one, ← hP]
    exact Ideal.subset_span ⟨i, rfl⟩
  let e := assocGradedAlgEquiv hS hScard hinj (fun i => (S.equivFin.symm i).2) hP hz
  -- `e` maps `G_d` into `gr^d_M(R)`: lift a form of degree `d` to a form over `R`
  have h1 : ∀ (d : ℕ) (p : MvPolynomial (Fin S.card) (R ⧸ maximalIdeal R)),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin S.card) (R ⧸ maximalIdeal R) d →
        e p ∈ AssocGraded.homogeneous (maximalIdeal R) d := by
    intro d p hp
    obtain ⟨q, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective p
    have hq : (MvPolynomial.homogeneousComponent d q).map (Ideal.Quotient.mk (maximalIdeal R)) =
        q.map (Ideal.Quotient.mk (maximalIdeal R)) := by
      rw [← MvPolynomial.homogeneousComponent_eq_self hp]
      ext m
      simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
      split_ifs <;> simp
    rw [← hq]
    show MvPolynomial.aeval _ _ ∈ _
    rw [aeval_mk_map_of_isHomogeneous (maximalIdeal R) z hz
      (MvPolynomial.homogeneousComponent_isHomogeneous d q)]
    exact AssocGraded.mk_mem_homogeneous _ _
  -- taking homogeneous components commutes with `e`
  have h2 : ∀ (d : ℕ) (p : MvPolynomial (Fin S.card) (R ⧸ maximalIdeal R)),
      AssocGraded.ofGrPiece (maximalIdeal R) d (grProj (maximalIdeal R) d (e p)) =
        e (MvPolynomial.homogeneousComponent d p) := by
    intro d p
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent p]
    rw [map_sum, map_sum, map_sum]
    rw [Finset.sum_eq_single d]
    · exact ofGrPiece_grProj_of_mem_aux _
        (h1 d _ (MvPolynomial.homogeneousComponent_mem d p))
    · intro d' _ hd'
      rw [grProj_of_mem_ne_aux _ hd' (h1 d' _ (MvPolynomial.homogeneousComponent_mem d' p)),
        map_zero]
    · intro hd
      rw [MvPolynomial.homogeneousComponent_eq_zero d p (by
        simp only [Finset.mem_range, not_lt] at hd; omega), map_zero, map_zero, map_zero]
  refine ⟨S.card, e, fun d p => ⟨h1 d p, fun hp => ?_⟩, h2⟩
  -- conversely, if `e p ∈ gr^d_M(R)` then all other homogeneous components of `p` vanish
  have hzero : ∀ d', d' ≠ d → MvPolynomial.homogeneousComponent d' p = 0 := by
    intro d' hd'
    apply e.injective
    rw [← h2, grProj_of_mem_ne_aux _ (Ne.symm hd') hp, map_zero, map_zero]
  have hpd : p = MvPolynomial.homogeneousComponent d p := by
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent p]
    rw [Finset.sum_eq_single d (fun d' _ hd' => hzero d' hd')]
    intro hd
    rw [MvPolynomial.homogeneousComponent_eq_zero d p (by
      simp only [Finset.mem_range, not_lt] at hd; omega)]
  rw [hpd]
  exact MvPolynomial.homogeneousComponent_mem d p

/-- The property of Lemma 10 for an ideal `𝔞` of `gr_M(R)` transfers along a graded
isomorphism `e : k[Z₁, …, Z_r] ≅ gr_M(R)`: `T` has it for `𝔞` iff `e⁻¹(T)` has it for
`e⁻¹(𝔞)`. -/
private theorem isTauProp_iff_aux (𝔞 : Ideal (AssocGraded (maximalIdeal R))) {r : ℕ}
    (e : MvPolynomial (Fin r) (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R))
    (hE : ∀ (d : ℕ) (p : MvPolynomial (Fin r) (R ⧸ maximalIdeal R)),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) d ↔
        e p ∈ AssocGraded.homogeneous (maximalIdeal R) d)
    (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))) (μ₀ : ℕ) :
    let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
    ((T ≤ AssocGraded.homogeneous (maximalIdeal R) 1 ∧
      ∀ μ ≤ μ₀, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        (ψ ∈ 𝔞 ↔ ψ ∈ Ideal.span ((𝔞 : Set (AssocGraded (maximalIdeal R))) ∩
          (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
            Set (AssocGraded (maximalIdeal R)))))) ↔
      IsTauSubmoduleMv (R ⧸ maximalIdeal R) r (Ideal.comap e 𝔞)
        (T.comap e.toLinearMap) μ₀) := by
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  have hadj : ∀ p, p ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      ((T.comap e.toLinearMap : Submodule _ _) : Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R)))
      ↔ e p ∈ Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) := by
    intro p
    have hmap : (Algebra.adjoin (R ⧸ maximalIdeal R) ((T.comap e.toLinearMap : Submodule _ _) :
        Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R)))).map (e : _ →ₐ[R ⧸ maximalIdeal R] _) =
        Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) := by
      rw [AlgHom.map_adjoin]
      congr 1
      ext y
      refine ⟨?_, fun hy => ⟨e.symm y, by simpa using hy, by simp⟩⟩
      rintro ⟨x, hx, rfl⟩
      simpa using hx
    rw [← hmap, Subalgebra.mem_map]
    refine ⟨fun h => ⟨p, h, rfl⟩, ?_⟩
    rintro ⟨q, hq, hqp⟩
    rwa [← e.injective hqp]
  have hspan : ∀ p, p ∈ Ideal.span ((Ideal.comap e 𝔞 :
      Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R))) ∩
      (Algebra.adjoin (R ⧸ maximalIdeal R) ((T.comap e.toLinearMap : Submodule _ _) :
        Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R))) :
        Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R)))) ↔
      e p ∈ Ideal.span ((𝔞 : Set (AssocGraded (maximalIdeal R))) ∩
        (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
          Set (AssocGraded (maximalIdeal R)))) := by
    intro p
    have himg : (e : MvPolynomial (Fin r) (R ⧸ maximalIdeal R) → AssocGraded (maximalIdeal R)) ''
        ((Ideal.comap e 𝔞 :
          Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R))) ∩
        (Algebra.adjoin (R ⧸ maximalIdeal R) ((T.comap e.toLinearMap : Submodule _ _) :
          Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R))) :
          Set (MvPolynomial (Fin r) (R ⧸ maximalIdeal R)))) =
        (𝔞 : Set (AssocGraded (maximalIdeal R))) ∩
          (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
            Set (AssocGraded (maximalIdeal R))) := by
      ext y
      constructor
      · rintro ⟨x, ⟨hx1, hx2⟩, rfl⟩
        exact ⟨hx1, (hadj x).mp hx2⟩
      · rintro ⟨hy1, hy2⟩
        refine ⟨e.symm y, ⟨?_, (hadj _).mpr (by simpa using hy2)⟩, by simp⟩
        rw [SetLike.mem_coe, Ideal.mem_comap, AlgEquiv.apply_symm_apply]
        exact hy1
    rw [← himg, ← Ideal.map_span, Ideal.mem_map_of_equiv]
    refine ⟨fun h => ⟨p, h, rfl⟩, ?_⟩
    rintro ⟨q, hq, hqp⟩
    rwa [← e.injective hqp]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun p hp => (hE 1 p).mpr (h1 hp), fun μ hμ p hp => ?_⟩
    rw [Ideal.mem_comap, hspan]
    exact h2 μ hμ (e p) ((hE μ p).mp hp)
  · rintro ⟨h1, h2⟩
    refine ⟨fun t ht => ?_, fun μ hμ ψ hψ => ?_⟩
    · have hmem : e.symm t ∈ T.comap e.toLinearMap := by simpa using ht
      simpa using (hE 1 _).mp (h1 hmem)
    · have hp : e.symm ψ ∈ MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R) μ :=
        (hE μ _).mpr (by simpa using hψ)
      have := h2 μ hμ _ hp
      rwa [Ideal.mem_comap, hspan, AlgEquiv.apply_symm_apply] at this

/-- Lemma 10 for an ideal `𝔞` of `gr_M(R)` generated by homogeneous elements: if `T` and `T'`
have the property of Lemma 10 up to `μ₀ > 0`, so does `T ∩ T'` (Lemma 10 transported along
`gr_M(R) ≅ k[Z]`). -/
private theorem isTauProp_inf_aux (S : Set (AssocGraded (maximalIdeal R)))
    (hS : ∀ x ∈ S, ∃ d, x ∈ AssocGraded.homogeneous (maximalIdeal R) d)
    (T T' : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R))) (μ₀ : ℕ)
    (hμ₀ : 0 < μ₀)
    (hT : T ≤ AssocGraded.homogeneous (maximalIdeal R) 1 ∧
      ∀ μ ≤ μ₀, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        (ψ ∈ Ideal.span S ↔ ψ ∈ Ideal.span ((Ideal.span S : Set (AssocGraded (maximalIdeal R))) ∩
          (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
            Set (AssocGraded (maximalIdeal R))))))
    (hT' : T' ≤ AssocGraded.homogeneous (maximalIdeal R) 1 ∧
      ∀ μ ≤ μ₀, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        (ψ ∈ Ideal.span S ↔ ψ ∈ Ideal.span ((Ideal.span S : Set (AssocGraded (maximalIdeal R))) ∩
          (Algebra.adjoin (R ⧸ maximalIdeal R) (T' : Set (AssocGraded (maximalIdeal R))) :
            Set (AssocGraded (maximalIdeal R)))))) :
    T ⊓ T' ≤ AssocGraded.homogeneous (maximalIdeal R) 1 ∧
      ∀ μ ≤ μ₀, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
        (ψ ∈ Ideal.span S ↔ ψ ∈ Ideal.span ((Ideal.span S : Set (AssocGraded (maximalIdeal R))) ∩
          (Algebra.adjoin (R ⧸ maximalIdeal R) ((T ⊓ T' : Submodule _ _) :
            Set (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R))))) := by
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨r, e, hE, -⟩ := exists_gradedAlgEquiv_aux R
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R)) :=
    MvPolynomial.gradedAlgebra
  -- `e⁻¹((S)) = (e⁻¹(S))` is generated by homogeneous elements
  have hcomap : Ideal.comap e (Ideal.span S) =
      Ideal.span ((e.symm : AssocGraded (maximalIdeal R) → _) '' S) := by
    rw [← Ideal.map_span]
    ext p
    rw [Ideal.mem_comap, Ideal.mem_map_of_equiv]
    refine ⟨fun h => ⟨e p, h, by simp⟩, ?_⟩
    rintro ⟨x, hx, rfl⟩
    simpa using hx
  have hI : (Ideal.comap e (Ideal.span S)).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin r) (R ⧸ maximalIdeal R)) := by
    rw [hcomap]
    refine Ideal.homogeneous_span _ _ ?_
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨d, hd⟩ := hS x hx
    exact ⟨d, (hE d _).mpr (by simpa using hd)⟩
  refine (isTauProp_iff_aux R (Ideal.span S) e hE _ μ₀).mpr ?_
  rw [Submodule.comap_inf]
  exact isTauSubmoduleMv_inf _ r _ hI μ₀ hμ₀ _ _
    ((isTauProp_iff_aux R (Ideal.span S) e hE _ μ₀).mp hT)
    ((isTauProp_iff_aux R (Ideal.span S) e hE _ μ₀).mp hT')

/-- Definition 10*, p. 251: "Note that `T`, `T*` and `τ_{(z)}(f₁, …, f_i)` are uniquely
determined by the given systems `(Z₁, …, Z_r)` and `(f₁, …, f_i)`. (See Lemma 10, §4.)"  With
`T` encoded as the intersection of all `k`-submodules of `gr¹_M(R)` with the property of
Definition 10*, the content of the remark is that this intersection itself has the property,
i.e. that a smallest such submodule exists. -/
@[blueprint "lem:III.10-star-unique"
  (statement := /-- Notation as in \cref{def:III.10-star}. The $k$-submodules $T$ and $T^*$ and
    the integer $\tau_{(z)}(f_1,\dots,f_i)$ are uniquely determined by the given systems
    $(Z_1,\dots,Z_r)$ and $(f_1,\dots,f_i)$. (Definition 10*, p.~251; see Lemma 10 of \S4,
    \cref{lem:III.10}.) (Formalization note: $T$ is encoded as the intersection of all
    $k$-submodules of $\operatorname{gr}^1_M(R)$ with the stated property, so the assertion is
    that this intersection has the property.) -/)
  (proof := /-- Since $R$ is regular, $\operatorname{gr}_M(R)$ is a polynomial ring over $k$
    graded in the natural way and $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$ is a
    homogeneous ideal. By Lemma~10 of \S4 (\cref{lem:III.10}), if $T$ and $T'$ are two
    $k$-submodules of $\operatorname{gr}^1_M(R)$ with the property of
    \cref{def:III.10-star}, then so is $T\cap T'$; as $\operatorname{gr}^1_M(R)$ is
    finite-dimensional over $k$, the intersection of all such submodules is a finite
    intersection and therefore has the property. It is by construction the smallest one, hence
    uniquely determined, and so are $T^*$ and its rank. -/)
  (latexEnv := "lemma")]
theorem tauZSubmodule_spec {i : ℕ} (f : Fin i → R) : IsTauZSubmodule R f (tauZSubmodule R f) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  -- the initial forms `φ_j` are homogeneous, of degrees `d j`
  have hhom : ∀ j, ∃ d, initialForm (maximalIdeal R) (f j) ∈
      AssocGraded.homogeneous (maximalIdeal R) d := by
    intro j
    by_cases htop : Ideal.ordElem (maximalIdeal R) (f j) = ⊤
    · exact ⟨0, by rw [initialForm, dite_eq_left htop]; exact zero_mem _⟩
    · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
      exact ⟨n, by rw [initialForm_eq_mk _ hn.symm]; exact AssocGraded.mk_mem_homogeneous _ _⟩
  choose d hd using hhom
  -- the property of Definition 10* is the property of Lemma 10 for `(φ₁, …, φ_i) gr_M(R)` up
  -- to any degree `μ̄ ≥ deg φ_j`
  have hiff : ∀ T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)),
      IsTauZSubmodule R f T ↔ (T ≤ AssocGraded.homogeneous (maximalIdeal R) 1 ∧
        ∀ μ ≤ (∑ j, d j) + 1, ∀ ψ ∈ AssocGraded.homogeneous (maximalIdeal R) μ,
          (ψ ∈ Ideal.span (Set.range fun j => initialForm (maximalIdeal R) (f j)) ↔
            ψ ∈ Ideal.span (((Ideal.span (Set.range fun j => initialForm (maximalIdeal R) (f j)) :
              Ideal (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R))) ∩
              (Algebra.adjoin (R ⧸ maximalIdeal R) (T : Set (AssocGraded (maximalIdeal R))) :
                Set (AssocGraded (maximalIdeal R)))))) := by
    intro T
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨h1, fun μ _ ψ _ => by rw [h2]⟩
    · rintro ⟨h1, h2⟩
      refine ⟨h1, le_antisymm (Ideal.span_le.mpr fun x hx => hx.1) ?_⟩
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      exact (h2 (d j) ((Finset.single_le_sum (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ j)).trans (Nat.le_succ _)) _ (hd j)).mp (Ideal.subset_span ⟨j, rfl⟩)
  -- by Lemma 10, the property is stable under intersections
  have hinf : ∀ T T' : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)),
      IsTauZSubmodule R f T → IsTauZSubmodule R f T' → IsTauZSubmodule R f (T ⊓ T') := by
    intro T T' hT hT'
    rw [hiff] at hT hT' ⊢
    refine isTauProp_inf_aux R _ ?_ T T' _ (Nat.succ_pos _) hT hT'
    rintro _ ⟨j, rfl⟩
    exact ⟨d j, hd j⟩
  -- the submodules with the property lie in the finite-dimensional `gr¹_M(R)`
  have hfin : ∀ T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)),
      IsTauZSubmodule R f T → FiniteDimensional (R ⧸ maximalIdeal R) T := by
    intro T hT
    have : FiniteDimensional (R ⧸ maximalIdeal R) (AssocGraded.homogeneous (maximalIdeal R) 1) := by
      refine Module.Finite.iff_fg.mpr ?_
      rw [AssocGraded.homogeneous, LinearMap.range_eq_map]
      exact Module.Finite.fg_top.map _
    exact Submodule.finiteDimensional_of_le hT.1
  -- `gr¹_M(R)` has the property, since it generates `gr_M(R)` (a polynomial ring over `k`)
  have hone : IsTauZSubmodule R f (AssocGraded.homogeneous (maximalIdeal R) 1) := by
    obtain ⟨r, e, hE, -⟩ := exists_gradedAlgEquiv_aux R
    have htop : Algebra.adjoin (R ⧸ maximalIdeal R)
        (AssocGraded.homogeneous (maximalIdeal R) 1 : Set (AssocGraded (maximalIdeal R))) = ⊤ := by
      refine eq_top_iff.mpr fun y _ => ?_
      obtain ⟨p, rfl⟩ := e.surjective y
      have hp : p ∈ Algebra.adjoin (R ⧸ maximalIdeal R) (Set.range (MvPolynomial.X :
          Fin r → MvPolynomial (Fin r) (R ⧸ maximalIdeal R))) := by
        rw [MvPolynomial.adjoin_range_X]
        exact Algebra.mem_top
      have hmap := Subalgebra.mem_map (f := (e : MvPolynomial (Fin r) (R ⧸ maximalIdeal R)
        →ₐ[R ⧸ maximalIdeal R] AssocGraded (maximalIdeal R))).mpr ⟨p, hp, rfl⟩
      rw [AlgHom.map_adjoin] at hmap
      refine Algebra.adjoin_mono ?_ hmap
      rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      exact (hE 1 _).mp (MvPolynomial.isHomogeneous_X _ j)
    refine ⟨le_rfl, ?_⟩
    rw [htop, Algebra.coe_top, Set.inter_univ, Ideal.span_eq]
  -- a submodule `T₀` with the property, of minimal rank; it is contained in every other one
  have hex : ∃ k, ∃ T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)),
      IsTauZSubmodule R f T ∧ Module.finrank (R ⧸ maximalIdeal R) T = k := ⟨_, _, hone, rfl⟩
  obtain ⟨T₀, hPT₀, hk⟩ := Nat.find_spec hex
  have := hfin T₀ hPT₀
  have hle : ∀ T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)),
      IsTauZSubmodule R f T → T₀ ≤ T := by
    intro T hT
    have h1 : T₀ ⊓ T = T₀ := Submodule.eq_of_le_of_finrank_le inf_le_left
      (hk ▸ Nat.find_min' hex ⟨_, hinf _ _ hPT₀ hT, rfl⟩)
    rw [← h1]
    exact inf_le_right
  have heq : tauZSubmodule R f = T₀ := le_antisymm (sInf_le hPT₀) (le_sInf hle)
  rw [heq]
  exact hPT₀

end Definition10Star

/-! ### Lemma 19 (pp. 251–252) -/

section Lemma19

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The `k`-submodule `T*` of Lemma 19, p. 251: "the `k`-submodule of `gr_M(R)` which is
generated by the initial forms of a regular system of `a`-th `τ`-parameters of `J` and those
of `(z) = (z₁, …, z_r)` in `gr_M(R)`". -/
noncomputable def tauParamsSubmoduleStar (J : Ideal R) (a : ℕ)
    (x : Fin (tau R J a) → maximalIdeal R) {r : ℕ} (z : Fin r → R) :
    Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
  Submodule.span (R ⧸ maximalIdeal R) (Set.range (linearForms R x) ∪ Set.range (frameForm z))

/-! #### The proof of Lemma 19

The coordinates of the printed proof (p. 252): elements `x₁, …, x_t, y₁, …, y_s` of `S` such that
`(z, x, y)` is a regular system of parameters of `R` and `T*` is generated by the initial forms
`Z, X` of `z, x` (`exists_adapted_rsop`).  Transport to a polynomial ring: such a system gives a
graded isomorphism `k[Z, X, Y] ≅ gr_M(R)` (`exists_adapted_transport`, from
`exists_transport_of_rsop`), under which the initial form of an element with expansion
`Σ c_A z^A` is `Σ Z^A c̄_A(X, Y)` (the `c_A` of `M`-adic order `≥ ν - |A|`, `exists_isLevel`)
and `T*` becomes `⟨Z, X⟩`.  The `E`-set argument of the paper (Remark 2), with the split
`c̄_A = c̄'_A + c̄''_A`, `c̄'_A ∈ k[X]`, `c̄''_A ∈ (Y) k[X, Y]`, is `core_mem_adjoin_adapted`
(`π` the projection `Y_j ↦ 0`; the more general `core_mem_adjoin`, with `π` a projection onto an
arbitrary `T`, is used by other statements). -/

section Lemma19Proof

open MvPolynomial

section Core

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable {K : Type u} [Field K] {r s : ℕ}

/-- The span of the variables `W_j = X_{r+j}`. -/
private noncomputable def wSpan (K : Type u) [Field K] (r s : ℕ) :
    Submodule K (MvPolynomial (Fin (r + s)) K) :=
  Submodule.span K (Set.range fun j : Fin s => X (Fin.natAdd r j))

private theorem X_natAdd_mem_wSpan (j : Fin s) :
    (X (Fin.natAdd r j) : MvPolynomial (Fin (r + s)) K) ∈ wSpan K r s :=
  Submodule.subset_span ⟨j, rfl⟩

/-- A linear form is a `Z`-part plus a `W`-part. -/
private theorem exists_decomp_linear {L : MvPolynomial (Fin (r + s)) K}
    (hL : L ∈ homogeneousSubmodule (Fin (r + s)) K 1) :
    ∃ LZ ∈ Submodule.span K (Set.range fun i : Fin r => (X (Fin.castAdd s i) :
        MvPolynomial (Fin (r + s)) K)), ∃ LW ∈ wSpan K r s, L = LZ + LW := by
  rw [homogeneousSubmodule_one_eq_span_X] at hL
  have hrange : Set.range (X : Fin (r + s) → MvPolynomial (Fin (r + s)) K) =
      Set.range (fun i : Fin r => (X (Fin.castAdd s i) : MvPolynomial (Fin (r + s)) K)) ∪
        Set.range (fun j : Fin s => (X (Fin.natAdd r j) : MvPolynomial (Fin (r + s)) K)) := by
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      refine Fin.addCases (fun i => ?_) (fun j => ?_) v
      · exact Or.inl ⟨i, rfl⟩
      · exact Or.inr ⟨j, rfl⟩
    · rintro (⟨i, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨_, rfl⟩
      · exact ⟨_, rfl⟩
  rw [hrange, Submodule.span_union, Submodule.mem_sup] at hL
  obtain ⟨LZ, hLZ, LW, hLW, rfl⟩ := hL
  exact ⟨LZ, hLZ, LW, hLW, rfl⟩

variable (T : Submodule K (MvPolynomial (Fin (r + s)) K))

/-- The projection data: a complement `U` of `T ∩ W` in the span `W` of the `W`-variables and
the projection of `W` onto `T ∩ W` along `U`. -/
private noncomputable def coreProj : wSpan K r s →ₗ[K] wSpan K r s :=
  Submodule.projection (T.comap (wSpan K r s).subtype)
    (Classical.choose (Submodule.exists_isCompl (T.comap (wSpan K r s).subtype)))
    (Classical.choose_spec (Submodule.exists_isCompl (T.comap (wSpan K r s).subtype)))

private theorem coreProj_mem (w : wSpan K r s) : ((coreProj T w : wSpan K r s) :
    MvPolynomial (Fin (r + s)) K) ∈ T :=
  Submodule.projection_apply_mem
    (Classical.choose_spec (Submodule.exists_isCompl (T.comap (wSpan K r s).subtype))) w

private theorem coreProj_of_mem (w : wSpan K r s) (hw : (w : MvPolynomial (Fin (r + s)) K) ∈ T) :
    coreProj T w = w :=
  Submodule.projection_apply_left _ (⟨w, hw⟩ : T.comap (wSpan K r s).subtype)

/-- The images of the variables under `π`. -/
private noncomputable def coreVar : Fin (r + s) → MvPolynomial (Fin (r + s)) K :=
  Fin.addCases (fun i => X (Fin.castAdd s i))
    (fun j => ((coreProj T ⟨X (Fin.natAdd r j), X_natAdd_mem_wSpan j⟩ : wSpan K r s) :
      MvPolynomial (Fin (r + s)) K))

/-- The algebra endomorphism `π` of `K[Z, W]`: the identity on `Z`, and the projection of the
`W`-variables onto `T ∩ W` along a complement. -/
private noncomputable def coreπ : MvPolynomial (Fin (r + s)) K →ₐ[K] MvPolynomial (Fin (r + s)) K :=
  aeval (coreVar T)

private theorem coreπ_X_castAdd (i : Fin r) :
    coreπ T (X (Fin.castAdd s i)) = X (Fin.castAdd s i) := by
  simp [coreπ, coreVar]

private theorem coreπ_of_mem_wSpan (w : wSpan K r s) :
    coreπ T (w : MvPolynomial (Fin (r + s)) K) = (coreProj T w : MvPolynomial (Fin (r + s)) K) := by
  obtain ⟨w, hw⟩ := w
  induction hw using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    simp [coreπ, coreVar]
  | zero =>
    show coreπ T 0 = ((coreProj T 0 : wSpan K r s) : MvPolynomial (Fin (r + s)) K)
    rw [map_zero, map_zero]
    rfl
  | add x y hx hy ihx ihy =>
    have := congrArg (fun z : wSpan K r s => (z : MvPolynomial (Fin (r + s)) K))
      (map_add (coreProj T) ⟨x, hx⟩ ⟨y, hy⟩)
    simp only [Submodule.coe_add] at this
    rw [map_add, ihx, ihy]
    exact this.symm
  | smul c x hx ih =>
    have := congrArg (fun z : wSpan K r s => (z : MvPolynomial (Fin (r + s)) K))
      (map_smul (coreProj T) c ⟨x, hx⟩)
    simp only [Submodule.coe_smul] at this
    rw [map_smul, ih]
    exact this.symm

private theorem wSpan_le_homogeneous :
    wSpan K r s ≤ homogeneousSubmodule (Fin (r + s)) K 1 := by
  rw [wSpan, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  exact isHomogeneous_X K _

private theorem coreπ_of_mem_spanZ {LZ : MvPolynomial (Fin (r + s)) K}
    (hLZ : LZ ∈ Submodule.span K (Set.range fun i : Fin r => (X (Fin.castAdd s i) :
        MvPolynomial (Fin (r + s)) K))) : coreπ T LZ = LZ := by
  induction hLZ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact coreπ_X_castAdd T i
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | smul c x _ hx => rw [map_smul, hx]

private theorem coreπ_of_mem (hT1 : T ≤ homogeneousSubmodule (Fin (r + s)) K 1)
    (hTZ : ∀ i : Fin r, (X (Fin.castAdd s i) : MvPolynomial (Fin (r + s)) K) ∈ T)
    {L : MvPolynomial (Fin (r + s)) K} (hL : L ∈ T) : coreπ T L = L := by
  obtain ⟨LZ, hLZ, LW, hLW, rfl⟩ := exists_decomp_linear (hT1 hL)
  have hLZT : LZ ∈ T := by
    refine (Submodule.span_le.mpr ?_) hLZ
    rintro _ ⟨i, rfl⟩
    exact hTZ i
  have hLWT : LW ∈ T := by
    have := sub_mem hL hLZT
    rwa [add_sub_cancel_left] at this
  rw [map_add, coreπ_of_mem_wSpan T ⟨LW, hLW⟩, coreProj_of_mem T ⟨LW, hLW⟩ hLWT,
    coreπ_of_mem_spanZ T hLZ]

/-- `π` is the identity on `K[T]`. -/
private theorem coreπ_of_mem_adjoin (hT1 : T ≤ homogeneousSubmodule (Fin (r + s)) K 1)
    (hTZ : ∀ i : Fin r, (X (Fin.castAdd s i) : MvPolynomial (Fin (r + s)) K) ∈ T)
    {F : MvPolynomial (Fin (r + s)) K} (hF : F ∈ Algebra.adjoin K (T : Set _)) :
    coreπ T F = F := by
  induction hF using Algebra.adjoin_induction with
  | mem x hx => exact coreπ_of_mem T hT1 hTZ hx
  | algebraMap c => exact AlgHom.commutes _ c
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]

private theorem coreVar_mem (hTZ : ∀ i : Fin r, (X (Fin.castAdd s i) :
    MvPolynomial (Fin (r + s)) K) ∈ T) (v : Fin (r + s)) : coreVar T v ∈ T := by
  refine Fin.addCases (fun i => ?_) (fun j => ?_) v
  · simp only [coreVar, Fin.addCases_left]
    exact hTZ i
  · simp only [coreVar, Fin.addCases_right]
    exact coreProj_mem T _

/-- The image of `π` lies in `K[T]`. -/
private theorem coreπ_mem_adjoin (hTZ : ∀ i : Fin r, (X (Fin.castAdd s i) :
    MvPolynomial (Fin (r + s)) K) ∈ T) (F : MvPolynomial (Fin (r + s)) K) :
    coreπ T F ∈ Algebra.adjoin K (T : Set _) := by
  have h : (coreπ T).range ≤ Algebra.adjoin K (T : Set _) := by
    rw [coreπ, MvPolynomial.aeval_range]
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨v, rfl⟩
    exact coreVar_mem T hTZ v
  exact h ⟨F, rfl⟩

private theorem coreVar_homogeneous (v : Fin (r + s)) :
    (coreVar T v).IsHomogeneous 1 := by
  refine Fin.addCases (fun i => ?_) (fun j => ?_) v
  · simp only [coreVar, Fin.addCases_left]
    exact isHomogeneous_X K _
  · simp only [coreVar, Fin.addCases_right]
    exact wSpan_le_homogeneous (coreProj T _).2

/-- `π` preserves forms of degree `d`. -/
private theorem coreπ_homogeneous {F : MvPolynomial (Fin (r + s)) K} {d : ℕ}
    (hF : F.IsHomogeneous d) : (coreπ T F).IsHomogeneous d := by
  have := hF.aeval (coreVar T) (coreVar_homogeneous T)
  rwa [one_mul] at this

/-- `π` commutes with taking homogeneous components. -/
private theorem homogeneousComponent_coreπ (F : MvPolynomial (Fin (r + s)) K) (d : ℕ) :
    homogeneousComponent d (coreπ T F) = coreπ T (homogeneousComponent d F) := by
  classical
  conv_lhs => rw [← sum_homogeneousComponent F]
  rw [map_sum, map_sum, Finset.sum_eq_single d]
  · rw [homogeneousComponent_of_mem (coreπ_homogeneous T (homogeneousComponent_isHomogeneous d F)),
      ite_eq_left rfl]
  · intro e _ hed
    rw [homogeneousComponent_of_mem (coreπ_homogeneous T (homogeneousComponent_isHomogeneous e F)),
      ite_eq_right (Ne.symm hed)]
  · intro hd
    rw [homogeneousComponent_eq_zero d F (by simpa [Nat.lt_succ_iff] using hd), map_zero,
      map_zero]


/-- The `Z`-part `(b_1, …, b_r)` of an exponent `B` of `K[Z, W]`. -/
def zPart (B : Fin (r + s) →₀ ℕ) : Fin r → ℕ := fun i => B (Fin.castAdd s i)

omit [Field K] in
private theorem castAdd_notMem_range_natAdd (i : Fin r) :
    Fin.castAdd s i ∉ Set.range (Fin.natAdd r : Fin s → Fin (r + s)) := by
  rintro ⟨j, hj⟩
  have := congrArg Fin.val hj
  simp at this
  omega

/-- Monomials of polynomials in the `W`-variables have zero `Z`-part. -/
private theorem zPart_eq_zero_of_mem_supported {Q : MvPolynomial (Fin (r + s)) K}
    (hQ : Q ∈ supported K (Set.range (Fin.natAdd r : Fin s → Fin (r + s))))
    {D : Fin (r + s) →₀ ℕ} (hD : D ∈ Q.support) (i : Fin r) : D (Fin.castAdd s i) = 0 := by
  classical
  by_contra h
  rw [mem_supported] at hQ
  have hv : Fin.castAdd s i ∈ Q.vars :=
    (mem_vars_iff_mem_support _).mpr ⟨D, hD, Finsupp.mem_support_iff.mpr h⟩
  exact castAdd_notMem_range_natAdd i (hQ hv)

private theorem wSpan_le_supported :
    (wSpan K r s : Set (MvPolynomial (Fin (r + s)) K)) ⊆
      supported K (Set.range (Fin.natAdd r : Fin s → Fin (r + s))) := by
  intro w hw
  induction hw using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact Algebra.subset_adjoin ⟨_, ⟨j, rfl⟩, rfl⟩
  | zero => exact zero_mem _
  | add x y _ _ hx hy => exact add_mem hx hy
  | smul c x _ hx => exact Subalgebra.smul_mem _ hx c

private theorem prod_X_castAdd_pow (e : Fin r → ℕ) (t : Finset (Fin r)) :
    ∏ i ∈ t, (X (Fin.castAdd s i) : MvPolynomial (Fin (r + s)) K) ^ e i =
      monomial (∑ i ∈ t, Finsupp.single (Fin.castAdd s i) (e i)) 1 := by
  classical
  induction t using Finset.induction_on with
  | empty => simp
  | insert j t hj ih =>
    rw [Finset.prod_insert hj, ih, Finset.sum_insert hj, X_pow_eq_monomial, monomial_mul_monomial,
      one_mul]

private theorem sum_single_castAdd_apply (e : Fin r → ℕ) (i : Fin r) :
    (∑ i' : Fin r, Finsupp.single (Fin.castAdd s i') (e i')) (Fin.castAdd s i) = e i := by
  classical
  rw [Finsupp.finsetSum_apply, Finset.sum_eq_single i]
  · simp
  · intro i' _ hi'
    rw [Finsupp.single_apply, ite_eq_right]
    intro h
    exact hi' (Fin.castAdd_injective _ _ h)
  · intro h
    exact absurd (Finset.mem_univ i) h

/-- `π` preserves the `Z`-parts of exponents: every monomial of `π(F)` has the `Z`-part of a
monomial of `F` (`π` fixes the `Z`-variables and maps the `W`-variables into `span(W)`). -/
private theorem exists_zPart_eq_of_mem_support_coreπ (F : MvPolynomial (Fin (r + s)) K)
    {B : Fin (r + s) →₀ ℕ} (hB : B ∈ (coreπ T F).support) :
    ∃ B' ∈ F.support, zPart B = zPart B' := by
  classical
  -- `π(Z^{B'_Z} W^{B'_W}) = Z^{B'_Z} · Q` with `Q` a polynomial in the `W`-variables
  have hmon : ∀ B' : Fin (r + s) →₀ ℕ, ∃ Q ∈ supported K (Set.range (Fin.natAdd r :
      Fin s → Fin (r + s))), coreπ T (monomial B' 1) =
        monomial (∑ i : Fin r, Finsupp.single (Fin.castAdd s i) (B' (Fin.castAdd s i))) 1 * Q := by
    intro B'
    refine ⟨∏ j : Fin s, coreVar T (Fin.natAdd r j) ^ B' (Fin.natAdd r j),
      prod_mem fun j _ => pow_mem (wSpan_le_supported (by
        simp only [coreVar, Fin.addCases_right]; exact (coreProj T _).2)) _, ?_⟩
    rw [coreπ, aeval_monomial, map_one, one_mul, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      Fin.prod_univ_add]
    congr 1
    simp only [coreVar, Fin.addCases_left]
    exact prod_X_castAdd_pow _ _
  -- expand `F` into monomials
  have hF : coreπ T F = ∑ B' ∈ F.support, F.coeff B' • coreπ T (monomial B' 1) := by
    conv_lhs => rw [F.as_sum]
    rw [map_sum]
    refine Finset.sum_congr rfl fun B' _ => ?_
    rw [← map_smul, smul_monomial, smul_eq_mul, mul_one]
  rw [hF] at hB
  obtain ⟨B', hB', hBB'⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hB)
  refine ⟨B', hB', ?_⟩
  have hBB'' := support_smul hBB'
  obtain ⟨Q, hQ, hQeq⟩ := hmon B'
  rw [hQeq, mem_support_iff, coeff_monomial_mul'] at hBB''
  split_ifs at hBB'' with hle
  · rw [one_mul] at hBB''
    funext i
    have h0 := zPart_eq_zero_of_mem_supported hQ (mem_support_iff.mpr hBB'') i
    rw [Finsupp.tsub_apply, sum_single_castAdd_apply] at h0
    have hle' := hle (Fin.castAdd s i)
    rw [sum_single_castAdd_apply] at hle'
    simp only [zPart]
    omega
  · exact absurd rfl hBB''


omit [Field K] in
/-- Homogeneous components of a product: if `u_a v_b ∈ I` whenever `a + b = d`, then the
degree-`d` component of `u v` lies in `I`. -/
theorem homogeneousComponent_mul_mem {K : Type u} [CommRing K] {σ : Type*}
    {I : Ideal (MvPolynomial σ K)} (u v : MvPolynomial σ K) (d : ℕ)
    (h : ∀ a b, a + b = d → homogeneousComponent a u * homogeneousComponent b v ∈ I) :
    homogeneousComponent d (u * v) ∈ I := by
  classical
  rw [show u * v = (∑ a ∈ Finset.range (u.totalDegree + 1), homogeneousComponent a u) *
    (∑ b ∈ Finset.range (v.totalDegree + 1), homogeneousComponent b v) by
      rw [sum_homogeneousComponent, sum_homogeneousComponent], Finset.sum_mul_sum, map_sum]
  refine sum_mem fun a _ => ?_
  rw [map_sum]
  refine sum_mem fun b _ => ?_
  rw [homogeneousComponent_of_mem ((homogeneousComponent_isHomogeneous a u).mul
    (homogeneousComponent_isHomogeneous b v))]
  split_ifs with hd
  · exact h a b hd.symm
  · exact zero_mem _

omit [Field K] in
/-- An exponent in the `E`-set translates into the `E`-set. -/
theorem add_mem_eSet {K : Type u} [CommRing K] {n : ℕ}
    {I : Ideal (MvPolynomial (Fin n) K)} {A : Fin n → ℕ} (hA : A ∈ ESet I) (B : Fin n → ℕ) :
    A + B ∈ ESet I := by
  obtain ⟨A₀, hA₀, B₀, rfl⟩ := hA
  exact ⟨A₀, hA₀, B₀ + B, add_assoc _ _ _⟩

/-- `π` commutes with taking homogeneous components, for an algebra endomorphism `π` preserving
forms. -/
private theorem homogeneousComponent_proj
    (π : MvPolynomial (Fin (r + s)) K →ₐ[K] MvPolynomial (Fin (r + s)) K)
    (hπhom : ∀ {F : MvPolynomial (Fin (r + s)) K} {d : ℕ}, F.IsHomogeneous d →
      (π F).IsHomogeneous d)
    (F : MvPolynomial (Fin (r + s)) K) (d : ℕ) :
    homogeneousComponent d (π F) = π (homogeneousComponent d F) := by
  classical
  conv_lhs => rw [← sum_homogeneousComponent F]
  rw [map_sum, map_sum, Finset.sum_eq_single d]
  · rw [homogeneousComponent_of_mem (hπhom (homogeneousComponent_isHomogeneous d F)),
      ite_eq_left rfl]
  · intro e _ hed
    rw [homogeneousComponent_of_mem (hπhom (homogeneousComponent_isHomogeneous e F)),
      ite_eq_right (Ne.symm hed)]
  · intro hd
    rw [homogeneousComponent_eq_zero d F (by simpa [Nat.lt_succ_iff] using hd), map_zero,
      map_zero]

/-- The algebraic core of the proofs of Lemma 19 and Theorem 7 (pp. 251–253), for an arbitrary
projection `π`.  In `K[Z, W] = K[Z₁, …, Z_r, W₁, …, W_s]`, let `I₀` be a homogeneous ideal of `K[Z]`
with E-set `E`, `G` an ideal whose homogeneous parts of degree `< ν` lie in `I₀ K[Z, W]`, and `T` a
space of linear forms.  Let `π` be a `K`-algebra endomorphism of `K[Z, W]` which fixes the `Z_i`,
fixes `K[T]` pointwise, maps `K[Z, W]` into `K[T]`, preserves forms of each degree, and does not
create `Z`-parts of exponents (every monomial of `π(F)` has the `Z`-part of a monomial of `F`).
If a form `φ` of degree `ν` lies in `((G ∩ K[T]) K[Z, W])` and none of its monomials has its
`Z`-part in `E`, then `φ ∈ K[T]`: `φ - π(φ) ∈ I₀ K[Z, W]`, and by Remark 2 its leading exponent
would have its `Z`-part in `E`. -/
theorem core_mem_adjoin_of_proj
    (π : MvPolynomial (Fin (r + s)) K →ₐ[K] MvPolynomial (Fin (r + s)) K)
    (hπX : ∀ i : Fin r, π (X (Fin.castAdd s i)) = X (Fin.castAdd s i))
    (hπfix : ∀ F ∈ Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)), π F = F)
    (hπrange : ∀ F, π F ∈ Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)))
    (hπhom : ∀ {F : MvPolynomial (Fin (r + s)) K} {d : ℕ}, F.IsHomogeneous d →
      (π F).IsHomogeneous d)
    (hπZ : ∀ (F : MvPolynomial (Fin (r + s)) K) {B : Fin (r + s) →₀ ℕ}, B ∈ (π F).support →
      ∃ B' ∈ F.support, zPart B = zPart B')
    (I₀ : Ideal (MvPolynomial (Fin r) K))
    (hI₀ : I₀.IsHomogeneous (homogeneousSubmodule (Fin r) K))
    (G : Ideal (MvPolynomial (Fin (r + s)) K))
    (ν : ℕ) (φ : MvPolynomial (Fin (r + s)) K) (hφ : φ.IsHomogeneous ν)
    (hφG : φ ∈ Ideal.span ((G : Set (MvPolynomial (Fin (r + s)) K)) ∩
      (Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)) :
        Set (MvPolynomial (Fin (r + s)) K))))
    (hG : ∀ d < ν, ∀ ψ ∈ G, homogeneousComponent d ψ ∈ I₀.map (rename (Fin.castAdd s)))
    (hE : ∀ B ∈ φ.support, zPart B ∉ ESet I₀) :
    φ ∈ Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)) := by
  classical
  set I := I₀.map (rename (R := K) (Fin.castAdd s)) with hIdef
  -- (1) `φ - π(φ) ∈ I₀ K[Z, W]`
  have hspanG : Ideal.span ((G : Set (MvPolynomial (Fin (r + s)) K)) ∩
      (Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)) :
        Set (MvPolynomial (Fin (r + s)) K))) ≤ G :=
    Ideal.span_le.mpr Set.inter_subset_left
  have hclaim : ∀ x ∈ Ideal.span ((G : Set (MvPolynomial (Fin (r + s)) K)) ∩
      (Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)) :
        Set (MvPolynomial (Fin (r + s)) K))),
      ∀ d ≤ ν, homogeneousComponent d (x - π x) ∈ I := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      intro d _
      rw [hπfix _ hx.2, sub_self, map_zero]
      exact zero_mem _
    | zero =>
      intro d _
      simp
    | add x y _ _ hx hy =>
      intro d hd
      rw [map_add, show x + y - (π x + π y) = (x - π x) + (y - π y) by
        ring, map_add]
      exact add_mem (hx d hd) (hy d hd)
    | smul a x hxmem hx =>
      intro d hd
      rw [smul_eq_mul, map_mul, show a * x - π a * π x =
        (a - π a) * x + π a * (x - π x) by ring, map_add]
      refine add_mem (homogeneousComponent_mul_mem _ _ d fun e e' hee' => ?_)
        (homogeneousComponent_mul_mem _ _ d fun e e' hee' => ?_)
      · by_cases he : e = 0
        · subst he
          rw [map_sub, homogeneousComponent_proj π hπhom, homogeneousComponent_zero,
            show π (C (a.coeff 0)) = C (a.coeff 0) from AlgHom.commutes _ _, sub_self,
            zero_mul]
          exact zero_mem _
        · exact Ideal.mul_mem_left _ _ (hG e' (by omega) x (hspanG hxmem))
      · exact Ideal.mul_mem_left _ _ (hx e' (by omega))
  have hφ'' : φ - π φ ∈ I := by
    have h := hclaim φ hφG ν le_rfl
    rwa [map_sub, homogeneousComponent_proj π hπhom, homogeneousComponent_of_mem hφ, ite_eq_left rfl]
      at h
  by_cases h0 : φ - π φ = 0
  · rw [sub_eq_zero] at h0
    rw [h0]
    exact hπrange φ
  -- (2) the `E`-set argument
  exfalso
  have hsupp : ∀ B ∈ (φ - π φ).support, zPart B ∉ ESet I₀ := by
    intro B hB hBE
    rcases Finset.mem_union.mp (support_sub _ _ _ hB) with h1 | h1
    · exact hE B h1 hBE
    · obtain ⟨B', hB', hBB'⟩ := hπZ φ h1
      exact hE B' hB' (hBB' ▸ hBE)
  have hφne : φ ≠ 0 := by
    rintro rfl
    exact h0 (by simp)
  obtain ⟨B₀, hB₀⟩ := MvPolynomial.support_nonempty.mpr hφne
  -- the leading exponent `B*` of `φ - π(φ)`
  obtain ⟨Bs, hBs, hEF, -⟩ := eFunction_spec_aux h0
  have hhom'' : φ - π φ ∈ homogeneousSubmodule (Fin (r + s)) K ν :=
    sub_mem hφ (hπhom hφ)
  have hΛ : ⇑Bs ∈ ESet I := ⟨_, ⟨_, hφ'', h0, ⟨ν, hhom''⟩, hEF.symm⟩, 0, (add_zero _).symm⟩
  rcases Nat.eq_zero_or_pos r with hr | hr
  · -- `r = 0`: `I₀ ≠ 0` contains a non-zero constant, and `E = Z₀⁰`
    subst hr
    have hI₀ne : I₀ ≠ ⊥ := by
      rintro h
      rw [hIdef, h, Ideal.map_bot] at hφ''
      exact h0 ((Submodule.mem_bot _).mp hφ'')
    obtain ⟨c, hcI, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI₀ne
    have hcE : EFunction c ∈ ESet I₀ := ⟨_, ⟨c, hcI, hc0, ⟨0, by
      rw [mem_homogeneousSubmodule, MvPolynomial.eq_C_of_isEmpty c]
      exact isHomogeneous_C _ _⟩, rfl⟩, 0, (add_zero _).symm⟩
    refine hsupp Bs hBs ?_
    have : zPart Bs = EFunction c := funext fun i => i.elim0
    rw [this]
    exact hcE
  rcases Nat.eq_zero_or_pos s with hs | hs
  · -- `s = 0`: impossible here, `π` is then the identity
    subst hs
    apply h0
    rw [sub_eq_zero, eq_comm]
    have hall : π = AlgHom.id K (MvPolynomial (Fin (r + 0)) K) :=
      MvPolynomial.algHom_ext fun v => by
        refine Fin.addCases (fun i => ?_) (fun j => j.elim0) v
        exact hπX i
    exact AlgHom.congr_fun hall φ
  -- `r ≥ 1`, `s ≥ 1`: Remark 2
  have hbound := eSet_isBound_qInj_image (S := K) hr (show r < r + s by omega) I₀ hI₀
  have hcast : (Fin.castLE (show r < r + s by omega).le : Fin r → Fin (r + s)) =
      Fin.castAdd s := funext fun i => Fin.ext rfl
  rw [hcast] at hbound
  obtain ⟨_, ⟨A₀, hA₀, rfl⟩, B', hBB⟩ := hbound.2 _ hΛ
  refine hsupp Bs hBs ?_
  have : zPart Bs = A₀ + fun i => B' (Fin.castAdd s i) := by
    funext i
    have := congrFun hBB (Fin.castAdd s i)
    simp only [Pi.add_apply, qInj] at this
    rw [dite_eq_left (show ((Fin.castAdd s i : Fin (r + s)) : ℕ) < r from i.2)] at this
    simpa [zPart] using this
  rw [this]
  exact add_mem_eSet hA₀ _


/-- The algebraic core of the proofs of Lemma 19 and Theorem 7 (pp. 251–253).  In
`K[Z, W] = K[Z₁, …, Z_r, W₁, …, W_s]`, let `I₀` be a homogeneous ideal of `K[Z]` with E-set
`E`, `G` an ideal whose homogeneous parts of degree `< ν` lie in `I₀ K[Z, W]`, and `T` a space
of linear forms containing the `Z_i`.  If a form `φ` of degree `ν` lies in
`((G ∩ K[T]) K[Z, W])` and none of its monomials has its `Z`-part in `E`, then `φ ∈ K[T]`.
(With `π` the endomorphism fixing `T` and killing a complement of `T ∩ span(W)` in `span(W)`,
`φ - π(φ) ∈ I₀ K[Z, W]`; by Remark 2 its leading exponent would have its `Z`-part in `E`.) -/
theorem core_mem_adjoin (I₀ : Ideal (MvPolynomial (Fin r) K))
    (hI₀ : I₀.IsHomogeneous (homogeneousSubmodule (Fin r) K))
    (G : Ideal (MvPolynomial (Fin (r + s)) K))
    (hT1 : T ≤ homogeneousSubmodule (Fin (r + s)) K 1)
    (hTZ : ∀ i : Fin r, (X (Fin.castAdd s i) : MvPolynomial (Fin (r + s)) K) ∈ T)
    (ν : ℕ) (φ : MvPolynomial (Fin (r + s)) K) (hφ : φ.IsHomogeneous ν)
    (hφG : φ ∈ Ideal.span ((G : Set (MvPolynomial (Fin (r + s)) K)) ∩
      (Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)) :
        Set (MvPolynomial (Fin (r + s)) K))))
    (hG : ∀ d < ν, ∀ ψ ∈ G, homogeneousComponent d ψ ∈ I₀.map (rename (Fin.castAdd s)))
    (hE : ∀ B ∈ φ.support, zPart B ∉ ESet I₀) :
    φ ∈ Algebra.adjoin K (T : Set (MvPolynomial (Fin (r + s)) K)) :=
  core_mem_adjoin_of_proj T (coreπ T) (coreπ_X_castAdd T)
    (fun _ hF => coreπ_of_mem_adjoin T hT1 hTZ hF) (coreπ_mem_adjoin T hTZ)
    (fun hF => coreπ_homogeneous T hF)
    (fun F {_B} hB => exists_zPart_eq_of_mem_support_coreπ T F hB) I₀ hI₀ G ν φ hφ hφG hG hE

end Core

namespace RegularFrame


/-- `z_j ∈ M`. -/
theorem z_mem_maximalIdeal (F : RegularFrame R) (i : Fin F.r) : F.z i ∈ maximalIdeal R := by
  classical
  obtain ⟨s, hsub, hs⟩ := F.extends_rsop
  rw [← hs.1]
  exact Ideal.subset_span (hsub (Finset.mem_image_of_mem _ (Finset.mem_univ i)))

/-- `P ⊆ M`. -/
private theorem idealZ_le_maximalIdeal (F : RegularFrame R) : F.idealZ ≤ maximalIdeal R :=
  Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact z_mem_maximalIdeal F i)

/-- `S → R` is local: `s ∈ N ↔ s ∈ M`. -/
theorem algebraMap_mem_maximalIdeal_iff_aux (F : RegularFrame R) (t : F.S) :
    algebraMap F.S R t ∈ maximalIdeal R ↔ t ∈ maximalIdeal F.S := by
  rw [mem_maximalIdeal, mem_maximalIdeal, mem_nonunits_iff, mem_nonunits_iff, isUnit_map_iff]

/-- The retraction `R → R/P ≅ S`. -/
noncomputable def retr (F : RegularFrame R) : R →+* F.S :=
  (RingEquiv.ofBijective _ F.quot_bijective).symm.toRingHom.comp
    (Ideal.Quotient.mk (Ideal.span (Set.range F.z)))

theorem retr_algebraMap (F : RegularFrame R) (t : F.S) :
    retr F (algebraMap F.S R t) = t := by
  show (RingEquiv.ofBijective _ F.quot_bijective).symm
    ((RingEquiv.ofBijective _ F.quot_bijective) t) = t
  exact RingEquiv.symm_apply_apply _ _

theorem sub_retr_mem (F : RegularFrame R) (x : R) :
    x - algebraMap F.S R (retr F x) ∈ F.idealZ := by
  have h : Ideal.Quotient.mk (Ideal.span (Set.range F.z)) (algebraMap F.S R (retr F x)) =
      Ideal.Quotient.mk (Ideal.span (Set.range F.z)) x := by
    show (RingEquiv.ofBijective _ F.quot_bijective)
      ((RingEquiv.ofBijective _ F.quot_bijective).symm
        (Ideal.Quotient.mk (Ideal.span (Set.range F.z)) x)) = _
    exact RingEquiv.apply_symm_apply _ _
  rw [← Ideal.Quotient.eq]
  exact h.symm

theorem retr_z (F : RegularFrame R) (i : Fin F.r) : retr F (F.z i) = 0 := by
  show (RingEquiv.ofBijective _ F.quot_bijective).symm
    (Ideal.Quotient.mk (Ideal.span (Set.range F.z)) (F.z i)) = 0
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr
    (show F.z i ∈ Ideal.span (Set.range F.z) from Ideal.subset_span ⟨i, rfl⟩), map_zero]

theorem retr_mem_maximalIdeal (F : RegularFrame R) {x : R} (hx : x ∈ maximalIdeal R) :
    retr F x ∈ maximalIdeal F.S := by
  rw [← algebraMap_mem_maximalIdeal_iff_aux]
  have h := (idealZ_le_maximalIdeal F) (sub_retr_mem F x)
  have : algebraMap F.S R (retr F x) = x - (x - algebraMap F.S R (retr F x)) := by ring
  rw [this]
  exact sub_mem hx h

/-- A regular system of parameters `(z₁, …, z_r, w₁, …, w_s)` of `R` with `w_j ∈ S` generating
the maximal ideal of `S`. -/
theorem exists_rsop_append (F : RegularFrame R) : ∃ (s : ℕ) (w : Fin s → F.S),
    (∀ j, w j ∈ maximalIdeal F.S) ∧ maximalIdeal F.S ≤ Ideal.span (Set.range w) ∧
    Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) = maximalIdeal R ∧
    ((F.r + s : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
  classical
  obtain ⟨s₀, hsub, hs₀⟩ := F.extends_rsop
  set Y := s₀ \ Finset.image F.z Finset.univ with hYdef
  set W := Y.image (retr F) with hWdef
  let w : Fin W.card → F.S := fun j => (W.equivFin.symm j : F.S)
  have hwrange : Set.range w = (W : Set F.S) := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      exact (W.equivFin.symm j).2
    · intro hy
      exact ⟨W.equivFin ⟨y, hy⟩, by simp [w]⟩
  have hs₀M : ∀ x ∈ s₀, x ∈ maximalIdeal R := fun x hx => by
    rw [← hs₀.1]
    exact Ideal.subset_span hx
  have hwN : ∀ j, w j ∈ maximalIdeal F.S := by
    intro j
    have hj : w j ∈ W := by
      rw [← Finset.mem_coe, ← hwrange]
      exact ⟨j, rfl⟩
    obtain ⟨x, hx, hxj⟩ := Finset.mem_image.mp hj
    rw [← hxj]
    exact retr_mem_maximalIdeal F (hs₀M x (Finset.mem_sdiff.mp hx).1)
  have hNle : maximalIdeal F.S ≤ Ideal.span (Set.range w) := by
    intro t ht
    have h1 : algebraMap F.S R t ∈ Ideal.span (s₀ : Set R) := by
      rw [hs₀.1]
      exact (algebraMap_mem_maximalIdeal_iff_aux F t).mpr ht
    have h2 := Ideal.mem_map_of_mem (retr F) h1
    rw [retr_algebraMap, Ideal.map_span] at h2
    refine (Ideal.span_le.mpr ?_) h2
    rintro _ ⟨x, hx, rfl⟩
    by_cases hxz : x ∈ Finset.image F.z Finset.univ
    · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hxz
      rw [SetLike.mem_coe, retr_z]
      exact zero_mem _
    · refine Ideal.subset_span ?_
      rw [hwrange]
      exact Finset.mem_image_of_mem _ (Finset.mem_sdiff.mpr ⟨hx, hxz⟩)
  have hspan : Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
      maximalIdeal R := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨v, rfl⟩
      refine Fin.addCases (fun i => ?_) (fun j => ?_) v
      · rw [Fin.append_left]
        exact z_mem_maximalIdeal F i
      · rw [Fin.append_right]
        exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hwN j)
    · intro x hx
      have h1 : x - algebraMap F.S R (retr F x) ∈
          Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
        refine Ideal.span_mono ?_ (sub_retr_mem F x)
        rintro _ ⟨i, rfl⟩
        exact ⟨Fin.castAdd _ i, Fin.append_left _ _ i⟩
      have h2 : algebraMap F.S R (retr F x) ∈
          Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
        have := Ideal.mem_map_of_mem (algebraMap F.S R) (hNle (retr_mem_maximalIdeal F hx))
        rw [Ideal.map_span] at this
        refine Ideal.span_mono ?_ this
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        exact ⟨Fin.natAdd F.r j, Fin.append_right _ _ j⟩
      have := add_mem h1 h2
      rwa [sub_add_cancel] at this
  -- the dimension count
  have hcardz : (Finset.image F.z Finset.univ).card = F.r := by
    rw [Finset.card_image_of_injective _ F.z_injective, Finset.card_univ, Fintype.card_fin]
  have hY : Y.card = s₀.card - F.r := by rw [Finset.card_sdiff_of_subset hsub, hcardz]
  have hWY : W.card ≤ Y.card := Finset.card_image_le
  have hle1 : F.r ≤ s₀.card := by
    have := Finset.card_le_card hsub
    omega
  have hle2 : s₀.card ≤ F.r + W.card := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hs₀.2] at h1
    have h2 : (maximalIdeal R).spanFinrank = s₀.card := by exact_mod_cast h1
    have h3 := Submodule.spanFinrank_span_le_ncard_of_finite (R := R)
      (Set.finite_range (Fin.append F.z (algebraMap F.S R ∘ w)))
    have h4 : (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))).ncard ≤ F.r + W.card := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
    have h5 : Submodule.span R (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
        maximalIdeal R := hspan
    rw [h5, h2] at h3
    omega
  refine ⟨W.card, w, hwN, hNle, hspan, ?_⟩
  rw [← hs₀.2]
  congr 2
  omega


/-- `M ⊆ φ(N)R + P`. -/
private theorem maximalIdeal_le_sup (F : RegularFrame R) :
    maximalIdeal R ≤ Ideal.map (algebraMap F.S R) (maximalIdeal F.S) ⊔ F.idealZ := by
  intro x hx
  have h := add_mem (Ideal.mem_sup_left (Ideal.mem_map_of_mem (algebraMap F.S R)
    (retr_mem_maximalIdeal F hx)) : _ ∈ Ideal.map (algebraMap F.S R) (maximalIdeal F.S) ⊔
      F.idealZ) (Ideal.mem_sup_right (sub_retr_mem F x))
  rwa [add_sub_cancel] at h

/-- `φ(N) R ⊆ M`. -/
private theorem map_maximalIdeal_le_aux (F : RegularFrame R) :
    Ideal.map (algebraMap F.S R) (maximalIdeal F.S) ≤ maximalIdeal R :=
  Ideal.map_le_iff_le_comap.mpr fun t ht => (algebraMap_mem_maximalIdeal_iff_aux F t).mpr ht

/-- `Mᵈ⁻¹ I ⊆ Mᵈ` for `I ⊆ M`. -/
private theorem pow_pred_mul_le {I : Ideal R} (hI : I ≤ maximalIdeal R) (d : ℕ) :
    maximalIdeal R ^ (d - 1) * I ≤ maximalIdeal R ^ d := by
  rcases d with _ | d
  · simp
  · rw [Nat.add_sub_cancel, pow_succ]
    exact Ideal.mul_mono_right hI

/-- `Mᵈ ⊆ φ(Nᵈ) R + P Mᵈ⁻¹`. -/
private theorem maximalIdeal_pow_le (F : RegularFrame R) (d : ℕ) :
    maximalIdeal R ^ d ≤ Ideal.map (algebraMap F.S R) (maximalIdeal F.S ^ d) ⊔
      F.idealZ * maximalIdeal R ^ (d - 1) := by
  induction d with
  | zero => simp [Ideal.map_top]
  | succ d ih =>
    rw [pow_succ, Nat.add_sub_cancel]
    refine (Ideal.mul_mono ih (maximalIdeal_le_sup F)).trans ?_
    rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup]
    refine sup_le (sup_le ?_ ?_) (sup_le ?_ ?_)
    · rw [← Ideal.map_mul, ← pow_succ]
      exact le_sup_left
    · refine le_sup_of_le_right ?_
      rw [mul_comm]
      refine Ideal.mul_mono_right ?_
      rw [Ideal.map_pow]
      exact Ideal.pow_right_mono (map_maximalIdeal_le_aux F) d
    · refine le_sup_of_le_right ?_
      rw [mul_assoc]
      exact Ideal.mul_mono_right (pow_pred_mul_le (map_maximalIdeal_le_aux F) d)
    · refine le_sup_of_le_right ?_
      rw [mul_assoc]
      exact Ideal.mul_mono_right (pow_pred_mul_le (idealZ_le_maximalIdeal F) d)

/-- Elements of `φ(Nᵈ) R` are `φ(c)`, `c ∈ Nᵈ`, modulo `P Mᵈ`. -/
private theorem exists_sub_mem_of_mem_map (F : RegularFrame R) (d : ℕ) {a : R}
    (ha : a ∈ Ideal.map (algebraMap F.S R) (maximalIdeal F.S ^ d)) :
    ∃ c ∈ maximalIdeal F.S ^ d, a - algebraMap F.S R c ∈ F.idealZ * maximalIdeal R ^ d := by
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨c, hc, rfl⟩ := hx
    exact ⟨c, hc, by rw [sub_self]; exact zero_mem _⟩
  | zero => exact ⟨0, zero_mem _, by rw [map_zero, sub_self]; exact zero_mem _⟩
  | add x y _ _ hx hy =>
    obtain ⟨c, hc, hxc⟩ := hx
    obtain ⟨c', hc', hyc'⟩ := hy
    refine ⟨c + c', add_mem hc hc', ?_⟩
    rw [map_add, show x + y - (algebraMap F.S R c + algebraMap F.S R c') =
      (x - algebraMap F.S R c) + (y - algebraMap F.S R c') by ring]
    exact add_mem hxc hyc'
  | smul t x _ hx =>
    obtain ⟨c, hc, hxc⟩ := hx
    refine ⟨retr F t * c, Ideal.mul_mem_left _ _ hc, ?_⟩
    rw [smul_eq_mul, map_mul, show t * x - algebraMap F.S R (retr F t) * algebraMap F.S R c =
      t * (x - algebraMap F.S R c) + (t - algebraMap F.S R (retr F t)) *
        algebraMap F.S R c by ring]
    refine add_mem (Ideal.mul_mem_left _ _ hxc) (Ideal.mul_mem_mul (sub_retr_mem F t) ?_)
    have : algebraMap F.S R c ∈ Ideal.map (algebraMap F.S R) (maximalIdeal F.S) ^ d := by
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hc
    exact Ideal.pow_right_mono (map_maximalIdeal_le_aux F) d this

/-- `G ∈ S[Z]` has *level* `d`: its coefficient of `Z^B` lies in `N^{d - |B|}`. -/
private def IsLevel (F : RegularFrame R) (d : ℕ) (G : MvPolynomial (Fin F.r) F.S) : Prop :=
  ∀ B, G.coeff B ∈ maximalIdeal F.S ^ (d - B.degree)

private theorem isLevel_zero (F : RegularFrame R) (d : ℕ) : IsLevel F d 0 := fun B => by
  simp

private theorem isLevel_add {F : RegularFrame R} {d : ℕ} {G G' : MvPolynomial (Fin F.r) F.S}
    (hG : IsLevel F d G) (hG' : IsLevel F d G') : IsLevel F d (G + G') := fun B => by
  have h : (G + G').coeff B = G.coeff B + G'.coeff B := by simp
  rw [h]
  exact add_mem (hG B) (hG' B)

private theorem isLevel_sum {F : RegularFrame R} {d : ℕ} {ι : Type*} (t : Finset ι)
    (G : ι → MvPolynomial (Fin F.r) F.S) (hG : ∀ i ∈ t, IsLevel F d (G i)) :
    IsLevel F d (∑ i ∈ t, G i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simpa using isLevel_zero F d
  | insert j t hj ih =>
    rw [Finset.sum_insert hj]
    exact isLevel_add (hG j (Finset.mem_insert_self j t))
      (ih fun i hi => hG i (Finset.mem_insert_of_mem hi))

private theorem isLevel_C (F : RegularFrame R) {d : ℕ} {c : F.S} (hc : c ∈ maximalIdeal F.S ^ d) :
    IsLevel F d (MvPolynomial.C c) := fun B => by
  rw [MvPolynomial.coeff_C]
  split_ifs with h
  · subst h
    simpa using hc
  · exact zero_mem _

private theorem isLevel_X_mul {F : RegularFrame R} {d : ℕ} {G : MvPolynomial (Fin F.r) F.S}
    (hG : IsLevel F (d - 1) G) (i : Fin F.r) : IsLevel F d (MvPolynomial.X i * G) := fun B => by
  classical
  rw [MvPolynomial.coeff_X_mul']
  split_ifs with hi
  · have hle : Finsupp.single i 1 ≤ B :=
      Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi))
    have hdeg := congrArg Finsupp.degree (tsub_add_cancel_of_le hle)
    rw [map_add, Finsupp.degree_single] at hdeg
    refine Ideal.pow_le_pow_right ?_ (hG (B - Finsupp.single i 1))
    omega
  · exact zero_mem _

/-- The expansion is compatible with the `M`-adic filtration: every `x ∈ Mᵈ` is `G(z)` modulo
`Pⁿ` for some `G ∈ S[Z]` of level `d`. -/
private theorem exists_isLevel (F : RegularFrame R) (n : ℕ) : ∀ (d : ℕ) (x : R),
    x ∈ maximalIdeal R ^ d → ∃ G, IsLevel F d G ∧ x - evZ F G ∈ F.idealZ ^ n := by
  classical
  induction n with
  | zero => exact fun d x _ => ⟨0, isLevel_zero F d, by simp⟩
  | succ n ih =>
    intro d x hx
    -- the elements of `P Mᵈ⁻¹`
    have hPM : ∀ y ∈ F.idealZ * maximalIdeal R ^ (d - 1),
        ∃ G, IsLevel F d G ∧ y - evZ F G ∈ F.idealZ ^ (n + 1) := by
      intro y hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro m hm n' hn'
        obtain ⟨a, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hm
        choose G hG hGx using fun i => ih (d - 1) (a i * n') (Ideal.mul_mem_left _ _ hn')
        refine ⟨∑ i, MvPolynomial.X i * G i, isLevel_sum _ _ fun i _ => isLevel_X_mul (hG i) i, ?_⟩
        have : (∑ i, a i * F.z i) * n' - evZ F (∑ i, MvPolynomial.X i * G i) =
            ∑ i, F.z i * (a i * n' - evZ F (G i)) := by
          rw [map_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul, evZ, MvPolynomial.aeval_X, ← evZ]
          ring
        rw [this, pow_succ']
        exact sum_mem fun i _ => Ideal.mul_mem_mul (Ideal.subset_span ⟨i, rfl⟩) (hGx i)
      · intro y y' hy hy'
        obtain ⟨G, hG, hGy⟩ := hy
        obtain ⟨G', hG', hGy'⟩ := hy'
        refine ⟨G + G', isLevel_add hG hG', ?_⟩
        rw [map_add, show y + y' - (evZ F G + evZ F G') = (y - evZ F G) + (y' - evZ F G') by
          ring]
        exact add_mem hGy hGy'
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp (maximalIdeal_pow_le F d hx)
    obtain ⟨c, hc, hac⟩ := exists_sub_mem_of_mem_map F d ha
    have hy : a - algebraMap F.S R c + b ∈ F.idealZ * maximalIdeal R ^ (d - 1) :=
      add_mem (Ideal.mul_mono_right (Ideal.pow_le_pow_right (Nat.sub_le d 1)) hac) hb
    obtain ⟨G, hG, hGy⟩ := hPM _ hy
    refine ⟨MvPolynomial.C c + G, isLevel_add (isLevel_C F hc) hG, ?_⟩
    rw [map_add, evZ, MvPolynomial.aeval_C, ← evZ]
    convert hGy using 1
    rw [Algebra.algebraMap_eq_smul_one, ← Algebra.algebraMap_eq_smul_one]
    ring

end RegularFrame

section Transport


/-- `[a Xⁿ] = [b Xⁿ]` if `a - b ∈ Iⁿ⁺¹`. -/
theorem assocGraded_mk_eq_of_sub_mem {A : Type u} [CommRing A] (I : Ideal A) {n : ℕ}
    {a b : A}
    (ha : a ∈ I ^ n) (hb : b ∈ I ^ n) (hab : a - b ∈ I ^ (n + 1)) :
    AssocGraded.mk I n a ha = AssocGraded.mk I n b hb := by
  have hab' : a - b ∈ I ^ n := Ideal.pow_le_pow_right (Nat.le_succ n) hab
  rw [assocGraded_mk_congr I rfl (sub_add_cancel a b).symm ha (add_mem hab' hb),
    AssocGraded.mk_add I n _ _ hab' hb, (AssocGraded.mk_eq_zero_iff I hab').mpr hab, zero_add]

variable {n : ℕ} (y : Fin n → R) (hy : ∀ i, y i ∈ maximalIdeal R ^ 1)

include hy in
/-- `(R/M)[X] → gr_M(R)`, `X_i ↦ [y_i]`, maps forms of degree `d` into `grᵈ`. -/
theorem aeval_mem_homogeneous (d : ℕ) (p : MvPolynomial (Fin n) (R ⧸ maximalIdeal R))
    (hp : p ∈ homogeneousSubmodule (Fin n) (R ⧸ maximalIdeal R) d) :
    aeval (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i)) p ∈
      AssocGraded.homogeneous (maximalIdeal R) d := by
  obtain ⟨q, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective p
  have hq : (homogeneousComponent d q).map (Ideal.Quotient.mk (maximalIdeal R)) =
      q.map (Ideal.Quotient.mk (maximalIdeal R)) := by
    rw [← homogeneousComponent_eq_self hp]
    ext m
    simp only [coeff_map, coeff_homogeneousComponent]
    split_ifs <;> simp
  rw [← hq, aeval_mk_map_of_isHomogeneous (maximalIdeal R) y hy
    (homogeneousComponent_isHomogeneous d q)]
  exact AssocGraded.mk_mem_homogeneous _ _

include hy in
/-- Taking homogeneous components commutes with `(R/M)[X] → gr_M(R)`. -/
theorem ofGrPiece_grProj_aeval (d : ℕ) (p : MvPolynomial (Fin n) (R ⧸ maximalIdeal R)) :
    AssocGraded.ofGrPiece (maximalIdeal R) d (grProj (maximalIdeal R) d
      (aeval (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i)) p)) =
      aeval (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i))
        (homogeneousComponent d p) := by
  conv_lhs => rw [← sum_homogeneousComponent p]
  rw [map_sum, map_sum, map_sum, Finset.sum_eq_single d]
  · exact ofGrPiece_grProj_of_mem_aux _
      (aeval_mem_homogeneous y hy d _ (homogeneousComponent_mem d p))
  · intro d' _ hd'
    rw [grProj_of_mem_ne_aux _ hd' (aeval_mem_homogeneous y hy d' _
      (homogeneousComponent_mem d' p)), map_zero]
  · intro hd
    rw [homogeneousComponent_eq_zero d p (by
      simp only [Finset.mem_range, not_lt] at hd; omega), map_zero, map_zero, map_zero]

include hy in
/-- Conversely (for an injective map), forms of degree `d` are the preimages of `grᵈ`. -/
theorem mem_homogeneous_of_aeval_mem
    (hinj : Function.Injective (aeval (R := R ⧸ maximalIdeal R)
      (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i))))
    (d : ℕ) (p : MvPolynomial (Fin n) (R ⧸ maximalIdeal R))
    (hp : aeval (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i)) p ∈
      AssocGraded.homogeneous (maximalIdeal R) d) :
    p ∈ homogeneousSubmodule (Fin n) (R ⧸ maximalIdeal R) d := by
  have hzero : ∀ d', d' ≠ d → homogeneousComponent d' p = 0 := by
    intro d' hd'
    apply hinj
    rw [← ofGrPiece_grProj_aeval y hy, grProj_of_mem_ne_aux _ (Ne.symm hd') hp, map_zero,
      map_zero]
  have hpd : p = homogeneousComponent d p := by
    conv_lhs => rw [← sum_homogeneousComponent p]
    rw [Finset.sum_eq_single d (fun d' _ hd' => hzero d' hd')]
    intro hd
    rw [homogeneousComponent_eq_zero d p (by
      simp only [Finset.mem_range, not_lt] at hd; omega)]
  rw [hpd]
  exact homogeneousComponent_mem d p

omit [IsRegularLocalRing R] in
/-- The monomials of `Z^B · H(W)` have `Z`-part `B`. -/
theorem zPart_of_mem_support_mul {r s : ℕ} (B : Fin r →₀ ℕ) (H : MvPolynomial (Fin s) R)
    {m : Fin (r + s) →₀ ℕ}
    (hm : m ∈ (rename (Fin.castAdd s) (monomial B 1) * rename (Fin.natAdd r) H).support) :
    zPart m = ⇑B ∧ H ≠ 0 := by
  classical
  rw [rename_monomial, mem_support_iff, coeff_monomial_mul'] at hm
  split_ifs at hm with hle
  · rw [one_mul] at hm
    refine ⟨funext fun i => ?_, fun h0 => hm (by rw [h0, map_zero]; simp)⟩
    have h0 : (m - B.mapDomain (Fin.castAdd s)) (Fin.castAdd s i) = 0 := by
      by_contra h
      have hv : Fin.castAdd s i ∈ (rename (Fin.natAdd r) H).vars :=
        (mem_vars_iff_mem_support _).mpr ⟨_, mem_support_iff.mpr hm,
          Finsupp.mem_support_iff.mpr h⟩
      obtain ⟨j, -, hj⟩ := Finset.mem_image.mp (vars_rename _ _ hv)
      have := congrArg Fin.val hj
      simp at this
      omega
    have hB : B.mapDomain (Fin.castAdd s) (Fin.castAdd s i) = B i :=
      Finsupp.mapDomain_apply_of_injective (Fin.castAdd_injective r s) B i
    have hle' := hle (Fin.castAdd s i)
    rw [Finsupp.tsub_apply, hB] at h0
    rw [hB] at hle'
    simp only [zPart]
    omega
  · exact absurd rfl hm

end Transport

namespace RegularFrame


/-- The transport of initial forms to `k[Z, W]`: a regular system of parameters
`(z₁, …, z_r, w₁, …, w_s)` of `R` with `w_j ∈ S` generating the maximal ideal of `S` gives a graded
isomorphism `Θ : k[Z₁, …, Z_r, W₁, …, W_s] ≅ gr_M(R)` with `Θ(Z_i) = Z_i` and `Θ(W_j) = [w_j]`, and
for `g` with `ν_M(g) = ν` every monomial of `Θ⁻¹(in(g)) = Σ_{|B| ≤ ν} Z^B c̄_B(W)` has `Z`-part
some `B` with `|B| ≤ ν` and non-zero expansion coefficient `c_B(g)`. -/
theorem exists_transport_of_rsop (F : RegularFrame R) {s : ℕ} (w : Fin s → F.S)
    (hwN : ∀ j, w j ∈ maximalIdeal F.S) (hNle : maximalIdeal F.S ≤ Ideal.span (Set.range w))
    (hspan : Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) = maximalIdeal R)
    (hdim : ((F.r + s : ℕ) : WithBot ℕ∞) = ringKrullDim R) :
    ∃ (Θ : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R)),
    (∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)),
      p ∈ homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) d ↔
        Θ p ∈ AssocGraded.homogeneous (maximalIdeal R) d) ∧
    (∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)),
      AssocGraded.ofGrPiece (maximalIdeal R) d (grProj (maximalIdeal R) d (Θ p)) =
        Θ (homogeneousComponent d p)) ∧
    (∀ i, Θ (X (Fin.castAdd s i)) = frameForm F.z i) ∧
    (∀ (g : R) (ν : ℕ), Ideal.ordElem (maximalIdeal R) g = ν →
      ∀ m ∈ (Θ.symm (initialForm (maximalIdeal R) g)).support,
        ∃ B : Fin F.r →₀ ℕ, B.degree ≤ ν ∧ expCoeff F g B ≠ 0 ∧ zPart m = ⇑B) ∧
    (∀ i, Ideal.ordElem (maximalIdeal R) (F.z i) = (1 : ℕ)) ∧
    (∀ j, Θ (X (Fin.natAdd F.r j)) = AssocGraded.mk (maximalIdeal R) 1
      (algebraMap F.S R (w j)) (by
        rw [pow_one]; exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hwN j))) := by
  classical
  set y : Fin (F.r + s) → R := Fin.append F.z (algebraMap F.S R ∘ w) with hydef
  have hy : ∀ i, y i ∈ maximalIdeal R ^ 1 := fun i => by
    rw [pow_one, ← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hbij := assocGraded_maximalIdeal_aeval_bijective hspan hdim hy
  set Θ := AlgEquiv.ofBijective _ hbij with hΘdef
  have hΘ : ∀ p, Θ p = aeval (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i)) p :=
    fun _ => rfl
  -- `Θ(Z_i) = [z_i]` is the initial form of `z_i`
  have hyi : ∀ i, y (Fin.castAdd s i) = F.z i := fun i => Fin.append_left _ _ i
  have hord : ∀ i, Ideal.ordElem (maximalIdeal R) (F.z i) = (1 : ℕ) := by
    intro i
    have hne : AssocGraded.mk (maximalIdeal R) 1 (y (Fin.castAdd s i)) (hy _) ≠ 0 := by
      rw [← aeval_X (R := R ⧸ maximalIdeal R)
        (fun i => AssocGraded.mk (maximalIdeal R) 1 (y i) (hy i)) (Fin.castAdd s i), ← hΘ]
      exact fun h => X_ne_zero _ (Θ.injective (by rw [h, map_zero]))
    have hz1 : F.z i ∈ maximalIdeal R ^ 1 := hyi i ▸ hy _
    refine le_antisymm (Ideal.ordElem_le_of_notMem fun h => hne ?_) (Ideal.le_ordElem hz1)
    rw [AssocGraded.mk_eq_zero_iff, hyi]
    exact h
  have hΘX : ∀ j, Θ (X (Fin.natAdd F.r j)) = AssocGraded.mk (maximalIdeal R) 1
      (algebraMap F.S R (w j)) (by
        rw [pow_one]; exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hwN j)) := by
    intro j
    rw [hΘ, aeval_X]
    exact assocGraded_mk_congr _ rfl (Fin.append_right _ _ j) _ _
  refine ⟨Θ, fun d p => ⟨fun hp => ?_, fun hp => ?_⟩, fun d p => ?_, fun i => ?_, ?_, hord, hΘX⟩
  · rw [hΘ]
    exact aeval_mem_homogeneous y hy d p hp
  · exact mem_homogeneous_of_aeval_mem y hy hbij.1 d p hp
  · rw [hΘ, hΘ]
    exact ofGrPiece_grProj_aeval y hy d p
  · rw [hΘ, aeval_X, frameForm, initialForm_eq_mk _ (hord i)]
    exact assocGraded_mk_congr _ rfl (hyi i) _ _
  -- the expansion of `in(g)`
  intro g ν hν m hm
  have hg : g ∈ maximalIdeal R ^ ν := Ideal.mem_pow_of_ordElem hν
  obtain ⟨G, hGlev, hGg⟩ := exists_isLevel F (ν + 1) ν g hg
  have hQ : ∀ B : Fin F.r →₀ ℕ, ∃ Q : MvPolynomial (Fin s) F.S,
      Q.IsHomogeneous (ν - B.degree) ∧ eval w Q = G.coeff B ∧ (G.coeff B = 0 → Q = 0) := by
    intro B
    by_cases h0 : G.coeff B = 0
    · exact ⟨0, isHomogeneous_zero _ _ _, by rw [map_zero, h0], fun _ => rfl⟩
    · obtain ⟨Q, hQ, hQe⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous w _).mp
        (Ideal.pow_right_mono hNle _ (hGlev B))
      exact ⟨Q, hQ, hQe, fun h => absurd h h0⟩
  choose Q hQh hQe hQ0 using hQ
  set t := G.support.filter (fun B => B.degree ≤ ν) with htdef
  set K : MvPolynomial (Fin (F.r + s)) R := ∑ B ∈ t, rename (Fin.castAdd s) (monomial B 1) *
    rename (Fin.natAdd F.r) ((Q B).map (algebraMap F.S R)) with hKdef
  have hKh : K.IsHomogeneous ν := by
    refine IsHomogeneous.sum _ _ _ fun B hB => ?_
    have hBν := (Finset.mem_filter.mp hB).2
    have := ((isHomogeneous_monomial (d := B) (1 : R) rfl).rename_isHomogeneous
      (f := Fin.castAdd s)).mul
      (((hQh B).map (algebraMap F.S R)).rename_isHomogeneous (f := Fin.natAdd F.r))
    rwa [Nat.add_sub_cancel' hBν] at this
  have hKe : eval y K = ∑ B ∈ t, evZ F (monomial B (G.coeff B)) := by
    rw [hKdef, map_sum]
    refine Finset.sum_congr rfl fun B _ => ?_
    have h1 : y ∘ Fin.castAdd s = F.z := funext fun i => Fin.append_left _ _ i
    have h2 : y ∘ Fin.natAdd F.r = algebraMap F.S R ∘ w := funext fun j => Fin.append_right _ _ j
    rw [map_mul, eval_rename, eval_rename, evZ, aeval_monomial, eval_monomial, eval_map, h1, h2,
      ← eval₂_comp, hQe, one_mul, mul_comm]
  -- `in(g) = Θ(K̄)`
  have hdiff : eval y K - g ∈ maximalIdeal R ^ (ν + 1) := by
    have hsplit : evZ F G = eval y K + ∑ B ∈ G.support.filter (fun B => ¬ B.degree ≤ ν),
        evZ F (monomial B (G.coeff B)) := by
      conv_lhs => rw [G.as_sum]
      rw [map_sum, hKe, Finset.sum_filter_add_sum_filter_not]
    have h1 : eval y K - g = -(g - evZ F G) - ∑ B ∈ G.support.filter (fun B => ¬ B.degree ≤ ν),
        evZ F (monomial B (G.coeff B)) := by
      rw [hsplit]
      ring
    rw [h1]
    refine sub_mem (neg_mem (Ideal.pow_right_mono (idealZ_le_maximalIdeal F) _ hGg))
      (sum_mem fun B hB => ?_)
    have hB := (Finset.mem_filter.mp hB).2
    exact Ideal.pow_right_mono (idealZ_le_maximalIdeal F) _
      (Ideal.pow_le_pow_right (by omega) (evZ_monomial_mem F B _))
  have hΘK : Θ (K.map (Ideal.Quotient.mk (maximalIdeal R))) =
      initialForm (maximalIdeal R) g := by
    rw [hΘ, aeval_mk_map_of_isHomogeneous (maximalIdeal R) y hy hKh, initialForm_eq_mk _ hν]
    exact assocGraded_mk_eq_of_sub_mem _ _ _ hdiff
  rw [← hΘK, AlgEquiv.symm_apply_apply] at hm
  -- the monomials of `K̄`
  have hKbar : K.map (Ideal.Quotient.mk (maximalIdeal R)) = ∑ B ∈ t,
      rename (Fin.castAdd s) (monomial B 1) * rename (Fin.natAdd F.r)
        ((Q B).map ((Ideal.Quotient.mk (maximalIdeal R)).comp (algebraMap F.S R))) := by
    rw [hKdef, map_sum]
    refine Finset.sum_congr rfl fun B _ => ?_
    rw [map_mul, map_rename, map_rename, map_monomial, map_one, map_map]
  rw [hKbar] at hm
  obtain ⟨B, hBt, hmB⟩ := Finset.mem_biUnion.mp (support_sum hm)
  obtain ⟨hzB, hQB⟩ := zPart_of_mem_support_mul B _ hmB
  have hBν := (Finset.mem_filter.mp hBt).2
  refine ⟨B, hBν, ?_, hzB⟩
  rw [expCoeff_eq F hGg (by omega)]
  intro h0
  exact hQB (by rw [hQ0 B h0, map_zero])

/-- The transport of initial forms to `k[Z, W]` (`exists_transport_of_rsop`) for the regular system of
parameters `(z, w)` given by `exists_rsop_append`. -/
theorem exists_transport (F : RegularFrame R) : ∃ (s : ℕ)
    (Θ : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
      AssocGraded (maximalIdeal R)),
    (∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)),
      p ∈ homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) d ↔
        Θ p ∈ AssocGraded.homogeneous (maximalIdeal R) d) ∧
    (∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)),
      AssocGraded.ofGrPiece (maximalIdeal R) d (grProj (maximalIdeal R) d (Θ p)) =
        Θ (homogeneousComponent d p)) ∧
    (∀ i, Θ (X (Fin.castAdd s i)) = frameForm F.z i) ∧
    (∀ (g : R) (ν : ℕ), Ideal.ordElem (maximalIdeal R) g = ν →
      ∀ m ∈ (Θ.symm (initialForm (maximalIdeal R) g)).support,
        ∃ B : Fin F.r →₀ ℕ, B.degree ≤ ν ∧ expCoeff F g B ≠ 0 ∧ zPart m = ⇑B) ∧
    (∀ i, Ideal.ordElem (maximalIdeal R) (F.z i) = (1 : ℕ)) := by
  obtain ⟨s, w, hwN, hNle, hspan, hdim⟩ := exists_rsop_append F
  obtain ⟨Θ, h1, h2, h3, h4, h5, -⟩ := exists_transport_of_rsop F w hwN hNle hspan hdim
  exact ⟨s, Θ, h1, h2, h3, h4, h5⟩

end RegularFrame

section AdaptedCoordinates

open MvPolynomial

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- `(ā) · [x Xⁿ] = [a x Xⁿ]` in `gr_I(A)`. -/
private theorem smul_mk_frames {A : Type*} [CommRing A] (I : Ideal A) (n : ℕ) (r x : A)
    (hx : x ∈ I ^ n) :
    (Ideal.Quotient.mk I r) • AssocGraded.mk I n x hx =
      AssocGraded.mk I n (r * x) (Ideal.mul_mem_left _ r hx) := by
  rw [← Ideal.Quotient.algebraMap_eq, IsScalarTower.algebraMap_smul]
  exact (map_smul (AssocGraded.mkLinear I n) r ⟨x, hx⟩).symm

/-- Every element of `grⁿ_I(A)` is the class `[y Xⁿ]` of some `y ∈ Iⁿ`. -/
private theorem exists_mk_eq_frames {A : Type*} [CommRing A] (I : Ideal A) {n : ℕ}
    {x : AssocGraded I} (hx : x ∈ AssocGraded.homogeneous I n) :
    ∃ y : A, ∃ hy : y ∈ I ^ n, AssocGraded.mk I n y hy = x := by
  obtain ⟨q, rfl⟩ := LinearMap.mem_range.mp hx
  induction q using Submodule.Quotient.induction_on with
  | H y => exact ⟨y, y.2, rfl⟩

/-- A family of elements of `M` whose classes in `M/M²` are linearly independent over `k = R/M`
is independent in the sense of `RSOPIndep` (the argument of `rsopIndep_of_linearIndependent` of
`Hironaka/Compat/WeierstrassChoice.lean`, which is downstream of this file). -/
private theorem rsopIndep_of_linearIndependent_frames {ι : Type*} [Fintype ι] (v : ι → R)
    (hv : ∀ i, v i ∈ maximalIdeal R ^ 1)
    (hli : LinearIndependent (R ⧸ maximalIdeal R)
      (fun i => AssocGraded.mk (maximalIdeal R) 1 (v i) (hv i))) :
    RSOPIndep (Finset.univ : Finset ι) v := by
  classical
  intro z _
  refine ⟨by simpa using hv z, fun hmem => ?_⟩
  set g : ι → AssocGraded (maximalIdeal R) :=
    fun i => AssocGraded.mk (maximalIdeal R) 1 (v i) (hv i) with hg
  set L : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
    Submodule.span (R ⧸ maximalIdeal R) (g '' {j | j ≠ z}) with hL
  have key : ∀ b ∈ Ideal.span (v '' (((Finset.univ : Finset ι) : Set ι) \ {z})),
      ∃ h : b ∈ maximalIdeal R ^ 1, AssocGraded.mk (maximalIdeal R) 1 b h ∈ L := by
    intro b hb
    refine Submodule.span_induction (p := fun b _ => ∃ h : b ∈ maximalIdeal R ^ 1,
      AssocGraded.mk (maximalIdeal R) 1 b h ∈ L) ?_ ?_ ?_ ?_ hb
    · rintro _ ⟨j, hj, rfl⟩
      refine ⟨hv j, Submodule.subset_span ⟨j, ?_, rfl⟩⟩
      simpa using hj
    · refine ⟨zero_mem _, ?_⟩
      have : AssocGraded.mk (maximalIdeal R) 1 (0 : R) (zero_mem _) = 0 :=
        map_zero (AssocGraded.mkLinear (maximalIdeal R) 1)
      rw [this]
      exact zero_mem _
    · rintro a b - - ⟨ha, ha'⟩ ⟨hb, hb'⟩
      refine ⟨add_mem ha hb, ?_⟩
      rw [AssocGraded.mk_add (maximalIdeal R) 1 a b ha hb]
      exact add_mem ha' hb'
    · rintro s a - ⟨ha, ha'⟩
      refine ⟨Ideal.mul_mem_left _ s ha, ?_⟩
      have := smul_mk_frames (maximalIdeal R) 1 s a ha
      show AssocGraded.mk (maximalIdeal R) 1 (s * a) (Ideal.mul_mem_left _ s ha) ∈ L
      rw [← this]
      exact L.smul_mem _ ha'
  have h1 : v z ∈ Ideal.span (v '' (((Finset.univ : Finset ι) : Set ι) \ {z})) ⊔
      maximalIdeal R ^ 2 := hmem
  obtain ⟨b, hb, c, hc, hbc⟩ := Submodule.mem_sup.mp h1
  obtain ⟨hbM, hbL⟩ := key b hb
  have hvz : v z ∈ maximalIdeal R ^ 1 := hv z
  have hdiff : v z - b ∈ maximalIdeal R ^ (1 + 1) := by
    rw [← hbc]
    simpa using hc
  have heq := mk_eq_mk_of_sub_mem_pow_succ (maximalIdeal R) hvz hbM hdiff
  have : g z ∈ L := by
    show AssocGraded.mk (maximalIdeal R) 1 (v z) (hv z) ∈ L
    rw [heq]
    exact hbL
  exact hli.notMem_span_image (s := {j | j ≠ z}) (by simp) this

namespace RegularFrame

/-- The class in `gr¹_M(R)` of an element of `(z)R` lies in `⟨Z₁, …, Z_r⟩`: `[Σ aᵢ zᵢ] = Σ āᵢ Zᵢ`. -/
private theorem mk_mem_span_frameForm (F : RegularFrame R)
    (hord : ∀ i, Ideal.ordElem (maximalIdeal R) (F.z i) = ((1 : ℕ) : ℕ∞)) {d : R}
    (hd : d ∈ F.idealZ) :
    ∃ h : d ∈ maximalIdeal R ^ 1, AssocGraded.mk (maximalIdeal R) 1 d h ∈
      Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) := by
  have hd' : d ∈ Ideal.span (Set.range F.z) := hd
  clear hd
  induction hd' using Submodule.span_induction with
  | mem b hb =>
    obtain ⟨i, rfl⟩ := hb
    have h1 : F.z i ∈ maximalIdeal R ^ 1 := Ideal.mem_pow_of_ordElem (hord i)
    refine ⟨h1, ?_⟩
    have : frameForm F.z i = AssocGraded.mk (maximalIdeal R) 1 (F.z i) h1 := by
      rw [frameForm, initialForm_eq_mk _ (hord i)]
    rw [← this]
    exact Submodule.subset_span ⟨i, rfl⟩
  | zero =>
    refine ⟨zero_mem _, ?_⟩
    have : AssocGraded.mk (maximalIdeal R) 1 (0 : R) (zero_mem _) = 0 :=
      map_zero (AssocGraded.mkLinear (maximalIdeal R) 1)
    rw [this]
    exact zero_mem _
  | add a b _ _ ha hb =>
    obtain ⟨ha, ha'⟩ := ha
    obtain ⟨hb, hb'⟩ := hb
    refine ⟨add_mem ha hb, ?_⟩
    rw [AssocGraded.mk_add (maximalIdeal R) 1 a b ha hb]
    exact add_mem ha' hb'
  | smul s a _ ha =>
    obtain ⟨ha, ha'⟩ := ha
    refine ⟨Ideal.mul_mem_left _ s ha, ?_⟩
    have := smul_mk_frames (maximalIdeal R) 1 s a ha
    show AssocGraded.mk (maximalIdeal R) 1 (s * a) (Ideal.mul_mem_left _ s ha) ∈ _
    rw [← this]
    exact Submodule.smul_mem _ _ ha'

end RegularFrame


namespace RegularFrame

/-- A basis of `T*/⟨Z⟩` by classes of elements of `S`: if `T` is a `k`-submodule of `gr¹_M(R)`
containing `Z₁, …, Z_r`, there are elements `x₁, …, x_t` of the maximal ideal of `S` such that the
classes `Z₁, …, Z_r, X₁, …, X_t` of `z₁, …, z_r, x₁, …, x_t` form a basis of `T`.  (An element `u`
of `M` with class in `T` is replaced by `x = ρ(u) ∈ S`, `ρ` the retraction `R → S`: `u - x ∈ (z)R`,
so the class of `x` differs from that of `u` by an element of `⟨Z⟩`.) -/
private theorem exists_adapted_basis (F : RegularFrame R)
    (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)))
    (hT1 : T ≤ AssocGraded.homogeneous (maximalIdeal R) 1)
    (hTZ : Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) ≤ T) :
    ∃ (t : ℕ) (x : Fin t → F.S) (hx : ∀ j, algebraMap F.S R (x j) ∈ maximalIdeal R ^ 1),
      (∀ j, x j ∈ maximalIdeal F.S) ∧
      LinearIndependent (R ⧸ maximalIdeal R) (Fin.append (frameForm F.z)
        (fun j => AssocGraded.mk (maximalIdeal R) 1 (algebraMap F.S R (x j)) (hx j))) ∧
      T = Submodule.span (R ⧸ maximalIdeal R) (Set.range (Fin.append (frameForm F.z)
        (fun j => AssocGraded.mk (maximalIdeal R) 1 (algebraMap F.S R (x j)) (hx j)))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨s₁, Θ₀, -, -, hΘZ, -, hord⟩ := exists_transport F
  -- finite dimension of `T`, linear independence of `Z`
  have hfinH : Module.Finite (R ⧸ maximalIdeal R) (AssocGraded.homogeneous (maximalIdeal R) 1) := by
    refine Module.Finite.iff_fg.mpr ?_
    rw [AssocGraded.homogeneous, LinearMap.range_eq_map]
    exact Module.Finite.fg_top.map _
  have hfinT : FiniteDimensional (R ⧸ maximalIdeal R) T := Submodule.finiteDimensional_of_le hT1
  have hliZ : LinearIndependent (R ⧸ maximalIdeal R) (frameForm F.z) := by
    have h1 : LinearIndependent (R ⧸ maximalIdeal R)
        (fun i : Fin F.r => (X (Fin.castAdd s₁ i) :
          MvPolynomial (Fin (F.r + s₁)) (R ⧸ maximalIdeal R))) :=
      (MvPolynomial.linearIndependent_X _ _).comp _ (Fin.castAdd_injective _ _)
    have h2 := h1.map' Θ₀.toLinearMap (LinearMap.ker_eq_bot.mpr Θ₀.injective)
    convert h2 using 1
    funext i
    exact (hΘZ i).symm
  set L : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) :=
    Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) with hLdef
  have hfinL : Module.finrank (R ⧸ maximalIdeal R) L = F.r := by
    rw [hLdef, finrank_span_eq_card hliZ, Fintype.card_fin]
  -- a complement `C` of `L` in `T` (a submodule of `gr`)
  obtain ⟨C₀, hC₀⟩ := Submodule.exists_isCompl L
  set C : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)) := C₀ ⊓ T with hCdef
  have hCT : C ≤ T := inf_le_right
  have hsup : L ⊔ C = T := by
    rw [hCdef, ← sup_inf_assoc_of_le C₀ hTZ, hC₀.sup_eq_top, top_inf_eq]
  have hinf : L ⊓ C = ⊥ := by
    refine eq_bot_iff.mpr ?_
    calc L ⊓ C ≤ L ⊓ C₀ := inf_le_inf_left _ inf_le_left
      _ = ⊥ := hC₀.inf_eq_bot
      _ ≤ ⊥ := le_rfl
  have hfinC : FiniteDimensional (R ⧸ maximalIdeal R) C := Submodule.finiteDimensional_of_le hCT
  have hfinL0 : FiniteDimensional (R ⧸ maximalIdeal R) L := Submodule.finiteDimensional_of_le
    (hTZ.trans hT1)
  have hfinTC : Module.finrank (R ⧸ maximalIdeal R) T =
      F.r + Module.finrank (R ⧸ maximalIdeal R) C := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq L C
    rw [hsup, hinf, finrank_bot, add_zero, hfinL] at h
    exact h
  set t := Module.finrank (R ⧸ maximalIdeal R) C with htdef
  let bC := Module.finBasis (R ⧸ maximalIdeal R) C
  -- the classes `c l` of the basis, lifted to `M` and retracted to `S`
  have hcT : ∀ l : Fin t, ((bC l : C) : AssocGraded (maximalIdeal R)) ∈ T := fun l => hCT (bC l).2
  have hlift : ∀ l : Fin t, ∃ u : R, ∃ hu : u ∈ maximalIdeal R ^ 1,
      AssocGraded.mk (maximalIdeal R) 1 u hu = ((bC l : C) : AssocGraded (maximalIdeal R)) :=
    fun l => exists_mk_eq_frames _ (hT1 (hcT l))
  choose u hu hmk using hlift
  set x : Fin t → F.S := fun l => retr F (u l) with hxdef
  have hxN : ∀ l, x l ∈ maximalIdeal F.S := fun l =>
    retr_mem_maximalIdeal F (by simpa using hu l)
  have hxM : ∀ l, algebraMap F.S R (x l) ∈ maximalIdeal R ^ 1 := fun l => by
    rw [pow_one]; exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hxN l)
  -- `[x l] = c l + (an element of L)`
  have hxcl : ∀ l, ∃ e : AssocGraded (maximalIdeal R), e ∈ L ∧
      AssocGraded.mk (maximalIdeal R) 1 (algebraMap F.S R (x l)) (hxM l) =
        ((bC l : C) : AssocGraded (maximalIdeal R)) + e := by
    intro l
    have hsub : algebraMap F.S R (x l) - u l ∈ F.idealZ := by
      have := neg_mem (sub_retr_mem F (u l))
      simpa using this
    obtain ⟨he, heL⟩ := mk_mem_span_frameForm F hord hsub
    refine ⟨_, heL, ?_⟩
    rw [← hmk l]
    have hu1 := hu l
    have e1 : AssocGraded.mk (maximalIdeal R) 1 (algebraMap F.S R (x l)) (hxM l) =
        AssocGraded.mk (maximalIdeal R) 1 (u l + (algebraMap F.S R (x l) - u l))
          (add_mem hu1 he) := mk_congr_of_eq _ rfl (by ring) _ _
    rw [e1, AssocGraded.mk_add (maximalIdeal R) 1 (u l) _ hu1 he]
  choose e heL hxe using hxcl
  set fam : Fin (F.r + t) → AssocGraded (maximalIdeal R) :=
    Fin.append (frameForm F.z)
      (fun j => AssocGraded.mk (maximalIdeal R) 1 (algebraMap F.S R (x j)) (hxM j)) with hfam
  have hLfam : L ≤ Submodule.span (R ⧸ maximalIdeal R) (Set.range fam) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact Submodule.subset_span ⟨Fin.castAdd t i, by rw [hfam, Fin.append_left]⟩
  have hfamT : Submodule.span (R ⧸ maximalIdeal R) (Set.range fam) = T := by
    apply le_antisymm
    · refine Submodule.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      refine Fin.addCases (fun i => ?_) (fun l => ?_) i
      · rw [hfam, Fin.append_left]
        exact hTZ (Submodule.subset_span ⟨i, rfl⟩)
      · rw [hfam, Fin.append_right, hxe l]
        exact add_mem (hcT l) (hTZ (heL l))
    · intro v hv
      have hv' : v ∈ L ⊔ C := by rw [hsup]; exact hv
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hv'
      rw [← hab]
      refine add_mem (hLfam ha) ?_
      -- `b ∈ C` is a combination of the `c l`
      have hbsum : (⟨b, hb⟩ : C) = ∑ l, bC.repr ⟨b, hb⟩ l • bC l := (bC.sum_repr _).symm
      have hb' : b = ∑ l, bC.repr ⟨b, hb⟩ l • ((bC l : C) : AssocGraded (maximalIdeal R)) := by
        have := congrArg (fun y : C => (y : AssocGraded (maximalIdeal R))) hbsum
        simp only [Submodule.coe_sum, Submodule.coe_smul] at this
        exact this
      rw [hb']
      refine Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ ?_
      have hcl : ((bC l : C) : AssocGraded (maximalIdeal R)) =
          AssocGraded.mk (maximalIdeal R) 1 (algebraMap F.S R (x l)) (hxM l) - e l := by
        rw [hxe l]; ring
      rw [hcl]
      refine sub_mem (Submodule.subset_span ⟨Fin.natAdd F.r l, ?_⟩) (hLfam (heL l))
      rw [hfam, Fin.append_right]
  refine ⟨t, x, hxM, hxN, ?_, hfamT.symm⟩
  rw [linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin, Set.finrank, ← hfam, hfamT,
    hfinTC]

end RegularFrame


namespace RegularFrame

/-- If `(z, w)` generates `M` with `w ∈ S`, then `w` generates the maximal ideal of `S`
(apply the retraction `R → S`, which kills `z` and fixes `S`). -/
private theorem maximalIdeal_le_span_range_of_span_eq (F : RegularFrame R) {s : ℕ}
    (w : Fin s → F.S)
    (hspan : Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) = maximalIdeal R) :
    maximalIdeal F.S ≤ Ideal.span (Set.range w) := by
  intro n hn
  have h1 : algebraMap F.S R n ∈
      Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
    rw [hspan]
    exact (algebraMap_mem_maximalIdeal_iff_aux F n).mpr hn
  have h2 := Ideal.mem_map_of_mem (retr F) h1
  rw [retr_algebraMap, Ideal.map_span] at h2
  refine (Ideal.span_le.mpr ?_) h2
  rintro _ ⟨_, ⟨v, rfl⟩, rfl⟩
  refine Fin.addCases (fun i => ?_) (fun j => ?_) v
  · rw [Fin.append_left, retr_z]
    exact zero_mem _
  · rw [Fin.append_right]
    show retr F (algebraMap F.S R (w j)) ∈ _
    rw [retr_algebraMap]
    exact Ideal.subset_span ⟨j, rfl⟩

/-- **Adapted coordinates** (p. 252, first sentences of the proof of Lemma 19): "Let us choose a
system of elements `(x₁, …, x_t)` of `S` such that `(z₁, …, z_r, x₁, …, x_t)` can be extended to a
regular system of parameters of `R`, and that `T*` is generated by the initial forms `Z₁, …, Z_r,
X₁, …, X_t` of `z₁, …, z_r, x₁, …, x_t` in `gr_M(R)`.  Let `(y₁, …, y_s)` be a system of elements of
`S` such that `(z, x, y)` is a regular system of parameters of `R`."  Here `w = (x, y)` with
`x = (w₁, …, w_t)`, for a `k`-submodule `T` of `gr¹_M(R)` containing `Z₁, …, Z_r` (`T = T*`). -/
theorem exists_adapted_rsop (F : RegularFrame R)
    (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)))
    (hT1 : T ≤ AssocGraded.homogeneous (maximalIdeal R) 1)
    (hTZ : Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) ≤ T) :
    ∃ (t m : ℕ) (w : Fin (t + m) → F.S)
      (hw : ∀ j, algebraMap F.S R (w j) ∈ maximalIdeal R ^ 1),
      (∀ j, w j ∈ maximalIdeal F.S) ∧ maximalIdeal F.S ≤ Ideal.span (Set.range w) ∧
      Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) = maximalIdeal R ∧
      ((F.r + (t + m) : ℕ) : WithBot ℕ∞) = ringKrullDim R ∧
      T = Submodule.span (R ⧸ maximalIdeal R) (Set.range (Fin.append (frameForm F.z)
        (fun j : Fin t => AssocGraded.mk (maximalIdeal R) 1
          (algebraMap F.S R (w (Fin.castAdd m j))) (hw _)))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨t, x, hxM, hxN, hli, hT⟩ := exists_adapted_basis F T hT1 hTZ
  obtain ⟨s₁, Θ₀, -, -, -, -, hord⟩ := exists_transport F
  -- `(z, x)` is independent modulo `M²`, hence part of a regular system of parameters of `R`
  set z' : Fin (F.r + t) → R := Fin.append F.z (fun j => algebraMap F.S R (x j)) with hz'
  have hz'M : ∀ i, z' i ∈ maximalIdeal R ^ 1 := fun i => by
    induction i using Fin.addCases with
    | left j => rw [hz', Fin.append_left]; exact Ideal.mem_pow_of_ordElem (hord j)
    | right j => rw [hz', Fin.append_right]; exact hxM j
  have hfam : (fun i => AssocGraded.mk (maximalIdeal R) 1 (z' i) (hz'M i)) =
      Fin.append (frameForm F.z) (fun j => AssocGraded.mk (maximalIdeal R) 1
        (algebraMap F.S R (x j)) (hxM j)) := by
    funext i
    induction i using Fin.addCases with
    | left j =>
      rw [Fin.append_left, frameForm, initialForm_eq_mk _ (hord j)]
      exact mk_congr_of_eq _ rfl (by rw [hz', Fin.append_left]) _ _
    | right j =>
      rw [Fin.append_right]
      exact mk_congr_of_eq _ rfl (by rw [hz', Fin.append_right]) _ _
  have hind := rsopIndep_of_linearIndependent_frames z' hz'M (by rw [hfam]; exact hli)
  obtain ⟨hinj', hext⟩ := hind.injOn_and_extends
  have hz'inj : Function.Injective z' := fun a b h =>
    hinj' (Finset.mem_coe.mpr (Finset.mem_univ a)) (Finset.mem_coe.mpr (Finset.mem_univ b)) h
  obtain ⟨s₀, hts, hs₀⟩ := hext
  -- the remaining members of the regular system of parameters, retracted into `S`
  set Y := s₀ \ Finset.image z' Finset.univ with hYdef
  set W := Y.image (retr F) with hWdef
  let y : Fin W.card → F.S := fun j => (W.equivFin.symm j : F.S)
  have hs₀M : ∀ e ∈ s₀, e ∈ maximalIdeal R := fun e he => by
    rw [← hs₀.1]
    exact Ideal.subset_span he
  have hyW : ∀ j, y j ∈ W := fun j => (W.equivFin.symm j).2
  have hyN : ∀ j, y j ∈ maximalIdeal F.S := by
    intro j
    obtain ⟨e, he, hej⟩ := Finset.mem_image.mp (hyW j)
    rw [← hej]
    exact retr_mem_maximalIdeal F (hs₀M e (Finset.mem_sdiff.mp he).1)
  set w : Fin (t + W.card) → F.S := Fin.append x y with hwdef
  have hwN : ∀ j, w j ∈ maximalIdeal F.S := by
    intro j
    induction j using Fin.addCases with
    | left j => rw [hwdef, Fin.append_left]; exact hxN j
    | right j => rw [hwdef, Fin.append_right]; exact hyN j
  have hw : ∀ j, algebraMap F.S R (w j) ∈ maximalIdeal R ^ 1 := fun j => by
    rw [pow_one]
    exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hwN j)
  have hspan : Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
      maximalIdeal R := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨v, rfl⟩
      refine Fin.addCases (fun i => ?_) (fun j => ?_) v
      · rw [Fin.append_left]
        exact z_mem_maximalIdeal F i
      · rw [Fin.append_right]
        exact (algebraMap_mem_maximalIdeal_iff_aux F _).mpr (hwN j)
    · rw [← hs₀.1, Ideal.span_le]
      intro e he
      by_cases hez : e ∈ Finset.image z' Finset.univ
      · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hez
        induction i using Fin.addCases with
        | left j =>
          rw [hz', Fin.append_left]
          exact Ideal.subset_span ⟨Fin.castAdd _ j, by rw [Fin.append_left]⟩
        | right j =>
          rw [hz', Fin.append_right]
          exact Ideal.subset_span ⟨Fin.natAdd F.r (Fin.castAdd _ j), by
            rw [Fin.append_right]
            simp only [Function.comp_apply, hwdef, Fin.append_left]⟩
      · have heY : e ∈ Y := Finset.mem_sdiff.mpr ⟨he, hez⟩
        have heW : retr F e ∈ W := Finset.mem_image_of_mem _ heY
        have h1 : e - algebraMap F.S R (retr F e) ∈
            Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
          refine Ideal.span_mono ?_ (sub_retr_mem F e)
          rintro _ ⟨i, rfl⟩
          exact ⟨Fin.castAdd _ i, Fin.append_left _ _ i⟩
        have h2 : algebraMap F.S R (retr F e) ∈
            Ideal.span (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) := by
          refine Ideal.subset_span ⟨Fin.natAdd F.r (Fin.natAdd t (W.equivFin ⟨retr F e, heW⟩)), ?_⟩
          rw [Fin.append_right]
          simp only [Function.comp_apply, hwdef, Fin.append_right, y, Equiv.symm_apply_apply]
        have := add_mem h1 h2
        rwa [sub_add_cancel] at this
  have hNle := maximalIdeal_le_span_range_of_span_eq F w hspan
  -- the dimension count
  have hcardz' : (Finset.image z' Finset.univ).card = F.r + t := by
    rw [Finset.card_image_of_injective _ hz'inj, Finset.card_univ, Fintype.card_fin]
  have hY : Y.card = s₀.card - (F.r + t) := by rw [Finset.card_sdiff_of_subset hts, hcardz']
  have hWY : W.card ≤ Y.card := Finset.card_image_le
  have hle1 : F.r + t ≤ s₀.card := by
    have := Finset.card_le_card hts
    omega
  have hle2 : s₀.card ≤ F.r + (t + W.card) := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hs₀.2] at h1
    have h2 : (maximalIdeal R).spanFinrank = s₀.card := by exact_mod_cast h1
    have h3 := Submodule.spanFinrank_span_le_ncard_of_finite (R := R)
      (Set.finite_range (Fin.append F.z (algebraMap F.S R ∘ w)))
    have h4 : (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))).ncard ≤ F.r + (t + W.card) := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
    have h5 : Submodule.span R (Set.range (Fin.append F.z (algebraMap F.S R ∘ w))) =
        maximalIdeal R := hspan
    rw [h5, h2] at h3
    omega
  refine ⟨t, W.card, w, hw, hwN, hNle, hspan, ?_, ?_⟩
  · rw [← hs₀.2]
    congr 2
    omega
  · have hcongr : (fun j : Fin t => AssocGraded.mk (maximalIdeal R) 1
        (algebraMap F.S R (w (Fin.castAdd W.card j))) (hw _)) = fun j => AssocGraded.mk
          (maximalIdeal R) 1 (algebraMap F.S R (x j)) (hxM j) := by
      funext j
      exact mk_congr_of_eq _ rfl (by rw [hwdef, Fin.append_left]) _ _
    rw [hcongr]
    exact hT

end RegularFrame


/-- The variables `Z₁, …, Z_r, X₁, …, X_t` among the variables `Z₁, …, Z_r, X₁, …, X_t, Y₁, …, Y_m`
of `K[Z, X, Y]` (the first `r + t` ones). -/
def zxVars (K : Type*) [CommRing K] (r t m : ℕ) : Set (MvPolynomial (Fin (r + (t + m))) K) :=
  {p | ∃ v : Fin (r + (t + m)), (v : ℕ) < r + t ∧ p = MvPolynomial.X v}

namespace RegularFrame

/-- **The transport to adapted coordinates** (p. 252): for a regular system of parameters
`(z, x, y)` of `R` with `x, y ∈ S` as in `exists_adapted_rsop`, the graded isomorphism
`Θ : k[Z, X, Y] ≅ gr_M(R)` of `exists_transport_of_rsop`, for which `Θ⁻¹(T*) = ⟨Z₁, …, Z_r,
X₁, …, X_t⟩`, i.e. `k[T*]` is the subalgebra `k[Z, X]`. -/
theorem exists_adapted_transport (F : RegularFrame R)
    (T : Submodule (R ⧸ maximalIdeal R) (AssocGraded (maximalIdeal R)))
    (hT1 : T ≤ AssocGraded.homogeneous (maximalIdeal R) 1)
    (hTZ : Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) ≤ T) :
    ∃ (t m : ℕ)
      (Θ : MvPolynomial (Fin (F.r + (t + m))) (R ⧸ maximalIdeal R) ≃ₐ[R ⧸ maximalIdeal R]
        AssocGraded (maximalIdeal R)),
    (∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + (t + m))) (R ⧸ maximalIdeal R)),
      p ∈ homogeneousSubmodule (Fin (F.r + (t + m))) (R ⧸ maximalIdeal R) d ↔
        Θ p ∈ AssocGraded.homogeneous (maximalIdeal R) d) ∧
    (∀ (d : ℕ) (p : MvPolynomial (Fin (F.r + (t + m))) (R ⧸ maximalIdeal R)),
      AssocGraded.ofGrPiece (maximalIdeal R) d (grProj (maximalIdeal R) d (Θ p)) =
        Θ (homogeneousComponent d p)) ∧
    (∀ i, Θ (X (Fin.castAdd (t + m) i)) = frameForm F.z i) ∧
    (∀ (g : R) (ν : ℕ), Ideal.ordElem (maximalIdeal R) g = ν →
      ∀ m' ∈ (Θ.symm (initialForm (maximalIdeal R) g)).support,
        ∃ B : Fin F.r →₀ ℕ, B.degree ≤ ν ∧ expCoeff F g B ≠ 0 ∧ zPart m' = ⇑B) ∧
    (∀ i, Ideal.ordElem (maximalIdeal R) (F.z i) = (1 : ℕ)) ∧
    T.comap Θ.toLinearMap = Submodule.span (R ⧸ maximalIdeal R)
      (zxVars (R ⧸ maximalIdeal R) F.r t m) := by
  classical
  obtain ⟨t, m, w, hw, hwN, hNle, hspan, hdim, hT⟩ := exists_adapted_rsop F T hT1 hTZ
  obtain ⟨Θ, h1, h2, h3, h4, h5, hΘX⟩ := exists_transport_of_rsop F w hwN hNle hspan hdim
  refine ⟨t, m, Θ, h1, h2, h3, h4, h5, ?_⟩
  -- `Θ` maps the variables `Z, X` onto the generators of `T`
  have himage : Θ '' zxVars (R ⧸ maximalIdeal R) F.r t m = Set.range (Fin.append (frameForm F.z)
      (fun j : Fin t => AssocGraded.mk (maximalIdeal R) 1
        (algebraMap F.S R (w (Fin.castAdd m j))) (hw _))) := by
    ext p
    constructor
    · rintro ⟨_, ⟨v, hv, rfl⟩, rfl⟩
      induction v using Fin.addCases with
      | left i => exact ⟨Fin.castAdd t i, by rw [Fin.append_left, ← h3 i]⟩
      | right j =>
        have hj : (j : ℕ) < t := by simpa using hv
        refine ⟨Fin.natAdd F.r ⟨j, hj⟩, ?_⟩
        rw [Fin.append_right, hΘX j]
        exact mk_congr_of_eq _ rfl (by congr 2) _ _
    · rintro ⟨i, rfl⟩
      induction i using Fin.addCases with
      | left i =>
        exact ⟨X (Fin.castAdd (t + m) i), ⟨Fin.castAdd (t + m) i, by simp; omega, rfl⟩, by
          rw [h3 i, Fin.append_left]⟩
      | right j =>
        refine ⟨X (Fin.natAdd F.r (Fin.castAdd m j)), ⟨Fin.natAdd F.r (Fin.castAdd m j), by simp,
          rfl⟩, ?_⟩
        rw [Fin.append_right, hΘX]
  have hmap : T = Submodule.map Θ.toLinearMap (Submodule.span (R ⧸ maximalIdeal R)
      (zxVars (R ⧸ maximalIdeal R) F.r t m)) := by
    rw [Submodule.map_span]
    have : (Θ.toLinearMap : _ → _) '' zxVars (R ⧸ maximalIdeal R) F.r t m =
        Θ '' zxVars (R ⧸ maximalIdeal R) F.r t m := rfl
    rw [this, himage]
    exact hT
  conv_lhs => rw [hmap]
  exact Submodule.comap_map_eq_of_injective Θ.injective _

end RegularFrame

end AdaptedCoordinates

section AdaptedCore

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable {K : Type u} [Field K] {r t m : ℕ}

/-- The projection of `K[Z, X, Y]` onto `K[Z, X]`: `Y_j ↦ 0`.  It is the split
`c̄_A = c̄'_A + c̄''_A` of the proof of Lemma 19 (p. 252): `φ' = π(φ)`, `φ'' = φ - π(φ)`. -/
private noncomputable def adaptedProj (K : Type u) [Field K] (r t m : ℕ) :
    MvPolynomial (Fin (r + (t + m))) K →ₐ[K] MvPolynomial (Fin (r + (t + m))) K :=
  aeval fun v => if (v : ℕ) < r + t then X v else 0

private theorem adaptedProj_X_of_lt (v : Fin (r + (t + m))) (hv : (v : ℕ) < r + t) :
    adaptedProj K r t m (X v) = X v := by
  simp [adaptedProj, hv]

private theorem adaptedProj_X_castAdd (i : Fin r) :
    adaptedProj K r t m (X (Fin.castAdd (t + m) i)) = X (Fin.castAdd (t + m) i) :=
  adaptedProj_X_of_lt _ (by have := i.2; simp; omega)

private theorem adaptedProj_fix_span {x : MvPolynomial (Fin (r + (t + m))) K}
    (hx : x ∈ Submodule.span K (zxVars K r t m)) : adaptedProj K r t m x = x := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨v, hv, rfl⟩ := hy
    exact adaptedProj_X_of_lt v hv
  | zero => exact map_zero _
  | add x' y' _ _ hx1 hy1 => rw [map_add, hx1, hy1]
  | smul c x' _ hx1 => rw [map_smul, hx1]

private theorem adaptedProj_fix {p : MvPolynomial (Fin (r + (t + m))) K}
    (hp : p ∈ Algebra.adjoin K ((Submodule.span K (zxVars K r t m) :
      Submodule K (MvPolynomial (Fin (r + (t + m))) K)) : Set (MvPolynomial (Fin (r + (t + m))) K))) :
    adaptedProj K r t m p = p := by
  induction hp using Algebra.adjoin_induction with
  | mem x hx => exact adaptedProj_fix_span hx
  | algebraMap c => exact AlgHom.commutes _ c
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]

private theorem adaptedProj_mem_adjoin (F : MvPolynomial (Fin (r + (t + m))) K) :
    adaptedProj K r t m F ∈ Algebra.adjoin K ((Submodule.span K (zxVars K r t m) :
      Submodule K (MvPolynomial (Fin (r + (t + m))) K)) :
        Set (MvPolynomial (Fin (r + (t + m))) K)) := by
  have h : (adaptedProj K r t m).range ≤ Algebra.adjoin K ((Submodule.span K (zxVars K r t m) :
      Submodule K (MvPolynomial (Fin (r + (t + m))) K)) :
        Set (MvPolynomial (Fin (r + (t + m))) K)) := by
    rw [adaptedProj, MvPolynomial.aeval_range]
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨v, rfl⟩
    by_cases hv : (v : ℕ) < r + t
    · simp only [hv, ite_true]
      exact Submodule.subset_span ⟨v, hv, rfl⟩
    · simp only [hv, ite_false]
      exact zero_mem _
  exact h ⟨F, rfl⟩

private theorem adaptedProj_isHomogeneous {F : MvPolynomial (Fin (r + (t + m))) K} {d : ℕ}
    (hF : F.IsHomogeneous d) : (adaptedProj K r t m F).IsHomogeneous d := by
  have := hF.aeval (fun v : Fin (r + (t + m)) =>
    if (v : ℕ) < r + t then (X v : MvPolynomial (Fin (r + (t + m))) K) else 0) (fun v => by
      split_ifs
      · exact isHomogeneous_X K v
      · exact isHomogeneous_zero _ _ _)
  rwa [one_mul] at this

/-- `π` of a monomial: the monomial itself if it does not involve a `Y`-variable, `0` otherwise. -/
private theorem adaptedProj_monomial (B : Fin (r + (t + m)) →₀ ℕ) (c : K) :
    adaptedProj K r t m (monomial B c) =
      if ∀ v : Fin (r + (t + m)), ¬ (v : ℕ) < r + t → B v = 0 then monomial B c else 0 := by
  classical
  rw [adaptedProj, aeval_monomial]
  split_ifs with hgood
  · rw [monomial_eq, ← MvPolynomial.algebraMap_eq]
    congr 1
    refine Finsupp.prod_congr fun v hv => ?_
    have hv' : (v : ℕ) < r + t := by
      by_contra h
      exact (Finsupp.mem_support_iff.mp hv) (hgood v h)
    simp [hv']
  · push Not at hgood
    obtain ⟨v, hv, hne⟩ := hgood
    rw [Finsupp.prod, Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hne) (by
      simp [hv, zero_pow hne]), mul_zero]

/-- `π` does not create monomials: `supp π(F) ⊆ supp F`. -/
private theorem adaptedProj_support_subset (F : MvPolynomial (Fin (r + (t + m))) K) :
    (adaptedProj K r t m F).support ⊆ F.support := by
  classical
  intro B hB
  have hF : adaptedProj K r t m F =
      ∑ B' ∈ F.support, adaptedProj K r t m (monomial B' (F.coeff B')) := by
    conv_lhs => rw [F.as_sum]
    rw [map_sum]
  rw [hF] at hB
  obtain ⟨B', hB', hBB'⟩ := Finset.mem_biUnion.mp (support_sum hB)
  rw [adaptedProj_monomial] at hBB'
  split_ifs at hBB' with hgood
  · rw [mem_support_iff, coeff_monomial] at hBB'
    by_cases hB'B : B' = B
    · rw [← hB'B]
      exact hB'
    · exact absurd (by simp [hB'B]) hBB'
  · simp at hBB'

/-- **The algebraic core in adapted coordinates** (p. 252): in `K[Z, X, Y]`, with `T = ⟨Z, X⟩` and
`π` the projection `Y_j ↦ 0` onto `K[Z, X]`. -/
theorem core_mem_adjoin_adapted (I₀ : Ideal (MvPolynomial (Fin r) K))
    (hI₀ : I₀.IsHomogeneous (homogeneousSubmodule (Fin r) K))
    (G : Ideal (MvPolynomial (Fin (r + (t + m))) K))
    (ν : ℕ) (φ : MvPolynomial (Fin (r + (t + m))) K) (hφ : φ.IsHomogeneous ν)
    (hφG : φ ∈ Ideal.span ((G : Set (MvPolynomial (Fin (r + (t + m))) K)) ∩
      (Algebra.adjoin K ((Submodule.span K (zxVars K r t m) :
        Submodule K (MvPolynomial (Fin (r + (t + m))) K)) :
          Set (MvPolynomial (Fin (r + (t + m))) K)) :
        Set (MvPolynomial (Fin (r + (t + m))) K))))
    (hG : ∀ d < ν, ∀ ψ ∈ G, homogeneousComponent d ψ ∈
      I₀.map (rename (R := K) (Fin.castAdd (t + m))))
    (hE : ∀ B ∈ φ.support, zPart B ∉ ESet I₀) :
    φ ∈ Algebra.adjoin K ((Submodule.span K (zxVars K r t m) :
      Submodule K (MvPolynomial (Fin (r + (t + m))) K)) :
        Set (MvPolynomial (Fin (r + (t + m))) K)) :=
  core_mem_adjoin_of_proj (Submodule.span K (zxVars K r t m)) (adaptedProj K r t m)
    adaptedProj_X_castAdd (fun _ hF => adaptedProj_fix hF) adaptedProj_mem_adjoin
    (fun hF => adaptedProj_isHomogeneous hF)
    (fun F {B} hB => ⟨B, adaptedProj_support_subset F hB, rfl⟩) I₀ hI₀ G ν φ hφ hφG hG hE

end AdaptedCore

section Lemma19Aux

/-- The initial form of an element is homogeneous. -/
theorem initialForm_mem_homogeneous_aux' {A : Type*} [CommRing A] (I : Ideal A) (f : A) :
    ∃ d, initialForm I f ∈ AssocGraded.homogeneous I d := by
  by_cases htop : Ideal.ordElem I f = ⊤
  · exact ⟨0, by rw [initialForm, dite_eq_left htop]; exact zero_mem _⟩
  · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
    exact ⟨n, by rw [initialForm_eq_mk I hn.symm]; exact AssocGraded.mk_mem_homogeneous I _⟩

/-- The homogeneous component of degree `μ ≤ ν` of `g F`, for a form `F` of degree `ν`. -/
private theorem homogeneousComponent_mul_form_aux' {σ E : Type*} [CommRing E]
    {F : MvPolynomial σ E} {ν : ℕ} (hF : F ∈ homogeneousSubmodule σ E ν)
    (g : MvPolynomial σ E) (μ : ℕ) (hμ : μ ≤ ν) :
    homogeneousComponent μ (g * F) = if μ = ν then C (g.coeff 0) * F else 0 := by
  classical
  conv_lhs => rw [← sum_homogeneousComponent g]
  rw [Finset.sum_mul, map_sum]
  have h : ∀ i, homogeneousComponent μ (homogeneousComponent i g * F) =
      if μ = i + ν then homogeneousComponent i g * F else 0 := fun i =>
    homogeneousComponent_of_mem ((homogeneousComponent_isHomogeneous i g).mul hF)
  simp_rw [h]
  split_ifs with hμν
  · subst hμν
    rw [Finset.sum_eq_single 0]
    · simp [homogeneousComponent_zero]
    · intro i _ hi
      rw [ite_eq_right (by omega)]
    · intro h0
      exact absurd (Finset.mem_range.mpr (Nat.succ_pos _)) h0
  · exact Finset.sum_eq_zero fun i _ => ite_eq_right (by omega)

/-- The homogeneous components of an element of `E[T]`, `T` a set of linear forms, lie in
`E[T]`. -/
private theorem homogeneousComponent_mem_adjoin_aux' {σ E : Type*} [CommRing E]
    {T : Set (MvPolynomial σ E)} (hT : T ⊆ homogeneousSubmodule σ E 1)
    {h : MvPolynomial σ E} (hh : h ∈ Algebra.adjoin E T) (μ : ℕ) :
    homogeneousComponent μ h ∈ Algebra.adjoin E T := by
  classical
  induction hh using Algebra.adjoin_induction generalizing μ with
  | mem x hx =>
    rw [homogeneousComponent_of_mem (hT hx)]
    split_ifs
    · exact Algebra.subset_adjoin hx
    · exact zero_mem _
  | algebraMap r =>
    rw [MvPolynomial.algebraMap_eq, homogeneousComponent_of_mem (isHomogeneous_C σ r)]
    split_ifs
    · exact Subalgebra.algebraMap_mem _ r
    · exact zero_mem _
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem (hx μ) (hy μ)
  | mul x y _ _ hx hy =>
    rw [← sum_homogeneousComponent x, ← sum_homogeneousComponent y, Finset.sum_mul_sum, map_sum]
    refine sum_mem fun i _ => ?_
    rw [map_sum]
    refine sum_mem fun j _ => ?_
    rw [homogeneousComponent_of_mem ((homogeneousComponent_isHomogeneous i x).mul
      (homogeneousComponent_isHomogeneous j y))]
    split_ifs
    · exact mul_mem (hx i) (hy j)
    · exact zero_mem _

/-- If a form `F` of degree `ν` lies in `((I ∩ E[L]))` for an ideal `I ⊆ (F)` and a module `L`
of linear forms, then `F ∈ E[L]` (take degree-`ν` components). -/
private theorem mem_adjoin_of_mem_span_inter_aux {σ E : Type*} [Field E]
    {F : MvPolynomial σ E} {ν : ℕ} (hF : F ∈ homogeneousSubmodule σ E ν)
    {L : Submodule E (MvPolynomial σ E)} (hL : L ≤ homogeneousSubmodule σ E 1)
    {I : Ideal (MvPolynomial σ E)} (hI : I ≤ Ideal.span {F})
    (hmem : F ∈ Ideal.span ((I : Set (MvPolynomial σ E)) ∩
      (Algebra.adjoin E (L : Set (MvPolynomial σ E)) : Set (MvPolynomial σ E)))) :
    F ∈ Algebra.adjoin E (L : Set (MvPolynomial σ E)) := by
  have key : ∀ x ∈ Ideal.span ((I : Set (MvPolynomial σ E)) ∩
      (Algebra.adjoin E (L : Set (MvPolynomial σ E)) : Set (MvPolynomial σ E))),
      x ∈ Ideal.span {F} ∧
        homogeneousComponent ν x ∈ Algebra.adjoin E (L : Set (MvPolynomial σ E)) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      exact ⟨hI hx.1, homogeneousComponent_mem_adjoin_aux' (fun y hy => hL hy) hx.2 ν⟩
    | zero => exact ⟨zero_mem _, by rw [map_zero]; exact zero_mem _⟩
    | add x y _ _ hx hy =>
      exact ⟨add_mem hx.1 hy.1, by rw [map_add]; exact add_mem hx.2 hy.2⟩
    | smul a x _ hx =>
      refine ⟨Ideal.mul_mem_left _ a hx.1, ?_⟩
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hx.1
      have h2 := hx.2
      rw [homogeneousComponent_mul_form_aux' hF g ν le_rfl, ite_eq_left rfl] at h2
      rw [smul_eq_mul, ← mul_assoc, homogeneousComponent_mul_form_aux' hF (a * g) ν le_rfl,
        ite_eq_left rfl, ← constantCoeff_eq, map_mul, constantCoeff_eq, constantCoeff_eq,
        map_mul, mul_assoc]
      exact mul_mem (by rw [← MvPolynomial.algebraMap_eq]; exact Subalgebra.algebraMap_mem _ _) h2
  have := (key F hmem).2
  rwa [homogeneousComponent_of_mem hF, ite_eq_left rfl] at this

/-- Transport of `((I ∩ k[T]))` along an algebra isomorphism. -/
theorem symm_mem_span_inter_aux {K A B : Type*} [CommRing K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] (Θ : A ≃ₐ[K] B) {I : Ideal B} {T : Submodule K B} {u : B}
    (hu : u ∈ Ideal.span ((I : Set B) ∩ (Algebra.adjoin K (T : Set B) : Set B))) :
    Θ.symm u ∈ Ideal.span ((Ideal.comap Θ I : Set A) ∩
      (Algebra.adjoin K (T.comap Θ.toLinearMap : Set A) : Set A)) := by
  induction hu using Submodule.span_induction with
  | mem v hv =>
    refine Ideal.subset_span ⟨by simpa using hv.1, ?_⟩
    have h1 : Θ.symm v ∈ (Algebra.adjoin K (T : Set B)).map Θ.symm.toAlgHom :=
      Subalgebra.mem_map.mpr ⟨v, hv.2, rfl⟩
    rw [AlgHom.map_adjoin] at h1
    refine Algebra.adjoin_mono ?_ h1
    rintro _ ⟨t, ht, rfl⟩
    show Θ (Θ.symm t) ∈ T
    rw [AlgEquiv.apply_symm_apply]
    exact ht
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hx

end Lemma19Aux

namespace RegularFrame


/-- `τ_{(z)}(f) = 0` forces the initial form of `f` into `k[Z]` (p. 251: "We have `φ_j ∈ k[Z]`
for all `j`"). -/
theorem initialForm_mem_adjoin_of_tauZ_eq_zero (F : RegularFrame R) (f : R)
    (h : tauZ R F.z (fun _ : Fin 1 => f) = 0) :
    initialForm (maximalIdeal R) f ∈
      Algebra.adjoin (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  obtain ⟨s, Θ, hΘh, -, hΘZ, -, -⟩ := exists_transport F
  have hspec := tauZSubmodule_spec R (fun _ : Fin 1 => f)
  -- `gr¹_M(R)` is finite-dimensional
  have hgr1 : AssocGraded.homogeneous (maximalIdeal R) 1 ≤
      (homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) 1).map Θ.toLinearMap := by
    intro u hu
    refine ⟨Θ.symm u, (hΘh 1 _).mpr (by rwa [AlgEquiv.apply_symm_apply]), ?_⟩
    exact AlgEquiv.apply_symm_apply Θ u
  have hfd : FiniteDimensional (R ⧸ maximalIdeal R)
      ((homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) 1).map Θ.toLinearMap) := by
    rw [homogeneousSubmodule_one_eq_span_X, Submodule.map_span]
    exact FiniteDimensional.span_of_finite _ ((Set.finite_range _).image _)
  have hZ1 : Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) ≤
      AssocGraded.homogeneous (maximalIdeal R) 1 := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨l, rfl⟩
    rw [← hΘZ]
    exact (hΘh 1 _).mp (isHomogeneous_X _ _)
  have hstar1 : tauZSubmoduleStar R F.z (fun _ : Fin 1 => f) ≤
      AssocGraded.homogeneous (maximalIdeal R) 1 := sup_le hspec.1 hZ1
  have : FiniteDimensional (R ⧸ maximalIdeal R) (tauZSubmoduleStar R F.z (fun _ : Fin 1 => f)) :=
    Submodule.finiteDimensional_of_le (hstar1.trans hgr1)
  -- `Z₁, …, Z_r` are linearly independent
  have hli : LinearIndependent (R ⧸ maximalIdeal R) (frameForm F.z) := by
    have : frameForm F.z = Θ.toLinearMap ∘ fun l => (X (Fin.castAdd s l) :
        MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)) := funext fun l => (hΘZ l).symm
    rw [this]
    exact ((MvPolynomial.linearIndependent_X _ _).comp _ (Fin.castAdd_injective _ _)).map' _
      (LinearMap.ker_eq_bot.mpr Θ.injective)
  have hZr : Module.finrank (R ⧸ maximalIdeal R)
      (Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z))) = F.r := by
    rw [finrank_span_eq_card hli, Fintype.card_fin]
  have hfr : Module.finrank (R ⧸ maximalIdeal R) (tauZSubmoduleStar R F.z (fun _ : Fin 1 => f)) ≤
      Module.finrank (R ⧸ maximalIdeal R)
        (Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z))) := by
    rw [hZr]
    unfold tauZ at h
    omega
  have heq := Submodule.eq_of_le_of_finrank_le le_sup_right hfr
  have hTZ : tauZSubmodule R (fun _ : Fin 1 => f) ≤
      Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) := by
    rw [heq]
    exact le_sup_left
  -- transport the principal-ideal statement to `k[Z, W]`
  obtain ⟨d, hd⟩ := initialForm_mem_homogeneous_aux' (maximalIdeal R) f
  have hF : Θ.symm (initialForm (maximalIdeal R) f) ∈
      homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) d :=
    (hΘh d _).mpr (by rwa [AlgEquiv.apply_symm_apply])
  have hmem : initialForm (maximalIdeal R) f ∈ Ideal.span
      (((Ideal.span (Set.range fun _ : Fin 1 => initialForm (maximalIdeal R) f) :
        Ideal (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R))) ∩
      (Algebra.adjoin (R ⧸ maximalIdeal R)
        (tauZSubmodule R (fun _ : Fin 1 => f) : Set (AssocGraded (maximalIdeal R))) :
          Set (AssocGraded (maximalIdeal R)))) := by
    rw [hspec.2]
    exact Ideal.subset_span ⟨0, rfl⟩
  have hL : (tauZSubmodule R (fun _ : Fin 1 => f)).comap Θ.toLinearMap ≤
      homogeneousSubmodule (Fin (F.r + s)) (R ⧸ maximalIdeal R) 1 :=
    fun t ht => (hΘh 1 t).mpr (hspec.1 ht)
  have hI : Ideal.comap Θ (Ideal.span (Set.range fun _ : Fin 1 => initialForm (maximalIdeal R) f))
      ≤ Ideal.span {Θ.symm (initialForm (maximalIdeal R) f)} := by
    intro x hx
    rw [Ideal.mem_comap, Set.range_const, Ideal.mem_span_singleton'] at hx
    obtain ⟨c, hc⟩ := hx
    rw [Ideal.mem_span_singleton']
    refine ⟨Θ.symm c, ?_⟩
    rw [← map_mul, hc, AlgEquiv.symm_apply_apply]
  have h1 := mem_adjoin_of_mem_span_inter_aux hF hL hI (symm_mem_span_inter_aux Θ hmem)
  -- back to `gr_M(R)`
  have h2 : Θ (Θ.symm (initialForm (maximalIdeal R) f)) ∈
      (Algebra.adjoin (R ⧸ maximalIdeal R) ((tauZSubmodule R (fun _ : Fin 1 => f)).comap
        Θ.toLinearMap : Set (MvPolynomial (Fin (F.r + s)) (R ⧸ maximalIdeal R)))).map
          Θ.toAlgHom := Subalgebra.mem_map.mpr ⟨_, h1, rfl⟩
  rw [AlgHom.map_adjoin, AlgEquiv.apply_symm_apply] at h2
  refine Algebra.adjoin_le ?_ h2
  rintro _ ⟨t, ht, rfl⟩
  have ht' : Θ t ∈ Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) := hTZ ht
  exact Algebra.span_le_adjoin _ _ ht'


attribute [local instance] MvPolynomial.gradedAlgebra

private theorem initialForm_mem_adjoin_of_isNormalizedBy_aux (F : RegularFrame R) (J : Ideal R)
    {i : ℕ} (f : Fin i → R) (_hfJ : ∀ j, f j ∈ J)
    (hτ : ∀ j : Fin i, tauZ R F.z (fun _ : Fin 1 => f j) = 0)
    (g : R) (hgJ : g ∈ J)
    (a : ℕ) (ha : 0 < a) (hmu : (mu R J a : ℕ∞) = nuI R J i.succPNat)
    (h1 : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R))
    (h2 : F.IsNormalizedBy f g)
    (x : Fin (tau R J a) → maximalIdeal R) (hx : IsRegularSystemOfTauParameters R J a x) :
    initialForm (maximalIdeal R) g ∈
      Algebra.adjoin (R ⧸ maximalIdeal R)
        ((tauParamsSubmoduleStar J a x F.z : Submodule (R ⧸ maximalIdeal R)
          (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R))) := by
  classical
  let _ : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  -- `T* ≤ gr¹_M(R)`: the classes of the `x_j` and the `Z_i` are linear forms
  obtain ⟨s₀, Θ₀, hΘ₀h, -, hΘ₀Z, -, -⟩ := exists_transport F
  have hTstar1 : tauParamsSubmoduleStar J a x F.z ≤
      AssocGraded.homogeneous (maximalIdeal R) 1 := by
    unfold tauParamsSubmoduleStar
    refine Submodule.span_le.mpr ?_
    rintro _ (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · exact AssocGraded.mk_mem_homogeneous _ _
    · rw [← hΘ₀Z]
      exact (hΘ₀h 1 _).mp (isHomogeneous_X _ _)
  have hTstarZ : Submodule.span (R ⧸ maximalIdeal R) (Set.range (frameForm F.z)) ≤
      tauParamsSubmoduleStar J a x F.z :=
    Submodule.span_le.mpr (by
      rintro _ ⟨l, rfl⟩
      exact Submodule.subset_span (Or.inr ⟨l, rfl⟩))
  -- the adapted coordinates `(z, x, y)` of the printed proof: `T* = ⟨Z, X⟩`, `gr = k[Z, X, Y]`
  obtain ⟨t₀, n₀, Θ, hΘh, -, hΘZ, hΘe, -, hΘT⟩ :=
    exists_adapted_transport F _ hTstar1 hTstarZ
  -- `ν_M(g) = ν^{(i+1)}(J) = μ^{(a)}(J)`
  obtain ⟨m, gs, him, hgs, hgsf⟩ := h1
  have hgsi : gs (Fin.castLE him (Fin.last i)) = g := by rw [hgsf, Fin.snoc_last]
  have hordg : Ideal.ordElem (maximalIdeal R) g = (mu R J a : ℕ) := by
    have h := ordElem_eq_nuI_of_isStandardBase_aux J gs hgs (Fin.castLE him (Fin.last i))
    rw [hgsi] at h
    rw [h, hmu]
    rfl
  have hgν : initialForm (maximalIdeal R) g ∈ AssocGraded.homogeneous (maximalIdeal R)
      (mu R J a) := by
    rw [initialForm_eq_mk _ hordg]
    exact AssocGraded.mk_mem_homogeneous _ _
  -- the initial forms `φ_j` lie in `k[Z]`: `φ_j = Θ(ψ_j(Z))`
  have hψ : ∀ j : Fin i, ∃ ψ, frameAlgHom F.z ψ = initialForm (maximalIdeal R) (f j) := by
    intro j
    have h := initialForm_mem_adjoin_of_tauZ_eq_zero F (f j) (hτ j)
    rw [Algebra.adjoin_range_eq_range_aeval] at h
    exact h
  choose ψ hψ using hψ
  have hΘrename : ∀ q, Θ (rename (Fin.castAdd (t₀ + n₀)) q) = frameAlgHom F.z q := by
    intro q
    have : Θ.toAlgHom.comp (rename (Fin.castAdd (t₀ + n₀))) = frameAlgHom F.z :=
      MvPolynomial.algHom_ext fun l => by
        rw [AlgHom.comp_apply, rename_X, frameAlgHom, aeval_X]
        exact hΘZ l
    exact AlgHom.congr_fun this q
  have hψI : ∀ j, ψ j ∈ frameInitialIdeal F.z f := fun j => Ideal.subset_span ⟨j, hψ j⟩
  -- `I = (φ₁, …, φ_i) k[Z]` is homogeneous
  have hI₀ : (frameInitialIdeal F.z f).IsHomogeneous
      (homogeneousSubmodule (Fin F.r) (R ⧸ maximalIdeal R)) := by
    apply Ideal.homogeneous_span
    rintro q ⟨j, hj⟩
    obtain ⟨d, hd⟩ := initialForm_mem_homogeneous_aux' (maximalIdeal R) (f j)
    refine ⟨d, ?_⟩
    have h1 : rename (Fin.castAdd (t₀ + n₀)) q ∈
        homogeneousSubmodule (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R) d :=
      (hΘh d _).mpr (by rw [hΘrename, hj]; exact hd)
    exact (IsHomogeneous.rename_isHomogeneous_iff (Fin.castAdd_injective _ _)).mp h1
  -- `φ = Θ⁻¹(in(g))`
  have hφh : (Θ.symm (initialForm (maximalIdeal R) g)).IsHomogeneous (mu R J a) :=
    (hΘh _ _).mpr (by rwa [AlgEquiv.apply_symm_apply])
  have hφG : Θ.symm (initialForm (maximalIdeal R) g) ∈ Ideal.span
      ((Ideal.comap Θ (grIdeal (maximalIdeal R) J) :
        Set (MvPolynomial (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R))) ∩
      (Algebra.adjoin (R ⧸ maximalIdeal R) ((tauParamsSubmoduleStar J a x F.z).comap
        Θ.toLinearMap : Set (MvPolynomial (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R))) :
          Set (MvPolynomial (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R)))) := by
    have hta := ((hx a ha le_rfl).2 (mu R J a) le_rfl _ hgν).mp
      (Ideal.subset_span ⟨g, hgJ, rfl⟩)
    refine Ideal.span_mono ?_ (symm_mem_span_inter_aux Θ hta)
    refine Set.inter_subset_inter_right _ (Algebra.adjoin_mono ?_)
    intro t ht
    refine Submodule.span_mono ?_ ht
    rintro _ ⟨l, rfl⟩
    exact Or.inl ⟨l.1, rfl⟩
  -- the homogeneous parts of degree `< ν` of `gr_M(J, R)` lie in `(φ₁, …, φ_i)`
  have hG : ∀ d < mu R J a, ∀ u ∈ Ideal.comap Θ (grIdeal (maximalIdeal R) J),
      homogeneousComponent d u ∈ (frameInitialIdeal F.z f).map (rename (Fin.castAdd (t₀ + n₀))) := by
    obtain ⟨-, ⟨dd, hdd, hmono⟩, hspan, hiii⟩ := hgs.2
    have hdi : dd (Fin.castLE him (Fin.last i)) = mu R J a := by
      have hne : initialForm (maximalIdeal R) g ≠ 0 := by
        rw [initialForm_eq_mk _ hordg]
        intro h0
        rw [AssocGraded.mk_eq_zero_iff] at h0
        have := Ideal.le_ordElem h0
        rw [hordg, Nat.cast_le] at this
        omega
      by_contra hne'
      apply hne
      have h1 : initialForm (maximalIdeal R) (gs (Fin.castLE him (Fin.last i))) ∈
          AssocGraded.homogeneous (maximalIdeal R) (dd (Fin.castLE him (Fin.last i))) := hdd _
      rw [hgsi] at h1
      rw [← ofGrPiece_grProj_of_mem_aux _ hgν, grProj_of_mem_ne_aux _ hne' h1, map_zero]
    set Φ : Fin m → MvPolynomial (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R) :=
      fun l => Θ.symm (initialForm (maximalIdeal R) (gs l)) with hΦdef
    have hΦh : ∀ l, Φ l ∈ homogeneousSubmodule (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R) (dd l) :=
      fun l => (hΘh _ _).mpr (by rw [hΦdef, AlgEquiv.apply_symm_apply]; exact hdd l)
    have hΦI : ∀ l : Fin m, (l : ℕ) < i →
        Φ l ∈ (frameInitialIdeal F.z f).map (rename (Fin.castAdd (t₀ + n₀))) := by
      intro l hl
      have hgl : gs l = f ⟨l, hl⟩ := by
        have h := hgsf (Fin.castSucc ⟨l, hl⟩)
        rw [Fin.snoc_castSucc] at h
        rw [← h]
        congr 1
      have : Φ l = rename (Fin.castAdd (t₀ + n₀)) (ψ ⟨l, hl⟩) := by
        rw [hΦdef]
        dsimp only
        rw [hgl, ← hψ, ← hΘrename, AlgEquiv.symm_apply_apply]
      rw [this]
      exact Ideal.mem_map_of_mem _ (hψI _)
    have hΦdeg : ∀ l : Fin m, i ≤ (l : ℕ) → mu R J a ≤ dd l := fun l hl =>
      hdi ▸ hmono (Fin.le_iff_val_le_val.mpr (by simpa using hl))
    have hclaim : ∀ u ∈ Ideal.span (Set.range Φ), ∀ d < mu R J a,
        homogeneousComponent d u ∈ (frameInitialIdeal F.z f).map (rename (Fin.castAdd (t₀ + n₀))) := by
      intro u hu
      induction hu using Submodule.span_induction with
      | mem u hu =>
        obtain ⟨l, rfl⟩ := hu
        intro d hd
        rw [homogeneousComponent_of_mem (hΦh l)]
        split_ifs with hdl
        · by_cases hl : (l : ℕ) < i
          · exact hΦI l hl
          · have := hΦdeg l (by omega)
            omega
        · exact zero_mem _
      | zero => intro d _; rw [map_zero]; exact zero_mem _
      | add u v _ _ hu hv =>
        intro d hd
        rw [map_add]
        exact add_mem (hu d hd) (hv d hd)
      | smul c u _ hu =>
        intro d hd
        rw [smul_eq_mul]
        refine homogeneousComponent_mul_mem _ _ d fun e e' hee' => ?_
        exact Ideal.mul_mem_left _ _ (hu e' (by omega))
    intro d hd u hu
    have hu' : u ∈ Ideal.span (Set.range Φ) := by
      have key : ∀ v ∈ Ideal.span (Set.range fun l => initialForm (maximalIdeal R) (gs l)),
          Θ.symm v ∈ Ideal.span (Set.range Φ) := by
        intro v hv
        induction hv using Submodule.span_induction with
        | mem v hv =>
          obtain ⟨l, rfl⟩ := hv
          exact Ideal.subset_span ⟨l, rfl⟩
        | zero => rw [map_zero]; exact zero_mem _
        | add v w _ _ hv hw => rw [map_add]; exact add_mem hv hw
        | smul c v _ hv => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hv
      have h := key (Θ u) (by rw [← hspan]; exact hu)
      rwa [AlgEquiv.symm_apply_apply] at h
    exact hclaim u hu' d hd
  -- no monomial of `φ` has its `Z`-part in `E` (normalization)
  have hE : ∀ B ∈ (Θ.symm (initialForm (maximalIdeal R) g)).support,
      zPart B ∉ ESet (frameInitialIdeal F.z f) := by
    intro B hB hBE
    obtain ⟨B', -, hB'0, hBB'⟩ := hΘe g _ hordg B hB
    rw [hBB'] at hBE
    have h := h2 (expansion F) (isExpansion_expansion F) ⇑B' hBE
    rw [psCoeff, Finsupp.equivFunOnFinite_symm_coe, coeff_expansion] at h
    exact hB'0 h
  -- the form `φ''` of the printed proof lies in `(φ₁, …, φ_i) gr_M(R)` and has no monomial whose
  -- `Z`-part is in `E`; Remark 2 then shows `φ'' = 0`
  rw [hΘT] at hφG
  have hcore : Θ.symm (initialForm (maximalIdeal R) g) ∈ Algebra.adjoin (R ⧸ maximalIdeal R)
      ((tauParamsSubmoduleStar J a x F.z).comap Θ.toLinearMap :
        Set (MvPolynomial (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R))) := by
    rw [hΘT]
    exact core_mem_adjoin_adapted _ hI₀ _ _ _ hφh hφG hG hE
  -- back to `gr_M(R)`
  have h3 : Θ (Θ.symm (initialForm (maximalIdeal R) g)) ∈
      (Algebra.adjoin (R ⧸ maximalIdeal R) ((tauParamsSubmoduleStar J a x F.z).comap
        Θ.toLinearMap : Set (MvPolynomial (Fin (F.r + (t₀ + n₀))) (R ⧸ maximalIdeal R)))).map
          Θ.toAlgHom := Subalgebra.mem_map.mpr ⟨_, hcore, rfl⟩
  rw [AlgHom.map_adjoin, AlgEquiv.apply_symm_apply] at h3
  refine Algebra.adjoin_mono ?_ h3
  rintro _ ⟨t, ht, rfl⟩
  exact ht

end RegularFrame

end Lemma19Proof

/-- Lemma 19, pp. 251–252: "Let `R` be a regular local ring, `(S; z₁, …, z_r)` a regular frame
of `R`, and `J` an ideal in `R`. Let `(f₁, …, f_i)` be a system of elements of `J` such that
`τ_{(z)}(f_j) = 0` for `1 ≤ j ≤ i`. Let `f` be an element of `J`. Let `a` be the positive
integer such that `μ^{(a)}(J) = ν^{(i+1)}(J)`. Suppose: (i) `(f₁, …, f_i, f)` can be extended
to a standard base of `J`, and (ii) `f` is normalized by `(f₁, …, f_i)` with respect to
`(S; z₁, …, z_r)`. Let `T*` be the `k`-submodule of `gr_M(R)` which is generated by the
initial forms of a regular system of `a`-th `τ`-parameters of `J` and those of
`(z) = (z₁, …, z_r)` in `gr_M(R)`. Then the initial form of `f` in `gr_M(R)` is contained in
the `k`-subalgebra `k[T*]` of `gr_M(R)`, where `k` = the residue field of `R`."

(Formalization notes: both hypotheses are quoted above:
"Let `(f₁, …, f_i)` be a system of elements of `J` such that `τ_{(z)}(f_j) = 0` for `1 ≤ j ≤ i`" and
"Let `a` be the positive integer such that `μ^{(a)}(J) = ν^{(i+1)}(J)`".  The first is transcribed
literally, as the vanishing of `τ_{(z)}` of each one-element system `(f_j)` (Definition 10*,
\cref{def:III.10-star}: `τ_{(z)}(f₁, …, f_i)` is defined for a system of elements); this is also the reading
used in the paper's own proof, which begins "We have `φ_j ∈ k[Z]` for all `j`".  The second is `hmu`
(`μ^{(a)}(J) = ν^{(i+1)}(J)` with `ν^{(i+1)}(J) = nuI R J i.succPNat`).  The paper's element `f` is called
`g` here.)

(The proof follows the printed one (p. 252): `exists_adapted_rsop` chooses the elements
`x₁, …, x_t, y₁, …, y_s` of `S` with `(z, x, y)` a regular system of parameters of `R` and `T*`
generated by `Z, X`; `exists_adapted_transport` gives `gr_M(R) = k[Z, X, Y]`; `φ_j ∈ k[Z]`
(`initialForm_mem_adjoin_of_tauZ_eq_zero`); `E_r` is the E-set of `(φ₁, …, φ_i) k[Z]`; `c_A = 0` for
`A ∈ E_r` by (ii); `ν_M(c_A) ≥ μ - |A|` and `φ = Σ c̄_A Z^A` for `|A| + ν_M(c_A) = μ`; the split
`c̄_A = c̄'_A + c̄''_A` is `φ = π(φ) + (φ - π(φ))` with `π` the projection `Y_j ↦ 0`
(`core_mem_adjoin_adapted`), `φ'' = φ - π(φ)` lies in `(φ₁, …, φ_i) gr_M(R)` "by the selection of
`(x₁, …, x_t)`", and by Remark 2 (`eSet_isBound_qInj_image`) a non-zero `φ''` would have
`Ā ∈ E_r`, which is impossible.  The steps that the paper does not argue are proved: the choice of
`x_j ∈ S` (`exists_adapted_basis`: replace an element of `M` with class in `T*` by its retraction
`ρ(u) ∈ S`, `u - ρ(u) ∈ (z)R`, which changes the class by an element of `⟨Z⟩`), `φ_j ∈ k[Z]`,
`ν_M(f) = ν^{(i+1)}(J)`, and the two facts hidden in "by the selection of `(x₁, …, x_t)`":
`φ ∈ (gr_M(J, R) ∩ k[T*]) gr_M(R)` (the property of `T_a`) and that the homogeneous components of
degree `< ν^{(i+1)}(J)` of `gr_M(J, R)` lie in `(φ₁, …, φ_i) gr_M(R)` (standard base).  The paper
writes "Let `μ = ν^{(j+1)}(J)`" at one point of the proof; `j` is not introduced there and is a
misprint for `i`.) -/
@[blueprint "lem:III.19"
  (statement := /-- Let $R$ be a regular local ring, $(S;z_1,\dots,z_r)$ a regular frame of
    $R$ (\cref{def:III.9}), and $J$ an ideal in $R$. Let $(f_1,\dots,f_i)$ be a system of
    elements of $J$ such that $\tau_{(z)}(f_j)=0$ for $1\le j\le i$
    (\cref{def:III.10-star}). Let $f$ be an element of $J$. Let $a$ be the positive integer
    such that $\mu^{(a)}(J)=\nu^{(i+1)}(J)$ (\cref{def:III.6-mu}, \cref{def:III.1}). Suppose:
    \begin{enumerate}
      \item[(i)] $(f_1,\dots,f_i,f)$ can be extended to a standard base of $J$
        (\cref{def:III.7-extends-standard-base}), and
      \item[(ii)] $f$ is normalized by $(f_1,\dots,f_i)$ with respect to $(S;z_1,\dots,z_r)$
        (\cref{def:III.9-normalized-by}).
    \end{enumerate}
    Let $T^*$ be the $k$-submodule of $\operatorname{gr}_M(R)$ which is generated by the
    initial forms of a regular system of $a$-th $\tau$-parameters of $J$ (\cref{def:III.7})
    and those of $(z)=(z_1,\dots,z_r)$ in $\operatorname{gr}_M(R)$. Then the initial form of
    $f$ in $\operatorname{gr}_M(R)$ is contained in the $k$-subalgebra $k[T^*]$ of
    $\operatorname{gr}_M(R)$, where $k$ is the residue field of $R$. (Lemma 19,
    pp.~251--252.) -/)
  (proof := /-- Let us choose a system of elements $(x_1,\dots,x_t)$ of $S$ such that
    $(z_1,\dots,z_r,x_1,\dots,x_t)$ can be extended to a regular system of parameters of $R$,
    and that $T^*$ is generated by the initial forms $Z_1,\dots,Z_r,X_1,\dots,X_t$ of
    $z_1,\dots,z_r,x_1,\dots,x_t$ in $\operatorname{gr}_M(R)$. Let $(y_1,\dots,y_s)$ be a
    system of elements of $S$ such that $(z_1,\dots,z_r,x_1,\dots,x_t,y_1,\dots,y_s)$ is a
    regular system of parameters of $R$. Let $Y_j$ be the initial form of $y_j$
    $(1\le j\le s)$ in $\operatorname{gr}_M(R)$. Then we have
    $\operatorname{gr}_M(R)=k[Z_1,\dots,Z_r,X_1,\dots,X_t,Y_1,\dots,Y_s]$. Let $\varphi_j$
    (resp.\ $\varphi$) be the initial form of $f_j$ (resp.\ $f$) in $\operatorname{gr}_M(R)$
    for $1\le j\le i$. We have $\varphi_j\in k[Z]$ for all $j$, $1\le j\le i$. Let $E_r$ be
    the $E$-set of $(\varphi_1,\dots,\varphi_i)k[Z]$ with respect to $(k;Z_1,\dots,Z_r)$. Let
    $f=\sum_{A\in\mathbb Z^r_0}c_Az^A$ with $c_A\in S$ be the power series expansion of $f$ in
    $S\{z_1,\dots,z_r\}$. Then, by (ii), $c_A=0$ for all $A\in E_r$. Let
    $\mu=\nu^{(j+1)}(J)$. We have $\nu_M(c_A)\ge\mu-|A|$ for all $A\in\mathbb Z^r_0$.
    Let $\bar c_A$ denote the initial form of $c_A$ in $\operatorname{gr}_M(R)$. Then we have
    $\varphi=\sum\bar c_AZ^A$ for $|A|+\nu_M(c_A)=\mu$.

    We want to show that the $\bar c_A$ with those $A$ are all forms in $X_1,\dots,X_t$. Let us
    write $\bar c_A=\bar c'_A+\bar c''_A$ where $\bar c'_A\in k[X_1,\dots,X_t]$ and
    $\bar c''_A\in(Y_1,\dots,Y_s)k[X,Y]$. Then, by the selection of $(x_1,\dots,x_t)$, we must
    have that the form $\varphi''=\sum\bar c''_AZ^A$ for $|A|+\nu_M(c_A)=\mu$ belongs to
    the ideal $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$. Let $E_{r+t+s}$ be the
    $E$-set of $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$ with respect to
    $(k;Z_1,\dots,Z_r,X_1,\dots,X_t,Y_1,\dots,Y_s)$. Let $q$ be the canonical injection of
    $\mathbb Z^r_0$ into $\mathbb Z^r_0\times\mathbb Z^{t+s}_0=\mathbb Z^{r+t+s}_0$, and
    $\Lambda_{r+t+s}$ the $E$-function of $k[Z,X,Y]$ with respect to
    $(k;Z_1,\dots,Z_r,X_1,\dots,X_t,Y_1,\dots,Y_s)$. If $\varphi''\ne0$, then we have
    $\Lambda_{r+t+s}(\varphi'')\in E_{r+t+s}$. It is clear from the above expression of
    $\varphi''$ that we have $\bar A$ such that $|\bar A|+\nu_M(c_{\bar A})=\mu$ and that
    $\Lambda_{r+t+s}(\varphi'')=q(\bar A)+B$ with $B\in(0)\times\mathbb Z^{t+s}_0$. However, by
    Remark 2 (\cref{rem:III.7-2}), $E_{r+t+s}$ is bounded by $q(E_r)$ and hence we should have
    $\bar A\in E_r$, which is impossible. We conclude that $\varphi''=0$ and
    $\bar c_A=\bar c'_A\in k[X]$ for all $A$ with $|A|+\nu_M(c_A)=\mu$. \qed

    (Formalization notes. The system $(x,y)$ is chosen in S, as printed: an element of $M$ whose
    class lies in $T^*$ is replaced by its image under the retraction $R\to S$, which changes its
    class by an element of $\langle Z\rangle$. The split $\bar c_A=\bar c'_A+\bar c''_A$ is
    $\varphi=\pi(\varphi)+(\varphi-\pi(\varphi))$ with $\pi$ the projection $Y_j\mapsto0$.
    That $\varphi''$ belongs to $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$ ``by the
    selection of $(x_1,\dots,x_t)$'' uses the defining property of the $a$-th $\tau$-parameters
    at degree $\mu^{(a)}(J)$ and the fact that the components of degree $<\mu$ of
    $\operatorname{gr}_M(J,R)$ lie in $(\varphi_1,\dots,\varphi_i)\operatorname{gr}_M(R)$, both
    proved. In the paper's ``$\mu=\nu^{(j+1)}(J)$'' the index $j$ is not introduced; it is read $\mu=\nu^{(i+1)}(J)$.) -/)
  (latexEnv := "lemma")]
theorem initialForm_mem_adjoin_of_isNormalizedBy (F : RegularFrame R) (J : Ideal R) {i : ℕ}
    (f : Fin i → R) (hfJ : ∀ j, f j ∈ J)
    (hτ : ∀ j : Fin i, tauZ R F.z (fun _ : Fin 1 => f j) = 0)
    (g : R) (hgJ : g ∈ J)
    (a : ℕ) (ha : 0 < a) (hmu : (mu R J a : ℕ∞) = nuI R J i.succPNat)
    (h1 : ExtendsToStandardBase J (Fin.snoc f g : Fin (i + 1) → R))
    (h2 : F.IsNormalizedBy f g)
    (x : Fin (tau R J a) → maximalIdeal R) (hx : IsRegularSystemOfTauParameters R J a x) :
    initialForm (maximalIdeal R) g ∈
      Algebra.adjoin (R ⧸ maximalIdeal R)
        ((tauParamsSubmoduleStar J a x F.z : Submodule (R ⧸ maximalIdeal R)
          (AssocGraded (maximalIdeal R))) : Set (AssocGraded (maximalIdeal R))) :=
  RegularFrame.initialForm_mem_adjoin_of_isNormalizedBy_aux F J f hfJ hτ g hgJ a ha hmu h1 h2 x hx

end Lemma19

/-! ### Definition 10 (pp. 252–253): regular τ-frames -/

section Definition10

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- Definition 10, pp. 252–253: "Let `R` be a regular local ring, and `J` an ideal in `R`. A
regular frame `(S; z₁, …, z_r)` of `R` will be called a *regular `τ`-frame of `R` for `J`* if
`(z₁, …, z_r)` is a regular system of `τ`-parameters of `R` for `J`. (See Definition 7, §4.)"

(Formalization note: a regular system of `τ`-parameters of `R` for `J` is a system of
`τ^{(t)}(J)` elements of `M` (`\cref{def:III.7}` with `a = t(J)`), so the definition carries
the arity condition `r = τ^{(t(J))}(J)` — recorded here as an equation `tau R J (t R J) = F.r`
through which the system `(z₁, …, z_r)` is transported — together with `z_j ∈ M`, which for a
regular frame follows from `extends_rsop` but is not part of the encoding of that field.) -/
@[blueprint "def:III.10"
  (statement := /-- Let $R$ be a regular local ring and $J$ an ideal in $R$. A regular frame
    $(S;z_1,\dots,z_r)$ of $R$ (\cref{def:III.9}) is called a \emph{regular $\tau$-frame of
    $R$ for $J$} if $(z_1,\dots,z_r)$ is a regular system of $\tau$-parameters of $R$ for $J$
    (\cref{def:III.7}; in particular $r=\tau^{(t)}(J)$ with $t=t(J)$). (Definition 10,
    pp.~252--253.) -/)
  (latexEnv := "definition")]
def RegularFrame.IsRegularTauFrame (F : RegularFrame R) (J : Ideal R) : Prop :=
  ∃ (h : tau R J (t R J) = F.r) (hz : ∀ j, F.z j ∈ maximalIdeal R),
    IsRegularSystemOfTauParameters R J (t R J) fun i => ⟨F.z (Fin.cast h i), hz _⟩

end Definition10


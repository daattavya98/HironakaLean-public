/-!
# Ch. 0 §2 / Ch. I §1 (pp. 166–168): monoidal transformations, total and strict transforms

Hironaka never constructs the blow-up in this paper; he *characterizes* it (p. 166):

> Let V be an algebraic scheme, and B a subscheme of V. Then the monoidal transformation
> f: V' → V of V with center B can be characterized (up to an isomorphism of V') by the
> following universal mapping property:
>  (i) If I denotes the sheaf of ideals of B on V, then f⁻¹(I) (the sheaf of ideals on V'
>      generated by I) is invertible; and
>  (ii) if f': V'' → V is any morphism of algebraic schemes which satisfies (i), then there
>       exists a unique morphism h: V'' → V' such that f' = f ∘ h.
> The existence can be proved by taking as V' the projective scheme Proj(S(I)) over V …
> (cf. §3, Ch. II of Grothendieck [6]).  We note that the above universal mapping property
> remains equivalent if we take arbitrary schemes (or preschemes) in the places of V' and V''.

Accordingly a monoidal transformation is *data* satisfying (i) and (ii) (quantified over all
schemes, as Hironaka allows), and existence is a cited external theorem (EGA II §3).
Because of (ii) any two monoidal transformations with the same center are canonically
isomorphic, so every statement of the paper about "the" monoidal transformation is a
statement about any such datum.

-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace

namespace Hironaka

universe u

/-! ### Total transform (footnote 35, p. 168) -/

namespace Subscheme


/-- The total transform of the empty subscheme (ideal sheaf `⊤ = O_X`) along any morphism is
again empty: the base change of the empty closed immersion is the empty scheme, and the kernel
of a morphism out of the empty scheme is `⊤`.  (`totalTransform f D` is by definition
`D.comap f` in Mathlib's terminology.) -/
theorem totalTransform_top {X X' : Scheme.{u}} (f : X' ⟶ X) :
    totalTransform f (⊤ : Subscheme X) = ⊤ :=
  Scheme.IdealSheafData.comap_top f

theorem totalTransform_empty {X X' : Scheme.{u}} (f : X' ⟶ X) :
    totalTransform f (empty : Subscheme X) = empty :=
  totalTransform_top f

/-- The ideal sheaf `⊤ = O_X` of the empty subscheme is invertible: on every affine open it is
generated by `1`, which is a non-zero-divisor. -/
theorem isInvertibleIdeal_top {X : Scheme.{u}} : (⊤ : Subscheme X).IsInvertibleIdeal := by
  intro x
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  exact ⟨⟨U, hU⟩, hxU, 1, Ideal.span_singleton_one.symm, Submonoid.one_mem _⟩

theorem isInvertibleIdeal_empty {X : Scheme.{u}} : (empty : Subscheme X).IsInvertibleIdeal :=
  isInvertibleIdeal_top

/-- Functoriality of total transforms: the identity does nothing. -/
@[simp]
theorem totalTransform_id {X : Scheme.{u}} (D : Subscheme X) : totalTransform (𝟙 X) D = D :=
  Scheme.IdealSheafData.comap_id D

/-- Functoriality of total transforms: the total transform by a composite is the composite of
the total transforms. -/
@[simp]
theorem totalTransform_comp {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (D : Subscheme Z) :
    totalTransform (f ≫ g) D = totalTransform f (totalTransform g D) :=
  Scheme.IdealSheafData.comap_comp D f g

end Subscheme

/-! ### Monoidal transformations (p. 166) -/


namespace MonoidalTransformation

variable {X : Scheme.{u}} {B : Subscheme X}



/-- Existence of monoidal transformations.  Hironaka cites Grothendieck, EGA II §3
(Proj of the graded algebra `⊕ Iᵐ`) and does not reprove it; this is a cited leaf of
the blueprint.  We record with it that, for `X` locally noetherian, `Proj(⊕ Iᵐ) → X` is
projective, hence proper, which is the form in which the paper uses it (p. 278, for algebraic
schemes).

Deviation from the paper (cited-leaf issue): properness cannot be claimed for every scheme and
every quasi-coherent ideal sheaf, since that is false (blowing up the origin of
`Spec k[x₁, x₂, …]` gives a non-quasi-compact scheme, the exceptional divisor being
`Proj k[T₁, T₂, …]`).  Properness is asserted only for `X`
locally noetherian (every algebraic scheme is noetherian, `IsAlgebraicScheme.isNoetherian`).
Existence is still asserted for every scheme: this is more than the paper cites (it works with
algebraic schemes) but true, since `Proj(⊕ Iᵐ)` has the universal property of (ii) for every
quasi-coherent ideal sheaf. -/
@[blueprint "thm:monoidal-transformation-exists"
  (statement := /-- For every scheme $X$ and subscheme $B$ there exists a monoidal
    transformation of $X$ with center $B$; it can be taken to be
    $\operatorname{Proj}\big(\bigoplus_{m\ge0}I^m\big)\to X$, which is projective, and in
    particular proper, if $X$ is locally noetherian. -/)
  (proof := /-- Cited: Grothendieck, EGA II \S3 (footnote 33, p.\ 166); projectivity of
    $\operatorname{Proj}$ over $X$ gives properness. Not proved in the paper.
    \textbf{Cited-leaf issue.} The paper asserts
    existence for an algebraic scheme $V$. Properness cannot be claimed for every scheme and
    every quasi-coherent ideal sheaf, which is false (the
    blow-up of the origin of $\operatorname{Spec}k[x_1,x_2,\dots]$ is not quasi-compact);
    properness is asserted only for $X$ locally noetherian, which every algebraic scheme
    is. Existence is still asserted for every scheme, which is more than the paper cites but
    true. -/)
  (latexEnv := "theorem")]
theorem exists_isProper [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] :
    ∀ (X : Scheme.{u}) (B : Subscheme X),
    ∃ t : MonoidalTransformation X B, IsLocallyNoetherian X → IsProper t.f :=
  @Hironaka.Cited.MonoidalTransformationExistsIsProper.exists_isProper _

/-- Uniqueness up to unique isomorphism (immediate from (ii), p. 166). -/
@[blueprint "lem:monoidal-transformation-unique"
  (statement := /-- Any two monoidal transformations of $X$ with the same center are
    isomorphic over $X$ by a unique isomorphism. -/)
  (proof := /-- Immediate from the universal mapping property (ii). -/)
  (latexEnv := "lemma")]
theorem unique_up_to_iso (t t' : MonoidalTransformation X B) :
    ∃! e : t.X' ≅ t'.X', e.hom ≫ t'.f = t.f := by
  obtain ⟨h', hh', huniq'⟩ := t'.universal t.X' t.f t.invertible
  obtain ⟨h, hh, -⟩ := t.universal t'.X' t'.f t'.invertible
  have h1 : h' ≫ h = 𝟙 _ :=
    (t.universal t.X' t.f t.invertible).unique (by rw [Category.assoc, hh, hh'])
      (Category.id_comp _)
  have h2 : h ≫ h' = 𝟙 _ :=
    (t'.universal t'.X' t'.f t'.invertible).unique (by rw [Category.assoc, hh', hh])
      (Category.id_comp _)
  exact ⟨⟨h', h, h1, h2⟩, hh', fun e he => Iso.ext (huniq' e.hom he)⟩

/-- Every monoidal transformation of a locally noetherian scheme (e.g. of an algebraic scheme)
is proper: by `unique_up_to_iso` it is isomorphic over `X` to the projective one provided by
`exists_isProper`.  (Used without proof on p. 278, for algebraic schemes.  The
hypothesis `[IsLocallyNoetherian X]` is needed for the cited existence result.) -/
@[blueprint "lem:monoidal-transformation-proper"
  (statement := /-- If $X$ is locally noetherian (e.g.\ algebraic), the morphism
    $f\colon X'\to X$ of any monoidal transformation of $X$ is proper. -/)
  (proof := /-- By \cref{lem:monoidal-transformation-unique}, $f$ is isomorphic over $X$ to
    the projective morphism $\operatorname{Proj}(\bigoplus_m I^m)\to X$ of
    \cref{thm:monoidal-transformation-exists}, and properness is invariant under such
    isomorphisms. -/)
  (latexEnv := "lemma")]
theorem isProper [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] [IsLocallyNoetherian X] (t : MonoidalTransformation X B) : IsProper t.f := by
  obtain ⟨t₀, h₀⟩ := exists_isProper X B
  obtain ⟨e, he, -⟩ := unique_up_to_iso t t₀
  have := h₀ ‹_›
  -- `e.hom` is an isomorphism, hence proper, and `t₀.f` is proper by choice of `t₀`.
  rw [← he]
  infer_instance

/-- The monoidal transformation with empty center is the identity (p. 295, and p. 168:
"B may be the empty subscheme of X"). -/
@[blueprint "lem:monoidal-transformation-empty-center"
  (statement := /-- The monoidal transformation with the empty center is the identity
    isomorphism. -/)
  (latexEnv := "lemma")]
theorem isIso_of_empty (t : MonoidalTransformation X Subscheme.empty) : IsIso t.f := by
  obtain ⟨h, hh, -⟩ := t.universal X (𝟙 X)
    (by rw [Subscheme.totalTransform_empty]; exact Subscheme.isInvertibleIdeal_empty)
  have h2 : t.f ≫ h = 𝟙 _ :=
    (t.universal t.X' t.f t.invertible).unique
      (by rw [Category.assoc, hh, Category.comp_id]) (Category.id_comp _)
  exact ⟨⟨h, h2, hh⟩⟩

end MonoidalTransformation

/-! ### Strict transform (p. 167) -/

namespace Subscheme


/-- Ch. 0 §2, p. 130: the ideal sheaf of the strict transform is the union of the kernels of
`O_{X'} → Hom((g⁻¹J)ⁿ, O_{X'}/g⁻¹(I))`, i.e. the saturation of `g⁻¹(I)` by `g⁻¹(J)`.

Deviation from the paper (gap filled): the paper calls this "an immediate consequence of the
universal mapping properties (1) and (2)" and states it for the blow-up of `V` embedded in `X'`;
here it is proved for the strict transform of p. 167 from (1) alone, on stalks. -/
@[blueprint "lem:strict-transform-saturation"
  (statement := /-- With $I$ the ideal of $V$ and $J$ the ideal of $B$, the ideal of the strict
    transform is $\bigcup_n\big(g^{-1}(I):g^{-1}(J)^n\big)$. -/)
  (proof := /-- The paper: ``This fact is an immediate consequence of the universal mapping
    properties (1) and (2)'' (p.\ 130), stated there for the ideal of the blow-up $X''$ of $V$
    embedded in $X'$.
    \textbf{Gap in the paper filled.} Lean proves the formula for the strict transform of
    p.~167 (\cref{def:strict-transform}), using only (i): the ideal $g^{-1}(J)$ of
    $E=g^{-1}(B)$ is invertible, locally generated by a non-zero-divisor $s$. A sheaf of ideals
    $V'$ agreeing with $g^{-1}(I)$ off $E$ agrees with it on the affine opens $D(s)$, so every
    section $h$ of $V'$ satisfies $s^nh\in g^{-1}(I)$ for some $n$; conversely the union of the
    $g^{-1}(I)\cdot g^{-1}(J)^{-n}$ (whose stalks are the colon ideals, $g^{-1}(J)$ being
    invertible) agrees with $g^{-1}(I)$ off $E$. The argument is carried out on stalks; the
    universal property (ii) enters only in \cref{lem:strict-transform-is-blowup}, which
    identifies this subscheme with $X''$. -/)
  (latexEnv := "lemma")]
theorem strictTransform_stalkIdeal {X : Scheme.{u}} {B : Subscheme X}
    (t : MonoidalTransformation X B) (V : Subscheme X) (x' : t.X') :
    (strictTransform t V).stalkIdeal x' =
      ⨆ n : ℕ, ((totalTransform t.f V).stalkIdeal x').colon
        (((t.exceptional.stalkIdeal x') ^ n : Ideal _) : Set _) :=
  Subscheme.stalkIdeal_sSup_eq_off t.invertible x'

/-- (a), (b) of p. 167: the monoidal transformation of `V` with center `B ∩ V` identifies
with the strict transform of `V`; in particular the strict transform of `V` is the blow-up
of `V` along `B ∩ V`.

Deviation from the paper (gap filled): "immediately from the above universal mapping
property" (p. 167); the proof also needs the saturation of the strict transform and a
non-zero-divisor argument.  The uniqueness of the identification ("in a unique way", (a)) is
`Subscheme.existsUnique_hom_strictTransform`. -/
@[blueprint "lem:strict-transform-is-blowup"
  (statement := /-- Let $V\subseteq X$ be a subscheme and $g\colon X'\to X$ the monoidal
    transformation with center $B$. The monoidal transformation $f\colon V'\to V$ with center
    $B\cap V$ identifies uniquely with a subscheme of $X'$ so that $g$ induces $f$, and this
    subscheme is the strict transform of $V$.
    The Lean statement gives, for every monoidal transformation
    $f\colon V'\to V$ with center $B\cap V$, an isomorphism of $V'$ with the strict transform
    compatible with $f$ and $g$; the uniqueness of the identification (``in a unique way'',
    (a) of p.~167) is \cref{lem:strict-transform-is-blowup-unique}. -/)
  (proof := /-- The paper: ``immediately from the above universal mapping property'' (p.\ 167).
    \textbf{Gap in the paper filled.} The Lean argument also needs the saturation of the
    strict transform and a non-zero-divisor argument: the
    ideal of $V'$ contains $g^{-1}(I_V)$, so $V'\to X'\to X$ factors through $V$; the ideal of
    $V'$ is saturated with respect to the invertible ideal $g^{-1}(J)$
    (\cref{lem:strict-transform-saturation}), so a local generator of $g^{-1}(J)$ stays a
    non-zero-divisor on $V'$ and the pull-back of $B\cap V$ to $V'$ is invertible. If
    $h\colon Z\to V$ has invertible $h^{-1}(B\cap V)$, then $Z\to V\to X$ factors uniquely as
    $k_0\colon Z\to X'$; a section $a$ of the ideal of $V'$ satisfies $as^n\in g^{-1}(I_V)$, whose
    pull-back to $Z$ vanishes, and the image of $s$ generates the invertible ideal
    $h^{-1}(B\cap V)$, hence is a non-zero-divisor, so $k_0$ kills the ideal of $V'$ and factors
    through $V'$. Thus $V'\to V$ is a monoidal transformation with center $B\cap V$, and it is
    unique up to isomorphism (\cref{lem:monoidal-transformation-unique}); existence is
    \cref{thm:monoidal-transformation-exists}. -/)
  (latexEnv := "lemma")]
theorem nonempty_monoidalTransformation_strictTransform [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] {X : Scheme.{u}} {B : Subscheme X}
    (t : MonoidalTransformation X B) (V : Subscheme X) :
    Nonempty (MonoidalTransformation V.toScheme (totalTransform V.ι B)) ∧
    ∀ s : MonoidalTransformation V.toScheme (totalTransform V.ι B),
      ∃ e : s.X' ≅ (strictTransform t V).toScheme,
        e.hom ≫ (strictTransform t V).ι ≫ t.f = s.f ≫ V.ι := by
  refine ⟨⟨(MonoidalTransformation.exists_isProper _ _).choose⟩, fun s => ?_⟩
  set V' := strictTransform t V with hV'
  -- `f⁻¹(V) ⊆ V'`, so `V' → X' → X` factors through `V`
  have hle : totalTransform t.f V ≤ V' := le_sSup fun _ _ => rfl
  let g : V'.toScheme ⟶ V.toScheme := Scheme.IdealSheafData.subschemeMap V' V t.f
    (Scheme.IdealSheafData.le_map_iff_comap_le.mpr hle)
  have hg : g ≫ V.ι = V'.ι ≫ t.f := Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _
  -- `V'` is saturated with respect to `E = f⁻¹(B)`
  have hdir : ∀ x : t.X', Directed (· ≤ ·) fun n : ℕ =>
      ((totalTransform t.f V).stalkIdeal x).colon
        (((t.exceptional.stalkIdeal x) ^ n : Ideal _) : Set (t.X'.presheaf.stalk x)) :=
    fun x => Monotone.directed_le fun m n hmn =>
      Submodule.colon_mono le_rfl (Ideal.pow_le_pow_right hmn)
  have hsat : ∀ x, (V'.stalkIdeal x).colon (t.exceptional.stalkIdeal x : Set _) ≤
      V'.stalkIdeal x := by
    intro x a ha
    obtain ⟨σ, hσ, -⟩ := Subscheme.IsInvertibleIdeal.exists_stalkIdeal_eq_span t.invertible x
    have hσ' : t.exceptional.stalkIdeal x = Ideal.span {σ} := hσ
    have ha' : a * σ ∈ V'.stalkIdeal x := by
      have := Submodule.mem_colon.mp ha σ (by rw [hσ']; exact Ideal.mem_span_singleton_self σ)
      simpa [smul_eq_mul] using this
    rw [hV', strictTransform_stalkIdeal] at ha' ⊢
    obtain ⟨n, hn⟩ := (Submodule.mem_iSup_of_directed _ (hdir x)).mp ha'
    refine Ideal.mem_iSup_of_mem (n + 1) (Submodule.mem_colon.mpr fun p hp => ?_)
    rw [hσ', Ideal.span_singleton_pow, SetLike.mem_coe, Ideal.mem_span_singleton'] at hp
    obtain ⟨c, rfl⟩ := hp
    have := Submodule.mem_colon.mp hn (c * σ ^ n) (by
      rw [hσ', Ideal.span_singleton_pow]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    rw [smul_eq_mul] at this ⊢
    convert this using 1
    ring
  -- the pull-back of `B ∩ V` to `V'` is invertible
  have hinv : (totalTransform g (totalTransform V.ι B)).IsInvertibleIdeal := by
    rw [← totalTransform_comp, hg, totalTransform_comp]
    exact Subscheme.IsInvertibleIdeal.comap_subschemeι (K := V') t.invertible hsat
  -- the universal property
  have huniv : ∀ (Z : Scheme.{u}) (h : Z ⟶ V.toScheme),
      (totalTransform h (totalTransform V.ι B)).IsInvertibleIdeal → ∃! k : Z ⟶ V'.toScheme,
        k ≫ g = h := by
    intro Z h hh
    have hh' : (totalTransform (h ≫ V.ι) B).IsInvertibleIdeal := by
      rw [totalTransform_comp]; exact hh
    obtain ⟨k₀, hk₀, hk₀u⟩ := t.universal Z (h ≫ V.ι) hh'
    -- `f⁻¹(V)` pulls back to zero on `Z`
    have hVV : V.comap V.ι = (⊥ : Subscheme V.toScheme) := by
      refine Subscheme.ext_stalkIdeal fun w => ?_
      rw [Subscheme.stalkIdeal_comap, Subscheme.stalkIdeal_bot_eq, stalkIdeal_eq_ker_stalkMap V w]
      exact (Ideal.map_eq_bot_iff_le_ker _).mpr le_rfl
    have hJ0 : (totalTransform t.f V).comap k₀ = ⊥ := by
      change (V.comap t.f).comap k₀ = ⊥
      rw [← Scheme.IdealSheafData.comap_comp, hk₀, Scheme.IdealSheafData.comap_comp, hVV]
      exact Subscheme.ext_stalkIdeal fun z => by
        rw [Subscheme.stalkIdeal_comap, Subscheme.stalkIdeal_bot_eq, Ideal.map_bot,
          Subscheme.stalkIdeal_bot_eq]
    have hker : V'.subschemeι.ker ≤ k₀.ker := by
      rw [Scheme.IdealSheafData.ker_subschemeι, ← Scheme.IdealSheafData.map_bot,
        Scheme.IdealSheafData.le_map_iff_comap_le, Subscheme.le_iff_stalkIdeal_le]
      intro z
      rw [Subscheme.stalkIdeal_bot_eq, Subscheme.stalkIdeal_comap, Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, Submodule.mem_bot]
      obtain ⟨σ, hσ, -⟩ := Subscheme.IsInvertibleIdeal.exists_stalkIdeal_eq_span t.invertible (k₀ z)
      have hσ' : t.exceptional.stalkIdeal (k₀ z) = Ideal.span {σ} := hσ
      rw [hV', strictTransform_stalkIdeal] at ha
      obtain ⟨n, hn⟩ := (Submodule.mem_iSup_of_directed _ (hdir (k₀ z))).mp ha
      have h1 : a * σ ^ n ∈ (totalTransform t.f V).stalkIdeal (k₀ z) := by
        have := Submodule.mem_colon.mp hn (σ ^ n) (by
          rw [hσ', Ideal.span_singleton_pow]; exact Ideal.mem_span_singleton_self _)
        simpa [smul_eq_mul] using this
      have h2 := Ideal.mem_map_of_mem (k₀.stalkMap z).hom h1
      rw [← Subscheme.stalkIdeal_comap, hJ0, Subscheme.stalkIdeal_bot_eq, Submodule.mem_bot,
        map_mul, map_pow] at h2
      -- the image of `σ` generates the invertible ideal `(h ∘ ι)⁻¹(B)` at `z`
      obtain ⟨γ, hγ, hγnzd⟩ := Subscheme.IsInvertibleIdeal.exists_stalkIdeal_eq_span hh' z
      have h3 : Ideal.span {(k₀.stalkMap z).hom σ} = Ideal.span {γ} := by
        rw [← hγ, ← hk₀, totalTransform_comp]
        change _ = Subscheme.stalkIdeal (t.exceptional.comap k₀) z
        rw [Subscheme.stalkIdeal_comap, hσ', Ideal.map_span, Set.image_singleton]
      have h4 := Subscheme.mem_nonZeroDivisors_of_span_eq h3 hγnzd
      exact (mul_right_mem_nonZeroDivisors_eq_zero_iff (pow_mem h4 n)).mp h2
    let k : Z ⟶ V'.toScheme := IsClosedImmersion.lift V'.subschemeι k₀ hker
    have hk : k ≫ V'.ι = k₀ := IsClosedImmersion.lift_fac _ _ _
    refine ⟨k, ?_, fun k' hk' => ?_⟩
    · show k ≫ g = h
      rw [← cancel_mono V.ι, Category.assoc, hg, ← Category.assoc, hk, hk₀]
    · have hk'' : k' ≫ g = h := hk'
      have : k' ≫ V'.ι = k₀ := hk₀u _ (show (k' ≫ V'.ι) ≫ t.f = h ≫ V.ι by
        rw [Category.assoc, ← hg, ← Category.assoc, hk''])
      rw [← cancel_mono V'.ι, this, hk]
  let t' : MonoidalTransformation V.toScheme (totalTransform V.ι B) :=
    ⟨V'.toScheme, g, hinv, huniv⟩
  obtain ⟨e, he, -⟩ := MonoidalTransformation.unique_up_to_iso s t'
  refine ⟨e, ?_⟩
  rw [← hg, ← Category.assoc]
  exact congrArg (· ≫ V.ι) he

/-- (a) of p. 167, the uniqueness: "Then, immediately from the above universal mapping property, it follows
that (a) `V'` can be in a unique way identified with a subscheme of `X'` such that the following diagram
commutes, (b) `V'` (as a subscheme of `X'`) is the strict transform of `V` by the monoidal transformation
`g` with center `B`."  Here `s : V' → V` is a monoidal transformation with center `B ∩ V`.  The
morphism `V' → X'` of the diagram is unique, among all morphisms; and every morphism making the diagram
commute is the closed immersion of the strict transform of `V` composed with an isomorphism
`V' ≅ strictTransform t V` (this is the identification of (a), a subscheme of `X'`, and (b)).

Gap in the paper filled: the uniqueness is the uniqueness in the universal property (ii) of `g`, applied to
`V' → V → X`, whose pull-back of `I_B` is invertible by (i) for `s` (`totalTransform_comp`); the paper
says "immediately". -/
@[blueprint "lem:strict-transform-is-blowup-unique"
  (statement := /-- Let $V\subseteq X$ be a subscheme, $g\colon X'\to X$ the monoidal transformation with
    center $B$ and $f\colon V'\to V$ the monoidal transformation with center $B\cap V$. Then there is
    exactly one morphism $j\colon V'\to X'$ with $g\circ j=\iota_V\circ f$, and every morphism $j$ with
    this property is the composite of an isomorphism of $V'$ with the strict transform of $V$ and the
    inclusion of the latter into $X'$. (p.~167, (a) and (b).)
    \textbf{Gap in the paper filled.} The paper: ``immediately from the above universal mapping
    property''. -/)
  (proof := /-- $\iota_V\circ f$ has an invertible pull-back of $I_B$, namely that of $f$
    (\cref{def:monoidal-transformation} (i)), so the universal property (ii) of $g$ gives exactly one $j$.
    By \cref{lem:strict-transform-is-blowup} the composite of an isomorphism $V'\cong\overline V$ with the
    inclusion $\overline V\to X'$ is such a $j$; by uniqueness it is every such $j$. -/)
  (latexEnv := "lemma")]
theorem existsUnique_hom_strictTransform [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] {X : Scheme.{u}} {B : Subscheme X}
    (t : MonoidalTransformation X B) (V : Subscheme X)
    (s : MonoidalTransformation V.toScheme (totalTransform V.ι B)) :
    (∃! j : s.X' ⟶ t.X', j ≫ t.f = s.f ≫ V.ι) ∧
    ∀ j : s.X' ⟶ t.X', j ≫ t.f = s.f ≫ V.ι →
      ∃ e : s.X' ≅ (strictTransform t V).toScheme, e.hom ≫ (strictTransform t V).ι = j := by
  have hinv : (totalTransform (s.f ≫ V.ι) B).IsInvertibleIdeal := by
    rw [totalTransform_comp]
    exact s.invertible
  have huniq := t.universal s.X' (s.f ≫ V.ι) hinv
  obtain ⟨e, he⟩ := (nonempty_monoidalTransformation_strictTransform t V).2 s
  have hj₀ : (e.hom ≫ (strictTransform t V).ι) ≫ t.f = s.f ≫ V.ι := by
    rw [Category.assoc]
    exact he
  refine ⟨⟨_, hj₀, fun j hj => huniq.unique hj hj₀⟩, fun j hj => ⟨e, ?_⟩⟩
  exact (huniq.unique hj₀ hj)


end Subscheme

/-! ### Successions of monoidal transformations (pp. 168–170) -/


namespace MonoidalSuccession


/-- The number of monoidal transformations in the succession. -/
def length : {X Y : Scheme.{u}} → MonoidalSuccession X Y → ℕ
  | _, _, nil _ => 0
  | _, _, cons _ _ rest => rest.length + 1



@[simp] theorem composite_nil (X : Scheme.{u}) : (nil X).composite = 𝟙 X := rfl

@[simp] theorem composite_cons {X Y : Scheme.{u}} (B : Subscheme X)
    (t : MonoidalTransformation X B) (rest : MonoidalSuccession t.X' Y) :
    (cons B t rest).composite = rest.composite ≫ t.f := rfl

@[simp] theorem length_nil (X : Scheme.{u}) : (nil X).length = 0 := rfl

@[simp] theorem length_cons {X Y : Scheme.{u}} (B : Subscheme X)
    (t : MonoidalTransformation X B) (rest : MonoidalSuccession t.X' Y) :
    (cons B t rest).length = rest.length + 1 := rfl

@[simp] theorem strictTransform_nil {X : Scheme.{u}} (V : Subscheme X) :
    (nil X).strictTransform V = V := rfl

@[simp] theorem strictTransform_cons {X Y : Scheme.{u}} (B : Subscheme X)
    (t : MonoidalTransformation X B) (rest : MonoidalSuccession t.X' Y) (V : Subscheme X) :
    (cons B t rest).strictTransform V = rest.strictTransform (Subscheme.strictTransform t V) :=
  rfl

@[simp] theorem totalTransform_nil {X : Scheme.{u}} (V : Subscheme X) :
    (nil X).totalTransform V = V := by
  simp [totalTransform]

/-- The composite of a succession of monoidal transformations of a locally noetherian scheme is
proper (p. 278: "a morphism obtained by a succession of monoidal transformations is proper",
for algebraic schemes).  Hironaka uses this without proof; each monoidal transformation of a
locally noetherian scheme is proper (`MonoidalTransformation.isProper`), hence of finite type,
so its source is again locally noetherian, and composites of proper morphisms are proper. -/
@[blueprint "lem:succession-proper"
  (statement := /-- If $X$ is locally noetherian (e.g.\ algebraic), the composite morphism of
    a finite succession of monoidal transformations of $X$ is proper. -/)
  (proof := /-- Induction on the length of the succession: each monoidal transformation of a
    locally noetherian scheme is proper (\cref{lem:monoidal-transformation-proper}), in
    particular of finite type, so the next scheme is again locally noetherian; and a composite
    of proper morphisms is proper. -/)
  (latexEnv := "lemma")]
theorem isProper_composite [Hironaka.Cited.MonoidalTransformationExistsIsProper.{u}] {X Y : Scheme.{u}} [IsLocallyNoetherian X]
    (s : MonoidalSuccession X Y) : IsProper s.composite := by
  revert ‹IsLocallyNoetherian X›
  induction s with
  | nil X =>
    intro _
    show IsProper (𝟙 X)
    infer_instance
  | cons B t rest ih =>
    intro _
    have := t.isProper
    have : IsLocallyNoetherian t.X' := LocallyOfFiniteType.isLocallyNoetherian t.f
    have := ih
    show IsProper (rest.composite ≫ t.f)
    infer_instance

end MonoidalSuccession

end Hironaka


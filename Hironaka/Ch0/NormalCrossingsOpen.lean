namespace Hironaka

universe u

/-! ### Commutative algebra: spreading properties of a localization to nearby primes

Throughout, `A` is a ring, `p` a prime of `A` and `Bp` a localization of `A` at `p`; a property
holds "near `p`" if it holds for all primes `q` in a neighbourhood of `p` in `Spec A`, and for all
localizations `B` of `A` at `q`. -/

section NCOpenAlgebra

open Classical

/-- In a regular local ring, the ideal generated by part `K` of a regular system of parameters
has height at least `#K` (the ideals generated by the initial segments of `K` form a chain of
primes). -/
theorem ExtendsToRSOP.card_le_height_span {R : Type u} [CommRing R] [IsRegularLocalRing R]
    {K : Finset R} (h : ExtendsToRSOP R K) :
    (K.card : ℕ∞) ≤ (Ideal.span (K : Set R)).height := by
  classical
  induction K using Finset.induction_on with
  | empty => simp
  | @insert k K hk ih =>
    have h' : ExtendsToRSOP R K := h.mono (Finset.subset_insert _ _)
    have hP := h.isPrime_span
    have hP' := h'.isPrime_span
    have hlt : Ideal.span (K : Set R) < Ideal.span ((insert k K : Finset R) : Set R) := by
      refine lt_of_le_of_ne (Ideal.span_mono (by simp)) fun heq => ?_
      obtain ⟨Z, hKZ, hZ⟩ := h
      apply rsop_notMem_span hZ ((Finset.subset_insert _ _).trans hKZ)
        (hKZ (Finset.mem_insert_self _ _)) hk
      rw [heq]
      exact Ideal.subset_span (by simp)
    have := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    rw [Finset.card_insert_of_notMem hk]
    push_cast
    calc (K.card : ℕ∞) + 1 ≤ (Ideal.span (K : Set R)).height + 1 := by
          gcongr; exact ih h'
      _ ≤ _ := by rw [← Finset.coe_insert]; exact this

/-- If every prime containing `I` has height at least `n`, then `dim R/I + n ≤ dim R`. -/
theorem ringKrullDim_quotient_add_le_of_le_height {R : Type*} [CommRing R] (I : Ideal R) (n : ℕ)
    (h : ∀ P : Ideal R, P.IsPrime → I ≤ P → (n : ℕ∞) ≤ P.height) :
    ringKrullDim (R ⧸ I) + n ≤ ringKrullDim R := by
  rw [ringKrullDim_quotient I]
  set Z := PrimeSpectrum.zeroLocus (R := R) (I : Set R)
  rcases isEmpty_or_nonempty Z with hZ | hZ
  · rw [Order.krullDim_eq_bot]
    simp
  · have : Nonempty (PrimeSpectrum R) := ⟨(Classical.arbitrary Z).1⟩
    rw [Order.krullDim_eq_iSup_coheight_of_nonempty]
    unfold ringKrullDim
    rw [Order.krullDim_eq_iSup_height_add_coheight_of_nonempty]
    have e : ((⨆ a : Z, Order.coheight a : ℕ∞) : WithBot ℕ∞) + (n : WithBot ℕ∞) =
        (((⨆ a : Z, Order.coheight a) + n : ℕ∞) : WithBot ℕ∞) := by
      push_cast; rfl
    rw [e, WithBot.coe_le_coe, ENat.iSup_add]
    refine iSup_le fun a => ?_
    refine le_trans ?_ (le_iSup _ a.1)
    rw [add_comm (Order.height a.1)]
    gcongr
    · exact Order.coheight_le_coheight_apply_of_strictMono Subtype.val (fun _ _ h => h) a
    · have := h a.1.asIdeal a.1.isPrime a.2
      rwa [PrimeSpectrum.height_eq_orderHeight] at this

/-- An inclusion `J₁ Bp ⊆ J₂ Bp` of extended ideals at `p` persists near `p` (for `A`
noetherian): an element `s ∉ p` of `(J₂ : J₁)` becomes a unit near `p`. -/
theorem eventually_map_le_map_of_map_le {A : Type u} [CommRing A] [IsNoetherianRing A]
    (p : PrimeSpectrum A) (Bp : Type u) [CommRing Bp] [Algebra A Bp]
    [IsLocalization.AtPrime Bp p.asIdeal] (J₁ J₂ : Ideal A)
    (h : J₁.map (algebraMap A Bp) ≤ J₂.map (algebraMap A Bp)) :
    ∀ᶠ q in 𝓝 p, ∀ (B : Type u) [CommRing B] [Algebra A B]
      [IsLocalization.AtPrime B q.asIdeal],
        J₁.map (algebraMap A B) ≤ J₂.map (algebraMap A B) := by
  have := IsLocalization.AtPrime.isLocalRing Bp p.asIdeal
  have hcol := Ideal.map_colon_of_isLocalization (A' := Bp) p.asIdeal.primeCompl J₂ J₁
    (IsNoetherian.noetherian J₁)
  have htop : (J₂.colon (J₁ : Set A)).map (algebraMap A Bp) = ⊤ := by
    rw [hcol, Ideal.eq_top_iff_one, Submodule.mem_colon]
    intro b hb
    rw [one_smul]
    exact h hb
  obtain ⟨s, hs, hsp⟩ : ∃ s ∈ J₂.colon (J₁ : Set A), s ∉ p.asIdeal := by
    by_contra hcon
    push Not at hcon
    have hle : (J₂.colon (J₁ : Set A)).map (algebraMap A Bp) ≤ maximalIdeal Bp := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Bp p.asIdeal a).mpr (hcon a ha)
    rw [htop, top_le_iff] at hle
    exact (maximalIdeal.isMaximal Bp).ne_top hle
  refine Filter.eventually_of_mem ((PrimeSpectrum.basicOpen s).isOpen.mem_nhds hsp) ?_
  intro q hq B _ _ _
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap]
  have hsa : s * a ∈ J₂ := by
    have := Submodule.mem_colon.mp hs a ha
    rwa [smul_eq_mul] at this
  have hu : IsUnit (algebraMap A B s) :=
    IsLocalization.map_units B (⟨s, hq⟩ : q.asIdeal.primeCompl)
  have := Ideal.mem_map_of_mem (algebraMap A B) hsa
  rw [map_mul] at this
  exact (Ideal.unit_mul_mem_iff_mem _ hu).mp this

/-- For `J ⊆ q`, the quotient `B/JB` of a localization `B` of `A` at `q` is regular iff the
point `q/J` of `Spec A/J` lies in the regular locus. -/
theorem isRegularLocalRing_quotient_map_iff_mem_regularLocus {A : Type u} [CommRing A] (J : Ideal A)
    (q : PrimeSpectrum A) (hJq : J ≤ q.asIdeal) (B : Type u) [CommRing B] [Algebra A B]
    [IsLocalization.AtPrime B q.asIdeal] :
    IsRegularLocalRing (B ⧸ J.map (algebraMap A B)) ↔
      (⟨q.asIdeal.map (Ideal.Quotient.mk J), Ideal.isPrime_map_quotientMk_of_isPrime hJq⟩ :
        PrimeSpectrum (A ⧸ J)) ∈ regularLocus (A ⧸ J) := by
  set q' : Ideal (A ⧸ J) := q.asIdeal.map (Ideal.Quotient.mk J) with hq'def
  have hq' : q'.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hJq
  have hsub : Algebra.algebraMapSubmonoid (A ⧸ J) q.asIdeal.primeCompl = q'.primeCompl := by
    ext x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    constructor
    · rintro ⟨b, hb, hba⟩
      show Ideal.Quotient.mk J a ∉ q'
      rw [hq'def, Ideal.mem_quotient_iff_mem hJq]
      intro ha
      apply hb
      have hba' : Ideal.Quotient.mk J b = Ideal.Quotient.mk J a := hba
      rw [Ideal.Quotient.eq] at hba'
      have := q.asIdeal.add_mem (hJq hba') ha
      simpa using this
    · intro ha
      refine ⟨a, fun ha' => ha ?_, rfl⟩
      exact Ideal.mem_map_of_mem _ ha'
  have : IsLocalization q'.primeCompl (B ⧸ J.map (algebraMap A B)) :=
    hsub ▸ (inferInstance : IsLocalization (Algebra.algebraMapSubmonoid (A ⧸ J)
      q.asIdeal.primeCompl) (B ⧸ J.map (algebraMap A B)))
  let e := IsLocalization.algEquiv q'.primeCompl (Localization.AtPrime q')
    (B ⧸ J.map (algebraMap A B))
  show _ ↔ IsRegularLocalRing (Localization.AtPrime q')
  constructor
  · intro h
    exact IsRegularLocalRing.of_ringEquiv e.symm.toRingEquiv
  · intro h
    exact IsRegularLocalRing.of_ringEquiv e.toRingEquiv

/-- For `A` of finite type over `S ∈ 𝔅`, regularity of `Bp/J Bp` persists near `p` (on `V(J)`):
this is the openness of the regular locus of `Spec A/J`, (iii) of p. 161. -/
theorem eventually_isRegularLocalRing_quotient_map [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] {S A : Type u} [CommRing S] [IsLocalRing S]
    [IsHironakaBase S] [CommRing A] [Algebra S A] [Algebra.FiniteType S A] (J : Ideal A)
    (p : PrimeSpectrum A) (Bp : Type u) [CommRing Bp] [Algebra A Bp]
    [IsLocalization.AtPrime Bp p.asIdeal] (hJp : J ≤ p.asIdeal)
    (hreg : IsRegularLocalRing (Bp ⧸ J.map (algebraMap A Bp))) :
    ∀ᶠ q in 𝓝 p, ∀ (_ : J ≤ q.asIdeal) (B : Type u) [CommRing B] [Algebra A B]
      [IsLocalization.AtPrime B q.asIdeal],
        IsRegularLocalRing (B ⧸ J.map (algebraMap A B)) := by
  have hft : Algebra.FiniteType S (A ⧸ J) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ S J)
      (Ideal.Quotient.mkₐ_surjective S J)
  have hopen : IsOpen (regularLocus (A ⧸ J)) :=
    isClosed_compl_iff.mp (IsHironakaBase.isClosed_singularLocus S (A ⧸ J))
  have hind : Topology.IsInducing (PrimeSpectrum.comap (Ideal.Quotient.mk J)) :=
    PrimeSpectrum.comap_isInducing_of_surjective _ _ Ideal.Quotient.mk_surjective
  obtain ⟨O, hO, hOeq⟩ := hind.isOpen_iff.mp hopen
  have hmem : ∀ (q : PrimeSpectrum A) (hJq : J ≤ q.asIdeal),
      PrimeSpectrum.comap (Ideal.Quotient.mk J) ⟨q.asIdeal.map (Ideal.Quotient.mk J),
        Ideal.isPrime_map_quotientMk_of_isPrime hJq⟩ = q := by
    intro q hJq
    ext1
    rw [PrimeSpectrum.comap_asIdeal, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact sup_eq_left.mpr hJq
  have hpO : p ∈ O := by
    have := (isRegularLocalRing_quotient_map_iff_mem_regularLocus J p hJp Bp).mp hreg
    rw [← hOeq, Set.mem_preimage, hmem p hJp] at this
    exact this
  refine Filter.eventually_of_mem (hO.mem_nhds hpO) ?_
  intro q hq hJq B _ _ _
  refine (isRegularLocalRing_quotient_map_iff_mem_regularLocus J q hJq B).mpr ?_
  rw [← hOeq, Set.mem_preimage, hmem q hJq]
  exact hq

/-- The height count behind "by (1) the subsystem … can be extended" (p. 277), where the
primality of the ideal `I = (z₁, …, z_s, z_{i₁}, …, z_{i_t})A` in (1) is used: if `I` is a prime of
`A` contained in the prime `p` of `x`, with `I Bp` of height at least `n`, then every prime `P` of a
localization `B` of `A` (at any prime `q`) containing `I B` has height at least `n`: `P ∩ A ⊇ I`,
heights of primes are unchanged by localization, and `ht I = ht(I Bp)` since `I ⊆ p`. -/
theorem le_height_of_isPrime_of_le_height_map {A : Type u} [CommRing A]
    (p : Ideal A) [p.IsPrime] (Bp : Type u) [CommRing Bp] [Algebra A Bp]
    [IsLocalization.AtPrime Bp p] (I : Ideal A) [I.IsPrime] (hIp : I ≤ p) (n : ℕ)
    (hn : (n : ℕ∞) ≤ (I.map (algebraMap A Bp)).height)
    (q : Ideal A) [q.IsPrime] (B : Type u) [CommRing B] [Algebra A B]
    [IsLocalization.AtPrime B q] (P : Ideal B) [P.IsPrime]
    (hIP : I.map (algebraMap A B) ≤ P) : (n : ℕ∞) ≤ P.height := by
  have h1 : (I.map (algebraMap A Bp)).height = I.height :=
    IsLocalization.height_map_of_disjoint p.primeCompl I
      (Set.disjoint_left.mpr fun a ha haI => ha (hIp haI))
  have h2 : (P.under A).height = P.height := IsLocalization.height_under q.primeCompl P
  have h3 : I ≤ P.under A := Ideal.map_le_iff_le_comap.mp hIP
  calc (n : ℕ∞) ≤ (I.map (algebraMap A Bp)).height := hn
    _ = I.height := h1
    _ ≤ (P.under A).height := Ideal.height_mono h3
    _ = P.height := h2

/-- "By (1) the subsystem of `(z₁, …, z_r)` consisting of those `z_j` contained in `Q` can be
extended to a regular system of parameters of the local ring `A_Q`" (p. 277).  Let `I = (v_i)_{i∈F}A`
be a prime ideal of `A` with `A/I` a regular ring (this is (1)), the images of the `v_i` in `A_p`
being distinct and part of a regular system of parameters of `A_p`, and let `q ⊇ I` be a prime of
`A`.  Then the images of the `v_i` in `A_q` form part of a regular system of parameters of `A_q`.

Gap filled: the paper derives this "by (1)" in one line.  `A_q/IA_q` is regular since `A/I` is a
regular ring.  `I ⊆ p` is a prime of height `≥ #F` (`I A_p` is generated by part of a regular system
of parameters, `ExtendsToRSOP.card_le_height_span`), so every prime of `A_q` over `I A_q` has height
`≥ #F` (`le_height_of_isPrime_of_le_height_map`, the use of the primality in (1)); hence
`dim A_q/IA_q + #F ≤ dim A_q`, and with the regularity of `A_q/IA_q` a regular system of parameters
of `A_q/IA_q` lifts to one of `A_q` containing the `v_i` (`rsop_extends_of_quotient_regular`).
Regularity of `A_q/IA_q` alone would not suffice. -/
@[blueprint "lem:normal-crossings-open-extend"
  (statement := /-- Let $A$ be a ring, $P$ a prime ideal of $A$ with $A_P$ regular, and
    $v_i\in A$ ($i\in F$) elements whose images in $A_P$ are distinct and part of a regular
    system of parameters of $A_P$. Assume that $I=(v_i)_{i\in F}A$ is a prime ideal of $A$ and
    that $A/I$ is a regular ring. Then, for every prime $Q\supseteq I$ of $A$ with $A_Q$ regular,
    the images of the $v_i$ in $A_Q$ are part of a regular system of parameters of $A_Q$.
    (The step ``by (1) the subsystem \dots\ can be extended to a regular system of parameters of
    the local ring $A_Q$'' of the proof of Lemma~1, p.~277.) -/)
  (proof := /-- The ring $A_Q/IA_Q$ is regular because $A/I$ is a regular ring. The prime $I$ is
    contained in $P$, and $IA_P$ is generated by part of a regular system of parameters of $A_P$,
    hence has height at least $\#F$; heights of primes are unchanged by localization, so $I$ has
    height at least $\#F$ in $A$ and every prime of $A_Q$ containing $IA_Q$ has height at least
    $\#F$. Hence $\dim A_Q/IA_Q+\#F\le\dim A_Q$. A regular local quotient of a regular local
    ring $B$ by an ideal generated by $m$ elements of the maximal ideal with $\dim B/J+m\le\dim B$
    has its generators extended to a regular system of parameters of $B$ (lift a regular system of
    parameters of $B/J$). \textbf{Gap filled.} The paper states this as a consequence of (1); the
    height count, which uses the primality of $I$ in (1), is supplied. -/)
  (latexEnv := "lemma")]
theorem extendsToRSOP_image_of_isPrime {A : Type u} [CommRing A]
    (p : PrimeSpectrum A) (Bp : Type u) [CommRing Bp] [Algebra A Bp]
    [IsLocalization.AtPrime Bp p.asIdeal] [IsRegularLocalRing Bp] {ι : Type*} (F : Finset ι)
    (v : ι → A) (hinj : Set.InjOn (fun i => algebraMap A Bp (v i)) F)
    (hF : ExtendsToRSOP Bp (F.image fun i => algebraMap A Bp (v i)))
    (hprime : (Ideal.span (v '' (F : Set ι))).IsPrime)
    (hreg : IsRegularRing (A ⧸ Ideal.span (v '' (F : Set ι))))
    (q : PrimeSpectrum A) (hFq : ∀ i ∈ F, v i ∈ q.asIdeal) (B : Type u) [CommRing B] [Algebra A B]
    [IsLocalization.AtPrime B q.asIdeal] [IsRegularLocalRing B] :
    ExtendsToRSOP B (F.image fun i => algebraMap A B (v i)) := by
  classical
  set J : Ideal A := Ideal.span (v '' (F : Set ι)) with hJ
  have hmapJ : ∀ (B : Type u) [CommRing B] [Algebra A B], J.map (algebraMap A B) =
      Ideal.span ((F.image fun i => algebraMap A B (v i) : Finset B) : Set B) := by
    intro B _ _
    rw [hJ, Ideal.map_span, Finset.coe_image, ← Set.image_comp]
    rfl
  have hJp : J ≤ p.asIdeal := by
    rw [hJ, Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Bp p.asIdeal (v i)).mp
      (hF.mem_maximalIdeal (Finset.mem_image_of_mem _ hi))
  have hht : ((F.card : ℕ) : ℕ∞) ≤ (J.map (algebraMap A Bp)).height := by
    rw [hmapJ, ← Finset.card_image_of_injOn hinj]
    exact ExtendsToRSOP.card_le_height_span hF
  have hJq : J ≤ q.asIdeal := by
    rw [hJ, Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    exact hFq i hi
  have hreg' : IsRegularLocalRing (B ⧸ J.map (algebraMap A B)) :=
    (isRegularLocalRing_quotient_map_iff_mem_regularLocus J q hJq B).mpr (by
      have := Ideal.isPrime_map_quotientMk_of_isPrime hJq
      exact IsRegularRing.isRegularLocalRing_localization (q.asIdeal.map (Ideal.Quotient.mk J)))
  rw [hmapJ] at hreg'
  apply rsop_extends_of_quotient_regular
  · intro k hk
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hk
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff B q.asIdeal (v i)).mpr (hFq i hi)
  · have h1 := ringKrullDim_quotient_add_le_of_le_height (J.map (algebraMap A B)) F.card
      (fun P hP hJP => le_height_of_isPrime_of_le_height_map p.asIdeal Bp J hJp F.card hht
        q.asIdeal B P hJP)
    rw [hmapJ] at h1
    refine le_trans ?_ h1
    gcongr
    exact_mod_cast Finset.card_image_le

/-- Associated generators generate the same ideal. -/
theorem Ideal.span_eq_span_image_of_associated {R : Type*} [CommRing R] (T : Set R)
    (g : R → R) (hg : ∀ a ∈ T, Associated a (g a)) : Ideal.span T = Ideal.span (g '' T) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    intro a ha
    obtain ⟨c, hc⟩ := hg a ha
    have : a = g a * ↑c⁻¹ := by rw [← hc, mul_assoc, Units.mul_inv, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨a, ha, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨c, hc⟩ := hg a ha
    rw [← hc]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ha)

end NCOpenAlgebra

namespace Subscheme

variable {X : Scheme.{u}}

open Classical

/-- The points `hV.fromSpec q` of an affine open `V` lie in `V`. -/
theorem _root_.AlgebraicGeometry.IsAffineOpen.fromSpec_mem {V : X.Opens} (hV : IsAffineOpen V) (q : PrimeSpectrum Γ(X, V)) :
    hV.fromSpec q ∈ V := by
  rw [← SetLike.mem_coe, ← hV.range_fromSpec]; exact ⟨q, rfl⟩

/-- The end of the proof of Lemma 1 (p. 277), after "we may assume that": given `Spec(A) = V`, the
prime `P` of `x`, a regular system of parameters `z` of `A_P` (with `z_j` represented by `f a ∈ A`),
the subsystem `t ⊆ z` generating the ideal of `D` at `x` (`(z₁, …, z_s)`), and

* (1) for every subsystem `G` of `z ∖ t` (the paper's `(z_{i₁}, …, z_{i_t})`), the ideal
  `(t ∪ G)A` is prime and `A/(t ∪ G)A` is a regular ring (`h1`);
* (2) the ideal of `D` in `A` is `(z₁, …, z_s)A` (`h2`; its primality and the regularity of the
  quotient are (1) for `G = ∅`);
* (3) every irreducible component of `E` meeting `Spec(A)` (a minimal prime of the ideal of `E` in
  `A`) is cut out by one `z_j` (`h3`; "`Spec(A)` has empty intersection with any of the `E_j` which
  does not pass through `x`", together with the ideal `(z_j)A` of each `E_j` through `x`),

then "if `y` is any point of `Spec(A) ∩ W` and if `Q` denotes the prime ideal of `y` in `A`, then by
(1) the subsystem of `(z₁, …, z_r)` consisting of those `z_j` contained in `Q` can be extended to a
regular system of parameters of the local ring `A_Q` of `X` at `y`, so that, by (2) and (3), `W` has
only normal crossings with `⋃ E_j` at `y`".  The extension "by (1)" is
`extendsToRSOP_image_of_isPrime`; the subsystem contains `t` because `y ∈ D`. -/
@[blueprint "lem:normal-crossings-open-shrunk"
  (statement := /-- Let $X$ be a non-singular algebraic scheme, $E,D$ subschemes of $X$,
    $\operatorname{Spec}(A)\subseteq X$ an affine open subscheme, $P$ the prime ideal of $A$ of a
    point $x$, $(z_1,\dots,z_r)$ a regular system of parameters of $A_P$ represented by elements of
    $A$, and $(z_1,\dots,z_s)$ a subsystem generating the ideal of $D$ in $A_P$. Assume:
    (1) for every subsystem $(z_{i_1},\dots,z_{i_t})$ of $(z_{s+1},\dots,z_r)$,
    $(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A$ is a prime ideal in $A$ and
    $A/(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A$ is a regular ring; (2) the ideal of $D$ in $A$ is
    $(z_1,\dots,z_s)A$; (3) every irreducible component of $E$ meeting $\operatorname{Spec}(A)$ has
    ideal $(z_j)A$ in $A$ for some $j$. Then $E$ has only normal crossings with $D$ at every point
    of $\operatorname{Spec}(A)\cap D$. (The end of the proof of Lemma~1, p.~277.) -/)
  (proof := /-- Let $y$ be a point of $\operatorname{Spec}(A)\cap D$ and $Q$ its prime ideal in $A$.
    Since $y\in D$, $Q$ contains the ideal $(z_1,\dots,z_s)A$ of $D$ by (2). Let $G$ be the set of
    $z_j$ contained in $Q$; it contains $z_1,\dots,z_s$. By (1), applied to $G\setminus\{z_1,\dots,z_s\}$,
    the ideal $GA$ is prime and $A/GA$ is regular, so by \cref{lem:normal-crossings-open-extend}
    the subsystem $G$ can be extended to a regular system of parameters $w$ of the local ring
    $A_Q$. Every irreducible component of $E$ through $y$ has its ideal in $A_Q$ generated by some
    $z_j$ by (3), and $z_j\in Q$, so this ideal is generated by a member of $w$; the ideal of $D$
    in $A_Q$ is generated by $z_1,\dots,z_s\in w$ by (2). -/)
  (latexEnv := "lemma")]
theorem hasOnlyNormalCrossingsWithAt_of_prime_system (hX : X.IsNonsingular) (E D : Subscheme X)
    {V : X.Opens} (hV : IsAffineOpen V) (x : X) (hxV : x ∈ V) (p : PrimeSpectrum Γ(X, V))
    (hpx : hV.fromSpec p = x)
    (z t : Finset (X.presheaf.stalk x))
    (hz : IsRegularSystemOfParameters (X.presheaf.stalk x) z) (htz : t ⊆ z)
    (f : X.presheaf.stalk x → Γ(X, V))
    (hassoc : ∀ a ∈ z, Associated a ((X.presheaf.germ V x hxV).hom (f a)))
    (h1 : ∀ G ∈ (z \ t).powerset,
      (Ideal.span (f '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _))).IsPrime ∧
        IsRegularRing (Γ(X, V) ⧸ Ideal.span (f '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _))))
    (h2 : D.ideal ⟨V, hV⟩ = Ideal.span (f '' (t : Set (X.presheaf.stalk x))))
    (h3 : ∀ r ∈ (E.ideal ⟨V, hV⟩).minimalPrimes, ∃ a ∈ z, r = Ideal.span {f a}) :
    ∀ q : PrimeSpectrum Γ(X, V), hV.fromSpec q ∈ D.pts →
      E.HasOnlyNormalCrossingsWithAt D (hV.fromSpec q) := by
  classical
  subst hpx
  let _ : Algebra Γ(X, V) (X.presheaf.stalk (hV.fromSpec p)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hV.fromSpec p, hxV⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk (hV.fromSpec p)) p.asIdeal :=
    hV.isLocalization_stalk' p hxV
  have : IsRegularLocalRing (X.presheaf.stalk (hV.fromSpec p)) := hX _
  have hind : RSOPIndep z
      (fun a => algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec p)) (f a)) := by
    have h0 : RSOPIndep z (fun a : X.presheaf.stalk (hV.fromSpec p) => a) :=
      RSOPIndep.of_extends (Set.injOn_id _)
        (by rw [Finset.image_id']; exact ExtendsToRSOP.of_isRegularSystemOfParameters hz)
    exact h0.of_associated fun a ha => hassoc a ha
  obtain ⟨hinjz, hextz⟩ := hind.injOn_and_extends
  intro q hyD
  have hqV : hV.fromSpec q ∈ V := hV.fromSpec_mem q
  let _ : Algebra Γ(X, V) (X.presheaf.stalk (hV.fromSpec q)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hV.fromSpec q, hqV⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk (hV.fromSpec q)) q.asIdeal :=
    hV.isLocalization_stalk' q hqV
  have : IsRegularLocalRing (X.presheaf.stalk (hV.fromSpec q)) := hX _
  have hprimeOf : hV.primeIdealOf ⟨hV.fromSpec q, hqV⟩ = q :=
    hV.fromSpec.isOpenEmbedding.injective (hV.fromSpec_primeIdealOf ⟨_, hqV⟩)
  have hmemq : ∀ c : Γ(X, V), algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec q)) c ∈
      maximalIdeal (X.presheaf.stalk (hV.fromSpec q)) ↔ c ∈ q.asIdeal :=
    fun c => IsLocalization.AtPrime.to_map_mem_maximal_iff _ q.asIdeal c
  -- `D(V) = (z_1, …, z_s)A ⊆ Q`
  have hDq : D.ideal ⟨V, hV⟩ ≤ q.asIdeal := (compStalk_fromSpec_mem_pts_iff D hV q).mp hyD
  rw [h2] at hDq
  -- "the subsystem of `(z_1, …, z_r)` consisting of those `z_j` contained in `Q`"
  set Gq : Finset (X.presheaf.stalk (hV.fromSpec p)) := z.filter fun a => f a ∈ q.asIdeal with hGq
  have htGq : t ⊆ Gq := fun a ha =>
    Finset.mem_filter.mpr ⟨htz ha, hDq (Ideal.subset_span ⟨a, ha, rfl⟩)⟩
  have hGqz : Gq ⊆ z := Finset.filter_subset _ _
  -- "by (1) … can be extended to a regular system of parameters of the local ring `A_Q`"
  obtain ⟨hprime, hreg⟩ := h1 (Gq \ t) (Finset.mem_powerset.mpr
    (Finset.sdiff_subset_sdiff hGqz subset_rfl))
  rw [Finset.union_sdiff_of_subset htGq] at hprime hreg
  obtain ⟨w, hGw, hw⟩ := extendsToRSOP_image_of_isPrime p
    (X.presheaf.stalk (hV.fromSpec p)) Gq f (hinjz.mono hGqz)
    (hextz.mono (Finset.image_subset_image hGqz)) hprime hreg q
    (fun i hi => (Finset.mem_filter.mp hi).2) (X.presheaf.stalk (hV.fromSpec q))
  refine ⟨w, hw, ?_, ?_⟩
  · intro C hC hyC
    obtain ⟨r, hr, hrq, rfl⟩ := compStalk_exists_prime E hV hqV hC hyC
    rw [hprimeOf] at hrq
    obtain ⟨a, haz, hra⟩ := h3 r.asIdeal hr
    have hCy : (ofClosed ⟨closure {hV.fromSpec r}, isClosed_closure⟩).stalkIdeal
        (hV.fromSpec q) =
          Ideal.span {algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec q)) (f a)} := by
      rw [compStalk_stalkIdeal_ofClosed_closure hV hqV r]
      change r.asIdeal.map (algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec q))) = _
      rw [hra, Ideal.map_span, Set.image_singleton]
    refine ⟨algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec q)) (f a), hGw ?_, hCy⟩
    have hfa : f a ∈ q.asIdeal := hrq (hra ▸ Ideal.mem_span_singleton_self _)
    exact Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨haz, hfa⟩)
  · have hDy : D.stalkIdeal (hV.fromSpec q) =
        (Ideal.span (f '' (t : Set (X.presheaf.stalk (hV.fromSpec p))))).map
          (algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec q))) := by
      rw [stalkIdeal_eq_map_germ_affine D ⟨V, hV⟩ hqV]
      exact congrArg _ h2
    refine ⟨t.image (fun i => algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec q)) (f i)),
      ?_, ?_⟩
    · intro b hb
      obtain ⟨a, hat, rfl⟩ := Finset.mem_image.mp hb
      apply hGw
      exact Finset.mem_image_of_mem _ (htGq hat)
    · rw [hDy, Ideal.map_span, Finset.coe_image, ← Set.image_comp]
      rfl

/-- The stalk at a point `y ∈ V` of an affine open `V`, with the algebra structure given by the germ,
is the localization of `Γ(X, V)` at the prime of `y` (`IsAffineOpen.isLocalization_stalk` for a point
given by `y` and `hy`). -/
theorem _root_.AlgebraicGeometry.IsAffineOpen.isLocalization_stalk_of_mem {V : X.Opens} (hV : IsAffineOpen V) (y : X) (hy : y ∈ V) :
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨y, hy⟩ : V)
    IsLocalization.AtPrime (X.presheaf.stalk y) (hV.primeIdealOf ⟨y, hy⟩).asIdeal :=
  hV.isLocalization_stalk ⟨y, hy⟩

/-- The ideal `J Γ(X, V)` obtained from an ideal `J` of `Γ(X, V₀)` (`V ≤ V₀`) has the same germs at
every point of `V` as `J`. -/
theorem map_map_germ_eq {V₀ V : X.Opens} (hle : V ≤ V₀) (J : Ideal Γ(X, V₀)) (y : X)
    (hy : y ∈ V) :
    (J.map (X.presheaf.map (homOfLE hle).op).hom).map (X.presheaf.germ V y hy).hom =
      J.map (X.presheaf.germ V₀ y (hle hy)).hom := by
  rw [Ideal.map_map]
  congr 1
  ext a
  exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hle) y hy a

/-- "Replacing `A` by `A_f`": two ideals of `Γ(X, V₀)` have the same extension to the affine open
`V ≤ V₀` as soon as they have the same germs at every point of `V` (an ideal of an affine ring is
determined by its stalks, `IsAffineOpen.ideal_ext_iff`). -/
theorem map_eq_map_of_forall_germ {V₀ V : X.Opens} (hV : IsAffineOpen V) (hle : V ≤ V₀)
    (J₁ J₂ : Ideal Γ(X, V₀))
    (h : ∀ (y : X) (hy : y ∈ V), J₁.map (X.presheaf.germ V₀ y (hle hy)).hom =
      J₂.map (X.presheaf.germ V₀ y (hle hy)).hom) :
    J₁.map (X.presheaf.map (homOfLE hle).op).hom = J₂.map (X.presheaf.map (homOfLE hle).op).hom :=
  hV.ideal_ext_iff.mpr fun y hy => by rw [map_map_germ_eq, map_map_germ_eq]; exact h y hy

/-- The sheaf of ideals of `D` on a basic open `D(f₀)` of an affine open `V₀` is the extension to
`A_{f₀} = Γ(X, D(f₀))` of its ideal on `V₀` (quasi-coherence, `Scheme.IdealSheafData.map_ideal_basicOpen`). -/
theorem ideal_eq_map_of_eq_basicOpen (D : Subscheme X) {V₀ : X.Opens} (hV₀ : IsAffineOpen V₀)
    (f₀ : Γ(X, V₀)) {V : X.Opens} (hV : IsAffineOpen V) (hVdef : V = X.basicOpen f₀)
    (hle : V ≤ V₀) :
    D.ideal ⟨V, hV⟩ = (D.ideal ⟨V₀, hV₀⟩).map (X.presheaf.map (homOfLE hle).op).hom := by
  subst hVdef
  exact (D.map_ideal_basicOpen ⟨V₀, hV₀⟩ f₀).symm

/-- "By replacing `A` by `A_f` with a suitable `f ∈ A − P`, so that `Spec(A_f)` is an affine open
subscheme of `X` containing the given point `x`, we may assume that (1), (2), (3)" (p. 277), together
with the choices that precede it ("Let `Spec(A)` be an affine open subscheme of `X` which contains
the given point `x` … We have a regular system of parameters `(z₁, …, z_r)` of `A_P` such that …").

For `E` and `D` with only normal crossings at `x` (Def. 2: the regular system of parameters `z` of
`O_{X,x}`, the subsystem `t ⊆ z` generating the ideal of `D` at `x`), there are an affine open
`V = Spec A ∋ x` and sections `f a ∈ A` (`a ∈ z`, associated to `a` in `A_P`) such that:
* (1) for every subsystem `G` of `z ∖ t`, `(t ∪ G)A` is a prime ideal of `A` and `A/(t ∪ G)A` is a
  regular ring;
* (2) the ideal of `D` in `A` is `(z₁, …, z_s)A` (`t = {z₁, …, z_s}`), obtained by finite generation
  of ideals (this is the step that makes the lemma valid for arbitrary `D`); and the components of
  `D` meeting `Spec(A)` all pass through `x` (the ingredient of "`Spec(A) ∩ W` is irreducible" that
  `ideal_eq_span_of_isReduced` uses for reduced `D`, as printed);
* (3) every irreducible component of `E` meeting `Spec(A)` (a minimal prime of the ideal of `E` in
  `A`) is cut out by one `z_j`: "`Spec(A)` has empty intersection with any of the `E_j` which does
  not pass through `x`", together with the ideal `(z_j)A` of each `E_j` through `x` in `A`.

The proof: each of the finitely many conditions holds near `p` in `Spec A₀` (`A₀ = Γ(X, V₀)`,
`V₀ ∋ x` affine, of finite type over a base ring `S ∈ 𝔅`); a basic open `D(f₀) ∋ p` lies in all of them;
`V = D(f₀)`, `A = (A₀)_{f₀}` (`IsLocalization.Away`).  Equalities of ideals of `A` are checked
stalkwise (`map_eq_map_of_forall_germ`).  The openness of the regular locus ((iii) of p. 161,
`eventually_isRegularLocalRing_quotient_map`) is the only cited input. -/
@[blueprint "lem:normal-crossings-open-replace"
  (statement := /-- Let $X$ be a non-singular algebraic scheme and $E$, $D$ subschemes of $X$ such
    that $E$ has only normal crossings with $D$ at $x$, with regular system of parameters
    $(z_1,\dots,z_r)$ of $\mathcal O_{X,x}$ and $(z_1,\dots,z_s)$ generating the ideal of $D$ at
    $x$. Then there is an affine open subscheme $\operatorname{Spec}(A)\ni x$ of $X$ and elements
    of $A$, representing the $z_j$ up to units of $\mathcal O_{X,x}$, such that:
    (1) for every subsystem $(z_{i_1},\dots,z_{i_t})$ of $(z_{s+1},\dots,z_r)$,
    $(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A$ is a prime ideal in $A$ and
    $A/(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A$ is a regular ring; (2) the ideal of $D$ in $A$ is
    $(z_1,\dots,z_s)A$, and every irreducible component of $D$ meeting $\operatorname{Spec}(A)$
    passes through $x$; (3) every irreducible component of $E$ meeting $\operatorname{Spec}(A)$ has
    ideal $(z_j)A$ in $A$ for some $j$. (The step ``By replacing $A$ by $A_f$ with a suitable
    $f\in A-P$ \dots\ we may assume that'' of the proof of Lemma~1, p.~277.) -/)
  (proof := /-- Let $\operatorname{Spec}(A_0)\ni x$ be an affine open subscheme, $A_0$ of finite
    type over a base ring of $X$, $P$ the prime of $x$, and represent the $z_j$ by elements $f_j$ of
    $A_0$. Each of the following holds on a neighbourhood of $P$ in $\operatorname{Spec}A_0$; a basic
    open $D(f)\ni P$ lies in all of them and $A=(A_0)_f$. (1): the ideal
    $I_G=(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A_0$ has the same localizations near $P$ as the prime
    $I_G(A_0)_P\cap A_0$ (finitely generated ideals that agree at $P$ agree nearby), which is
    disjoint from the powers of $f$, so $I_GA$ is prime; and $A_0/I_G$ is regular near $P$ by the
    openness of the regular locus (\cref{prop:class-A-iii}), so $A/I_GA$ is a regular ring. (2): the
    ideal of $D$ in $(A_0)_P$ is $(z_1,\dots,z_s)(A_0)_P$, so the two ideals agree in $A_f$ for
    suitable $f$; the minimal primes of the ideal of $D$ in $A_0$ not contained in $P$ are avoided
    by $D(f)$. (3): likewise for the minimal primes of the ideal of $E$ in $A_0$, those contained
    in $P$ having ideal $(z_j)$ at $P$, hence in $A_f$. \textbf{Gaps filled.} The $z_j$ are
    tacitly elements of $A$; the paper does not argue that the replacement achieves (1)--(3); the
    ideal of each $E_j$ through $x$ in $A$ is $(z_j)A$. -/)
  (latexEnv := "lemma")]
theorem exists_isAffineOpen_prime_system [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [IsAlgebraicScheme X] (hX : X.IsNonsingular)
    (E D : Subscheme X) (x : X) (h : E.HasOnlyNormalCrossingsWithAt D x) :
    ∃ (z t : Finset (X.presheaf.stalk x)) (V : X.Opens) (hV : IsAffineOpen V) (hxV : x ∈ V)
      (f : X.presheaf.stalk x → Γ(X, V)),
      IsRegularSystemOfParameters (X.presheaf.stalk x) z ∧ t ⊆ z ∧
      D.stalkIdeal x = Ideal.span (t : Set (X.presheaf.stalk x)) ∧
      (∀ a ∈ z, Associated a ((X.presheaf.germ V x hxV).hom (f a))) ∧
      (∀ G ∈ (z \ t).powerset,
        (Ideal.span (f '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _))).IsPrime ∧
          IsRegularRing
            (Γ(X, V) ⧸ Ideal.span (f '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _)))) ∧
      D.ideal ⟨V, hV⟩ = Ideal.span (f '' (t : Set (X.presheaf.stalk x))) ∧
      (∀ r ∈ (E.ideal ⟨V, hV⟩).minimalPrimes, ∃ a ∈ z, r = Ideal.span {f a}) ∧
      (∀ r ∈ (D.ideal ⟨V, hV⟩).minimalPrimes, r ≤ (hV.primeIdealOf ⟨x, hxV⟩).asIdeal) := by
  classical
  obtain ⟨z, hz, hcomp, t, htz, hDt⟩ := h
  -- an affine open `V₀ ∋ x`, with ring `A₀ = Γ(X, V₀)` of finite type over a base ring `S ∈ 𝔅`
  obtain ⟨⟨V₀, hV₀⟩, hxV₀⟩ := exists_affineOpen_mem x
  replace hxV₀ : x ∈ V₀ := hxV₀
  replace hV₀ : IsAffineOpen V₀ := hV₀
  obtain ⟨S, i1, i2, i3, π, hπ, -⟩ := IsAlgebraicScheme.exists_base (X := X)
  let φ : S →+* Γ(X, V₀) :=
    (π.appLE ⊤ V₀ le_top).hom.comp (Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom
  let : Algebra S Γ(X, V₀) := φ.toAlgebra
  have hφ : φ.FiniteType := by
    refine RingHom.FiniteType.comp ?_ (RingHom.FiniteType.of_surjective _ ?_)
    · exact HasRingHomProperty.appLE @LocallyOfFiniteType π hπ
        ⟨⊤, isAffineOpen_top _⟩ ⟨V₀, hV₀⟩ le_top
    · exact (Scheme.ΓSpecIso (CommRingCat.of S)).commRingCatIsoToRingEquiv.symm.surjective
  have : Algebra.FiniteType S Γ(X, V₀) := hφ
  have : IsNoetherianRing Γ(X, V₀) := Algebra.FiniteType.isNoetherianRing S _
  -- `x` is the point of `V₀` given by the prime `p` of `A₀`; `O_{X,x} = (A₀)_p`
  set p := hV₀.primeIdealOf ⟨x, hxV₀⟩ with hpdef
  have hpx : hV₀.fromSpec p = x := hV₀.fromSpec_primeIdealOf ⟨x, hxV₀⟩
  let _ : Algebra Γ(X, V₀) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV₀⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal :=
    hV₀.isLocalization_stalk ⟨x, hxV₀⟩
  have : IsRegularLocalRing (X.presheaf.stalk x) := hX _
  -- the members `a` of `z` are, up to units, germs of sections `f a` over `V₀`
  choose g hg using fun a : X.presheaf.stalk x => IsLocalization.surj p.asIdeal.primeCompl a
  set f : X.presheaf.stalk x → Γ(X, V₀) := fun a => (g a).1 with hf
  have hassoc : ∀ a : X.presheaf.stalk x,
      Associated a (algebraMap Γ(X, V₀) (X.presheaf.stalk x) (f a)) := fun a =>
    ⟨(IsLocalization.map_units (X.presheaf.stalk x) (g a).2).unit, by
      rw [IsUnit.unit_spec]; exact hg a⟩
  have hind : RSOPIndep z (fun a => algebraMap Γ(X, V₀) (X.presheaf.stalk x) (f a)) := by
    have h0 : RSOPIndep z (fun a : X.presheaf.stalk x => a) :=
      RSOPIndep.of_extends (Set.injOn_id _)
        (by rw [Finset.image_id']; exact ExtendsToRSOP.of_isRegularSystemOfParameters hz)
    exact h0.of_associated fun a _ => hassoc a
  obtain ⟨hinjz, hextz⟩ := hind.injOn_and_extends
  -- the ideals `I_G = (z_1, …, z_s, z_{i_1}, …, z_{i_t})`, `G` a subsystem of `(z_{s+1}, …, z_r)`
  let I : Finset (X.presheaf.stalk x) → Ideal Γ(X, V₀) := fun G => Ideal.span (f '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set (X.presheaf.stalk x)))
  have hIext : ∀ G ∈ (z \ t).powerset,
      ExtendsToRSOP (X.presheaf.stalk x) ((t ∪ G).image fun a => algebraMap Γ(X, V₀) (X.presheaf.stalk x) (f a)) := fun G hG =>
    hextz.mono (Finset.image_subset_image (Finset.union_subset htz
      (Finset.subset_sdiff.mp (Finset.mem_powerset.mp hG)).1))
  have hImap : ∀ G, (I G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) =
      Ideal.span (((t ∪ G).image fun a => algebraMap Γ(X, V₀) (X.presheaf.stalk x) (f a) : Finset (X.presheaf.stalk x)) : Set (X.presheaf.stalk x)) := by
    intro G
    rw [Ideal.map_span, Finset.coe_image, ← Set.image_comp]
    rfl
  let 𝔭 : Finset (X.presheaf.stalk x) → Ideal Γ(X, V₀) := fun G =>
    ((I G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x))).comap (algebraMap Γ(X, V₀) (X.presheaf.stalk x))
  have h𝔭prime : ∀ G ∈ (z \ t).powerset, (𝔭 G).IsPrime := fun G hG => by
    have := (hIext G hG).isPrime_span
    rw [← hImap] at this
    exact Ideal.comap_isPrime _ _
  have hI𝔭 : ∀ G, I G ≤ 𝔭 G := fun G a ha => Ideal.mem_map_of_mem _ ha
  have h𝔭p : ∀ G ∈ (z \ t).powerset, 𝔭 G ≤ p.asIdeal := fun G hG a ha => by
    have h1 : algebraMap Γ(X, V₀) (X.presheaf.stalk x) a ∈ (I G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) := ha
    rw [hImap] at h1
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) p.asIdeal a).mp ?_
    exact (Ideal.span_le.mpr fun b hb => (hIext G hG).mem_maximalIdeal hb) h1
  have hmapeq : ∀ G, (I G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) = (𝔭 G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) :=
    fun G => (IsLocalization.map_under p.asIdeal.primeCompl (X.presheaf.stalk x) _).symm
  have hIp : ∀ G ∈ (z \ t).powerset, I G ≤ p.asIdeal := fun G hG =>
    (hI𝔭 G).trans (h𝔭p G hG)
  -- (1): near `x`, `I_G` and the prime `𝔭_G` have the same stalks, and `A/I_G` is regular
  have hevA : ∀ᶠ q in 𝓝 p, ∀ G ∈ (z \ t).powerset,
      (∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B] [IsLocalization.AtPrime B q.asIdeal],
        (I G).map (algebraMap Γ(X, V₀) B) = (𝔭 G).map (algebraMap Γ(X, V₀) B)) ∧
      (I G ≤ q.asIdeal → ∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B]
        [IsLocalization.AtPrime B q.asIdeal],
          IsRegularLocalRing (B ⧸ (I G).map (algebraMap Γ(X, V₀) B))) := by
    rw [Filter.eventually_all_finset]
    intro G hG
    have hreg : IsRegularLocalRing ((X.presheaf.stalk x) ⧸ (I G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x))) := by
      rw [hImap]; exact (hIext G hG).isRegularLocalRing_quotient
    filter_upwards [eventually_map_le_map_of_map_le p (X.presheaf.stalk x) _ _ (hmapeq G).le,
      eventually_map_le_map_of_map_le p (X.presheaf.stalk x) _ _ (hmapeq G).ge,
      eventually_isRegularLocalRing_quotient_map (S := S) (I G) p (X.presheaf.stalk x) (hIp G hG) hreg]
      with q h1 h2 h3
    exact ⟨fun B _ _ _ => le_antisymm (h1 B) (h2 B), fun hq B _ _ _ => h3 hq B⟩
  -- (2): near `x`, the ideal of `D` is generated by `z_1, …, z_s`
  have hDx : (D.ideal ⟨V₀, hV₀⟩).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) =
      (Ideal.span (f '' (t : Set (X.presheaf.stalk x)))).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) := by
    have h1 := stalkIdeal_eq_map_germ_affine D ⟨V₀, hV₀⟩ hxV₀
    change D.stalkIdeal _ = (D.ideal ⟨V₀, hV₀⟩).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) at h1
    rw [← h1, hDt, Ideal.map_span, ← Set.image_comp]
    exact Ideal.span_eq_span_image_of_associated _ _ fun a _ => hassoc a
  have hevD : ∀ᶠ q in 𝓝 p, ∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B]
      [IsLocalization.AtPrime B q.asIdeal], (D.ideal ⟨V₀, hV₀⟩).map (algebraMap Γ(X, V₀) B) =
        (Ideal.span (f '' (t : Set (X.presheaf.stalk x)))).map (algebraMap Γ(X, V₀) B) := by
    filter_upwards [eventually_map_le_map_of_map_le p (X.presheaf.stalk x) _ _ hDx.le,
      eventually_map_le_map_of_map_le p (X.presheaf.stalk x) _ _ hDx.ge] with q h1 h2 B _ _ _
    exact le_antisymm (h1 B) (h2 B)
  -- (3): the components of `E` through `x` have ideal `(z_j)` near `x`; the others are avoided
  have hcompE : ∀ r ∈ (E.ideal ⟨V₀, hV₀⟩).minimalPrimes, ∃ a : (X.presheaf.stalk x), r ≤ p.asIdeal → a ∈ z ∧
      r.map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) = (Ideal.span {f a}).map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) := by
    intro r hr
    by_cases hrp : r ≤ p.asIdeal
    · have hrprime : r.IsPrime := hr.1.1
      let r' : PrimeSpectrum Γ(X, V₀) := ⟨r, hrprime⟩
      have hC := compStalk_ofClosed_mem_irreducibleComponents E hV₀ (q := r') hr
      have hxC : hV₀.fromSpec p ∈
          (ofClosed ⟨closure {hV₀.fromSpec r'}, isClosed_closure⟩).pts := by
        rw [pts_ofClosed]
        show hV₀.fromSpec p ∈ closure {hV₀.fromSpec r'}
        exact specializes_iff_mem_closure.mp
          ((compStalk_fromSpec_specializes_iff hV₀ r' p).mpr hrp)
      rw [hpx] at hxC
      obtain ⟨a, haz, ha⟩ := hcomp _ hC hxC
      rw [compStalk_stalkIdeal_ofClosed_closure hV₀ hxV₀ r'] at ha
      refine ⟨a, fun _ => ⟨haz, ?_⟩⟩
      change r.map (algebraMap Γ(X, V₀) (X.presheaf.stalk x)) = _ at ha
      rw [ha, Ideal.map_span, Set.image_singleton]
      have := Ideal.span_eq_span_image_of_associated {a}
        (fun b => algebraMap Γ(X, V₀) (X.presheaf.stalk x) (f b))
        (fun b hb => by rw [Set.mem_singleton_iff.mp hb]; exact hassoc a)
      rwa [Set.image_singleton] at this
    · exact ⟨0, fun h => absurd h hrp⟩
  choose! a ha using hcompE
  have hevE : ∀ᶠ q in 𝓝 p, ∀ r ∈ (E.ideal ⟨V₀, hV₀⟩).minimalPrimes,
      (r ≤ p.asIdeal → ∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B]
        [IsLocalization.AtPrime B q.asIdeal],
          r.map (algebraMap Γ(X, V₀) B) = (Ideal.span {f (a r)}).map (algebraMap Γ(X, V₀) B)) ∧
      (¬ r ≤ p.asIdeal → ¬ r ≤ q.asIdeal) := by
    refine (Filter.eventually_all_finite
      (Ideal.finite_minimalPrimes_of_isNoetherianRing _ _)).mpr fun r hr => ?_
    by_cases hrp : r ≤ p.asIdeal
    · have hmap := (ha r hr hrp).2
      filter_upwards [eventually_map_le_map_of_map_le p (X.presheaf.stalk x) _ _ hmap.le,
        eventually_map_le_map_of_map_le p (X.presheaf.stalk x) _ _ hmap.ge] with q h1 h2
      exact ⟨fun _ B _ _ _ => le_antisymm (h1 B) (h2 B), fun h => absurd hrp h⟩
    · obtain ⟨b, hbr, hbp⟩ := Set.not_subset.mp hrp
      refine Filter.eventually_of_mem ((PrimeSpectrum.basicOpen b).isOpen.mem_nhds hbp) ?_
      intro q hq
      exact ⟨fun h => absurd h hrp, fun _ hrq => absurd (hrq hbr) hq⟩
  -- the components of `D` not through `x` are avoided near `x`
  have hevDm : ∀ᶠ q in 𝓝 p, ∀ r ∈ (D.ideal ⟨V₀, hV₀⟩).minimalPrimes,
      ¬ r ≤ p.asIdeal → ¬ r ≤ q.asIdeal := by
    refine (Filter.eventually_all_finite
      (Ideal.finite_minimalPrimes_of_isNoetherianRing _ _)).mpr fun r hr => ?_
    by_cases hrp : r ≤ p.asIdeal
    · exact Filter.Eventually.of_forall fun _ h => absurd hrp h
    · obtain ⟨b, hbr, hbp⟩ := Set.not_subset.mp hrp
      refine Filter.eventually_of_mem ((PrimeSpectrum.basicOpen b).isOpen.mem_nhds hbp) ?_
      intro q hq _ hrq
      exact absurd (hrq hbr) hq
  -- "By replacing `A` by `A_f` with a suitable `f ∈ A - P`": a basic open `D(f₀) ∋ p` on which
  -- all of these hold
  obtain ⟨f₀, hf₀p, hf₀⟩ : ∃ f₀ : Γ(X, V₀), f₀ ∉ p.asIdeal ∧ ∀ q : PrimeSpectrum Γ(X, V₀),
      f₀ ∉ q.asIdeal →
        (∀ G ∈ (z \ t).powerset,
          (∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B]
            [IsLocalization.AtPrime B q.asIdeal],
              (I G).map (algebraMap Γ(X, V₀) B) = (𝔭 G).map (algebraMap Γ(X, V₀) B)) ∧
          (I G ≤ q.asIdeal → ∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B]
            [IsLocalization.AtPrime B q.asIdeal],
              IsRegularLocalRing (B ⧸ (I G).map (algebraMap Γ(X, V₀) B)))) ∧
        (∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B] [IsLocalization.AtPrime B q.asIdeal],
          (D.ideal ⟨V₀, hV₀⟩).map (algebraMap Γ(X, V₀) B) =
            (Ideal.span (f '' (t : Set (X.presheaf.stalk x)))).map (algebraMap Γ(X, V₀) B)) ∧
        (∀ r ∈ (E.ideal ⟨V₀, hV₀⟩).minimalPrimes,
          (r ≤ p.asIdeal → ∀ (B : Type u) [CommRing B] [Algebra Γ(X, V₀) B]
            [IsLocalization.AtPrime B q.asIdeal],
              r.map (algebraMap Γ(X, V₀) B) =
                (Ideal.span {f (a r)}).map (algebraMap Γ(X, V₀) B)) ∧
          (¬ r ≤ p.asIdeal → ¬ r ≤ q.asIdeal)) ∧
        (∀ r ∈ (D.ideal ⟨V₀, hV₀⟩).minimalPrimes, ¬ r ≤ p.asIdeal → ¬ r ≤ q.asIdeal) := by
    have hev := hevA.and (hevD.and (hevE.and hevDm))
    obtain ⟨T, ⟨f₀, rfl⟩, hpT, hTle⟩ :=
      (PrimeSpectrum.isTopologicalBasis_basic_opens (R := Γ(X, V₀))).mem_nhds_iff.mp hev
    refine ⟨f₀, hpT, fun q hq => ?_⟩
    exact hTle hq
  -- the affine open `Spec(A_{f₀})`, `A = Γ(X, V)`, `V = D(f₀)`
  obtain ⟨V, hVdef⟩ : ∃ V : X.Opens, V = X.basicOpen f₀ := ⟨_, rfl⟩
  have hV : IsAffineOpen V := hVdef ▸ hV₀.basicOpen f₀
  have hle : V ≤ V₀ := hVdef ▸ X.basicOpen_le f₀
  let _ : Algebra Γ(X, V₀) Γ(X, V) := (X.presheaf.map (homOfLE hle).op).hom.toAlgebra
  have hloc : IsLocalization.Away f₀ Γ(X, V) :=
    hV₀.isLocalization_of_eq_basicOpen f₀ (homOfLE hle) hVdef
  have : IsNoetherianRing Γ(X, V) :=
    IsLocalization.isNoetherianRing (Submonoid.powers f₀) _ inferInstance
  -- the points of `V` are the points `y` of `V₀` whose prime does not contain `f₀`
  have hq₀ : ∀ (y : X) (hy : y ∈ V), f₀ ∉ (hV₀.primeIdealOf ⟨y, hle hy⟩).asIdeal := by
    intro y hy hf
    have hu : IsUnit (X.presheaf.germ V₀ y (hle hy) f₀) :=
      (X.mem_basicOpen f₀ y (hle hy)).mp (hVdef ▸ hy)
    let _ : Algebra Γ(X, V₀) (X.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hle hy⟩
    have := hV₀.isLocalization_stalk_of_mem y (hle hy)
    exact (IsLocalRing.mem_maximalIdeal _).mp
      ((IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk y) _ f₀).mpr hf) hu
  have hxV : x ∈ V := by
    rw [hVdef, X.mem_basicOpen f₀ x hxV₀]
    by_contra hnu
    exact hf₀p ((IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) _ f₀).mp
      ((IsLocalRing.mem_maximalIdeal _).mpr hnu))
  -- the sections `f' a = f a|_V`
  set ρ : Γ(X, V₀) →+* Γ(X, V) := algebraMap Γ(X, V₀) Γ(X, V) with hρ
  let f' : X.presheaf.stalk x → Γ(X, V) := fun a => ρ (f a)
  have hgerm : ∀ (y : X) (hy : y ∈ V) (c : Γ(X, V₀)),
      (X.presheaf.germ V y hy).hom (ρ c) = (X.presheaf.germ V₀ y (hle hy)).hom c := fun y hy c =>
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hle) y hy c
  have hspan : ∀ S : Set (X.presheaf.stalk x), Ideal.span (f' '' S) = (Ideal.span (f '' S)).map ρ := by
    intro S
    rw [Ideal.map_span, Set.image_image]
  -- the point `x` of `Spec(A)`
  set p' := hV.primeIdealOf ⟨x, hxV⟩ with hp'def
  have hp'x : hV.fromSpec p' = x := hV.fromSpec_primeIdealOf ⟨x, hxV⟩
  -- at a point `y` of `V`, the stalk is a localization of `A₀` and of `A`; its prime in `A₀`
  -- is a point of `D(f₀)`
  have hgood := fun (y : X) (hy : y ∈ V) => hf₀ _ (hq₀ y hy)
  -- (1): `(z_1, …, z_s, z_{i_1}, …, z_{i_t})A` is prime, and `A/(…)A` is regular
  have h1' : ∀ G ∈ (z \ t).powerset,
      (Ideal.span (f' '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _))).IsPrime ∧
        IsRegularRing (Γ(X, V) ⧸ Ideal.span (f' '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _))) := by
    intro G hG
    -- `I_G A = 𝔭_G A`, the extension of a prime inside `p`
    have hIA : Ideal.span (f' '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _)) =
        (I G).map ρ := hspan _
    have hIG : (I G).map ρ = (𝔭 G).map ρ := by
      refine map_eq_map_of_forall_germ hV hle _ _ fun y hy => ?_
      let _ : Algebra Γ(X, V₀) (X.presheaf.stalk y) :=
        TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hle hy⟩
      have := hV₀.isLocalization_stalk_of_mem y (hle hy)
      exact (hgood y hy).1 G hG |>.1 (X.presheaf.stalk y)
    have hprime : ((𝔭 G).map ρ).IsPrime := by
      have := h𝔭prime G hG
      refine IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f₀) Γ(X, V) (𝔭 G) this ?_
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hn
      exact hf₀p (h𝔭p G hG (this.mem_of_pow_mem n hn))
    refine ⟨by rw [hIA, hIG]; exact hprime, ?_⟩
    -- `A/I_G A` is regular: at a prime `Q ⊇ I_G A`, with `y` the point of `Q`
    rw [isRegularRing_iff]
    intro q' hq'
    let J : Ideal Γ(X, V) := Ideal.span (f' '' ((t ∪ G : Finset (X.presheaf.stalk x)) : Set _))
    let Qp : PrimeSpectrum Γ(X, V) := ⟨q'.comap (Ideal.Quotient.mk J), Ideal.comap_isPrime _ _⟩
    have hQpp : Qp.asIdeal.IsPrime := Qp.isPrime
    have hJQ : J ≤ Qp.asIdeal := fun a ha => by
      show Ideal.Quotient.mk J a ∈ q'
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact zero_mem _
    have hyV : hV.fromSpec Qp ∈ V := hV.fromSpec_mem Qp
    let _ : Algebra Γ(X, V) (X.presheaf.stalk (hV.fromSpec Qp)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hV.fromSpec Qp, hyV⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk (hV.fromSpec Qp)) Qp.asIdeal :=
      hV.isLocalization_stalk' Qp hyV
    let _ : Algebra Γ(X, V₀) (X.presheaf.stalk (hV.fromSpec Qp)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hV.fromSpec Qp, hle hyV⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk (hV.fromSpec Qp))
        (hV₀.primeIdealOf ⟨hV.fromSpec Qp, hle hyV⟩).asIdeal :=
      hV₀.isLocalization_stalk_of_mem (hV.fromSpec Qp) (hle hyV)
    have hIq₀ : I G ≤ (hV₀.primeIdealOf ⟨hV.fromSpec Qp, hle hyV⟩).asIdeal := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨a, ha, rfl⟩
      refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk (hV.fromSpec Qp))
        (hV₀.primeIdealOf ⟨hV.fromSpec Qp, hle hyV⟩).asIdeal (f a)).mp ?_
      have h1 : f' a ∈ Qp.asIdeal := hJQ (Ideal.subset_span ⟨a, ha, rfl⟩)
      have h2 := (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (X.presheaf.stalk (hV.fromSpec Qp)) Qp.asIdeal (f' a)).mpr h1
      rwa [show algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec Qp)) (f' a) =
        algebraMap Γ(X, V₀) (X.presheaf.stalk (hV.fromSpec Qp)) (f a) from
        hgerm _ hyV (f a)] at h2
    have hreg := (hgood _ hyV).1 G hG |>.2 hIq₀ (X.presheaf.stalk (hV.fromSpec Qp))
    have hJmap : J.map (algebraMap Γ(X, V) (X.presheaf.stalk (hV.fromSpec Qp))) =
        (I G).map (algebraMap Γ(X, V₀) (X.presheaf.stalk (hV.fromSpec Qp))) := by
      have hJ' : J = (I G).map ρ := hIA
      rw [hJ']; exact map_map_germ_eq hle (I G) _ hyV
    have hq := (isRegularLocalRing_quotient_map_iff_mem_regularLocus J Qp hJQ
      (X.presheaf.stalk (hV.fromSpec Qp))).mp (hJmap ▸ hreg)
    have hqq : (⟨Qp.asIdeal.map (Ideal.Quotient.mk J),
        Ideal.isPrime_map_quotientMk_of_isPrime hJQ⟩ : PrimeSpectrum (Γ(X, V) ⧸ J)) =
        ⟨q', hq'⟩ :=
      PrimeSpectrum.ext (Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective q')
    rw [hqq] at hq
    exact hq
  -- (2): the ideal of `D` in `A` is `(z_1, …, z_s)A`
  have h2' : D.ideal ⟨V, hV⟩ = Ideal.span (f' '' (t : Set (X.presheaf.stalk x))) := by
    rw [ideal_eq_map_of_eq_basicOpen D hV₀ f₀ hV hVdef hle, hspan]
    refine map_eq_map_of_forall_germ hV hle _ _ fun y hy => ?_
    let _ : Algebra Γ(X, V₀) (X.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hle hy⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk y)
        (hV₀.primeIdealOf ⟨y, hle hy⟩).asIdeal := hV₀.isLocalization_stalk_of_mem y (hle hy)
    exact (hgood y hy).2.1 (X.presheaf.stalk y)
  -- the minimal primes of the ideal of `Z` in `A` are the extensions of those in `A₀` avoiding `f₀`
  have hminV : ∀ (Z : Subscheme X) (r : Ideal Γ(X, V)), r ∈ (Z.ideal ⟨V, hV⟩).minimalPrimes →
      ∃ r₀ ∈ (Z.ideal ⟨V₀, hV₀⟩).minimalPrimes, ∃ _ : r₀.IsPrime, f₀ ∉ r₀ ∧ r = r₀.map ρ := by
    intro Z r hr
    have hrprime : r.IsPrime := hr.1.1
    have hZV : Z.ideal ⟨V, hV⟩ = (Z.ideal ⟨V₀, hV₀⟩).map ρ :=
      ideal_eq_map_of_eq_basicOpen Z hV₀ f₀ hV hVdef hle
    rw [hZV, IsLocalization.minimalPrimes_map (Submonoid.powers f₀) Γ(X, V)] at hr
    obtain ⟨r₀, hr₀def⟩ : ∃ r₀, r₀ = r.under Γ(X, V₀) := ⟨_, rfl⟩
    have hr₀ : r₀ ∈ (Z.ideal ⟨V₀, hV₀⟩).minimalPrimes := hr₀def ▸ hr
    have hr₀prime : r₀.IsPrime := hr₀def ▸ Ideal.IsPrime.comap _
    refine ⟨r₀, hr₀, hr₀prime, fun h => ?_, hr₀def ▸ (IsLocalization.map_under (Submonoid.powers f₀) _ r).symm⟩
    have h' : f₀ ∈ r.under Γ(X, V₀) := hr₀def ▸ h
    exact hrprime.ne_top (Ideal.eq_top_of_isUnit_mem r (show ρ f₀ ∈ r from h')
      (IsLocalization.map_units Γ(X, V) (⟨f₀, Submonoid.mem_powers f₀⟩ : Submonoid.powers f₀)))
  -- (3): every irreducible component of `E` meeting `Spec(A)` passes through `x`, and its ideal
  -- in `A` is generated by the corresponding `z_j`
  have h3' : ∀ r ∈ (E.ideal ⟨V, hV⟩).minimalPrimes, ∃ a ∈ z, r = Ideal.span {f' a} := by
    intro r hr
    obtain ⟨r₀, hr₀, hr₀prime, hf₀r₀, hrr₀⟩ := hminV E r hr
    -- "`Spec(A)` has empty intersection with any of the `E_j` which does not pass through `x`"
    have hr₀p : r₀ ≤ p.asIdeal := by
      by_contra hn
      exact (((hf₀ ⟨r₀, hr₀prime⟩ hf₀r₀).2.2.1 r₀ hr₀).2 hn) le_rfl
    refine ⟨a r₀, (ha r₀ hr₀ hr₀p).1, ?_⟩
    have : r₀.map ρ = (Ideal.span {f (a r₀)}).map ρ := by
      refine map_eq_map_of_forall_germ hV hle _ _ fun y hy => ?_
      let _ : Algebra Γ(X, V₀) (X.presheaf.stalk y) :=
        TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hle hy⟩
      have : IsLocalization.AtPrime (X.presheaf.stalk y)
          (hV₀.primeIdealOf ⟨y, hle hy⟩).asIdeal := hV₀.isLocalization_stalk_of_mem y (hle hy)
      exact (((hgood y hy).2.2.1 r₀ hr₀).1 hr₀p) (X.presheaf.stalk y)
    rw [hrr₀, this, Ideal.map_span, Set.image_singleton]
  -- the components of `D` meeting `Spec(A)` pass through `x`: `Spec(A) ∩ D` is "irreducible"
  have hmin' : ∀ r ∈ (D.ideal ⟨V, hV⟩).minimalPrimes, r ≤ p'.asIdeal := by
    intro r hr
    obtain ⟨r₀, hr₀, hr₀prime, hf₀r₀, hrr₀⟩ := hminV D r hr
    have hr₀p : r₀ ≤ p.asIdeal := by
      by_contra hn
      exact (((hf₀ ⟨r₀, hr₀prime⟩ hf₀r₀).2.2.2) r₀ hr₀ hn) le_rfl
    rw [hrr₀, Ideal.map_le_iff_le_comap]
    intro c hc
    -- `ρ c ∈ p'` since its germ at `x` is the germ of `c`, which lies in the maximal ideal
    let _ : Algebra Γ(X, V) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk x) p'.asIdeal := hV.isLocalization_stalk ⟨x, hxV⟩
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) p'.asIdeal (ρ c)).mp ?_
    have h1 := (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) p.asIdeal c).mpr
      (hr₀p hc)
    rwa [show algebraMap Γ(X, V) (X.presheaf.stalk x) (ρ c) =
      algebraMap Γ(X, V₀) (X.presheaf.stalk x) c from hgerm x hxV c]
  have hassoc' : ∀ a ∈ z, Associated a ((X.presheaf.germ V x hxV).hom (f' a)) := fun a _ => by
    rw [hgerm x hxV (f a)]
    exact hassoc a
  exact ⟨z, t, V, hV, hxV, f', hz, htz, hDt, hassoc', h1', h2', h3', hmin'⟩

/-- Step (2) of the proof of Lemma 1 (p. 277) as printed, for `D = W` reduced: "`Spec(A) ∩ W` is
irreducible (hence, non-singular by (1)), so that `(z₁, …, z_s)A` is the prime ideal of `W` in the
affine ring `A`".

Let `V = Spec A` be affine, `P` the prime of `x`, `t = {z₁, …, z_s}` with `(z₁, …, z_s)A_P` the
prime ideal of `W` in `A_P` and `(z₁, …, z_s)A` prime (this is (1) for the empty subsystem), and
suppose that every component of `W` meeting `Spec(A)` passes through `x` (`Spec(A) ∩ W` is
irreducible).  Since `W` is reduced, the ideal of `W` in `A` is radical, hence the intersection of its
minimal primes.  Each minimal prime `r` of it is contained in `P`, so it is the contraction of `r A_P`,
which contains the ideal of `W` at `x`, i.e. `(z₁, …, z_s)A_P`; so `r` contains `(z₁, …, z_s)A`, a
prime ideal which itself contains the ideal of `W` (its extension to `A_P` equals that of the ideal of
`W`, and both are contained in `P`); by minimality `r = (z₁, …, z_s)A`.  Hence the ideal of `W` in `A`
is `(z₁, …, z_s)A`: this is "both are primes of `A` contained in `P` with the same localization at
`P`". -/
@[blueprint "lem:normal-crossings-open-prime-ideal"
  (statement := /-- Let $\operatorname{Spec}(A)$ be an affine open subscheme of $X$, $P$ the prime of
    a point $x$ of $\operatorname{Spec}(A)$, $W$ a reduced subscheme of $X$ whose ideal in $A_P$ is
    generated by $z_1,\dots,z_s\in A_P$ (part of a regular system of parameters, represented by
    elements of $A$) with $(z_1,\dots,z_s)A$ a prime ideal of $A$, and assume that every irreducible
    component of $W$ meeting $\operatorname{Spec}(A)$ passes through $x$. Then $(z_1,\dots,z_s)A$ is
    the ideal of $W$ in $A$. (Step (2) of the proof of Lemma~1, p.~277.) -/)
  (proof := /-- Since $W$ is reduced, its ideal $\mathfrak w$ in $A$ is radical, hence the
    intersection of its minimal primes. Let $\mathfrak r$ be a minimal prime of $\mathfrak w$;
    $\mathfrak r\subseteq P$ since $\operatorname{Spec}(A)\cap W$ is irreducible through $x$. The ideals
    $\mathfrak w$ and $(z_1,\dots,z_s)A$ have the same extension to $A_P$, namely the ideal of $W$ at
    $x$, and $(z_1,\dots,z_s)A$ is a prime ideal of $A$ contained in $P$; so it is the contraction of
    that extension, whence $\mathfrak w\subseteq(z_1,\dots,z_s)A$, and $\mathfrak r$, which
    contracts from its extension to $A_P$, contains $(z_1,\dots,z_s)A$. By minimality of
    $\mathfrak r$, $\mathfrak r=(z_1,\dots,z_s)A$; hence $\mathfrak w=(z_1,\dots,z_s)A$. -/)
  (latexEnv := "lemma")]
theorem ideal_eq_span_of_isReduced {D : Subscheme X} (hD : D.IsReduced) {V : X.Opens}
    (hV : IsAffineOpen V) (x : X) (hxV : x ∈ V) (t : Finset (X.presheaf.stalk x))
    (f : X.presheaf.stalk x → Γ(X, V))
    (htm : ∀ a ∈ t, a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hDt : D.stalkIdeal x = Ideal.span (t : Set (X.presheaf.stalk x)))
    (hassoc : ∀ a ∈ t, Associated a ((X.presheaf.germ V x hxV).hom (f a)))
    (hprime : (Ideal.span (f '' (t : Set (X.presheaf.stalk x)))).IsPrime)
    (hmin : ∀ r ∈ (D.ideal ⟨V, hV⟩).minimalPrimes, r ≤ (hV.primeIdealOf ⟨x, hxV⟩).asIdeal) :
    D.ideal ⟨V, hV⟩ = Ideal.span (f '' (t : Set (X.presheaf.stalk x))) := by
  classical
  set p := hV.primeIdealOf ⟨x, hxV⟩ with hpdef
  let _ : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal := hV.isLocalization_stalk ⟨x, hxV⟩
  set J := D.ideal ⟨V, hV⟩ with hJdef
  set I₀ := Ideal.span (f '' (t : Set (X.presheaf.stalk x))) with hI₀def
  -- "`W` reduced": the ideal of `W` in `A` is radical
  have hJrad : J.radical = J :=
    congrArg (fun I => Scheme.IdealSheafData.ideal I ⟨V, hV⟩) (radical_eq_self_of_isReduced D hD)
  -- the ideal of `W` and `(z₁, …, z_s)A` have the same extension to `A_P`
  have hJB : J.map (algebraMap Γ(X, V) (X.presheaf.stalk x)) =
      I₀.map (algebraMap Γ(X, V) (X.presheaf.stalk x)) := by
    have h1 := stalkIdeal_eq_map_germ_affine D ⟨V, hV⟩ hxV
    change D.stalkIdeal _ = J.map (algebraMap Γ(X, V) (X.presheaf.stalk x)) at h1
    rw [← h1, hDt, hI₀def, Ideal.map_span, ← Set.image_comp]
    exact Ideal.span_eq_span_image_of_associated _ _ hassoc
  have hI₀p : I₀ ≤ p.asIdeal := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨a, ha, rfl⟩
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) p.asIdeal (f a)).mp ?_
    obtain ⟨u, hu⟩ := hassoc a ha
    have : (X.presheaf.germ V x hxV).hom (f a) = a * ↑u := hu.symm
    show (X.presheaf.germ V x hxV).hom (f a) ∈ _
    rw [this]
    exact Ideal.mul_mem_right _ _ (htm a ha)
  -- primes inside `P` are contracted from their extensions to `A_P`
  have hunder : ∀ q : Ideal Γ(X, V), q.IsPrime → q ≤ p.asIdeal →
      (q.map (algebraMap Γ(X, V) (X.presheaf.stalk x))).comap
        (algebraMap Γ(X, V) (X.presheaf.stalk x)) = q := fun q hq hqp =>
    compStalk_under_map p.asIdeal q hqp
  have hJI₀ : J ≤ I₀ := by
    have h1 : J ≤ (J.map (algebraMap Γ(X, V) (X.presheaf.stalk x))).comap
        (algebraMap Γ(X, V) (X.presheaf.stalk x)) := Ideal.le_comap_map
    rwa [hJB, hunder I₀ hprime hI₀p] at h1
  have hne : J ≠ ⊤ := fun h => hprime.ne_top (top_le_iff.mp (h ▸ hJI₀))
  -- every minimal prime of the ideal of `W` is `(z₁, …, z_s)A`
  have hreq : ∀ r ∈ J.minimalPrimes, r = I₀ := by
    intro r hr
    have hrp := hmin r hr
    have hI₀r : I₀ ≤ r := by
      have h1 : I₀ ≤ (I₀.map (algebraMap Γ(X, V) (X.presheaf.stalk x))).comap
          (algebraMap Γ(X, V) (X.presheaf.stalk x)) := Ideal.le_comap_map
      rw [← hJB] at h1
      refine h1.trans ?_
      calc _ ≤ (r.map (algebraMap Γ(X, V) (X.presheaf.stalk x))).comap
            (algebraMap Γ(X, V) (X.presheaf.stalk x)) :=
            Ideal.comap_mono (Ideal.map_mono hr.1.2)
        _ = r := hunder r hr.1.1 hrp
    exact le_antisymm (hr.2 ⟨hprime, hJI₀⟩ hI₀r) hI₀r
  obtain ⟨r, hr⟩ := Ideal.nonempty_minimalPrimes hne
  rw [← hJrad, ← Ideal.sInf_minimalPrimes]
  refine le_antisymm (sInf_le ((hreq r hr).symm ▸ hr)) (le_sInf fun r' hr' => (hreq r' hr').symm ▸ le_rfl)

/-- Points where `E` fails to have normal crossings with `D` form a closed subset of `D`
(this is the content of Lemma 1, §1, Ch. IV, p. 277, whose last step is proved here as printed, for
arbitrary `E` and `D`; the paper-form statement is `exists_isOpen_hasOnlyNormalCrossingsWithAt_of_isReduced`).

Formalization note: the hypotheses "X non-singular algebraic" are the standing ones of Def. 2
(p. 141) and are needed: on `X = Spec ℚ[y₁, y₂, …]` (not noetherian) the generic point
satisfies the definition with `z = ∅`, `E = ∅`, `D = X`, but no closed point does, since
their maximal ideals are not finitely generated.  Reducedness of `E` and invertibility of its
ideal sheaf are not needed.

Deviation from the paper (statement modified): the paper proves this inside Lemma 1 of Ch. IV
§1 for `E = ⋃ E_j` (reduced, everywhere of codimension one) and `D = W` (reduced); the lemma
here is stated for arbitrary subschemes `E`, `D` (the public statement, used by
`Ch4/ImplicationsAB.lean` and `Ch4/ImplicationsCD.lean`); accordingly, (2) is obtained by finite
generation of ideals (`D` need not be reduced; `exists_isAffineOpen_prime_system`).  The paper's
argument for (2) is `exists_isOpen_hasOnlyNormalCrossingsWithAt_of_isReduced`.  The proof is
that of the paper. -/
@[blueprint "lem:normal-crossings-open"
  (statement := /-- Let $X$ be a non-singular algebraic scheme. If $E$ has only normal
    crossings with $D$ at $x\in D$, then it has only normal crossings with $D$ at every point
    of an open neighbourhood of $x$ in $D$. (Formalization note: ``$X$ non-singular algebraic''
    is the standing hypothesis of Def.~2, p.~141, and the statement is false without it.)
    \textbf{Deviation from the paper (statement modified).} The paper proves this, inside the
    proof of Lemma~1 of Ch.~IV \S1 (p.~277), for $E=\bigcup E_j$ reduced of codimension one
    and $D=W$ reduced (\cref{lem:normal-crossings-open-paper}); here $E$ and $D$ are arbitrary
    subschemes. -/)
  (proof := /-- As in the proof of \cref{lem:normal-crossings-open-paper}, with the replacement of
    $A$ by $A_f$ of \cref{lem:normal-crossings-open-replace}, whose step (2) holds for arbitrary
    $D$: the ideal of $D$ in $A$ is $(z_1,\dots,z_s)A$ by finite generation of ideals (the ideals
    of $D$ and of $(z_1,\dots,z_s)A_0$ agree at $P$, hence in $A_f$ for suitable $f$), instead of
    the paper's argument for reduced $W$ (\cref{lem:normal-crossings-open-prime-ideal}); the
    irreducibility and non-singularity of $\operatorname{Spec}(A)\cap D$ follow from (1) for the
    empty subsystem. The end of the proof is \cref{lem:normal-crossings-open-shrunk}, whose key step
    ``by (1) \dots\ can be extended'' is \cref{lem:normal-crossings-open-extend}. -/)
  (latexEnv := "lemma")]
theorem exists_isOpen_hasOnlyNormalCrossingsWithAt [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [IsAlgebraicScheme X] (hX : X.IsNonsingular)
    (E D : Subscheme X) (x : X)
    (h : E.HasOnlyNormalCrossingsWithAt D x) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ ∀ y ∈ U ∩ D.pts, E.HasOnlyNormalCrossingsWithAt D y := by
  classical
  obtain ⟨z, t, V, hV, hxV, f, hz, htz, -, hassoc, h1, h2, h3, -⟩ :=
    exists_isAffineOpen_prime_system hX E D x h
  -- "Now, if `y` is any point of `Spec(A) ∩ W` …"
  have hB := hasOnlyNormalCrossingsWithAt_of_prime_system hX E D hV x hxV
    (hV.primeIdealOf ⟨x, hxV⟩) (hV.fromSpec_primeIdealOf ⟨x, hxV⟩) z t hz htz f hassoc h1 h2 h3
  refine ⟨(V : Set X), V.isOpen, hxV, fun y hy => ?_⟩
  obtain ⟨q, rfl⟩ : ∃ q, hV.fromSpec q = y := by
    have : y ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hy.1
    exact this
  exact hB q hy.2

/-- **Lemma 1 of Ch. IV §1, p. 277, normal-crossing part, as printed**: for `W = D` reduced and
`E` reduced everywhere of codimension one (the hypotheses of a resolution datum, Def. 3 (I)(i), (iii);
`X` is non-singular algebraic, irreducibility is not needed), "if `W` has only normal crossings with
`⋃ E_i` at a point `x` of `W`, then there exists an open subset of `W` containing `x` at every point
of which `W` has only normal crossings with `⋃ E_i`".

The proof is the printed one (see the module docstring).  The replacement of `A` by `A_f`
(`exists_isAffineOpen_prime_system`) gives (1), (3) and that the components of `W` meeting `Spec(A)`
pass through `x`; (2) is then proved as printed ("`Spec(A) ∩ W` is irreducible …, so that
`(z₁, …, z_s)A` is the prime ideal of `W` in the affine ring `A`", `ideal_eq_span_of_isReduced`, using
that `W` is reduced and (1) for the empty subsystem); and the end of the proof is
`hasOnlyNormalCrossingsWithAt_of_prime_system`.  The hypotheses `E` reduced and everywhere of
codimension one are those of the paper; the proof does not use them (they are only used through
Def. 2, which in Lean does not require them). -/
@[blueprint "lem:normal-crossings-open-paper"
  (statement := /-- Let $X$ be a non-singular algebraic scheme, $E$ a reduced subscheme of $X$
    which is everywhere of codimension one, and $W$ a reduced subscheme of $X$. If $W$ has only
    normal crossings with $E$ at a point $x$ of $W$, then there exists an open subset of $W$
    containing $x$ at every point of which $W$ has only normal crossings with $E$.
    (The last part of the proof of Lemma~1 of Ch.~IV \S1, p.~277.) -/)
  (proof := /-- Let $\operatorname{Spec}(A)$ be an affine open subscheme of $X$ which contains the
    given point $x$, where $A$ is an algebra of finite type over a base ring of $X$. Let $P$ be
    the prime ideal in $A$ such that $A_P$ is the local ring of $X$ at $x$. We have a regular
    system of parameters $(z_1,\dots,z_r)$ of $A_P$ such that those $E_j$ passing through $x$ as
    well as $W$ have prime ideals in $A_P$ generated by subsystems of $(z_1,\dots,z_r)$. We
    arrange the indices of the $z_j$ in such a way that, for a certain positive integer
    $s\le r$, $(z_1,\dots,z_s)$ generates the prime ideal of $W$ in $A_P$. By replacing $A$ by
    $A_f$ with a suitable $f\in A-P$, so that $\operatorname{Spec}(A_f)$ is an affine open
    subscheme of $X$ containing the given point $x$, we may assume that:
    (1) for every subsystem $(z_{i_1},\dots,z_{i_t})$ of $(z_{s+1},\dots,z_r)$,
    $(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A$ is a prime ideal in $A$, and
    $A/(z_1,\dots,z_s,z_{i_1},\dots,z_{i_t})A$ is a regular ring, and
    (2) $\operatorname{Spec}(A)\cap W$ is irreducible (hence, non-singular by (1)), so that
    $(z_1,\dots,z_s)A$ is the prime ideal of $W$ in the affine ring $A$, and
    (3) $\operatorname{Spec}(A)$ has empty intersection with any of the $E_j$ which does not
    pass through $x$.
    Now, if $y$ is any point of $\operatorname{Spec}(A)\cap W$ and if $Q$ denotes the prime
    ideal of $y$ in $A$, then by (1) the subsystem of $(z_1,\dots,z_r)$ consisting of those
    $z_j$ contained in $Q$ can be extended to a regular system of parameters of the local ring
    $A_Q$ of $X$ at $y$, so that, by (2) and (3), $W$ has only normal crossings with
    $\bigcup_{i=1}^\alpha E_i$ at $y$. q.e.d.

    In Lean: the replacement of $A$ by $A_f$ achieving (1), (3), and that every component of $W$
    meeting $\operatorname{Spec}(A)$ passes through $x$, is \cref{lem:normal-crossings-open-replace}
    (finite generation of ideals; the openness of the regular locus, \cref{prop:class-A-iii}, for
    the regularity in (1)). (2) is then as printed: $\operatorname{Spec}(A)\cap W$ is irreducible, $W$
    is reduced, so the ideal of $W$ in $A$ is a prime, which is $(z_1,\dots,z_s)A$, a prime by (1)
    for the empty subsystem, with the same localization at $P$
    (\cref{lem:normal-crossings-open-prime-ideal}). The end of the proof is
    \cref{lem:normal-crossings-open-shrunk}, whose key step ``by (1) \dots\ can be extended'' is
    \cref{lem:normal-crossings-open-extend}. \textbf{Gaps filled.} The $z_j$ are tacitly elements
    of $A$; the ideal of each $E_j$ through $x$ in $A$ is $(z_j)A$ (used in ``by (2) and (3)'');
    ``by (1) \dots\ can be extended'' needs a height count; the replacement achieving (1)--(3) is not
    argued in the paper. -/)
  (latexEnv := "lemma")]
theorem exists_isOpen_hasOnlyNormalCrossingsWithAt_of_isReduced [Hironaka.Cited.IsHironakaBaseIsClosedSingularLocus.{u}] [IsAlgebraicScheme X]
    (hX : X.IsNonsingular) (E D : Subscheme X) (_hE : E.IsReduced)
    (_hEc : E.IsEverywhereCodimOne) (hD : D.IsReduced) (x : X)
    (h : E.HasOnlyNormalCrossingsWithAt D x) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ ∀ y ∈ U ∩ D.pts, E.HasOnlyNormalCrossingsWithAt D y := by
  classical
  -- "By replacing `A` by `A_f` … we may assume that (1), (2), (3)"
  obtain ⟨z, t, V, hV, hxV, f, hz, htz, hDt, hassoc, h1, -, h3, hmin⟩ :=
    exists_isAffineOpen_prime_system hX E D x h
  -- (2): "`Spec(A) ∩ W` is irreducible …, so that `(z₁, …, z_s)A` is the prime ideal of `W` in the
  -- affine ring `A`": `W` is reduced and `(z₁, …, z_s)A` is prime by (1) (for the empty subsystem)
  have h2 : D.ideal ⟨V, hV⟩ = Ideal.span (f '' (t : Set (X.presheaf.stalk x))) := by
    refine ideal_eq_span_of_isReduced hD hV x hxV t f
      (fun a ha => (hz.1 ▸ Ideal.subset_span (htz ha) : a ∈ _)) hDt
      (fun a ha => hassoc a (htz ha)) ?_ hmin
    have := (h1 ∅ (Finset.empty_mem_powerset _)).1
    rwa [Finset.union_empty] at this
  -- "Now, if `y` is any point of `Spec(A) ∩ W` …"
  have hB := hasOnlyNormalCrossingsWithAt_of_prime_system hX E D hV x hxV
    (hV.primeIdealOf ⟨x, hxV⟩) (hV.fromSpec_primeIdealOf ⟨x, hxV⟩) z t hz htz f hassoc h1 h2 h3
  refine ⟨(V : Set X), V.isOpen, hxV, fun y hy => ?_⟩
  obtain ⟨q, rfl⟩ : ∃ q, hV.fromSpec q = y := by
    have : y ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hy.1
    exact this
  exact hB q hy.2

end Subscheme

end Hironaka


/-!
# Ch. II §2: the diagram of pp. 193–194 and the proof of Lemma 8

> We have the following commutative diagram of homomorphisms of Ō/Q̄ (= O/Q)-algebras:
>
>     gr⁰_Q(gr_P(J,R)) ⊗ gr_Q̄(Ō) --ψ''--> gr_Q(J,R)
>              |                              |
>     gr⁰_Q(gr_P(R))   ⊗ gr_Q̄(Ō) --ψ(≈)--> gr_Q(R)
>              |                              |
>     gr⁰_Q(gr_P(O))   ⊗ gr_Q̄(Ō) --ψ'-->   gr_Q(O)
>
> Here the two vertical sequences are exact by Lemma 5, and by the right exactness of tensor
> product. Moreover, it is easily seen that ψ is isomorphic and that ψ' is surjective. Therefore,
> it follows from the diagram that ψ' is isomorphic if and only if ψ'' is surjective.
> Let γ be the canonical homomorphism of graded Ō-algebras γ: gr_P(R) → gr_Q(R) … Therefore, ψ' is
> isomorphic if and only if the image of gr_P(J, R) by γ in
> gr_Q(R) generates the ideal gr_Q(J, R). … Thus the following lemma is verified: Lemma 8. (pp. 193–194)

This file carries out the full argument (abridged in the quote above).  The notation is that of p. 193 (see `Hironaka/Ch2/GradedIdeal.lean`):
`R` a regular local ring, `J ⊆ P ⊆ Q`, `O = R/J`, `P̄ = P/J`, `Q̄ = Q/J`, `Ō = O/P̄ = R/P`,
`Q̄' = Q̄/P̄ = Q/P`, and `y₁, …, y_s ∈ R` whose classes in `Ō` form a minimal base of `Q̄'`.

## Encoding

* Graded algebras are handled one (total) degree at a time, as in `psiDeg`: "`ψ'` is an
  isomorphism of graded algebras" is "`ψ'` is bijective in every total degree `n`", and the diagram
  is the diagram of the homogeneous components of total degree `n`, the source of `ψ` being
  `⊕_{p+q=n} gr⁰_Q(gr^p_P(·)) ⊗ gr^q_{Q̄}(Ō)`.
* The tensor products `gr⁰_Q(M) ⊗_{R/Q} G` of the paper (`G` an `R/Q`-module) are the canonical
  `M ⊗_R G` (`tensorEquivGrModPieceZero`, the identification already used for `grModMap`): this is
  the form in which the right exactness of the tensor product (`LinearMap.rTensor_exact`) is used.
  All maps of the diagram are `R`-linear (the paper's maps are `R/Q = O/Q̄`-linear).
* `Ō = O/P̄ = R/P` and `Q̄' = Q̄/P̄ = Q/P` are written as equalities in the paper; here `Ō` is
  `O/P̄` for `ψ'` and `R/P` for `ψ`, identified by `thetaEquiv`.

## Contents, in the paper's order

* the diagram (`mapJR`, `mapRO`, `psiTildeR`, `psiTildeO`, `psiDoublePrime`; exact columns,
  commutativity) and "`ψ'` is isomorphic iff `ψ''` is surjective"
  (`bijective_psiDeg_iff_surjective_psiDoublePrime`);
* `γ : gr_P(R) → gr_Q(R)` (`gammaMap`), "the image of `ψ''` is a graded ideal in `gr_Q(R)` which is
  generated by the image of `gr_P(J, R)` by `γ`" (`psiDoublePrimeImage_eq_map_gammaMap`) and "`ψ'`
  is isomorphic iff the image of `gr_P(J, R)` by `γ` generates `gr_Q(J, R)`"
  (`surjective_psiDoublePrime_iff_eq_map_gammaMap`);
* the study of `ν = ν_P(f)` against `μ = ν_Q(f)`: `Φ ∈ Q^{μ-ν} gr_P(R)` (`initialForm_mem_map_pow`,
  from the transversality of the `P`-adic and `Q`-adic filtrations, `inf_pow_le_mixedPow`),
  `γ(Φ) = 0` or `γ(Φ)` is the initial form of `f` (`gammaMap_initialForm_eq_zero`,
  `gammaMap_initialForm_eq`);
* Lemma 8 (`bijective_psiDeg_iff_hasInitialFormSystem`).
-/

@[expose] public section

open TensorProduct
open scoped DirectSum

namespace Hironaka

namespace Lemma8

universe u

/-! ### The four-lemma behind "it follows from the diagram" (p. 194) -/

section Diagram

variable {S : Type*} [CommRing S]
  {A₁ A₂ A₃ B₁ B₂ B₃ : Type*} [AddCommGroup A₁] [AddCommGroup A₂] [AddCommGroup A₃]
  [AddCommGroup B₁] [AddCommGroup B₂] [AddCommGroup B₃] [Module S A₁] [Module S A₂]
  [Module S A₃] [Module S B₁] [Module S B₂] [Module S B₃]

/-- p. 194: "Moreover, it is easily seen that `ψ` is isomorphic and that `ψ'` is surjective.
Therefore, it follows from the diagram that `ψ'` is isomorphic if and only if `ψ''` is
surjective."  The diagram has an exact left column `A₁ → A₂ → A₃ → 0` and an exact right column
`0 → B₁ → B₂ → B₃ → 0`, commutes, and `ψ : A₂ → B₂` is bijective and `ψ' : A₃ → B₃` surjective. -/
theorem bijective_iff_surjective_of_exact_columns (f₁ : A₁ →ₗ[S] A₂) (f₂ : A₂ →ₗ[S] A₃)
    (g₁ : B₁ →ₗ[S] B₂) (g₂ : B₂ →ₗ[S] B₃) (ψ'' : A₁ →ₗ[S] B₁) (ψ : A₂ →ₗ[S] B₂)
    (ψ' : A₃ →ₗ[S] B₃) (hf : Function.Exact f₁ f₂) (hf₂ : Function.Surjective f₂)
    (hg₁ : Function.Injective g₁) (hg : Function.Exact g₁ g₂)
    (h₁ : ∀ a, ψ (f₁ a) = g₁ (ψ'' a)) (h₂ : ∀ a, ψ' (f₂ a) = g₂ (ψ a))
    (hψ : Function.Bijective ψ) (hψ' : Function.Surjective ψ') :
    Function.Bijective ψ' ↔ Function.Surjective ψ'' := by
  constructor
  · intro hb b
    obtain ⟨a₂, ha₂⟩ := hψ.2 (g₁ b)
    have h0 : ψ' (f₂ a₂) = 0 := by rw [h₂, ha₂]; exact (hg _).mpr ⟨b, rfl⟩
    have h0' : f₂ a₂ = 0 := hb.1 (by rw [h0, map_zero])
    obtain ⟨a₁, rfl⟩ := (hf a₂).mp h0'
    exact ⟨a₁, hg₁ (by rw [← h₁, ha₂])⟩
  · intro hs
    refine ⟨(injective_iff_map_eq_zero ψ').mpr fun z hz => ?_, hψ'⟩
    obtain ⟨a₂, rfl⟩ := hf₂ z
    have h0 : g₂ (ψ a₂) = 0 := by rw [← h₂, hz]
    obtain ⟨b, hb⟩ := (hg _).mp h0
    obtain ⟨a₁, rfl⟩ := hs b
    have : a₂ = f₁ a₁ := hψ.1 (by rw [h₁, hb])
    rw [this]
    exact (hf _).mpr ⟨a₁, rfl⟩

end Diagram

/-! ### Tensor products over the quotient ring (right exactness, p. 194) -/

section TensorQuotient

variable {A : Type u} [CommRing A] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M]
  (G : Type u) [AddCommGroup G] [Module A G] [Module (A ⧸ I) G] [IsScalarTower A (A ⧸ I) G]

/-- `(A/I) ⊗_A M ≃ gr⁰_I(M)` as `A/I`-modules. -/
noncomputable def quotTensorEquivGrModPieceZero : ((A ⧸ I) ⊗[A] M) ≃ₗ[A ⧸ I] GrModPiece I M 0 :=
  ((TensorProduct.quotTensorEquivQuotSMul M I).trans
    (quotEquivGrModPieceZero I M)).extendScalarsOfSurjective Ideal.Quotient.mk_surjective

/-- `G ⊗_A M ≃ G ⊗_{A/I} gr⁰_I(M)`. -/
noncomputable def tensorEquivGrModPieceZeroAux :
    (G ⊗[A] M) ≃ₗ[A ⧸ I] (G ⊗[A ⧸ I] GrModPiece I M 0) :=
  (TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ I) (A ⧸ I) G M).symm.trans
    (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl (A ⧸ I) G)
      (quotTensorEquivGrModPieceZero I M))

/-- For an `A/I`-module `G`: `gr⁰_I(M) ⊗_{A/I} G = (M/IM) ⊗_{A/I} G` is canonically `M ⊗_A G`
(`x ⊗ g ↦ [x] ⊗ g`), the identification used in `grModMap` ("`gr⁰_I(M) ⊗_{A/I} grᵐ_I(A)` is
canonically `M ⊗_A Iᵐ/Iᵐ⁺¹`").  It makes the right exactness of `⊗_{A/I}` of the paper the right
exactness of `⊗_A` (`LinearMap.rTensor_exact`). -/
noncomputable def tensorEquivGrModPieceZero :
    (M ⊗[A] G) ≃ₗ[A] (GrModPiece I M 0 ⊗[A ⧸ I] G) :=
  (TensorProduct.comm A M G).trans (((tensorEquivGrModPieceZeroAux I M G).restrictScalars A).trans
    ((TensorProduct.comm (A ⧸ I) G (GrModPiece I M 0)).restrictScalars A))

theorem tensorEquivGrModPieceZero_tmul (x : M) (g : G) :
    tensorEquivGrModPieceZero I M G (x ⊗ₜ g) =
      Submodule.Quotient.mk ⟨x, mem_pow_zero_smul_top I x⟩ ⊗ₜ[A ⧸ I] g := by
  simp [tensorEquivGrModPieceZero, tensorEquivGrModPieceZeroAux, quotTensorEquivGrModPieceZero]
  rfl

end TensorQuotient

/-! ### Lemma 5 in each degree (the columns of the diagram, p. 194) -/

section Lemma5

variable {A : Type u} [CommRing A] (J I : Ideal A)

/-- The homogeneous part `gr^n_I(J, A) = ((J ∩ Iⁿ) + Iⁿ⁺¹)/Iⁿ⁺¹` of degree `n` of the graded ideal
`gr_I(J, A)` (p. 189: "We denote by `gr^n_I(J, A)` the homogeneous part of degree `n` of the graded
ideal `gr_I(J, A)`"), as an `A`-submodule of `grⁿ_I(A) = Iⁿ/Iⁿ⁺¹`. -/
def grIdealPiece (n : ℕ) : Submodule A (GrPiece I n) where
  carrier := {x | inJ I J n x}
  zero_mem' := inJ_zero I J n
  add_mem' := inJ_add I
  smul_mem' := by
    rintro r x ⟨a, haJ, ha, rfl⟩
    refine ⟨r * a, J.mul_mem_left r haJ, (I ^ n).mul_mem_left r ha, ?_⟩
    rw [← Submodule.Quotient.mk_smul]
    rfl

theorem mem_grIdealPiece_iff (n : ℕ) (x : GrPiece I n) :
    x ∈ grIdealPiece J I n ↔ ∃ a ∈ J, ∃ ha : a ∈ I ^ n, Submodule.Quotient.mk ⟨a, ha⟩ = x :=
  Iff.rfl

theorem mk_mem_grIdealPiece {n : ℕ} {a : A} (haJ : a ∈ J) (ha : a ∈ I ^ n) :
    (Submodule.Quotient.mk ⟨a, ha⟩ : GrPiece I n) ∈ grIdealPiece J I n :=
  ⟨a, haJ, ha, rfl⟩

/-- `A → Ā = A/J` induces `Iⁿ → Īⁿ` on the pieces (`Ī = IĀ`): the component of degree `n`
of the canonical homomorphism `gr_I(A) → gr_Ī(Ā)` of Lemma 5 (p. 190). -/
noncomputable def grPieceMapQuot (n : ℕ) :
    GrPiece I n →ₗ[A] GrPiece (I.map (Ideal.Quotient.mk J)) n :=
  Submodule.liftQ _
    { toFun := fun x => Submodule.Quotient.mk
        ⟨Ideal.Quotient.mk J x.1, by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ x.2⟩
      map_add' := fun x y => by
        rw [← Submodule.Quotient.mk_add]
        exact congrArg _ (Subtype.ext (map_add _ _ _))
      map_smul' := fun r x => by
        rw [RingHom.id_apply, ← Submodule.Quotient.mk_smul]
        exact congrArg _ (Subtype.ext (by simp [Algebra.smul_def])) }
    (by
      intro x hx
      rw [LinearMap.mem_ker]
      show (Submodule.Quotient.mk _ : GrPiece (I.map (Ideal.Quotient.mk J)) n) = 0
      rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
      show Ideal.Quotient.mk J x.1 ∈ (I.map (Ideal.Quotient.mk J)) ^ (n + 1)
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hx)

theorem grPieceMapQuot_mk (n : ℕ) (a : ↥(I ^ n)) :
    grPieceMapQuot J I n (Submodule.Quotient.mk a) = Submodule.Quotient.mk
      ⟨Ideal.Quotient.mk J a.1, by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ a.2⟩ :=
  rfl

/-- Lemma 5 (p. 190), surjectivity in degree `n` (`Īⁿ = (Iⁿ + J)/J`). -/
theorem grPieceMapQuot_surjective (n : ℕ) : Function.Surjective (grPieceMapQuot J I n) := by
  intro z
  induction z using Submodule.Quotient.induction_on with
  | H z =>
    obtain ⟨b, hb⟩ := z
    rw [← Ideal.map_pow, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hb
    obtain ⟨a, ha, rfl⟩ := hb
    exact ⟨Submodule.Quotient.mk ⟨a, ha⟩, rfl⟩

theorem ofGrPiece_grPieceMapQuot (n : ℕ) (x : GrPiece I n) :
    AssocGraded.ofGrPiece (I.map (Ideal.Quotient.mk J)) n (grPieceMapQuot J I n x) =
      grMapQuot I J (AssocGraded.ofGrPiece I n x) := by
  induction x using Submodule.Quotient.induction_on with
  | H a =>
    rw [AssocGraded.ofGrPiece_mk, grPieceMapQuot_mk, AssocGraded.ofGrPiece_mk, grMapQuot_mk]

/-- Lemma 5 (p. 190), exactness in degree `n`: the kernel of `gr^n_I(A) → gr^n_Ī(Ā)` is
`gr^n_I(J, A)`.  It is the degree-`n` part of `ker_grMapQuot` (the kernel of the whole map
`gr_I(A) → gr_Ī(Ā)` is `gr_I(J, A)`). -/
theorem grPieceMapQuot_eq_zero_iff (n : ℕ) (x : GrPiece I n) :
    grPieceMapQuot J I n x = 0 ↔ x ∈ grIdealPiece J I n := by
  have key : grPieceMapQuot J I n x = 0 ↔ AssocGraded.ofGrPiece I n x ∈ grIdeal I J := by
    rw [← ker_grMapQuot, RingHom.mem_ker, ← ofGrPiece_grPieceMapQuot]
    constructor
    · intro h
      rw [h, map_zero]
    · intro h
      exact AssocGraded.ofGrPiece_injective _ n (by rw [h, map_zero])
  rw [key]
  constructor
  · intro h
    obtain ⟨a, ⟨haJ, -⟩, ha, hmk⟩ := (grIdeal_homogeneous_eq I J n _
      (LinearMap.mem_range.mpr ⟨x, rfl⟩)).mp h
    refine ⟨a, haJ, ha, ?_⟩
    refine AssocGraded.ofGrPiece_injective I n ?_
    rw [AssocGraded.ofGrPiece_mk]
    exact hmk
  · rintro ⟨a, haJ, ha, rfl⟩
    rw [AssocGraded.ofGrPiece_mk]
    exact mk_mem_grIdeal I haJ ha

/-- Lemma 5 (p. 190), in degree `n`: `0 → gr^n_I(J, A) → gr^n_I(A) → gr^n_Ī(Ā) → 0` is exact. -/
theorem exact_subtype_grPieceMapQuot (n : ℕ) :
    Function.Exact (grIdealPiece J I n).subtype (grPieceMapQuot J I n) := by
  intro x
  rw [grPieceMapQuot_eq_zero_iff]
  exact ⟨fun hx => ⟨⟨x, hx⟩, rfl⟩, fun ⟨z, hz⟩ => hz ▸ z.2⟩

end Lemma5

/-! ### The identification `Ō = R/P = O/P̄` (p. 193) -/

section Theta

/-- A ring isomorphism carrying `I` to `I'` identifies `grⁿ_I` with `grⁿ_{I'}` (semilinearly). -/
noncomputable def grPieceRingEquiv {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B)
    [RingHomInvPair (e : A →+* B) (e.symm : B →+* A)]
    [RingHomInvPair (e.symm : B →+* A) (e : A →+* B)]
    (I : Ideal A) (I' : Ideal B) (hII' : I.map (e : A →+* B) = I') (n : ℕ) :
    GrPiece I n ≃ₛₗ[(e : A →+* B)] GrPiece I' n := by
  let f₀ : A ≃ₛₗ[(e : A →+* B)] B := e.toSemilinearEquiv
  have hpow : ∀ k, I' ^ k = (I ^ k).comap (e.symm : B →+* A) := by
    intro k
    rw [← hII', ← Ideal.map_pow, Ideal.map_comap_of_equiv]
    rfl
  have hmap : ∀ k, Submodule.map (f₀ : A →ₛₗ[(e : A →+* B)] B) (I ^ k) = I' ^ k := by
    intro k
    ext x
    rw [Submodule.mem_map, hpow k, Ideal.mem_comap]
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa [f₀] using hy
    · intro hx
      exact ⟨e.symm x, hx, by simp [f₀]⟩
  let g₀ : ↥(I ^ n) ≃ₛₗ[(e : A →+* B)] ↥(I' ^ n) :=
    (f₀.submoduleMap (I ^ n)).trans (LinearEquiv.ofEq _ _ (hmap n))
  have hq : (Submodule.comap (I ^ n).subtype (I ^ (n + 1))).map
      (g₀ : ↥(I ^ n) →ₛₗ[(e : A →+* B)] ↥(I' ^ n)) =
      Submodule.comap (I' ^ n).subtype (I' ^ (n + 1)) := by
    rw [Submodule.map_equiv_eq_comap_symm]
    ext ⟨x, hx⟩
    show ((g₀.symm ⟨x, hx⟩ : ↥(I ^ n)) : A) ∈ I ^ (n + 1) ↔ x ∈ I' ^ (n + 1)
    rw [hpow (n + 1), Ideal.mem_comap]
    rfl
  exact Submodule.Quotient.equiv _ _ g₀ hq

theorem grPieceRingEquiv_mk {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B)
    [RingHomInvPair (e : A →+* B) (e.symm : B →+* A)]
    [RingHomInvPair (e.symm : B →+* A) (e : A →+* B)] (I : Ideal A) (I' : Ideal B) (hII' : I.map (e : A →+* B) = I') (n : ℕ) (a : ↥(I ^ n))
    (ha : e a.1 ∈ I' ^ n) :
    grPieceRingEquiv e I I' hII' n (Submodule.Quotient.mk a) =
      Submodule.Quotient.mk ⟨e a.1, ha⟩ :=
  rfl

variable {R : Type u} [CommRing R] (J P Q : Ideal R)

/-- `Q̄' = Q̄/P̄` is the image of `Q' = Q/P` under `Ō = R/P ≅ O/P̄`. -/
theorem map_quotQuotEquivQuotOfLE_symm (hJP : J ≤ P) :
    (Q.map (Ideal.Quotient.mk P)).map ((DoubleQuot.quotQuotEquivQuotOfLE hJP).symm : R ⧸ P →+*
        (R ⧸ J) ⧸ (P.map (Ideal.Quotient.mk J))) =
      (Q.map (Ideal.Quotient.mk J)).map
        (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))) := by
  rw [Ideal.map_map, Ideal.map_map]
  congr 1

/-- The identification `gr^q_{Q/P}(R/P) = gr^q_{Q̄/P̄}(O/P̄)` of the two descriptions of
`gr_Q̄(Ō)` (`Ō = R/P = O/P̄`, `Q̄' = Q/P = Q̄/P̄`), as an `R`-linear isomorphism. -/
noncomputable def thetaEquiv (hJP : J ≤ P) (q : ℕ) :
    GrPiece (Q.map (Ideal.Quotient.mk P)) q ≃ₗ[R]
      GrPiece ((Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))
        q :=
  haveI := RingHomInvPair.of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm
  haveI := RingHomInvPair.of_ringEquiv_symm (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm
  { (grPieceRingEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm _ _
      (map_quotQuotEquivQuotOfLE_symm J P Q hJP) q).toAddEquiv with
    map_smul' := fun r z => by
      have h1 : r • z = (Ideal.Quotient.mk P r) • z := (algebraMap_smul (R ⧸ P) r z).symm
      have h2 := (grPieceRingEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm _ _
        (map_quotQuotEquivQuotOfLE_symm J P Q hJP) q).map_smulₛₗ (Ideal.Quotient.mk P r) z
      rw [RingHom.id_apply, h1]
      refine h2.trans ?_
      exact (algebraMap_smul _ r _) }

theorem thetaEquiv_mk (hJP : J ≤ P) (q : ℕ) (x : R ⧸ P) (hx : x ∈ (Q.map (Ideal.Quotient.mk P)) ^ q)
    (hx' : (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm x ∈
      ((Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) ^ q) :
    thetaEquiv J P Q hJP q (Submodule.Quotient.mk ⟨x, hx⟩) =
      Submodule.Quotient.mk ⟨(DoubleQuot.quotQuotEquivQuotOfLE hJP).symm x, hx'⟩ :=
  rfl

end Theta

/-! ### The left column: right exactness of the tensor product (p. 194) -/

section LeftColumn

/-- A surjective ring map makes the `A`-tensor product of two `B`-modules the `B`-tensor product. -/
theorem compatibleSMul_of_surjective {A B M N : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) [AddCommGroup M] [Module A M] [Module B M]
    [IsScalarTower A B M] [AddCommGroup N] [Module A N] [Module B N] [IsScalarTower A B N] :
    TensorProduct.CompatibleSMul A B M N :=
  ⟨fun b m n => by
    obtain ⟨a, rfl⟩ := h b
    rw [algebraMap_smul, algebraMap_smul]
    exact TensorProduct.smul_tmul a m n⟩

/-- `M ⊗_A N = M ⊗_B N` for `B`-modules `M`, `N`, `B` a quotient of `A`. -/
noncomputable def tensorEquivOfSurjective {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) (M N : Type*) [AddCommGroup M] [Module A M]
    [Module B M] [IsScalarTower A B M] [AddCommGroup N] [Module A N] [Module B N]
    [IsScalarTower A B N] : (M ⊗[A] N) ≃ₗ[A] (M ⊗[B] N) :=
  haveI := compatibleSMul_of_surjective (M := M) (N := N) h
  (TensorProduct.equivOfCompatibleSMul A B A M N).symm

variable {R : Type u} [CommRing R] (J P Q : Ideal R)

/-- The summands `gr^p_P(R) ⊗ gr^q_{Q̄}(Ō)` (`Ō = R/P`) of the source of `ψ` in total degree `n`
(second row of the diagram; tensor products over `R`, see the module docstring). -/
abbrev SummandR (n : ℕ) : {pq : ℕ × ℕ // pq.1 + pq.2 = n} → Type u := fun pq =>
  GrPiece P pq.1.1 ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2

/-- The summands `gr^p_P(J, R) ⊗ gr^q_{Q̄}(Ō)` of the source of `ψ''` (first row). -/
abbrev SummandJ (n : ℕ) : {pq : ℕ × ℕ // pq.1 + pq.2 = n} → Type u := fun pq =>
  ↥(grIdealPiece J P pq.1.1) ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2

/-- The summands `gr^p_{P̄}(O) ⊗_{O} gr^q_{Q̄}(Ō)` (`Ō = O/P̄`) of the source of `ψ'` (third row). -/
abbrev SummandO (n : ℕ) : {pq : ℕ × ℕ // pq.1 + pq.2 = n} → Type u := fun pq =>
  GrPiece (P.map (Ideal.Quotient.mk J)) pq.1.1 ⊗[R ⧸ J]
    GrPiece ((Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))
      pq.1.2

/-- `gr_P(J, R) → gr_P(R)` tensored with `gr_{Q̄}(Ō)`: the first arrow of the left column. -/
noncomputable def mapJR (n : ℕ) : (⨁ pq, SummandJ J P Q n pq) →ₗ[R] ⨁ pq, SummandR P Q n pq :=
  DirectSum.lmap fun pq => LinearMap.rTensor _ (grIdealPiece J P pq.1.1).subtype

/-- The identification `gr^p_{P̄}(O) ⊗_R gr^q_{Q̄}(Ō) = gr^p_{P̄}(O) ⊗_O gr^q_{Q̄}(Ō)`, with the
identification `Ō = R/P = O/P̄` (`thetaEquiv`) on the second factor. -/
noncomputable def tensorEquivRO (hJP : J ≤ P) (p q : ℕ) :
    GrPiece (P.map (Ideal.Quotient.mk J)) p ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) q ≃ₗ[R]
      GrPiece (P.map (Ideal.Quotient.mk J)) p ⊗[R ⧸ J]
        GrPiece ((Q.map (Ideal.Quotient.mk J)).map
          (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) q :=
  (TensorProduct.congr (LinearEquiv.refl R _) (thetaEquiv J P Q hJP q)).trans
    (tensorEquivOfSurjective (A := R) (B := R ⧸ J) Ideal.Quotient.mk_surjective _ _)

/-- `gr^p_P(R) ⊗ gr^q_{Q̄}(Ō) → gr^p_{P̄}(O) ⊗ gr^q_{Q̄}(Ō)` induced by `gr_P(R) → gr_{P̄}(O)`
(Lemma 5) and the identification `Ō = R/P = O/P̄`. -/
noncomputable def tensorMapRO (hJP : J ≤ P) (p q : ℕ) :
    GrPiece P p ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) q →ₗ[R]
      GrPiece (P.map (Ideal.Quotient.mk J)) p ⊗[R ⧸ J]
        GrPiece ((Q.map (Ideal.Quotient.mk J)).map
          (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) q :=
  (tensorEquivRO J P Q hJP p q).toLinearMap ∘ₗ LinearMap.rTensor _ (grPieceMapQuot J P p)

theorem tensorMapRO_tmul (hJP : J ≤ P) (p q : ℕ) (x : GrPiece P p)
    (z : GrPiece (Q.map (Ideal.Quotient.mk P)) q) :
    tensorMapRO J P Q hJP p q (x ⊗ₜ z) = grPieceMapQuot J P p x ⊗ₜ[R ⧸ J] thetaEquiv J P Q hJP q z :=
  rfl

/-- `gr_P(R) ⊗ gr_{Q̄}(Ō) → gr_{P̄}(O) ⊗ gr_{Q̄}(Ō)`: the second arrow of the left column. -/
noncomputable def mapRO (hJP : J ≤ P) (n : ℕ) :
    (⨁ pq, SummandR P Q n pq) →ₗ[R] ⨁ pq, SummandO J P Q n pq :=
  DirectSum.lmap fun pq => tensorMapRO J P Q hJP pq.1.1 pq.1.2

/-- The left column of the diagram is exact (p. 194: "exact ... by the right exactness of tensor
product"): `gr_P(J, R) ⊗ G → gr_P(R) ⊗ G → gr_{P̄}(O) ⊗ G → 0` is obtained from the exact sequence of
Lemma 5, `gr^p_P(J, R) → gr^p_P(R) → gr^p_{P̄}(O) → 0`, by tensoring with the module
`G = gr^q_{Q̄}(Ō)`, one summand `(p, q)` at a time. -/
theorem tensorMapRO_exact (hJP : J ≤ P) (p q : ℕ) :
    Function.Exact (LinearMap.rTensor (GrPiece (Q.map (Ideal.Quotient.mk P)) q)
      (grIdealPiece J P p).subtype) (tensorMapRO J P Q hJP p q) := by
  have h2 := rTensor_exact (GrPiece (Q.map (Ideal.Quotient.mk P)) q)
    (exact_subtype_grPieceMapQuot J P p) (grPieceMapQuot_surjective J P p)
  exact LinearEquiv.postcomp_exact_iff_exact.mpr h2

theorem mapRO_surjective (hJP : J ≤ P) (n : ℕ) : Function.Surjective (mapRO J P Q hJP n) :=
  (DirectSum.lmap_surjective _).mpr fun _ =>
    (tensorEquivRO J P Q hJP _ _).surjective.comp
      (LinearMap.rTensor_surjective _ (grPieceMapQuot_surjective J P _))

/-- The left column `gr_P(J, R) ⊗ G → gr_P(R) ⊗ G → gr_{P̄}(O) ⊗ G → 0` (total degree `n`) is exact. -/
theorem mapJR_mapRO_exact (hJP : J ≤ P) (n : ℕ) :
    Function.Exact (mapJR J P Q n) (mapRO J P Q hJP n) := by
  rw [LinearMap.exact_iff, mapRO, mapJR, DirectSum.ker_lmap, DirectSum.range_lmap]
  congr 1
  refine Submodule.ext fun v => ?_
  simp only [Submodule.mem_pi, Set.mem_univ, forall_true_left, LinearMap.mem_ker,
    LinearMap.mem_range]
  exact forall_congr' fun pq => (tensorMapRO_exact J P Q hJP pq.1.1 pq.1.2 _)

end LeftColumn

/-! ### The horizontal maps `ψ` and `ψ'` (p. 193–194) -/

section Rows

variable {R : Type u} [CommRing R] (J P Q : Ideal R) (hPQ : P ≤ Q) {s : ℕ} (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))

/-- The map `ψ : gr⁰_Q(gr_P(R)) ⊗ gr_{Q̄}(Ō) → gr_Q(R)` of Proposition 1 (p. 183) for `R`, `P`, `Q`
in total degree `n` (`psiDeg`), read on `⨁_{p+q=n} gr^p_P(R) ⊗_R gr^q_{Q̄}(Ō)` through
`tensorEquivGrModPieceZero` (second row of the diagram). -/
noncomputable def psiTildeR (n : ℕ) : (⨁ pq, SummandR P Q n pq) →ₗ[R] GrPiece Q n :=
  (psiDeg P Q hPQ y hqr hz n).restrictScalars R ∘ₗ
    DirectSum.lmap fun pq => (tensorEquivGrModPieceZero Q (GrPiece P pq.1.1)
      (GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2)).toLinearMap

theorem psiTildeR_lof_tmul (n : ℕ) (pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n})
    (x : GrPiece P pq.1.1) (z : GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2) :
    psiTildeR P Q hPQ y hqr hz n (DirectSum.lof R _ (SummandR P Q n) pq (x ⊗ₜ z)) =
      GrPiece.castDeg Q pq.2 (GrPiece.mulPieceQuot Q pq.1.1 pq.1.2
        (grPieceInclusion P Q hPQ pq.1.1 x) (betaStarPiece P Q hPQ y hqr hz pq.1.2 z)) := by
  simp only [psiTildeR, LinearMap.comp_apply, DirectSum.lmap_lof, LinearMap.restrictScalars_apply]
  have h := psiDeg_lof P Q hPQ y hqr hz n pq (Submodule.Quotient.mk ⟨x, mem_pow_zero_smul_top Q x⟩ ⊗ₜ[R ⧸ Q] z)
  simp only [DirectSum.lof_eq_of] at h ⊢
  rw [LinearEquiv.coe_coe, tensorEquivGrModPieceZero_tmul, h]
  unfold psiSummandMap psiPiece
  rw [LinearMap.comp_apply, TensorProduct.lift.tmul, LinearMap.compl₁₂_apply, alphaPiece_mk]

theorem bijective_psiTildeR_iff (n : ℕ) :
    Function.Bijective (psiTildeR P Q hPQ y hqr hz n) ↔
      Function.Bijective (psiDeg P Q hPQ y hqr hz n) := by
  have hc : Function.Bijective (DirectSum.lmap fun pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n} =>
      (tensorEquivGrModPieceZero Q (GrPiece P pq.1.1)
        (GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2)).toLinearMap) :=
    ⟨(DirectSum.lmap_injective _).mpr fun pq => LinearEquiv.injective _,
      (DirectSum.lmap_surjective _).mpr fun pq => LinearEquiv.surjective _⟩
  rw [psiTildeR, LinearMap.coe_comp, LinearMap.coe_restrictScalars]
  exact Function.Bijective.of_comp_iff _ hc

variable {J}
variable (hqr' : IsQuasiRegular fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j)))
  (hz' : Ideal.span (Set.range fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j))) =
      (Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))

/-- The map `ψ' : gr⁰_{Q̄}(gr_{P̄}(O)) ⊗ gr_{Q̄}(Ō) → gr_{Q̄}(O)` of Lemma 8 (p. 193) in total degree
`n`, i.e. `psiDeg` for `O`, `P̄`, `Q̄` and the classes `y'_j` of the `y_j` (third row of the
diagram), read on `⨁_{p+q=n} gr^p_{P̄}(O) ⊗_O gr^q_{Q̄}(Ō)`. -/
noncomputable def psiTildeO (n : ℕ) :
    (⨁ pq, SummandO J P Q n pq) →ₗ[R] GrPiece (Q.map (Ideal.Quotient.mk J)) n :=
  (psiDeg (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J)) (Ideal.map_mono hPQ)
    (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' n).restrictScalars R ∘ₗ
    DirectSum.lmap fun pq => ((tensorEquivGrModPieceZero (Q.map (Ideal.Quotient.mk J))
      (GrPiece (P.map (Ideal.Quotient.mk J)) pq.1.1)
      (GrPiece ((Q.map (Ideal.Quotient.mk J)).map
        (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) pq.1.2)).restrictScalars R).toLinearMap

theorem psiTildeO_lof_tmul (n : ℕ) (pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n})
    (x : GrPiece (P.map (Ideal.Quotient.mk J)) pq.1.1)
    (z : GrPiece ((Q.map (Ideal.Quotient.mk J)).map
      (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) pq.1.2) :
    psiTildeO P Q hPQ y hqr' hz' n (DirectSum.lof R _ (SummandO J P Q n) pq (x ⊗ₜ[R ⧸ J] z)) =
      GrPiece.castDeg (Q.map (Ideal.Quotient.mk J)) pq.2
        (GrPiece.mulPieceQuot (Q.map (Ideal.Quotient.mk J)) pq.1.1 pq.1.2
          (grPieceInclusion (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
            (Ideal.map_mono hPQ) pq.1.1 x)
          (betaStarPiece (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
            (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' pq.1.2 z)) := by
  simp only [psiTildeO, LinearMap.comp_apply, DirectSum.lmap_lof, LinearMap.restrictScalars_apply]
  have h := psiDeg_lof (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
    (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' n pq
    (Submodule.Quotient.mk ⟨x, mem_pow_zero_smul_top (Q.map (Ideal.Quotient.mk J)) x⟩ ⊗ₜ[(R ⧸ J) ⧸ Q.map (Ideal.Quotient.mk J)] z)
  simp only [DirectSum.lof_eq_of] at h ⊢
  simp only [LinearEquiv.coe_coe, LinearEquiv.restrictScalars_apply, tensorEquivGrModPieceZero_tmul]
  rw [h]
  unfold psiSummandMap psiPiece
  rw [LinearMap.comp_apply, TensorProduct.lift.tmul, LinearMap.compl₁₂_apply, alphaPiece_mk]

theorem bijective_psiTildeO_iff (n : ℕ) :
    Function.Bijective (psiTildeO P Q hPQ y hqr' hz' n) ↔
      Function.Bijective (psiDeg (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' n) := by
  have hc : Function.Bijective (DirectSum.lmap fun pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n} =>
      ((tensorEquivGrModPieceZero (Q.map (Ideal.Quotient.mk J))
        (GrPiece (P.map (Ideal.Quotient.mk J)) pq.1.1)
        (GrPiece ((Q.map (Ideal.Quotient.mk J)).map
          (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) pq.1.2)).restrictScalars R).toLinearMap) :=
    ⟨(DirectSum.lmap_injective _).mpr fun pq => LinearEquiv.injective _,
      (DirectSum.lmap_surjective _).mpr fun pq => LinearEquiv.surjective _⟩
  unfold psiTildeO
  rw [LinearMap.coe_comp]
  exact Function.Bijective.of_comp_iff (⇑(psiDeg (P.map (Ideal.Quotient.mk J))
    (Q.map (Ideal.Quotient.mk J)) (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j))
    hqr' hz' n)) hc

theorem surjective_psiTildeO_of_surjective (n : ℕ)
    (h : Function.Surjective (psiDeg (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' n)) :
    Function.Surjective (psiTildeO P Q hPQ y hqr' hz' n) := by
  have hc : Function.Surjective (DirectSum.lmap fun pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n} =>
      ((tensorEquivGrModPieceZero (Q.map (Ideal.Quotient.mk J))
        (GrPiece (P.map (Ideal.Quotient.mk J)) pq.1.1)
        (GrPiece ((Q.map (Ideal.Quotient.mk J)).map
          (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) pq.1.2)).restrictScalars R).toLinearMap) :=
    (DirectSum.lmap_surjective _).mpr fun pq => LinearEquiv.surjective _
  unfold psiTildeO
  rw [LinearMap.coe_comp]
  exact h.comp hc

end Rows

/-! ### The squares of the diagram commute (p. 193) -/

section Compat

section Quotient

variable {A : Type u} [CommRing A] (J : Ideal A)

theorem grPieceMapQuot_castDeg (I : Ideal A) {a b : ℕ} (h : a = b) (x : GrPiece I a) :
    grPieceMapQuot J I b (GrPiece.castDeg I h x) =
      GrPiece.castDeg (I.map (Ideal.Quotient.mk J)) h (grPieceMapQuot J I a x) := by
  subst h
  rfl

theorem grPieceMapQuot_mulPieceQuot (I : Ideal A) (p q : ℕ) (a : GrPiece I p) (b : GrPiece I q) :
    grPieceMapQuot J I (p + q) (GrPiece.mulPieceQuot I p q a b) =
      GrPiece.mulPieceQuot (I.map (Ideal.Quotient.mk J)) p q (grPieceMapQuot J I p a)
        (grPieceMapQuot J I q b) := by
  induction a using Submodule.Quotient.induction_on with
  | H a =>
    induction b using Submodule.Quotient.induction_on with
    | H b => rfl

theorem grPieceMapQuot_grPieceInclusion (P I : Ideal A) (hPI : P ≤ I) (p : ℕ) (x : GrPiece P p) :
    grPieceMapQuot J I p (grPieceInclusion P I hPI p x) =
      grPieceInclusion (P.map (Ideal.Quotient.mk J)) (I.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPI) p (grPieceMapQuot J P p x) := by
  induction x using Submodule.Quotient.induction_on with
  | H a => rfl

end Quotient

section BetaStar

theorem betaStarPiece_basis {O : Type u} [CommRing O] (P m : Ideal O) (hPm : P ≤ m) {s : ℕ}
    (y : Fin s → O) (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
    (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = m.map (Ideal.Quotient.mk P))
    (q : ℕ) (α : ↥(degreeFinset s q)) (h : (α.1.prod fun j e => y j ^ e) ∈ m ^ q) :
    betaStarPiece P m hPm y hqr hz q
      (grPieceMapBasis P m hPm _ hqr hz (degreeFinset s) (fun _ _ => mem_degreeFinset) q α) =
        Submodule.Quotient.mk ⟨α.1.prod fun j e => y j ^ e, h⟩ := by
  unfold betaStarPiece
  rw [Module.Basis.constr_basis]

variable {R : Type u} [CommRing R] (J P Q : Ideal R) (hJP : J ≤ P) (hPQ : P ≤ Q) {s : ℕ}
  (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))
  (hqr' : IsQuasiRegular fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j)))
  (hz' : Ideal.span (Set.range fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j))) =
      (Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))

/-- The two maps `β*` agree (p. 193: "`β*` maps the class of `ȳ_j` in `gr¹_{Q̄}(Ō)` to the class of
`y_j` in `gr¹_Q(R)`, and `β*'` to the class of `y'_j` in `gr¹_Q̄(O)`"): `β*'` is `β*` followed by
`gr_Q(R) → gr_Q̄(O)` (Lemma 5), through the identification `Ō = R/P = O/P̄` (`thetaEquiv`). -/
theorem grPieceMapQuot_betaStarPiece (q : ℕ) (z : GrPiece (Q.map (Ideal.Quotient.mk P)) q) :
    grPieceMapQuot J Q q (betaStarPiece P Q hPQ y hqr hz q z) =
      betaStarPiece (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' q
        (thetaEquiv J P Q hJP q z) := by
  classical
  let bR := grPieceMapBasis P Q hPQ _ hqr hz (degreeFinset s) (fun _ _ => mem_degreeFinset) q
  let bO := grPieceMapBasis (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
    (Ideal.map_mono hPQ) _ hqr' hz' (degreeFinset s) (fun _ _ => mem_degreeFinset) q
  let L₁ : GrPiece (Q.map (Ideal.Quotient.mk P)) q →ₗ[R] GrPiece (Q.map (Ideal.Quotient.mk J)) q :=
    (grPieceMapQuot J Q q) ∘ₗ (betaStarPiece P Q hPQ y hqr hz q).restrictScalars R
  let L₂ : GrPiece (Q.map (Ideal.Quotient.mk P)) q →ₗ[R] GrPiece (Q.map (Ideal.Quotient.mk J)) q :=
    (betaStarPiece (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
      (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' q).restrictScalars R ∘ₗ
      (thetaEquiv J P Q hJP q).toLinearMap
  have hspan : Submodule.span R (Set.range bR) = ⊤ := by
    rw [← Submodule.restrictScalars_span R (R ⧸ Q) Ideal.Quotient.mk_surjective, bR.span_eq]
    rfl
  have hL : L₁ = L₂ := by
    refine LinearMap.ext_on hspan ?_
    rintro _ ⟨α, rfl⟩
    have hmR : (α.1.prod fun j e => (Ideal.Quotient.mk P (y j)) ^ e) ∈
        (Q.map (Ideal.Quotient.mk P)) ^ q := by
      have := mono_mem_span_pow (fun j => Ideal.Quotient.mk P (y j)) α.1
      rwa [(mem_degreeFinset.mp α.2), hz] at this
    have hmO : (α.1.prod fun j e => (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
        (Ideal.Quotient.mk J (y j))) ^ e) ∈
        ((Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J)))) ^ q := by
      have := mono_mem_span_pow (fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
        (Ideal.Quotient.mk J (y j))) α.1
      rwa [(mem_degreeFinset.mp α.2), hz'] at this
    have hbR : bR α = Submodule.Quotient.mk ⟨_, hmR⟩ :=
      grPieceMapBasis_apply P Q hPQ _ hqr hz (degreeFinset s) (fun _ _ => mem_degreeFinset) q α hmR
    have hbO : bO α = Submodule.Quotient.mk ⟨_, hmO⟩ :=
      grPieceMapBasis_apply (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPQ) _ hqr' hz' (degreeFinset s) (fun _ _ => mem_degreeFinset) q α hmO
    have hmono : (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm
        (α.1.prod fun j e => (Ideal.Quotient.mk P (y j)) ^ e) =
        α.1.prod fun j e => (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
          (Ideal.Quotient.mk J (y j))) ^ e := by
      simp only [Finsupp.prod, map_prod, map_pow, DoubleQuot.quotQuotEquivQuotOfLE_symm_mk]
      rfl
    have hΘ : thetaEquiv J P Q hJP q (bR α) = bO α := by
      rw [hbR, hbO, thetaEquiv_mk J P Q hJP q _ hmR (hmono ▸ hmO)]
      exact congrArg _ (Subtype.ext hmono)
    have hmQ : (α.1.prod fun j e => y j ^ e) ∈ Q ^ q :=
      prod_pow_mem_pow_of_span_le Q y (span_range_le_of_span_map_eq P Q hPQ y hz) q α.1
        (mem_degreeFinset.mp α.2)
    have hmQ' : (α.1.prod fun j e => (Ideal.Quotient.mk J (y j)) ^ e) ∈
        (Q.map (Ideal.Quotient.mk J)) ^ q :=
      prod_pow_mem_pow_of_span_le (Q.map (Ideal.Quotient.mk J)) (fun j => Ideal.Quotient.mk J (y j))
        (span_range_le_of_span_map_eq (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
          (Ideal.map_mono hPQ) _ hz') q α.1 (mem_degreeFinset.mp α.2)
    show grPieceMapQuot J Q q (betaStarPiece P Q hPQ y hqr hz q (bR α)) =
      betaStarPiece (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' q
        (thetaEquiv J P Q hJP q (bR α))
    rw [hΘ, betaStarPiece_basis P Q hPQ y hqr hz q α hmQ,
      betaStarPiece_basis (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
        (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' q α hmQ',
      grPieceMapQuot_mk]
    exact congrArg _ (Subtype.ext (by simp [Finsupp.prod, map_prod, map_pow]))
  exact LinearMap.congr_fun hL z

/-- The lower square of the diagram commutes: `gr_Q(R) → gr_Q̄(O)` after `ψ` is `ψ'` after
`gr_P(R) ⊗ G → gr_{P̄}(O) ⊗ G` (p. 193: "the systems `(y₁, …, y_s)` and `(y'₁, …, y'_s)` determine the
following commutative diagram"). -/
theorem grPieceMapQuot_psiTildeR (n : ℕ) (a : ⨁ pq, SummandR P Q n pq) :
    grPieceMapQuot J Q n (psiTildeR P Q hPQ y hqr hz n a) =
      psiTildeO P Q hPQ y hqr' hz' n (mapRO J P Q hJP n a) := by
  have h : (grPieceMapQuot J Q n).comp (psiTildeR P Q hPQ y hqr hz n) =
      (psiTildeO P Q hPQ y hqr' hz' n).comp (mapRO J P Q hJP n) := by
    refine DirectSum.linearMap_ext R fun pq => TensorProduct.ext' fun x z => ?_
    simp only [LinearMap.comp_apply, psiTildeR_lof_tmul, mapRO, DirectSum.lmap_lof,
      tensorMapRO_tmul, psiTildeO_lof_tmul, grPieceMapQuot_castDeg, grPieceMapQuot_mulPieceQuot,
      grPieceMapQuot_grPieceInclusion, grPieceMapQuot_betaStarPiece J P Q hJP hPQ y hqr hz hqr' hz']
  exact LinearMap.congr_fun h a

end BetaStar

section DoublePrime

variable {R : Type u} [CommRing R] (J P Q : Ideal R) (hJP : J ≤ P) (hPQ : P ≤ Q) {s : ℕ}
  (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))
  (hqr' : IsQuasiRegular fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j)))
  (hz' : Ideal.span (Set.range fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j))) =
      (Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))

/-- `ψ'' : gr⁰_Q(gr_P(J, R)) ⊗ gr_Q̄(Ō) → gr_Q(J, R)` (first row of the diagram, total degree `n`):
the restriction of `ψ` to the image of the first vertical arrow (p. 193: "By virtue of Lemma 5, the
homomorphism `α` maps the ideal `gr⁰_Q(gr_P(J, R))` into the ideal `gr_Q(J, R)`": the image of
`gr_P(J, R) ⊗ G` in `gr_P(O) ⊗ G` is zero, and the kernel of `gr_Q(R) → gr_Q̄(O)` is `gr_Q(J, R)`). -/
noncomputable def psiDoublePrime (n : ℕ) :
    (⨁ pq, SummandJ J P Q n pq) →ₗ[R] ↥(grIdealPiece J Q n) :=
  ((psiTildeR P Q hPQ y hqr hz n) ∘ₗ (mapJR J P Q n)).codRestrict (grIdealPiece J Q n) (fun a => by
    rw [← grPieceMapQuot_eq_zero_iff, LinearMap.comp_apply,
      grPieceMapQuot_psiTildeR J P Q hJP hPQ y hqr hz hqr' hz',
      ((mapJR_mapRO_exact J P Q hJP n) (mapJR J P Q n a)).mpr ⟨a, rfl⟩, map_zero])

variable [IsRegularLocalRing R] [P.IsPrime] [Q.IsPrime] [IsRegularLocalRing (R ⧸ P)]
  [IsRegularLocalRing (R ⧸ Q)]

/-- p. 194: "Therefore, it follows from the diagram that `ψ'` is isomorphic if and only if `ψ''` is
surjective."  Here "`ψ'` is isomorphic" is "bijective in each total degree `n`"; the hypotheses
`hqr`, `hz`, `hqr'`, `hz'` are those of `psiDeg` for `R`, `P`, `Q` and for `O`, `P̄`, `Q̄`, and
`hQY : Q = P + (y)`.  The proof applies `bijective_iff_surjective_of_exact_columns` to the diagram:
exact left column (`mapJR_mapRO_exact`, right exactness of the tensor product), exact right column
(Lemma 5, `exact_subtype_grPieceMapQuot`), `ψ` bijective (Proposition 1 (1), as `gr_P(R)` is flat:
`R/P` is regular) and `ψ'` surjective (Proposition 1, `psiDeg_surjective`). -/
theorem bijective_psiDeg_iff_surjective_psiDoublePrime
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) (n : ℕ) :
    Function.Bijective (psiDeg (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
      (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) hqr' hz' n) ↔
        Function.Surjective (psiDoublePrime J P Q hJP hPQ y hqr hz hqr' hz' n) := by
  rw [← bijective_psiTildeO_iff P Q hPQ y hqr' hz' n]
  let _ : ∀ pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n}, AddCommGroup (SummandJ J P Q n pq) :=
    fun _ => TensorProduct.addCommGroup
  let _ : ∀ pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n}, AddCommGroup (SummandR P Q n pq) :=
    fun _ => TensorProduct.addCommGroup
  let _ : ∀ pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n}, AddCommGroup (SummandO J P Q n pq) :=
    fun _ => TensorProduct.addCommGroup
  refine bijective_iff_surjective_of_exact_columns (mapJR J P Q n) (mapRO J P Q hJP n)
    (grIdealPiece J Q n).subtype (grPieceMapQuot J Q n) (psiDoublePrime J P Q hJP hPQ y hqr hz hqr' hz' n)
    (psiTildeR P Q hPQ y hqr hz n) (psiTildeO P Q hPQ y hqr' hz' n)
    (mapJR_mapRO_exact J P Q hJP n) (mapRO_surjective J P Q hJP n) Subtype.val_injective
    (exact_subtype_grPieceMapQuot J Q n) (fun a => rfl)
    (fun a => (grPieceMapQuot_psiTildeR J P Q hJP hPQ y hqr hz hqr' hz' n a).symm) ?_ ?_
  · rw [bijective_psiTildeR_iff]
    exact psiDeg_bijective_of_isNormallyFlatAlongIdeal P Q hPQ y hqr hz
      (isNormallyFlatAlongIdeal_of_isRegularLocalRing_quotient P) hQY n
  · exact surjective_psiTildeO_of_surjective P Q hPQ y hqr' hz' n
      (psiDeg_surjective _ _ _ _ hqr' hz' (map_eq_sup_span_map J P Q y hQY) n)

end DoublePrime

end Compat

/-! ### The homomorphism `γ : gr_P(R) → gr_Q(R)` (p. 194) -/

section Gamma

open Polynomial

variable {A : Type u} [CommRing A] (P Q : Ideal A)

theorem reesAlgebra_mono (hPQ : P ≤ Q) : reesAlgebra P ≤ reesAlgebra Q := fun f hf =>
  (mem_reesAlgebra_iff Q f).mpr fun i =>
    Ideal.pow_right_mono hPQ i ((mem_reesAlgebra_iff P f).mp hf i)

/-- p. 194: "Let `γ` be the canonical homomorphism of graded `Ō`-algebras `γ: gr_P(R) → gr_Q(R)`
(which induces the above homomorphism `α`)" and "(In fact, `γ` is induced by the inclusion of `Pᵛ`
into `Qᵛ`)". -/
noncomputable def gammaMap (hPQ : P ≤ Q) : AssocGraded P →ₐ[A] AssocGraded Q :=
  Ideal.quotientMapₐ (I := Ideal.map (algebraMap A (reesAlgebra P)) P)
    (Ideal.map (algebraMap A (reesAlgebra Q)) Q)
    (Subalgebra.inclusion (reesAlgebra_mono P Q hPQ)) (by
      intro x hx
      rw [Ideal.mem_comap, mem_map_algebraMap_reesAlgebra_iff]
      rw [mem_map_algebraMap_reesAlgebra_iff] at hx
      intro n
      exact Ideal.pow_right_mono hPQ (n + 1) (hx n))

/-- `γ` sends the class of `a Xⁿ` in `gr_P(A)` to the class of `a Xⁿ` in `gr_Q(A)`. -/
theorem gammaMap_mk (hPQ : P ≤ Q) (n : ℕ) (a : A) (ha : a ∈ P ^ n) :
    gammaMap P Q hPQ (AssocGraded.mk P n a ha) =
      AssocGraded.mk Q n a (Ideal.pow_right_mono hPQ n ha) :=
  rfl

/-- In degree `p`, `γ` is the map `grᵖ_P(A) → grᵖ_Q(A)` induced by `Pᵖ ⊆ Qᵖ`
(`grPieceInclusion`, the map `α` of p. 183 before dividing by `Q grᵖ_P(A)`). -/
theorem gammaMap_ofGrPiece (hPQ : P ≤ Q) (p : ℕ) (x : GrPiece P p) :
    gammaMap P Q hPQ (AssocGraded.ofGrPiece P p x) =
      AssocGraded.ofGrPiece Q p (grPieceInclusion P Q hPQ p x) := by
  induction x using Submodule.Quotient.induction_on with
  | H a => rfl

theorem ofGrPiece_castDeg (I : Ideal A) {a b : ℕ} (h : a = b) (x : GrPiece I a) :
    AssocGraded.ofGrPiece I b (GrPiece.castDeg I h x) = AssocGraded.ofGrPiece I a x := by
  subst h
  rfl

/-- The product of `gr_I(A)` in terms of the pieces: `[a] · [b] = [ab]`. -/
theorem ofGrPiece_mulPieceQuot (I : Ideal A) (p q : ℕ) (a : GrPiece I p) (b : GrPiece I q) :
    AssocGraded.ofGrPiece I (p + q) (GrPiece.mulPieceQuot I p q a b) =
      AssocGraded.ofGrPiece I p a * AssocGraded.ofGrPiece I q b := by
  induction a using Submodule.Quotient.induction_on with
  | H a =>
    induction b using Submodule.Quotient.induction_on with
    | H b =>
      exact (AssocGraded.mk_mul_mk I a.2 b.2).symm

end Gamma

/-! ### The image of `ψ''` (p. 194) -/

section Image

variable {R : Type u} [CommRing R] (J P Q : Ideal R) (hJP : J ≤ P) (hPQ : P ≤ Q) {s : ℕ}
  (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))

theorem psiTildeR_mapJR_lof_tmul (n : ℕ) (pq : {pq : ℕ × ℕ // pq.1 + pq.2 = n})
    (u : ↥(grIdealPiece J P pq.1.1)) (z : GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2) :
    psiTildeR P Q hPQ y hqr hz n (mapJR J P Q n (DirectSum.lof R _ (SummandJ J P Q n) pq (u ⊗ₜ z))) =
      GrPiece.castDeg Q pq.2 (GrPiece.mulPieceQuot Q pq.1.1 pq.1.2
        (grPieceInclusion P Q hPQ pq.1.1 u.1) (betaStarPiece P Q hPQ y hqr hz pq.1.2 z)) := by
  rw [mapJR, DirectSum.lmap_lof, LinearMap.rTensor_tmul]
  exact psiTildeR_lof_tmul P Q hPQ y hqr hz n pq u.1 z

/-- "As is easily seen, the image of `ψ''` is a graded ideal in `gr_Q(R)` which is generated by the
image of `gr_P(J, R)` by `γ`", first half: the image of `ψ''` lies in the ideal of `gr_Q(R)`
generated by `γ(gr_P(J, R))`.  (An element of the image is a sum of products `α(u) β*(z)` with
`u ∈ gr_P(J, R)`, and `α = γ`.) -/
theorem ofGrPiece_psiTildeR_mapJR_mem (n : ℕ) (a : ⨁ pq, SummandJ J P Q n pq) :
    AssocGraded.ofGrPiece Q n (psiTildeR P Q hPQ y hqr hz n (mapJR J P Q n a)) ∈
      Ideal.map (gammaMap P Q hPQ) (grIdeal P J) := by
  refine DirectSum.induction_on a (by simp) (fun pq t => ?_) (fun a b ha hb => ?_)
  · have key : ∀ t : ↥(grIdealPiece J P pq.1.1) ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2,
        AssocGraded.ofGrPiece Q n (psiTildeR P Q hPQ y hqr hz n
          (mapJR J P Q n (DirectSum.of (SummandJ J P Q n) pq t))) ∈
            Ideal.map (gammaMap P Q hPQ) (grIdeal P J) := by
      intro t
      induction t with
      | tmul u z =>
        rw [← DirectSum.lof_eq_of R, psiTildeR_mapJR_lof_tmul, ofGrPiece_castDeg,
          ofGrPiece_mulPieceQuot, ← gammaMap_ofGrPiece]
        refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_)
        obtain ⟨a, haJ, ha, hu⟩ := u.2
        rw [← hu, AssocGraded.ofGrPiece_mk]
        exact mk_mem_grIdeal P haJ ha
      | add t₁ t₂ h₁ h₂ =>
        rw [map_add, map_add, map_add, map_add]
        exact add_mem h₁ h₂
    exact key t
  · rw [map_add, map_add, map_add]
    exact add_mem ha hb

theorem mulPieceQuot_mem_grIdealPiece {p p' : ℕ} {u : GrPiece P p} (hu : u ∈ grIdealPiece J P p)
    (x : GrPiece P p') : GrPiece.mulPieceQuot P p p' u x ∈ grIdealPiece J P (p + p') := by
  obtain ⟨j, hjJ, hj, rfl⟩ := hu
  induction x using Submodule.Quotient.induction_on with
  | H b =>
    exact ⟨j * b.1, J.mul_mem_right _ hjJ, by rw [pow_add]; exact Ideal.mul_mem_mul hj b.2, rfl⟩

/-- "As is easily seen, the image of `ψ''` is a graded ideal in `gr_Q(R)` which is generated by the
image of `gr_P(J, R)` by `γ`", second half: the image of `ψ''` is stable under multiplication by
`gr_Q(R)`.  Indeed `ψ` is surjective, so every element of `gr^q_Q(R)` is a sum of products
`α(x) β*(z)`, and `α(u) · α(x) β*(z) = α(u x) β*(z)` with `u x ∈ gr_P(J, R)`. -/
theorem exists_mapJR_eq_mulPieceQuot
    (hψ : ∀ q, Function.Surjective (psiTildeR P Q hPQ y hqr hz q)) {n : ℕ} (p q : ℕ) (h : p + q = n)
    (u : GrPiece P p) (hu : u ∈ grIdealPiece J P p) (z : GrPiece Q q) :
    ∃ a : ⨁ pq, SummandJ J P Q n pq,
      psiTildeR P Q hPQ y hqr hz n (mapJR J P Q n a) =
        GrPiece.castDeg Q h (GrPiece.mulPieceQuot Q p q (grPieceInclusion P Q hPQ p u) z) := by
  subst h
  rw [show GrPiece.castDeg Q rfl (GrPiece.mulPieceQuot Q p q (grPieceInclusion P Q hPQ p u) z) =
    GrPiece.mulPieceQuot Q p q (grPieceInclusion P Q hPQ p u) z from rfl]
  obtain ⟨w, rfl⟩ := hψ q z
  refine DirectSum.induction_on w ⟨0, by simp⟩ (fun pq' t => ?_) ?_
  · have key : ∀ t : GrPiece P pq'.1.1 ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) pq'.1.2,
        ∃ a : ⨁ pq, SummandJ J P Q (p + q) pq,
          psiTildeR P Q hPQ y hqr hz (p + q) (mapJR J P Q (p + q) a) =
            GrPiece.mulPieceQuot Q p q (grPieceInclusion P Q hPQ p u)
              (psiTildeR P Q hPQ y hqr hz q (DirectSum.of (SummandR P Q q) pq' t)) := by
      intro t
      induction t with
      | tmul x' y' =>
        obtain ⟨⟨p', q'⟩, hq⟩ := pq'
        have hq' : p' + q' = q := hq
        refine ⟨DirectSum.lof R _ (SummandJ J P Q (p + q)) ⟨(p + p', q'), by
          show p + p' + q' = p + q
          omega⟩ (⟨GrPiece.mulPieceQuot P p p' u x', mulPieceQuot_mem_grIdealPiece J P hu x'⟩ ⊗ₜ y'),
          ?_⟩
        rw [← DirectSum.lof_eq_of R, psiTildeR_mapJR_lof_tmul, psiTildeR_lof_tmul]
        refine AssocGraded.ofGrPiece_injective Q (p + q) ?_
        simp only [ofGrPiece_castDeg, ofGrPiece_mulPieceQuot, ← gammaMap_ofGrPiece P Q hPQ, map_mul]
        ring
      | add t₁ t₂ h₁ h₂ =>
        obtain ⟨a₁, h₁⟩ := h₁
        obtain ⟨a₂, h₂⟩ := h₂
        exact ⟨a₁ + a₂, by simp only [map_add, h₁, h₂]⟩
    exact key t
  · rintro w₁ w₂ ⟨a₁, h₁⟩ ⟨a₂, h₂⟩
    exact ⟨a₁ + a₂, by simp only [map_add, h₁, h₂]⟩

end Image

/-! ### The image of `ψ''` is the ideal generated by `γ(gr_P(J, R))` (p. 194) -/

section ImageIdeal

variable {R : Type u} [CommRing R] (J P Q : Ideal R) (hPQ : P ≤ Q) {s : ℕ} (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))

/-- The image of `ψ''` in degree `n`: a submodule of `gr^n_Q(R)`. -/
noncomputable def psiDoublePrimeRange (n : ℕ) : Submodule R (GrPiece Q n) :=
  LinearMap.range ((psiTildeR P Q hPQ y hqr hz n) ∘ₗ (mapJR J P Q n))

/-- The image of `ψ''`: the sum of the homogeneous images, a submodule of `gr_Q(R)`. -/
noncomputable def psiDoublePrimeImage : Submodule R (AssocGraded Q) :=
  ⨆ n, (psiDoublePrimeRange J P Q hPQ y hqr hz n).map
    ((AssocGraded.ofGrPiece Q n).restrictScalars R)

/-- The image of `ψ''` in degree `n` is stable under multiplication by `gr^i_Q(R)`. -/
theorem mulPieceQuot_mem_psiDoublePrimeRange
    (hψ : ∀ q, Function.Surjective (psiTildeR P Q hPQ y hqr hz q)) (i n : ℕ) (x : GrPiece Q i)
    {k : GrPiece Q n} (hk : k ∈ psiDoublePrimeRange J P Q hPQ y hqr hz n) :
    GrPiece.mulPieceQuot Q i n x k ∈ psiDoublePrimeRange J P Q hPQ y hqr hz (i + n) := by
  obtain ⟨a, rfl⟩ := hk
  show GrPiece.mulPieceQuot Q i n x (psiTildeR P Q hPQ y hqr hz n (mapJR J P Q n a)) ∈ _
  refine DirectSum.induction_on a (by simp) (fun pq t => ?_)
    (fun a b ha hb => ?_)
  · have key : ∀ t : ↥(grIdealPiece J P pq.1.1) ⊗[R] GrPiece (Q.map (Ideal.Quotient.mk P)) pq.1.2,
        GrPiece.mulPieceQuot Q i n x (psiTildeR P Q hPQ y hqr hz n
          (mapJR J P Q n (DirectSum.of (SummandJ J P Q n) pq t))) ∈
            psiDoublePrimeRange J P Q hPQ y hqr hz (i + n) := by
      intro t
      induction t with
      | tmul u w =>
        rw [← DirectSum.lof_eq_of R, psiTildeR_mapJR_lof_tmul]
        obtain ⟨⟨p, q⟩, hpq⟩ := pq
        have hpq' : p + q = n := hpq
        obtain ⟨a', ha'⟩ := exists_mapJR_eq_mulPieceQuot J P Q hPQ y hqr hz hψ p (i + q)
          (by omega : p + (i + q) = i + n) u.1 u.2
          (GrPiece.mulPieceQuot Q i q x (betaStarPiece P Q hPQ y hqr hz q w))
        refine ⟨a', ?_⟩
        show psiTildeR P Q hPQ y hqr hz (i + n) (mapJR J P Q (i + n) a') = _
        rw [ha']
        refine AssocGraded.ofGrPiece_injective Q (i + n) ?_
        simp only [ofGrPiece_castDeg, ofGrPiece_mulPieceQuot]
        ring
      | add t₁ t₂ h₁ h₂ =>
        rw [map_add, map_add, map_add, map_add]
        exact add_mem h₁ h₂
    exact key t
  · rw [map_add, map_add, map_add]
    exact add_mem ha hb

/-- The image of `ψ''` is stable under multiplication by `gr_Q(R)`: it is an ideal. -/
theorem mul_mem_psiDoublePrimeImage
    (hψ : ∀ q, Function.Surjective (psiTildeR P Q hPQ y hqr hz q)) (c : AssocGraded Q)
    {z : AssocGraded Q} (hz' : z ∈ psiDoublePrimeImage J P Q hPQ y hqr hz) :
    c * z ∈ psiDoublePrimeImage J P Q hPQ y hqr hz := by
  obtain ⟨d, rfl⟩ := (toGr_bijective Q).2 c
  have key : ∀ d : DirectSum ℕ (fun n => GrPiece Q n), ∀ z, z ∈ psiDoublePrimeImage J P Q hPQ y hqr hz →
      toGr Q d * z ∈ psiDoublePrimeImage J P Q hPQ y hqr hz := by
    intro d
    refine DirectSum.induction_on d (fun z _ => by simp) (fun i x z hz'' => ?_)
      (fun d₁ d₂ h₁ h₂ z hz'' => ?_)
    · refine Submodule.iSup_induction _ (motive := fun z => toGr Q (DirectSum.of _ i x) * z ∈
        psiDoublePrimeImage J P Q hPQ y hqr hz) hz'' (fun n z hzn => ?_) (by simp)
        (fun a b ha hb => by rw [mul_add]; exact add_mem ha hb)
      obtain ⟨k, hk, rfl⟩ := hzn
      refine Submodule.mem_iSup_of_mem (i + n)
        (Submodule.mem_map.mpr ⟨GrPiece.mulPieceQuot Q i n x k,
          mulPieceQuot_mem_psiDoublePrimeRange J P Q hPQ y hqr hz hψ i n x hk, ?_⟩)
      show AssocGraded.ofGrPiece Q (i + n) (GrPiece.mulPieceQuot Q i n x k) = _
      rw [ofGrPiece_mulPieceQuot]
      rw [← DirectSum.lof_eq_of (R ⧸ Q), toGr, DirectSum.toModule_lof]
      rfl
    · rw [map_add, add_mul]
      exact add_mem (h₁ z hz'') (h₂ z hz'')
  exact key d z hz'

theorem ofGrPiece_zero_one : AssocGraded.ofGrPiece Q 0
    (Submodule.Quotient.mk ⟨1, by simp⟩ : GrPiece Q 0) = 1 := by
  show AssocGraded.mk Q 0 1 (by simp) = 1
  exact congrArg (Ideal.Quotient.mk _) (Subtype.ext (by simp))

/-- **"As is easily seen, the image of `ψ''` is a graded ideal in `gr_Q(R)` which is generated by
the image of `gr_P(J, R)` by `γ`"** (p. 194), as one statement: the image of `ψ''` (the sum of its
homogeneous components) is the ideal of `gr_Q(R)` generated by `γ(gr_P(J, R))`. -/
theorem psiDoublePrimeImage_eq_map_gammaMap
    (hψ : ∀ q, Function.Surjective (psiTildeR P Q hPQ y hqr hz q)) :
    psiDoublePrimeImage J P Q hPQ y hqr hz =
      (Ideal.map (gammaMap P Q hPQ) (grIdeal P J)).restrictScalars R := by
  apply le_antisymm
  · -- the image lies in the ideal: a sum of products `α(u) β*(z)`, `u ∈ gr_P(J, R)`, `α = γ`
    refine iSup_le fun n => ?_
    rintro _ ⟨k, ⟨a, rfl⟩, rfl⟩
    exact ofGrPiece_psiTildeR_mapJR_mem J P Q hPQ y hqr hz n a
  · -- the image is an ideal containing `γ(gr_P(J, R))`
    let V : Ideal (AssocGraded Q) :=
      { psiDoublePrimeImage J P Q hPQ y hqr hz with
        smul_mem' := fun c z hz'' => by
          rw [smul_eq_mul]
          exact mul_mem_psiDoublePrimeImage J P Q hPQ y hqr hz hψ c hz'' }
    show Ideal.map (gammaMap P Q hPQ) (grIdeal P J) ≤ V
    rw [Ideal.map_le_iff_le_comap, grIdeal, Ideal.span_le]
    rintro _ ⟨f, hf, rfl⟩
    show gammaMap P Q hPQ (initialForm P f) ∈ V
    by_cases htop : Ideal.ordElem P f = ⊤
    · simp [initialForm, htop]
    · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
      have hfP : f ∈ P ^ ν := Ideal.mem_pow_of_ordElem hν.symm
      obtain ⟨a, ha⟩ := exists_mapJR_eq_mulPieceQuot J P Q hPQ y hqr hz hψ ν 0 (n := ν) (by omega)
        (Submodule.Quotient.mk ⟨f, hfP⟩) ⟨f, hf, hfP, rfl⟩ (Submodule.Quotient.mk ⟨1, by simp⟩)
      rw [initialForm_eq_mk P hν.symm]
      refine Submodule.mem_iSup_of_mem ν (Submodule.mem_map.mpr ⟨_, ⟨a, rfl⟩, ?_⟩)
      show AssocGraded.ofGrPiece Q ν (psiTildeR P Q hPQ y hqr hz ν (mapJR J P Q ν a)) = _
      rw [ha, ofGrPiece_castDeg, ofGrPiece_mulPieceQuot, ofGrPiece_zero_one, mul_one,
        ← AssocGraded.ofGrPiece_mk P ν ⟨f, hfP⟩, gammaMap_ofGrPiece]

end ImageIdeal

/-! ### Transversality of the `P`-adic and `Q`-adic filtrations (the claim `Φ ∈ Q^{μ-ν} gr_P(R)`
of p. 194)

The paper asserts, for `f ∈ J` with `ν = ν_P(f) < μ = ν_Q(f)`, that the initial form `Φ` of `f`
in `gr_P(R)` satisfies `Φ ∈ Q^{μ-ν} gr_P(R)`, without argument.  It is the statement
`Pᵛ ∩ Q^{ν+k} ⊆ Qᵏ Pᵛ + Pᵛ⁺¹`, which follows from the transversality
`Pᵃ ∩ Qᴺ ⊆ Σ_p P^{max(p,a)} Yᴺ⁻ᵖ` (`Q = P + Y`, `Y = (y₁, …, y_s)`).  The proof uses the
descent and Krull's intersection theorem of p. 185 ("Repeating this argument, we have
`λ ∈ Σ PˢFᵗ + F^{q+m}` for all positive integer `m`. Hence `λ ∈ Σ PˢFᵗ`"). -/

section Transversality

section IdealSums

variable {A : Type*} [CommRing A]

theorem ideal_sum_le {ι : Type*} (s : Finset ι) (I : ι → Ideal A) {K : Ideal A}
    (h : ∀ i ∈ s, I i ≤ K) : ∑ i ∈ s, I i ≤ K :=
  Finset.sum_induction I (· ≤ K) (fun _ _ h₁ h₂ => by rw [Submodule.add_eq_sup]; exact sup_le h₁ h₂)
    bot_le h

theorem le_ideal_sum {ι : Type*} {s : Finset ι} (I : ι → Ideal A) {a : ι} (ha : a ∈ s) :
    I a ≤ ∑ b ∈ s, I b := by
  classical
  rw [← Finset.add_sum_erase s I ha, Submodule.add_eq_sup]
  exact le_sup_left

theorem exists_eq_sum_of_mem_ideal_sum {ι : Type*} (s : Finset ι) (I : ι → Ideal A) {g : A}
    (hg : g ∈ ∑ a ∈ s, I a) : ∃ u : ι → A, (∀ a ∈ s, u a ∈ I a) ∧ ∑ a ∈ s, u a = g := by
  classical
  induction s using Finset.induction_on generalizing g with
  | empty =>
    rw [Finset.sum_empty, Submodule.zero_eq_bot, Submodule.mem_bot] at hg
    exact ⟨0, by simp, by simp [hg]⟩
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Submodule.add_eq_sup, Submodule.mem_sup] at hg
    obtain ⟨y, hy, z, hz, rfl⟩ := hg
    obtain ⟨u, hu, rfl⟩ := ih hz
    refine ⟨Function.update u a y, fun b hb => ?_, ?_⟩
    · rcases Finset.mem_insert.mp hb with rfl | hb
      · simpa using hy
      · rw [Function.update_of_ne (ne_of_mem_of_not_mem hb ha)]
        exact hu b hb
    · rw [Finset.sum_insert ha, Function.update_self]
      congr 1
      exact Finset.sum_congr rfl fun b hb =>
        Function.update_of_ne (ne_of_mem_of_not_mem hb ha) _ _

/-- `(P ⊔ Y)ᵏ ⊆ Σ_{a ≤ k} Pᵃ Yᵏ⁻ᵃ`. -/
theorem sup_pow_le_sum_mul (P Y : Ideal A) (k : ℕ) :
    (P ⊔ Y) ^ k ≤ ∑ a ∈ Finset.range (k + 1), P ^ a * Y ^ (k - a) := by
  rw [← Submodule.add_eq_sup, add_pow]
  exact ideal_sum_le _ _ fun a ha =>
    Ideal.mul_le_left.trans (le_ideal_sum (fun a => P ^ a * Y ^ (k - a)) ha)

end IdealSums

section QuasiRegular

open MvPolynomial in
/-- Quasi-regularity in coordinates: if `Σ_{|α| = q} c_α z^α ∈ (z)^(q+1)`, all `c_α ∈ (z)`. -/
theorem coeff_mem_span_of_sum_mono_mem {A : Type*} [CommRing A] {s : ℕ} {z : Fin s → A}
    (hqr : IsQuasiRegular z) (q : ℕ) (c : (Fin s →₀ ℕ) → A)
    (h : ∑ α ∈ degreeFinset s q, c α * (α.prod fun j e => z j ^ e) ∈
      Ideal.span (Set.range z) ^ (q + 1)) :
    ∀ α ∈ degreeFinset s q, c α ∈ Ideal.span (Set.range z) := by
  classical
  let F : MvPolynomial (Fin s) A := ∑ α ∈ degreeFinset s q, monomial α (c α)
  have hF : F.IsHomogeneous q :=
    MvPolynomial.IsHomogeneous.sum _ _ _ fun α hα =>
      isHomogeneous_monomial _ (mem_degreeFinset.mp hα)
  have hFe : eval z F = ∑ α ∈ degreeFinset s q, c α * (α.prod fun j e => z j ^ e) := by
    simp only [F, map_sum, eval_monomial]
  intro α hα
  have := hqr q F hF (hFe ▸ h) α
  rwa [show F.coeff α = c α by
    simp only [F, coeff_sum, coeff_monomial]
    rw [Finset.sum_eq_single α (fun β _ hβ => by simp [hβ]) (fun h' => absurd hα h')]
    simp]
    at this

variable {R : Type u} [CommRing R] (P : Ideal R) {s : ℕ} (y : Fin s → R)

/-- `c mod P` in `(ȳ)` means `c ∈ P + (y)`. -/
theorem mem_sup_span_of_mk_mem_span (c : R)
    (h : Ideal.Quotient.mk P c ∈ Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j))) :
    c ∈ P ⊔ Ideal.span (Set.range y) := by
  rw [show Set.range (fun j => Ideal.Quotient.mk P (y j)) =
    Ideal.Quotient.mk P '' Set.range y by rw [← Set.range_comp]; rfl, ← Ideal.map_span,
    Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at h
  obtain ⟨w, hw, hwc⟩ := h
  have : c - w ∈ P := Ideal.Quotient.eq.mp hwc.symm
  have hc : c = w + (c - w) := by ring
  rw [hc]
  exact Ideal.add_mem _ (Ideal.mem_sup_right hw) (Ideal.mem_sup_left this)

end QuasiRegular

section CoreLemma

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (P : Ideal R) {s : ℕ}
  (y : Fin s → R)

/-- The core of the transversality of the `P`-adic and `Q`-adic filtrations: `Pᵃ Yᵈ ∩ Pᵃ⁺¹ ⊆
Pᵃ⁺¹ Yᵈ + Pᵃ Yᵈ⁺¹` (`Y = (y)`, the `ȳ_j` quasi-regular in `R/P` and `gr_P(R)` flat over `R/P`).
An element of `Pᵃ Yᵈ` is `Σ_{|α| = d} g_α y^α` with `g_α ∈ Pᵃ`; the classes of the `g_α` in the
free `R/P`-module `grᵃ_P(R)` satisfy `Σ ḡ_α ȳ^α = 0` (as the element lies in `Pᵃ⁺¹`), so by the
quasi-regularity of `ȳ` each `ḡ_α` lies in `(ȳ)grᵃ_P(R)`, i.e. `g_α ∈ (P + Y)Pᵃ`. -/
theorem mem_sup_of_mem_mul_inf (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (a d : ℕ) {b : R}
    (hb : b ∈ P ^ a * Ideal.span (Set.range y) ^ d) (hbP : b ∈ P ^ (a + 1)) :
    b ∈ P ^ (a + 1) * Ideal.span (Set.range y) ^ d ⊔
      P ^ a * Ideal.span (Set.range y) ^ (d + 1) := by
  classical
  have hD : ∀ q α, α ∈ degreeFinset s q ↔ α.degree = q := fun _ _ => mem_degreeFinset
  obtain ⟨g, hg, hbg⟩ := exists_eq_sum_mono_of_mem y (degreeFinset s) hD (P ^ a) d hb
  have hfree := hP a
  let e : Module.Basis (Module.Free.ChooseBasisIndex (R ⧸ P) (GrPiece P a)) (R ⧸ P)
    (GrPiece P a) := Module.Free.chooseBasis _ _
  obtain ⟨f, hf⟩ : ∃ f : Module.Free.ChooseBasisIndex (R ⧸ P) (GrPiece P a) → ↥(P ^ a),
      ∀ i, Submodule.Quotient.mk (f i) = e i :=
    ⟨fun i => (Submodule.Quotient.mk_surjective _ (e i)).choose,
      fun i => (Submodule.Quotient.mk_surjective _ (e i)).choose_spec⟩
  have hspan := pow_eq_span_of_basis P hPtop a e f hf
  have hC : ∀ α, ∃ c : Module.Free.ChooseBasisIndex (R ⧸ P) (GrPiece P a) → R,
      ∑ i, c i * (f i).1 = g α := fun α =>
    Ideal.mem_span_range_iff_exists_fun.mp (hspan ▸ hg α)
  choose C hC using hC
  -- `b = Σ_i W_i f_i`
  set W : Module.Free.ChooseBasisIndex (R ⧸ P) (GrPiece P a) → R := fun i =>
    ∑ α ∈ degreeFinset s d, C α i * (α.prod fun j e => y j ^ e) with hW
  have hbW : b = ∑ i, W i * (f i).1 := by
    rw [hbg]
    simp_rw [← hC, Finset.sum_mul, hW]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun α _ => by ring
  have hWP : ∀ i, W i ∈ P := coeff_mem_of_sum_mem_pow_succ P a e f hf W (hbW ▸ hbP)
  -- the coefficients `C α i` lie in `P ⊔ Y`
  have hCmem : ∀ α ∈ degreeFinset s d, ∀ i, C α i ∈ P ⊔ Ideal.span (Set.range y) := by
    intro α hα i
    have h0 : ∑ α ∈ degreeFinset s d, Ideal.Quotient.mk P (C α i) *
        (α.prod fun j e => (Ideal.Quotient.mk P (y j)) ^ e) ∈
          Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) ^ (d + 1) := by
      have : ∑ α ∈ degreeFinset s d, Ideal.Quotient.mk P (C α i) *
          (α.prod fun j e => (Ideal.Quotient.mk P (y j)) ^ e) = Ideal.Quotient.mk P (W i) := by
        rw [hW, map_sum]
        refine Finset.sum_congr rfl fun α _ => ?_
        rw [map_mul, map_finsuppProd]
        simp only [map_pow]
      rw [this, Ideal.Quotient.eq_zero_iff_mem.mpr (hWP i)]
      exact zero_mem _
    exact mem_sup_span_of_mk_mem_span P y _
      (coeff_mem_span_of_sum_mono_mem hqr d (fun α => Ideal.Quotient.mk P (C α i)) h0 α hα)
  -- hence `b ∈ ((P ⊔ Y) Pᵃ) Yᵈ`
  have hgmem : ∀ α ∈ degreeFinset s d, g α ∈ (P ⊔ Ideal.span (Set.range y)) * P ^ a := by
    intro α hα
    rw [← hC α]
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (hCmem α hα i) (f i).2
  have hbmem : b ∈ ((P ⊔ Ideal.span (Set.range y)) * P ^ a) * Ideal.span (Set.range y) ^ d := by
    rw [hbg]
    refine Ideal.sum_mem _ fun α hα => Ideal.mul_mem_mul (hgmem α hα) ?_
    have := mono_mem_span_pow y α
    rwa [(hD d α).mp hα] at this
  refine (?_ : ((P ⊔ Ideal.span (Set.range y)) * P ^ a) * Ideal.span (Set.range y) ^ d ≤ _) hbmem
  rw [Ideal.sup_mul, Ideal.sup_mul]
  refine sup_le (le_sup_of_le_left ?_) (le_sup_of_le_right ?_)
  · rw [pow_succ']
  · rw [pow_succ]
    refine le_of_eq ?_
    ring

end CoreLemma

section MixedPow

variable {R : Type u} [CommRing R] (P : Ideal R) {s : ℕ} (y : Fin s → R)

/-- `Σ_{p ≤ N} P^{max(p, a)} Yᴺ⁻ᵖ` with `Y = (y)`: the ideal `Σ_p Pᵖ Yᴺ⁻ᵖ = (P + Y)ᴺ` with the
`P`-exponents raised to at least `a`. -/
def mixedPow (a N : ℕ) : Ideal R :=
  ∑ p ∈ Finset.range (N + 1), P ^ max p a * Ideal.span (Set.range y) ^ (N - p)

theorem mixedPow_le_pow (a N : ℕ) : mixedPow P y a N ≤ P ^ a :=
  ideal_sum_le _ _ fun _ _ =>
    Ideal.mul_le_left.trans (Ideal.pow_le_pow_right (le_max_right _ _))

theorem mixedPow_succ_le (a N : ℕ) : mixedPow P y a (N + 1) ≤ mixedPow P y a N := by
  refine ideal_sum_le _ _ fun p hp => ?_
  have hp' := Finset.mem_range.mp hp
  by_cases h : p ≤ N
  · refine le_trans ?_ (le_ideal_sum (fun p => P ^ max p a * Ideal.span (Set.range y) ^ (N - p))
      (Finset.mem_range.mpr (Nat.lt_succ_of_le h)))
    exact Ideal.mul_mono_right (Ideal.pow_le_pow_right (by omega))
  · have hp1 : p = N + 1 := by omega
    subst hp1
    refine le_trans ?_ (le_ideal_sum (fun p => P ^ max p a * Ideal.span (Set.range y) ^ (N - p))
      (Finset.mem_range.mpr (Nat.lt_succ_self N)))
    simp only [Nat.sub_self]
    exact Ideal.mul_mono_left (Ideal.pow_le_pow_right (by omega))

theorem pow_le_mixedPow_zero {Q : Ideal R} (hQY : Q = P ⊔ Ideal.span (Set.range y)) (N : ℕ) :
    Q ^ N ≤ mixedPow P y 0 N := by
  subst hQY
  refine (sup_pow_le_sum_mul P _ N).trans (ideal_sum_le _ _ fun p hp => ?_)
  have hm : mixedPow P y 0 N =
      ∑ p ∈ Finset.range (N + 1), P ^ p * Ideal.span (Set.range y) ^ (N - p) := by
    unfold mixedPow
    exact Finset.sum_congr rfl fun p _ => by rw [Nat.max_eq_left (Nat.zero_le p)]
  rw [hm]
  exact le_ideal_sum (fun p => P ^ p * Ideal.span (Set.range y) ^ (N - p)) hp

variable [IsLocalRing R] [IsNoetherianRing R]

/-- Krull's intersection theorem in the form `⋂ⱼ (T + Qʲ) = T`. -/
theorem mem_of_forall_mem_sup_pow {T Q : Ideal R} (hTQ : T ≤ Q) (hQ : Q ≠ ⊤) {x : R}
    (h : ∀ j, x ∈ T ⊔ Q ^ j) : x ∈ T := by
  have hTtop : T ≠ ⊤ := fun h' => hQ (top_le_iff.mp (h' ▸ hTQ))
  have : Nontrivial (R ⧸ T) := Ideal.Quotient.nontrivial_iff.mpr hTtop
  have : IsLocalRing (R ⧸ T) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk T) Ideal.Quotient.mk_surjective
  have hQ' : Q.map (Ideal.Quotient.mk T) ≠ ⊤ := by
    intro h1
    obtain ⟨q, hq, hq1⟩ := (Ideal.mem_map_iff_of_surjective _
      Ideal.Quotient.mk_surjective).mp (h1 ▸ Submodule.mem_top : (1 : R ⧸ T) ∈ _)
    have h2 : 1 - q ∈ T := Ideal.Quotient.eq.mp hq1.symm
    refine hQ ((Ideal.eq_top_iff_one _).mpr ?_)
    have : (1 : R) = q + (1 - q) := by ring
    rw [this]
    exact add_mem hq (hTQ h2)
  have hmem : Ideal.Quotient.mk T x ∈ ⨅ j : ℕ, (Q.map (Ideal.Quotient.mk T)) ^ j := by
    refine (Submodule.mem_iInf _).mpr fun j => ?_
    obtain ⟨t, ht, q, hq, rfl⟩ := Submodule.mem_sup.mp (h j)
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ht, zero_add, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hq
  rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ hQ'] at hmem
  exact Ideal.Quotient.eq_zero_iff_mem.mp ((Ideal.mem_bot).mp hmem)

end MixedPow

section Transversality

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (P Q : Ideal R) {s : ℕ}
  (y : Fin s → R)

/-- One step of the descent (the argument of p. 185 for `P ∩ Fᵠ`, here for `Pᵃ⁺¹ ∩ Qᴺ`): if
`Pᵃ ∩ Qᴺ ⊆ Σ_p P^{max(p,a)} Yᴺ⁻ᵖ` for all `N`, then an element of `Pᵃ⁺¹ ∩ Qᴺ` is, modulo
`Σ_p P^{max(p,a+1)} Yᴺ⁻ᵖ`, an element of `Qᴺ⁺¹`. -/
theorem exists_mem_mixedPow_succ_sub_mem_pow_succ (hP : IsNormallyFlatAlongIdeal P)
    (hPtop : P ≠ ⊤) (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) (a : ℕ)
    (hK : ∀ N, P ^ a ⊓ Q ^ N ≤ mixedPow P y a N) (N : ℕ) {x : R} (hxP : x ∈ P ^ (a + 1))
    (hxQ : x ∈ Q ^ N) : ∃ t ∈ mixedPow P y (a + 1) N, x - t ∈ Q ^ (N + 1) := by
  classical
  by_cases hN : N ≤ a
  · refine ⟨0, zero_mem _, ?_⟩
    rw [sub_zero]
    exact Ideal.pow_le_pow_right (by omega) (Ideal.pow_right_mono hPQ (a + 1) hxP)
  · push Not at hN
    obtain ⟨u, hu, hxu⟩ := exists_eq_sum_of_mem_ideal_sum (Finset.range (N + 1)) _
      (hK N ⟨Ideal.pow_le_pow_right (Nat.le_succ a) hxP, hxQ⟩)
    set b : R := ∑ p ∈ (Finset.range (N + 1)).filter (· ≤ a), u p with hb
    set t₁ : R := ∑ p ∈ (Finset.range (N + 1)).filter (fun p => ¬ p ≤ a), u p with ht₁
    have hxbt : x = b + t₁ := by
      rw [← hxu]
      exact (Finset.sum_filter_add_sum_filter_not _ _ _).symm
    have hbY : b ∈ P ^ a * Ideal.span (Set.range y) ^ (N - a) := by
      refine Ideal.sum_mem _ fun p hp => ?_
      obtain ⟨hp1, hp2⟩ := Finset.mem_filter.mp hp
      have := hu p hp1
      rw [max_eq_right hp2] at this
      exact Ideal.mul_mono_right (Ideal.pow_le_pow_right (by omega)) this
    have ht₁m : t₁ ∈ mixedPow P y (a + 1) N := by
      refine Ideal.sum_mem _ fun p hp => ?_
      obtain ⟨hp1, hp2⟩ := Finset.mem_filter.mp hp
      have hp2' : a < p := by omega
      have := hu p hp1
      rw [max_eq_left hp2'.le] at this
      refine le_ideal_sum (fun p => P ^ max p (a + 1) * Ideal.span (Set.range y) ^ (N - p)) hp1 ?_
      rwa [max_eq_left (by omega : a + 1 ≤ p)]
    have hbP : b ∈ P ^ (a + 1) := by
      have : b = x - t₁ := by rw [hxbt]; ring
      rw [this]
      exact sub_mem hxP (mixedPow_le_pow P y (a + 1) N ht₁m)
    obtain ⟨t₂, ht₂, r, hr, hbr⟩ := Submodule.mem_sup.mp
      (mem_sup_of_mem_mul_inf P y hP hPtop hqr a (N - a) hbY hbP)
    refine ⟨t₁ + t₂, add_mem ht₁m ?_, ?_⟩
    · refine le_ideal_sum (fun p => P ^ max p (a + 1) * Ideal.span (Set.range y) ^ (N - p))
        (Finset.mem_range.mpr (by omega : a < N + 1)) ?_
      simpa using ht₂
    · have : x - (t₁ + t₂) = r := by rw [hxbt, ← hbr]; ring
      rw [this]
      have hYQ : Ideal.span (Set.range y) ≤ Q := hQY ▸ le_sup_right
      have h1 := Ideal.mul_mono (Ideal.pow_right_mono hPQ a) (Ideal.pow_right_mono hYQ (N - a + 1)) hr
      rwa [← pow_add, show a + (N - a + 1) = N + 1 by omega] at h1

/-- **Transversality of the `P`-adic and `Q`-adic filtrations**: `Pᵃ ∩ Qᴺ ⊆ Σ_p P^{max(p,a)} Yᴺ⁻ᵖ`.
Induction on `a`; the step is `exists_mem_mixedPow_succ_sub_mem_pow_succ` iterated, which gives
`x ∈ Σ_p P^{max(p,a+1)} Yᴺ⁻ᵖ + Qᴺ⁺ʲ` for all `j`, and then Krull's intersection theorem (as on
p. 185: "Repeating this argument, we have `λ ∈ Σ PˢFᵗ + F^{q+m}` for all positive integer `m`. Hence
`λ ∈ Σ PˢFᵗ`"). -/
theorem inf_pow_le_mixedPow (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q) (hQtop : Q ≠ ⊤)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) (a N : ℕ) : P ^ a ⊓ Q ^ N ≤ mixedPow P y a N := by
  induction a generalizing N with
  | zero => exact fun x hx => pow_le_mixedPow_zero P y hQY N hx.2
  | succ a ih =>
    have hS : ∀ j N (x : R), x ∈ P ^ (a + 1) ⊓ Q ^ N → x ∈ mixedPow P y (a + 1) N ⊔ Q ^ (N + j) := by
      intro j
      induction j with
      | zero => exact fun N x hx => Ideal.mem_sup_right hx.2
      | succ j ihj =>
        intro N x hx
        obtain ⟨t, ht, hxt⟩ := exists_mem_mixedPow_succ_sub_mem_pow_succ P Q y hP hPtop hqr hPQ hQY a ih N
          hx.1 hx.2
        have hL : x - t ∈ P ^ (a + 1) ⊓ Q ^ (N + 1) :=
          ⟨sub_mem hx.1 (mixedPow_le_pow P y (a + 1) N ht), hxt⟩
        obtain ⟨t', ht', r', hr', hLr⟩ := Submodule.mem_sup.mp (ihj (N + 1) _ hL)
        refine Submodule.mem_sup.mpr ⟨t + t', add_mem ht (mixedPow_succ_le P y (a + 1) N ht'), r',
          by rwa [show N + (j + 1) = N + 1 + j by ring], ?_⟩
        rw [add_assoc, hLr]
        ring
    intro x hx
    refine mem_of_forall_mem_sup_pow (T := mixedPow P y (a + 1) N) (Q := Q) ?_ hQtop fun j => ?_
    · exact (mixedPow_le_pow P y (a + 1) N).trans
        ((Ideal.pow_le_self (Nat.succ_ne_zero a)).trans hPQ)
    · obtain ⟨t, ht, r, hr, hxtr⟩ := Submodule.mem_sup.mp (hS j N x hx)
      exact Submodule.mem_sup.mpr ⟨t, ht, r, Ideal.pow_le_pow_right (Nat.le_add_left j N) hr, hxtr⟩

/-- p. 194: "`Φ ∈ Q^{μ-ν} gr_P(R)`": an element `f ∈ Pᵛ ∩ Q^{ν+k}` lies in `Qᵏ Pᵛ + Pᵛ⁺¹`. -/
theorem mem_mul_pow_sup_of_mem_inf (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q) (hQtop : Q ≠ ⊤)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) {ν k : ℕ} {f : R} (hfP : f ∈ P ^ ν)
    (hfQ : f ∈ Q ^ (ν + k)) : f ∈ Q ^ k * P ^ ν ⊔ P ^ (ν + 1) := by
  have hmem := inf_pow_le_mixedPow P Q y hP hPtop hqr hPQ hQtop hQY ν (ν + k) ⟨hfP, hfQ⟩
  have hYQ : Ideal.span (Set.range y) ≤ Q := hQY ▸ le_sup_right
  refine (?_ : mixedPow P y ν (ν + k) ≤ _) hmem
  refine ideal_sum_le _ _ fun p hp => ?_
  by_cases hpν : p ≤ ν
  · rw [max_eq_right hpν]
    refine le_sup_of_le_left ?_
    rw [mul_comm]
    exact Ideal.mul_mono_left ((Ideal.pow_right_mono hYQ _).trans
      (Ideal.pow_le_pow_right (by omega)))
  · refine le_sup_of_le_right ?_
    rw [max_eq_left (by omega)]
    exact Ideal.mul_le_left.trans (Ideal.pow_le_pow_right (by omega))

end Transversality

end Transversality

/-! ### The study of `ν_P(f)` against `ν_Q(f)` (p. 194) -/

section OrderComparison

variable {R : Type u} [CommRing R] (J P Q : Ideal R)

/-- p. 194: "It is clear that `ν ≤ μ`." -/
theorem ordElem_le_ordElem (hPQ : P ≤ Q) (f : R) : Ideal.ordElem P f ≤ Ideal.ordElem Q f :=
  Ideal.ordElem_le fun k hk => Ideal.le_ordElem (Ideal.pow_right_mono hPQ k hk)

/-- `f ∈ Qᵐ` as soon as `m ≤ ν_Q(f)`. -/
theorem mem_pow_of_le_ordElem {f : R} {m : ℕ} (h : (m : ℕ∞) ≤ Ideal.ordElem Q f) : f ∈ Q ^ m := by
  by_cases htop : Ideal.ordElem Q f = ⊤
  · exact Ideal.ordElem_eq_top_iff.mp htop m
  · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
    rw [← hn, Nat.cast_le] at h
    exact Ideal.pow_le_pow_right h (Ideal.mem_pow_of_ordElem hn.symm)

/-- p. 194: "(which induces the above homomorphism `α`)": `γ` factors through
`gr⁰_Q(gr_P(R)) = gr_P(R)/Q gr_P(R)`, i.e. `γ` kills `Q gr_P(R)` (`γ` is an `R`-algebra
homomorphism and `Q` acts as zero on `gr_Q(R)`). -/
theorem gammaMap_eq_zero_of_mem_map (hPQ : P ≤ Q) {x : AssocGraded P}
    (hx : x ∈ Ideal.map (algebraMap R (AssocGraded P)) Q) : gammaMap P Q hPQ x = 0 := by
  have : Ideal.map (algebraMap R (AssocGraded P)) Q ≤ RingHom.ker (gammaMap P Q hPQ) := by
    rw [Ideal.map_le_iff_le_comap]
    intro q hq
    rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes,
      IsScalarTower.algebraMap_apply R (R ⧸ Q) (AssocGraded Q) q,
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hq, map_zero]
  exact this hx

theorem gammaMap_initialForm_eq (hPQ : P ≤ Q) (f : R) (h : Ideal.ordElem P f = Ideal.ordElem Q f) :
    gammaMap P Q hPQ (initialForm P f) = initialForm Q f := by
  by_cases htop : Ideal.ordElem P f = ⊤
  · have htopQ : Ideal.ordElem Q f = ⊤ := h ▸ htop
    simp [initialForm, htop, htopQ]
  · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
    rw [initialForm_eq_mk P hν.symm, gammaMap_mk, initialForm_eq_mk Q (h ▸ hν.symm)]

/-- An element of `I • grⁿ_P(R)` is, in `gr_P(R)`, in the ideal `I · gr_P(R)`. -/
theorem ofGrPiece_mem_map_of_mem_smul_top (I : Ideal R) {n : ℕ} {x : GrPiece P n}
    (hx : x ∈ (I • ⊤ : Submodule R (GrPiece P n))) :
    AssocGraded.ofGrPiece P n x ∈ Ideal.map (algebraMap R (AssocGraded P)) I := by
  refine Submodule.smul_induction_on hx (fun i hi w _ => ?_) fun a b ha hb => by
    rw [map_add]
    exact add_mem ha hb
  have h1 : i • w = (Ideal.Quotient.mk P i) • w := (algebraMap_smul (R ⧸ P) i w).symm
  rw [h1, map_smul, Algebra.smul_def]
  refine Ideal.mul_mem_right _ _ ?_
  have : algebraMap (R ⧸ P) (AssocGraded P) (Ideal.Quotient.mk P i) =
      algebraMap R (AssocGraded P) i := (IsScalarTower.algebraMap_apply R (R ⧸ P) _ i).symm
  rw [this]
  exact Ideal.mem_map_of_mem _ hi

section PrintedInclusion

variable [IsLocalRing R] [IsNoetherianRing R] {s : ℕ} (y : Fin s → R)

/-- p. 194: "`Φ ∈ Q^{μ-ν} gr_P(R)`", in the degree `ν` of `Φ`: for `f ∈ Pᵛ ∩ Q^{ν+k}`, the class of
`f` in `grᵛ_P(R)` lies in `Qᵏ grᵛ_P(R)`.

Gap filled: the paper asserts this without argument. It is `Pᵛ ∩ Q^{ν+k} ⊆ Qᵏ Pᵛ + Pᵛ⁺¹`
(`mem_mul_pow_sup_of_mem_inf`), a consequence of the transversality of the `P`-adic and `Q`-adic
filtrations (`inf_pow_le_mixedPow`). -/
theorem mk_mem_smul_top_of_mem_inf (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q) (hQtop : Q ≠ ⊤)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) {ν k : ℕ} {f : R} (hfP : f ∈ P ^ ν)
    (hfQ : f ∈ Q ^ (ν + k)) :
    (Submodule.Quotient.mk ⟨f, hfP⟩ : GrPiece P ν) ∈ (Q ^ k • ⊤ : Submodule R (GrPiece P ν)) := by
  obtain ⟨q, hq, r, hr, hfqr⟩ := Submodule.mem_sup.mp
    (mem_mul_pow_sup_of_mem_inf P Q y hP hPtop hqr hPQ hQtop hQY hfP hfQ)
  have hfr : f - q = r := by rw [← hfqr]; ring
  have hqP : q ∈ P ^ ν := by
    have : q = f - r := by rw [← hfqr]; ring
    rw [this]
    exact sub_mem hfP (Ideal.pow_le_pow_right (Nat.le_succ ν) hr)
  have h2 : (Submodule.Quotient.mk ⟨f, hfP⟩ : GrPiece P ν) = Submodule.Quotient.mk ⟨q, hqP⟩ := by
    rw [Submodule.Quotient.eq, Submodule.mem_comap, Submodule.subtype_apply]
    show f - q ∈ P ^ (ν + 1)
    rw [hfr]
    exact hr
  rw [h2]
  exact mk_mem_smul_top_of_mem_mul_pow P (Q ^ k) ν hq hqP

/-- p. 194: "the initial form `Φ` of `f` in `gr_P(R)` is such that `deg Φ = ν` and
`Φ ∈ Q^{μ-ν} gr_P(R)`", for `ν = ν_P(f)` and `μ = ν_Q(f)`: `Φ ∈ Qᵏ gr_P(R)` for all `k` with
`ν + k ≤ μ`. -/
theorem initialForm_mem_map_pow (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q) (hQtop : Q ≠ ⊤)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) (f : R) (k : ℕ)
    (hk : Ideal.ordElem P f + k ≤ Ideal.ordElem Q f) :
    initialForm P f ∈ Ideal.map (algebraMap R (AssocGraded P)) (Q ^ k) := by
  by_cases htop : Ideal.ordElem P f = ⊤
  · simp [initialForm, htop]
  · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
    have hfP : f ∈ P ^ ν := Ideal.mem_pow_of_ordElem hν.symm
    have hfQ : f ∈ Q ^ (ν + k) :=
      mem_pow_of_le_ordElem Q (by rw [← hν] at hk; exact_mod_cast hk)
    rw [initialForm_eq_mk P hν.symm, ← AssocGraded.ofGrPiece_mk P ν ⟨f, hfP⟩]
    exact ofGrPiece_mem_map_of_mem_smul_top P (Q ^ k)
      (mk_mem_smul_top_of_mem_inf P Q y hP hPtop hqr hPQ hQtop hQY hfP hfQ)

/-- p. 194: "If `ν < μ`, then the initial form `Φ` of `f` in `gr_P(R)` is such that `deg Φ = ν` and
`Φ ∈ Q^{μ-ν} gr_P(R)`. The image of `Φ` in `gr⁰_Q(gr_P(R))` is then zero, hence, `γ(Φ) = 0`.  If
`ν = μ`, then the image `γ(Φ)` of `Φ` is equal to the initial form of `f` in `gr_Q(R)`."  This is
the case `ν < μ`: `Φ ∈ Q^{μ-ν} gr_P(R) ⊆ Q gr_P(R)` (`initialForm_mem_map_pow`, a gap of the paper),
that is, the image of `Φ` in `gr⁰_Q(gr_P(R)) = gr_P(R)/Q gr_P(R)` is zero, and `γ` factors through
`gr⁰_Q(gr_P(R))` (`gammaMap_eq_zero_of_mem_map`). -/
theorem gammaMap_initialForm_eq_zero (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q) (hQtop : Q ≠ ⊤)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) (f : R)
    (h : Ideal.ordElem P f < Ideal.ordElem Q f) :
    gammaMap P Q hPQ (initialForm P f) = 0 := by
  by_cases htop : Ideal.ordElem P f = ⊤
  · rw [htop] at h
    exact absurd h not_top_lt
  · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
    have hk : Ideal.ordElem P f + ((1 : ℕ) : ℕ∞) ≤ Ideal.ordElem Q f := by
      by_cases hμ : Ideal.ordElem Q f = ⊤
      · rw [hμ]
        exact le_top
      · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp hμ
        rw [← hν, ← hn] at h ⊢
        exact_mod_cast Nat.succ_le_of_lt (by exact_mod_cast h)
    have hΦ := initialForm_mem_map_pow P Q y hP hPtop hqr hPQ hQtop hQY f 1 hk
    rw [pow_one] at hΦ
    exact gammaMap_eq_zero_of_mem_map P Q hPQ hΦ

/-- The ideal of `gr_Q(R)` generated by the image of `gr_P(J, R)` by `γ` is generated by the initial
forms in `gr_Q(R)` of the `f ∈ J` with `ν_Q(f) = ν_P(f)`: "`γ(Φ)` is `0` or the initial form of
`f`", `Φ` running through the initial forms of the elements `f` of `J` that generate `gr_P(J, R)`. -/
theorem map_gammaMap_grIdeal_eq_equiOrderForms (hP : IsNormallyFlatAlongIdeal P) (hPtop : P ≠ ⊤)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (hPQ : P ≤ Q) (hQtop : Q ≠ ⊤)
    (hQY : Q = P ⊔ Ideal.span (Set.range y)) :
    Ideal.map (gammaMap P Q hPQ) (grIdeal P J) = equiOrderForms J P Q := by
  rw [grIdeal, Ideal.map_span, Set.image_image]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨f, hf, rfl⟩
    show gammaMap P Q hPQ (initialForm P f) ∈ equiOrderForms J P Q
    rcases (ordElem_le_ordElem P Q hPQ f).lt_or_eq with hlt | heq
    · rw [gammaMap_initialForm_eq_zero P Q y hP hPtop hqr hPQ hQtop hQY f hlt]
      exact zero_mem _
    · rw [gammaMap_initialForm_eq P Q hPQ f heq]
      exact Ideal.subset_span ⟨f, hf, heq.symm, rfl⟩
  · rw [equiOrderForms, Ideal.span_le]
    rintro _ ⟨f, hf, heq, rfl⟩
    rw [SetLike.mem_coe, ← gammaMap_initialForm_eq P Q hPQ f heq.symm]
    exact Ideal.subset_span ⟨f, hf, rfl⟩

end PrintedInclusion

end OrderComparison

/-! ### Lemma 8 (p. 194) -/

section Statement

variable {R : Type u} [CommRing R] (J P Q : Ideal R)

/-- "Thus the following lemma is verified", finite form: if `gr_Q(J, R)` is generated by the initial
forms of the `f ∈ J` with `ν_Q(f) = ν_P(f)`, finitely many of them suffice since `gr_Q(R)` is
noetherian, which gives a system `(f₁, …, f_m)` as in Lemma 8 (the paper does not say that `m` is
finite because it is clear: "a system of elements `(f₁, …, f_m)` of `J`").  -/
theorem hasInitialFormSystem_of_equiOrderForms_eq [IsNoetherianRing (AssocGraded Q)]
    (h : equiOrderForms J P Q = grIdeal Q J) : HasInitialFormSystem J P Q := by
  classical
  obtain ⟨t, htX, hts⟩ := (Submodule.fg_span_iff_fg_span_finset_subset
    {x | ∃ f ∈ J, Ideal.ordElem Q f = Ideal.ordElem P f ∧ x = initialForm Q f}).mp
    (IsNoetherian.noetherian (equiOrderForms J P Q))
  have hex : ∀ x : ↥t, ∃ f ∈ J, Ideal.ordElem Q f = Ideal.ordElem P f ∧
      (x : AssocGraded Q) = initialForm Q f := fun x => htX x.2
  choose f hfJ hford hfx using hex
  refine ⟨t.card, fun j => f (t.equivFin.symm j), fun j => hfJ _, fun j => hford _, ?_⟩
  have hrange : Set.range (fun j => initialForm Q (f (t.equivFin.symm j))) =
      (t : Set (AssocGraded Q)) := by
    ext x
    constructor
    · rintro ⟨j, rfl⟩
      have h1 : initialForm Q (f (t.equivFin.symm j)) ∈ (t : Set (AssocGraded Q)) := by
        have := (t.equivFin.symm j).2
        have h2 := hfx (t.equivFin.symm j)
        exact h2 ▸ this
      exact h1
    · intro hx
      refine ⟨t.equivFin ⟨x, hx⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact (hfx ⟨x, hx⟩).symm
  rw [hrange, ← h]
  exact hts.symm

variable {s : ℕ} (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))
  (hqr' : IsQuasiRegular fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j)))
  (hz' : Ideal.span (Set.range fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j))) =
      (Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))

variable {s : ℕ} (y : Fin s → R)
  (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j))
  (hz : Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P))
  (hqr' : IsQuasiRegular fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j)))
  (hz' : Ideal.span (Set.range fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
    (Ideal.Quotient.mk J (y j))) =
      (Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))))

/-- p. 194: "The ideal `gr_P(J, R)` is mapped into the ideal `gr_Q(J, R)` by `γ`." -/
theorem map_gammaMap_grIdeal_le (hPQ : P ≤ Q) :
    Ideal.map (gammaMap P Q hPQ) (grIdeal P J) ≤ grIdeal Q J := by
  rw [grIdeal, Ideal.map_span, Set.image_image, Ideal.span_le]
  rintro _ ⟨f, hf, rfl⟩
  show gammaMap P Q hPQ (initialForm P f) ∈ grIdeal Q J
  by_cases htop : Ideal.ordElem P f = ⊤
  · simp [initialForm, htop]
  · obtain ⟨ν, hν⟩ := ENat.ne_top_iff_exists.mp htop
    rw [initialForm_eq_mk P hν.symm, gammaMap_mk]
    exact mk_mem_grIdeal Q hf _

/-- The components of an element of the image of `ψ''` lie in the images of `ψ''_n`. -/
theorem grProj_mem_psiDoublePrimeRange (hPQ : P ≤ Q) {z : AssocGraded Q}
    (hz' : z ∈ psiDoublePrimeImage J P Q hPQ y hqr hz) (m : ℕ) :
    grProj Q m z ∈ psiDoublePrimeRange J P Q hPQ y hqr hz m := by
  refine Submodule.iSup_induction _ (motive := fun z => grProj Q m z ∈
    psiDoublePrimeRange J P Q hPQ y hqr hz m) hz' (fun n z hzn => ?_) (by simp)
    (fun a b ha hb => by rw [map_add]; exact add_mem ha hb)
  obtain ⟨k, hk, rfl⟩ := hzn
  by_cases hmn : n = m
  · subst hmn
    show grProj Q n (AssocGraded.ofGrPiece Q n k) ∈ _
    rw [grProj_ofGrPiece_same]
    exact hk
  · show grProj Q m (AssocGraded.ofGrPiece Q n k) ∈ _
    rw [grProj_ofGrPiece_ne Q hmn]
    exact zero_mem _

/-- p. 194: "Therefore, `ψ'` is isomorphic if and only if the image of `gr_P(J, R)` by `γ` in
`gr_Q(R)` generates the ideal `gr_Q(J, R)`", in the form: `ψ''` is surjective iff the ideal of
`gr_Q(R)` generated by `γ(gr_P(J, R))` is `gr_Q(J, R)`.  By `psiDoublePrimeImage_eq_map_gammaMap`
this ideal is the image of `ψ''`, and `ψ''` maps into `gr_Q(J, R)`: `ψ''` is surjective iff its image
contains the generators of `gr_Q(J, R)`, i.e. the initial forms of the elements of `J`. -/
theorem surjective_psiDoublePrime_iff_eq_map_gammaMap (hJP : J ≤ P) (hPQ : P ≤ Q)
    (hψ : ∀ q, Function.Surjective (psiTildeR P Q hPQ y hqr hz q)) :
    (∀ n, Function.Surjective (psiDoublePrime J P Q hJP hPQ y hqr hz hqr' hz' n)) ↔
      grIdeal Q J = Ideal.map (gammaMap P Q hPQ) (grIdeal P J) := by
  have himg := psiDoublePrimeImage_eq_map_gammaMap J P Q hPQ y hqr hz hψ
  have hmem : ∀ z, z ∈ Ideal.map (gammaMap P Q hPQ) (grIdeal P J) ↔
      z ∈ psiDoublePrimeImage J P Q hPQ y hqr hz := fun z => by rw [himg]; rfl
  constructor
  · intro hsurj
    refine le_antisymm ?_ (map_gammaMap_grIdeal_le J P Q hPQ)
    rw [grIdeal, Ideal.span_le]
    rintro _ ⟨g, hgJ, rfl⟩
    show initialForm Q g ∈ Ideal.map (gammaMap P Q hPQ) (grIdeal P J)
    rw [hmem]
    by_cases htop : Ideal.ordElem Q g = ⊤
    · simp [initialForm, htop]
    · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp htop
      have hgQ : g ∈ Q ^ n := Ideal.mem_pow_of_ordElem hn.symm
      obtain ⟨a, ha⟩ := hsurj n ⟨Submodule.Quotient.mk ⟨g, hgQ⟩, ⟨g, hgJ, hgQ, rfl⟩⟩
      rw [initialForm_eq_mk Q hn.symm]
      exact Submodule.mem_iSup_of_mem n (Submodule.mem_map.mpr
        ⟨Submodule.Quotient.mk ⟨g, hgQ⟩, ⟨a, congrArg Subtype.val ha⟩,
          AssocGraded.ofGrPiece_mk Q n ⟨g, hgQ⟩⟩)
  · intro h n ⟨x, hx⟩
    have hxI : AssocGraded.ofGrPiece Q n x ∈ Ideal.map (gammaMap P Q hPQ) (grIdeal P J) := by
      rw [← h]
      obtain ⟨g, hgJ, hg, rfl⟩ := hx
      rw [AssocGraded.ofGrPiece_mk]
      exact mk_mem_grIdeal Q hgJ hg
    have := grProj_mem_psiDoublePrimeRange J P Q y hqr hz hPQ ((hmem _).mp hxI) n
    rw [grProj_ofGrPiece_same] at this
    obtain ⟨a, ha⟩ := this
    exact ⟨a, Subtype.ext ha⟩

/-- **Lemma 8** (pp. 193–194), proved by the diagram of p. 194:
"`ψ'` is an isomorphism of graded `Ō/Q̄ (= O/Q)`-algebras if and only if there exists a system of
elements `(f₁, …, f_m)` of `J` such that (1) `ν_Q(f_j) = ν_P(f_j)` for `1 ≤ j ≤ m`, and (2) if `φ_j`
denotes the initial form of `f_j` in `gr_Q(R)`, then `gr_Q(J, R) = (φ₁, …, φ_m) gr_Q(R)`", for the
map `ψ'` of p. 193 defined by a system `(y₁, …, y_s)` with `Q = P + (y)` and the `ȳ_j` quasi-regular
in `R/P` (the form of the statement of `bijective_psiDeg_iff_hasInitialFormSystem`).

The proof follows the printed one, in its order: (1) `ψ'` is isomorphic iff `ψ''` is surjective (the
diagram, `bijective_psiDeg_iff_surjective_psiDoublePrime`); (2) the image of `ψ''` is the ideal of
`gr_Q(R)` generated by `γ(gr_P(J, R))` (`psiDoublePrimeImage_eq_map_gammaMap`), so `ψ''` is
surjective iff the image of `gr_P(J, R)` by `γ` generates `gr_Q(J, R)`
(`surjective_psiDoublePrime_iff_eq_map_gammaMap`); (3) the study of `ν = ν_P(f)` against
`μ = ν_Q(f)` (with `Φ ∈ Q^{μ-ν} gr_P(R)`, `initialForm_mem_map_pow`, `mk_mem_smul_top_of_mem_inf`)
shows that the ideal generated by `γ(gr_P(J, R))` is the ideal generated by the initial forms `φ_f`
of the `f ∈ J` with `ν_Q(f) = ν_P(f)` (`gammaMap_initialForm_eq_zero`, `gammaMap_initialForm_eq`,
`map_gammaMap_grIdeal_eq_equiOrderForms`), which is condition (2) of the lemma (finitely many `f`
suffice, `hasInitialFormSystem_of_equiOrderForms_eq`). -/
theorem bijective_psiDeg_iff_hasInitialFormSystem [IsRegularLocalRing R] [P.IsPrime] [Q.IsPrime]
    [IsRegularLocalRing (R ⧸ P)] [IsRegularLocalRing (R ⧸ Q)] (hJP : J ≤ P) (hPQ : P ≤ Q)
    (hQY : Q = P ⊔ Ideal.span (Set.range y))
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) :
    (∀ n, Function.Bijective (psiDeg (P.map (Ideal.Quotient.mk J)) (Q.map (Ideal.Quotient.mk J))
      (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j))
      (isQuasiRegular_map_quotient J P y hJP hqr)
      (span_map_mk_eq_map_quotient J P Q y hQY) n)) ↔
        HasInitialFormSystem J P Q := by
  have hz := span_map_mk_eq_of_eq_sup P Q y hQY
  have hqr' := isQuasiRegular_map_quotient J P y hJP hqr
  have hz' := span_map_mk_eq_map_quotient J P Q y hQY
  have hP := isNormallyFlatAlongIdeal_of_isRegularLocalRing_quotient P
  have hψbij : ∀ q, Function.Bijective (psiDeg P Q hPQ y hqr hz q) := fun q =>
    psiDeg_bijective_of_isNormallyFlatAlongIdeal P Q hPQ y hqr hz hP hQY q
  have hψ : ∀ q, Function.Surjective (psiTildeR P Q hPQ y hqr hz q) := fun q =>
    ((bijective_psiTildeR_iff P Q hPQ y hqr hz q).mpr (hψbij q)).2
  have : IsNoetherianRing (AssocGraded Q) := by
    obtain ⟨r, ⟨e⟩⟩ := exists_algEquiv_assocGraded Q inferInstance
    exact isNoetherianRing_of_ringEquiv _ e.toRingEquiv
  simp_rw [bijective_psiDeg_iff_surjective_psiDoublePrime J P Q hJP hPQ y hqr hz hqr' hz' hQY]
  rw [surjective_psiDoublePrime_iff_eq_map_gammaMap J P Q y hqr hz hqr' hz' hJP hPQ hψ,
    map_gammaMap_grIdeal_eq_equiOrderForms J P Q y hP Ideal.IsPrime.ne_top' hqr hPQ
      Ideal.IsPrime.ne_top' hQY]
  constructor
  · exact fun h => hasInitialFormSystem_of_equiOrderForms_eq J P Q h.symm
  · rintro ⟨m, f, hfJ, hord, h₂⟩
    refine le_antisymm ?_ (equiOrderForms_le_grIdeal J P Q)
    rw [← h₂, Ideal.span_le]
    rintro _ ⟨β, rfl⟩
    exact Ideal.subset_span ⟨f β, hfJ β, hord β, rfl⟩

end Statement


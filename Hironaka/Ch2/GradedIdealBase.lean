/-!
# Ch. II §2 (first part): the associated graded ideal, Lemmas 6 and 7, and the objects of Lemma 8
(pp. 189–195)

> Let A be a noetherian ring, and I an ideal in A, say I ≠ A. For each element f ∈ A, we define
> the symbol ν_I(f) as follows: ν_I(f) is the largest integer ν ≥ 0 such that f ∈ Iᵛ, if it
> exists, and ν_I(f) = ∞ if f ∈ Iᵛ for all positive integers ν. … If ν = ν_I(f) is a non-negative
> integer, then the class of f in Iᵛ/Iᵛ⁺¹ will be called the initial form of f in gr_I(A). …
> If J is an ideal in A, then we shall denote by gr_I(J, A) the graded ideal in gr_I(A)
> generated by the initial forms of elements of J. … We denote by grⁿ_I(J, A) the homogeneous part of
> degree n of the graded ideal gr_I(J, A).  (p. 189)

The definitions of p. 189 (`Ideal.ordElem` = ν_I, `initialForm`, `grIdeal` = gr_I(J, A)) and
Lemma 5 of p. 190 (`grMapQuot_surjective`, `ker_grMapQuot`) live in
`Hironaka/Compat/Graded.lean`.  This file contains Lemma 6, Lemma 7 (with the footnote 41 setup
of `Hironaka/Compat/RegularQuotientGenerators.lean`), the condition (iii) of Theorem 2 as a named
predicate `HasInitialFormSystem` (the right-hand side of Lemma 8) and the auxiliary statements
about the map `ψ'` of p. 193 used by Lemma 8 (`Hironaka/Ch2/Lemma8Diagram.lean`, which imports this
file).  The rest of §2 in the paper's order, Lemma 8 (the statement for a system `y` with
`Q = P + (y)`), Theorem 2 and its two corollaries (pp. 193–197), is in
`Hironaka/Ch2/GradedIdeal.lean`, which imports `Hironaka/Ch2/Lemma8Diagram.lean`; the declarations
of this file are visible there unchanged.
-/

@[expose] public section

open AlgebraicGeometry

namespace Hironaka

universe u

/-! ### Lemma 6 (p. 190) -/

section Lemma6

variable {A : Type u} [CommRing A]

/-- Lemma 6, p. 190: "Notation being as above, if `A` is a local ring, and if `(f₁, …, f_m)` is
a system of elements of `J` such that the initial forms of the `f_i` in `gr_I(A)` generate the
ideal `gr_I(J, A)`, then the `f_i` generate the ideal `J`."  "Notation being as above" carries
the standing assumptions of p. 189: `A` is noetherian and `I ≠ A` (without `I ≠ A` the
statement fails, since `gr_A(A) = 0`).  Local rings are noetherian throughout the paper
(p. 181). -/
@[blueprint "lem:II.2-6"
  (statement := /-- Let $A$ be a noetherian local ring, and $I\ne A$, $J$ ideals in $A$. If
    $(f_1,\dots,f_m)$ is a system of elements of $J$ such that the initial forms of the $f_i$
    in $\operatorname{gr}_I(A)$ (\cref{def:II.2-initial-form}) generate the ideal
    $\operatorname{gr}_I(J,A)$ (\cref{def:II.2-graded-ideal}), then the $f_i$ generate the
    ideal $J$. (Lemma 6, p.~190.) -/)
  (proof := /-- Let $J_0=(f_1,\dots,f_m)A$. Then we first show that $J\subseteq J_0+I^n$ for
    every positive integer $n$. It is clear for $n=1$. Inductively, if $g\in J$ and
    $\nu_I(g)=n$ then the initial form of $g$ in $\operatorname{gr}_I(A)$ is in
    $\operatorname{gr}^n_I(J,A)$ which is generated by the initial forms of $f_1,\dots,f_m$.
    Hence there exists a linear combination $g_0=\sum_ih_if_i$ with $h_i\in A$ such that
    $\nu_I(g-g_0)>n$. In this manner, $J\subseteq J_0+I^n$ implies $J\subseteq J_0+I^{n+1}$.
    Now, since $A$ is a local ring, $J\subseteq\bigcap_n(J_0+I^{n+1})=J_0$ (Krull's
    intersection theorem, $I$ being contained in the maximal ideal). But obviously
    $J\supseteq J_0$, hence $J=J_0$. -/)
  (latexEnv := "lemma")]
theorem span_eq_of_span_initialForm_eq_grIdeal [IsLocalRing A] [IsNoetherianRing A]
    (I : Ideal A) (hI : I ≠ ⊤) (J : Ideal A) {m : ℕ} (f : Fin m → A) (hf : ∀ j, f j ∈ J)
    (hgen : Ideal.span (Set.range fun j => initialForm I (f j)) = grIdeal I J) :
    Ideal.span (Set.range f) = J := by
  -- `J₀ = (f₁, …, f_m)A ⊆ J`.
  set J₀ := Ideal.span (Set.range f)
  have hJ₀J : J₀ ≤ J := Ideal.span_le.mpr (Set.range_subset_iff.mpr hf)
  -- `gr_I(J, A) ⊆ gr_I(J₀, A)`: the generators of `gr_I(J, A)`, the initial forms of the `f_j`,
  -- are initial forms of elements of `J₀`.
  have hgr : grIdeal I J ≤ grIdeal I J₀ := by
    rw [← hgen, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span
      (Set.mem_image_of_mem (initialForm I) (Ideal.subset_span (Set.mem_range_self j)))
  -- The inductive step: for `r ∈ J ∩ Iⁿ`, the class of `r` in `grⁿ_I(J, A) ⊆ grⁿ_I(J₀, A)` is
  -- the class of some `a ∈ J₀ ∩ Iⁿ` (p. 189), i.e. `ν_I(r - a) > n`.
  have step : ∀ (n : ℕ) (r : A), r ∈ J → r ∈ I ^ n → ∃ a ∈ J₀, r - a ∈ I ^ (n + 1) := by
    intro n r hrJ hr
    obtain ⟨a, haJ₀, ha, hmk⟩ := grIdeal_le_bound I J₀ (hgr (mk_mem_grIdeal I hrJ hr)) n
    rw [grProj_mk_same, Submodule.Quotient.eq] at hmk
    have har : a - r ∈ I ^ (n + 1) := hmk
    refine ⟨a, haJ₀, ?_⟩
    rw [← neg_sub]
    exact neg_mem har
  -- `J ⊆ J₀ + Iⁿ` for every `n`.
  have approx : ∀ n : ℕ, ∀ g ∈ J, ∃ g₀ ∈ J₀, g - g₀ ∈ I ^ n := by
    intro n
    induction n with
    | zero => exact fun g _ => ⟨0, zero_mem _, by simp⟩
    | succ n ih =>
      intro g hg
      obtain ⟨g₀, hg₀, hgn⟩ := ih g hg
      obtain ⟨a, ha, hga⟩ := step n (g - g₀) (sub_mem hg (hJ₀J hg₀)) hgn
      exact ⟨g₀ + a, add_mem hg₀ ha, by rwa [sub_add_eq_sub_sub]⟩
  -- Krull's intersection theorem for the finite `A`-module `A/J₀` (`I` lies in the maximal
  -- ideal): `⋂ₙ Iⁿ(A/J₀) = 0`, i.e. `⋂ₙ (J₀ + Iⁿ) = J₀`.
  refine le_antisymm hJ₀J fun g hg => ?_
  have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing I (M := A ⧸ J₀) hI
  have hmem : Ideal.Quotient.mk J₀ g ∈ (⨅ i : ℕ, I ^ i • ⊤ : Submodule A (A ⧸ J₀)) := by
    refine (Submodule.mem_iInf _).mpr fun n => ?_
    obtain ⟨g₀, hg₀, hgn⟩ := approx n g hg
    have h₁ : Ideal.Quotient.mk J₀ g = Ideal.Quotient.mk J₀ (g - g₀) :=
      Ideal.Quotient.eq.mpr (by rwa [sub_sub_cancel])
    have h₂ : Ideal.Quotient.mk J₀ (g - g₀) = (g - g₀) • (1 : A ⧸ J₀) :=
      Algebra.algebraMap_eq_smul_one (g - g₀)
    rw [h₁, h₂]
    exact Submodule.smul_mem_smul hgn Submodule.mem_top
  rw [hK] at hmem
  exact Ideal.Quotient.eq_zero_iff_mem.mp ((Submodule.mem_bot A).mp hmem)

end Lemma6

/-! ### Lemma 7 (pp. 190–193) -/

section Lemma7

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (J P Q : Ideal R) [P.IsPrime]
  [Q.IsPrime] [IsRegularLocalRing (R ⧸ P)] [IsRegularLocalRing (R ⧸ Q)]

/-- Membership in a finite sum of ideals. -/
private theorem exists_eq_sum_of_mem_sum {A : Type*} [CommRing A]
    {ι : Type*} (s : Finset ι) (I : ι → Ideal A) {g : A}
    (hg : g ∈ ∑ a ∈ s, I a) : ∃ u : ι → A, (∀ a ∈ s, u a ∈ I a) ∧ ∑ a ∈ s, u a = g := by
  classical
  induction s using Finset.induction_on generalizing g with
  | empty =>
    rw [Finset.sum_empty, Submodule.zero_eq_bot, Submodule.mem_bot] at hg
    exact ⟨0, by simp, by simp [hg]⟩
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Submodule.add_eq_sup, Submodule.mem_sup] at hg
    obtain ⟨y, hy, z, hz, rfl⟩ := hg
    obtain ⟨u, hu, rfl⟩ := ih hz
    refine ⟨Function.update u a y, fun b hb => ?_, ?_⟩
    · rcases Finset.mem_insert.mp hb with rfl | hb
      · simpa using hy
      · rw [Function.update_of_ne (ne_of_mem_of_not_mem hb ha)]
        exact hu b hb
    · rw [Finset.sum_insert ha, Function.update_self]
      congr 1
      exact Finset.sum_congr rfl fun b hb =>
        Function.update_of_ne (ne_of_mem_of_not_mem hb ha) _ _

private theorem le_sum_of_mem {A : Type*} [CommRing A]
    {ι : Type*} {s : Finset ι} (I : ι → Ideal A) {a : ι}
    (ha : a ∈ s) : I a ≤ ∑ b ∈ s, I b := by
  classical
  rw [← Finset.add_sum_erase s I ha, Submodule.add_eq_sup]
  exact le_sup_left

private theorem sum_le_of_forall {A : Type*} [CommRing A]
    {ι : Type*} (s : Finset ι) (I : ι → Ideal A) {K : Ideal A}
    (h : ∀ a ∈ s, I a ≤ K) : ∑ a ∈ s, I a ≤ K :=
  Finset.sum_induction I (· ≤ K) (fun _ _ h₁ h₂ => by
    rw [Submodule.add_eq_sup]; exact sup_le h₁ h₂) bot_le h

open MvPolynomial in
/-- Elements of `P^a Y^b`, with `P`, `Y` spanned by complementary parts of a family `x`, are
values of polynomials all of whose monomials have `P`-degree `a` and `Y`-degree `b`. -/
private theorem exists_biHom_of_mem {A : Type*} [CommRing A] {σ : Type*} [Fintype σ]
    [DecidableEq σ] (x : σ → A) (Zs : Finset σ) (a b : ℕ) {u : A}
    (hu : u ∈ Ideal.span (x '' ↑Zs) ^ a * Ideal.span (x '' ↑Zsᶜ) ^ b) :
    ∃ U : MvPolynomial σ A, (∀ e ∈ U.support, ∑ i ∈ Zs, e i = a ∧ ∑ i ∈ Zsᶜ, e i = b) ∧
      eval x U = u := by
  let Rep : ℕ → ℕ → Ideal A := fun a b =>
    { carrier := {u | ∃ U : MvPolynomial σ A,
        (∀ e ∈ U.support, ∑ i ∈ Zs, e i = a ∧ ∑ i ∈ Zsᶜ, e i = b) ∧ eval x U = u}
      add_mem' := by
        rintro _ _ ⟨U, hU, rfl⟩ ⟨V, hV, rfl⟩
        refine ⟨U + V, fun e he => ?_, by simp⟩
        rcases Finset.mem_union.mp (support_add he) with h | h
        exacts [hU e h, hV e h]
      zero_mem' := ⟨0, by simp, by simp⟩
      smul_mem' := by
        rintro c _ ⟨U, hU, rfl⟩
        refine ⟨c • U, fun e he => hU e (support_smul he), by simp⟩ }
  have hmem : ∀ a b u, u ∈ Rep a b ↔ ∃ U : MvPolynomial σ A,
      (∀ e ∈ U.support, ∑ i ∈ Zs, e i = a ∧ ∑ i ∈ Zsᶜ, e i = b) ∧ eval x U = u :=
    fun _ _ _ => Iff.rfl
  have hmul : ∀ a b a' b', Rep a b * Rep a' b' ≤ Rep (a + a') (b + b') := by
    intro a b a' b'
    refine Ideal.mul_le.mpr ?_
    rintro _ ⟨U, hU, rfl⟩ _ ⟨V, hV, rfl⟩
    refine ⟨U * V, fun e he => ?_, by simp⟩
    obtain ⟨e₁, he₁, e₂, he₂, rfl⟩ := Finset.mem_add.mp (support_mul U V he)
    simp only [Finsupp.add_apply, Finset.sum_add_distrib]
    exact ⟨by rw [(hU e₁ he₁).1, (hV e₂ he₂).1], by rw [(hU e₁ he₁).2, (hV e₂ he₂).2]⟩
  have hone : (⊤ : Ideal A) ≤ Rep 0 0 := by
    intro c _
    refine ⟨C c, fun e he => ?_, eval_C c⟩
    have he0 : e = 0 := by
      by_contra hne
      exact (mem_support_iff.mp he) (by simp [coeff_C, Ne.symm hne])
    subst he0
    simp
  have hP1 : Ideal.span (x '' ↑Zs) ≤ Rep 1 0 := by
    rw [Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    refine ⟨X i, fun e he => ?_, eval_X _⟩
    have he' : Finsupp.single i 1 = e := by
      by_contra h
      exact (mem_support_iff.mp he) (by simp [coeff_X, h])
    subst he'
    have hi₁ : i ∈ Zs := by simpa using hi
    have hi' : i ∉ Zsᶜ := by simpa using hi
    simp [Finsupp.single_apply, hi₁, hi']
  have hY1 : Ideal.span (x '' ↑Zsᶜ) ≤ Rep 0 1 := by
    rw [Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    refine ⟨X i, fun e he => ?_, eval_X _⟩
    have he' : Finsupp.single i 1 = e := by
      by_contra h
      exact (mem_support_iff.mp he) (by simp [coeff_X, h])
    subst he'
    have hi' : i ∉ Zs := by simpa using hi
    have hi'' : i ∈ Zsᶜ := by simpa using hi
    simp [Finsupp.single_apply, hi', hi'']
  have hPa : ∀ a, Ideal.span (x '' ↑Zs) ^ a ≤ Rep a 0 := by
    intro a
    induction a with
    | zero => rw [pow_zero, Ideal.one_eq_top]; exact hone
    | succ a ih => rw [pow_succ]; exact (Ideal.mul_mono ih hP1).trans (hmul a 0 1 0)
  have hYb : ∀ b, Ideal.span (x '' ↑Zsᶜ) ^ b ≤ Rep 0 b := by
    intro b
    induction b with
    | zero => rw [pow_zero, Ideal.one_eq_top]; exact hone
    | succ b ih => rw [pow_succ]; exact (Ideal.mul_mono ih hY1).trans (hmul 0 b 0 1)
  have := hmul a 0 0 b (Ideal.mul_mono (hPa a) (hYb b) hu)
  rw [Nat.add_zero, Nat.zero_add] at this
  exact (hmem a b u).mp this

open MvPolynomial in
/-- The value of a monomial `x^e` lies in `P^(Zs-degree of e) Y^(Zsᶜ-degree of e)`. -/
private theorem prod_pow_mem {A : Type*} [CommRing A] {σ : Type*} [Fintype σ]
    [DecidableEq σ] (x : σ → A) (Zs : Finset σ) (e : σ →₀ ℕ) :
    ∏ i, x i ^ e i ∈ Ideal.span (x '' ↑Zs) ^ (∑ i ∈ Zs, e i) *
      Ideal.span (x '' ↑Zsᶜ) ^ (∑ i ∈ Zsᶜ, e i) := by
  rw [← Finset.prod_mul_prod_compl Zs]
  refine Ideal.mul_mem_mul ?_ ?_
  · rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i hi =>
      Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_image_of_mem x (by simpa using hi))) _
  · rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i hi =>
      Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_image_of_mem x (by simpa using hi))) _

open MvPolynomial in
/-- **Independence of the bidegree components** (the direct sum decomposition of
`Qᵐ/Qᵐ⁺¹` by bidegree), from quasi-regularity of `x`: if `Σ_{a ∈ s} u_a ∈ Qᵐ⁺¹` with
`u_a ∈ Pᵃ Yᵐ⁻ᵃ` (`a ≤ m`), then every `u_a ∈ Q Pᵃ Yᵐ⁻ᵃ`. -/
theorem mem_mul_of_sum_mem_pow {A : Type*} [CommRing A] {σ : Type*} [Fintype σ]
    [DecidableEq σ] (x : σ → A) (hqr : IsQuasiRegular x) (Zs : Finset σ)
    (m : ℕ) (s : Finset ℕ) (hs : ∀ a ∈ s, a ≤ m) (u : ℕ → A)
    (hu : ∀ a ∈ s, u a ∈ Ideal.span (x '' ↑Zs) ^ a * Ideal.span (x '' ↑Zsᶜ) ^ (m - a))
    (hsum : ∑ a ∈ s, u a ∈ Ideal.span (Set.range x) ^ (m + 1)) :
    ∀ a ∈ s, u a ∈ Ideal.span (Set.range x) *
      (Ideal.span (x '' ↑Zs) ^ a * Ideal.span (x '' ↑Zsᶜ) ^ (m - a)) := by
  classical
  choose! U hU hUe using fun a ha => exists_biHom_of_mem x Zs a (m - a) (hu a ha)
  have hFhom : (∑ a ∈ s, U a).IsHomogeneous m := by
    refine IsHomogeneous.sum _ _ _ fun a ha => ?_
    intro e he
    obtain ⟨h1, h2⟩ := hU a ha e (mem_support_iff.mpr he)
    rw [Finsupp.weight_eq_sum, ← Finset.sum_add_sum_compl Zs]
    simp only [Pi.one_apply, smul_eq_mul, mul_one]
    rw [h1, h2]
    have := hs a ha
    omega
  have hFeval : eval x (∑ a ∈ s, U a) = ∑ a ∈ s, u a := by
    rw [map_sum]
    exact Finset.sum_congr rfl fun a ha => hUe a ha
  have hcoef := hqr m _ hFhom (hFeval ▸ hsum)
  intro a₀ ha₀
  have hcoef₀ : ∀ e, (U a₀).coeff e ∈ Ideal.span (Set.range x) := by
    intro e
    by_cases he : (U a₀).coeff e = 0
    · rw [he]; exact zero_mem _
    have hze := (hU a₀ ha₀ e (mem_support_iff.mpr he)).1
    have : (∑ a ∈ s, U a).coeff e = (U a₀).coeff e := by
      rw [coeff_sum]
      refine Finset.sum_eq_single a₀ (fun b hb hba => ?_) (fun h => absurd ha₀ h)
      by_contra hne
      exact hba ((hU b hb e (mem_support_iff.mpr hne)).1.symm.trans hze)
    rw [← this]
    exact hcoef e
  rw [← hUe a₀ ha₀, eval_eq']
  refine Ideal.sum_mem _ fun e he => Ideal.mul_mem_mul (hcoef₀ e) ?_
  obtain ⟨hz, hy⟩ := hU a₀ ha₀ e he
  have := prod_pow_mem x Zs e
  rwa [hz, hy] at this

/-- `(P ⊔ Y)ᵏ ⊆ Σ_{a ≤ k} Pᵃ Yᵏ⁻ᵃ`. -/
private theorem sup_pow_le_sum {A : Type*} [CommRing A] (P Y : Ideal A) (k : ℕ) :
    (P ⊔ Y) ^ k ≤ ∑ a ∈ Finset.Icc 0 k, P ^ a * Y ^ (k - a) := by
  rw [← Submodule.add_eq_sup, add_pow]
  refine sum_le_of_forall _ _ fun a ha =>
    Ideal.mul_le_left.trans (le_sum_of_mem (fun a => P ^ a * Y ^ (k - a)) ?_)
  simp only [Finset.mem_range] at ha
  simp only [Finset.mem_Icc]
  omega

private theorem mul_pow_le_pow {A : Type*} [CommRing A]
    {P Y Q : Ideal A} (hP : P ≤ Q) (hY : Y ≤ Q) (a b : ℕ) :
    P ^ a * Y ^ b ≤ Q ^ (a + b) := by
  rw [pow_add]
  exact Ideal.mul_mono (Ideal.pow_right_mono hP a) (Ideal.pow_right_mono hY b)

private theorem sum_le_pow_mul {A : Type*} [CommRing A]
    {P Y Q : Ideal A} (hP : P ≤ Q) (hY : Y ≤ Q) (ν μ : ℕ) :
    ∑ a ∈ Finset.Icc ν μ, P ^ a * Y ^ (μ - a) ≤ P ^ ν * Q ^ (μ - ν) := by
  refine sum_le_of_forall _ _ fun a ha => ?_
  obtain ⟨h1, h2⟩ := Finset.mem_Icc.mp ha
  have : P ^ a = P ^ ν * P ^ (a - ν) := by rw [← pow_add, Nat.add_sub_cancel' h1]
  rw [this, mul_assoc]
  refine Ideal.mul_mono_right ?_
  have := mul_pow_le_pow hP hY (a - ν) (μ - a)
  rwa [show a - ν + (μ - a) = μ - ν by omega] at this

/-- `Pᵛ ∩ Qᵘ = Σ_{ν ≤ a ≤ μ} Pᵃ Yᵘ⁻ᵃ` (inclusion `⊆`), from the independence of the bidegree
components. -/
theorem inf_pow_le_sum {A : Type*} [CommRing A] (P Y Q : Ideal A) (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → A,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    (ν μ : ℕ) (hνμ : ν ≤ μ) :
    P ^ ν ⊓ Q ^ μ ≤ ∑ a ∈ Finset.Icc ν μ, P ^ a * Y ^ (μ - a) := by
  induction μ, hνμ using Nat.le_induction with
  | base =>
    refine inf_le_left.trans (le_of_eq_of_le ?_
      (le_sum_of_mem (fun a => P ^ a * Y ^ (ν - a)) (Finset.left_mem_Icc.mpr le_rfl)))
    simp
  | succ μ hνμ ih =>
    intro g hg
    have hg' : g ∈ P ^ ν ⊓ Q ^ μ := ⟨hg.1, Ideal.pow_le_pow_right (Nat.le_succ μ) hg.2⟩
    obtain ⟨u, hu, rfl⟩ := exists_eq_sum_of_mem_sum _ _ (ih hg')
    have hQu := hind μ _ (fun a ha => (Finset.mem_Icc.mp ha).2) u hu hg.2
    refine Ideal.sum_mem _ fun a ha => ?_
    have haI := Finset.mem_Icc.mp ha
    have h := hQu a ha
    rw [hQ, Ideal.sup_mul, Submodule.mem_sup] at h
    obtain ⟨y, hy, z, hz, hyz⟩ := h
    rw [← hyz]
    refine add_mem (le_sum_of_mem (fun a => P ^ a * Y ^ (μ + 1 - a)) (a := a + 1)
      (Finset.mem_Icc.mpr ⟨by omega, by omega⟩) ?_)
      (le_sum_of_mem (fun a => P ^ a * Y ^ (μ + 1 - a)) (a := a)
      (Finset.mem_Icc.mpr ⟨by omega, by omega⟩) ?_)
    · have e : P * (P ^ a * Y ^ (μ - a)) = P ^ (a + 1) * Y ^ (μ + 1 - (a + 1)) := by
        rw [show μ + 1 - (a + 1) = μ - a by omega, pow_succ]
        ring
      rw [← e]
      exact hy
    · have e : Y * (P ^ a * Y ^ (μ - a)) = P ^ a * Y ^ (μ + 1 - a) := by
        rw [show μ + 1 - a = μ - a + 1 by omega, pow_succ]
        ring
      rw [← e]
      exact hz

/-- The step (I5): an element of `Pᵛ Yᵘ⁻ᵛ` lying in `QⁿPᵛ + Pᵛ⁺¹` with `μ < ν + n` lies in
`Qᵘ⁺¹`. -/
theorem mem_pow_succ_of_mem_sup {A : Type*} [CommRing A] (P Y Q : Ideal A) (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → A,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    {ν μ n : ℕ} (hνμ : ν ≤ μ) (hμ : μ < ν + n) {w : A} (hw : w ∈ P ^ ν * Y ^ (μ - ν))
    (hw' : w ∈ Q ^ n * P ^ ν ⊔ P ^ (ν + 1)) : w ∈ Q ^ (μ + 1) := by
  classical
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  have hYQ : Y ≤ Q := hQ ▸ le_sup_right
  obtain ⟨q, hq, p, hp, rfl⟩ := Submodule.mem_sup.mp hw'
  have hq' : q ∈ Q ^ (μ + 1) := by
    have : Q ^ n * P ^ ν ≤ Q ^ (μ + 1) :=
      calc Q ^ n * P ^ ν ≤ Q ^ n * Q ^ ν := Ideal.mul_mono_right (Ideal.pow_right_mono hPQ ν)
        _ = Q ^ (n + ν) := (pow_add Q n ν).symm
        _ ≤ Q ^ (μ + 1) := Ideal.pow_le_pow_right (by omega)
    exact this hq
  rcases hνμ.lt_or_eq with hlt | heq
  · have hwQ : q + p ∈ Q ^ μ := by
      have := mul_pow_le_pow hPQ hYQ ν (μ - ν) hw
      rwa [Nat.add_sub_cancel' hνμ] at this
    have hpQ : p ∈ Q ^ μ := by
      have := sub_mem hwQ (Ideal.pow_le_pow_right (Nat.le_succ μ) hq')
      rwa [add_sub_cancel_left] at this
    obtain ⟨r, hr, hrsum⟩ := exists_eq_sum_of_mem_sum _ _
      (inf_pow_le_sum P Y Q hQ hind (ν + 1) μ hlt ⟨hp, hpQ⟩)
    let z : ℕ → A := fun a => if a = ν then q + p else -r a
    have hIcc : Finset.Icc ν μ = insert ν (Finset.Icc (ν + 1) μ) :=
      (Finset.insert_Icc_add_one_left_eq_Icc hνμ).symm
    have hνnot : ν ∉ Finset.Icc (ν + 1) μ := by simp
    have hsum : ∑ a ∈ Finset.Icc ν μ, z a = q := by
      rw [hIcc, Finset.sum_insert hνnot]
      have : ∑ a ∈ Finset.Icc (ν + 1) μ, z a = -p := by
        rw [← hrsum, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun a ha => ?_
        have : a ≠ ν := by rintro rfl; exact hνnot ha
        simp [z, this]
      rw [this]
      simp [z]
    have hzmem : ∀ a ∈ Finset.Icc ν μ, z a ∈ P ^ a * Y ^ (μ - a) := by
      intro a ha
      by_cases haν : a = ν
      · subst haν
        simpa [z] using hw
      · have ha' : a ∈ Finset.Icc (ν + 1) μ := by
          rw [hIcc] at ha
          exact (Finset.mem_insert.mp ha).resolve_left haν
        simpa [z, haν] using neg_mem (hr a ha')
    have := hind μ _ (fun a ha => (Finset.mem_Icc.mp ha).2) z hzmem (hsum ▸ hq') ν
      (Finset.left_mem_Icc.mpr hνμ)
    simp only [z, ↓reduceIte] at this
    have hle : Q * (P ^ ν * Y ^ (μ - ν)) ≤ Q ^ (μ + 1) := by
      rw [pow_succ']
      refine Ideal.mul_mono_right ?_
      have := mul_pow_le_pow hPQ hYQ ν (μ - ν)
      rwa [Nat.add_sub_cancel' hνμ] at this
    exact hle this
  · subst heq
    exact add_mem hq' (Ideal.pow_right_mono hPQ _ hp)

/-- The core computation of the proof of Lemma 7 (pp. 191–192), at the level of `R`:
given `g ∈ Pᵛ ∩ Qᵘ` and `c_β ∈ Q^(μ-ν_β)` with `g - Σ c_β f_β ∈ Qᵘ⁺¹` (condition (ii)),
split `Σ c_β f_β` according to the bidegree. -/
private theorem exists_decomposition_of_sub_sum_mem {A : Type*} [CommRing A] (P Y Q J : Ideal A) (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → A,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    {m : ℕ} (f : Fin m → A) (νf : Fin m → ℕ) (hfJ : ∀ β, f β ∈ J)
    (hfP : ∀ β, f β ∈ P ^ νf β) {ν μ : ℕ} (hνμ : ν ≤ μ) {g : A} (hgP : g ∈ P ^ ν)
    (hgQ : g ∈ Q ^ μ) (c : Fin m → A) (hc : ∀ β, c β ∈ Q ^ (μ - νf β))
    (hc0 : ∀ β, μ < νf β → c β = 0) (hgc : g - ∑ β, c β * f β ∈ Q ^ (μ + 1)) :
    ∃ uν htop hlow : A, uν ∈ P ^ ν * Y ^ (μ - ν) ∧ g - uν ∈ P ^ (ν + 1) ∧
      uν - htop ∈ Q ^ (μ + 1) ∧
      htop ∈ ∑ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
        P ^ (ν - νf β) * Y ^ (μ - ν) * Ideal.span {f β} ∧
      hlow ∈ J ⊓ P ^ (ν + 1) ∧ g - htop - hlow ∈ Q ^ (μ + 1) := by
  classical
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  have hYQ : Y ≤ Q := hQ ▸ le_sup_right
  -- the bidegree decomposition of `g`
  obtain ⟨u, hu, hug⟩ := exists_eq_sum_of_mem_sum _ _
    (inf_pow_le_sum P Y Q hQ hind ν μ hνμ ⟨hgP, hgQ⟩)
  -- the bidegree decomposition of `c_β f_β`, keeping track of the factor `f_β`
  have hcf : ∀ β, c β * f β ∈ ∑ a ∈ Finset.Icc (νf β) μ,
      P ^ (a - νf β) * Y ^ (μ - a) * Ideal.span {f β} := by
    intro β
    by_cases hβ : νf β ≤ μ
    · have h1 : c β ∈ ∑ a ∈ Finset.Icc 0 (μ - νf β), P ^ a * Y ^ (μ - νf β - a) :=
        sup_pow_le_sum P Y _ (hQ ▸ hc β)
      have h2 := Ideal.mul_mem_mul h1 (Ideal.mem_span_singleton_self (f β))
      rw [Finset.sum_mul] at h2
      refine sum_le_of_forall _ _ (fun a ha => ?_) h2
      have ha' := Finset.mem_Icc.mp ha
      have := le_sum_of_mem (s := Finset.Icc (νf β) μ)
        (fun a => P ^ (a - νf β) * Y ^ (μ - a) * Ideal.span {f β}) (a := a + νf β)
        (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
      rwa [show a + νf β - νf β = a by omega, show μ - (a + νf β) = μ - νf β - a by omega]
        at this
    · rw [hc0 β (not_le.mp hβ), zero_mul]
      exact zero_mem _
  choose v hv hvsum using fun β => exists_eq_sum_of_mem_sum _ _ (hcf β)
  -- extensions by zero to `[0, μ]`
  let u' : ℕ → A := fun a => if a ∈ Finset.Icc ν μ then u a else 0
  let v' : Fin m → ℕ → A := fun β a => if a ∈ Finset.Icc (νf β) μ then v β a else 0
  have hv'mem : ∀ β a, v' β a ∈ P ^ a * Y ^ (μ - a) ∧ v' β a ∈ Ideal.span {f β} := by
    intro β a
    by_cases ha : a ∈ Finset.Icc (νf β) μ
    · have h := hv β a ha
      simp only [v', ha, ↓reduceIte]
      refine ⟨?_, ?_⟩
      · have hle : P ^ (a - νf β) * Y ^ (μ - a) * Ideal.span {f β} ≤ P ^ a * Y ^ (μ - a) := by
          have hf : Ideal.span {f β} ≤ P ^ νf β := (Ideal.span_singleton_le_iff_mem _).mpr (hfP β)
          calc P ^ (a - νf β) * Y ^ (μ - a) * Ideal.span {f β}
              ≤ P ^ (a - νf β) * Y ^ (μ - a) * P ^ νf β := Ideal.mul_mono_right hf
            _ = P ^ (a - νf β + νf β) * Y ^ (μ - a) := by rw [pow_add]; ring
            _ = P ^ a * Y ^ (μ - a) := by
                rw [Nat.sub_add_cancel (Finset.mem_Icc.mp ha).1]
        exact hle h
      · exact Ideal.mul_le_right h
    · simp only [v', ha, ↓reduceIte]
      exact ⟨zero_mem _, zero_mem _⟩
  have hu'mem : ∀ a, u' a ∈ P ^ a * Y ^ (μ - a) := by
    intro a
    by_cases ha : a ∈ Finset.Icc ν μ
    · simp only [u', ha, ↓reduceIte]
      exact hu a ha
    · simp only [u', ha, ↓reduceIte]
      exact zero_mem _
  have hsum_v' : ∀ β, ∑ a ∈ Finset.Icc 0 μ, v' β a = c β * f β := by
    intro β
    simp only [v']
    rw [Finset.sum_ite_mem, Finset.inter_eq_right.mpr
      (Finset.Icc_subset_Icc (Nat.zero_le _) le_rfl), hvsum β]
  have hsum_u'ν : ∑ a ∈ Finset.Icc ν μ, u' a = g := by
    rw [← hug]
    exact Finset.sum_congr rfl fun a ha => by simp only [u', ha, ↓reduceIte]
  have hsum_u' : ∑ a ∈ Finset.Icc 0 μ, u' a = g := by
    simp only [u']
    rw [Finset.sum_ite_mem, Finset.inter_eq_right.mpr
      (Finset.Icc_subset_Icc (Nat.zero_le _) le_rfl), hug]
  let W : ℕ → A := fun a => u' a - ∑ β, v' β a
  have hWmem : ∀ a ∈ Finset.Icc 0 μ, W a ∈ P ^ a * Y ^ (μ - a) := fun a _ =>
    sub_mem (hu'mem a) (Ideal.sum_mem _ fun β _ => (hv'mem β a).1)
  have hWsum : ∑ a ∈ Finset.Icc 0 μ, W a = g - ∑ β, c β * f β := by
    simp only [W, Finset.sum_sub_distrib]
    rw [hsum_u', Finset.sum_comm]
    congr 1
    exact Finset.sum_congr rfl fun β _ => hsum_v' β
  have hW : ∀ a ∈ Finset.Icc 0 μ, W a ∈ Q ^ (μ + 1) := by
    intro a ha
    have h := hind μ _ (fun a ha => (Finset.mem_Icc.mp ha).2) W hWmem (hWsum ▸ hgc) a ha
    have hle : Q * (P ^ a * Y ^ (μ - a)) ≤ Q ^ (μ + 1) := by
      rw [pow_succ']
      refine Ideal.mul_mono_right ?_
      have := mul_pow_le_pow hPQ hYQ a (μ - a)
      rwa [Nat.add_sub_cancel' (Finset.mem_Icc.mp ha).2] at this
    exact hle h
  have hIcc : Finset.Icc ν μ = insert ν (Finset.Icc (ν + 1) μ) :=
    (Finset.insert_Icc_add_one_left_eq_Icc hνμ).symm
  have hνnot : ν ∉ Finset.Icc (ν + 1) μ := by simp
  refine ⟨u' ν, ∑ β, v' β ν, ∑ a ∈ Finset.Icc (ν + 1) μ, ∑ β, v' β a, hu'mem ν, ?_, ?_, ?_,
    ?_, ?_⟩
  · rw [← hsum_u'ν, hIcc, Finset.sum_insert hνnot, add_sub_cancel_left]
    refine Ideal.sum_mem _ fun a ha => ?_
    exact Ideal.pow_le_pow_right (Finset.mem_Icc.mp ha).1 (Ideal.mul_le_left (hu'mem a))
  · exact hW ν (Finset.mem_Icc.mpr ⟨Nat.zero_le _, hνμ⟩)
  · refine Ideal.sum_mem _ fun β _ => ?_
    by_cases hβ : νf β ≤ ν
    · have hmemβ : ν ∈ Finset.Icc (νf β) μ := Finset.mem_Icc.mpr ⟨hβ, hνμ⟩
      have h := hv β ν hmemβ
      simp only [v', hmemβ, ↓reduceIte]
      exact le_sum_of_mem (fun β => P ^ (ν - νf β) * Y ^ (μ - ν) * Ideal.span {f β})
        (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hβ⟩) h
    · have hmemβ : ν ∉ Finset.Icc (νf β) μ := fun h => hβ (Finset.mem_Icc.mp h).1
      simp only [v', hmemβ, ↓reduceIte]
      exact zero_mem _
  · refine ⟨Ideal.sum_mem _ fun a _ => Ideal.sum_mem _ fun β _ => ?_,
      Ideal.sum_mem _ fun a ha => Ideal.sum_mem _ fun β _ => ?_⟩
    · exact (Ideal.span_singleton_le_iff_mem _).mpr (hfJ β) (hv'mem β a).2
    · exact Ideal.pow_le_pow_right (Finset.mem_Icc.mp ha).1 (Ideal.mul_le_left (hv'mem β a).1)
  · have : g - ∑ β, v' β ν - ∑ a ∈ Finset.Icc (ν + 1) μ, ∑ β, v' β a =
        ∑ a ∈ Finset.Icc ν μ, W a := by
      simp only [W, Finset.sum_sub_distrib]
      rw [hsum_u'ν, hIcc, Finset.sum_insert hνnot]
      ring
    rw [this]
    exact Ideal.sum_mem _ fun a ha =>
      hW a (Finset.mem_Icc.mpr ⟨Nat.zero_le _, (Finset.mem_Icc.mp ha).2⟩)

/-- The main step of the proof of Lemma 7 (p. 192), at the level of `R`: for `g ∈ J ∩ Pᵛ`
whose class in `grᵛ_P(R)` lies in `Qⁿ gr_P(R)`, the class of `g` lies in `QⁿH + Qⁿ⁺¹gr_P(R)`. -/
private theorem mem_sum_sup_sup_of_mem_inf {A : Type*} [CommRing A] (P Y Q J : Ideal A) (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → A,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    {m : ℕ} (f : Fin m → A) (νf : Fin m → ℕ) (hfJ : ∀ β, f β ∈ J)
    (hfP : ∀ β, f β ∈ P ^ νf β)
    (hSB : ∀ (μ : ℕ) (g : A), g ∈ J → g ∈ Q ^ μ → ∃ c : Fin m → A,
      (∀ β, c β ∈ Q ^ (μ - νf β)) ∧ (∀ β, μ < νf β → c β = 0) ∧
        g - ∑ β, c β * f β ∈ Q ^ (μ + 1))
    (ν n : ℕ) {g : A} (hgJ : g ∈ J) (hgP : g ∈ P ^ ν)
    (hg : g ∈ Q ^ n * P ^ ν ⊔ P ^ (ν + 1)) :
    g ∈ (∑ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
        Q ^ n * P ^ (ν - νf β) * Ideal.span {f β}) ⊔ P ^ (ν + 1) ⊔ Q ^ (n + 1) * P ^ ν := by
  classical
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  have hYQ : Y ≤ Q := hQ ▸ le_sup_right
  set H := ∑ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
    Q ^ n * P ^ (ν - νf β) * Ideal.span {f β} with hH
  have hPν : ∀ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
      P ^ (ν - νf β) * Ideal.span {f β} ≤ P ^ ν := by
    intro β hβ
    have hβ' := (Finset.mem_filter.mp hβ).2
    calc P ^ (ν - νf β) * Ideal.span {f β} ≤ P ^ (ν - νf β) * P ^ νf β :=
          Ideal.mul_mono_right ((Ideal.span_singleton_le_iff_mem _).mpr (hfP β))
      _ = P ^ ν := by rw [← pow_add, Nat.sub_add_cancel hβ']
  -- the case `μ ≥ ν + n`
  have case1 : ∀ μ g, ν + n ≤ μ → g ∈ J → g ∈ P ^ ν → g ∈ Q ^ μ →
      g ∈ H ⊔ P ^ (ν + 1) ⊔ Q ^ (n + 1) * P ^ ν := by
    intro μ g hμ hgJ hgP hgQ
    have hνμ : ν ≤ μ := by omega
    obtain ⟨c, hc, hc0, hgc⟩ := hSB μ g hgJ hgQ
    obtain ⟨-, htop, hlow, -, -, -, htopmem, hlowmem, hrest⟩ :=
      exists_decomposition_of_sub_sum_mem P Y Q J hQ hind f νf hfJ hfP hνμ hgP hgQ c hc hc0 hgc
    have htopH : htop ∈ H := by
      refine sum_le_of_forall _ _ (fun β hβ => ?_) htopmem
      refine le_trans ?_ (le_sum_of_mem (fun β => Q ^ n * P ^ (ν - νf β) * Ideal.span {f β}) hβ)
      rw [mul_comm (P ^ (ν - νf β)) (Y ^ (μ - ν))]
      refine Ideal.mul_mono_left (Ideal.mul_mono_left ?_)
      exact (Ideal.pow_right_mono hYQ _).trans (Ideal.pow_le_pow_right (by omega))
    have htopP : htop ∈ P ^ ν := by
      refine sum_le_of_forall _ _ (fun β hβ => ?_) htopmem
      refine le_trans ?_ (hPν β hβ)
      rw [mul_comm (P ^ (ν - νf β)) (Y ^ (μ - ν)), mul_assoc]
      exact Ideal.mul_le_right
    have hrestP : g - htop - hlow ∈ P ^ ν :=
      sub_mem (sub_mem hgP htopP) (Ideal.pow_le_pow_right (Nat.le_succ ν) hlowmem.2)
    have hrest' : g - htop - hlow ∈ Q ^ (n + 1) * P ^ ν := by
      have h1 := sum_le_pow_mul hPQ hYQ ν (μ + 1)
        (inf_pow_le_sum P Y Q hQ hind ν (μ + 1) (by omega) ⟨hrestP, hrest⟩)
      rw [mul_comm]
      exact Ideal.mul_mono_right (Ideal.pow_le_pow_right (by omega)) h1
    have : g = htop + hlow + (g - htop - hlow) := by ring
    rw [this]
    exact add_mem (add_mem (Ideal.mem_sup_left (Ideal.mem_sup_left htopH))
      (Ideal.mem_sup_left (Ideal.mem_sup_right hlowmem.2))) (Ideal.mem_sup_right hrest')
  suffices H' : ∀ k μ g, ν + n ≤ μ + k → ν ≤ μ → g ∈ J → g ∈ P ^ ν → g ∈ Q ^ μ →
      g ∈ Q ^ n * P ^ ν ⊔ P ^ (ν + 1) → g ∈ H ⊔ P ^ (ν + 1) ⊔ Q ^ (n + 1) * P ^ ν from
    H' n ν g le_rfl le_rfl hgJ hgP (Ideal.pow_right_mono hPQ ν hgP) hg
  intro k
  induction k with
  | zero => exact fun μ g hk _ hgJ hgP hgQ _ => case1 μ g (by omega) hgJ hgP hgQ
  | succ k ih =>
    intro μ g hk hνμ hgJ hgP hgQ hg
    by_cases hμ : ν + n ≤ μ
    · exact case1 μ g hμ hgJ hgP hgQ
    obtain ⟨c, hc, hc0, hgc⟩ := hSB μ g hgJ hgQ
    obtain ⟨uν, htop, hlow, huν, hguν, huνtop, -, hlowmem, hrest⟩ :=
      exists_decomposition_of_sub_sum_mem P Y Q J hQ hind f νf hfJ hfP hνμ hgP hgQ c hc hc0 hgc
    have huν' : uν ∈ Q ^ n * P ^ ν ⊔ P ^ (ν + 1) := by
      have : uν = g - (g - uν) := by ring
      rw [this]
      exact sub_mem hg (Ideal.mem_sup_right hguν)
    have huνQ := mem_pow_succ_of_mem_sup P Y Q hQ hind hνμ (by omega) huν huν'
    have htopQ : htop ∈ Q ^ (μ + 1) := by
      have : htop = uν - (uν - htop) := by ring
      rw [this]
      exact sub_mem huνQ huνtop
    have hg' := ih (μ + 1) (g - hlow) (by omega) (by omega) (sub_mem hgJ hlowmem.1)
      (sub_mem hgP (Ideal.pow_le_pow_right (Nat.le_succ ν) hlowmem.2))
      (by
        have : g - hlow = (g - htop - hlow) + htop := by ring
        rw [this]
        exact add_mem hrest htopQ)
      (sub_mem hg (Ideal.mem_sup_right hlowmem.2))
    have : g = (g - hlow) + hlow := by ring
    rw [this]
    exact add_mem hg' (Ideal.mem_sup_left (Ideal.mem_sup_right hlowmem.2))

/-- Iterating the main step and applying Krull's intersection theorem (p. 193). -/
theorem mem_sum_sup_pow_succ_of_mem_inf {A : Type*} [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] (P Y Q J : Ideal A)
    (hQ : Q = P ⊔ Y) (hQtop : Q ≠ ⊤)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → A,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    {m : ℕ} (f : Fin m → A) (νf : Fin m → ℕ) (hfJ : ∀ β, f β ∈ J)
    (hfP : ∀ β, f β ∈ P ^ νf β)
    (hSB : ∀ (μ : ℕ) (g : A), g ∈ J → g ∈ Q ^ μ → ∃ c : Fin m → A,
      (∀ β, c β ∈ Q ^ (μ - νf β)) ∧ (∀ β, μ < νf β → c β = 0) ∧
        g - ∑ β, c β * f β ∈ Q ^ (μ + 1))
    (ν n : ℕ) {g : A} (hgJ : g ∈ J) (hgP : g ∈ P ^ ν)
    (hg : g ∈ Q ^ n * P ^ ν ⊔ P ^ (ν + 1)) :
    g ∈ (∑ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
        Q ^ n * P ^ (ν - νf β) * Ideal.span {f β}) ⊔ P ^ (ν + 1) := by
  classical
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  let E : ℕ → Ideal A := fun n => (∑ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
    Q ^ n * P ^ (ν - νf β) * Ideal.span {f β}) ⊔ P ^ (ν + 1)
  have hHJ : ∀ n, (∑ β ∈ Finset.univ.filter (fun β => νf β ≤ ν),
      Q ^ n * P ^ (ν - νf β) * Ideal.span {f β}) ≤ J ⊓ P ^ ν := by
    intro n
    refine sum_le_of_forall _ _ fun β hβ => le_inf ?_ ?_
    · exact Ideal.mul_le_right.trans ((Ideal.span_singleton_le_iff_mem _).mpr (hfJ β))
    · have hβ' := (Finset.mem_filter.mp hβ).2
      calc Q ^ n * P ^ (ν - νf β) * Ideal.span {f β} ≤ P ^ (ν - νf β) * Ideal.span {f β} :=
            Ideal.mul_mono_left Ideal.mul_le_right
        _ ≤ P ^ (ν - νf β) * P ^ νf β :=
            Ideal.mul_mono_right ((Ideal.span_singleton_le_iff_mem _).mpr (hfP β))
        _ = P ^ ν := by rw [← pow_add, Nat.sub_add_cancel hβ']
  have hEmono : ∀ n, E (n + 1) ≤ E n := by
    intro n
    refine sup_le_sup_right (sum_le_of_forall _ _ fun β hβ => ?_) _
    refine le_trans ?_ (le_sum_of_mem (fun β => Q ^ n * P ^ (ν - νf β) * Ideal.span {f β}) hβ)
    exact Ideal.mul_mono_left (Ideal.mul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ n)))
  have iter : ∀ k n g, g ∈ J → g ∈ P ^ ν → g ∈ Q ^ n * P ^ ν ⊔ P ^ (ν + 1) →
      g ∈ E n ⊔ Q ^ (n + k) := by
    intro k
    induction k with
    | zero =>
      intro n g _ _ hg
      refine (sup_le ?_ ?_ : Q ^ n * P ^ ν ⊔ P ^ (ν + 1) ≤ E n ⊔ Q ^ (n + 0)) hg
      · exact Ideal.mul_le_left.trans le_sup_right
      · exact le_sup_right.trans le_sup_left
    | succ k ih =>
      intro n g hgJ hgP hg
      have h := mem_sum_sup_sup_of_mem_inf P Y Q J hQ hind f νf hfJ hfP hSB ν n hgJ hgP hg
      obtain ⟨e, he, q, hq, rfl⟩ := Submodule.mem_sup.mp h
      obtain ⟨h₀, hh₀, p, hp, rfl⟩ := Submodule.mem_sup.mp he
      have hh₀' := hHJ n hh₀
      have hg' := ih (n + 1) (p + q) (by
          have : p + q = h₀ + p + q - h₀ := by ring
          rw [this]; exact sub_mem hgJ hh₀'.1)
        (by
          have : p + q = h₀ + p + q - h₀ := by ring
          rw [this]; exact sub_mem hgP hh₀'.2)
        (add_mem (Ideal.mem_sup_right hp) (Ideal.mem_sup_left hq))
      have hle : E (n + 1) ⊔ Q ^ (n + 1 + k) ≤ E n ⊔ Q ^ (n + (k + 1)) :=
        sup_le_sup (hEmono n) (le_of_eq (by rw [show n + 1 + k = n + (k + 1) by omega]))
      have : h₀ + p + q = h₀ + (p + q) := by ring
      rw [this]
      exact add_mem (Ideal.mem_sup_left (Ideal.mem_sup_left hh₀)) (hle hg')
  -- Krull's intersection theorem for `A/E n`
  have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing Q (M := A ⧸ E n) hQtop
  have hmem : Ideal.Quotient.mk (E n) g ∈ (⨅ i : ℕ, Q ^ i • ⊤ : Submodule A (A ⧸ E n)) := by
    refine (Submodule.mem_iInf _).mpr fun k => ?_
    obtain ⟨e, he, q, hq, hgeq⟩ := Submodule.mem_sup.mp (iter k n g hgJ hgP hg)
    have hq' : q ∈ Q ^ k := Ideal.pow_le_pow_right (Nat.le_add_left k n) hq
    have h₁ : Ideal.Quotient.mk (E n) g = Ideal.Quotient.mk (E n) q :=
      Ideal.Quotient.eq.mpr (by rw [← hgeq, add_sub_cancel_right]; exact he)
    have h₂ : Ideal.Quotient.mk (E n) q = q • (1 : A ⧸ E n) := Algebra.algebraMap_eq_smul_one q
    rw [h₁, h₂]
    exact Submodule.smul_mem_smul hq' Submodule.mem_top
  rw [hK] at hmem
  exact Ideal.Quotient.eq_zero_iff_mem.mp ((Submodule.mem_bot A).mp hmem)

open IsLocalRing in
/-- The generators of `P ⊆ Q` adapted to each other used in the proof of Lemma 7 (p. 191:
"a regular system of parameters `(z₁, …, z_r, y₁, …, y_s, x₁, …, x_t)` of `R` such that
`P = (z)R` and `Q = (z, y)R`", footnote 41: "cf. footnote 39"): a quasi-regular family `x`
generating `Q` of which a subfamily generates `P`.

Proof as printed: the regular system of parameters `(z, y, x)` of footnote 41 is
`exists_isRegularSystemOfParameters_span_eq_of_le` (built from footnote 39,
`span_range_eq_iff_span_range_cotangentClass_eq`, as in the paper); the family `x` below
enumerates `z ∪ y`, which is part of that regular system of parameters, hence quasi-regular
(`isQuasiRegular_of_minimal`); the elements `x₁, …, x_t` are not needed afterwards. -/
theorem exists_adapted_quasiRegular {R : Type u} [CommRing R] [IsRegularLocalRing R]
    (P Q : Ideal R) [P.IsPrime] [Q.IsPrime] (hPQ : P ≤ Q) (hP : IsRegularLocalRing (R ⧸ P))
    (hQ : IsRegularLocalRing (R ⧸ Q)) :
    ∃ (N : ℕ) (x : Fin N → R) (Zs : Finset (Fin N)), IsQuasiRegular x ∧
      Ideal.span (Set.range x) = Q ∧ Ideal.span (x '' ↑Zs) = P := by
  classical
  obtain ⟨Z, Y, X, -, -, hS, hZ, hZY, -, -⟩ :=
    exists_isRegularSystemOfParameters_span_eq_of_le P Q hPQ hP hQ
  have hScard : (Z ∪ Y ∪ X).card = (maximalIdeal R).spanFinrank := by
    have h := hS.2
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal] at h
    exact_mod_cast h
  -- the family `x` enumerating `z ∪ y`
  set U := Z ∪ Y with hU
  let x : Fin U.card → R := fun i => (U.equivFin.symm i : R)
  have hinj : Function.Injective x := Subtype.val_injective.comp U.equivFin.symm.injective
  have hrange : Set.range x = (U : Set R) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (U.equivFin.symm i).2
    · intro hy
      exact ⟨U.equivFin ⟨y, hy⟩, by simp [x]⟩
  refine ⟨U.card, x, Finset.univ.filter (fun i => x i ∈ Z), ?_, ?_, ?_⟩
  · exact isQuasiRegular_of_minimal hS.1 hScard hinj fun i =>
      Finset.mem_union_left _ (U.equivFin.symm i).2
  · rw [hrange, hZY]
  · have : x '' ↑(Finset.univ.filter (fun i => x i ∈ Z)) = (Z : Set R) := by
      ext y
      constructor
      · rintro ⟨i, hi, rfl⟩
        simpa using hi
      · intro hy
        have hy' : y ∈ Z := Finset.mem_coe.mp hy
        have hyU : y ∈ U := Finset.mem_union_left _ hy'
        exact ⟨U.equivFin ⟨y, hyU⟩, by simp [x, hy'], by simp [x]⟩
    rw [this, hZ]

open Polynomial in
/-- The degree-`m` component of `[b Xⁱ] · [p]` is `[b · coeff p (m - i)]` (`i ≤ m`). -/
private theorem grProj_mk_mul_quotMk {A : Type u} [CommRing A]
    (I : Ideal A) {i m : ℕ} (b : A) (hb : b ∈ I ^ i)
    (ψ : AssocGraded I) (p : reesAlgebra I)
    (hp : Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I) p = ψ) (him : i ≤ m)
    (hmem : b * (p : A[X]).coeff (m - i) ∈ I ^ m) :
    grProj I m (AssocGraded.mk I i b hb * ψ) =
      Submodule.Quotient.mk ⟨b * (p : A[X]).coeff (m - i), hmem⟩ := by
  have key : grProj I m (AssocGraded.mk I i b hb * ψ) =
      Submodule.Quotient.mk
        (reesCoeff I m (⟨monomial i b, reesAlgebra.monomial_mem.mpr hb⟩ * p)) := by
    rw [← hp]
    rfl
  rw [key]
  congr 1
  apply Subtype.ext
  show (monomial i b * (p : A[X])).coeff m = b * (p : A[X]).coeff (m - i)
  rw [← C_mul_X_pow_eq_monomial, mul_assoc, coeff_C_mul, coeff_X_pow_mul']
  simp [him]

open Polynomial in
/-- The degree-`m` component of `[b Xⁱ] · [p]` vanishes if `m < i`. -/
private theorem grProj_mk_mul_quotMk_of_lt {A : Type u} [CommRing A]
    (I : Ideal A) {i m : ℕ} (b : A) (hb : b ∈ I ^ i)
    (ψ : AssocGraded I) (p : reesAlgebra I)
    (hp : Ideal.Quotient.mk (Ideal.map (algebraMap A (reesAlgebra I)) I) p = ψ) (hmi : m < i) :
    grProj I m (AssocGraded.mk I i b hb * ψ) = 0 := by
  have key : grProj I m (AssocGraded.mk I i b hb * ψ) =
      Submodule.Quotient.mk
        (reesCoeff I m (⟨monomial i b, reesAlgebra.monomial_mem.mpr hb⟩ * p)) := by
    rw [← hp]
    rfl
  rw [key, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply,
    reesCoeff_apply]
  show (monomial i b * (p : A[X])).coeff m ∈ I ^ (m + 1)
  rw [← C_mul_X_pow_eq_monomial, mul_assoc, coeff_C_mul, coeff_X_pow_mul']
  simp [show ¬ i ≤ m by omega]

open Polynomial in
/-- Condition (ii) of Lemma 7 in the form used by the proof: if the initial forms of the `f_β`
generate `gr_Q(J, R)`, then every `g ∈ J ∩ Qᵘ` is congruent modulo `Qᵘ⁺¹` to a combination
`Σ c_β f_β` with `c_β ∈ Q^(μ - ν_Q(f_β))`. -/
theorem exists_coeff_of_span_initialForm {A : Type u} [CommRing A]
    (Q J : Ideal A) {m : ℕ} (f : Fin m → A)
    (h₂ : Ideal.span (Set.range fun j => initialForm Q (f j)) = grIdeal Q J)
    (μ : ℕ) (g : A) (hgJ : g ∈ J) (hgQ : g ∈ Q ^ μ) :
    ∃ c : Fin m → A, (∀ β, c β ∈ Q ^ (μ - (Ideal.ordElem Q (f β)).toNat)) ∧
      (∀ β, μ < (Ideal.ordElem Q (f β)).toNat → c β = 0) ∧
        g - ∑ β, c β * f β ∈ Q ^ (μ + 1) := by
  classical
  have hmem := mk_mem_grIdeal Q hgJ hgQ
  rw [← h₂, Ideal.mem_span_range_iff_exists_fun] at hmem
  obtain ⟨Ψ, hΨ⟩ := hmem
  choose p hp using fun β => Ideal.Quotient.mk_surjective (Ψ β)
  set νf : Fin m → ℕ := fun β => (Ideal.ordElem Q (f β)).toNat with hνf
  let c : Fin m → A := fun β =>
    if Ideal.ordElem Q (f β) ≠ ⊤ ∧ νf β ≤ μ then ((p β : reesAlgebra Q) : A[X]).coeff (μ - νf β)
    else 0
  have hc : ∀ β, c β ∈ Q ^ (μ - νf β) := by
    intro β
    simp only [c]
    split_ifs
    · exact (mem_reesAlgebra_iff Q (p β)).mp (p β).2 _
    · exact zero_mem _
  have hc0 : ∀ β, μ < νf β → c β = 0 := by
    intro β hβ
    simp only [c]
    rw [ite_eq_right_iff]
    intro h
    omega
  have hfQ : ∀ β, f β ∈ Q ^ νf β := by
    intro β
    by_cases h : Ideal.ordElem Q (f β) = ⊤
    · exact Ideal.ordElem_eq_top_iff.mp h _
    · exact Ideal.mem_pow_of_ordElem (ENat.natCast_toNat h).symm
  have hcf : ∀ β, c β * f β ∈ Q ^ μ := by
    intro β
    by_cases hβ : νf β ≤ μ
    · have : Q ^ (μ - νf β) * Q ^ νf β = Q ^ μ := by rw [← pow_add, Nat.sub_add_cancel hβ]
      rw [← this]
      exact Ideal.mul_mem_mul (hc β) (hfQ β)
    · rw [hc0 β (not_le.mp hβ), zero_mul]
      exact zero_mem _
  have hterm : ∀ β, grProj Q μ (Ψ β * initialForm Q (f β)) =
      Submodule.Quotient.mk ⟨c β * f β, hcf β⟩ := by
    intro β
    by_cases htop : Ideal.ordElem Q (f β) = ⊤
    · have hc0' : c β = 0 := by simp [c, htop]
      have hif : initialForm Q (f β) = 0 := by simp only [initialForm, htop, ↓reduceDIte]
      rw [hif, mul_zero, map_zero, eq_comm, Submodule.Quotient.mk_eq_zero]
      simp [hc0']
    · rw [initialForm_eq_mk Q (ENat.natCast_toNat htop).symm, mul_comm]
      by_cases hβ : νf β ≤ μ
      · have hcβ : c β = ((p β : reesAlgebra Q) : A[X]).coeff (μ - νf β) := by
          simp [c, htop, hβ]
        have hmem : f β * ((p β : reesAlgebra Q) : A[X]).coeff (μ - νf β) ∈ Q ^ μ := by
          rw [← hcβ, mul_comm]
          exact hcf β
        rw [grProj_mk_mul_quotMk Q _ _ _ _ (hp β) hβ hmem]
        congr 1
        apply Subtype.ext
        simp only
        rw [hcβ, mul_comm]
      · rw [grProj_mk_mul_quotMk_of_lt Q _ _ _ _ (hp β) (not_le.mp hβ), eq_comm,
          Submodule.Quotient.mk_eq_zero]
        simp [hc0 β (not_le.mp hβ)]
  have hsum : grProj Q μ (AssocGraded.mk Q μ g hgQ) =
      ∑ β, Submodule.Quotient.mk (p := Submodule.comap (Q ^ μ).subtype (Q ^ (μ + 1)))
        ⟨c β * f β, hcf β⟩ := by
    rw [← hΨ, map_sum]
    exact Finset.sum_congr rfl fun β _ => hterm β
  rw [grProj_mk_same] at hsum
  refine ⟨c, hc, hc0, ?_⟩
  have hsum' : (Submodule.Quotient.mk ⟨g, hgQ⟩ :
      GrPiece Q μ) = Submodule.Quotient.mk ⟨∑ β, c β * f β, sum_mem fun β _ => hcf β⟩ := by
    rw [hsum]
    have : (⟨∑ β, c β * f β, sum_mem fun β _ => hcf β⟩ : ↥(Q ^ μ)) =
        ∑ β, (⟨c β * f β, hcf β⟩ : ↥(Q ^ μ)) := by
      apply Subtype.ext
      rw [Submodule.coe_sum]
    rw [this, ← Submodule.mkQ_apply, map_sum]
    rfl
  rw [Submodule.Quotient.eq] at hsum'
  exact hsum'

private theorem AssocGraded.mk_congr {A : Type u} [CommRing A]
    (I : Ideal A) {n n' : ℕ} {a a' : A} (hn : n = n') (ha : a = a')
    (h1 : a ∈ I ^ n) (h2 : a' ∈ I ^ n') :
    AssocGraded.mk I n a h1 = AssocGraded.mk I n' a' h2 := by
  subst hn
  subst ha
  rfl

private theorem mk_eq_mk_of_sub_mem {A : Type u} [CommRing A]
    (I : Ideal A) {n : ℕ} {a b : A} (ha : a ∈ I ^ n)
    (hb : b ∈ I ^ n) (h : a - b ∈ I ^ (n + 1)) :
    AssocGraded.mk I n a ha = AssocGraded.mk I n b hb := by
  rw [AssocGraded.mk_congr I rfl (sub_add_cancel a b).symm ha (add_mem (sub_mem ha hb) hb), AssocGraded.mk_add I n _ _
    (sub_mem ha hb) hb, (AssocGraded.mk_eq_zero_iff I (sub_mem ha hb)).mpr h, zero_add]

private theorem mk_sum_mem {A : Type u} [CommRing A]
    (I : Ideal A) {n : ℕ} (K : Ideal (AssocGraded I)) {ι : Type*}
    (s : Finset ι) (x : ι → A) (hx : ∀ i ∈ s, x i ∈ I ^ n)
    (hK : ∀ i (hi : i ∈ s), AssocGraded.mk I n (x i) (hx i hi) ∈ K)
    (hs : ∑ i ∈ s, x i ∈ I ^ n) : AssocGraded.mk I n (∑ i ∈ s, x i) hs ∈ K := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [(AssocGraded.mk_eq_zero_iff I hs).mpr (by simp)]
    exact zero_mem _
  | insert a s ha ih =>
    have hxa := hx a (Finset.mem_insert_self a s)
    have hxs : ∀ i ∈ s, x i ∈ I ^ n := fun i hi => hx i (Finset.mem_insert_of_mem hi)
    have hs' : ∑ i ∈ s, x i ∈ I ^ n := sum_mem hxs
    rw [AssocGraded.mk_congr I rfl (Finset.sum_insert ha) hs (add_mem hxa hs'), AssocGraded.mk_add I n _ _ hxa hs']
    exact add_mem (hK a (Finset.mem_insert_self a s))
      (ih hxs (fun i hi => hK i (Finset.mem_insert_of_mem hi)) hs')

/-- The degree-`i` component of an element of `I gr_P(A)` is the class of an element of
`I Pⁱ`. -/
private theorem exists_mem_mul_of_mem_map {A : Type u} [CommRing A]
    (P I : Ideal A) {Ψ : AssocGraded P}
    (hΨ : Ψ ∈ I.map (algebraMap A (AssocGraded P))) (i : ℕ) :
    ∃ a ∈ I * P ^ i, ∃ ha : a ∈ P ^ i, Submodule.Quotient.mk ⟨a, ha⟩ = grProj P i Ψ := by
  have h1 : Ψ ∈ (I • ⊤ : Submodule A (AssocGraded P)) := by
    rw [Ideal.smul_top_eq_map]
    exact hΨ
  have h2 : grProjA P i Ψ ∈ (I • ⊤ : Submodule A (GrPiece P i)) := by
    have := Submodule.mem_map_of_mem (f := grProjA P i) h1
    rw [Submodule.map_smul''] at this
    exact Submodule.smul_mono le_rfl le_top this
  have h3 : (I • ⊤ : Submodule A (GrPiece P i)) =
      (I • (⊤ : Submodule A ↥(P ^ i))).map (Submodule.mkQ _) := by
    rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ]
  rw [h3] at h2
  obtain ⟨y, hy, hyeq⟩ := h2
  refine ⟨y, ?_, y.2, hyeq⟩
  refine Submodule.smul_induction_on (p := fun y : ↥(P ^ i) => (y : A) ∈ I * P ^ i) hy
    (fun r hr z _ => ?_) (fun a b ha hb => ?_)
  · exact Ideal.mul_mem_mul hr z.2
  · rw [Submodule.coe_add]
    exact add_mem ha hb

/-- The class in `grᵈ_P(A)` of an element of `I Pᵈ` lies in `I gr_P(A)`. -/
private theorem mk_mem_map_of_mem_mul {A : Type u} [CommRing A]
    (P I : Ideal A) {d : ℕ} {c : A} (hc : c ∈ I * P ^ d)
    (hcd : c ∈ P ^ d) : AssocGraded.mk P d c hcd ∈ I.map (algebraMap A (AssocGraded P)) := by
  suffices H : c ∈ P ^ d ∧ ∀ hcd : c ∈ P ^ d,
      AssocGraded.mk P d c hcd ∈ I.map (algebraMap A (AssocGraded P)) from H.2 hcd
  refine Submodule.mul_induction_on hc (fun r hr p hp => ⟨Ideal.mul_mem_left _ r hp, fun h => ?_⟩)
    (fun x y hx hy => ⟨add_mem hx.1 hy.1, fun h => ?_⟩)
  · have : AssocGraded.mk P d (r * p) h =
        algebraMap A (AssocGraded P) r * AssocGraded.mk P d p hp := by
      rw [← Algebra.smul_def]
      show AssocGraded.mkLinear P d ⟨r * p, h⟩ = r • AssocGraded.mkLinear P d ⟨p, hp⟩
      rw [← map_smul]
      rfl
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hr)
  · rw [AssocGraded.mk_add P d x y hx.1 hy.1]
    exact add_mem (hx.2 hx.1) (hy.2 hy.1)

end Lemma7

/-! ### Auxiliary statements on the classes `[a Xⁿ]` in `gr_I(A)` (used from Lemma 7 on) -/

section Lemma8Aux

variable {R : Type u} [CommRing R]

theorem mk_congr_of_eq (Q : Ideal R) {n n' : ℕ} {a b : R} (hn : n = n') (hab : a = b)
    (ha : a ∈ Q ^ n) (hb : b ∈ Q ^ n') : AssocGraded.mk Q n a ha = AssocGraded.mk Q n' b hb := by
  subst hn hab
  rfl

theorem mk_eq_mk_of_sub_mem_pow_succ (Q : Ideal R) {n : ℕ} {a b : R} (ha : a ∈ Q ^ n)
    (hb : b ∈ Q ^ n) (h : a - b ∈ Q ^ (n + 1)) :
    AssocGraded.mk Q n a ha = AssocGraded.mk Q n b hb := by
  have hab : a - b ∈ Q ^ n := Ideal.pow_le_pow_right (Nat.le_succ n) h
  calc AssocGraded.mk Q n a ha = AssocGraded.mk Q n (b + (a - b)) (add_mem hb hab) :=
        mk_congr_of_eq Q rfl (by ring) _ _
    _ = AssocGraded.mk Q n b hb + AssocGraded.mk Q n (a - b) hab :=
        AssocGraded.mk_add Q n b (a - b) hb hab
    _ = AssocGraded.mk Q n b hb := by rw [(AssocGraded.mk_eq_zero_iff Q hab).mpr h, add_zero]

theorem sub_mem_pow_succ_of_mk_eq_mk (Q : Ideal R) {n : ℕ} {a b : R} (ha : a ∈ Q ^ n)
    (hb : b ∈ Q ^ n) (h : AssocGraded.mk Q n a ha = AssocGraded.mk Q n b hb) :
    a - b ∈ Q ^ (n + 1) := by
  have hab : a - b ∈ Q ^ n := sub_mem ha hb
  have : AssocGraded.mk Q n (a - b) hab = 0 := by
    have h2 : AssocGraded.mk Q n a ha = AssocGraded.mk Q n b hb +
        AssocGraded.mk Q n (a - b) hab := by
      rw [← AssocGraded.mk_add Q n b (a - b) hb hab]
      exact mk_congr_of_eq Q rfl (by ring) _ _
    rw [h2] at h
    simpa using h
  exact (AssocGraded.mk_eq_zero_iff Q hab).mp this

theorem mk_finset_sum (Q : Ideal R) {ι : Type*} (n : ℕ) (S : Finset ι) (f : ι → R)
    (hf : ∀ i, f i ∈ Q ^ n) :
    AssocGraded.mk Q n (∑ i ∈ S, f i) (Ideal.sum_mem _ fun i _ => hf i) =
      ∑ i ∈ S, AssocGraded.mk Q n (f i) (hf i) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact (AssocGraded.mk_eq_zero_iff Q (zero_mem _)).mpr (zero_mem _)
  | insert a S ha ih =>
    have := AssocGraded.mk_add Q n (f a) (∑ i ∈ S, f i) (hf a) (Ideal.sum_mem _ fun i _ => hf i)
    rw [Finset.sum_insert ha (f := fun i => AssocGraded.mk Q n (f i) (hf i)), ← ih, ← this]
    exact mk_congr_of_eq Q rfl (Finset.sum_insert ha) _ _

end Lemma8Aux

/-! ### Lemma 7 (pp. 190–193): auxiliary statements for the proof -/

section Lemma7Proof

open MvPolynomial IsLocalRing

section PolyAux

/-- The homogeneous component of degree `k + d` of `c * φ`, `φ` a form of degree `d`, is the
product of the component of degree `k` of `c` with `φ`. -/
theorem homogeneousComponent_add_mul_of_isHomogeneous {σ K : Type*} [CommRing K]
    {φ : MvPolynomial σ K} {d : ℕ} (hφ : φ.IsHomogeneous d) (c : MvPolynomial σ K) (k : ℕ) :
    MvPolynomial.homogeneousComponent (k + d) (c * φ) =
      MvPolynomial.homogeneousComponent k c * φ := by
  classical
  conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent c]
  rw [Finset.sum_mul, map_sum]
  have hterm : ∀ i, MvPolynomial.homogeneousComponent (k + d)
      (MvPolynomial.homogeneousComponent i c * φ) =
        if i = k then MvPolynomial.homogeneousComponent k c * φ else 0 := by
    intro i
    rw [MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.homogeneousComponent_isHomogeneous i c).mul hφ)]
    by_cases hik : i = k
    · subst hik; simp
    · have : ¬ (k + d = i + d) := fun h => hik (by omega)
      simp only [this, hik, ↓reduceIte]
  simp only [hterm]
  by_cases hk : k ∈ Finset.range (c.totalDegree + 1)
  · simp only [Finset.sum_ite_eq', hk, ↓reduceIte]
  · have : c.totalDegree < k := by simpa using hk
    simp only [Finset.sum_ite_eq', hk, ↓reduceIte]
    rw [MvPolynomial.homogeneousComponent_eq_zero k c this, zero_mul]

/-- Same as `homogeneousComponent_add_mul_of_isHomogeneous` for a degree below `d`: the component
vanishes. -/
theorem homogeneousComponent_mul_of_lt_of_isHomogeneous {σ K : Type*} [CommRing K]
    {φ : MvPolynomial σ K} {d : ℕ} (hφ : φ.IsHomogeneous d) (c : MvPolynomial σ K) {D : ℕ}
    (hD : D < d) : MvPolynomial.homogeneousComponent D (c * φ) = 0 := by
  classical
  conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent c]
  rw [Finset.sum_mul, map_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [MvPolynomial.homogeneousComponent_of_mem
    ((MvPolynomial.homogeneousComponent_isHomogeneous i c).mul hφ)]
  have : D ≠ i + d := by omega
  simp [this]

/-- **Homogeneous coefficients** (p. 191: "(ii) implies that `ξ_α(Z) ∈ (φ₁, …, φ_m)K[Z]` so that we
can write each non-zero `ξ_α(Z)` in the form `ξ_α(Z) = Σ_β ζ_{α β}(Z) φ_β(Z)` where `ζ_{α β}(Z)`
are forms only in `Z₁, …, Z_r` of degree `μ - d_α - ν_β ≥ 0`"): a form `ξ` of degree `D` lying in
the ideal generated by forms `φ_j` of degrees `d_j` is `Σ ζ_j φ_j`, with `ζ_j` forms of degree
`D - d_j` (the sum over the `j` with `d_j ≤ D`). -/
theorem exists_isHomogeneous_mul_eq_sum {σ K : Type*} [CommRing K] {m : ℕ} (d : Fin m → ℕ)
    (φ : Fin m → MvPolynomial σ K) (hφ : ∀ j, (φ j).IsHomogeneous (d j)) {D : ℕ}
    {ξ : MvPolynomial σ K} (hξ : ξ.IsHomogeneous D) (c : Fin m → MvPolynomial σ K)
    (hc : ξ = ∑ j, c j * φ j) :
    ∃ ζ : Fin m → MvPolynomial σ K, (∀ j, d j ≤ D → (ζ j).IsHomogeneous (D - d j)) ∧
      ξ = ∑ j ∈ Finset.univ.filter (fun j => d j ≤ D), ζ j * φ j := by
  classical
  refine ⟨fun j => MvPolynomial.homogeneousComponent (D - d j) (c j), fun j _ =>
    MvPolynomial.homogeneousComponent_isHomogeneous _ _, ?_⟩
  conv_lhs => rw [← MvPolynomial.homogeneousComponent_eq_self hξ, hc]
  rw [map_sum, ← Finset.sum_filter_add_sum_filter_not Finset.univ (fun j => d j ≤ D)]
  have h1 : ∀ j ∈ Finset.univ.filter (fun j => ¬ d j ≤ D),
      MvPolynomial.homogeneousComponent D (c j * φ j) = 0 := fun j hj =>
    homogeneousComponent_mul_of_lt_of_isHomogeneous (hφ j) (c j)
      (by simpa using (Finset.mem_filter.mp hj).2)
  rw [Finset.sum_eq_zero h1, add_zero]
  refine Finset.sum_congr rfl fun j hj => ?_
  have hj' : d j ≤ D := (Finset.mem_filter.mp hj).2
  have := homogeneousComponent_add_mul_of_isHomogeneous (hφ j) (c j) (D - d j)
  rwa [Nat.sub_add_cancel hj'] at this

/-- A form over `R/Q` lifts to a form over `R` of the same degree. -/
theorem exists_isHomogeneous_map_eq {R : Type*} [CommRing R] (Q : Ideal R) {σ : Type*} {e : ℕ}
    {A : MvPolynomial σ (R ⧸ Q)} (hA : A.IsHomogeneous e) :
    ∃ B : MvPolynomial σ R, B.IsHomogeneous e ∧ B.map (Ideal.Quotient.mk Q) = A := by
  obtain ⟨B, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective A
  refine ⟨MvPolynomial.homogeneousComponent e B, MvPolynomial.homogeneousComponent_isHomogeneous _ _,
    ?_⟩
  ext n
  rw [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
  have h := hA
  by_cases hn : n.degree = e
  · simp [hn, MvPolynomial.coeff_map]
  · simp only [hn, ↓reduceIte, map_zero]
    exact (hA.coeff_eq_zero hn).symm.trans (by rw [MvPolynomial.coeff_map])

end PolyAux

section GrAux

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- The class `[Σ_{i ∈ S} f_i X^n]` is the sum of the classes `[f_i X^n]`. -/
theorem AssocGraded.mk_sum_eq_sum {n : ℕ} {ι : Type*} (S : Finset ι) (f : ι → A)
    (hf : ∀ i ∈ S, f i ∈ I ^ n) (W : ι → AssocGraded I)
    (hW : ∀ i (hi : i ∈ S), AssocGraded.mk I n (f i) (hf i hi) = W i) :
    AssocGraded.mk I n (∑ i ∈ S, f i) (Ideal.sum_mem _ hf) = ∑ i ∈ S, W i := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact (AssocGraded.mk_eq_zero_iff I (zero_mem _)).mpr (zero_mem _)
  | insert a S ha ih =>
    have hf' : ∀ i ∈ S, f i ∈ I ^ n := fun i hi => hf i (Finset.mem_insert_of_mem hi)
    have h1 := AssocGraded.mk_add I n (f a) (∑ i ∈ S, f i) (hf a (Finset.mem_insert_self a S))
      (Ideal.sum_mem _ hf')
    calc AssocGraded.mk I n (∑ i ∈ insert a S, f i) (Ideal.sum_mem _ hf)
        = AssocGraded.mk I n (f a + ∑ i ∈ S, f i)
            (add_mem (hf a (Finset.mem_insert_self a S)) (Ideal.sum_mem _ hf')) :=
          mk_congr_of_eq I rfl (Finset.sum_insert ha) _ _
      _ = AssocGraded.mk I n (f a) (hf a (Finset.mem_insert_self a S)) +
            AssocGraded.mk I n (∑ i ∈ S, f i) (Ideal.sum_mem _ hf') := h1
      _ = W a + ∑ i ∈ S, W i := by
          rw [hW a (Finset.mem_insert_self a S),
            ih hf' (fun i hi => hW i (Finset.mem_insert_of_mem hi))]
      _ = ∑ i ∈ insert a S, W i := (Finset.sum_insert ha).symm

end GrAux

section MonomialClass

variable {R : Type u} [CommRing R] (Q : Ideal R) {κ ι : Type*} (y : κ → R) (z : ι → R)
  (hy : ∀ i, y i ∈ Q ^ 1) (hz : ∀ i, z i ∈ Q ^ 1)

include hy in
/-- The value at `y` of the monomial `Y^m` lies in `Q^{|m|}`. -/
theorem eval_monomial_one_mem_pow (m : κ →₀ ℕ) :
    eval y (monomial m (1 : R)) ∈ Q ^ m.degree :=
  eval_mem_pow_of_isHomogeneous Q y hy (isHomogeneous_monomial 1 rfl)

include hy hz in
/-- The image in `gr_Q(R)` of `Y^m · B̄(Z)`, `B` a form of degree `e` in `Z` over `R`, is the class
of `y^m · B(z)` in degree `|m| + e` (p. 192: "`T_α(y)` denotes the monomial in `y₁, …, y_s` which
is obtained by replacing `Y_i` by `y_i` in `T_α(Y)`"; "an element `h_{α,β} ∈ (z₁, …, z_r)^{…} R`
whose initial form in `K[Z, Y] (= gr_Q(R))` is equal to `ζ_{α β}(Z)`"). -/
theorem yzFormHom_monomial_map_eq_mk {e : ℕ} {B : MvPolynomial ι R} (hB : B.IsHomogeneous e)
    (m : κ →₀ ℕ) :
    yzFormHom Q y z hy hz (monomial m (B.map (Ideal.Quotient.mk Q))) =
      AssocGraded.mk Q (m.degree + e) (eval y (monomial m (1 : R)) * eval z B)
        (eval_mul_mem_pow_add Q y z hy hz (isHomogeneous_monomial 1 rfl) hB) := by
  rw [← yzFormHom_redYZ_map_C_mul_C Q y z hy hz (isHomogeneous_monomial (1 : R) (rfl : m.degree = m.degree)) hB]
  congr 1
  simp only [redYZ, map_mul, MvPolynomial.map_C, MvPolynomial.map_monomial, map_one]
  rw [show (C (B.map (Ideal.Quotient.mk Q)) : MvPolynomial κ (MvPolynomial ι (R ⧸ Q))) =
    monomial 0 (B.map (Ideal.Quotient.mk Q)) from rfl, monomial_mul_monomial]
  simp

end MonomialClass

/-! ### Lemma 7: the regular system of parameters `(z, y)` of p. 191 -/

section Lemma7Setup

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The regular system of parameters of p. 191 for `P ⊆ Q`: "a regular system of parameters
`(z₁, …, z_r, y₁, …, y_s, x₁, …, x_t)` of `R` such that `P = (z₁, …, z_r)R` and
`Q = (z₁, …, z_r, y₁, …, y_s)R`" (footnote 41, "cf. footnote 39": see
`exists_isRegularSystemOfParameters_span_eq_of_le`), in the form: finite families `y`, `z` (the
`x_i` are not needed) such that `(y, z)` is quasi-regular, `Q = (y, z)` and `P = (z)`; the bidegree
components of `Qⁿ` are independent (`hind`).  (The proof of Lemma 7 itself uses the variant
`exists_lemma7Setup`, which also gives the quasi-regularity of `z`.) -/
theorem exists_sumElim_isQuasiRegular (P Q : Ideal R) [P.IsPrime] [Q.IsPrime] (hPQ : P ≤ Q)
    (hP : IsRegularLocalRing (R ⧸ P)) (hQ : IsRegularLocalRing (R ⧸ Q)) :
    ∃ (κ ι : Type) (_ : Fintype κ) (_ : Fintype ι) (y : κ → R) (z : ι → R),
      IsQuasiRegular (Sum.elim y z) ∧ Ideal.span (Set.range (Sum.elim y z)) = Q ∧
      Ideal.span (Set.range z) = P ∧
      (∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → R,
        (∀ a ∈ s, u a ∈ P ^ a * Ideal.span (Set.range y) ^ (m - a)) →
        ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
        ∀ a ∈ s, u a ∈ Q * (P ^ a * Ideal.span (Set.range y) ^ (m - a))) := by
  classical
  obtain ⟨N, x, Zs, hqr, hxQ, hxP⟩ := exists_adapted_quasiRegular P Q hPQ hP hQ
  let κ := {i : Fin N // i ∈ Zsᶜ}
  let ι := {i : Fin N // i ∈ Zs}
  let e : κ ⊕ ι ≃ Fin N := Equiv.ofBijective (Sum.elim (fun j => j.1) (fun i => i.1)) (by
    constructor
    · rintro (a | a) (b | b) h
      · exact congrArg Sum.inl (Subtype.ext h)
      · have h' : a.1 = b.1 := h
        exact (Finset.mem_compl.mp a.2 (h' ▸ b.2)).elim
      · have h' : a.1 = b.1 := h
        exact (Finset.mem_compl.mp b.2 (h' ▸ a.2)).elim
      · exact congrArg Sum.inr (Subtype.ext h)
    · intro i
      by_cases hi : i ∈ Zs
      · exact ⟨Sum.inr ⟨i, hi⟩, rfl⟩
      · exact ⟨Sum.inl ⟨i, by simpa using hi⟩, rfl⟩)
  let y : κ → R := fun j => x j.1
  let z : ι → R := fun i => x i.1
  have hxe : Sum.elim y z = x ∘ e := by
    funext a
    rcases a with a | a <;> rfl
  have hrange : Set.range (Sum.elim y z) = Set.range x := by
    rw [hxe, Set.range_comp, e.range_eq_univ, Set.image_univ]
  have hzP : Set.range z = x '' ↑Zs := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.1, i.2, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  have hyY : Set.range y = x '' ↑Zsᶜ := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.1, i.2, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  refine ⟨κ, ι, inferInstance, inferInstance, y, z, ?_, ?_, ?_, ?_⟩
  · rw [hxe]
    exact IsQuasiRegular.of_comp_equiv (x := x ∘ e) e.symm (by
      have : (x ∘ e) ∘ e.symm = x := by funext i; simp
      rwa [this])
  · rw [hrange, hxQ]
  · rw [hzP, hxP]
  · intro m s hs u hu hsum
    rw [hyY] at hu ⊢
    rw [← hxP, ← hxQ] at *
    exact mem_mul_of_sum_mem_pow x hqr Zs m s hs u hu hsum
end Lemma7Setup

section Dec

variable {R : Type u} [CommRing R] (Q P Y : Ideal R) {κ ι : Type*} (y : κ → R) (z : ι → R)
  (hy : ∀ i, y i ∈ Q ^ 1) (hz : ∀ i, z i ∈ Q ^ 1)

/-- **Bidegree decomposition** (the identification `gr_Q(R) = K[Z, Y]` of p. 191, in degree `μ`):
the class in `gr_Q(R)` of an element `g ∈ Pᵃ ∩ Qᵘ` is the image of a polynomial `ψ ∈ K[Z][Y]`
whose `Y`-coefficients `ξ_m = ψ.coeff m` (the forms `ξ_α(Z)` of p. 191, `T_α = Y^m`) are forms of
degree `μ - |m|` in `Z` and vanish unless `|m| + a ≤ μ`, i.e. unless `deg ξ_m ≥ a`. -/
theorem exists_coeff_isHomogeneous_of_mem_inf_pow (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → R,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    (hPz : Ideal.span (Set.range z) = P) (hYy : Ideal.span (Set.range y) = Y)
    {a μ : ℕ} {g : R} (hgP : g ∈ P ^ a) (hgQ : g ∈ Q ^ μ) :
    ∃ ψ : MvPolynomial κ (MvPolynomial ι (R ⧸ Q)),
      yzFormHom Q y z hy hz ψ = AssocGraded.mk Q μ g hgQ ∧
      ∀ m : κ →₀ ℕ, (ψ.coeff m).IsHomogeneous (μ - m.degree) ∧
        (ψ.coeff m ≠ 0 → m.degree + a ≤ μ) := by
  classical
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  by_cases haμ : a ≤ μ
  · have hmem : g ∈ ∑ d ∈ Finset.Icc a μ, P ^ d * Y ^ (μ - d) :=
      inf_pow_le_sum P Y Q hQ hind a μ haμ ⟨hgP, hgQ⟩
    obtain ⟨u, hu, hug⟩ := exists_eq_sum_of_mem_sum _ _ hmem
    have key : ∀ d ∈ Finset.Icc a μ, ∃ H : MvPolynomial κ (MvPolynomial ι R),
        IsBiHomogeneous (μ - d) d H ∧ ∃ hQd : u d ∈ Q ^ (μ - d + d),
          yzFormHom Q y z hy hz (redYZ Q H) = AssocGraded.mk Q (μ - d + d) (u d) hQd := by
      intro d hd
      have hu' : u d ∈ Ideal.span (Set.range y) ^ (μ - d) * Ideal.span (Set.range z) ^ d := by
        rw [hYy, hPz, mul_comm]
        exact hu d hd
      obtain ⟨H, hH, -, hQd, hmk⟩ :=
        exists_isBiHomogeneous_evYZ_eq_of_mem_mul_pow Q y z hy hz hu'
      exact ⟨H, hH, hQd, hmk⟩
    choose! H hH hHQ hHmk using key
    -- `u d ∈ Qᵘ`, extended by `0` outside `[a, μ]`
    let v : ℕ → R := fun d => if d ∈ Finset.Icc a μ then u d else 0
    have hvQ : ∀ d, v d ∈ Q ^ μ := by
      intro d
      by_cases hd : d ∈ Finset.Icc a μ
      · have h := hHQ d hd
        rw [Nat.sub_add_cancel (Finset.mem_Icc.mp hd).2] at h
        simpa only [v, hd, ↓reduceIte] using h
      · simp only [v, hd, ↓reduceIte]
        exact zero_mem _
    have hvu : ∀ d ∈ Finset.Icc a μ, v d = u d := fun d hd => by
      have hd' := Finset.mem_Icc.mp hd
      simp only [v, Finset.mem_Icc]
      simp [hd'.1, hd'.2]
    refine ⟨∑ d ∈ Finset.Icc a μ, redYZ Q (H d), ?_, fun m => ?_⟩
    · rw [map_sum]
      have h1 : ∀ d ∈ Finset.Icc a μ, yzFormHom Q y z hy hz (redYZ Q (H d)) =
          AssocGraded.mk Q μ (v d) (hvQ d) := by
        intro d hd
        rw [hHmk d hd]
        exact mk_congr_of_eq Q (Nat.sub_add_cancel (Finset.mem_Icc.mp hd).2) (hvu d hd).symm _ _
      rw [Finset.sum_congr rfl h1, ← mk_finset_sum Q μ (Finset.Icc a μ) v hvQ]
      exact mk_congr_of_eq Q rfl (by
        rw [← hug]
        exact Finset.sum_congr rfl hvu) _ _
    · -- the coefficient of `Y^m` in `ψ`
      have hcoeff : (∑ d ∈ Finset.Icc a μ, redYZ Q (H d)).coeff m =
          ∑ d ∈ Finset.Icc a μ, MvPolynomial.map (Ideal.Quotient.mk Q) ((H d).coeff m) := by
        rw [coeff_sum]
        simp [redYZ, coeff_map]
      have hdeg : ∀ d ∈ Finset.Icc a μ, (H d).coeff m ≠ 0 → m.degree + d = μ := by
        intro d hd hne
        have := (hH d hd m).2 hne
        have hdμ := (Finset.mem_Icc.mp hd).2
        omega
      rw [hcoeff]
      refine ⟨?_, fun hne => ?_⟩
      · refine IsHomogeneous.sum _ _ _ fun d hd => ?_
        by_cases h0 : (H d).coeff m = 0
        · rw [h0, map_zero]
          exact isHomogeneous_zero _ _ _
        · have := hdeg d hd h0
          have hd' : d = μ - m.degree := by omega
          rw [← hd']
          exact (hH d hd m).1.map _
      · obtain ⟨d, hd, hd0⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
        have h0 : (H d).coeff m ≠ 0 := fun h => hd0 (by rw [h, map_zero])
        have := hdeg d hd h0
        have := (Finset.mem_Icc.mp hd).1
        omega
  · refine ⟨0, ?_, fun m => ?_⟩
    · rw [map_zero, eq_comm, AssocGraded.mk_eq_zero_iff]
      exact Ideal.pow_le_pow_right (by omega) (Ideal.pow_right_mono hPQ a hgP)
    · have h0 : (0 : MvPolynomial κ (MvPolynomial ι (R ⧸ Q))).coeff m = 0 := rfl
      rw [h0]
      exact ⟨isHomogeneous_zero _ _ _, fun h => absurd rfl h⟩

end Dec

section KeyStep

variable {R : Type u} [CommRing R] (J P Q Y : Ideal R) {κ ι : Type*} (y : κ → R) (z : ι → R)
  (hy : ∀ i, y i ∈ Q ^ 1) (hz : ∀ i, z i ∈ Q ^ 1)

/-- **The step `ψ ↦ h` of the proof of Lemma 7** (pp. 191–192).  Let `g ∈ Pᵃ ∩ Qᵘ` have its class
in `gr_Q(J, R)`.  Write the initial form `ψ` of `g` in `gr_Q(R) = K[Z, Y]` as
`ψ = Σ_α T_α(Y) ξ_α(Z)`; by (i) the `φ_j` are forms only in `Z`, so by (ii) `ξ_α = Σ_β ζ_{αβ} φ_β`
with forms `ζ_{αβ}` of degree `μ - d_α - ν_β`; take `h_{αβ} ∈ (z)^{μ-d_α-ν_β} R` with initial form
`ζ_{αβ}` and put `h = Σ_α T_α(y) Σ_β h_{αβ} f_β`.  Then `h ∈ J`, `g - h ∈ Q^{μ+1}` ("`ν_Q(g - h) > μ`"),
`h ∈ Pᵃ` ("`ν_P(h) ≥ ν`", since every non-zero `ξ_α` has degree `μ - d_α ≥ a`), and, when `a ≤ μ`,
`h` lies in `Σ_β Q^{μ-a} P^{a-ν_β} f_β + P^{a+1}`: the terms with `d_α < μ - a` are in `P^{a+1}`
and those with `d_α = μ - a` are `T_α(y) h_{αβ} f_β ∈ Q^{μ-a} P^{a-ν_β} f_β` (this is
"`Ψ*` must be of the form `Σ*_α (T_α(ȳ) Σ_β ζ*_{α,β}(Z) Φ_β(Z))` … It is clear that `Ψ*` is
contained in `Q̄ⁿH`", p. 192). -/
theorem exists_mem_sup_of_mem_inf_pow (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → R,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    (hPz : Ideal.span (Set.range z) = P) (hYy : Ideal.span (Set.range y) = Y)
    (hbij : Function.Bijective (yzFormHom Q y z hy hz))
    {m : ℕ} (f : Fin m → R) (hfJ : ∀ j, f j ∈ J)
    (h₁ : ∀ j, Ideal.ordElem Q (f j) = Ideal.ordElem P (f j))
    (h₂ : Ideal.span (Set.range fun j => initialForm Q (f j)) = grIdeal Q J)
    {a μ : ℕ} {g : R} (hgP : g ∈ P ^ a) (hgQ : g ∈ Q ^ μ)
    (hgJ : AssocGraded.mk Q μ g hgQ ∈ grIdeal Q J) :
    ∃ h ∈ J, h ∈ P ^ a ∧ g - h ∈ Q ^ (μ + 1) ∧
      (a ≤ μ → h ∈ (∑ β ∈ Finset.univ.filter (fun β => (Ideal.ordElem Q (f β)).toNat ≤ a),
        Q ^ (μ - a) * P ^ (a - (Ideal.ordElem Q (f β)).toNat) * Ideal.span {f β}) ⊔
          P ^ (a + 1)) := by
  classical
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  set νf : Fin m → ℕ := fun β => (Ideal.ordElem Q (f β)).toNat with hνf
  have hfQ : ∀ β, f β ∈ Q ^ νf β := by
    intro β
    by_cases h : Ideal.ordElem Q (f β) = ⊤
    · exact Ideal.ordElem_eq_top_iff.mp h _
    · exact Ideal.mem_pow_of_ordElem (ENat.natCast_toNat h).symm
  have hfP : ∀ β, f β ∈ P ^ νf β := by
    intro β
    by_cases h : Ideal.ordElem Q (f β) = ⊤
    · exact Ideal.ordElem_eq_top_iff.mp (h₁ β ▸ h) _
    · rw [h₁ β] at h
      simp only [νf, h₁ β]
      exact Ideal.mem_pow_of_ordElem (ENat.natCast_toNat h).symm
  have hφ : ∀ β, initialForm Q (f β) = AssocGraded.mk Q (νf β) (f β) (hfQ β) := by
    intro β
    by_cases h : Ideal.ordElem Q (f β) = ⊤
    · have : f β ∈ Q ^ (νf β + 1) := Ideal.ordElem_eq_top_iff.mp h _
      rw [(AssocGraded.mk_eq_zero_iff Q (hfQ β)).mpr this]
      simp only [initialForm, h, ↓reduceDIte]
    · exact initialForm_eq_mk Q (ENat.natCast_toNat h).symm
  -- "First of all, we note that by (i), the `φ_j` are all forms only in `Z₁, …, Z_r`." (p. 191)
  have hform : ∀ β, ∃ φt : MvPolynomial ι (R ⧸ Q), φt.IsHomogeneous (νf β) ∧
      yzFormHom Q y z hy hz (C φt) = initialForm Q (f β) := by
    intro β
    obtain ⟨ψ, hψ, hcoef⟩ := exists_coeff_isHomogeneous_of_mem_inf_pow Q P Y y z hy hz hQ hind hPz
      hYy (hfP β) (hfQ β)
    have hψC : ψ = C (ψ.coeff 0) := by
      ext n
      by_cases hn : n = 0
      · subst hn; simp
      · have h0 : ψ.coeff n = 0 := by
          by_contra hne
          have := (hcoef n).2 hne
          exact hn ((Finsupp.degree_eq_zero_iff n).mp (by omega))
        rw [h0, MvPolynomial.coeff_C]
        simp [Ne.symm hn]
    refine ⟨ψ.coeff 0, ?_, ?_⟩
    · simpa using (hcoef 0).1
    · rw [← hψC, hψ, hφ β]
  choose φt hφth hφE using hform
  -- the initial form `ψ` of `g` in `gr_Q(R) = K[Z, Y]`
  obtain ⟨ψ, hψE, hcoef⟩ := exists_coeff_isHomogeneous_of_mem_inf_pow Q P Y y z hy hz hQ hind hPz
    hYy hgP hgQ
  -- (ii): `ψ ∈ (φ₁, …, φ_m) K[Z, Y]`
  have hψmem : AssocGraded.mk Q μ g hgQ ∈ Ideal.span (Set.range fun j => initialForm Q (f j)) :=
    h₂ ▸ hgJ
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hψmem
  choose c' hc' using fun j => hbij.2 (c j)
  have hψeq : ψ = ∑ j, c' j * C (φt j) := by
    apply hbij.1
    rw [hψE, map_sum, ← hc]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, hc' j, hφE j]
  -- "`ξ_α(Z) ∈ (φ₁, …, φ_m) K[Z]` for all `α`": the `Y^m`-coefficient of `ψ`
  have hξ : ∀ n : κ →₀ ℕ, ψ.coeff n = ∑ j, (c' j).coeff n * φt j := by
    intro n
    rw [hψeq, coeff_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [mul_comm, coeff_C_mul, mul_comm]
  -- "we can write each non-zero `ξ_α(Z)` in the form `Σ_β ζ_{α β}(Z) φ_β(Z)`"
  have hζ : ∀ n : κ →₀ ℕ, ∃ ζ : Fin m → MvPolynomial ι (R ⧸ Q),
      (∀ j, νf j ≤ μ - n.degree → (ζ j).IsHomogeneous (μ - n.degree - νf j)) ∧
        ψ.coeff n = ∑ j ∈ Finset.univ.filter (fun j => νf j ≤ μ - n.degree), ζ j * φt j :=
    fun n => exists_isHomogeneous_mul_eq_sum νf φt hφth (hcoef n).1 (fun j => (c' j).coeff n)
      (hξ n)
  choose ζ hζh hζeq using hζ
  -- lifts `h_{α β}`: forms `B` over `R` with `B̄ = ζ_{α β}`
  have hB : ∀ (n : κ →₀ ℕ) (j : Fin m), ∃ B : MvPolynomial ι R,
      νf j ≤ μ - n.degree → B.IsHomogeneous (μ - n.degree - νf j) ∧
        B.map (Ideal.Quotient.mk Q) = ζ n j := by
    intro n j
    by_cases hle : νf j ≤ μ - n.degree
    · obtain ⟨B, hBh, hBm⟩ := exists_isHomogeneous_map_eq Q (hζh n j hle)
      exact ⟨B, fun _ => ⟨hBh, hBm⟩⟩
    · exact ⟨0, fun h => absurd h hle⟩
  choose B hBh hBm using hB
  -- the monomials `T_α(y)`, the forms `h_{α β}(z)` and the terms `T_α(y) h_{α β} f_β`
  let T : (κ →₀ ℕ) → R := fun n => eval y (monomial n (1 : R))
  have hTQ : ∀ n, T n ∈ Q ^ n.degree := fun n => eval_monomial_one_mem_pow Q y hy n
  have hzP : ∀ i, z i ∈ P ^ 1 := fun i => by
    rw [pow_one, ← hPz]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hhP : ∀ (n : κ →₀ ℕ) (j : Fin m), νf j ≤ μ - n.degree →
      eval z (B n j) ∈ P ^ (μ - n.degree - νf j) := fun n j hle =>
    eval_mem_pow_of_isHomogeneous P z hzP (hBh n j hle)
  let t : (κ →₀ ℕ) → Fin m → R := fun n j => T n * (eval z (B n j) * f j)
  let F : (κ →₀ ℕ) → Finset (Fin m) := fun n =>
    Finset.univ.filter (fun j => νf j ≤ μ - n.degree)
  have hsupp : ∀ n ∈ ψ.support, n.degree + a ≤ μ := fun n hn =>
    (hcoef n).2 (MvPolynomial.mem_support_iff.mp hn)
  have htQ : ∀ n ∈ ψ.support, ∀ j ∈ F n, t n j ∈ Q ^ μ := by
    intro n hn j hj
    have hle := (Finset.mem_filter.mp hj).2
    have h1 := hsupp n hn
    have hh : eval z (B n j) ∈ Q ^ (μ - n.degree - νf j) :=
      Ideal.pow_right_mono hPQ _ (hhP n j hle)
    have hpow : Q ^ μ = Q ^ n.degree * (Q ^ (μ - n.degree - νf j) * Q ^ νf j) := by
      rw [← pow_add, ← pow_add]
      congr 1
      omega
    rw [hpow]
    exact Ideal.mul_mem_mul (hTQ n) (Ideal.mul_mem_mul hh (hfQ j))
  have htP : ∀ n ∈ ψ.support, ∀ j ∈ F n, t n j ∈ P ^ (μ - n.degree) := by
    intro n hn j hj
    have hle := (Finset.mem_filter.mp hj).2
    have hpow : P ^ (μ - n.degree) = P ^ (μ - n.degree - νf j) * P ^ νf j := by
      rw [← pow_add]
      congr 1
      omega
    rw [hpow]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul (hhP n j hle) (hfP j))
  -- the class of `T_α(y) h_{α β} f_β` in `gr_Q(R)` is `T_α(Y) ζ_{α β}(Z) φ_β(Z)`
  have htmk : ∀ n (hn : n ∈ ψ.support) j (hj : j ∈ F n),
      AssocGraded.mk Q μ (t n j) (htQ n hn j hj) =
        yzFormHom Q y z hy hz (monomial n (ζ n j * φt j)) := by
    intro n hn j hj
    have hle := (Finset.mem_filter.mp hj).2
    have h1 := yzFormHom_monomial_map_eq_mk Q y z hy hz (hBh n j hle) n
    rw [hBm n j hle] at h1
    have h2 : yzFormHom Q y z hy hz (C (φt j)) = AssocGraded.mk Q (νf j) (f j) (hfQ j) :=
      (hφE j).trans (hφ j)
    have h3 : yzFormHom Q y z hy hz (monomial n (ζ n j * φt j)) =
        yzFormHom Q y z hy hz (monomial n (ζ n j)) * yzFormHom Q y z hy hz (C (φt j)) := by
      rw [← map_mul]
      congr 1
      rw [show (C (φt j) : MvPolynomial κ (MvPolynomial ι (R ⧸ Q))) =
        monomial 0 (φt j) from rfl, monomial_mul_monomial]
      simp
    rw [h3, h1, h2, AssocGraded.mk_mul_mk]
    have hsupp' := hsupp n hn
    exact mk_congr_of_eq Q (by omega) (by simp only [t, T]; ring) _ _
  -- the element `h = Σ_α T_α(y) Σ_β h_{α β} f_β`
  let h : R := ∑ n ∈ ψ.support, ∑ j ∈ F n, t n j
  have hJ : h ∈ J := Ideal.sum_mem _ fun n _ => Ideal.sum_mem _ fun j _ =>
    Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hfJ j))
  have hQμ : h ∈ Q ^ μ := Ideal.sum_mem _ fun n hn => Ideal.sum_mem _ fun j hj => htQ n hn j hj
  -- "Then, as is easily seen, ν_Q(h) = μ, and the initial form of h in K[Z, Y] is equal to ψ."
  have hmkh : AssocGraded.mk Q μ h hQμ = yzFormHom Q y z hy hz ψ := by
    have hinner : ∀ n (hn : n ∈ ψ.support), AssocGraded.mk Q μ (∑ j ∈ F n, t n j)
        (Ideal.sum_mem _ fun j hj => htQ n hn j hj) =
          yzFormHom Q y z hy hz (monomial n (ψ.coeff n)) := by
      intro n hn
      rw [AssocGraded.mk_sum_eq_sum Q (F n) (t n) (fun j hj => htQ n hn j hj)
        (fun j => yzFormHom Q y z hy hz (monomial n (ζ n j * φt j))) (fun j hj => htmk n hn j hj),
        ← map_sum, ← map_sum, hζeq n]
    rw [AssocGraded.mk_sum_eq_sum Q ψ.support (fun n => ∑ j ∈ F n, t n j)
      (fun n hn => Ideal.sum_mem _ fun j hj => htQ n hn j hj)
      (fun n => yzFormHom Q y z hy hz (monomial n (ψ.coeff n))) hinner, ← map_sum,
      ← MvPolynomial.as_sum]
  refine ⟨h, hJ, ?_, ?_, ?_⟩
  · -- "Therefore we have ν_P(h) ≥ ν + 1" / "hence ν_P(h) ≥ ν": `h ∈ Pᵃ`
    refine Ideal.sum_mem _ fun n hn => Ideal.sum_mem _ fun j hj => ?_
    exact Ideal.pow_le_pow_right (by have := hsupp n hn; omega) (htP n hn j hj)
  · -- "Hence ν_Q(g - h) > μ"
    exact sub_mem_pow_succ_of_mk_eq_mk Q hgQ hQμ (hψE.symm.trans hmkh.symm)
  · intro haμ
    refine Ideal.sum_mem _ fun n hn => Ideal.sum_mem _ fun j hj => ?_
    have hle := (Finset.mem_filter.mp hj).2
    have h1 := hsupp n hn
    by_cases hn' : n.degree + a = μ
    · -- the terms with `d_α = μ - a`: `T_α(y) h_{α β} f_β ∈ Q^{μ-a} P^{a-ν_β} (f_β)`
      have hνa : νf j ≤ a := by omega
      refine Ideal.mem_sup_left ?_
      refine le_sum_of_mem (fun β => Q ^ (μ - a) * P ^ (a - νf β) * Ideal.span {f β})
        (s := Finset.univ.filter (fun β => νf β ≤ a))
        (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hνa⟩) ?_
      have hTq : T n ∈ Q ^ (μ - a) := by
        have := hTQ n
        rwa [show n.degree = μ - a by omega] at this
      have hhp : eval z (B n j) ∈ P ^ (a - νf j) := by
        have := hhP n j hle
        rwa [show μ - n.degree - νf j = a - νf j by omega] at this
      have : t n j = (T n * eval z (B n j)) * f j := by simp only [t]; ring
      rw [this]
      exact Ideal.mul_mem_mul (Ideal.mul_mem_mul hTq hhp) (Ideal.mem_span_singleton_self _)
    · -- the terms with `d_α < μ - a` lie in `P^{a+1}`
      exact Ideal.mem_sup_right (Ideal.pow_le_pow_right (by omega) (htP n hn j hj))

end KeyStep

section MainStep

variable {R : Type u} [CommRing R] (J P Q Y : Ideal R) {κ ι : Type*} (y : κ → R) (z : ι → R)
  (hy : ∀ i, y i ∈ Q ^ 1) (hz : ∀ i, z i ∈ Q ^ 1)

/-- `Pᵛ ∩ Qᵛ⁺ᵏ = Pᵛ Qᵏ` (the intersection formula behind "`ν + n ≥ μ ≥ ν`" of p. 191, which the
paper does not argue): from the independence of the bidegree components. -/
theorem inf_pow_add_le_mul (hQ : Q = P ⊔ Y)
    (hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → R,
      (∀ a ∈ s, u a ∈ P ^ a * Y ^ (m - a)) → ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
      ∀ a ∈ s, u a ∈ Q * (P ^ a * Y ^ (m - a)))
    (ν k : ℕ) : P ^ ν ⊓ Q ^ (ν + k) ≤ P ^ ν * Q ^ k := by
  have hPQ : P ≤ Q := hQ ▸ le_sup_left
  have hYQ : Y ≤ Q := hQ ▸ le_sup_right
  refine (inf_pow_le_sum P Y Q hQ hind ν (ν + k) (Nat.le_add_right ν k)).trans ?_
  have := sum_le_pow_mul hPQ hYQ ν (ν + k)
  rwa [Nat.add_sub_cancel_left] at this

end MainStep

section Lemma7Printed

variable {R : Type u} [CommRing R]

/-- The data fixed at the beginning of the proof of Lemma 7 (p. 191): finite families `y`, `z`
(`(z₁, …, z_r, y₁, …, y_s)` of the regular system of parameters of footnote 41) with
`P = (z)R`, `Q = (z, y)R`; the classes of `z` in `gr_P(R)` and of `(z, y)` in `gr_Q(R)` identify
`gr_P(R) = R̄[Z]` and `gr_Q(R) = K[Z, Y]` (here `K[Z][Y]`), the classes `ȳ` of `y` in `R̄ = R/P` are
part of a regular system of parameters of `R̄` (`qr_bar`, p. 192) and the bidegree components of `Qⁿ`
are independent. -/
structure Lemma7Setup (P Q : Ideal R) {κ ι : Type*} (y : κ → R) (z : ι → R) : Prop where
  hy : ∀ i, y i ∈ Q ^ 1
  hz : ∀ i, z i ∈ Q ^ 1
  hzP : ∀ i, z i ∈ P ^ 1
  hQ : Q = P ⊔ Ideal.span (Set.range y)
  hPz : Ideal.span (Set.range z) = P
  hind : ∀ (m : ℕ) (s : Finset ℕ), (∀ a ∈ s, a ≤ m) → ∀ u : ℕ → R,
    (∀ a ∈ s, u a ∈ P ^ a * Ideal.span (Set.range y) ^ (m - a)) →
    ∑ a ∈ s, u a ∈ Q ^ (m + 1) →
    ∀ a ∈ s, u a ∈ Q * (P ^ a * Ideal.span (Set.range y) ^ (m - a))
  qr_z : IsQuasiRegular z
  qr_bar : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)
  bij : Function.Bijective (yzFormHom Q y z hy hz)

open IsLocalRing in
/-- **The setup of the proof of Lemma 7** (p. 191, footnote 41): "Let us choose a regular system of
parameters `(z₁, …, z_r, y₁, …, y_s, x₁, …, x_t)` of `R` such that `P = (z₁, …, z_r)R` and
`Q = (z₁, …, z_r, y₁, …, y_s)R`" is `exists_isRegularSystemOfParameters_span_eq_of_le`; `z` and
`(y, z)` are parts of that regular system of parameters, hence quasi-regular, and "We can identify
`gr_Q(R)` with the polynomial ring `K[Z, Y]`" is `yzFormHom_bijective`. -/
theorem exists_lemma7Setup [IsRegularLocalRing R] (P Q : Ideal R) [P.IsPrime] [Q.IsPrime]
    (hPQ : P ≤ Q) (hP : IsRegularLocalRing (R ⧸ P)) (hQ : IsRegularLocalRing (R ⧸ Q)) :
    ∃ (κ ι : Type u) (_ : Fintype κ) (_ : Fintype ι) (y : κ → R) (z : ι → R),
      Lemma7Setup P Q y z := by
  classical
  obtain ⟨Z, Y, X, hZY, hZYX, hS, hZ, hZYQ, -, hdimP⟩ :=
    exists_isRegularSystemOfParameters_span_eq_of_le P Q hPQ hP hQ
  have hScard : (Z ∪ Y ∪ X).card = (maximalIdeal R).spanFinrank := by
    have h := hS.2
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal] at h
    exact_mod_cast h
  let y : ↥Y → R := Subtype.val
  let z : ↥Z → R := Subtype.val
  have hyinj : Function.Injective y := Subtype.val_injective
  have hzinj : Function.Injective z := Subtype.val_injective
  have hrz : Set.range z = (Z : Set R) := Subtype.range_coe
  have hry : Set.range y = (Y : Set R) := Subtype.range_coe
  have hxinj : Function.Injective (Sum.elim y z) :=
    hyinj.sumElim hzinj fun a b h => Finset.disjoint_left.mp hZY b.2 (by
      have : (b : R) = a := h.symm
      rw [this]
      exact a.2)
  have hxS : ∀ i, Sum.elim y z i ∈ Z ∪ Y ∪ X := by
    rintro (i | i)
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ i.2)
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ i.2)
  have hqrx : IsQuasiRegular (Sum.elim y z) := by
    refine IsQuasiRegular.of_comp_equiv (Fintype.equivFin (↥Y ⊕ ↥Z)).symm ?_
    exact isQuasiRegular_of_minimal hS.1 hScard
      (hxinj.comp (Fintype.equivFin (↥Y ⊕ ↥Z)).symm.injective) fun i => hxS _
  have hqrz : IsQuasiRegular z := by
    refine IsQuasiRegular.of_comp_equiv Z.equivFin.symm ?_
    exact isQuasiRegular_of_minimal hS.1 hScard
      (hzinj.comp Z.equivFin.symm.injective) fun i =>
        Finset.mem_union_left _ (Finset.mem_union_left _ (Z.equivFin.symm i).2)
  have hspanz : Ideal.span (Set.range z) = P := by rw [hrz, hZ]
  have hspanx : Ideal.span (Set.range (Sum.elim y z)) = Q := by
    rw [Set.Sum.elim_range, Ideal.span_union, hry, hrz, ← hZYQ, Finset.coe_union, Ideal.span_union,
      sup_comm]
  have hQY : Q = P ⊔ Ideal.span (Set.range y) := by
    rw [← hspanx, Set.Sum.elim_range, Ideal.span_union, hspanz, sup_comm]
  have hy : ∀ i, y i ∈ Q ^ 1 := fun i => by
    rw [pow_one, ← hspanx]
    exact Ideal.subset_span ⟨Sum.inl i, rfl⟩
  have hz : ∀ i, z i ∈ Q ^ 1 := fun i => by
    rw [pow_one, ← hspanx]
    exact Ideal.subset_span ⟨Sum.inr i, rfl⟩
  have hzP : ∀ i, z i ∈ P ^ 1 := fun i => by
    rw [pow_one, ← hspanz]
    exact Ideal.subset_span ⟨i, rfl⟩
  -- p. 192: "`(ȳ₁, …, ȳ_s, x̄₁, …, x̄_t)` is a regular system of parameters of `R̄`", so `ȳ` is part
  -- of a regular system of parameters of `R̄` and quasi-regular
  have hqrbar : IsQuasiRegular (fun j : ↥Y => Ideal.Quotient.mk P (y j)) := by
    have := hP
    obtain ⟨hinj, hrsop⟩ := isRegularSystemOfParameters_image_quotient hS hZ hdimP
    have hcardbar : ((Y ∪ X).image (Ideal.Quotient.mk P)).card =
        (maximalIdeal (R ⧸ P)).spanFinrank := by
      have h := hrsop.2
      rw [← IsRegularLocalRing.spanFinrank_maximalIdeal] at h
      exact_mod_cast h
    refine IsQuasiRegular.of_comp_equiv Y.equivFin.symm ?_
    exact isQuasiRegular_of_minimal hrsop.1 hcardbar
      (z := fun i : Fin Y.card => Ideal.Quotient.mk P ((Y.equivFin.symm i : ↥Y) : R))
      (fun a b hab => Y.equivFin.symm.injective (Subtype.val_injective
        (hinj (Finset.mem_coe.mpr (Finset.mem_union_left _ (Y.equivFin.symm a).2))
          (Finset.mem_coe.mpr (Finset.mem_union_left _ (Y.equivFin.symm b).2)) hab)))
      (fun i => Finset.mem_image_of_mem _ (Finset.mem_union_left _ (Y.equivFin.symm i).2))
  refine ⟨↥Y, ↥Z, inferInstance, inferInstance, y, z,
    ⟨hy, hz, hzP, hQY, hspanz, ?_, hqrz, hqrbar,
      yzFormHom_bijective Q y z hy hz hqrx hspanx⟩⟩
  intro m s hs u hu hsum
  have hZs : (Sum.elim y z) '' ↑(Finset.univ.image (Sum.inr : ↥Z → ↥Y ⊕ ↥Z)) = Set.range z := by
    ext a
    simp
  have hZsc : (Sum.elim y z) '' ↑(Finset.univ.image (Sum.inr : ↥Z → ↥Y ⊕ ↥Z))ᶜ = Set.range y := by
    ext a
    simp
  have := mem_mul_of_sum_mem_pow (Sum.elim y z) hqrx (Finset.univ.image (Sum.inr : ↥Z → ↥Y ⊕ ↥Z))
    m s hs u (by rw [hZs, hZsc]; rw [hspanz]; exact hu) (by rw [hspanx]; exact hsum)
  rw [hZs, hZsc, hspanx, hspanz] at this
  exact this

end Lemma7Printed

section Lemma7Coord

open MvPolynomial

variable {R : Type u} [CommRing R] {P Q : Ideal R} {κ ι : Type*} {y : κ → R} {z : ι → R}
  (S : Lemma7Setup P Q y z)

/-- The coordinates of an element of `gr_Q(R)` in `K[Z][Y]` (p. 191: "We can identify `gr_Q(R)` with
the polynomial ring `K[Z, Y]`"), `K = R/Q`: the inverse of `yzFormHom_bijective`. -/
noncomputable def Lemma7Setup.coord :
    AssocGraded Q ≃+* MvPolynomial κ (MvPolynomial ι (R ⧸ Q)) :=
  (RingEquiv.ofBijective _ S.bij).symm

theorem Lemma7Setup.yz_coord (x : AssocGraded Q) :
    yzFormHom Q y z S.hy S.hz (S.coord x) = x :=
  (RingEquiv.ofBijective _ S.bij).apply_symm_apply x

theorem Lemma7Setup.coord_yz (ψ : MvPolynomial κ (MvPolynomial ι (R ⧸ Q))) :
    S.coord (yzFormHom Q y z S.hy S.hz ψ) = ψ :=
  (RingEquiv.ofBijective _ S.bij).symm_apply_apply ψ

/-- **Bidegree decomposition**, in terms of the coordinates: if `g ∈ Pᵃ ∩ Qᵘ`, the coefficients of
the coordinates of the class of `g` in `gr_Q(R)` are forms of degree `μ - |m|` in `Z`, nonzero only
if `|m| + a ≤ μ`.  (This is `exists_coeff_isHomogeneous_of_mem_inf_pow`.) -/
theorem Lemma7Setup.coord_mk_coeff {a μ : ℕ} {g : R} (hgP : g ∈ P ^ a) (hgQ : g ∈ Q ^ μ)
    (m : κ →₀ ℕ) :
    ((S.coord (AssocGraded.mk Q μ g hgQ)).coeff m).IsHomogeneous (μ - m.degree) ∧
      ((S.coord (AssocGraded.mk Q μ g hgQ)).coeff m ≠ 0 → m.degree + a ≤ μ) := by
  obtain ⟨ψ, hψ, hcoef⟩ := exists_coeff_isHomogeneous_of_mem_inf_pow Q P (Ideal.span (Set.range y))
    y z S.hy S.hz S.hQ S.hind S.hPz rfl hgP hgQ
  have : S.coord (AssocGraded.mk Q μ g hgQ) = ψ := by rw [← hψ, S.coord_yz]
  rw [this]
  exact hcoef m

/-- `Z = 0`: the coefficientwise constant term `K[Z][Y] → K[Y]`. -/
noncomputable def zeroZ (ι : Type*) (K : Type*) [CommRing K] (κ : Type*) :
    MvPolynomial κ (MvPolynomial ι K) →+* MvPolynomial κ K :=
  MvPolynomial.map (MvPolynomial.constantCoeff : MvPolynomial ι K →+* K)

theorem coeff_zeroZ {K : Type*} [CommRing K] (ψ : MvPolynomial κ (MvPolynomial ι K))
    (m : κ →₀ ℕ) : (zeroZ ι K κ ψ).coeff m = MvPolynomial.constantCoeff (ψ.coeff m) := by
  simp [zeroZ, MvPolynomial.coeff_map]

/-- `gr_Q(R) → K[Y]`: the coordinates followed by `Z = 0`. -/
noncomputable def Lemma7Setup.zeroCoord : AssocGraded Q →+* MvPolynomial κ (R ⧸ Q) :=
  (zeroZ ι (R ⧸ Q) κ).comp S.coord.toRingHom

theorem Lemma7Setup.zeroCoord_apply (x : AssocGraded Q) :
    S.zeroCoord x = zeroZ ι (R ⧸ Q) κ (S.coord x) := rfl

include S in
theorem Lemma7Setup.hPQ : P ≤ Q := S.hQ ▸ le_sup_left

include S in
theorem Lemma7Setup.hy' (j : κ) :
    Ideal.Quotient.mk P (y j) ∈ (Q.map (Ideal.Quotient.mk P)) ^ 1 := by
  rw [pow_one]
  exact Ideal.mem_map_of_mem _ (by simpa using S.hy j)

include S in
/-- `Q̄ = (ȳ)R̄` (p. 192: "`Q̄ = (ȳ₁, …, ȳ_s)R̄`"). -/
theorem Lemma7Setup.span_map_y :
    Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P) := by
  rw [S.hQ, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **The identification `gr_Q̄(R̄) = K̄[Y]`** (p. 192: "If `ȳ_i` denotes the residue class of `y_i` in
`R̄ = R/P` and `x̄_j` that of `x_j`, then `(ȳ₁, …, ȳ_s, x̄₁, …, x̄_t)` is a regular system of
parameters of `R̄` and `Q̄ = (ȳ₁, …, ȳ_s)R̄`.  We can identify `gr_Q̄(R̄)` with the polynomial ring
`K[Y₁, …, Y_s]` in such a way that `Y_j` corresponds to the class of `ȳ_j` in `gr¹_Q̄(R̄)`"),
`K̄ = R̄/Q̄`: `ȳ` is part of a regular system of parameters of `R̄`
(`isRegularSystemOfParameters_image_quotient`, used in `exists_lemma7Setup`), hence quasi-regular
(`Lemma7Setup.qr_bar`), generates `Q̄` (`Lemma7Setup.span_map_y`), and `K̄[Y] → gr_Q̄(R̄)`,
`Y_j ↦ [ȳ_j]`, is bijective. -/
noncomputable def Lemma7Setup.grQuotEquiv :
    MvPolynomial κ ((R ⧸ P) ⧸ Q.map (Ideal.Quotient.mk P)) ≃+*
      AssocGraded (Q.map (Ideal.Quotient.mk P)) :=
  RingEquiv.ofBijective
    (zFormHom (Q.map (Ideal.Quotient.mk P)) (fun j => Ideal.Quotient.mk P (y j)) S.hy')
    ⟨aeval_mk_injective_of_isQuasiRegular _ _ S.hy' S.qr_bar S.span_map_y,
      aeval_mk_surjective _ _ S.hy' S.span_map_y⟩

theorem Lemma7Setup.grQuotEquiv_X (j : κ) :
    S.grQuotEquiv (MvPolynomial.X j) = AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) 1
      (Ideal.Quotient.mk P (y j)) (S.hy' j) := by
  simp [Lemma7Setup.grQuotEquiv, zFormHom]

theorem Lemma7Setup.grQuotEquiv_C (c : (R ⧸ P) ⧸ Q.map (Ideal.Quotient.mk P)) :
    S.grQuotEquiv (MvPolynomial.C c) =
      algebraMap ((R ⧸ P) ⧸ Q.map (Ideal.Quotient.mk P))
        (AssocGraded (Q.map (Ideal.Quotient.mk P))) c := by
  simp [Lemma7Setup.grQuotEquiv, zFormHom]

/-- `gr_Q̄(R̄) → K[Y]`, `K = R/Q = R̄/Q̄`: the inverse of the identification
`Lemma7Setup.grQuotEquiv`, followed by `R̄/Q̄ = R/Q`. -/
noncomputable def Lemma7Setup.grQuotCoord :
    AssocGraded (Q.map (Ideal.Quotient.mk P)) →+* MvPolynomial κ (R ⧸ Q) :=
  (MvPolynomial.map (DoubleQuot.quotQuotEquivQuotOfLE S.hPQ).toRingHom).comp
    S.grQuotEquiv.symm.toRingHom

theorem Lemma7Setup.grQuotCoord_injective : Function.Injective S.grQuotCoord :=
  (MvPolynomial.map_injective _ (DoubleQuot.quotQuotEquivQuotOfLE S.hPQ).injective).comp
    S.grQuotEquiv.symm.injective

theorem Lemma7Setup.grQuotCoord_surjective : Function.Surjective S.grQuotCoord :=
  (MvPolynomial.map_surjective _ (DoubleQuot.quotQuotEquivQuotOfLE S.hPQ).surjective).comp
    S.grQuotEquiv.symm.surjective

theorem Lemma7Setup.grQuotCoord_bijective : Function.Bijective S.grQuotCoord :=
  ⟨S.grQuotCoord_injective, S.grQuotCoord_surjective⟩

/-- Under `gr_Q̄(R̄) = K[Y]` the class of `ȳ_j` in `gr¹_Q̄(R̄)` corresponds to `Y_j` (p. 192: "in such
a way that `Y_j` corresponds to the class of `ȳ_j` in `gr¹_Q̄(R̄)`"). -/
theorem Lemma7Setup.grQuotCoord_mk_one (j : κ) :
    S.grQuotCoord (AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) 1 (Ideal.Quotient.mk P (y j))
      (S.hy' j)) = MvPolynomial.X j := by
  rw [← S.grQuotEquiv_X j]
  simp [Lemma7Setup.grQuotCoord]

/-- The map `gr_Q(R) → gr_Q̄(R̄) = K[Y]` of Lemma 5 is `Z = 0` on `gr_Q(R) = K[Z, Y]`: the classes of
the `z_i ∈ P` die in `gr_Q̄(R̄)`, and `Y_j ↦ [ȳ_j]`. -/
theorem Lemma7Setup.grQuotCoord_grMapQuot (x : AssocGraded Q) :
    S.grQuotCoord (grMapQuot Q P x) = S.zeroCoord x := by
  set F : MvPolynomial κ (MvPolynomial ι (R ⧸ Q)) →+* MvPolynomial κ (R ⧸ Q) :=
    S.grQuotCoord.comp ((grMapQuot Q P : AssocGraded Q →+* AssocGraded (Q.map
      (Ideal.Quotient.mk P))).comp (yzFormHom Q y z S.hy S.hz)) with hF
  have hX : ∀ j, F (MvPolynomial.X j) = zeroZ ι (R ⧸ Q) κ (MvPolynomial.X j) := by
    intro j
    simp only [hF, RingHom.comp_apply, yzFormHom_X, zeroZ, MvPolynomial.map_X]
    have := grMapQuot_mk Q P 1 (y j) (S.hy j)
    simp only [RingHom.coe_coe]
    rw [this]
    exact S.grQuotCoord_mk_one j
  have hCX : ∀ i, F (MvPolynomial.C (MvPolynomial.X i)) =
      zeroZ ι (R ⧸ Q) κ (MvPolynomial.C (MvPolynomial.X i)) := by
    intro i
    have hz0 : Ideal.Quotient.mk P (z i) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (by
      have := S.hzP i
      rwa [pow_one] at this)
    simp only [hF, RingHom.comp_apply, yzFormHom_C, zeroZ, MvPolynomial.map_C]
    have h1 : zFormHom Q z S.hz (MvPolynomial.X i) = AssocGraded.mk Q 1 (z i) (S.hz i) := by
      simp [zFormHom]
    simp only [RingHom.coe_coe]
    rw [h1, grMapQuot_mk]
    have h2 : AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) 1 (Ideal.Quotient.mk P (z i))
        (by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ (S.hz i)) = 0 :=
      (AssocGraded.mk_eq_zero_iff _ _).mpr (by rw [hz0]; exact zero_mem _)
    rw [h2, map_zero]
    simp
  have hCC : ∀ c : R ⧸ Q, F (MvPolynomial.C (MvPolynomial.C c)) =
      zeroZ ι (R ⧸ Q) κ (MvPolynomial.C (MvPolynomial.C c)) := by
    intro c
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
    simp only [hF, RingHom.comp_apply, yzFormHom_C, zeroZ, MvPolynomial.map_C]
    have h1 : zFormHom Q z S.hz (MvPolynomial.C (Ideal.Quotient.mk Q a)) =
        algebraMap R (AssocGraded Q) a := by
      simp [zFormHom]
      exact (IsScalarTower.algebraMap_apply R (R ⧸ Q) (AssocGraded Q) a).symm
    simp only [RingHom.coe_coe]
    rw [h1, AlgHom.commutes]
    have h2 : algebraMap R (AssocGraded (Q.map (Ideal.Quotient.mk P))) a =
        S.grQuotEquiv (MvPolynomial.C (Ideal.Quotient.mk (Q.map (Ideal.Quotient.mk P))
          (Ideal.Quotient.mk P a))) := by
      rw [S.grQuotEquiv_C, IsScalarTower.algebraMap_apply R (R ⧸ P)
        (AssocGraded (Q.map (Ideal.Quotient.mk P))),
        IsScalarTower.algebraMap_apply (R ⧸ P) ((R ⧸ P) ⧸ Q.map (Ideal.Quotient.mk P))
        (AssocGraded (Q.map (Ideal.Quotient.mk P)))]
      rfl
    rw [h2]
    simp only [Lemma7Setup.grQuotCoord, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
      RingHom.coe_coe, RingEquiv.symm_apply_apply, MvPolynomial.map_C, MvPolynomial.constantCoeff_C]
    exact congrArg MvPolynomial.C (DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk a S.hPQ)
  have hFeq : F = zeroZ ι (R ⧸ Q) κ := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) hX
    have hinner : F.comp MvPolynomial.C = (zeroZ ι (R ⧸ Q) κ).comp MvPolynomial.C :=
      MvPolynomial.ringHom_ext hCC hCX
    exact RingHom.congr_fun hinner a
  rw [S.zeroCoord_apply, ← S.yz_coord x]
  have := RingHom.congr_fun hFeq (S.coord x)
  simp only [hF, RingHom.comp_apply, RingHom.coe_coe] at this
  rw [S.coord_yz] at *
  simpa [S.coord_yz] using this

end Lemma7Coord

section Lemma7Psi0

open MvPolynomial

variable {R : Type u} [CommRing R] {P Q : Ideal R} {κ ι : Type*} {y : κ → R} {z : ι → R}
  (S : Lemma7Setup P Q y z)

/-- The partial sum of `ψ ∈ K[Z][Y]` consisting of those terms (monomials in `Z` and `Y`) which are
exactly of degree `ν` in `Z` (p. 192: "`ψ₀` is the partial sum of the form `ψ` consisting of those
terms (monomials in `Z` and `Y`) which are exactly of degree `ν` in `Z₁, …, Z_r`"). -/
noncomputable def zDegreePart {K : Type*} [CommRing K] (ν : ℕ) (ψ : MvPolynomial κ (MvPolynomial ι K)) :
    MvPolynomial κ (MvPolynomial ι K) :=
  ∑ m ∈ ψ.support, monomial m (homogeneousComponent ν (ψ.coeff m))

theorem coeff_zDegreePart {K : Type*} [CommRing K] (ν : ℕ) (ψ : MvPolynomial κ (MvPolynomial ι K))
    (m : κ →₀ ℕ) : (zDegreePart ν ψ).coeff m = homogeneousComponent ν (ψ.coeff m) := by
  classical
  rw [zDegreePart, coeff_sum]
  simp only [coeff_monomial]
  rw [Finset.sum_ite_eq' ψ.support m]
  by_cases hm : m ∈ ψ.support
  · simp [hm]
  · simp [hm, notMem_support_iff.mp hm]

open Classical in
/-- The image of a coefficient `c ∈ Q̄ⁿ` of `Ψ` in `grⁿ_Q̄(R̄) = K[Y]ₙ` (p. 192: "replacing the
coefficients in `Q̄` of `Ψ` by their images in `grⁿ_Q̄(R̄)`"); `0` if `c ∉ Q̄ⁿ`. -/
noncomputable def Lemma7Setup.imageCoeff (n : ℕ) (c : R ⧸ P) : MvPolynomial κ (R ⧸ Q) :=
  if hc : c ∈ (Q.map (Ideal.Quotient.mk P)) ^ n then
    S.grQuotCoord (AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) n c hc) else 0

/-- **The form `ψ₀`** (p. 192): "Let `ψ₀` be the form in `K[Z, Y]` obtained by replacing the
coefficients in `Q̄` of `Ψ` by their images in `grⁿ_Q̄(R̄)`" (`Ψ ∈ Q̄ⁿ R̄[Z]`; here
`ψ₀ = Σ_w ι(c_w) Z^w` with `ι(c_w) ∈ K[Y]ₙ` the image of the coefficient `c_w` of `Z^w`). -/
noncomputable def Lemma7Setup.psiZero (n : ℕ) (Ψ : MvPolynomial ι (R ⧸ P)) :
    MvPolynomial κ (MvPolynomial ι (R ⧸ Q)) :=
  ∑ w ∈ Ψ.support, MvPolynomial.map (C : (R ⧸ Q) →+* MvPolynomial ι (R ⧸ Q))
    (S.imageCoeff n (Ψ.coeff w)) * C (monomial w 1)

theorem Lemma7Setup.coeff_psiZero (n : ℕ) (Ψ : MvPolynomial ι (R ⧸ P)) (m : κ →₀ ℕ) :
    (S.psiZero n Ψ).coeff m =
      ∑ w ∈ Ψ.support, monomial w ((S.imageCoeff n (Ψ.coeff w)).coeff m) := by
  rw [Lemma7Setup.psiZero, coeff_sum]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [mul_comm, coeff_C_mul, coeff_map, mul_comm, C_mul_monomial, mul_one]

theorem Lemma7Setup.coeff_coeff_psiZero (n : ℕ) (Ψ : MvPolynomial ι (R ⧸ P)) (m : κ →₀ ℕ)
    (w : ι →₀ ℕ) : ((S.psiZero n Ψ).coeff m).coeff w = (S.imageCoeff n (Ψ.coeff w)).coeff m := by
  classical
  rw [S.coeff_psiZero, coeff_sum]
  simp only [coeff_monomial]
  rw [Finset.sum_ite_eq' Ψ.support w]
  by_cases hw : w ∈ Ψ.support
  · simp [hw]
  · simp only [hw, ↓reduceIte]
    rw [notMem_support_iff.mp hw]
    have : S.imageCoeff n 0 = 0 := by
      unfold Lemma7Setup.imageCoeff
      by_cases h0 : (0 : R ⧸ P) ∈ (Q.map (Ideal.Quotient.mk P)) ^ n
      · have : AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) n (0 : R ⧸ P) h0 = 0 :=
          (AssocGraded.mk_eq_zero_iff _ h0).mpr (zero_mem _)
        simp [h0, this]
      · simp [h0]
    rw [this]
    rfl

/-- For a form `F` of degree `d` in `Z` and a monomial `Z^w` of degree `ν`, the component of
degree `ν` of `F · Z^w` is `F(0) Z^w`: it is `F Z^w` if `d = 0` and `0` if `d > 0`. -/
theorem homogeneousComponent_mul_monomial {K : Type*} [CommRing K] {d ν : ℕ}
    {F : MvPolynomial ι K} (hF : F.IsHomogeneous d) {w : ι →₀ ℕ} (hw : w.degree = ν) :
    homogeneousComponent ν (F * monomial w 1) = monomial w (constantCoeff F) := by
  by_cases hd : d = 0
  · subst hd
    have hF0 : F = C (F.coeff 0) :=
      calc F = homogeneousComponent 0 F := (homogeneousComponent_eq_self hF).symm
        _ = C (F.coeff 0) := homogeneousComponent_zero F
    have : F * monomial w 1 = monomial w (constantCoeff F) := by
      rw [constantCoeff_eq]
      calc F * monomial w 1 = C (F.coeff 0) * monomial w 1 := by rw [← hF0]
        _ = monomial w (F.coeff 0) := by rw [C_mul_monomial, mul_one]
    rw [this]
    exact homogeneousComponent_eq_self (isHomogeneous_monomial _ hw)
  · have hmul : (F * monomial w 1).IsHomogeneous (d + ν) := hF.mul (isHomogeneous_monomial 1 hw)
    rw [homogeneousComponent_of_mem hmul]
    simp only [show ν ≠ d + ν by omega, ↓reduceIte]
    have : constantCoeff F = 0 := by
      rw [constantCoeff_eq]
      refine hF.coeff_eq_zero ?_
      simp
      omega
    rw [this]
    simp

theorem Lemma7Setup.imageCoeff_eq_zero_iff {n : ℕ} {c : R ⧸ P}
    (hc : c ∈ (Q.map (Ideal.Quotient.mk P)) ^ n) :
    S.imageCoeff n c = 0 ↔ c ∈ (Q.map (Ideal.Quotient.mk P)) ^ (n + 1) := by
  have h : S.imageCoeff n c =
      S.grQuotCoord (AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) n c hc) := by
    simp only [Lemma7Setup.imageCoeff, hc, ↓reduceDIte]
  rw [h, ← map_zero S.grQuotCoord, S.grQuotCoord_injective.eq_iff, AssocGraded.mk_eq_zero_iff]

/-- **`ψ₀ ≠ 0` iff `Ψ ∉ Q̄ⁿ⁺¹R̄[Z]`** (p. 192: "Since `n` is the largest integer such that
`Ψ ∈ Q̄ⁿR̄[Z]`, `ψ₀` is different from zero"): `ψ₀ = 0` iff all coefficients of `Ψ` lie in
`Q̄ⁿ⁺¹`. -/
theorem Lemma7Setup.psiZero_eq_zero_iff {n : ℕ} {Ψ : MvPolynomial ι (R ⧸ P)}
    (hcoef : ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ n) :
    S.psiZero n Ψ = 0 ↔ ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ (n + 1) := by
  constructor
  · intro h w
    refine (S.imageCoeff_eq_zero_iff (hcoef w)).mp ?_
    ext m
    rw [← S.coeff_coeff_psiZero, h]
    simp
  · intro h
    ext m w
    rw [S.coeff_coeff_psiZero, (S.imageCoeff_eq_zero_iff (hcoef w)).mpr (h w)]
    rfl

theorem zDegreePart_zero {K : Type*} [CommRing K] (ν : ℕ) :
    zDegreePart (κ := κ) (ι := ι) (K := K) ν 0 = 0 := by
  simp [zDegreePart]

/-- **"`ψ ∈ (Z₁, …, Z_r)^{ν+1} K[Z, Y]`" has no term of exact degree `ν` in `Z`** (p. 191--192:
"`ν_P(h) ≥ ν + 1`", "`ψ₀` is different from zero"): if `p ∈ P^{ν+1} ∩ Q^{ν+n}`, the form `ψ` of
degree `ν + n` corresponding to the class of `p` in `gr_Q(R)` has all its terms of degree `> ν` in
`Z`, so its partial sum of exact degree `ν` in `Z` vanishes (bigrading compatible with the `P`-adic
filtration, `Lemma7Setup.coord_mk_coeff`). -/
theorem Lemma7Setup.zDegreePart_coord_mk_eq_zero {n ν : ℕ} {p : R} (hpP : p ∈ P ^ (ν + 1))
    (hpQ : p ∈ Q ^ (ν + n)) : zDegreePart ν (S.coord (AssocGraded.mk Q (ν + n) p hpQ)) = 0 := by
  ext m : 1
  rw [coeff_zDegreePart]
  obtain ⟨hhom, hne⟩ := S.coord_mk_coeff hpP hpQ m
  by_cases h0 : (S.coord (AssocGraded.mk Q (ν + n) p hpQ)).coeff m = 0
  · rw [h0, map_zero]
    rfl
  · have := hne h0
    rw [homogeneousComponent_of_mem hhom]
    simp only [show ν ≠ ν + n - m.degree by omega, ↓reduceIte]
    rfl

/-- **"Then we can see that `ψ₀` is the partial sum of the form `ψ` consisting of those terms
(monomials in `Z` and `Y`) which are exactly of degree `ν` in `Z₁, …, Z_r`"** (p. 192): let
`Ψ ∈ Q̄ⁿR̄[Z]` be a form of degree `ν` (its coefficients lie in `Q̄ⁿ`) and `g ∈ Pᵛ ∩ Q^{ν+n}` an
element whose initial form in `gr_P(R) = R̄[Z]` is `Ψ`; then the partial sum of exact degree `ν` in
`Z` of the form `ψ ∈ K[Z, Y]` of degree `ν + n` corresponding to the class of `g` in `gr_Q(R)` is the
form `ψ₀` obtained from `Ψ` by replacing the coefficients in `Q̄` by their images in `grⁿ_Q̄(R̄)`.

Deviation from the paper (gap filled): the paper says "we can see".  Proof: write `g = Σ_w a_w z^w +
p'` with `a_w ∈ Qⁿ` lifting the coefficient `c_w` of `Z^w` in `Ψ` and `p' ∈ P^{ν+1} ∩ Q^{ν+n}`; the
terms of `p'` have degree `> ν` in `Z`, and `[a_w z^w] = [a_w]ₙ · Z^w` whose terms of exact degree
`ν` in `Z` are those of `[a_w]ₙ` of degree `0` in `Z`, i.e. the image of `c_w` in `K[Y]ₙ`. -/
theorem Lemma7Setup.zDegreePart_coord_mk_eq_psiZero {n ν : ℕ} {Ψ : MvPolynomial ι (R ⧸ P)}
    (hΨ : Ψ.IsHomogeneous ν) (hcoef : ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ n)
    {g : R} (hgP : g ∈ P ^ ν) (hgQ : g ∈ Q ^ (ν + n))
    (hΨg : zFormHom P z S.hzP Ψ = AssocGraded.mk P ν g hgP) :
    zDegreePart ν (S.coord (AssocGraded.mk Q (ν + n) g hgQ)) = S.psiZero n Ψ := by
  classical
  have hwdeg : ∀ w ∈ Ψ.support, w.degree = ν := fun w hw => by
    rw [Finsupp.degree_eq_weight_one]
    exact hΨ (mem_support_iff.mp hw)
  -- lifts `a_w ∈ Qⁿ` of the coefficients `c_w` of `Ψ`
  have hlift : ∀ w, ∃ a, a ∈ Q ^ n ∧ Ideal.Quotient.mk P a = Ψ.coeff w := by
    intro w
    have := hcoef w
    rw [← Ideal.map_pow, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at this
    exact this
  choose a haQ haP using hlift
  -- the form `A = Σ_w a_w Z^w` over `R` with `A ≡ Ψ`, and `g' = A(z)`
  set A : MvPolynomial ι R := ∑ w ∈ Ψ.support, monomial w (a w) with hA
  have hAhom : A.IsHomogeneous ν :=
    IsHomogeneous.sum _ _ _ fun w hw => isHomogeneous_monomial _ (hwdeg w hw)
  have hAmap : A.map (Ideal.Quotient.mk P) = Ψ := by
    conv_rhs => rw [Ψ.as_sum]
    rw [hA, map_sum]
    exact Finset.sum_congr rfl fun w _ => by rw [map_monomial, haP]
  set g' : R := eval z A with hg'
  have hg'P : g' ∈ P ^ ν := eval_mem_pow_of_isHomogeneous P z S.hzP hAhom
  have hg'eq : g' = ∑ w ∈ Ψ.support, a w * eval z (monomial w 1) := by
    rw [hg', hA, map_sum]
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [show (monomial w (a w) : MvPolynomial ι R) = C (a w) * monomial w 1 by
      rw [C_mul_monomial, mul_one], map_mul, eval_C]
  have hzw : ∀ w ∈ Ψ.support, eval z (monomial w (1 : R)) ∈ Q ^ ν := fun w hw =>
    eval_mem_pow_of_isHomogeneous Q z S.hz (isHomogeneous_monomial 1 (hwdeg w hw))
  have hterm : ∀ w ∈ Ψ.support, a w * eval z (monomial w 1) ∈ Q ^ (n + ν) := fun w hw => by
    rw [pow_add]
    exact Ideal.mul_mem_mul (haQ w) (hzw w hw)
  have hg'Q : g' ∈ Q ^ (ν + n) := by
    rw [hg'eq, add_comm]
    exact Ideal.sum_mem _ hterm
  -- `p' = g - g' ∈ P^{ν+1} ∩ Q^{ν+n}`
  have hεA : zFormHom P z S.hzP Ψ = AssocGraded.mk P ν g' hg'P := by
    rw [← hAmap]
    exact zFormHom_map_of_isHomogeneous P z S.hzP hAhom
  have hp'P : g - g' ∈ P ^ (ν + 1) :=
    sub_mem_pow_succ_of_mk_eq_mk P hgP hg'P (hΨg.symm.trans hεA)
  have hp'Q : g - g' ∈ Q ^ (ν + n) := sub_mem hgQ hg'Q
  have hsplit : AssocGraded.mk Q (ν + n) g hgQ =
      AssocGraded.mk Q (ν + n) g' hg'Q + AssocGraded.mk Q (ν + n) (g - g') hp'Q := by
    rw [← AssocGraded.mk_add Q (ν + n) g' (g - g') hg'Q hp'Q]
    exact mk_congr_of_eq Q rfl (by ring) _ _
  -- the terms of `ψ(p')` have degree `> ν` in `Z`
  have hpart : ∀ m, homogeneousComponent ν
      ((S.coord (AssocGraded.mk Q (ν + n) (g - g') hp'Q)).coeff m) = 0 := by
    intro m
    have := congrArg (fun F => F.coeff m) (S.zDegreePart_coord_mk_eq_zero hp'P hp'Q)
    simpa [coeff_zDegreePart] using this
  -- the main term: `ψ(g') = Σ_w ρ_w Z^w`
  set ρ : (ι →₀ ℕ) → MvPolynomial κ (MvPolynomial ι (R ⧸ Q)) :=
    fun w => S.coord (AssocGraded.mk Q n (a w) (haQ w)) with hρ
  have hmain : S.coord (AssocGraded.mk Q (ν + n) g' hg'Q) =
      ∑ w ∈ Ψ.support, ρ w * C (monomial w 1) := by
    have h1 : AssocGraded.mk Q (ν + n) g' hg'Q =
        AssocGraded.mk Q (n + ν) g' (by rw [add_comm]; exact hg'Q) :=
      mk_congr_of_eq Q (add_comm _ _) rfl _ _
    have h2 := AssocGraded.mk_sum_eq_sum Q (n := n + ν) Ψ.support
      (fun w => a w * eval z (monomial w 1)) hterm
      (fun w => yzFormHom Q y z S.hy S.hz (ρ w * C (monomial w 1))) (fun w hw => by
        rw [← AssocGraded.mk_mul_mk Q (haQ w) (hzw w hw), map_mul, yzFormHom_C, hρ]
        simp only [Lemma7Setup.yz_coord]
        congr 1
        have := zFormHom_map_of_isHomogeneous Q z S.hz (A := (monomial w (1 : R))) 
          (isHomogeneous_monomial 1 (hwdeg w hw))
        rw [map_monomial, map_one] at this
        exact this.symm)
    have h3 : AssocGraded.mk Q (n + ν) g' (by rw [add_comm]; exact hg'Q) =
        AssocGraded.mk Q (n + ν) (∑ w ∈ Ψ.support, a w * eval z (monomial w 1))
          (Ideal.sum_mem _ hterm) :=
      mk_congr_of_eq Q rfl hg'eq _ _
    rw [h1, h3, h2, ← map_sum, S.coord_yz]
  -- compare the coefficients
  ext m : 1
  rw [coeff_zDegreePart, S.coeff_psiZero]
  have hcoord : (S.coord (AssocGraded.mk Q (ν + n) g hgQ)).coeff m =
      (∑ w ∈ Ψ.support, ρ w * C (monomial w 1)).coeff m +
        (S.coord (AssocGraded.mk Q (ν + n) (g - g') hp'Q)).coeff m := by
    rw [hsplit, map_add, hmain]
    rfl
  rw [hcoord, map_add, hpart m, add_zero, coeff_sum, map_sum]
  refine Finset.sum_congr rfl fun w hw => ?_
  rw [mul_comm, coeff_C_mul, mul_comm]
  obtain ⟨hhom, hne⟩ := S.coord_mk_coeff (P := P) (a := 0) (g := a w) (by simp) (haQ w) m
  rw [homogeneousComponent_mul_monomial hhom (hwdeg w hw)]
  congr 1
  -- `(imageCoeff c_w).coeff m = constantCoeff ((ρ w).coeff m)`
  have hmk : AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) n (Ψ.coeff w) (hcoef w) =
      grMapQuot Q P (AssocGraded.mk Q n (a w) (haQ w)) := by
    rw [grMapQuot_mk]
    exact mk_congr_of_eq _ rfl (haP w).symm _ _
  have : S.imageCoeff n (Ψ.coeff w) =
      S.grQuotCoord (AssocGraded.mk (Q.map (Ideal.Quotient.mk P)) n (Ψ.coeff w) (hcoef w)) := by
    simp only [Lemma7Setup.imageCoeff, hcoef w, ↓reduceDIte]
  rw [this, hmk, S.grQuotCoord_grMapQuot, S.zeroCoord_apply, coeff_zeroZ]

end Lemma7Psi0

section Lemma7Identify

open MvPolynomial

variable {R : Type u} [CommRing R] {P Q : Ideal R} {κ ι : Type*} {y : κ → R} {z : ι → R}
  (S : Lemma7Setup P Q y z)

/-- "We can identify `gr_P(R)` with the polynomial ring `R̄[Z] = R̄[Z₁, …, Z_r]` of `r` variables
over `R̄` in such a way that `Z_i` corresponds to the class of `z_i` in `gr¹_P(R)`" (p. 191):
`R̄[Z] → gr_P(R)`, `Z_i ↦ [z_i]`, is bijective, `z` being quasi-regular with `(z) = P`. -/
theorem Lemma7Setup.zFormHom_bijective : Function.Bijective (zFormHom P z S.hzP) :=
  ⟨aeval_mk_injective_of_isQuasiRegular P z S.hzP S.qr_z S.hPz,
    aeval_mk_surjective P z S.hzP S.hPz⟩

/-- Under `R̄[Z] ≅ gr_P(R)`, the ideal `Q̄ᵏ gr_P(R)` corresponds to `Q̄ᵏ R̄[Z]`: a polynomial
`Ψ ∈ R̄[Z]` lies in `Q̄ᵏR̄[Z]` iff all its coefficients lie in `Q̄ᵏ`. -/
theorem Lemma7Setup.zFormHom_mem_pow_iff (k : ℕ) (Ψ : MvPolynomial ι (R ⧸ P)) :
    zFormHom P z S.hzP Ψ ∈ (Q.map (algebraMap R (AssocGraded P))) ^ k ↔
      ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ k := by
  have hcomp : (zFormHom P z S.hzP).comp (C : R ⧸ P →+* MvPolynomial ι (R ⧸ P)) =
      algebraMap (R ⧸ P) (AssocGraded P) := by
    ext a
    simp [zFormHom]
  have hmap : Ideal.map (zFormHom P z S.hzP)
      (Ideal.map (C : R ⧸ P →+* MvPolynomial ι (R ⧸ P)) ((Q.map (Ideal.Quotient.mk P)) ^ k)) =
        (Q.map (algebraMap R (AssocGraded P))) ^ k := by
    rw [Ideal.map_map, hcomp, ← Ideal.map_pow, ← Ideal.map_pow, Ideal.map_map]
    congr 1
  have := Ideal.comap_map_of_bijective (f := zFormHom P z S.hzP) S.zFormHom_bijective
    (I := Ideal.map (C : R ⧸ P →+* MvPolynomial ι (R ⧸ P)) ((Q.map (Ideal.Quotient.mk P)) ^ k))
  rw [hmap] at this
  rw [← MvPolynomial.mem_map_C_iff, ← this, Ideal.mem_comap]

/-- Every element of `Pᵛ` is the value `A(z)` at `z` of a form `A` of degree `ν` over `R`, since
`P = (z)`: so every homogeneous element `[a]` of `gr_P(R)` of degree `ν` is the image of a form
`Ψ ∈ R̄[Z]` of degree `ν` under `R̄[Z] ≅ gr_P(R)`. -/
theorem Lemma7Setup.exists_isHomogeneous_zFormHom_eq {ν : ℕ} {a : R} (ha : a ∈ P ^ ν) :
    ∃ Ψ : MvPolynomial ι (R ⧸ P), Ψ.IsHomogeneous ν ∧
      zFormHom P z S.hzP Ψ = AssocGraded.mk P ν a ha := by
  obtain ⟨K, hK, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous z a).mp
    (by rw [S.hPz]; exact ha)
  exact ⟨K.map (Ideal.Quotient.mk P), hK.map _, zFormHom_map_of_isHomogeneous P z S.hzP hK⟩

end Lemma7Identify

section Lemma7Classes

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (P Q : Ideal R)

/-- **"`Ψ*` … is contained in `Q̄ⁿH`"** (p. 192): the class in `grᵛ_P(R)` of an element `h ∈ Pᵛ`
of the form `Σ_β e_β + p'`, `e_β ∈ Qⁿ P^{ν-ν_β} f_β`, `p' ∈ P^{ν+1}`, lies in `Q̄ⁿ H`,
`H = (Φ₁, …, Φ_m) gr_P(R)` (`Φ_β` the initial form of `f_β` in `gr_P(R)`): "Ψ* must be of the form
`Σ*_α (T_α(ȳ) Σ_β ζ*_{α,β}(Z) Φ_β(Z))`", each term being a multiple of `Φ_β` by an element of
`Q̄ⁿ gr_P(R)`. -/
theorem mk_mem_mul_span_of_mem_sup (hPtop : P ≠ ⊤) {m : ℕ} (f : Fin m → R)
    (h₁ : ∀ j, Ideal.ordElem Q (f j) = Ideal.ordElem P (f j)) (n ν : ℕ) {h : R}
    (hhP : h ∈ P ^ ν)
    (hh : h ∈ (∑ β ∈ Finset.univ.filter (fun β => (Ideal.ordElem Q (f β)).toNat ≤ ν),
        Q ^ n * P ^ (ν - (Ideal.ordElem Q (f β)).toNat) * Ideal.span {f β}) ⊔ P ^ (ν + 1)) :
    AssocGraded.mk P ν h hhP ∈ (Q.map (algebraMap R (AssocGraded P))) ^ n *
      Ideal.span (Set.range fun j => initialForm P (f j)) := by
  classical
  set νf : Fin m → ℕ := fun β => (Ideal.ordElem Q (f β)).toNat with hνf
  have hfP : ∀ β, f β ∈ P ^ νf β := by
    intro β
    by_cases h : Ideal.ordElem Q (f β) = ⊤
    · exact Ideal.ordElem_eq_top_iff.mp (h₁ β ▸ h) _
    · rw [h₁ β] at h
      simp only [νf, h₁ β]
      exact Ideal.mem_pow_of_ordElem (ENat.natCast_toNat h).symm
  obtain ⟨h', hh', p', hp', hhp⟩ := Submodule.mem_sup.mp hh
  have hh'i : h' ∈ P ^ ν := by
    have : h' = h - p' := by rw [← hhp]; ring
    rw [this]
    exact sub_mem hhP (Ideal.pow_le_pow_right (Nat.le_succ ν) hp')
  have heq : AssocGraded.mk P ν h hhP = AssocGraded.mk P ν h' hh'i := by
    refine mk_eq_mk_of_sub_mem P hhP hh'i ?_
    have : h - h' = p' := by rw [← hhp]; ring
    rw [this]
    exact hp'
  rw [heq]
  obtain ⟨e, he, rfl⟩ := exists_eq_sum_of_mem_sum _ _ hh'
  have hdec : ∀ β, νf β ≤ ν → e β ∈ Q ^ n * P ^ (ν - νf β) * Ideal.span {f β} →
      ∃ c ∈ Q ^ n * P ^ (ν - νf β), c ∈ P ^ (ν - νf β) ∧ c * f β = e β ∧ e β ∈ P ^ ν := by
    intro β hβ' heβ
    obtain ⟨c, hc, hce⟩ := Ideal.mem_mul_span_singleton.mp heβ
    have hcP : c ∈ P ^ (ν - νf β) := Ideal.mul_le_right hc
    refine ⟨c, hc, hcP, hce, ?_⟩
    have : P ^ (ν - νf β) * P ^ νf β = P ^ ν := by rw [← pow_add, Nat.sub_add_cancel hβ']
    rw [← hce, ← this]
    exact Ideal.mul_mem_mul hcP (hfP β)
  have hmemi : ∀ β ∈ Finset.univ.filter (fun β => νf β ≤ ν), e β ∈ P ^ ν := by
    intro β hβ
    obtain ⟨-, -, -, -, h⟩ := hdec β (Finset.mem_filter.mp hβ).2 (he β hβ)
    exact h
  refine mk_sum_mem P _ _ e hmemi (fun β hβ => ?_) hh'i
  suffices H : ∀ hm : e β ∈ P ^ ν, AssocGraded.mk P ν (e β) hm ∈
      (Q.map (algebraMap R (AssocGraded P))) ^ n *
        Ideal.span (Set.range fun j => initialForm P (f j)) from H _
  intro hm
  have hd := hdec β (Finset.mem_filter.mp hβ).2 (he β hβ)
  obtain ⟨c, hc, hcP, hce, heP⟩ := hd
  have hβ' := (Finset.mem_filter.mp hβ).2
  by_cases htop : Ideal.ordElem P (f β) = ⊤
  · have hf0 : f β = 0 := (Ideal.ordElem_eq_top_iff_eq_zero hPtop).mp htop
    have h0 : e β ∈ P ^ (ν + 1) := by
      rw [← hce, hf0, mul_zero]
      exact zero_mem _
    rw [(AssocGraded.mk_eq_zero_iff P _).mpr h0]
    exact zero_mem _
  · have hord : Ideal.ordElem P (f β) = (νf β : ℕ∞) := by
      simp only [νf, h₁ β]
      exact (ENat.natCast_toNat htop).symm
    rw [AssocGraded.mk_congr P (Nat.sub_add_cancel hβ').symm hce.symm _
        (by rw [pow_add]; exact Ideal.mul_mem_mul hcP (hfP β)),
      ← AssocGraded.mk_mul_mk P hcP (hfP β)]
    refine Ideal.mul_mem_mul ?_ ?_
    · rw [← Ideal.map_pow]
      exact mk_mem_map_of_mem_mul P (Q ^ n) hc hcP
    · rw [← initialForm_eq_mk P hord]
      exact Ideal.subset_span ⟨β, rfl⟩

end Lemma7Classes

section Lemma7Key

open MvPolynomial

variable {R : Type u} [CommRing R]

theorem mk_sub_mk {I : Ideal R} {n : ℕ} {a b : R} (ha : a ∈ I ^ n) (hb : b ∈ I ^ n) :
    AssocGraded.mk I n (a - b) (sub_mem ha hb) =
      AssocGraded.mk I n a ha - AssocGraded.mk I n b hb := by
  have := AssocGraded.mk_add I n (a - b) b (sub_mem ha hb) hb
  rw [eq_sub_iff_add_eq, ← this]
  exact mk_congr_of_eq I rfl (by ring) _ _

variable [IsLocalRing R] [IsNoetherianRing R] {P Q : Ideal R} {κ ι : Type*} {y : κ → R}
  {z : ι → R} (S : Lemma7Setup P Q y z) (J : Ideal R) {m : ℕ} (f : Fin m → R)
  (hfJ : ∀ j, f j ∈ J) (h₁ : ∀ j, Ideal.ordElem Q (f j) = Ideal.ordElem P (f j))
  (h₂ : Ideal.span (Set.range fun j => initialForm Q (f j)) = grIdeal Q J)

omit [IsLocalRing R] [IsNoetherianRing R] in
include S hfJ h₁ h₂ in
/-- The step `ψ ↦ h` of the proof of Lemma 7 (pp. 191–192), `exists_mem_sup_of_mem_inf_pow`, for
the data of `Lemma7Setup`. -/
theorem Lemma7Setup.exists_sub_mem_pow_succ {a μ : ℕ} {g : R} (hgP : g ∈ P ^ a) (hgQ : g ∈ Q ^ μ)
    (hgJ : AssocGraded.mk Q μ g hgQ ∈ grIdeal Q J) :
    ∃ h ∈ J, h ∈ P ^ a ∧ g - h ∈ Q ^ (μ + 1) ∧
      (a ≤ μ → h ∈ (∑ β ∈ Finset.univ.filter (fun β => (Ideal.ordElem Q (f β)).toNat ≤ a),
        Q ^ (μ - a) * P ^ (a - (Ideal.ordElem Q (f β)).toNat) * Ideal.span {f β}) ⊔
          P ^ (a + 1)) :=
  exists_mem_sup_of_mem_inf_pow J P Q (Ideal.span (Set.range y)) y z S.hy S.hz S.hQ S.hind S.hPz
    rfl S.bij f hfJ h₁ h₂ hgP hgQ hgJ

include S hfJ h₁ h₂ in
/-- **The main step of the proof of Lemma 7** (pp. 191–192), as printed.  Let `Ψ ∈ R̄[Z] = gr_P(R)`
be a form of degree `ν` which lies in `Q̄ⁿR̄[Z]` but not in `Q̄ⁿ⁺¹R̄[Z]` ("we may assume that `n` is the
largest integer such that `Ψ ∈ Q̄ⁿR̄[Z]`") and in `gr_P(J, R)`.  Then there is `h ∈ J ∩ Pᵛ`,
`ν_P(h) = ν`, whose initial form `Ψ* = [h]` in `gr_P(R)` lies in `Q̄ⁿH` and satisfies
`Ψ - Ψ* ∈ Q̄ⁿ⁺¹R̄[Z]`; so `Ψ ∈ Q̄ⁿH + Q̄ⁿ⁺¹R̄[Z]`.

Steps (each quoted in the body): `g ∈ J` with initial form `Ψ`, `μ = ν_Q(g)`, "Then we have
`ν + n ≥ μ ≥ ν`"; the form `ψ` and the element `h` (`Lemma7Setup.exists_sub_mem_pow_succ`);
the case `ν + n > μ` ("Thus we could choose `g` in such a way that `ν + n = μ`"); the case
`ν + n = μ`; "`ψ₀` is the partial sum of the form `ψ` …" (`Lemma7Setup.zDegreePart_coord_mk_eq_psiZero`);
"since `n` is the largest integer such that `Ψ ∈ Q̄ⁿR̄[Z]`, `ψ₀` is different from zero"
(`Lemma7Setup.psiZero_eq_zero_iff`); "Hence we must have `ν_P(h) = ν`"; "`Ψ - Ψ* ∈ Q̄ⁿ⁺¹R̄[Z]`,
because we know that `ψ` is the initial form of `h` as well as that of `g`"; "`Ψ*` is contained in
`Q̄ⁿH`" (`mk_mem_mul_span_of_mem_sup`). -/
theorem Lemma7Setup.exists_mk_mem_mul_span_sub_mem (hPtop : P ≠ ⊤) (hQtop : Q ≠ ⊤)
    {n ν : ℕ} {Ψ : MvPolynomial ι (R ⧸ P)} (hΨ : Ψ.IsHomogeneous ν)
    (hcoef : ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ n)
    (hmax : ¬ ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ (n + 1))
    (hJ : zFormHom P z S.hzP Ψ ∈ grIdeal P J) :
    ∃ (h : R) (hhP : h ∈ P ^ ν), h ∉ P ^ (ν + 1) ∧
      AssocGraded.mk P ν h hhP ∈ (Q.map (algebraMap R (AssocGraded P))) ^ n *
        Ideal.span (Set.range fun j => initialForm P (f j)) ∧
      zFormHom P z S.hzP Ψ - AssocGraded.mk P ν h hhP ∈
        (Q.map (algebraMap R (AssocGraded P))) ^ (n + 1) := by
  classical
  have hPQ : P ≤ Q := S.hQ ▸ le_sup_left
  -- `Ψ` is the initial form of some `g₀ ∈ J`
  obtain ⟨g₀, ⟨hg₀J, -⟩, hg₀P, hg₀eq⟩ : ∃ g₀ ∈ J ⊓ P ^ ν, ∃ hg : g₀ ∈ P ^ ν,
      AssocGraded.mk P ν g₀ hg = zFormHom P z S.hzP Ψ := by
    obtain ⟨A, hAhom, hAmap⟩ := exists_isHomogeneous_map_eq P hΨ
    have hAP : eval z A ∈ P ^ ν := eval_mem_pow_of_isHomogeneous P z S.hzP hAhom
    have hε : zFormHom P z S.hzP Ψ = AssocGraded.mk P ν (eval z A) hAP := by
      rw [← hAmap]
      exact zFormHom_map_of_isHomogeneous P z S.hzP hAhom
    exact (grIdeal_homogeneous_eq P J ν _ (hε ▸ AssocGraded.mk_mem_homogeneous P hAP)).mp hJ
  have hΨQn : zFormHom P z S.hzP Ψ ∈ (Q.map (algebraMap R (AssocGraded P))) ^ n :=
    (S.zFormHom_mem_pow_iff n Ψ).mpr hcoef
  have hΨne : zFormHom P z S.hzP Ψ ≠ 0 := by
    intro h0
    apply hmax
    intro w
    have h1 : zFormHom P z S.hzP Ψ ∈ (Q.map (algebraMap R (AssocGraded P))) ^ (n + 1) := by
      rw [h0]
      exact zero_mem _
    exact (S.zFormHom_mem_pow_iff (n + 1) Ψ).mp h1 w
  -- "good" elements `g`: `g ∈ J ∩ Pᵛ` with initial form `Ψ`
  let Good : R → Prop := fun g => g ∈ J ∧ ∃ hg : g ∈ P ^ ν,
    AssocGraded.mk P ν g hg = zFormHom P z S.hzP Ψ
  have hgood_ne : ∀ g, Good g → g ≠ 0 := by
    rintro g ⟨-, hg, hgeq⟩ rfl
    apply hΨne
    rw [← hgeq]
    exact (AssocGraded.mk_eq_zero_iff P hg).mpr (zero_mem _)
  have hgood_order : ∀ g, Good g → ∃ μ : ℕ, Ideal.ordElem Q g = μ := by
    intro g hg
    obtain ⟨μ, hμ⟩ := ENat.ne_top_iff_exists.mp (fun htop => hgood_ne g hg
      ((Ideal.ordElem_eq_top_iff_eq_zero hQtop).mp htop))
    exact ⟨μ, hμ.symm⟩
  -- "Then we have `ν + n ≥ μ ≥ ν`" (p. 191, not argued in the paper)
  have hgap : ∀ g, Good g → ∀ μ : ℕ, Ideal.ordElem Q g = μ → ν ≤ μ ∧ μ ≤ ν + n := by
    intro g hg μ hμ
    obtain ⟨-, hgP, hgeq⟩ := hg
    refine ⟨?_, ?_⟩
    · have := Ideal.le_ordElem (Ideal.pow_right_mono hPQ ν hgP)
      rw [hμ] at this
      exact_mod_cast this
    · by_contra hlt
      have hlt' : ν + (n + 1) ≤ μ := by omega
      have hgQ : g ∈ Q ^ (ν + (n + 1)) :=
        Ideal.pow_le_pow_right hlt' (Ideal.mem_pow_of_ordElem hμ)
      have hmul : g ∈ P ^ ν * Q ^ (n + 1) := inf_pow_add_le_mul P Q (Ideal.span (Set.range y))
        S.hQ S.hind ν (n + 1) ⟨hgP, hgQ⟩
      rw [mul_comm] at hmul
      have h1 : zFormHom P z S.hzP Ψ ∈ (Q.map (algebraMap R (AssocGraded P))) ^ (n + 1) := by
        rw [← hgeq, ← Ideal.map_pow]
        exact mk_mem_map_of_mem_mul P (Q ^ (n + 1)) hmul hgP
      exact hmax fun w => (S.zFormHom_mem_pow_iff (n + 1) Ψ).mp h1 w
  -- "Thus we could choose `g` in such a way that `ν + n = μ`"
  have hchoose : ∃ g, Good g ∧ Ideal.ordElem Q g = ((ν + n : ℕ) : ℕ∞) := by
    suffices H : ∀ d : ℕ, ∀ g, Good g → ∀ μ : ℕ, Ideal.ordElem Q g = μ → ν + n - μ ≤ d →
        ∃ g, Good g ∧ Ideal.ordElem Q g = ((ν + n : ℕ) : ℕ∞) from by
      obtain ⟨g, hg⟩ : ∃ g, Good g := ⟨g₀, hg₀J, hg₀P, hg₀eq⟩
      obtain ⟨μ, hμ⟩ := hgood_order g hg
      exact H _ g hg μ hμ le_rfl
    intro d
    induction d with
    | zero =>
      intro g hg μ hμ hd
      have := hgap g hg μ hμ
      exact ⟨g, hg, by rw [hμ]; congr 1; omega⟩
    | succ d ih =>
      intro g hg μ hμ hd
      by_cases hμν : μ = ν + n
      · exact ⟨g, hg, by rw [hμ, hμν]⟩
      have hμlt : μ < ν + n := lt_of_le_of_ne (hgap g hg μ hμ).2 hμν
      obtain ⟨hgJ, hgP, hgeq⟩ := hg
      have hgQ : g ∈ Q ^ μ := Ideal.mem_pow_of_ordElem hμ
      -- `ν + n > μ`: `g ∈ QⁿPᵛ + Pᵛ⁺¹` (the class of `g` in `grᵛ_P(R)` is `Ψ ∈ Q̄ⁿgr_P(R)`)
      obtain ⟨a', ha'mul, ha'P, ha'eq⟩ := exists_mem_mul_of_mem_map P (Q ^ n)
        (by rw [Ideal.map_pow]; exact hΨQn) ν
      have hga' : g - a' ∈ P ^ (ν + 1) := by
        have h1 : grProj P ν (zFormHom P z S.hzP Ψ) = Submodule.Quotient.mk ⟨g, hgP⟩ := by
          rw [← hgeq]
          exact grProj_mk_same P ν g hgP
        rw [h1, Submodule.Quotient.eq] at ha'eq
        have h3 : a' - g ∈ P ^ (ν + 1) := ha'eq
        have h2 : g - a' = -(a' - g) := by ring
        rw [h2]
        exact neg_mem h3
      have ha'Q : a' ∈ Q ^ (μ + 1) := by
        have h1 : Q ^ n * P ^ ν ≤ Q ^ (μ + 1) :=
          calc Q ^ n * P ^ ν ≤ Q ^ n * Q ^ ν :=
                Ideal.mul_mono_right (Ideal.pow_right_mono hPQ ν)
            _ = Q ^ (n + ν) := (pow_add Q n ν).symm
            _ ≤ Q ^ (μ + 1) := Ideal.pow_le_pow_right (by omega)
        exact h1 ha'mul
      -- "`ψ` … the initial form of `g` in `gr_Q(J, R)`" is that of `p = g - a' ∈ Pᵛ⁺¹ ∩ Qᵘ`, so
      -- "`ψ ∈ (Z₁, …, Z_r)^{ν+1} K[Z, Y]`" and "`ν_P(h) ≥ ν + 1`"
      have hpQ : g - a' ∈ Q ^ μ :=
        sub_mem hgQ (Ideal.pow_le_pow_right (Nat.le_succ μ) ha'Q)
      have hpgr : AssocGraded.mk Q μ (g - a') hpQ ∈ grIdeal Q J := by
        have := mk_mem_grIdeal Q hgJ hgQ
        rwa [← mk_eq_mk_of_sub_mem_pow_succ Q hpQ hgQ (by
          have h2 : g - a' - g = -a' := by ring
          rw [h2]
          exact neg_mem ha'Q)] at this
      obtain ⟨h, hhJ, hhP, hph, -⟩ := S.exists_sub_mem_pow_succ J f hfJ h₁ h₂ hga' hpQ hpgr
      -- "`g` and `g - h` have the same initial form `Ψ` in `gr_P(R)`, while `ν_Q(g - h) > μ`"
      have hgP' : g - h ∈ P ^ ν :=
        sub_mem hgP (Ideal.pow_le_pow_right (Nat.le_succ ν) hhP)
      have hgQ' : g - h ∈ Q ^ (μ + 1) := by
        have h2 : g - h = a' + (g - a' - h) := by ring
        rw [h2]
        exact add_mem ha'Q hph
      have hgood' : Good (g - h) := ⟨sub_mem hgJ hhJ, hgP', by
        rw [← hgeq]
        refine mk_eq_mk_of_sub_mem P hgP' hgP ?_
        have h2 : g - h - g = -h := by ring
        rw [h2]
        exact neg_mem hhP⟩
      obtain ⟨μ', hμ'⟩ := hgood_order _ hgood'
      have hμ'ge : μ + 1 ≤ μ' := by
        have := Ideal.le_ordElem hgQ'
        rw [hμ'] at this
        exact_mod_cast this
      exact ih (g - h) hgood' μ' hμ' (by omega)
  obtain ⟨g, ⟨hgJ, hgP, hgeq⟩, hgord⟩ := hchoose
  have hgQ : g ∈ Q ^ (ν + n) := Ideal.mem_pow_of_ordElem hgord
  -- "Let us then consider the case in which `ν + n = μ`": the form `ψ₀`
  have hψ0 : S.psiZero n Ψ ≠ 0 := fun h0 => hmax ((S.psiZero_eq_zero_iff hcoef).mp h0)
  have hpartial := S.zDegreePart_coord_mk_eq_psiZero hΨ hcoef hgP hgQ hgeq.symm
  -- the element `h` built from `ψ`
  obtain ⟨h, hhJ, hhP, hgh, hhE⟩ :=
    S.exists_sub_mem_pow_succ J f hfJ h₁ h₂ hgP hgQ (mk_mem_grIdeal Q hgJ hgQ)
  have hhE' := hhE (by omega)
  rw [show ν + n - ν = n by omega] at hhE'
  -- "Hence we must have `ν_P(h) = ν`"
  have hhν : h ∉ P ^ (ν + 1) := by
    intro hh1
    have hhQ : h ∈ Q ^ (ν + n) := by
      have h2 : h = g - (g - h) := by ring
      rw [h2]
      exact sub_mem hgQ (Ideal.pow_le_pow_right (Nat.le_succ _) hgh)
    have hmk : AssocGraded.mk Q (ν + n) g hgQ = AssocGraded.mk Q (ν + n) h hhQ :=
      mk_eq_mk_of_sub_mem_pow_succ Q hgQ hhQ hgh
    rw [hmk, S.zDegreePart_coord_mk_eq_zero hh1 hhQ] at hpartial
    exact hψ0 hpartial.symm
  -- "`Ψ*` … is contained in `Q̄ⁿH`"
  obtain ⟨Ψh, hΨh, hεΨh⟩ := S.exists_isHomogeneous_zFormHom_eq hhP
  have hhmem := mk_mem_mul_span_of_mem_sup P Q hPtop f h₁ n ν hhP hhE'
  have hΨhcoef : ∀ w, Ψh.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ n := by
    refine (S.zFormHom_mem_pow_iff n Ψh).mp ?_
    rw [hεΨh]
    exact Ideal.mul_le_left hhmem
  -- "`Ψ - Ψ* ∈ Q̄ⁿ⁺¹R̄[Z]`, because we know that `ψ` is the initial form of `h` as well as that of `g`"
  have hghP : g - h ∈ P ^ ν := sub_mem hgP hhP
  have hghQ : g - h ∈ Q ^ (ν + n) := Ideal.pow_le_pow_right (Nat.le_succ _) hgh
  have hεΘ : zFormHom P z S.hzP (Ψ - Ψh) = AssocGraded.mk P ν (g - h) hghP := by
    rw [map_sub, hεΨh, ← hgeq, mk_sub_mk hgP hhP]
  have hΘcoef : ∀ w, (Ψ - Ψh).coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ n := fun w => by
    rw [MvPolynomial.coeff_sub]
    exact sub_mem (hcoef w) (hΨhcoef w)
  have hpartialΘ := S.zDegreePart_coord_mk_eq_psiZero (hΨ.sub hΨh) hΘcoef hghP hghQ hεΘ
  have hzero : AssocGraded.mk Q (ν + n) (g - h) hghQ = 0 :=
    (AssocGraded.mk_eq_zero_iff Q hghQ).mpr hgh
  rw [hzero, map_zero, zDegreePart_zero] at hpartialΘ
  have hΘ1 := (S.psiZero_eq_zero_iff hΘcoef).mp hpartialΘ.symm
  refine ⟨h, hhP, hhν, hhmem, ?_⟩
  have := (S.zFormHom_mem_pow_iff (n + 1) (Ψ - Ψh)).mpr hΘ1
  rwa [map_sub, hεΨh] at this

end Lemma7Key

section Lemma7Iterate

open MvPolynomial

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {P Q : Ideal R}
  {κ ι : Type*} {y : κ → R} {z : ι → R} (S : Lemma7Setup P Q y z) (J : Ideal R) {m : ℕ}
  (f : Fin m → R) (hfJ : ∀ j, f j ∈ J) (h₁ : ∀ j, Ideal.ordElem Q (f j) = Ideal.ordElem P (f j))
  (h₂ : Ideal.span (Set.range fun j => initialForm Q (f j)) = grIdeal Q J)

include S hfJ h₁ h₂ in
/-- **The end of the proof of Lemma 7** (p. 193), in each homogeneous part of `gr_P(R) = R̄[Z]`:
"`Q̄ⁿR̄[Z] ∩ gr_P(J, R) ⊆ Q̄ⁿH + Q̄ⁿ⁺¹R̄[Z]` for every non-negative integer `n`.  This implies
immediately that `Q̄ⁿR̄[Z] ∩ gr_P(J, R) ⊆ Q̄ⁿH + Q̄ⁿ⁺ᵉR̄[Z]` for every non-negative integer `n` and all
positive integers `e`.  Applying Nakayama's lemma to each homogeneous part of
`gr_P(R) = R̄[Z]`, which is an `R̄`-module of finite type, we obtain `Q̄ⁿR̄[Z] ∩ gr_P(J, R) ⊆ Q̄ⁿH`."

For a homogeneous element of degree `ν` (an element `x` of the homogeneous part `grᵛ_P(R) = Pᵛ/Pᵛ⁺¹`,
a finite `R`-module): the step `Q̄ⁿ ↦ Q̄ⁿ⁺¹` is `Lemma7Setup.exists_mk_mem_mul_span_sub_mem`; the
iteration to `Q̄ⁿ⁺ᵉ` is an induction on `e`; and the last step is Nakayama's lemma for the finite
`R`-module `M = Q̄ⁿN ∩ gr_P(J, R)_ν` (`N = grᵛ_P(R)`): `M ⊆ Q̄ⁿH + Q̄ M`, hence `M ⊆ Q̄ⁿH`.

Gap filled (the one sub-step that is not Nakayama's lemma): from `M ⊆ Q̄ⁿH + Q̄ⁿ⁺ᵉN` for all `e` one gets
`M ⊆ Q̄ⁿH + Q̄ M` by the **Artin–Rees lemma** (`Ideal.exists_pow_inf_eq_pow_smul`) applied to
`gr_P(J, R)_ν ⊆ N`: for `n ≥ c`, `Q̄ⁿ⁺¹N ∩ gr_P(J, R)_ν = Q̄ (Q̄ⁿN ∩ gr_P(J, R)_ν)`.  This is needed
because `Q̄ⁿ⁺ᵉN` is a submodule of `N`, not of `M`, and Nakayama's lemma alone says nothing about it
(Artin–Rees is also the input of Krull's intersection theorem, the usual form of the paper's
"Nakayama").  For `n < c` one iterates up to `c` first. -/
theorem Lemma7Setup.ofGrPiece_mem_mul_span_of_mem_inf (hPtop : P ≠ ⊤) (hQtop : Q ≠ ⊤)
    (n ν : ℕ) (x : GrPiece P ν)
    (hQ : AssocGraded.ofGrPiece P ν x ∈ (Q.map (algebraMap R (AssocGraded P))) ^ n)
    (hJ : AssocGraded.ofGrPiece P ν x ∈ grIdeal P J) :
    AssocGraded.ofGrPiece P ν x ∈ (Q.map (algebraMap R (AssocGraded P))) ^ n *
      Ideal.span (Set.range fun j => initialForm P (f j)) := by
  classical
  set Qb : ℕ → Ideal (AssocGraded P) := fun k => (Q.map (algebraMap R (AssocGraded P))) ^ k
    with hQb
  set H : Ideal (AssocGraded P) := Ideal.span (Set.range fun j => initialForm P (f j)) with hH
  let ι' : GrPiece P ν →ₗ[R] AssocGraded P := (AssocGraded.ofGrPiece P ν).restrictScalars R
  have hι' : ∀ t, ι' t = AssocGraded.ofGrPiece P ν t := fun t => rfl
  have hH_le : H ≤ grIdeal P J := Ideal.span_le.mpr (by
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span (Set.mem_image_of_mem _ (hfJ j)))
  -- the step `Q̄ⁿ ↦ Q̄ⁿ⁺¹` (p. 191--193): "`Q̄ⁿR̄[Z] ∩ gr_P(J, R) ⊆ Q̄ⁿH + Q̄ⁿ⁺¹R̄[Z]`"
  have step : ∀ n (t : GrPiece P ν), ι' t ∈ Qb n → ι' t ∈ grIdeal P J →
      ∃ t' : GrPiece P ν, ι' t' ∈ Qb n * H ∧ ι' t - ι' t' ∈ Qb (n + 1) := by
    intro n t htQ htJ
    by_cases hmem : ι' t ∈ Qb (n + 1)
    · exact ⟨0, by rw [map_zero]; exact zero_mem _, by rw [map_zero, sub_zero]; exact hmem⟩
    induction t using Submodule.Quotient.induction_on with
    | H a =>
      obtain ⟨Ψ, hΨ, hεΨ⟩ := S.exists_isHomogeneous_zFormHom_eq a.2
      have hεΨ' : zFormHom P z S.hzP Ψ = ι' (Submodule.Quotient.mk a) := hεΨ
      have hcoef : ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ n :=
        (S.zFormHom_mem_pow_iff n Ψ).mp (hεΨ' ▸ htQ)
      have hmax : ¬ ∀ w, Ψ.coeff w ∈ (Q.map (Ideal.Quotient.mk P)) ^ (n + 1) := fun hall =>
        hmem (hεΨ' ▸ (S.zFormHom_mem_pow_iff (n + 1) Ψ).mpr hall)
      obtain ⟨h, hhP, -, hhmem, hdiff⟩ := S.exists_mk_mem_mul_span_sub_mem J f hfJ h₁ h₂ hPtop
        hQtop hΨ hcoef hmax (hεΨ' ▸ htJ)
      refine ⟨Submodule.Quotient.mk ⟨h, hhP⟩, hhmem, ?_⟩
      rw [← hεΨ']
      exact hdiff
  -- the homogeneous part of degree `ν` of `Q̄ᵏH` and of `Q̄ᵏ gr_P(R)`
  let E : ℕ → Submodule R (GrPiece P ν) := fun k =>
    Submodule.comap ι' ((Qb k * H).restrictScalars R)
  let T : ℕ → Submodule R (GrPiece P ν) := fun k =>
    Submodule.comap ι' ((Qb k).restrictScalars R)
  have hEmono : ∀ k, E (k + 1) ≤ E k := fun k t ht =>
    Ideal.mul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ k)) ht
  have hTmono : ∀ k l, k ≤ l → T l ≤ T k := fun k l hkl t ht =>
    Ideal.pow_le_pow_right hkl ht
  -- "This implies immediately that `Q̄ⁿR̄[Z] ∩ gr_P(J, R) ⊆ Q̄ⁿH + Q̄ⁿ⁺ᵉR̄[Z]`"
  have iter : ∀ e n (t : GrPiece P ν), ι' t ∈ Qb n → ι' t ∈ grIdeal P J → t ∈ E n ⊔ T (n + e) := by
    intro e
    induction e with
    | zero =>
      intro n t htQ _
      exact Submodule.mem_sup_right htQ
    | succ e ih =>
      intro n t htQ htJ
      obtain ⟨t', ht'1, ht'2⟩ := step n t htQ htJ
      have ht'J : ι' t' ∈ grIdeal P J := hH_le (Ideal.mul_le_right ht'1)
      have := ih (n + 1) (t - t') (by rw [map_sub]; exact ht'2) (by
        rw [map_sub]; exact sub_mem htJ ht'J)
      obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp this
      refine Submodule.mem_sup.mpr ⟨t' + u, add_mem ht'1 (hEmono n hu), v, ?_, ?_⟩
      · exact hTmono (n + (e + 1)) (n + 1 + e) (by omega) hv
      · calc t' + u + v = t' + (u + v) := by abel
          _ = t' + (t - t') := by rw [huv]
          _ = t := by abel
  -- "Applying Nakayama's lemma to each homogeneous part of `gr_P(R) = R̄[Z]`, which is an `R̄`-module
  -- of finite type": the homogeneous part `grᵛ_P(R)` is a finite `R`-module, `Qᵏ`-multiples:
  have hT : ∀ k (t : GrPiece P ν), ι' t ∈ Qb k → t ∈ Q ^ k • (⊤ : Submodule R (GrPiece P ν)) := by
    intro k t ht
    have h1 : ι' t ∈ (Q ^ k • ⊤ : Submodule R (AssocGraded P)) := by
      rw [Ideal.smul_top_eq_map]
      show ι' t ∈ (Q ^ k).map (algebraMap R (AssocGraded P))
      rw [Ideal.map_pow]
      exact ht
    have h2 := Submodule.mem_map_of_mem (f := grProjA P ν) h1
    rw [Submodule.map_smul''] at h2
    have h3 : grProjA P ν (ι' t) = t := grProj_ofGrPiece_same P ν t
    rw [h3] at h2
    exact Submodule.smul_mono le_rfl le_top h2
  have hT' : ∀ k (t : GrPiece P ν), t ∈ Q ^ k • (⊤ : Submodule R (GrPiece P ν)) → ι' t ∈ Qb k := by
    intro k t ht
    refine Submodule.smul_induction_on ht (fun q hq u _ => ?_) (fun a b ha hb => by
      rw [map_add]
      exact add_mem ha hb)
    rw [map_smul, Algebra.smul_def]
    refine Ideal.mul_mem_right _ _ ?_
    show algebraMap R (AssocGraded P) q ∈ (Q.map (algebraMap R (AssocGraded P))) ^ k
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hq
  let G : Submodule R (GrPiece P ν) := Submodule.comap ι' ((grIdeal P J).restrictScalars R)
  have hEG : ∀ k, E k ≤ G := fun k t ht => hH_le (Ideal.mul_le_right ht)
  have hEanti : Antitone E := antitone_nat_of_succ_le hEmono
  -- the Artin–Rees lemma for `gr_P(J, R)_ν ⊆ grᵛ_P(R)`: `Qⁿ⁺¹N ∩ G = Q (QⁿN ∩ G)` for `n ≥ c`
  obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul Q G
  have hAR : ∀ n, c ≤ n → Q ^ (n + 1) • (⊤ : Submodule R (GrPiece P ν)) ⊓ G =
      Q • (Q ^ n • (⊤ : Submodule R (GrPiece P ν)) ⊓ G) := by
    intro n hn
    rw [hc (n + 1) (by omega), hc n hn, show n + 1 - c = (n - c) + 1 by omega, pow_succ' Q (n - c),
      ← smul_smul]
  have hjac : Q ≤ Ideal.jacobson ⊥ :=
    (IsLocalRing.le_maximalIdeal hQtop).trans (IsLocalRing.maximalIdeal_le_jacobson _)
  -- for `n ≥ c`: Nakayama's lemma for the finite `R`-module `M = QⁿN ∩ G`
  -- (`Q̄ⁿR̄[Z] ∩ gr_P(J, R)` in degree `ν`), `M ⊆ Q̄ⁿH + Q̄ M`
  have hNak : ∀ n, c ≤ n → ∀ t : GrPiece P ν, t ∈ Q ^ n • (⊤ : Submodule R (GrPiece P ν)) →
      t ∈ G → t ∈ E n := by
    intro n hn
    have hle : (Q ^ n • (⊤ : Submodule R (GrPiece P ν)) ⊓ G) ≤
        E n ⊔ Q • (Q ^ n • (⊤ : Submodule R (GrPiece P ν)) ⊓ G) := by
      intro x hx
      obtain ⟨hxT, hxG⟩ := hx
      obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp (iter 1 n x (hT' n x hxT) hxG)
      have hvG : v ∈ G := by
        have : v = x - u := by rw [← huv]; abel
        rw [this]
        exact sub_mem hxG (hEG n hu)
      have hvAR : v ∈ Q • (Q ^ n • (⊤ : Submodule R (GrPiece P ν)) ⊓ G) := by
        rw [← hAR n hn]
        exact ⟨hT (n + 1) v hv, hvG⟩
      exact Submodule.mem_sup.mpr ⟨u, hu, v, hvAR, huv⟩
    intro t ht htG
    exact Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _) hjac hle
      ⟨ht, htG⟩
  -- for `n < c`: `x ∈ Eₙ + Q̄^c N ∩ G` and `Q̄^c N ∩ G ⊆ E_c ⊆ Eₙ`
  have hxE : x ∈ E n := by
    by_cases hcn : c ≤ n
    · exact hNak n hcn x (hT n x hQ) hJ
    · obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp (iter (c - n) n x hQ hJ)
      rw [show n + (c - n) = c by omega] at hv
      have hvG : v ∈ G := by
        have : v = x - u := by rw [← huv]; abel
        rw [this]
        exact sub_mem hJ (hEG n hu)
      have hvE : v ∈ E c := hNak c le_rfl v (hT c v hv) hvG
      rw [← huv]
      exact add_mem hu (hEanti (by omega : n ≤ c) hvE)
  exact hxE

end Lemma7Iterate

end Lemma7Proof

section Lemma7Theorem

variable {R : Type u} [CommRing R] [IsRegularLocalRing R] (J P Q : Ideal R) [P.IsPrime]
  [Q.IsPrime] [IsRegularLocalRing (R ⧸ P)] [IsRegularLocalRing (R ⧸ Q)]

/-- Lemma 7, pp. 190–191: "Let `R` be a regular local ring, `J` an ideal in `R`, and `P`, `Q`
prime ideals such that `Q ⊇ P ⊇ J`, and that `R/P` and `R/Q` are both regular. Let `R̄ = R/P`
and `Q̄ = Q/P`. Suppose we have a system of elements `(f₁, …, f_m)` of `J` such that
(i) `ν_Q(f_j) = ν_P(f_j)` for `1 ≤ j ≤ m`; (ii) if `φ_j` denotes the initial form of `f_j` in
`gr_Q(R)`, then `gr_Q(J, R) = (φ₁, …, φ_m) gr_Q(R)`. Let `Φ_j` be the initial form of `f_j` in
`gr_P(R)` and `H = (Φ₁, …, Φ_m) gr_P(R)`. Then we have `Q̄ⁿ gr_P(R) ∩ gr_P(J, R) = Q̄ⁿ H` for all
non-negative integers `n`. In particular, we have `gr_P(J, R) = (Φ₁, …, Φ_m) gr_P(R)`."

Here `Q̄ gr_P(R)` is the ideal `Q.map (algebraMap R (AssocGraded P))` of `gr_P(R)` generated by
the image of `Q` (it equals `Q̄ gr_P(R)`, `P` acting as `0`), `Q̄ⁿ gr_P(R)` is its `n`-th power
and `Q̄ⁿ H` is the product of ideals.

The proof follows the paper's, pp. 191–193, step by step (the blueprint node quotes it):
* "Let us choose a regular system of parameters `(z₁, …, z_r, y₁, …, y_s, x₁, …, x_t)` of `R` such
  that `P = (z₁, …, z_r)R` and `Q = (z₁, …, z_r, y₁, …, y_s)R`" (footnote 41: "cf. footnote 39")
  is `exists_isRegularSystemOfParameters_span_eq_of_le` (`Compat/RegularQuotientGenerators.lean`);
  `exists_lemma7Setup` packages the data used afterwards (`Lemma7Setup`: the families `y`, `z`, the
  quasi-regularity of `z` and of `(y, z)`, the independence of the bidegree components).
  "We can identify `gr_P(R)` with the polynomial ring `R̄[Z]`" is `Lemma7Setup.zFormHom_bijective`;
  "we can identify `gr_Q(R)` with the polynomial ring `K[Z, Y]`" is `yzFormHom_bijective`
  (`Lemma7Setup.coord`), with `K[Z, Y]` written as `((R/Q)[Z])[Y]` so that the decomposition
  `ψ = Σ_α T_α(Y) ξ_α(Z)` of p. 191 is `MvPolynomial.coeff`.  "If `ȳ_i` denotes the residue class of
  `y_i` in `R̄ = R/P` and `x̄_j` that of `x_j`, then `(ȳ₁, …, ȳ_s, x̄₁, …, x̄_t)` is a regular system of
  parameters of `R̄` and `Q̄ = (ȳ₁, …, ȳ_s)R̄`" is `isRegularSystemOfParameters_image_quotient` and
  `Lemma7Setup.span_map_y`; "we can identify `gr_Q̄(R̄)` with `K[Y]`" is `Lemma7Setup.grQuotEquiv`
  and `Lemma7Setup.grQuotCoord`.
* "By (i), the `φ_j` are all forms only in `Z`", "`ξ_α(Z) ∈ (φ₁, …, φ_m)K[Z]`", the forms
  `ζ_{α β}`, the elements `h_{α,β}`, `h = Σ_α (T_α(y) Σ_β h_{α,β} f_β)`, "`ν_Q(g - h) > μ`" and
  "`ν_P(h) ≥ ν + 1`" are `exists_mem_sup_of_mem_inf_pow` (`Lemma7Setup.exists_sub_mem_pow_succ`;
  with `exists_coeff_isHomogeneous_of_mem_inf_pow`, `exists_isHomogeneous_mul_eq_sum`,
  `exists_isHomogeneous_map_eq`, `yzFormHom_monomial_map_eq_mk`).
* "We may assume that `n` is the largest integer such that `Ψ ∈ Q̄ⁿR̄[Z]`", "Let `ν = deg Ψ`.
  We have an element `g ∈ J` such that `Ψ` is the initial form of `g` in `gr_P(R) = R̄[Z]`.  Let
  `μ = ν_Q(g)`.  Then we have `ν + n ≥ μ ≥ ν`", the cases `ν + n > μ` and `ν + n = μ`, "Thus we could choose `g` in such a
  way that `ν + n = μ`", "`ψ₀` is the partial sum of the form `ψ` …", "`ψ₀` is different from
  zero", "hence we must have `ν_P(h) = ν`", "`Ψ - Ψ* ∈ Q̄ⁿ⁺¹R̄[Z]`" and "`Ψ*` is contained in `Q̄ⁿH`"
  are `Lemma7Setup.exists_mk_mem_mul_span_sub_mem` (with `Lemma7Setup.psiZero`,
  `Lemma7Setup.zDegreePart_coord_mk_eq_psiZero`, `Lemma7Setup.psiZero_eq_zero_iff`,
  `mk_mem_mul_span_of_mem_sup`).
* "`Q̄ⁿR̄[Z] ∩ gr_P(J, R) ⊆ Q̄ⁿH + Q̄ⁿ⁺ᵉR̄[Z]`" and "Applying Nakayama's lemma to each
  homogeneous part of `gr_P(R)`" are `Lemma7Setup.ofGrPiece_mem_mul_span_of_mem_inf`.
* "Obviously, we may assume that `Ψ` is homogeneous" (the homogeneous components of an element of
  `Q̄ⁿ gr_P(R) ∩ gr_P(J, R)`) and the reverse inclusion are in the body of the theorem.

Gaps of the paper filled: the existence of the decomposition of `gr_Q(R)` into the bidegree
components `Z`-degree `a`, `Y`-degree `μ - a` and its compatibility with the `P`-adic filtration
(`exists_coeff_isHomogeneous_of_mem_inf_pow`, from `inf_pow_le_sum`, i.e. from the quasi-regularity
of `(y, z)`); "`ξ_α(Z) ∈ (φ)K[Z]` for all `α`" (coefficients of `ψ` in the ideal generated by the
constants `φ_j`); the homogeneous components `ζ_{α β}` and their lifts `h_{α β}`; "`ν + n ≥ μ`"
(`inf_pow_add_le_mul`: `Pᵛ ∩ Qᵛ⁺ᵏ = Pᵛ Qᵏ`); the identification `gr_Q̄(R̄) = K[Y]`,
`Y_j ↔ [ȳ_j]`: that `(ȳ, x̄)` is a regular system of parameters of `R̄` is
`isRegularSystemOfParameters_image_quotient` (the dimension count of footnote 41), and then
`Lemma7Setup.grQuotEquiv` is `thm:regular-graded-polynomial` for `R̄`, `Q̄ = (ȳ)`; "`ψ₀` is the partial sum of
the form `ψ` consisting of those terms which are exactly of degree `ν` in `Z`"
(`Lemma7Setup.zDegreePart_coord_mk_eq_psiZero`); the termination of "we could choose `g`" (induction on
`ν + n - ν_Q(g)`); and the Artin–Rees lemma, the input of Nakayama's lemma applied to the finite
`R`-module `M = Q̄ⁿ grᵛ_P(R) ∩ gr_P(J, R)_ν`.

Differences from the printed text that remain: none in the route.  The paper's "Nakayama's lemma"
is Nakayama's lemma for `M` together with the Artin–Rees lemma (see above).  The hypothesis
`J ⊆ P` is not used (the printed proof does not use it either). -/
@[blueprint "lem:II.2-7"
  (statement := /-- Let $R$ be a regular local ring, $J$ an ideal in $R$, and $P$, $Q$ prime
    ideals such that $Q\supseteq P\supseteq J$, and that $R/P$ and $R/Q$ are both regular. Let
    $\bar R=R/P$ and $\bar Q=Q/P$. Suppose we have a system of elements $(f_1,\dots,f_m)$ of
    $J$ such that (i) $\nu_Q(f_j)=\nu_P(f_j)$ for $1\le j\le m$ (\cref{def:II.2-order-element});
    (ii) if $\varphi_j$ denotes the initial form of $f_j$ in $\operatorname{gr}_Q(R)$, then
    $\operatorname{gr}_Q(J,R)=(\varphi_1,\dots,\varphi_m)\operatorname{gr}_Q(R)$. Let $\Phi_j$
    be the initial form of $f_j$ in $\operatorname{gr}_P(R)$ and
    $H=(\Phi_1,\dots,\Phi_m)\operatorname{gr}_P(R)$. Then we have
    $\bar Q^n\operatorname{gr}_P(R)\cap\operatorname{gr}_P(J,R)=\bar Q^nH$ for all
    non-negative integers $n$. In particular, we have $\operatorname{gr}_P(J,R)=(\Phi_1,\dots,
    \Phi_m)\operatorname{gr}_P(R)$. (Lemma 7, pp.~190--191.) -/)
  (proof := /-- (pp.~191--193.) Choose a regular system of parameters
    $(z_1,\dots,z_r,y_1,\dots,y_s,x_1,\dots,x_t)$ of $R$ such that $P=(z_1,\dots,z_r)R$ and
    $Q=(z_1,\dots,z_r,y_1,\dots,y_s)R$, where $t=\dim R/Q$, $s+t=\dim R/P$ and
    $r+s+t=\dim R$ (footnote 41: ``cf.\ footnote 39''). Identify $\operatorname{gr}_P(R)$ with
    the polynomial ring $\bar R[Z]=\bar R[Z_1,\dots,Z_r]$, $Z_i\leftrightarrow$ class of $z_i$,
    and, with $K$ the regular local ring $R/Q=\bar R/\bar Q$, identify
    $\operatorname{gr}_Q(R)$ with $K[Z,Y]=K[Z_1,\dots,Z_r,Y_1,\dots,Y_s]$. By (i) the
    $\varphi_j$ are forms only in $Z_1,\dots,Z_r$. One proves $\bar Q^n\bar R[Z]\cap
    \operatorname{gr}_P(J,R)\subseteq\bar Q^nH+\bar Q^{n+1}\bar R[Z]$ for every $n\ge0$: let
    $\Psi$ be an element of the left side; one may assume that $n$ is the largest integer with
    $\Psi\in\bar Q^n\bar R[Z]$ and that $\Psi$ is homogeneous, of degree $\nu$; let $g\in J$
    have initial form $\Psi$ in $\operatorname{gr}_P(R)$ and $\mu=\nu_Q(g)$. ``Then we have
    $\nu+n\geqq\mu\geqq\nu$.'' Write the initial form $\psi$ of $g$ in $K[Z,Y]$ as
    $\psi=\sum_\alpha T_\alpha(Y)\xi_\alpha(Z)$ with distinct monomials $T_\alpha$ of degree
    $d_\alpha$ and forms $\xi_\alpha(Z)$ of degree $\mu-d_\alpha$; by (ii),
    $\xi_\alpha(Z)=\sum_\beta\zeta_{\alpha\beta}(Z)\varphi_\beta(Z)$ with forms
    $\zeta_{\alpha\beta}$ of degree $\mu-d_\alpha-\nu_\beta\ge0$, $\nu_\beta=\deg\varphi_\beta=
    \nu_Q(f_\beta)$. Taking $h_{\alpha\beta}\in(z_1,\dots,z_r)^{\mu-d_\alpha-\nu_\beta}R$ with
    initial form $\zeta_{\alpha\beta}(Z)$ in $K[Z,Y]$ and the monomials $T_\alpha(y)$, put
    $h=\sum_\alpha T_\alpha(y)\sum_\beta h_{\alpha\beta}f_\beta$; then $\nu_Q(h)=\mu$, $h$
    and $g$ have the same initial form $\psi$ in $K[Z,Y]$, so $\nu_Q(g-h)>\mu$. If $\nu+n>\mu$,
    then $\psi\in(Z_1,\dots,Z_r)^{\nu+1}K[Z,Y]$ (as $g\in Q^nP^\nu+P^{\nu+1}$), so
    $\nu_P(h)\ge\nu+1$ and $g-h$ has the same initial form $\Psi$ in $\operatorname{gr}_P(R)$
    with larger $\nu_Q$; hence $g$ may be chosen with $\nu+n=\mu$. Then, identifying
    $\operatorname{gr}_{\bar Q}(\bar R)$ with $K[Y]$, the form $\psi_0$ obtained by replacing
    the coefficients in $\bar Q$ of $\Psi$ by their images in $\operatorname{gr}^n_{\bar Q}
    (\bar R)$ is the partial sum of $\psi$ of the terms of degree exactly $\nu$ in $Z$, and
    $\psi_0\ne0$ since $n$ is maximal; hence $\nu_P(h)=\nu$ and, for the initial form $\Psi^*$
    of $h$ in $\operatorname{gr}_P(R)$, $\Psi-\Psi^*\in\bar Q^{n+1}\bar R[Z]$, while by the
    shape of $h$, $\Psi^*=\sum^*_\alpha T_\alpha(\bar y)\sum_\beta\zeta^*_{\alpha\beta}(Z)
    \Phi_\beta(Z)\in\bar Q^nH$ (sum over the $\alpha$ with $d_\alpha=n$). This gives the
    inclusion, hence $\bar Q^n\bar R[Z]\cap\operatorname{gr}_P(J,R)\subseteq\bar Q^nH+
    \bar Q^{n+e}\bar R[Z]$ for all $e\ge1$, and Nakayama's lemma applied to each homogeneous
    part of $\bar R[Z]$ (a module of finite type) yields $\bar Q^n\bar R[Z]\cap
    \operatorname{gr}_P(J,R)\subseteq\bar Q^nH$; the reverse inclusion is obvious. The case
    $n=0$ is the last assertion.

    \textbf{Paper misprint.} On p.~192 the paper prints
    ``$h_{\alpha,\beta}\in(z_1,\cdots,z^r)^{\mu-d_x-\nu_\beta}R$''; meant is
    $(z_1,\dots,z_r)^{\mu-d_\alpha-\nu_\beta}R$.

    \textbf{Lean.} The Lean proof follows this text. The regular system of parameters of
    footnote~41 is \cref{fn:II.2-41} (the $x_i$ are not needed afterwards); the identifications
    $\operatorname{gr}_P(R)=\bar R[Z]$ ($Z_i\mapsto[z_i]$) and $\operatorname{gr}_Q(R)=K[Z,Y]$
    ($Z_i\mapsto[z_i]$, $Y_j\mapsto[y_j]$) are isomorphisms, the second written as $(K[Z])[Y]$ so
    that the decomposition $\psi=\sum_\alpha T_\alpha(Y)\xi_\alpha(Z)$ is the decomposition into
    the coefficients of the monomials in $Y$; $(\bar y,\bar x)$ is a regular system of parameters of
    $\bar R$ (the dimension count of \cref{fn:II.2-41}) and $\bar Q=(\bar y)\bar R$, so $\bar y$ is
    quasi-regular and $\operatorname{gr}_{\bar Q}(\bar R)=K[Y]$
    (\cref{thm:regular-graded-polynomial}); the map $\operatorname{gr}_Q(R)\to
    \operatorname{gr}_{\bar Q}(\bar R)$ of Lemma~5 is then $Z=0$ on $K[Z,Y]$. The $\varphi_j$ are
    forms in $Z$ by
    (i), $\xi_\alpha\in(\varphi_1,\dots,\varphi_m)K[Z]$ because the $Y$-coefficient of an
    element of $(\varphi_1,\dots,\varphi_m)K[Z][Y]$ lies in $(\varphi_1,\dots,\varphi_m)K[Z]$, and
    the $\zeta_{\alpha\beta}$ are the homogeneous components of the coefficients. The elements
    $h_{\alpha\beta}$ are the values at $z$ of lifts of the $\zeta_{\alpha\beta}$ to forms over
    $R$. $\Psi\in\bar R[Z]$ is a form with all coefficients in $\bar Q^n$ and one coefficient
    outside $\bar Q^{n+1}$ ($n$ the largest integer with $\Psi\in\bar Q^n\bar R[Z]$); $g$ and
    $\mu=\nu_Q(g)$ are as in the paper, and ``we could choose $g$ in such a way that
    $\nu+n=\mu$'' is an induction on $\nu+n-\nu_Q(g)$. The form $\psi_0\in K[Z][Y]$ is
    $\sum_w\iota(c_w)Z^w$, $c_w$ the coefficient of $Z^w$ in $\Psi$ and $\iota(c_w)\in K[Y]_n$ its
    image in $\operatorname{gr}^n_{\bar Q}(\bar R)$; it is the partial sum of $\psi$ of the terms
    of degree exactly $\nu$ in $Z$ (one writes $g=\sum_wa_wz^w+p'$, $a_w\in Q^n$ lifting $c_w$,
    $p'\in P^{\nu+1}\cap Q^{\nu+n}$), and it vanishes iff all $c_w\in\bar Q^{n+1}$. The last step
    applies Nakayama's lemma to the finite $R$-module $M=\bar Q^n\operatorname{gr}^\nu_P(R)\cap
    \operatorname{gr}_P(J,R)_\nu$, a submodule of the homogeneous part of degree $\nu$ of
    $\operatorname{gr}_P(R)=\bar R[Z]$ ($\bar R$-module of finite type): $M\subseteq(\bar Q^nH)_\nu+\bar QM$,
    the second summand by the Artin--Rees lemma from $M\subseteq(\bar Q^nH)_\nu+\bar Q^{n+e}
    \operatorname{gr}^\nu_P(R)$.

    \textbf{Gaps in the paper filled.} (1) The bigrading of $\operatorname{gr}_Q(R)=K[Z,Y]$ is
    compatible with the $P$-adic filtration: if $g\in P^a\cap Q^\mu$, its initial form
    $\psi$ has all its coefficients $\xi_\alpha$ forms of degree $\mu-d_\alpha\ge a$ (this is
    used as ``$\psi\in(Z_1,\dots,Z_r)^{\nu+1}K[Z,Y]$'' and ``$\psi\in(Z_1,\dots,Z_r)^\nu
    K[Z,Y]$''); it follows from the independence of the bidegree components
    ($P^a\cap Q^\mu=\sum_{a\le b\le\mu}P^bY^{\mu-b}$), i.e.\ from the quasi-regularity of
    $(y,z)$. (2) The inequality ``$\nu+n\ge\mu$'' (p.~191), which the paper does not argue: from
    $P^\nu\cap Q^{\nu+k}=P^\nu Q^k$ and the maximality of $n$. (3) The assertion that
    $(\bar y_1,\dots,\bar y_s,\bar x_1,\dots,\bar x_t)$ is a regular system of parameters of
    $\bar R$ (p.~192), which gives $\operatorname{gr}_{\bar Q}(\bar R)=K[Y]$,
    $Y_j\leftrightarrow[\bar y_j]$: from the dimension count of footnote~41. (4) ``Then we can see that $\psi_0$ is the partial sum of the form $\psi$
    \dots''. (5) The existence of the homogeneous $\zeta_{\alpha\beta}$ and of the lifts
    $h_{\alpha\beta}$. (6) The termination of the replacement of $g$ by $g-h$. (7) The passage
    from ``$\subseteq\bar Q^nH+\bar Q^{n+e}\bar R[Z]$ for all $e$'' to $\subseteq\bar Q^nH$, for
    which Nakayama's lemma alone does not suffice: the Artin--Rees lemma (the input of Krull's
    intersection theorem) gives $\bar Q^{n+1}N\cap G=\bar Q(\bar Q^nN\cap G)$ for large $n$.

    \textbf{Differences from the printed text.} None in the route. The hypothesis
    $J\subseteq P$ is not used (the printed proof does not use it either). -/)
  (latexEnv := "lemma")]
theorem inf_grIdeal_eq_mul_span_initialForm (hJP : J ≤ P) (hPQ : P ≤ Q) {m : ℕ}
    (f : Fin m → R) (hf : ∀ j, f j ∈ J)
    (h₁ : ∀ j, Ideal.ordElem Q (f j) = Ideal.ordElem P (f j))
    (h₂ : Ideal.span (Set.range fun j => initialForm Q (f j)) = grIdeal Q J) :
    (∀ n : ℕ, (Q.map (algebraMap R (AssocGraded P))) ^ n ⊓ grIdeal P J =
        (Q.map (algebraMap R (AssocGraded P))) ^ n *
          Ideal.span (Set.range fun j => initialForm P (f j))) ∧
      grIdeal P J = Ideal.span (Set.range fun j => initialForm P (f j)) := by
  have key : ∀ n : ℕ, (Q.map (algebraMap R (AssocGraded P))) ^ n ⊓ grIdeal P J =
      (Q.map (algebraMap R (AssocGraded P))) ^ n *
        Ideal.span (Set.range fun j => initialForm P (f j)) := by
    classical
    -- (`J ⊆ P` is not used by the printed proof.)
    have _hJP := hJP
    -- "Let us choose a regular system of parameters `(z₁, …, z_r, y₁, …, y_s, x₁, …, x_t)` of `R`
    -- such that `P = (z)R` and `Q = (z, y)R`" (p. 191, footnote 41); "We can identify `gr_P(R)`
    -- with the polynomial ring `R̄[Z]`" and "`gr_Q(R)` with `K[Z, Y]`"
    obtain ⟨κ, ι, -, -, y, z, S⟩ := exists_lemma7Setup P Q hPQ inferInstance inferInstance
    have hQtop : Q ≠ ⊤ := Ideal.IsPrime.ne_top'
    have hPtop : P ≠ ⊤ := Ideal.IsPrime.ne_top'
    intro n
    apply le_antisymm
    · rintro Ψ ⟨hΨQ, hΨJ⟩
      -- "Obviously, we may assume that `Ψ` is homogeneous": `Ψ` is the sum of its homogeneous
      -- components, which lie in `Q̄ⁿ gr_P(R) ∩ gr_P(J, R)`
      obtain ⟨T, hT⟩ := GrQuotDiagram.exists_eq_sum_ofGrPiece_grProj P Ψ
      rw [hT]
      refine Ideal.sum_mem _ fun i _ => ?_
      obtain ⟨a, ha, haP, haeq⟩ := exists_mem_mul_of_mem_map P (Q ^ n)
        (by rw [Ideal.map_pow]; exact hΨQ) i
      obtain ⟨b, hbJ, hbP, hbeq⟩ := grIdeal_le_bound P J hΨJ i
      refine S.ofGrPiece_mem_mul_span_of_mem_inf J f hf h₁ h₂ hPtop hQtop n i (grProj P i Ψ) ?_ ?_
      · rw [← haeq, AssocGraded.ofGrPiece_mk, ← Ideal.map_pow]
        exact mk_mem_map_of_mem_mul P (Q ^ n) ha haP
      · rw [← hbeq, AssocGraded.ofGrPiece_mk]
        exact mk_mem_grIdeal P hbJ hbP
    · refine le_inf Ideal.mul_le_left (Ideal.mul_le_right.trans ?_)
      rw [Ideal.span_le]
      rintro _ ⟨β, rfl⟩
      exact Ideal.subset_span (Set.mem_image_of_mem _ (hf β))
  -- "In particular": the case `n = 0`, where `Q̄⁰ gr_P(R) = gr_P(R)`.
  refine ⟨key, ?_⟩
  simpa using key 0

end Lemma7Theorem

/-! ### Condition (iii) of Theorem 2 (p. 195) -/

section InitialFormSystem

variable {R : Type u} [CommRing R]

/-- The condition (iii)(1)(2) of Theorem 2 (p. 195), which is also the right-hand side of
Lemma 8 (p. 194): "there exists a system of elements `(f₁, …, f_m)` of `J` such that
(1) `ν_Q(f_j) = ν_P(f_j)` for `1 ≤ j ≤ m`, and (2) if `φ_j` denotes the initial form of `f_j` in
`gr_Q(R)` for `1 ≤ j ≤ m`, then `gr_Q(J, R) = (φ₁, …, φ_m) gr_Q(R)`."  (The system of
elements is exactly one satisfying the hypotheses (i), (ii) of Lemma 7.) -/
@[blueprint "def:II.2-initial-form-system"
  (statement := /-- Let $R$ be a ring and $J$, $P$, $Q$ ideals in $R$. We say that $J$
    \emph{admits a system of initial forms with respect to $(P,Q)$} if there exists a system
    of elements $(f_1,\dots,f_m)$ of $J$ such that (1) $\nu_Q(f_j)=\nu_P(f_j)$ for
    $1\le j\le m$ (\cref{def:II.2-order-element}), and (2) if $\varphi_j$ denotes the initial
    form of $f_j$ in $\operatorname{gr}_Q(R)$ (\cref{def:II.2-initial-form}), then
    $\operatorname{gr}_Q(J,R)=(\varphi_1,\dots,\varphi_m)\operatorname{gr}_Q(R)$
    (\cref{def:II.2-graded-ideal}). This is condition (iii) of Theorem~2 and the right-hand
    side of Lemma~8 (pp.~194--195). -/)
  (latexEnv := "definition")]
def HasInitialFormSystem (J P Q : Ideal R) : Prop :=
  ∃ (m : ℕ) (f : Fin m → R), (∀ j, f j ∈ J) ∧
    (∀ j, Ideal.ordElem Q (f j) = Ideal.ordElem P (f j)) ∧
    Ideal.span (Set.range fun j => initialForm Q (f j)) = grIdeal Q J

end InitialFormSystem

/-- If `J ≤ Q` and `Q` is a maximal ideal of `R`, then `Q/J` is a maximal ideal of `R/J`. -/
theorem isMaximal_map_quotientMk_of_le {R : Type u} [CommRing R] {J Q : Ideal R} (hJQ : J ≤ Q)
    [hQ : Q.IsMaximal] : (Q.map (Ideal.Quotient.mk J)).IsMaximal := by
  refine (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    hQ).resolve_left fun h => hQ.ne_top ?_
  have hker : Ideal.comap (Ideal.Quotient.mk J) ⊥ = J := Ideal.mk_ker
  have := Ideal.comap_map_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective Q
  rw [h, Ideal.comap_top, hker, sup_eq_left.mpr hJQ] at this
  exact this.symm

section Lemma8Flat

/-- For a regular local ring `R` and a prime `P` with `R/P` regular, `gr_P(R)` is flat over
`R/P`: it is a polynomial ring over `R/P`, and each homogeneous part is a direct summand of it,
hence a finite projective module over the local ring `R/P`. -/
theorem isNormallyFlatAlongIdeal_of_isRegularLocalRing_quotient {R : Type u} [CommRing R]
    [IsRegularLocalRing R] (P : Ideal R) [P.IsPrime] [IsRegularLocalRing (R ⧸ P)] :
    IsNormallyFlatAlongIdeal P := by
  intro p
  obtain ⟨r, ⟨e⟩⟩ := exists_algEquiv_assocGraded P inferInstance
  have : Module.Free (R ⧸ P) (AssocGraded P) := Module.Free.of_equiv e.toLinearEquiv
  have : Module.Projective (R ⧸ P) (GrPiece P p) :=
    Module.Projective.of_split (AssocGraded.ofGrPiece P p) (grProj P p)
      (LinearMap.ext fun x => grProj_ofGrPiece_same P p x)
  have : Module.Flat (R ⧸ P) (GrPiece P p) := inferInstance
  exact Module.free_of_flat_of_isLocalRing

end Lemma8Flat

section Lemma8Dir

variable {R : Type u} [CommRing R] (J P Q : Ideal R)

/-- The ideal of `gr_Q(R)` generated by the initial forms of the `f ∈ J` with `ν_Q(f) = ν_P(f)`
(the image of `gr_P(J, R)` in `gr_Q(R)`, p. 194). -/
noncomputable def equiOrderForms : Ideal (AssocGraded Q) :=
  Ideal.span {x | ∃ f ∈ J, Ideal.ordElem Q f = Ideal.ordElem P f ∧ x = initialForm Q f}

theorem mk_mem_equiOrderForms (hPQ : P ≤ Q) {p : ℕ} {j : R} (hjJ : j ∈ J) (hjP : j ∈ P ^ p) :
    AssocGraded.mk Q p j (Ideal.pow_right_mono hPQ p hjP) ∈ equiOrderForms J P Q := by
  by_cases hj : j ∈ Q ^ (p + 1)
  · rw [(AssocGraded.mk_eq_zero_iff Q _).mpr hj]
    exact zero_mem _
  · have hQ : Ideal.ordElem Q j = p :=
      le_antisymm (Ideal.ordElem_le_of_notMem hj)
        (Ideal.le_ordElem (Ideal.pow_right_mono hPQ p hjP))
    have hP : Ideal.ordElem P j = p := by
      refine le_antisymm ?_ (Ideal.le_ordElem hjP)
      rw [← hQ]
      exact Ideal.ordElem_le fun k hk => Ideal.le_ordElem (Ideal.pow_right_mono hPQ k hk)
    rw [← initialForm_eq_mk Q hQ]
    exact Ideal.subset_span ⟨j, hjJ, hQ.trans hP.symm, rfl⟩

theorem equiOrderForms_le_grIdeal : equiOrderForms J P Q ≤ grIdeal Q J := by
  rw [equiOrderForms, Ideal.span_le]
  rintro _ ⟨f, hf, -, rfl⟩
  exact Ideal.subset_span ⟨f, hf, rfl⟩

end Lemma8Dir

section Lemma8Iff

/-- Quasi-regularity is transported along a ring isomorphism. -/
theorem IsQuasiRegular.map_ringEquiv {A B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B)
    {σ : Type*} {x : σ → A} (hx : IsQuasiRegular x) : IsQuasiRegular fun i => e (x i) := by
  intro d F hF hFx m
  have hrange : Ideal.span (Set.range fun i => e (x i)) =
      (Ideal.span (Set.range x)).map e := by
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have hF' : (MvPolynomial.map (e.symm : B →+* A) F).IsHomogeneous d := hF.map _
  have heval : ∀ G : MvPolynomial σ B, MvPolynomial.eval x (MvPolynomial.map (e.symm : B →+* A) G) =
      e.symm (MvPolynomial.eval (fun i => e (x i)) G) := fun G => by
    induction G using MvPolynomial.induction_on <;> simp_all
  have h1 : e.symm (MvPolynomial.eval (fun i => e (x i)) F) ∈
      Ideal.span (Set.range x) ^ (d + 1) := by
    rw [hrange, ← Ideal.map_pow] at hFx
    obtain ⟨a, ha, hae⟩ := (Ideal.mem_map_iff_of_surjective e e.surjective).mp hFx
    rw [← hae]
    simpa using ha
  have h2 := hx d _ hF' (by rw [heval]; exact h1) m
  rw [MvPolynomial.coeff_map] at h2
  rw [hrange]
  simpa using Ideal.mem_map_of_mem e h2

variable {R : Type u} [CommRing R] (J P Q : Ideal R) {s : ℕ} (y : Fin s → R)

theorem span_map_mk_eq_of_eq_sup (hQY : Q = P ⊔ Ideal.span (Set.range y)) :
    Ideal.span (Set.range fun j => Ideal.Quotient.mk P (y j)) = Q.map (Ideal.Quotient.mk P) := by
  rw [hQY, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, ← Set.range_comp]
  rfl

theorem map_eq_sup_span_map (hQY : Q = P ⊔ Ideal.span (Set.range y)) :
    Q.map (Ideal.Quotient.mk J) = P.map (Ideal.Quotient.mk J) ⊔
      Ideal.span (Set.range fun j => Ideal.Quotient.mk J (y j)) := by
  rw [hQY, Ideal.map_sup, Ideal.map_span, ← Set.range_comp]
  rfl

theorem span_map_mk_eq_map_quotient (hQY : Q = P ⊔ Ideal.span (Set.range y)) :
    Ideal.span (Set.range fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
      (Ideal.Quotient.mk J (y j))) =
        (Q.map (Ideal.Quotient.mk J)).map (Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))) := by
  rw [map_eq_sup_span_map J P Q y hQY, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
    Ideal.map_span, ← Set.range_comp]
  rfl

theorem isQuasiRegular_map_quotient (hJP : J ≤ P)
    (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) :
    IsQuasiRegular fun j => Ideal.Quotient.mk (P.map (Ideal.Quotient.mk J))
      (Ideal.Quotient.mk J (y j)) := by
  have h := hqr.map_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm
  simp only [DoubleQuot.quotQuotEquivQuotOfLE_symm_mk] at h
  exact h

end Lemma8Iff

section QuotEquiv

/-- `gr⁰_I(M) = M/IM` as a quotient of `M` (the `e₃` of `flat_quotient_tensor_iff_...`). -/
noncomputable def quotEquivGrModPieceZero {A : Type u} [CommRing A] (I : Ideal A) (M : Type u)
    [AddCommGroup M] [Module A M] : (M ⧸ (I • (⊤ : Submodule A M))) ≃ₗ[A] GrModPiece I M 0 :=
  let htop : I ^ 0 • (⊤ : Submodule A M) = ⊤ := by
    rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
  let e₂ : ↥(I ^ 0 • (⊤ : Submodule A M)) ≃ₗ[A] M :=
    (LinearEquiv.ofEq _ _ htop).trans Submodule.topEquiv
  Submodule.Quotient.equiv _ _ e₂.symm (by
      ext x
      rw [Submodule.mem_map_equiv, LinearEquiv.symm_symm, Submodule.mem_comap,
        Submodule.subtype_apply, zero_add, pow_one]
      rfl)

end QuotEquiv


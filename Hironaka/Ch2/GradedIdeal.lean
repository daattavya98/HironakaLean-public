        (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (n : ℕ),
        Function.Bijective (psiDeg P̄ Q̄ (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j))
          (isQuasiRegular_map_quotient J P y hJP hqr) (span_map_mk_eq_map_quotient J P Q y hQY) n),
      IsNormallyFlatAlongIdeal Q̄ ∧ HasInitialFormSystem J P Q,
      Module.Flat (Ō ⧸ Q̄') (GrModPiece Q̄' (AssocGraded P̄) 0) ∧
        ∀ m : ℕ, Function.Bijective (grModMap Q̄' (AssocGraded P̄) m)].TFAE := by
  have hJM : J ≤ IsLocalRing.maximalIdeal R :=
    hJP.trans (IsLocalRing.le_maximalIdeal Ideal.IsPrime.ne_top')
  have : IsLocalRing 𝒪 := isLocalRing_quotient_of_le hJM
  have hPbar : P̄.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact hJP)
  have hQbar : Q̄.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact hJP.trans hPQ)
  have : IsRegularLocalRing (𝒪 ⧸ P̄) :=
    IsRegularLocalRing.of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJP).symm
  have : IsRegularLocalRing (𝒪 ⧸ Q̄) :=
    IsRegularLocalRing.of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE (hJP.trans hPQ)).symm
  have hQbar' : Q̄'.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact Ideal.map_mono hPQ)
  -- (i) ⟹ (ii): Proposition 1 of §1
  tfae_have 1 → 2 := fun h =>
    ⟨(isNormallyFlatAlongIdeal_of_le P̄ Q̄ (Ideal.map_mono hPQ) h).2,
      fun s y hQY hqr n => psiDeg_bijective_of_isNormallyFlatAlongIdeal P̄ Q̄
        (Ideal.map_mono hPQ) (fun j => Ideal.Quotient.mk J (y j)) _ _ h
        (map_eq_sup_span_map J P Q y hQY) n⟩
  -- (ii) ⟹ (iii): Lemma 8
  tfae_have 2 → 3 := fun h => by
    obtain ⟨s, y, hqr, -, hQY, -⟩ := exists_adapted_lift P Q hPQ
    exact ⟨h.1, (bijective_psiDeg_iff_hasInitialFormSystem J P Q y hJP hPQ hQY hqr).mp
      (h.2 s y hQY hqr)⟩
  -- (iii) ⟹ (ii): Lemma 8
  tfae_have 3 → 2 := fun h => ⟨h.1, fun s y hQY hqr n =>
    (bijective_psiDeg_iff_hasInitialFormSystem J P Q y hJP hPQ hQY hqr).mpr h.2 n⟩
  -- (ii) and (iii) together imply (iv): the paper's argument through `ψ'`, for a system `y` as on
  -- pp. 183 and 193
  tfae_have 3 → 4 := fun h => by
    obtain ⟨s, y, hqr, -, hQY, -⟩ := exists_adapted_lift P Q hPQ
    exact flat_and_bijective_grModMap_of_bijective_psiDeg J P Q hJP hPQ h.1 y hQY hqr
      ((bijective_psiDeg_iff_hasInitialFormSystem J P Q y hJP hPQ hQY hqr).mpr h.2) h.2
  -- (iv) ⟹ (i): the corollary to Lemma 2 of §1
  tfae_have 4 → 1 := fun h =>
    (isNormallyFlatAlongIdeal_iff_grModMap_bijective P̄ hPbar.ne_top Q̄' hQbar'.ne_top).mpr h
  tfae_finish

/-- Corollary 1 of Theorem 2 (pp. 196–197) with its condition (ii): the statement of
`isNormallyFlatAlongIdeal_tfae_of_eq_maximalIdeal` (see there for the quoted text and the
encoding of (i), (iii), (iv)) with
(ii) The homomorphism of graded `O/Q̄`-algebras
`ψ' : gr⁰_{Q̄}(gr_{P̄}(O)) ⊗_{O/Q̄} gr_{Q̄/P̄}(O/P̄) → gr_{Q̄}(O)` is isomorphic
inserted as the second condition.

Intermediate version (the paper's form is
`isNormallyFlatAlongIdeal_tfae_psiDeg_of_eq_maximalIdeal_of_span_eq_map`): as in
`isNormallyFlatAlongIdeal_tfae_psiDeg`,
`ψ'` depends on the system `(y₁, …, y_s)` of p. 193 and (ii) is stated for every system `y` with
`Q = P + (y)` and `ȳ_j` quasi-regular in `R/P`, "isomorphic" meaning bijective in each total
degree (`psiDeg`).  As in the paper, the corollary follows from
`isNormallyFlatAlongIdeal_tfae_psiDeg` because every module over the field `O/Q̄ = R/Q` is flat. -/
@[blueprint "cor:II.2-thm2-1-quasi-regular"
  (statement := /-- The notation and assumptions being as in \cref{thm:II.2-2-quasi-regular},
  assume that
    $Q$ is the maximal ideal of $R$. Then the following conditions are equivalent to each
    other: (i) $\operatorname{gr}_{\bar P}(O)$ is flat over $O/\bar P$. (ii) The homomorphism
    $\psi'$ of graded $O/\bar Q$-algebras is isomorphic (\cref{lem:II.2-8-quasi-regular}).
    (iii) There exists
    a system of elements $(f_1,\dots,f_m)$ of $J$ with $\nu_Q(f_j)=\nu_P(f_j)$ whose initial
    forms generate $\operatorname{gr}_Q(J,R)$ (\cref{def:II.2-initial-form-system}). (iv) The
    canonical homomorphism $\varphi$ is isomorphic. (Corollary 1, pp.~196--197, with (ii).)

    \textbf{Formalization note (intermediate version).} The paper's form is
    \cref{cor:II.2-thm2-1-psi}. As in \cref{thm:II.2-2-quasi-regular}, $\psi'$
    is stated for every system $(y_j)$ with $Q=P+(y)$ whose classes are quasi-regular in $R/P$,
    ``isomorphic'' meaning bijective in each total degree. -/)
  (proof := /-- The assertion follows \cref{thm:II.2-2-quasi-regular} because every module is flat
  over a
    field: $O/\bar Q=R/Q$ is a field, so the flatness conditions in (ii), (iii) and (iv) of
    \cref{thm:II.2-2-quasi-regular} hold automatically. -/)
  (latexEnv := "corollary")]
theorem isNormallyFlatAlongIdeal_tfae_psiDeg_of_eq_maximalIdeal (hJP : J ≤ P)
    (hQ : Q = IsLocalRing.maximalIdeal R) :
    [IsNormallyFlatAlongIdeal P̄,
      ∀ (s : ℕ) (y : Fin s → R) (hQY : Q = P ⊔ Ideal.span (Set.range y))
        (hqr : IsQuasiRegular fun j => Ideal.Quotient.mk P (y j)) (n : ℕ),
        Function.Bijective (psiDeg P̄ Q̄
          (Ideal.map_mono (hQ ▸ IsLocalRing.le_maximalIdeal_of_isPrime P))
          (fun j => Ideal.Quotient.mk J (y j))
          (isQuasiRegular_map_quotient J P y hJP hqr) (span_map_mk_eq_map_quotient J P Q y hQY) n),
      HasInitialFormSystem J P Q,
      ∀ m : ℕ, Function.Bijective (grModMap Q̄' (AssocGraded P̄) m)].TFAE := by
  have hPQ : P ≤ Q := hQ ▸ IsLocalRing.le_maximalIdeal_of_isPrime P
  have hQmax : Q.IsMaximal := hQ ▸ IsLocalRing.maximalIdeal.isMaximal R
  have hQbar : (Q̄).IsMaximal := isMaximal_map_quotientMk_of_le (hJP.trans hPQ)
  have hQbar' : (Q̄').IsMaximal := isMaximal_map_quotientMk_of_le (Ideal.map_mono hPQ)
  have hfree : IsNormallyFlatAlongIdeal Q̄ := fun p => by
    let _ : Field (𝒪 ⧸ Q̄) := Ideal.Quotient.field _
    exact Module.Free.of_divisionRing _ _
  have hflat : Module.Flat (Ō ⧸ Q̄') (GrModPiece Q̄' (AssocGraded P̄) 0) := by
    let _ : Field (Ō ⧸ Q̄') := Ideal.Quotient.field _
    have : Module.Free (Ō ⧸ Q̄') (GrModPiece Q̄' (AssocGraded P̄) 0) :=
      Module.Free.of_divisionRing _ _
    exact Module.Flat.of_free
  have h := isNormallyFlatAlongIdeal_tfae_psiDeg J P Q hJP hPQ
  have h12 := h.out 1 2
  have h23 := h.out 2 3
  have h34 := h.out 3 4
  have h41 := h.out 4 1
  tfae_have 1 → 2 := fun h₁ => (h12.mp h₁).2
  tfae_have 2 → 3 := fun h₂ => (h23.mp ⟨hfree, h₂⟩).2
  tfae_have 3 → 4 := fun h₃ => (h34.mp ⟨hfree, h₃⟩).2
  tfae_have 4 → 1 := fun h₄ => h41.mp ⟨hflat, h₄⟩
  tfae_finish

end Theorem2

/-! ### Corollary 2 (p. 197) -/

/-- For `J = (f)` in a regular local ring, `ν_M(f) = ν_P(f)` gives an initial form system
(`gr_M(R)` is a domain, so `gr_M(J, R)` is generated by the initial form of `f`). -/
private theorem hasInitialFormSystem_span_singleton {R : Type u} [CommRing R]
    [IsRegularLocalRing R] (P : Ideal R) (f : R)
    (h : Ideal.ordElem (IsLocalRing.maximalIdeal R) f = Ideal.ordElem P f) :
    HasInitialFormSystem (Ideal.span {f}) P (IsLocalRing.maximalIdeal R) := by
  refine ⟨1, fun _ => f, fun _ => Ideal.subset_span rfl, fun _ => h, ?_⟩
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨f, Ideal.subset_span rfl, rfl⟩
  · rw [grIdeal, Ideal.span_le]
    rintro _ ⟨g, hg, rfl⟩
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hg
    rw [initialForm_mul_maximalIdeal]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨0, rfl⟩)

/-- `ν_M((f)) = ν_M(f)`. -/
private theorem ord_span_singleton {S : Type u} [CommRing S] (M : Ideal S) (f : S) :
    Ideal.ord M (Ideal.span {f}) = Ideal.ordElem M f := by
  unfold Ideal.ord Ideal.ordElem
  simp only [Ideal.span_singleton_le_iff_mem]

/-- `ν_{PR_P}(f) = ν_P(f)` when `R` and `R/P` are regular (`Pᵛ` is `P`-primary). -/
private theorem ordElem_map_algebraMap_localization {R S : Type u} [CommRing R] [CommRing S]
    [IsRegularLocalRing R] [Algebra R S] (P : Ideal R) [P.IsPrime]
    (hP : IsRegularLocalRing (R ⧸ P)) [IsLocalization.AtPrime S P] (f : R) :
    Ideal.ordElem (P.map (algebraMap R S)) (algebraMap R S f) = Ideal.ordElem P f := by
  have key : ∀ n : ℕ, algebraMap R S f ∈ (P.map (algebraMap R S)) ^ n ↔ f ∈ P ^ n := by
    intro n
    rw [← Ideal.map_pow]
    constructor
    · intro hf
      obtain ⟨⟨a, s⟩, hs⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl S).mp hf
      rw [← map_mul] at hs
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists P.primeCompl S).mp hs
      have hmem : ((c : R) * s) * f ∈ P ^ n := by
        rw [show ((c : R) * s) * f = c * (f * s) by ring, hc]
        exact Ideal.mul_mem_left _ _ a.2
      exact mem_pow_of_mul_mem_pow_of_isRegularLocalRing_quotient P hP n _ f
        (P.primeCompl.mul_mem c.2 s.2) hmem
    · intro hf
      exact Ideal.mem_map_of_mem _ hf
  unfold Ideal.ordElem
  simp only [key]

/-- A ring isomorphism `A ≅ B` carrying `I` to `J` identifies `grⁿ_I(A)` with `grⁿ_J(B)`,
semilinearly over `A/I ≅ B/J`. -/
private theorem exists_grPiece_addEquiv {A B : Type u} [CommRing A] [CommRing B]
    (e : A ≃+* B) (I : Ideal A) (J : Ideal B) (hIJ : I.map (e : A →+* B) = J) (n : ℕ) :
    ∃ j : GrPiece I n ≃+ GrPiece J n, ∀ (r : A ⧸ I) (m : GrPiece I n),
      j (r • m) = Ideal.quotientEquiv I J e hIJ.symm r • j m := by
  have := RingHomInvPair.of_ringEquiv e
  have := RingHomInvPair.symm (e : A →+* B) (e.symm : B →+* A)
  let f₀ : A ≃ₛₗ[(e : A →+* B)] B := e.toSemilinearEquiv
  have hpow : ∀ k, J ^ k = (I ^ k).comap (e.symm : B →+* A) := by
    intro k
    rw [← hIJ, ← Ideal.map_pow, Ideal.map_comap_of_equiv]
    rfl
  have hmap : ∀ k, Submodule.map (f₀ : A →ₛₗ[(e : A →+* B)] B) (I ^ k) = J ^ k := by
    intro k
    ext x
    rw [Submodule.mem_map, hpow k, Ideal.mem_comap]
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa [f₀] using hy
    · intro hx
      exact ⟨e.symm x, hx, by simp [f₀]⟩
  let g₀ : ↥(I ^ n) ≃ₛₗ[(e : A →+* B)] ↥(J ^ n) :=
    (f₀.submoduleMap (I ^ n)).trans (LinearEquiv.ofEq _ _ (hmap n))
  have hq : (Submodule.comap (I ^ n).subtype (I ^ (n + 1))).map
      (g₀ : ↥(I ^ n) →ₛₗ[(e : A →+* B)] ↥(J ^ n)) =
      Submodule.comap (J ^ n).subtype (J ^ (n + 1)) := by
    rw [Submodule.map_equiv_eq_comap_symm]
    ext ⟨x, hx⟩
    show ((g₀.symm ⟨x, hx⟩ : ↥(I ^ n)) : A) ∈ I ^ (n + 1) ↔ x ∈ J ^ (n + 1)
    rw [hpow (n + 1), Ideal.mem_comap]
    rfl
  let j : GrPiece I n ≃ₛₗ[(e : A →+* B)] GrPiece J n := Submodule.Quotient.equiv _ _ g₀ hq
  refine ⟨j.toAddEquiv, fun r m => ?_⟩
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
  have h1 : (Ideal.Quotient.mk I a) • m = a • m := algebraMap_smul (A ⧸ I) a m
  have h2 : Ideal.quotientEquiv I J e hIJ.symm (Ideal.Quotient.mk I a) =
      Ideal.Quotient.mk J (e a) := rfl
  have h3 : (Ideal.Quotient.mk J (e a)) • j m = e a • j m := algebraMap_smul (B ⧸ J) (e a) (j m)
  rw [h1, h2]
  change j (a • m) = Ideal.Quotient.mk J (e a) • j m
  rw [h3]
  exact j.map_smulₛₗ a m

/-- Freeness is transported along a semilinear additive isomorphism. -/
private theorem free_of_equiv_equiv {K L M N : Type u} [CommRing K] [CommRing L]
    [AddCommGroup M] [AddCommGroup N] [Module K M] [Module L N] (i : K ≃+* L) (j : M ≃+ N)
    (hc : ∀ (r : K) (m : M), j (r • m) = i r • j m) [Module.Free K M] : Module.Free L N := by
  let : Module K N := Module.compHom N (i : K →+* L)
  let j' : M ≃ₗ[K] N := { j with map_smul' := hc }
  exact Module.Free.of_basis (((Module.Free.chooseBasis K M).map j').mapCoeffs i fun _ _ => rfl)

/-- Normal flatness is invariant under ring isomorphisms. -/
private theorem isNormallyFlatAlongIdeal_of_ringEquiv {A B : Type u} [CommRing A] [CommRing B]
    (e : A ≃+* B) (I : Ideal A) (J : Ideal B) (hIJ : I.map (e : A →+* B) = J)
    (h : IsNormallyFlatAlongIdeal I) : IsNormallyFlatAlongIdeal J := fun n => by
  obtain ⟨j, hj⟩ := exists_grPiece_addEquiv e I J hIJ n
  have := h n
  exact free_of_equiv_equiv _ j hj

/-- Every point of the support of a subscheme is in the image of its closed immersion. -/
private theorem exists_ι_eq_of_mem_pts {Y : Scheme.{u}} (W : Subscheme Y) {x : Y} (hx : x ∈ W.pts) :
    ∃ y : W.toScheme, W.ι y = x := by
  have : x ∈ Set.range W.ι := by
    rw [Scheme.IdealSheafData.range_subschemeι]
    exact hx
  exact this

open CategoryTheory in
/-- For `W ⊆ V`, the total transform `W' = ι_V⁻¹(W)` of `W` in the scheme `V` is isomorphic to
`W`, compatibly with the immersions into `X`. -/
private theorem exists_totalTransform_hom {Y : Scheme.{u}} {V W : Subscheme Y}
    (hWV : W.IsContainedIn V) :
    ∃ g : (Subscheme.totalTransform V.ι W).toScheme ⟶ W.toScheme, IsIso g ∧
      g ≫ W.ι = (Subscheme.totalTransform V.ι W).ι ≫ V.ι := by
  have hT : Subscheme.totalTransform V.ι W = W.comap V.ι := rfl
  rw [hT]
  have hVW : V ≤ W := fun U => hWV U
  have hsq : IsPullback (Scheme.IdealSheafData.inclusion hVW) (𝟙 W.toScheme) V.ι W.ι :=
    IsPullback.of_vert_isIso_mono ⟨by
      rw [Scheme.IdealSheafData.inclusion_subschemeι, Category.id_comp]⟩
  have hsnd : Limits.pullback.snd V.ι W.ι = hsq.isoPullback.inv :=
    (hsq.isoPullback_inv_snd).symm.trans (Category.comp_id _)
  refine ⟨(W.comapIso V.ι ≪≫ hsq.isoPullback.symm).hom, inferInstance, ?_⟩
  rw [Iso.trans_hom, Iso.symm_hom, ← hsnd, Category.assoc, ← Limits.pullback.condition,
    ← Category.assoc, Scheme.IdealSheafData.comapIso_hom_fst]

/-- A scheme isomorphic to a non-singular scheme is non-singular. -/
private theorem isNonsingular_of_iso {A B : Scheme.{u}} (e : A ≅ B) (hB : B.IsNonsingular) :
    A.IsNonsingular := by
  intro a
  have : IsRegularLocalRing (B.presheaf.stalk (e.hom a)) := hB (e.hom a)
  exact IsRegularLocalRing.of_ringEquiv (CategoryTheory.asIso
    (e.hom.stalkMap a)).commRingCatIsoToRingEquiv

/-- A scheme isomorphic to an irreducible scheme is irreducible. -/
private theorem irreducibleSpace_of_iso {A B : Scheme.{u}} (e : A ≅ B) [IrreducibleSpace B] :
    IrreducibleSpace A := by
  have hsurj : Function.Surjective e.inv := fun a => ⟨e.hom a, by
    rw [← Scheme.Hom.comp_apply, CategoryTheory.Iso.hom_inv_id]
    rfl⟩
  rw [irreducibleSpace_def]
  have := (IrreducibleSpace.isIrreducible_univ B).image e.inv e.inv.continuous.continuousOn
  rwa [Set.image_univ, hsurj.range_eq] at this

open CategoryTheory in
/-- For `W ⊆ V` and `x'` a point of `W' = ι_V⁻¹(W)`, `W'_{x'}` is the image of `W_{x}`
(`x = ι_V(x')`) in `O_{V,x'} = O_{X,x}/V_x`. -/
private theorem stalkIdeal_totalTransform_eq_map {Y : Scheme.{u}} {V W : Subscheme Y}
    (hWV : W.IsContainedIn V) {x' : V.toScheme} (hx' : x' ∈ (Subscheme.totalTransform V.ι W).pts) :
    (Subscheme.totalTransform V.ι W).stalkIdeal x' =
      (W.stalkIdeal (V.ι x')).map (V.ι.stalkMap x').hom := by
  obtain ⟨g, hg, hcomm⟩ := exists_totalTransform_hom hWV
  obtain ⟨y', rfl⟩ := exists_ι_eq_of_mem_pts _ hx'
  suffices h : ((Subscheme.totalTransform V.ι W).stalkIdeal
      ((Subscheme.totalTransform V.ι W).ι y')).comap
      (V.ι.stalkMap ((Subscheme.totalTransform V.ι W).ι y')).hom =
      W.stalkIdeal (V.ι ((Subscheme.totalTransform V.ι W).ι y')) by
    rw [← h, Ideal.map_comap_of_surjective _ (V.ι.stalkMap_surjective _)]
  rw [stalkIdeal_eq_ker_stalkMap, RingHom.comap_ker]
  have h1 : ((Subscheme.totalTransform V.ι W).ι.stalkMap y').hom.comp
      (V.ι.stalkMap ((Subscheme.totalTransform V.ι W).ι y')).hom =
      (((Subscheme.totalTransform V.ι W).ι ≫ V.ι).stalkMap y').hom := by
    rw [Scheme.Hom.stalkMap_comp]
    rfl
  rw [h1]
  have hinj : Function.Injective (g.stalkMap y').hom :=
    (ConcreteCategory.bijective_of_isIso (g.stalkMap y')).1
  have key : ∀ φ : (Subscheme.totalTransform V.ι W).toScheme ⟶ Y, g ≫ W.ι = φ →
      RingHom.ker (φ.stalkMap y').hom = W.stalkIdeal (φ y') := by
    rintro φ rfl
    rw [Scheme.Hom.stalkMap_comp]
    have h2 : RingHom.ker ((W.ι.stalkMap (g y')) ≫ g.stalkMap y').hom =
        RingHom.ker (W.ι.stalkMap (g y')).hom := by
      ext a
      rw [RingHom.mem_ker, RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply,
        ← map_zero (g.stalkMap y').hom]
      exact hinj.eq_iff
    exact h2.trans (stalkIdeal_eq_ker_stalkMap W (g y')).symm
  exact key _ hcomm

/-- On an affine open `V ∋ y`, the stalk `D_y` is generated by the germs of `D(V)`. -/
private theorem stalkIdeal_eq_map_germ_of_affineOpen {Y : Scheme.{u}} (D : Subscheme Y) (V : Y.affineOpens)
    {y : Y} (hy : y ∈ (V : Y.Opens)) :
    D.stalkIdeal y = (D.ideal V).map (Y.presheaf.germ (V : Y.Opens) y hy).hom := by
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨U, hyU, s, hs, rfl⟩
    obtain ⟨_, ⟨U', hU', rfl⟩, hyU', hU'le⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open (show y ∈ (U : Y.Opens) ⊓ V from ⟨hyU, hy⟩)
        ((U : Y.Opens) ⊓ V).isOpen
    let U'' : Y.affineOpens := ⟨U', hU'⟩
    have h1 : U'' ≤ U := fun z hz => (hU'le hz).1
    have h2 : U'' ≤ V := fun z hz => (hU'le hz).2
    have hs' : Y.presheaf.map (CategoryTheory.homOfLE h1).op s ∈ (D.ideal V).map (Y.presheaf.map
        (CategoryTheory.homOfLE h2).op).hom := by
      rw [D.map_ideal h2]
      exact D.ideal_le_comap_ideal h1 hs
    have hle : (D.ideal V).map (Y.presheaf.map (CategoryTheory.homOfLE h2).op).hom ≤
        ((D.ideal V).map (Y.presheaf.germ (V : Y.Opens) y hy).hom).comap
          (Y.presheaf.germ (U'' : Y.Opens) y hyU').hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro t ht
      have e : (Y.presheaf.germ (U'' : Y.Opens) y hyU').hom
          ((Y.presheaf.map (CategoryTheory.homOfLE h2).op).hom t) =
          (Y.presheaf.germ (V : Y.Opens) y hy).hom t := Y.presheaf.germ_res_apply _ _ _ _
      rw [Ideal.mem_comap, Ideal.mem_comap, e]
      exact Ideal.mem_map_of_mem _ ht
    have e : (Y.presheaf.germ (U'' : Y.Opens) y hyU').hom
        ((Y.presheaf.map (CategoryTheory.homOfLE h1).op).hom s) =
        (Y.presheaf.germ (U : Y.Opens) y hyU).hom s := Y.presheaf.germ_res_apply _ _ _ _
    show (Y.presheaf.germ (U : Y.Opens) y hyU).hom s ∈ _
    rw [← e]
    exact hle hs'
  · rw [Ideal.map_le_iff_le_comap]
    intro s hs
    exact Ideal.subset_span ⟨V, hy, s, hs, rfl⟩

/-- If `D_y` is prime and `D_η` is the maximal ideal of `O_η` for a generization `η ⤳ y`, then
`D_y` is the prime of `O_y` corresponding to `η`. -/
private theorem comap_maximalIdeal_stalkSpecializes_eq {Y : Scheme.{u}} (D : Subscheme Y)
    {η y : Y} (h : η ⤳ y) [(D.stalkIdeal y).IsPrime]
    (hη : D.stalkIdeal η = IsLocalRing.maximalIdeal (Y.presheaf.stalk η)) :
    (IsLocalRing.maximalIdeal (Y.presheaf.stalk η)).comap (Y.presheaf.stalkSpecializes h).hom =
      D.stalkIdeal y := by
  let := (Y.presheaf.stalkSpecializes h).hom.toAlgebra
  have hloc := isLocalization_stalkSpecializes_of_specializes h
  have hmap : D.stalkIdeal η = (D.stalkIdeal y).map (algebraMap _ (Y.presheaf.stalk η)) :=
    Subscheme.stalkIdeal_eq_map_stalkSpecializes D h
  have hle : D.stalkIdeal y ≤ (IsLocalRing.maximalIdeal (Y.presheaf.stalk η)).comap
      (Y.presheaf.stalkSpecializes h).hom := by
    intro a ha
    rw [Ideal.mem_comap, ← hη, hmap]
    exact Ideal.mem_map_of_mem _ ha
  refine le_antisymm ?_ hle
  intro a ha
  rw [Ideal.mem_comap, ← hη, hmap] at ha
  have := IsLocalization.under_map_of_isPrime_disjoint (((IsLocalRing.maximalIdeal
    (Y.presheaf.stalk η)).comap (Y.presheaf.stalkSpecializes h).hom).primeCompl)
    (Y.presheaf.stalk η) (I := D.stalkIdeal y) inferInstance (by
      rw [Set.disjoint_left]
      intro b hb hb'
      exact hb (hle hb'))
  rw [← this]
  exact ha

/-- At a point `x` of a non-singular subscheme `W`, `O_{X,x}/W_x ≅ O_{W,x}` is regular. -/
private theorem isRegularLocalRing_stalk_quot {X : Scheme.{u}} (W : Subscheme X)
    (hW : W.IsNonsingular) {x : X} (hx : x ∈ W.pts) :
    IsRegularLocalRing (X.presheaf.stalk x ⧸ W.stalkIdeal x) := by
  obtain ⟨y, rfl⟩ := exists_ι_eq_of_mem_pts W hx
  obtain ⟨e⟩ := nonempty_stalk_quot_equiv W y
  have : IsRegularLocalRing (W.toScheme.presheaf.stalk y) := hW y
  exact IsRegularLocalRing.of_ringEquiv e.symm

/-- At a point `x` of a non-singular subscheme `W`, the stalk `W_x` is a prime ideal. -/
private theorem isPrime_stalkIdeal {X : Scheme.{u}} (W : Subscheme X) (hW : W.IsNonsingular)
    {x : X} (hx : x ∈ W.pts) : (W.stalkIdeal x).IsPrime := by
  have := isRegularLocalRing_stalk_quot W hW hx
  have := isDomain_of_isRegularLocalRing (X.presheaf.stalk x ⧸ W.stalkIdeal x)
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- Containment of subschemes gives the reverse inclusion of the stalks of the ideal
sheaves. -/
private theorem stalkIdeal_le_of_isContainedIn {X : Scheme.{u}} {W W₁ : Subscheme X}
    (h : W₁.IsContainedIn W) (x : X) : W.stalkIdeal x ≤ W₁.stalkIdeal x :=
  Ideal.span_mono fun _ ⟨U, hxU, s, hs, hsa⟩ => ⟨U, hxU, s, h U hs, hsa⟩

/-- An invertible sheaf of ideals is generated at every point by a single non-zero element. -/
private theorem exists_stalkIdeal_eq_span_singleton {Y : Scheme.{u}} {V : Subscheme Y}
    (hV : V.IsInvertibleIdeal) (x : Y) :
    ∃ f : Y.presheaf.stalk x, V.stalkIdeal x = Ideal.span {f} ∧ f ≠ 0 := by
  obtain ⟨U, hxU, a, hVa, ha⟩ := hV x
  refine ⟨Y.presheaf.germ (U : Y.Opens) x hxU a, ?_, ?_⟩
  · rw [stalkIdeal_eq_map_germ_of_affineOpen V U hxU, hVa, Ideal.map_span, Set.image_singleton]
  · intro h0
    let _ : Algebra Γ(Y, U) (Y.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨x, hxU⟩
    have hloc := U.2.isLocalization_stalk ⟨x, hxU⟩
    obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff
      (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl (Y.presheaf.stalk x) a).mp h0
    have hs0 : (s : Γ(Y, U)) = 0 := (mem_nonZeroDivisors_iff.mp ha).2 s hs
    exact s.2 (by rw [hs0]; exact Ideal.zero_mem _)

/-- `e(O_{V,z'}) = ν(f)` for a local generator `f ≠ 0` of `V` at `z = ι_V(z')` in a regular
`O_{X,z}` (the multiplicity of a hypersurface, p. 133). -/
private theorem multAt_eq_ordElem {Y : Scheme.{u}} (V : Subscheme Y) (z' : V.toScheme)
    (f : Y.presheaf.stalk (V.ι z')) (hVf : V.stalkIdeal (V.ι z') = Ideal.span {f}) (hf0 : f ≠ 0)
    [IsRegularLocalRing (Y.presheaf.stalk (V.ι z'))] :
    ((V.toScheme.multAt z' : ℕ) : ℕ∞) =
      Ideal.ordElem (IsLocalRing.maximalIdeal (Y.presheaf.stalk (V.ι z'))) f := by
  have hz : V.ι z' ∈ V.pts := by
    show V.ι z' ∈ (V.support : Set Y)
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨z', rfl⟩
  have hfM : f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (V.ι z')) :=
    stalkIdeal_le_maximalIdeal_of_mem_pts V hz (hVf ▸ Ideal.mem_span_singleton_self f)
  have : Nontrivial (Y.presheaf.stalk (V.ι z') ⧸ Ideal.span {f}) :=
    Ideal.Quotient.nontrivial_iff.mpr
      (fun h => (IsLocalRing.mem_maximalIdeal f).mp hfM (Ideal.span_singleton_eq_top.mp h))
  have : IsLocalRing (Y.presheaf.stalk (V.ι z') ⧸ Ideal.span {f}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  let e : (Y.presheaf.stalk (V.ι z') ⧸ Ideal.span {f}) ≃+* V.toScheme.presheaf.stalk z' :=
    (Ideal.quotEquivOfEq hVf.symm).trans (nonempty_stalk_quot_equiv V z').some
  unfold Scheme.multAt
  rw [← samuelMultiplicity_eq_of_ringEquiv e,
    samuelMultiplicity_quotient_span_singleton _ f hf0 hfM]
  exact ord_span_singleton _ f

/-- Multiplying by a unit does not change `ν_I`. -/
private theorem ordElem_unit_mul {A : Type u} [CommRing A] (I : Ideal A) {u : A} (hu : IsUnit u)
    (f : A) : Ideal.ordElem I (u * f) = Ideal.ordElem I f := by
  unfold Ideal.ordElem
  simp only [Ideal.unit_mul_mem_iff_mem _ hu]

/-- The step of Corollary 2 (p. 197) that the paper does not argue: for `J = (f)` with `f ≠ 0`,
condition (iii) of Corollary 1 of Theorem 2 forces `ν_M(f) = ν_P(f)`.  By Lemma 6 the elements
`f_j` of the system generate `(f)`, so `f_j = c_j f` and `f = Σ d_j f_j = (Σ d_j c_j) f`;
`R` being a domain, `Σ d_j c_j = 1`, so some `c_j` is a unit, and `ν_M(f) = ν_M(f_j) = ν_P(f_j) =
ν_P(f)` (multiplication by a unit changes no order). -/
private theorem ordElem_maximalIdeal_eq_of_hasInitialFormSystem_span_singleton {R : Type u}
    [CommRing R] [IsRegularLocalRing R] (P : Ideal R) (f : R) (hf0 : f ≠ 0)
    (h : HasInitialFormSystem (Ideal.span {f}) P (IsLocalRing.maximalIdeal R)) :
    Ideal.ordElem (IsLocalRing.maximalIdeal R) f = Ideal.ordElem P f := by
  classical
  obtain ⟨m, g, hg, hν, hgen⟩ := h
  have := isDomain_of_isRegularLocalRing R
  -- Lemma 6: the `f_j` generate `(f)`
  have hspan := span_eq_of_span_initialForm_eq_grIdeal (IsLocalRing.maximalIdeal R)
    (IsLocalRing.maximalIdeal.isMaximal R).ne_top (Ideal.span {f}) g hg hgen
  -- `f_j = c_j f` and `f = Σ d_j f_j`
  choose c hc using fun j => Ideal.mem_span_singleton'.mp (hg j)
  have hfmem : f ∈ Ideal.span (Set.range g) := by
    rw [hspan]
    exact Ideal.mem_span_singleton_self f
  obtain ⟨d, hd⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hfmem
  have hsum : ∑ j, d j * c j * f = f :=
    (Finset.sum_congr rfl fun j _ => by rw [mul_assoc, hc j]).trans hd
  -- `(1 - Σ d_j c_j) f = 0`, so `Σ d_j c_j = 1`
  have h1 : (1 - ∑ j, d j * c j) * f = 0 := by
    rw [sub_mul, one_mul, Finset.sum_mul, hsum, sub_self]
  have h2 : ∑ j, d j * c j = 1 := by
    rcases mul_eq_zero.mp h1 with h | h
    · exact (sub_eq_zero.mp h).symm
    · exact absurd h hf0
  -- some `c_j` is a unit
  have h3 : ∃ j, IsUnit (c j) := by
    by_contra hcon
    push Not at hcon
    have hmem : ∑ j, d j * c j ∈ IsLocalRing.maximalIdeal R :=
      Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hcon j)))
    rw [h2] at hmem
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr hmem)
  obtain ⟨j, hj⟩ := h3
  calc Ideal.ordElem (IsLocalRing.maximalIdeal R) f
      = Ideal.ordElem (IsLocalRing.maximalIdeal R) (g j) := by
        rw [← hc j, ordElem_unit_mul _ hj]
    _ = Ideal.ordElem P (g j) := hν j
    _ = Ideal.ordElem P f := by rw [← hc j, ordElem_unit_mul _ hj]

/-- The local statement behind Corollary 2 (p. 197).  Let `x'` be a point of `W ⊆ V` (identified
with its image in `X`), `R = O_{X,x}`, `V_x = (f)R`, `P = W_x`, `M` the maximal ideal of `R`, and
`ξ'` the generic point of `W`, with `W_ξ` the maximal ideal of `O_{X,ξ}` and `ξ` a generization of
every point of `W`.  "By Corollary 1 of Theorem 2, `gr_{P̄}(O)` is flat over `O/P̄` (i.e., `V` is
normally flat along `W` at `x`) if and only if `ν_M(f) = ν_P(f)`.  This proves the assertion of
Corollary 2 because `ν_M(f)` (resp. `ν_P(f)`) is equal to the multiplicity of `V` at `x` (resp. at
the generic point of `W`).  Here it should be remarked that `ν_P(f) = ν_{PR_P}(f)` because of the
regularity of `R/P`": `V` is normally flat along `W` at `x'` iff the multiplicity of `V` at `x'`
equals that at `ξ'`. -/
private theorem isNormallyFlatAlongAt_totalTransform_iff_multAt_eq {X : Scheme.{u}}
    [IsAlgebraicScheme X] (hX : X.IsNonsingular) (V W : Subscheme X) (hV : V.IsInvertibleIdeal)
    (hW : W.IsNonsingular) (hWV : W.IsContainedIn V)
    (hpts : ∀ y : V.toScheme, y ∈ (Subscheme.totalTransform V.ι W).pts ↔ V.ι y ∈ W.pts)
    {ξ' : V.toScheme}
    (hWξ : W.stalkIdeal (V.ι ξ') = IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι ξ')))
    (hsp : ∀ y ∈ W.pts, V.ι ξ' ⤳ y) {x' : V.toScheme}
    (hx'W : x' ∈ (Subscheme.totalTransform V.ι W).pts) :
    (Subscheme.totalTransform V.ι W).IsNormallyFlatAlongAt x' ↔
      V.toScheme.multAt x' = V.toScheme.multAt ξ' := by
  have := IsAlgebraicScheme.isNoetherian X
  have := isAlgebraicScheme_toScheme V
  have hx : V.ι x' ∈ W.pts := (hpts x').mp hx'W
  -- `R = O_{X,x}` regular, `P = W_x` prime with `R/P` regular, `V_x = (f)`
  have : IsRegularLocalRing (X.presheaf.stalk (V.ι x')) := hX _
  have : IsRegularLocalRing (X.presheaf.stalk (V.ι ξ')) := hX _
  have hRP := isRegularLocalRing_stalk_quot W hW hx
  have := isPrime_stalkIdeal W hW hx
  obtain ⟨f, hVf, hf0⟩ := exists_stalkIdeal_eq_span_singleton hV (V.ι x')
  have hfP : f ∈ W.stalkIdeal (V.ι x') :=
    stalkIdeal_le_of_isContainedIn hWV _ (hVf ▸ Ideal.mem_span_singleton_self f)
  -- `O_{X,ξ} = R_P` via the generization map, and `V_ξ = (f)`
  have h := hsp _ hx
  let _ := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have hloc := isLocalization_stalkSpecializes_of_specializes h
  have hcomapP := comap_maximalIdeal_stalkSpecializes_eq W h hWξ
  have hlocP : IsLocalization.AtPrime (X.presheaf.stalk (V.ι ξ')) (W.stalkIdeal (V.ι x')) := by
    have hsub : ((IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι ξ'))).comap
        (X.presheaf.stalkSpecializes h).hom).primeCompl =
        (W.stalkIdeal (V.ι x')).primeCompl := by
      ext a
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomapP]
    show IsLocalization (W.stalkIdeal (V.ι x')).primeCompl _
    rw [← hsub]
    exact hloc
  have hVξ : V.stalkIdeal (V.ι ξ') =
      Ideal.span {algebraMap _ (X.presheaf.stalk (V.ι ξ')) f} := by
    rw [Subscheme.stalkIdeal_eq_map_stalkSpecializes V h, hVf, Ideal.map_span, Set.image_singleton]
    rfl
  have hsf0 : algebraMap _ (X.presheaf.stalk (V.ι ξ')) f ≠ 0 := by
    have := isDomain_of_isRegularLocalRing (X.presheaf.stalk (V.ι x'))
    intro h0
    exact hf0 (IsLocalization.injective (X.presheaf.stalk (V.ι ξ'))
      (Ideal.primeCompl_le_nonZeroDivisors (W.stalkIdeal (V.ι x')))
      (h0.trans (map_zero _).symm))
  -- `mult x' = ν_M(f)` and `mult ξ' = ν_{PR_P}(f) = ν_P(f)`
  have hmult_x : ((V.toScheme.multAt x' : ℕ) : ℕ∞) =
      Ideal.ordElem (IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι x'))) f :=
    multAt_eq_ordElem V x' f hVf hf0
  have hmult_ξ : ((V.toScheme.multAt ξ' : ℕ) : ℕ∞) =
      Ideal.ordElem (W.stalkIdeal (V.ι x')) f := by
    rw [multAt_eq_ordElem V ξ' _ hVξ hsf0, ← IsLocalization.AtPrime.map_eq_maximalIdeal
      (W.stalkIdeal (V.ι x')) (X.presheaf.stalk (V.ι ξ'))]
    exact ordElem_map_algebraMap_localization _ hRP f
  have hmult : V.toScheme.multAt x' = V.toScheme.multAt ξ' ↔
      Ideal.ordElem (IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι x'))) f =
        Ideal.ordElem (W.stalkIdeal (V.ι x')) f := by
    rw [← hmult_x, ← hmult_ξ, Nat.cast_inj]
  rw [hmult]
  -- Corollary 1 of Theorem 2 for `R`, `J = (f)`, `P`, `Q = M`
  let _ : Field
      (X.presheaf.stalk (V.ι x') ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι x'))) :=
    Ideal.Quotient.field _
  have : IsRegularLocalRing
      (X.presheaf.stalk (V.ι x') ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι x'))) :=
    inferInstance
  have hcor1 := isNormallyFlatAlongIdeal_tfae_of_eq_maximalIdeal (Ideal.span {f})
    (W.stalkIdeal (V.ι x')) (IsLocalRing.maximalIdeal _)
    ((Ideal.span_singleton_le_iff_mem _).mpr hfP) rfl
  -- transport along `R/(f) ≅ O_{V,x'}`, which carries `P/(f)` to `W'_{x'}`
  let e : (X.presheaf.stalk (V.ι x') ⧸ Ideal.span {f}) ≃+* V.toScheme.presheaf.stalk x' :=
    (Ideal.quotEquivOfEq hVf.symm).trans ((Ideal.quotEquivOfEq
      (stalkIdeal_eq_ker_stalkMap V x')).trans
      (RingHom.quotientKerEquivOfSurjective (V.ι.stalkMap_surjective x')))
  have hmapE : ((W.stalkIdeal (V.ι x')).map (Ideal.Quotient.mk (Ideal.span {f}))).map
      (e : _ →+* _) = (Subscheme.totalTransform V.ι W).stalkIdeal x' := by
    rw [Ideal.map_map, stalkIdeal_totalTransform_eq_map hWV hx'W]
    congr 1
  constructor
  · -- `V` normally flat along `W` at `x'` gives (i) of Corollary 1, hence (iii), hence
    -- `ν_M(f) = ν_P(f)`
    intro hnfAt
    have hnf : IsNormallyFlatAlongIdeal
        ((W.stalkIdeal (V.ι x')).map (Ideal.Quotient.mk (Ideal.span {f}))) := by
      refine isNormallyFlatAlongIdeal_of_ringEquiv e.symm _ _ ?_ hnfAt.2
      rw [← hmapE, Ideal.map_map]
      convert Ideal.map_id _
      exact RingHom.ext fun a => e.symm_apply_apply a
    exact ordElem_maximalIdeal_eq_of_hasInitialFormSystem_span_singleton _ f hf0
      ((hcor1.out 1 2).mp hnf)
  · -- `ν_M(f) = ν_P(f)`: Corollary 1 of Theorem 2 gives (i), `gr_{P/(f)}(R/(f))` flat over `R/P`
    intro hν
    have hnf := (hcor1.out 2 1).mp (hasInitialFormSystem_span_singleton _ f hν)
    exact ⟨hx'W, isNormallyFlatAlongIdeal_of_ringEquiv e _ _ hmapE hnf⟩

/-- Corollary 2 of Theorem 2, p. 197: "Let `V` be an algebraic scheme which is imbedded in a
non-singular algebraic scheme `X`. Let us suppose that the sheaf of ideals of `V` on `X` is
invertible, i.e., locally everywhere generated by a single non-zero element. Let `W` be a
non-singular irreducible subscheme of `V`. Then `V` is normally flat along `W` if and only if
`V` is equi-multiple along `W`, i.e., `V` has a constant multiplicity at the points of `W`."

Encoding: `V` and `W` are subschemes of `X` with `W ⊆ V` (`hWV`); "`V` is normally flat along
`W`" is `V.IsNormallyFlatAlong' W` (normal flatness of the scheme `V` along the subscheme
`W ∩ V = W` of `V`, at every point of `W`); "`V` has a constant multiplicity at the points of
`W`" is `IsEquimultipleAlong` (p. 133) for `W` viewed as the subscheme
`Subscheme.totalTransform V.ι W` of the scheme `V`.

The proof is the paper's, point by point (`isNormallyFlatAlongAt_totalTransform_iff_multAt_eq`): at
a point `x` of `W`, `O_{V,x} = R/(f)R` with `R = O_{X,x}` regular, `P = W_x` and `M` the maximal
ideal of `R`; "By Corollary 1 of Theorem 2, `gr_{P̄}(O)` is flat over `O/P̄` (i.e., `V` is normally
flat along `W` at `x`) if and only if `ν_M(f) = ν_P(f)`", and `ν_M(f)` (resp. `ν_P(f) =
ν_{PR_P}(f)`) is the multiplicity of `V` at `x` (resp. at the generic point `ξ` of `W`).  Both
directions go through Corollary 1: normally flat at every point ⟹ `ν_M(f) = ν_P(f)` ⟹
`mult(x) = mult(ξ)` for every `x`, i.e. equimultiple; conversely equimultiple ⟹ `mult(x) =
mult(ξ)` ⟹ `ν_M(f) = ν_P(f)` ⟹ normally flat at `x`.

Deviation from the paper (gap filled): "if and only if `ν_M(f) = ν_P(f)`" (p. 197) is stated
as the content of Corollary 1 of Theorem 2, whose condition (iii) is the existence of a system
`(f₁, …, f_m)` in `J = (f)` with `ν_M(f_j) = ν_P(f_j)` whose initial forms generate `gr_M(J, R)`;
the passage between (iii) and `ν_M(f) = ν_P(f)` is not argued.  Both directions are proved: if
`ν_M(f) = ν_P(f)` then `f` alone is such a system (`gr_M(R)` is a domain, so `gr_M((f), R)` is
generated by the initial form of `f`); conversely, by Lemma 6 the `f_j` generate `(f)`, so
`f_j = c_j f` and `f = Σ d_j f_j = (Σ d_j c_j) f`, hence `Σ d_j c_j = 1` (`R` is a domain), some
`c_j` is a unit, and `ν_M(f) = ν_M(f_j) = ν_P(f_j) = ν_P(f)`
(`ordElem_maximalIdeal_eq_of_hasInitialFormSystem_span_singleton`).  Also the remark "`ν_P(f) =
ν_{PR_P}(f)` because of the regularity of `R/P`" is proved from the primary powers of `P`, and the
multiplicities are `ν_M(f)`, `ν_{PR_P}(f)` by the formula `e(R/(f)) = ν(f)` of p. 133.

The printed hypothesis "locally everywhere generated by a single non-zero element" is the form
`Subscheme.isNormallyFlatAlong'_iff_isEquimultipleAlong_of_forall_exists_ne_zero`
(`Hironaka/Ch2/GradedIdealCorollary2.lean`, blueprint node `cor:II.2-thm2-2`), equivalent to
the hypothesis `V.IsInvertibleIdeal` used here on a non-singular `X`
(`Subscheme.isInvertibleIdeal_iff_forall_exists_ne_zero`). -/
@[blueprint "cor:II.2-thm2-2-invertible"
  (statement := /-- Let $V$ be an algebraic scheme which is imbedded in a non-singular
    algebraic scheme $X$. Let us suppose that the sheaf of ideals of $V$ on $X$ is invertible
    (locally generated by a non-zero-divisor). Let $W$ be a non-singular
    irreducible subscheme of $V$. Then $V$ is normally flat along $W$
    (\cref{def:0.1-normally-flat}) if and only if $V$ is equi-multiple along $W$
    (\cref{def:equimultiple-along}), i.e., $V$ has a constant multiplicity at the points of
    $W$. (Corollary 2, p.~197, with the hypothesis ``invertible'' read as ``locally generated by
    a non-zero-divisor''; the form with the printed hypothesis ``locally everywhere generated by a
    single non-zero element'' is \cref{cor:II.2-thm2-2}.) -/)
  (proof := /-- (The paper's argument, p.~197.) Let $x$ be an arbitrary point of $W$ and $O$
    the local ring of $V$ at $x$. Then, by the assumption, we have a regular local ring $R$ and
    an element $f$ of $R$ such that $O=R/(f)R$. Let $P$ be the prime ideal in $R$ such that
    $\bar P=P/(f)R$ is the ideal of $W$ in $O$. Let $M$ be the maximal ideal of $R$. By
    \cref{cor:II.2-thm2-1}, $\operatorname{gr}_{\bar P}(O)$ is flat over $O/\bar P$ (i.e.,
    $V$ is normally flat along $W$ at $x$) if and only if $\nu_M(f)=\nu_P(f)$. This proves the
    assertion of Corollary 2 because $\nu_M(f)$ (resp.\ $\nu_P(f)$) is equal to the
    multiplicity of $V$ at $x$ (resp.\ at the generic point of $W$). Here it should be
    remarked that $\nu_P(f)=\nu_{PR_P}(f)$ because of the regularity of $R/P$.

    \textbf{Gap in the paper filled.} ``If and only if $\nu_M(f)=\nu_P(f)$'' (p.~197) is the
    content of Corollary~1 of Theorem~2, whose condition (iii) is the existence of a system
    $(f_1,\dots,f_m)$ in $(f)$ with $\nu_M(f_j)=\nu_P(f_j)$ whose initial forms generate
    $\operatorname{gr}_M((f),R)$; the paper does not argue the passage between (iii) and
    $\nu_M(f)=\nu_P(f)$. Lean proves both directions. If $\nu_M(f)=\nu_P(f)$, then $f$ alone is
    a system as in (iii), because $\operatorname{gr}_M(R)$ is a domain
    (\cref{cor:regular-graded-domain}) so that $\operatorname{gr}_M((f)R,R)$ is generated by the
    initial form of $f$. Conversely, if (iii) holds, then by \cref{lem:II.2-6} the $f_j$ generate
    $(f)$, so $f_j=c_jf$ and $f=\sum_jd_jf_j=(\sum_jd_jc_j)f$; $R$ being a domain,
    $\sum_jd_jc_j=1$, so some $c_j$ is a unit and $\nu_M(f)=\nu_M(f_j)=\nu_P(f_j)=\nu_P(f)$.
    Moreover the multiplicities are $\nu_M(f)$ and $\nu_{PR_P}(f)$ by
    \cref{lem:0.4-multiplicity-hypersurface} ($e(R/(f))=\nu(f)$, p.~133) applied to $R$ and to
    $R_P$, and $\nu_{PR_P}(f)=\nu_P(f)$ because the powers of $P$ are $P$-primary
    (\cref{lem:regular-quotient-primary-powers}), which is the remark at the end of the printed
    proof. -/)
  (latexEnv := "corollary")]
theorem Subscheme.isNormallyFlatAlong'_iff_isEquimultipleAlong {X : Scheme.{u}}
    [IsAlgebraicScheme X] (hX : X.IsNonsingular) (V W : Subscheme X) (hV : V.IsInvertibleIdeal)
    (hW : W.IsNonsingular) (hirr : W.IsIrreducible) (hWV : W.IsContainedIn V) :
    V.IsNormallyFlatAlong' W ↔ (Subscheme.totalTransform V.ι W).IsEquimultipleAlong := by
  have := IsAlgebraicScheme.isNoetherian X
  have := isAlgebraicScheme_toScheme V
  have : IrreducibleSpace W.toScheme := hirr
  have hpts : ∀ y : V.toScheme, y ∈ (Subscheme.totalTransform V.ι W).pts ↔ V.ι y ∈ W.pts :=
    fun y => by
      show y ∈ ((W.comap V.ι).support : Set V.toScheme) ↔ _
      rw [Scheme.IdealSheafData.support_comap]
      rfl
  -- the generic point `ξ` of `W`; `W_ξ` is the maximal ideal of `O_{X,ξ}`
  have hgen : ∃ ξ' : V.toScheme, ξ' ∈ (Subscheme.totalTransform V.ι W).pts ∧
      W.stalkIdeal (V.ι ξ') = IsLocalRing.maximalIdeal (X.presheaf.stalk (V.ι ξ')) ∧
        ∀ y ∈ W.pts, V.ι ξ' ⤳ y := by
    have hred : W.IsReduced := by
      have : ∀ z : W.toScheme, _root_.IsReduced (W.toScheme.presheaf.stalk z) := fun z => by
        have : IsRegularLocalRing (W.toScheme.presheaf.stalk z) := hW z
        have := isDomain_of_isRegularLocalRing (W.toScheme.presheaf.stalk z)
        infer_instance
      exact isReduced_of_isReduced_stalk W.toScheme
    have hWξ : W.stalkIdeal (W.ι (genericPoint W.toScheme)) =
        IsLocalRing.maximalIdeal (X.presheaf.stalk (W.ι (genericPoint W.toScheme))) :=
      stalkIdeal_eq_maximalIdeal_of_isReduced W hred _ (by
        rw [irreducibleComponents_eq_singleton, (genericPoint_spec W.toScheme).def]
        exact Set.mem_singleton _)
    have hsp : ∀ y ∈ W.pts, W.ι (genericPoint W.toScheme) ⤳ y := by
      intro y hy
      obtain ⟨z, rfl⟩ := exists_ι_eq_of_mem_pts W hy
      exact (genericPoint_specializes z).map W.ι.continuous
    have hξW : W.ι (genericPoint W.toScheme) ∈ W.pts := by
      show _ ∈ (W.support : Set X)
      rw [← Scheme.IdealSheafData.range_subschemeι]
      exact ⟨_, rfl⟩
    generalize W.ι (genericPoint W.toScheme) = ξ at hWξ hsp hξW
    obtain ⟨ξ', rfl⟩ := exists_ι_eq_of_mem_pts V (pts_subset_of_isContainedIn hWV hξW)
    exact ⟨ξ', (hpts ξ').mpr hξW, hWξ, hsp⟩
  obtain ⟨ξ', hξ'W, hWξ, hsp⟩ := hgen
  -- Corollary 1 of Theorem 2, point by point (`isNormallyFlatAlongAt_totalTransform_iff_multAt_eq`):
  -- `V` is normally flat along `W` at `x` iff the multiplicity of `V` at `x` equals that at `ξ`
  have key := fun {x' : V.toScheme} (hx'W : x' ∈ (Subscheme.totalTransform V.ι W).pts) =>
    isNormallyFlatAlongAt_totalTransform_iff_multAt_eq hX V W hV hW hWV hpts hWξ hsp hx'W
  constructor
  · -- normal flatness at every point of `W` gives `mult x = mult ξ` for every `x`
    intro h
    have hk : ∀ z ∈ (Subscheme.totalTransform V.ι W).pts,
        V.toScheme.multAt z = V.toScheme.multAt ξ' := fun z hz => (key hz).mp (by
      obtain ⟨z', hz', hnf⟩ := h (V.ι z) ((hpts z).mp hz)
      rwa [V.ι.isEmbedding.injective hz'] at hnf)
    exact fun x hx y hy => (hk x hx).trans (hk y hy).symm
  · intro heq x hx
    obtain ⟨x', rfl⟩ := exists_ι_eq_of_mem_pts V (pts_subset_of_isContainedIn hWV hx)
    have hx'W : x' ∈ (Subscheme.totalTransform V.ι W).pts := (hpts x').mpr hx
    exact ⟨x', rfl, (key hx'W).mpr (heq x' hx'W ξ' hξ'W)⟩

end Hironaka


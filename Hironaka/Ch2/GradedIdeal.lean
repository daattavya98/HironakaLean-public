@[blueprint "thm:II.2-2-quasi-regular"
  (statement := /-- Let $R$ be a regular local ring and $J$ an ideal in $R$. Let $P$ and $Q$
    be prime ideals in $R$ such that $Q\supseteq P\supseteq J$ and that $R/P$ and $R/Q$ are
    both regular. Let $O=R/J$, $\bar Q=Q/J$, and $\bar P=P/J$. Then the following conditions
    are equivalent to each other:
    (i) $\operatorname{gr}_{\bar P}(O)$ is flat over $O/\bar P$.
    (ii) $\operatorname{gr}_{\bar Q}(O)$ is flat over $O/\bar Q$ and the above homomorphism
    $\psi'$ of graded $O/\bar Q$-algebras is isomorphic (\cref{lem:II.2-8-quasi-regular}).
    (iii) $\operatorname{gr}_{\bar Q}(O)$ is flat over $O/\bar Q$, and there exists a system of
    elements $(f_1,\dots,f_m)$ of $J$ with $\nu_Q(f_j)=\nu_P(f_j)$ whose initial forms generate
    $\operatorname{gr}_Q(J,R)$ (\cref{def:II.2-initial-form-system}).
    (iv) $\operatorname{gr}^0_{\bar Q}(\operatorname{gr}_{\bar P}(O))$ is flat over $O/\bar Q$,
    and the canonical homomorphism $\varphi$ is isomorphic. (Theorem 2, p.~195, with (ii).)

    \textbf{Formalization note (intermediate version).} The paper's form is
    \cref{thm:II.2-2-psi}. As in \cref{lem:II.2-8-quasi-regular}, $\psi'$ is
    stated for every system $(y_j)$ with $Q=P+(y)$ whose classes are quasi-regular in $R/P$, and
    ``isomorphic'' means bijective in each total degree; (iii) and (iv) are encoded as in
    \cref{thm:II.2-2}. -/)
  (proof := /-- By Proposition 1 of \S1 (\cref{prop:II.1-1-psi}), (i)$\Rightarrow$(ii). By
    \cref{lem:II.2-8-quasi-regular}, (ii)$\Leftrightarrow$(iii). By the corollary to Lemma 2 of
    \S1,
    (iv)$\Rightarrow$(i). The remaining step, that (ii) and (iii) together imply (iv), is proved
    through $\psi'$ as in \cref{thm:II.2-2}, with the minor variations recorded there. -/)
  (latexEnv := "theorem")]
theorem isNormallyFlatAlongIdeal_tfae_psiDeg (hJP : J ≤ P) (hPQ : P ≤ Q) :
    [IsNormallyFlatAlongIdeal P̄,
      IsNormallyFlatAlongIdeal Q̄ ∧ ∀ (s : ℕ) (y : Fin s → R)
